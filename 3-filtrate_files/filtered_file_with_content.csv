nver = cvx___.nver;
if isoctave,
    if nver <= 3.08,
        fprintf( '%s\\nCVX is not yet supported on Octave.\\n(Please do not waste further time trying: changes to Octave are required.\\nBut they are coming! Stay tuned.)\\n%s\\n', line, line );
