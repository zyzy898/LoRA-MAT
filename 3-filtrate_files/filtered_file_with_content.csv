1705,CollewetNorm.m,72.546,60,90.91,30,100.0,81.82,70-80,"function [ROIonlyNorm] = CollewetNorm(ROIonly)

ROIonly = double(ROIonly);
temp = ROIonly(~isnan(ROIonly));
u = mean(temp);
sigma = std(temp);
ROIonlyNorm = ROIonly;
ROIonlyNorm(ROIonly > (u + 3*sigma)) = NaN;
ROIonlyNorm(ROIonly < (u - 3*sigma)) = NaN;

end"
1706,collide.m,72.0,30,100.0,30,100.0,100.0,70-80,"function [C] = collide(map, points)
map3d = map.map3d_collision;
sz = size(map3d); nx = sz(1); ny = sz(2); nz = sz(3);
points = points_to_idx(map, points);
idx = (points(:,3)-1)*nx*ny + (points(:,2)-1)*nx + points(:,1);
C = map3d(idx) ~= 255 | map3d(nx*ny*nz+idx) ~= 255 | map3d(nx*ny*nz*2+idx) ~= 255;
end"
