sweepsetts.issweep = issweep;
if issweep
    switch sweeptype
        case sweeptypenames.IC
        sweepsizevec = [numx10; numx20; nummodels];              
        case sweeptypenames.nu           
        sweepsizevec = [numnu1; numnu2]; 
        case sweeptypenames.rand_nu           
