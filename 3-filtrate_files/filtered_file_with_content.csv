4770,db_select_blob.m,71.76,60,61.9,75,100.0,61.9,70-80,"function s = db_select_blob(tablename, fieldname, sel)



format = 'serialize';

if nargin>2
  cmd = sprintf('SELECT %s FROM %s LIMIT %d,1', fieldname, tablename, sel-1);
else
  cmd = sprintf('SELECT %s FROM %s', fieldname, tablename);
end

s = mysql(cmd);

if numel(s)==1
  s = msg2struct(s{1}, format);
else
  for i=1:numel(s)
    s{i} = msg2struct(s{i}, format);
  end
end"
