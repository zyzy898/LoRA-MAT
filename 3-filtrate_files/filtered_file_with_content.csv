maxRad = max(rad);
box = zeros(maxRad + 1, maxRad + 1, maxRad + 1);
image = box;
box(1, 1, 1) = 1;
[ix, iy, iz] = meshgrid(1:maxRad + 1, 1:maxRad + 1, 1:maxRad + 1);
