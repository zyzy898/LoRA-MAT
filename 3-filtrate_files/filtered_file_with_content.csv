1071,cvx_pushobj.m,83.208,100,71.6,100,100.0,44.44,80-90,"function cvx_pushobj( dir, x )

global cvx___
try
    np = length(cvx___.problems);
    pstr = cvx___.problems(np);
catch
    cvx_throw( 'No CVX model is present.' );
end


if ~isinf( pstr.direction )
    if isnan( pstr.direction )
        cvx_throw( 'Objective functions cannot be added to sets.' );
    else
        cvx_throw( 'An objective has already been supplied for this problem.' );
    end
end


if ~ischar( dir ) || size( dir, 1 ) ~= 1,
    cvx_throw( 'The second argument must be a string.' );
end


persistent remap_min remap_max
if isempty( remap_max ),
    remap_min = cvx_remap( { { 'constant' } ; { 'l_convex' } ; { 'convex' } } );
    remap_max = cvx_remap( { { 'constant' } ; { 'l_concave' } ; { 'concave' } } );
end
if ~isa( x, 'cvx' ) && ~isnumeric( x ),
    cvx_throw( 'Cannot accept an objective of type ''%s''.', class( arg ) );
elseif ~isreal( x ),
    cvx_throw( 'Expressions in objective functions must be real.' );
elseif isempty( x ),
    warning( 'CVX:EmptyObjective', 'Empty objective.' );
end
cx = cvx_classify( x );
switch dir,
    case { 'minimize', 'minimise' }, 
        vx = remap_min( :, cx ); 
        dir = +1;
    case { 'maximize', 'maximise' }, 
        vx = remap_max( :, cx ); 
        dir = -1;
    otherwise, 
        cvx_throw( 'Invalid objective type: %s', dir );
end
avx = all( vx, 2 );
if ~any( avx ),
    vx = any( vx, 1 );
    if all( vx ),
        cvx_throw( 'Cannot combine logarithmic and linear objectives.' );
    else
        cvx_dcp_error( type, 'unary', cvx_fastref( x, ~vx ) );
    end
end


isgeo = avx(2) & ( ~avx(1) | pstr.gp );
if isgeo,
    x = log( x );
    dir = 2 * dir;
end
if np > 1,
    bx = cvx_sparsify( cvx_basis( x ), [], 'magnitude' );
    x = cvx( size( x ), bx );
end
if isgeo,
    x = exp( x ); 
end
pstr.objective = x;
pstr.direction = dir;
cp = pstr.checkpoint(4);
if cp > 1,
    x = find( any( cvx_basis( x ), 2 ), 2, 'first' );
    if any( x > 1 & x < cp ),
        pstr.checkpoint(4) = x(1+(x(1)==1)) - 1;
    end
end
cvx___.problems( end ) = pstr;"
1072,cvx_pushvar.m,80.34,80,71.43,100,100.0,50.27,80-90,"function v = cvx_pushvar( args )

global cvx___
try
    pstr = cvx___.problems(end);
catch
    cvx_throw( 'No CVX model is present.' );
end

name = args(1).name;
if ~isvarname( name ),
    cvx_throw( 'Invalid variable name: %s', name );
elseif isfield( pstr.variables, name ),
    cvx_throw( 'Variable name conflict: %s', name );
elseif isfield( pstr.duals,name ),
    cvx_throw( 'Primal/dual variable name conflict: %s', name );
end


xsiz = args(1).args;
if isempty( xsiz ),
    xsiz = [ 1, 1 ];
end
isepi  = false;
ishypo = false;
isnneg = false;
issemi = false;
asnneg = pstr.gp;
itype  = '';
iseh   = 0;
if numel( args ) > 1,
    [ str, itype, stypes ] = cvx_create_structure( args );
    for k = 1 : length( stypes )
        strs = stypes{k};
        switch strs
            case 'epigraph_',    isepi  = true; iseh = +1;
            case 'hypograph_',   ishypo = true; iseh = -1;
            case 'nonnegative',  isnneg = true; asnneg = true;
            case 'semidefinite', issemi = true;
            case 'nonnegative_', asnneg = true;
        end
    end
    if isepi || ishypo,
        if ~isempty( pstr.objective ),
            cvx_throw( 'An objective has already been supplied for this problem.' );
        elseif isnan( pstr.direction ),
            cvx_throw( 'Epigraph/hypograph variables cannot be added to sets.' );
        elseif ~isreal( str ) || ~isempty( itype ),
            cvx_throw( 'Epigraph/hypograph variables must be real and continuous.' );
        elseif ~isempty( str ),
            cvx_throw( 'Epigraph/hypograph variables must not have matrix structure.' );
        end
    end
    if pstr.gp
        if issemi
            cvx_throw( 'SEMIDEFINITE variables cannot be declared in geometric programs.' );
        elseif ~isreal( str )
            cvx_throw( 'Complex variables cannot be declared in geometric programs.' );
        elseif any( nonzeros( str ) ~= 1 )
            cvx_throw( 'This matrix structure is incompatibile with geometric programs.' );
        end
    end
else
    str = [];
end


if isempty( str ),
    dof = prod( xsiz );
else
    dof = size( str, 1 );
end
tx = cvx_newvar( dof );
if pstr.gp
    tx = cvx_pushexp( tx );
    isnneg = false;
    asnneg = false;
end
v = sparse( tx, 1 : dof, 1 );
if ~isempty( str ), v = v * str; end
v = cvx( xsiz, v );
s1 = xsiz(1);
tn = [];
if isnneg || issemi && s1 == 1,    
    cvx_pushcone( true, 'nonnegative', tx );
    asnneg = false;
    tn = tx;
end
if issemi && s1 > 1,
    if isreal(str), 
        ctype = 'semidefinite';
        mdof = s1*(s1+1)/2;
    else
        ctype = 'hermitian_semidefinite';
        mdof = s1 * s1;
    end
    mmat = prod(xsiz(3:end));
    if ~isnneg && numel( tx ) == mdof * mmat,
        tx = reshape( tx, mdof, mmat );
        cvx_pushcone( true, ctype, tx );
        if ~isnneg,
            if isreal(str)
                tn = tx(cumsum([1,s1:-1:2]),:);
            else
                tn = tx(cumsum([1,2*s1-1:-2:3]),:);
            end
        end
    else
        cvx_pushcnstr( v - semidefinite(xsiz,~isreal(str)), true );
        if ~isnneg,
            tn = reshape( v, s1 * s1, mmat );
            tn = tn( 1 : s1 + 1 : end, : );
            tn = find( any( cvx_basis( tn ), 2 ) );
        end
    end
end
if asnneg
    tn = tx;
end
if ~isempty( itype )
    cvx_pushcone( true, itype, tx' );
end
if ~isempty( tn ),
    cvx_setnneg( tn );
end


if iseh,
    pstr.objective = v;
    pstr.direction = iseh * ( 1 + pstr.gp );
end
pstr.variables.(name) = v;
cvx___.problems( end ) = pstr;"
