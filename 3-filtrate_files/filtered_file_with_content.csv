6206,complexNormalAngle.m,69.886,80,37.9,100,100.0,31.53,61-70,"function alpha = complexNormalAngle(varargin)



cells = [];
if length(varargin)==4
    nodes = varargin{1};
    edges = varargin{2};
    faces = varargin{3};
    ind   = varargin{4};
    
elseif length(varargin)==5
    nodes = varargin{1};
    edges = varargin{2};
    faces = varargin{3};
    cells = varargin{4};
    ind   = varargin{5};
    
elseif length(varargin)==2
    graph = varargin{1};
    nodes = graph.nodes;
    edges = graph.edges;
    faces = graph.faces;
    if isfield(graph, 'cells')
        cells = graph.cells;
    end
    ind   = varargin{2};
else
    error('wrong number of arguments');
end


alpha0 = zeros([length(ind) 1]);
alpha1 = zeros([length(ind) 1]);
alpha2 = zeros([length(ind) 1]);
alpha3 = zeros([length(ind) 1]);
alpha = [];

if size(nodes, 2)==2
    
    if iscell(faces)

        for i=1:length(ind)
            if ind(i)>size(nodes, 1)
                continue;
            end
            
            alpha0(i) = 2*pi;

            alpha1(i) = length(find(sum(edges==ind(i), 2)))*pi;

            alpha2(i) = 0;
            for j=1:length(faces)
                face = faces{j};
                indf = find(face==ind(i));
                
                if ~isempty(indf)
                    alpha2(i) = alpha2(i) + polygonNormalAngle(nodes(face,:), indf);
                end
            end
        end

    else
        for i=1:length(ind)

            if ind(i)>size(nodes, 1)
                continue;
            end

            alpha0(i) = 2*pi;

            alpha1(i) = length(find(sum(edges==ind(i), 2)))*pi;

            alpha2(i) = 0;
            for j=1:size(faces, 1)
                face = faces(j,:);
                indf = find(face==ind(i));
                
                if ~isempty(indf)
                    alpha2(i) = alpha2(i) + polygonNormalAngle(nodes(face,:), indf);
                end
            end
            
        end
    end
    
    alpha = alpha0 - alpha1 + alpha2;

elseif size(nodes, 2)==3
    for i=1:length(ind)
        
        if ind(i)>size(nodes, 1)
            continue;
        end        

        alpha0(i) = 4*pi;

        alpha1(i) = length(find(sum(edges==ind(i), 2)))*2*pi;

        alpha2(i) = 0;
        if iscell(faces)
            for j=1:length(faces)
                face = faces{j};
                indf = find(face==ind(i));

                if ~isempty(indf)
                    alpha2(i) = alpha2(i) + polygon3dNormalAngle(nodes(face,:), indf);
                end
            end
            
        else
            for j=1:size(faces, 1)
                face = faces(j,:);
                indf = find(face==ind(i));
                
                if ~isempty(indf)
                    alpha2(i) = alpha2(i) + polygon3dNormalAngle(nodes(face,:), indf);
                end
            end
        end

        alpha3(i) = 0;
        for j=1:length(cells)
            cell = cells{j};
            if iscell(faces)
                cellFaces = faces(cell);
            else
                cellFaces = faces(cell, :);
            end

            alpha3(i) = alpha3(i) + polyhedronNormalAngle(nodes, cellFaces, ind(i));
        end
         
        alpha = alpha0 - alpha1 + alpha2 - alpha3;
   end
end



function theta = polygonNormalAngle(points, ind)

np = size(points, 1);

nv = length(ind);

theta = zeros(nv, 1);

for i=1:nv
    p0 = points(ind(i), :);
    
    if ind(i)==1
        p1 = points(np, :);
    else
        p1 = points(ind(i)-1, :);
    end
    
    if ind(i)==np
        p2 = points(1, :);
    else
        p2 = points(ind(i)+1, :);
    end
    
    theta1  = mod(atan2(p1(2)-p0(2), p1(1)-p0(1)) + 2*pi, 2*pi);
    theta2  = mod(atan2(p2(2)-p0(2), p2(1)-p0(1)) + 2*pi, 2*pi);
    dtheta  = mod(theta2-theta1+2*pi, 2*pi);
    
    dtheta  = min(dtheta, 2*pi-dtheta);
    theta(i)= pi - dtheta;    
end

return;



function theta = polyhedronNormalAngle(nodes, faces, ind)


na = length(ind);

theta = zeros(na, 1);
for i=1:na
    
    if iscell(faces)
        for j=1:length(faces)
            if ismember(ind(i), faces{j})
                face = nodes(faces{j}, :);
                
                indp = find(faces{j}==ind(i));
                
                thetaf = [thetaf polygon3dInnerAngle(face, indp)];
            end
        end
    else
        indf = find(sum(ismember(faces, ind(i)), 2));
        
        thetaf = zeros(length(indf), 1);
        for j=1:length(indf)
            ind2 = faces(indf(j), :);
            face = nodes(ind2, :);
            indp = find(ind2==ind(i));
            thetaf(j) = polygon3dInnerAngle(face, indp);
        end
    end

    if ~isempty(thetaf)
        theta(i) = 2*pi - sum(thetaf);
    end    
end

return;


function theta = polygon3dNormalAngle(points, ind)

    
theta = 2*pi - 2*polygon3dInnerAngle(points, ind);

return;


function theta = polygon3dInnerAngle(points, ind)

np = size(points, 1);

nv = length(ind);

theta = zeros(nv, 1);

for i=1:nv
    p0 = points(ind(i), :);
    
    if ind(i)==1
        p1 = points(np, :);
    else
        p1 = points(ind(i)-1, :);
    end
    
    if ind(i)==np
        p2 = points(1, :);
    else
        p2 = points(ind(i)+1, :);
    end
    
    theta(i) = angle3d(p1, p0, p2);
    theta(i) = min(theta(i), 2*pi-theta(i));
end

return;"
