			filename(i*2,:)=[];

			filepath(i*2-1,:)=[];
			filename(i*2-1,:)=[];
		end
	end
	gui.put('filepath',filepath);
	gui.put('filename',filename);
	gui.put('ismean',[]);
	masks_in_frame=gui.retr('masks_in_frame');
	if isempty(masks_in_frame)
		masks_in_frame=cell(1,floor(size(filepath,1)/2));
	end

	gui.sliderrange(1)

