2859,controller_dfs_variant.m,71.61,100,65.22,45,100.0,47.83,70-80,"function ksi_dot = controller_dfs_variant(t,ksi,K1_single,Formations,h,Tconv,v_x,alter_a)

    
    
    index=dfs(t,ksi,Formations,h,Tconv);
    L=Formations.Laplacians;
    
    target=Formations.Targets(:,:,index);
    target(:,1) = target(:,1) + v_x*t;
    n=size(target,1);
    H=zeros(4*n,1);
    for i=1:n
        H(4*i-3,:)=target(i,1);
        H(4*i-2,:)=v_x;
        H(4*i-1,:)=target(i,2);
        H(4*i,:)=0;
    end

    Hv_dot=zeros(2*Formations.robot_number,1);
    
    N=size(ksi,1)/4;
    
    B2_single=[0;1];
    B1_single=[1;0];
    
    B2 = kron(eye(2),B2_single);
    B1 = kron(eye(2),B1_single);
    
    P_single = solveP(K1_single);

    K1 = kron(eye(2),K1_single);
    P=kron(eye(2),P_single);

    lamda = lamda_min(L);
    K2_single = (2*lamda)^(-1)*B2_single'*P_single;

    K2 = kron(eye(2),K2_single);
    
    
    ksi_dot = (kron(eye(N),(B2*K1+B1*B2'))-kron(L(:,:,index),B2*K2))*ksi...
    -(kron(eye(N),B2*K1)-kron(L(:,:,index),B2*K2))*H+kron(eye(N),B2)*Hv_dot;
    
    CorectAcl=obstacle_simple(ksi,alter_a);
    ksi_dot=ksi_dot+CorectAcl;
    
end"
2860,Controller_PD.m,71.564,100,74.36,45,100.0,38.46,70-80,"function Actuators = Controller_PD(States,Control,Phase)


S = convert(States);   

C = Control.footOne;
pos = S.th1;    
vel = S.dth1;
A.T1 = C.Kp*(C.nomPos-pos) + C.Kd*(C.nomVel-vel);
if strcmp(Phase,'F') || strcmp(Phase,'S2')
    A.T1 = 0*A.T1;    %Can't use ankle torques in mid-air!
end

C = Control.footTwo;
pos = S.th2;    
vel = S.dth2;
A.T2 = C.Kp*(C.nomPos-pos) + C.Kd*(C.nomVel-vel);
if strcmp(Phase,'F') || strcmp(Phase,'S1')
    A.T2 = 0*A.T2;    %Can't use ankle torques in mid-air!
end

C = Control.legOne;
pos = S.L1;    
vel = S.dL1;
A.F1 = C.Kp*(C.nomPos-pos) + C.Kd*(C.nomVel-vel);

C = Control.legTwo;
pos = S.L2;    
vel = S.dL2;
A.F2 = C.Kp*(C.nomPos-pos) + C.Kd*(C.nomVel-vel);

C = Control.hip;
pos = S.th2 - S.th1;    
vel = S.dth2 - S.dth2;
A.Thip = C.Kp*(C.nomPos-pos) + C.Kd*(C.nomVel-vel);

Actuators = convert(A);

end"
2861,controller_recon_cL.m,72.764,60,82.35,45,100.0,76.47,70-80,"function [Ak,Bk,Ck,Dk] = controller_recon_cL(A,Bu,Cy,Xe,Ye,Ac_hat,Bc_hat,Cc_hat,Dc_hat,param)
for i = 1:length(param)
    arr(i) = mean(param{i}.range);
end
X = Xe.eval(arr);
Y = Ye.eval(arr);

nx = size(A,1); nu = size(Bu,2); ny = size(Cy,1);                    

[Left,D1,Right] = svd(eye(size(X,1))-X*Y); 
M = Left*sqrt(D1); N = Right*sqrt(D1);

Dk = Dc_hat;
Ck = (Cc_hat-Dk*Cy*X)*pinv(M');
Bk = pinv(N)*(Bc_hat - Y*Bu*Dk);
Ak = pinv(N)*(Ac_hat - N*Bk*Cy*X - Y*Bu*Ck*M' - Y*(A + Bu*Dk*Cy)*X)*pinv(M');
end"
