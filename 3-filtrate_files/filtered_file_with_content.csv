1424,demo_blockproc_denoising.m,81.636,100,65.91,90,100.0,52.27,80-90,"function demo_blockproc_denoising(source,varargin) %RUNASSCRIPT

if demo_blockproc_header(mfilename,nargin)
   return;
end

p = blockpanel({
               {'GdB','Gain',-20,20,0,21},...
               {'Thr','Treshold',0,0.1,0,1000}
               });
    
        


M = 1000;

try
    fs=block(source,varargin{:},'loadind',p);
catch
    blockdone(p);
    err = lasterror;
    error(err.message);
end

bufLen = floor(30e-3*fs);

winLenms = 20; %floor(fs*winLenms/1e3)
[F,Fdual] = framepair('dgtreal',{'hann',floor(fs*winLenms/1e3)},'dual',40,M);
[Fa,Fs] = blockframepairaccel(F,Fdual, bufLen,'segola');


flag = 1;
while flag && p.flag
   
  gain = 10^(p.getParam('GdB')/20); % dB -> val
  thres = p.getParam('Thr');

  [f,flag] = blockread(bufLen);
  c = blockana(Fa, f*gain); 
  c = thresh(c,thres,'soft');
  fhat = real(blocksyn(Fs, c, size(f,1)));
  blockplay(fhat);
end
blockdone(p);"
1425,demo_blockproc_dgtequalizer.m,80.884,100,63.24,100,100.0,41.18,80-90,"function demo_blockproc_dgtequalizer(source,varargin) %RUNASSCRIPT

if demo_blockproc_header(mfilename,nargin)
   return;
end

M = 1000;

fobj = blockfigure();
            
octaves = 6;
voices = 1;
eqbands = (octaves)*voices;

d = floor((floor(M/2)+1)*2.^(-(0:eqbands-1)./(voices)));
d = fliplr([d,0]); 

parg = {{'GdB','Gain',-20,20,0,21}};
for ii=1:eqbands
   parg{end+1} = {sprintf('G%idB',ii),sprintf('band%i',ii),-20,20,0,21};
end

p = blockpanel(parg);
    


try
    fs=block(source,varargin{:},'loadind',p);
catch
    blockdone(p,fobj);
    err = lasterror;
    error(err.message);
end

bufLen = floor(30e-3*fs);

winLenms = 20; %floor(fs*winLenms/1e3)
[F,Fdual] = framepair('dgtreal',{'hann',floor(fs*winLenms/1e3)},'dual',40,M);
[Fa,Fs] = blockframepairaccel(F,Fdual, bufLen,'segola');

flag = 1;
ola = [];
ola2 = [];
while flag && p.flag
   gain = blockpanelget(p);
   gain = 10.^(gain/20);

   [f,flag] = blockread(bufLen);
   f=f*gain(1);
   gain = gain(2:end);
   
   [c, ola] = blockana(Fa, f, ola);
   
   cc = framecoef2tf(Fa,c);
   for ii=1:eqbands
      cc(d(ii)+1:d(ii+1),:,:) = gain(ii)*cc(d(ii)+1:d(ii+1),:,:);
   end
   c = frametf2coef(Fa,cc);
   
   fhat = blocksyn(Fs, c, size(f,1));
   
   
   blockplay(fhat);
   
   [c2, ola2] = blockana(Fa, fhat, ola2);
   blockplot(fobj,Fa,c2(:,1));
end
blockdone(p,fobj);"
