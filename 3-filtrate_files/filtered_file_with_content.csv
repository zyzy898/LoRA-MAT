		axis tight, xlabel s1, ylabel err2, title 'Water inverse error'

		prompt
	end
	clear fw t2 wat err
end"
1597,de_ftab_xform.m,80.924,60,92.31,60,100.0,92.31,80-90,"function fs = de_ftab_xform(ftab, fm)

if nargin < 2, ir_usage, end

