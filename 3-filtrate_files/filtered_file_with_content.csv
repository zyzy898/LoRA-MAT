5545,demo_registration_ex1.m,74.09,100,59.7,60,100.0,50.75,70-80,"disp('(*)First load the mesh and point cloud. Hit Enter to continue...');
pause;

load sampledata;
if (exist('OCTAVE_VERSION') ~= 0)
    trimesh(el, no(:, 1), no(:, 2), no(:, 3));
else
    cla;
    trisurf(el, no(:, 1), no(:, 2), no(:, 3));
end
title('Metch toolbox demonstration');
axis equal;
hold on;


pnum = size(pt, 1);

disp('(*)Create 4 mapping pairs to initialize the mapping. Hit Enter to continue...');
pause;

ptidx = [4 107 1 190];
ptselected = pt(ptidx, :);

meshidx = [3173 1715 156 1740];
meshselected = no(meshidx, :);

[A0, b0] = affinemap(ptselected, meshselected);

disp('(*)Display the updated points. Hit Enter to continue...');
pause;

points_after_initmap = (A0 * pt' + repmat(b0(:), 1, pnum))';
plot3(points_after_initmap(:, 1), points_after_initmap(:, 2), points_after_initmap(:, 3), 'r.');

disp('(*)Optimize the mapping matrix to fit the surface. Hit Enter to continue...');
pause;


pmask = -1 * ones(pnum, 1);
pmask(ptidx) = meshidx;

[A, b, newpos] = regpt2surf(no, el, pt, pmask, A0, b0, ones(12, 1), 10);
A;
b;

disp('(*)Display the optimized point cloud. Hit Enter to continue...');
pause;

points_after_optimize = (A * pt' + repmat(b(:), 1, pnum))';

plot3(points_after_optimize(:, 1), points_after_optimize(:, 2), points_after_optimize(:, 3), 'g+');

disp('(*)Project the point cloud on the surface. Hit Enter to continue...');
pause;


nv = nodesurfnorm(no, el);
[d2surf, cn] = dist2surf(no, nv, points_after_optimize);
[points_after_proj eid weights] = proj2mesh(no, el, points_after_optimize, nv, cn);

disp('(*)Display the final results. Hit Enter to continue...');
pause;

plot3(points_after_proj(:, 1), points_after_proj(:, 2), points_after_proj(:, 3), 'c*');

legend('surface mesh', 'points after initial map', 'points after optimized map', ...
       'points after projection');"
5546,demo_regress.m,74.666,60,94.44,30,100.0,88.89,70-80,"fprintf('Example: Kernel Regression with KDE toolbox\\n');
rand('state',0);
randn('state',0);

x = rand(1,200);
y = sin(2*pi*x) + .05*randn(1,200);
bwType = {'rot','lcv','local'}; color = ['g','r','m'];
plot(x,y,'bo');
for j=1:length(bwType)
  px = kde(x,bwType{j}); bwx = getBW(px,1);
  p = kde([x;y],[bwx;0]);
  xx = 0:.01:1; yy = 0*xx;
  for i=1:length(xx)
    yy(i) = mean(condition(p,1,[xx(i);0]));
  end;
  hold on; tmp=plot(xx,yy,[color(j),'-']); set(tmp,'LineWidth',2); hold off;
end;
legend('Samples','ROT kernel size','Likelihd X-Val','Local L. X-val');"
5547,demo_regression_additive1.m,75.856,80,63.49,90,100.0,45.79,70-80,"S = which('demo_regression1');
L = strrep(S,'demo_regression1.m','demodata/maunaloa_data.txt');
data=load(L);
y = data(:, 2:13);
y=y';
y=y(:);
x = [1:1:length(y)]';
x = x(y>0);             % Remove contaminated observations
y = y(y>0);
avgy = mean(y);
y = y-avgy;
xt = [0:0.5:565]';

[n,nin] = size(x);

pl1 = prior_t('s2', 100, 'nu', 10);
pl2 = prior_t('s2', 10, 'nu', 10);
pm1 = prior_sqrtt('s2',300);
pm2 = prior_sqrtt('s2',10);
pn = prior_logunif();
gpcf1 = gpcf_sexp('lengthScale', 100, 'magnSigma2', 200, 'lengthScale_prior', pl1, 'magnSigma2_prior', pm1);
if exist('ldlchol')
  gpcf2 = gpcf_ppcs2('nin', nin, 'lengthScale', 5, 'magnSigma2', 5, 'lengthScale_prior', pl2, 'magnSigma2_prior', pm2);
else
  warning('GPstuff:SuiteSparseMissing',...
  ['SuiteSparse is not properly installed. (in BECS try ''use suitesparse'')\\n' ...
   'Using gpcf_sexp (non-compact support) instead of gpcf_ppcs2 (compact support)']);
  gpcf2 = gpcf_sexp('lengthScale', 5, 'magnSigma2', 1, 'lengthScale_prior', pl2, 'magnSigma2_prior', pm);
end
lik = lik_gaussian('sigma2', 0.1, 'sigma2_prior', pn);

gp = gp_set('lik', lik, 'cf', {gpcf1, gpcf2}, 'jitterSigma2', 1e-9) 

opt=optimset('TolFun',1e-3,'TolX',1e-3);
gp=gp_optim(gp,x,y,'opt',opt);

[Eft_full, Varft_full, lpyt_full, Eyt_full, Varyt_full] = gp_pred(gp, x, y, xt, 'yt', ones(size(xt)));
[Eft_full1, Varft_full1] = gp_pred(gp, x, y, xt, 'predcf', 1);
[Eft_full2, Varft_full2] = gp_pred(gp, x, y, xt, 'predcf', 2);

figure
subplot(2,1,1)
hold on
plot(x,y,'.', 'MarkerSize',7)
plot(xt,Eyt_full,'k', 'LineWidth', 2)
plot(xt,Eyt_full-2.*sqrt(Varyt_full),'g--')
plot(xt,Eyt_full+2.*sqrt(Varyt_full),'g--')
axis tight
caption1 = sprintf('Full GP:  l_1= %.2f, s^2_1 = %.2f, \\n l_2= %.2f, s^2_2 = %.2f \\n s^2_{noise} = %.2f', gp.cf{1}.lengthScale, gp.cf{1}.magnSigma2, gp.cf{2}.lengthScale, gp.cf{2}.magnSigma2, gp.lik.sigma2);
title(caption1)
legend('Data point', 'predicted mean', '2\\sigma error')

subplot(2,1,2)
[AX, H1, H2] = plotyy(xt, Eft_full2, xt, Eft_full1);
set(H2,'LineStyle','--')
set(H2, 'LineWidth', 2)
set(H1,'LineStyle','-')
set(H1, 'LineWidth', 0.8)
