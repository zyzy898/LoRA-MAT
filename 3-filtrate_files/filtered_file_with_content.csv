        Tria(t,:) = [nv1+j nv0+Ind(j,:)];
        t = t+1;
        Tria(t,:) = [nv1+j nv0+Ind(j,2) nv1+1];
      elseif Ind(j,2) == 0 && j < m
        t = t+1;
        Tria(t,:) = [nv1+j nv0+Ind(j,1) nv1+j+1];
