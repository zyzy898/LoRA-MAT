    if ~( isnumeric(sx) && nx==size(sx,2) && isreal(sx) && all(sx>=0) && all(sx==floor(sx)) ),
        cvx_throw( 'Size argument must be a row vector of nonnegative integers.' );
    end
    switch nx,
    case 2,
    case 1,
        sx = [ sx ,1 ];
