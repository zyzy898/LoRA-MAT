    R_vehicleBody_2_ned = eul2rotmARH_mex([yawAng,pitchAng,rollAng],'zyx');

    [R_ned_2_baseFrame, ~, ~, ~] = computeNedFrameInFrame(rVectBaseFrame);

    R_baseFrame_2_GlobalInertial = baseFrame.getRotMatToInertialAtTime(ut, ce, []);
    R_bodyInertialFrame_2_GlobalInertial = bodyInertialFrame.getRotMatToInertialAtTime(ut, ce, []);

    R_GlobalInertial_2_bodyInertialFrame = R_bodyInertialFrame_2_GlobalInertial';
    R_baseFrame_2_BodyInertialFrame = R_GlobalInertial_2_bodyInertialFrame * R_baseFrame_2_GlobalInertial;

	R_body_2_inertial = real(R_baseFrame_2_BodyInertialFrame * R_ned_2_baseFrame * R_vehicleBody_2_ned); 

    bodyX = R_body_2_inertial(:,1);
    bodyY = R_body_2_inertial(:,2);
    bodyZ = R_body_2_inertial(:,3);
end"
2155,computeInitialEllipsoid.m,79.644,100,55.36,100,100.0,42.86,70-80,"function [Chi2] = computeInitialEllipsoid(a_hat,L_mat,d_vec,nCands,factor)
nn = length(a_hat);

if nargin < 3
    error('ATTENTION: number of inputs is insufficient!')

elseif nargin < 4
    nCands = 2;         % Default number of candidates
    factor = 1.5;       % Default factor for squared norm used

elseif nargin < 5
    factor = 1.5;       % Default factor for squared norm used

end
if nCands > nn + 1

    Vn   = (2/nn) * ( pi^(nn/2) / gamma(nn/2) );
    Chi2 = ( factor * nCands / ( sqrt(prod(d_vec)) * Vn ) ) ^ (2/nn);

else
    
    Chi = NaN(1,nn+1);
    iQ  = ( L_mat \\ diag(1./d_vec) ) / L_mat';
  
    for kk = nn:-1:0

        a_float = a_hat;
        a_fixed = a_hat;
        
        for ii = nn:-1:1
            
            dw = 0;
            for jj = nn:-1:ii
                dw = dw + L_mat(jj,ii) * ( a_float(jj) - a_fixed(jj) );
            end
            
            a_float(ii) = a_float(ii) - dw;
            if (ii ~= kk)
                a_fixed(ii) = round( a_float(ii) );
            else
                tmp = round( a_float(ii) );
                a_fixed(ii) = tmp + sign( a_float(ii) - tmp );              
            end
            
        end

        Chi(kk+1) = ( a_hat - a_fixed )' * iQ * ( a_hat - a_fixed );
    
    end
    
    Chi_sorted  = sort(Chi);
    
    Chi2 = Chi_sorted(nCands) + 1e-6;

end
end"
2156,ComputeInitialPotentials.m,76.404,100,59.65,75,100.0,47.37,70-80,"function P = ComputeInitialPotentials(C)

N = length(C.nodes);

P.cliqueList = repmat(struct('var', [], 'card', [], 'val', []), N, 1);


assignments = zeros(length(C.factorList), 1);
for i = 1:length(C.factorList)
    for j = 1:N
        if isempty(setdiff(C.factorList(i).var, C.nodes{j}))
            assignments(i) = j;
            break
        end
    end
end
cardinalities = zeros(1, length(unique([C.factorList(:).var])));
for i = 1:length(cardinalities)
    for j = 1:length(C.factorList)
        if ~isempty(find(C.factorList(j).var == i))
            cardinalities(i) = C.factorList(j).card(find(C.factorList(j).var == i));
            break;
        end
    end
end
for i = 1:N
    P.cliqueList(i).var = C.nodes{i};
    P.cliqueList(i).card = cardinalities(C.nodes{i});
    P.cliqueList(i).val = ones(1, prod(P.cliqueList(i).card));
end
for i = 1:length(assignments)
    P.cliqueList(assignments(i)) = FactorProduct(P.cliqueList(assignments(i)), C.factorList(i));
end
P.edges = C.edges;
for i = 1:length(C.factorList)
    factorVars = C.factorList(i).var;
    allVarsInFactor = 0;
    for j = 1:N
        varNotFound = 0;
        for k = 1:length(factorVars)
            if isempty(find(ismember(P.cliqueList(j).var, factorVars(k))))
                varNotFound = 1;
                break
            end
        end
        if varNotFound == 0
            allVarsInFactor = 1;
            break
        end
    end
    if allVarsInFactor == 0
        disp('Family intersection property violated!');
    end
end


end"
2157,ComputeInputSignals.m,76.452,80,56.1,100,100.0,46.16,70-80,"function InpSignal = ComputeInputSignals(stepTime,UPoint,interType,tmp_CP,inpBound,SimTimeInt,isVarTime)




ns = length(stepTime);  % number of simulation steps
nu = length(tmp_CP);    % number of input signals
ni = length(interType); % number of different interpolation types
nsti = length(SimTimeInt); % Is initial time specified?

if nsti==1
    initTime = 0;
    simTime = SimTimeInt;
else
    initTime = SimTimeInt(1);
    simTime = SimTimeInt(2);
end

InpSignal = zeros(ns,nu);
idx_offset = tmp_CP(end)+1;

for ii = 1:nu
    
    if ii==1
        CP_idx = 1:tmp_CP(1);
    else
        CP_idx = tmp_CP(ii-1)+1:tmp_CP(ii);
    end
    U_tmp = UPoint(CP_idx);
    
    if ni==1
        idx_it = 1;
    else
        idx_it = ii;
    end

    timeVector = [];
    if isVarTime==1
        if nsti==1
            timeVector = UPoint(tmp_CP(end)+1:end)';
        else
            timeVector = initTime+(simTime-initTime)/simTime*UPoint(tmp_CP(end)+1:end)';
        end
    elseif isVarTime==2 
        assert(initTime<UPoint(idx_offset),' ComputeInputSignal: Variable time control points are requested, but the time stamp of the 1st control point violates the initial time constraint. This could be the case when a signal prefix is used and the first control point has time less than last time stamp of the prefix signal.')
        if iscolumn(UPoint)
            UPoint = UPoint';
        end         
        if ii==1
            assert(UPoint(idx_offset+tmp_CP(1)-3)<simTime,' ComputeInputSignal: Variable time control points are requested, but the time stamp of the last control point violates the maximum simulation time.')
            timeVector = [initTime UPoint(idx_offset:(idx_offset+tmp_CP(1)-3)) simTime]';
            idx_offset = idx_offset+tmp_CP(1)-2;
        else
            assert(UPoint(idx_offset+tmp_CP(ii)-tmp_CP(ii-1)+-3)<simTime,' ComputeInputSignal: Variable time control points are requested, but the time stamp of the last control point violates the maximum simulation time.')
            timeVector = [initTime UPoint(idx_offset:(idx_offset+tmp_CP(ii)-tmp_CP(ii-1)+-3)) simTime]';
            idx_offset = idx_offset+tmp_CP(ii)-tmp_CP(ii-1)-2;
        end
    end
    
    if isa(interType{idx_it},'function_handle')
        
        InterpFcnPt = interType{idx_it};
        
        if isVarTime>0
            InpSignal(:,ii) = InterpFcnPt(timeVector,U_tmp,stepTime);
        else
            InpSignal(:,ii) = InterpFcnPt(U_tmp,stepTime);
        end        
        
    elseif iscell(interType{idx_it}) % this is the case for prefix fixed signals 
        
        endTime = interType{idx_it}{1}(end,1);
        idx_pref = find(stepTime<=endTime);
        idx_suff = find(stepTime>endTime);
        if ~isempty(idx_pref)
            n_inp = size(interType{idx_it}{1},2);
            if n_inp>2 && ni>1
                error(' ComputeInputSignals: For input signals with pre-specified prefix: multiple input signals in a single array are only allowed when specifying the same interpolation function for all input signals.')
            end
            if n_inp==2
                InpSignal_pref = interp1(interType{idx_it}{1}(:,1),interType{idx_it}{1}(:,2),stepTime(idx_pref));
            else
                InpSignal_pref = interp1(interType{idx_it}{1}(:,1),interType{idx_it}{1}(:,ii+1),stepTime(idx_pref));
            end
        else
            InpSignal_pref = [];
        end
        if ~isempty(idx_suff)
            if isVarTime==2
                timeVector(1) = [];
                timeVector(end) = [];
            end
            InpSignal_suff = ComputeInputSignals(stepTime(idx_suff),[U_tmp,timeVector'],interType{idx_it}(2),length(U_tmp),inpBound(idx_it,:),[stepTime(idx_suff(1)),simTime],isVarTime);
        else
            InpSignal_suff = [];
        end
        InpSignal(:,ii) = [InpSignal_pref; InpSignal_suff];
        
    else
        
        switch interType{idx_it}

            case 'bool'
                
                nbnodes = length(U_tmp);
                assert(min(U_tmp >= 0 & U_tmp <= 1), 'When interpolation type is bool, the range of the input signal must be given as [0,1].') 
                if isVarTime>0
                    nbnodes = nbnodes-1;
                else
                    timeVector = initTime:((simTime-initTime)/length(U_tmp)):simTime;
                end

                vals = U_tmp >= 0.5; % randi(2,nbnodes,1)-1;
                bsignal = zeros(ns,1);
                for v = 1:nbnodes
                    bsignal(stepTime >= timeVector(v) & stepTime <= timeVector(v+1)) = vals(v);  
                end
                
                if isVarTime>0
                    bsignal(end) = vals(end);
                end
                
                InpSignal(:,ii) = bsignal;  

            case 'UR'
                assert(length(U_tmp)==1,['S-Taliro: Input signal ',num2str(ii),' is constant, but more than 1 control points are provided.']);
                InpSignal(:,ii) = inpBound(ii,1)+(inpBound(ii,2)-inpBound(ii,1))*rand(ns,1);  

            case 'const'
                assert(length(U_tmp)==1,['S-Taliro: Input signal ',num2str(ii),' is constant, but more than 1 control points are provided.']);
                InpSignal(:,ii) = U_tmp*ones(ns,1);

            case 'pconst'

                if isVarTime==0
                    timeVector = initTime:((simTime-initTime)/length(U_tmp)):simTime;
                end

                InpSignal(:,ii) = piecewise_const(timeVector,U_tmp,stepTime);

            otherwise

                if isVarTime==0
                    timeVector = initTime:((simTime-initTime)/(length(U_tmp)-1)):simTime;
                end

                InpSignal(:,ii) = interp1(timeVector,U_tmp,stepTime,interType{idx_it});
                if strcmp(interType{idx_it},'spline')
                    lwBd = repmat(inpBound(ii,1),ns,1);
                    upBd = repmat(inpBound(ii,2),ns,1);
                    if ~(min(lwBd<=InpSignal(:,ii) & InpSignal(:,ii)<=upBd))
                        InpSignal = [];
                        return
                    end
                end
        end
    end
end

if ns==1
    InpSignal = InpSignal';
end

end"
2158,computeInternalMetaboliteProduction.m,75.494,80,56.14,100,100.0,41.33,70-80,"function computeInternalMetaboliteProduction(modelFolder,propertiesFolder,reconVersion,metList,numWorkers)

dInfo = dir(modelFolder);
modelList={dInfo.name};
modelList=modelList';
modelList(~(contains(modelList(:,1),{'.mat','.sbml','.xml'})),:)=[];

mkdir([propertiesFolder filesep 'ComputedFluxes'])

if isfile([propertiesFolder filesep 'ComputedFluxes' filesep 'InternalProduction_' reconVersion  '.txt'])
    InternalProduction = readInputTableForPipeline([propertiesFolder filesep 'ComputedFluxes' filesep 'InternalProduction_' reconVersion  '.txt']);
    
    if isempty(metList)
        allMets=InternalProduction(1,2:end)';
    else
        allMets=metList;
    end
else
    if isempty(metList)
        if isfile([propertiesFolder filesep 'Metabolites_' reconVersion '.txt'])
            metabolites = readInputTableForPipeline([propertiesFolder filesep 'Metabolites_' reconVersion '.txt']);
            allMets=metabolites(:,1);
        else
            allMets={};
            for i=1:length(modelList)
                try
                    model=readCbModel([modelFolder filesep modelList{i}]);
                catch
                    model=load([modelFolder filesep modelList{i}]);
                    model = model.model;
                end
                
                mets=strrep(model.mets,'[c]','');
                mets=strrep(mets,'[e]','');
                allMets=unique(vertcat(allMets,mets));
            end
        end
    else
        allMets=metList;
    end
    InternalProduction={};
    InternalProduction(1,2:length(allMets)+1)=allMets;
end

global CBT_LP_SOLVER
if isempty(CBT_LP_SOLVER)
    initCobraToolbox
end
solver = CBT_LP_SOLVER;

if numWorkers>0 && ~isempty(ver('parallel'))
    poolobj = gcp('nocreate');
    if isempty(poolobj)
        parpool(numWorkers)
    end
end
environment = getEnvironment();

if isfile([propertiesFolder filesep 'ComputedFluxes' filesep 'InternalProduction_' reconVersion  '.txt'])
    modelsRenamed=strrep(modelList(:,1),'.mat','');
    modelsRenamed=strrep(modelsRenamed,'.sbml','');
    modelsRenamed=strrep(modelsRenamed,'.xml','');
    [C,IA]=intersect(modelsRenamed,InternalProduction(2:end,1));
    modelList(IA,:)=[];
end

if length(modelList)>5000
    steps=1000;
elseif length(modelList)>200
    steps=200;
else
    steps=25;
end

if ~isempty(modelList)
    for i=1:steps:length(modelList)
        
        if length(modelList)-i>=steps-1
            endPnt=steps-1;
        else
            endPnt=length(modelList)-i;
        end
        
        modelsToLoad={};
        for j=i:i+endPnt
            if j <= length(modelList)
                modelsToLoad{j}=[modelFolder filesep modelList{j}];
            end
        end
        
        parfor j=i:i+endPnt
            restoreEnvironment(environment);
            changeCobraSolver(solver, 'LP', 0, -1);
            if strcmp(solver,'ibm_cplex')
                changeCobraSolverParams('LP', 'logFile', 0);
            end
            try
                model=readCbModel(modelsToLoad{j});
            catch
                model=load(modelsToLoad{j});
                model = model.model;
            end
            exRxns=model.rxns(find(strncmp(model.rxns,'EX_',3)));
            model = changeRxnBounds(model, exRxns, -1000, 'l');
            model = changeRxnBounds(model, exRxns, 1000, 'u');
            
            mets=strrep(model.mets,'[c]','');
            mets=strrep(mets,'[e]','');
            mets=unique(mets);
            mets=intersect(mets,allMets);
            
            for k=1:length(mets)
                if ~isempty(find(strcmp(model.mets,[mets{k} '[c]'])))
                    if ~contains(model.rxns,['DM_' mets{k} '[c]'])
                        model=addDemandReaction(model,[mets{k} '[c]']);
                    end
                    model=changeObjective(model,['DM_' mets{k} '[c]']);
                    model=changeRxnBounds(model,['EX_' mets{k} '(e)'],0,'l');

                    FBA=optimizeCbModel(model,'max');
                    metFluxes{j}(k)=FBA.f;
                else
                    metFluxes{j}(k)=0;
                end
            end
        end
        
        for j=i:i+endPnt
            try
                model=readCbModel(modelsToLoad{j});
            catch
                model=load(modelsToLoad{j});
                model = model.model;
            end
            plusonerow=size(InternalProduction,1)+1;
            modelID=strrep(modelList{j},'.mat','');
            modelID=strrep(modelID,'.sbml','');
            modelID=strrep(modelID,'.xml','');
            InternalProduction{plusonerow,1}=modelID;
            InternalProduction(plusonerow,2:end)={'0'};
            
            mets=strrep(model.mets,'[c]','');
            mets=strrep(mets,'[e]','');
            mets=unique(mets);
            mets=intersect(mets,allMets);
            
            for k=1:length(mets)
                findInd=find(strcmp(InternalProduction(1,:),mets{k}));
                InternalProduction{plusonerow,findInd}=num2str(metFluxes{j}(k));
            end
        end
        InternalProduction{1,1}='Model_ID';
        writetable(cell2table(InternalProduction),[propertiesFolder filesep 'ComputedFluxes' filesep 'InternalProduction_' reconVersion],'FileType','text','WriteVariableNames',false,'Delimiter','tab');
    end
end

tol=0.0000001;

data = readInputTableForPipeline([propertiesFolder filesep 'ComputedFluxes' filesep 'InternalProduction_' reconVersion  '.txt']);
for j=2:size(data,1)
    for k=2:size(data,2)
        if data{j,k} > tol
            data{j,k}=1;
        else
            data{j,k}=0;
        end
    end
end
writetable(cell2table(data),[propertiesFolder filesep 'ComputedFluxes' filesep 'InternalProduction_' reconVersion '_qualitative'],'FileType','text','WriteVariableNames',false,'Delimiter','tab');

end"
2159,ComputeInvPolarApData.m,76.584,100,75.0,60,100.0,47.92,70-80,"function Ap = ComputeInvPolarApData(XBounds,YBounds,handles)

[ny, nx, nz] = size(handles.phasehistory);
Ap = zeros(ny,nx,nz);

YBounds = [ny-YBounds(2) ny-YBounds(1)];

k_a = linspace(handles.k_a(1),handles.k_a(2),nx);
k_r = linspace(handles.k_r(1),handles.k_r(2),ny);

ka(1:10) = k_a(XBounds(1));
kr(1:10) = linspace(k_r(YBounds(1)),k_r(YBounds(2)),10);
ka(11:20) = linspace(k_a(XBounds(1)),k_a(XBounds(2)),10);
kr(11:20) = k_r(YBounds(2));
ka(21:30) = k_a(XBounds(2));
kr(21:30) = linspace(k_r(YBounds(2)),k_r(YBounds(1)),10);
ka(31:40) = linspace(k_a(XBounds(2)),k_a(XBounds(1)),10);
kr(31:40) = k_r(YBounds(1));

center_freq = handles.meta.Grid.Row.KCtr;
ss = [handles.meta.Grid.Row.SS handles.meta.Grid.Col.SS];
k_v = center_freq + ((1./ss(2)) * [-1 1] / 2);
k_u = (1./ss(1)) * [-1 1] / 2;
k_v = linspace(k_v(1), k_v(2), ny)';
k_u = linspace(k_u(1), k_u(2), nx)';

xpos = zeros(length(ka),1);
ypos = zeros(length(kr),1);
for i=1:length(ka)
    ku_temp = sind(ka(i))*kr(i);
    kv_temp = cosd(ka(i))*kr(i);
    [~,index1] = min(abs(k_u-ku_temp));
    [~,index2] = min(abs(k_v-kv_temp));
    xpos(i) = index1;
    ypos(i) = ny - index2;    
end

BW = poly2mask(xpos,ypos,ny,nx);

if get(handles.InverseSelection,'Value')
    BW = -1*(BW-1);
end

for i=1:nz
    Ap(:,:,i) = handles.phasehistory(:,:,i).*BW;
end

end"
2160,computeISIprop.m,74.608,100,60.87,60,100.0,52.17,70-80,"function [propLongISI, coefficient_variation, coefficient_variation2, isi_skewness] = computeISIprop(ISIs, theseSpikes)


spiking_stat_window = max(theseSpikes) - min(theseSpikes);
spiking_stat_bins = [min(theseSpikes), max(theseSpikes)];

bin_spikes = ...
    histcounts(theseSpikes, ...
    spiking_stat_bins);

min_spikes = 10;
use_spiking_stat_bins = bsxfun(@ge, bin_spikes, prctile(bin_spikes, 80, 2)) & bin_spikes > min_spikes;

longISI = 2;
long_isi_total = 0;
for curr_bin = find(use_spiking_stat_bins)
    curr_spike_times = theseSpikes( ...
        theseSpikes > spiking_stat_bins(curr_bin) & ...
        theseSpikes < spiking_stat_bins(curr_bin+1));
    curr_isi = diff(curr_spike_times);

    long_isi_total = long_isi_total + sum(curr_isi(curr_isi > longISI));
    
    if curr_bin==1
        coefficient_variation = std(curr_isi) / mean(curr_isi);
    
        coefficient_variation2 = 2 * mean(abs(diff(curr_isi))) / mean([curr_isi(1:end-1); curr_isi(2:end)]);
    
        isi_skewness = skewness(ISIs);
    end


end
if isempty(curr_bin)
    coefficient_variation = NaN;
    
    coefficient_variation2 = NaN;
    
    isi_skewness = NaN;
end

propLongISI = long_isi_total / ...
    (sum(use_spiking_stat_bins(:)) * spiking_stat_window);


end"
2161,computeJGJacobian.m,71.77,80,65.35,45,100.0,68.5,70-80,"function J = computeJGJacobian (qR, qS, returnStructureOnly, auxdata)
  [K C f Rv Rf Sv Sf NS d] = deal(auxdata{:});
  
  nr  = length(Rv);  % The number of large regions.
  ns  = length(Sv);  % The number of small regions.
  nqr = length(qR);  % The number of variables associated with the
  nqs = length(qS);  % The number of variables associated with the

  qR = reshapemarginals(qR,Rv,K);
  qS = reshapemarginals(qS,Sv,K);
  
  rows = zeros(1,nqr);
  is   = 0;
  for r = 1:nr
    tablesize = numel(qR{r});
    is        = is(end) + (1:tablesize);
    rows(is)  = r;
  end
  JR = sparse(rows,1:nqr,ones(1,nqr),nr,nqr);
  
  rows = zeros(1,nqs);
  is   = 0;
  for s = 1:ns
    tablesize = numel(qS{s});
    is        = is(end) + (1:tablesize);
    rows(is)  = s;
  end
  JS = sparse(rows,1:nqs,ones(1,nqs),ns,nqs);
  
  JCS = cell(1,ns);
  for s = 1:ns
    w      = numel(qS{s});  % The width of the Jacobian subblock.
    h      = d(s) * w;      % The height of the Jacobian subblock.
    cols   = repmat(1:w,1,d(s));
    JCS{s} = sparse(1:h,cols,-ones(1,h),h,w);
  end

  JCR = cell(sum(d),1);
  t   = 1;  % The row of the current subblock.
  for s = 1:ns
    for r = NS{s}
      h      = numel(qS{s});  % The height of the Jacobian subblock.
      w      = numel(qR{r});  % The width of the Jacobian subblock.
      rows   = multiplyfactors(ones([K(Rv{r}) 1]),Rv{r},...
                               reshape(1:h,[K(Sv{s}) 1]),Sv{s});
      JCR{t} = sparse(rows(:)',1:w,ones(1,w),h,w);
      t      = t + 1;         % Move to the next row.
    end
  end

  J = [ JR                              spzeros(nr,nqs);
        spzeros(ns,nqr)                 JS;
        spblockrows(JCR,vectorize(NS))  spblockdiag(JCS) ];
  
function A = spblockdiag (blocks)
  n       = length(blocks);  % The number of blocks.
  h       = 0;               % The height of the full matrix.
  w       = 0;               % The width of the full matrix.
  rows    = [];
  cols    = [];
  entries = [];
  
  for i = 1:n
    [hb wb]    = size(blocks{i});  % The height and width of the block.
    [is js xs] = find(blocks{i});
    rows       = [rows h + is'];
    cols       = [cols w + js'];
    entries    = [entries xs'];
    h          = h + hb;
    w          = w + wb;
  end
  
  A = sparse(rows,cols,entries,h,w);
  
function A = spblockrows (blocks, c)
  n       = length(blocks);  % The number of blocks.
  nc      = max(c);          % The number of block columns.
  h       = 0;               % The height of the full matrix.
  rows    = [];              % The rows of the individual entries.
  cols    = [];              % The columns of the individual entries.
  entries = [];
  
  bw = zeros(1,nc);
  for i = 1:n
    bw(c(i)) = size(blocks{i},2);
  end
  
  bw = cumsum(bw);
  w  = bw(nc);
  bw = [0 bw(1:nc-1)];
  
  for i = 1:n
    hb         = size(blocks{i},1);  % The height of the block.
    [is js xs] = find(blocks{i});
    rows       = [rows h + is'];
    cols       = [cols bw(c(i)) + js'];
    entries    = [entries xs'];
    h          = h + hb;
  end
  
  A = sparse(rows,cols,entries,h,w);"
2162,computeJGObjective.m,72.556,100,63.89,60,100.0,38.89,70-80,"function F = computeJGObjective (qR, qS, auxdata)
  [K C f Rv Rf Sv Sf NS d] = deal(auxdata{:});
    
  qR = reshapemarginals(qR,Rv,K);
  qS = reshapemarginals(qS,Sv,K);

  F = computefreeenergy(C,f,Rv,Rf,Sv,Sf,qR,qS,d);
  
function F = computefreeenergy (C, f, Rv, Rf, Sv, Sf, qR, qS, d)
  nr = length(Rv);   % The number of large regions.
  ns = length(Sv);   % The number of small regions.
  F  = 0;            % The return value.
    
  for r = 1:nr
    for j = Rf{r}
      table = multiplyfactors(qR{r},Rv{r},log(f{j}),C{j});
      F     = F - sum(table(:));
    end
  end
  
  for s = 1:ns
    for j = Sf{s}
      table = multiplyfactors(qS{s},Sv{s},log(f{j}),C{j});
      F     = F - (1 - d(s)) * sum(table(:));
    end
  end
  
  for r = 1:nr
    table = qR{r} .* log(qR{r});
    F     = F + sum(table(:));
  end
  
  for s = 1:ns
    table = qS{s} .* log(qS{s});
    F     = F + (1 - d(s)) * sum(table(:));
  end"
