        fc{i}=corfreq_one(lat{i});
    end
else
   fc=corfreq_one(lat);
end

function[fc]=corfreq_one(lat)
omega=7.2921159e-5;
fc=2*sind(lat).*omega.*(3600);

function[]=corfreq_test
 
reporttest('CORFREQ at 30 degrees is about 2*pi/24',aresame(1./corfreq(30),24/2/pi,1e-1))"
3256,coriolisMatrix.m,71.05,100,58.97,45,100.0,51.28,70-80,"function C = coriolisMatrix(robot, q, qd)


N = length(robot.homeConfiguration);

assert(length(q) == N, 'RTB:coriolis:badarg', 'q must have %d elements', N)
assert(length(qd) == N, 'RTB:coriolis:badarg', 'qd must have %d elements', N)

q = q(:)';
qd = qd(:)';

robot2 = robot.copy;
robot2.Gravity = [0 0 0];
robot2.DataFormat = ""row"";

C = zeros(N,N);
Csq = zeros(N,N);


for j=1:N
    QD = zeros(1,N);
    QD(j) = 1;
    tau = robot2.inverseDynamics(q, QD, zeros(size(q)));
    Csq(:,j) = Csq(:,j) + tau.';
end

for j=1:N
    for k=j+1:N
        QD = zeros(1,N);
        QD(j) = 1;
        QD(k) = 1;
        tau = robot2.inverseDynamics(q, QD, zeros(size(q)));
        C(:,k) = C(:,k) + (tau.' - Csq(:,k) - Csq(:,j)) * qd(j)/2;
        C(:,j) = C(:,j) + (tau.' - Csq(:,k) - Csq(:,j)) * qd(k)/2;
    end
end

C = C + Csq * diag(qd);
end"
