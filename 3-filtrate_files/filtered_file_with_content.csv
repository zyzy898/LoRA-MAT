2298,compute_combinatorial_laplacian.m,72.554,100,58.33,60,100.0,44.44,70-80,"function L = compute_combinatorial_laplacian(A)


error('Not used anymore');

Ic = adjacency2incidence(A);
L = Ic*Ic';

return;

w0 = sum( abs(Ic') );
w0 = diag( w0.^(-1/2) );
L = w0 * A * w0;
L = diag( sum(L) ) - L;
L = (L+L')/2; 


return;


n = length(A);
L = zeros(n,n);

for i=1:n
    ni = sum( A(i,:) );
    for j=1:n
        nj = sum( A(:,j) );
        if A(i,j) ==1
            L(i,j) = -1/sqrt(ni*nj);
        end
    end
end

for i=1:n
    L(i,i) = -sum( L(i,:) );
end"
2299,compute_compass_calibration_coefficients.m,76.674,80,70.87,60,100.0,72.5,70-80,"function coeffs=compute_compass_calibration_coefficients(true_heading, ...
                                                    compass_output,do_plots,polynom_order)

if nargin==2
  do_plots=1;
  polynom_order=4;
elseif nargin==3
  polynom_order=4;
end

[raw_comp,ind]=sort(compass_output);
true_heading=true_heading(ind);
true_heading=180/pi*unwrap(true_heading/180*pi);

if mean(true_heading)>180
  true_heading=true_heading-360;
end


true_heading=[true_heading(end)-360 ; true_heading ; true_heading(1)+360];
raw_comp=[raw_comp(end)-360 ; raw_comp ; raw_comp(1)+360];

[true_heading raw_comp];
coeffs=polyfit(raw_comp,true_heading,polynom_order);
