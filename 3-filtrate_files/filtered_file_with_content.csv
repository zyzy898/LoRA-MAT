function varargout = circleToPolygon(circle, varargin)


N = 64;
if ~isempty(varargin)
    N = varargin{1};
end

t = linspace(0, 2*pi, N+1)';
x = circle(1) + circle(3) * cos(t);
y = circle(2) + circle(3) * sin(t);

if nargout == 1
    varargout{1} = [x y];
elseif nargout == 2
    varargout{1} = x;
    varargout{2} = y;    
end

end"
