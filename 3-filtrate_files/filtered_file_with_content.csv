                       [F_left,F_right] = TVDflux1d(u,a(i),dtdx,phi);
                        u_next = u - dtdx*(F_right - F_left) ...
                        + (dt/r_time)*(u_eq-u);
                        u_next(1) = u_next(2);
                        u_next(nx) = u_next(nx-1);
                         u = u_next;                
                         f(i,:) = u(:);                         
                 end
                   [n,j_x,E] = macromoments1d(k,w,f,v);
            
                   [r,ux,t,p,yun] = macroproperties1d(n,j_x,E,nx,nv,theta);
