  Handles.Hs{end+1} = scatter3(sensors.vertices(:,1),...
                               sensors.vertices(:,2),...
                               sensors.vertices(:,3),...
                               50,'bo','filled');
end

if ~usesurf,
  surf.vertices = sensors.vertices;
  surf.faces = convhulln(surf.vertices);
