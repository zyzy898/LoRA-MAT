    cmdFileC{end+1,1} = ['background_max=',num2str(threshold_bone)];
    cmdFileC{end+1,1} = '';
end
cmdFileC(end+1:end+size(ursFileC,2),1) = ursFileC(:);
cell2file(cmdFileC,cmdFileName)"
3738,CreateRandomLogParamSets.m,75.808,100,61.9,60,100.0,57.14,70-80,"function [PRLog] = CreateRandomLogParamSets(Sys, params, ranges, N, varargin)

if ~isempty(find(sign(ranges)<0,1))
    error('CreateRandomLogParamSets:rangeBound',...
            'Range limits must be positive or null.');
end

if ischar(params)
    params = {params};
end

nbParam = numel(params);

if(nbParam~=numel(unique(params)))
    error('CreateRandomLogParamSets:duplicateParam',...
            ['When refining, it must not be more than one time a '...
            'parameter']);
end

strictlyInside = nargin==5 && strcmpi(varargin{1},'strictlyinside');


if(numel(Sys.CVodesOptions.AbsTol)==1)
    ranges(ranges==0) = Sys.CVodesOptions.AbsTol;
else
    ranges(ranges==0) = Sys.CVodesOptions.AbsTol(ranges==0);
end

ranges = log10(ranges); %from normal scale to log scale

PRLog = CreateParamSet(Sys, params, ranges);
if(strictlyInside)
    PRLog = QuasiRefine(PRLog,N,'strictlyInside');
else
    PRLog = QuasiRefine(PRLog,N);
end

val = PRLog.pts(PRLog.dim,:);
PRLog.pts(PRLog.dim,:) = 10.^val;
PRLog.epsi = 10.^(val+PRLog.epsi) - PRLog.pts(PRLog.dim,:); % epsi = sup - value

end"
3739,createRandRegGraph.m,75.0,100,61.33,75,100.0,38.67,70-80,"function A = createRandRegGraph(vertNum, deg)

n = vertNum;
d = deg;
matIter = 10;

if mod(n*d,2)==1   
    disp('createRandRegGraph input err: n*d must be even!');
    A=[];
    return;
end

U = repmat(1:n,1,d);

A=sparse(n,n);

edgesTested=0; 
repetition=1;

while ~isempty(U) && repetition < matIter
    
    edgesTested = edgesTested + 1;

    if mod(edgesTested, 5000)==0 
        fprintf('createRandRegGraph() progress: edges=%d/%d\\n', edgesTested, n*d);    
    end

    i1 = ceil(rand*length(U));
    i2 = ceil(rand*length(U));
    v1 = U(i1);
    v2 = U(i2);

    if (v1 == v2) || (A(v1,v2) == 1)
        
        if (edgesTested == n*d)           
            repetition=repetition+1;            
            edgesTested = 0;
            U = repmat(1:n,1,d);
            A = sparse(n,n);
        end
    else
        A(v1, v2)=1;
        A(v2, v1)=1;
        
        v = sort([i1,i2]);
        U = [U(1:v(1)-1), U(v(1)+1:v(2)-1), U(v(2)+1:end)];
    end
end

msg=isRegularGraph(A);
if ~isempty(msg)    
    disp(msg);
end


function msg=isRegularGraph(G)

msg=[];

if (norm(G-G','fro')>0)
    msg=[msg,' is not symmetric, '];
end

if (max(G(:))>1)
    msg=[msg,sprintf(' has %d parallel edges, ',length(find(G(:)>1)) )];
end

d_vec=sum(G);
if min(d_vec)<d_vec(1) || max(d_vec)>d_vec(1)
    msg=[msg,' not d-regular, '];
end

if (norm(diag(G))>0)
    msg=[msg,sprintf(' has %d self loops, ',length(find(diag(G)>0)) )];
end"
3740,createRaster.m,72.422,80,59.66,75,100.0,47.45,70-80,"function obj = createRaster(obj, varargin)


validRasterValue = {'average' 'linear' 'mask' 'plane'};

p = inputParser;
p.addParameter('CellSize'     , 1        , @(x) isnumeric(x) && x>0);
p.addParameter('RasterValue'  , 'average', @(x) any(strcmpi(x, validRasterValue)));
p.addParameter('SearchRadius' , 3        , @(x) isnumeric(x) && x>0); % for 'RasterValue' 'average' and 'plane'
p.parse(varargin{:});
p = p.Results;


procHierarchy = {'POINTCLOUD' 'RASTER'};
msg('S', procHierarchy);
msg('I', procHierarchy, sprintf('Point cloud label = ''%s''', obj.label));
msg('I', procHierarchy, sprintf('IN: RasterValue = ''%s''', p.RasterValue));
msg('V', p.CellSize, 'IN: CellSize', 'Prec', 2);
if any(strcmpi(p.RasterValue, {'average' 'plane'}))
    msg('V', p.SearchRadius, 'IN: SearchRadius', 'Prec', 2);
end


lim.min = min(obj.X(obj.act,[1 2]));
lim.min = (floor(lim.min/100))*100;

rowCol = [floor((obj.X(obj.act,1)-lim.min(1))/p.CellSize) ...
          floor((obj.X(obj.act,2)-lim.min(2))/p.CellSize)];

rowCol = unique(rowCol, 'rows');

xq = lim.min(1)+p.CellSize/2+rowCol(:,1)*p.CellSize;
yq = lim.min(2)+p.CellSize/2+rowCol(:,2)*p.CellSize;


if strcmpi(p.RasterValue, 'average')
    idxAct = find(obj.act);
    ns = createns(obj.X(idxAct,[1 2]));
    idxSearchRadius = ns.rangesearch([xq yq], p.SearchRadius);
    zq = cellfun(@(x) mean(obj.X(idxAct(x),3)), idxSearchRadius);
end

if strcmpi(p.RasterValue, 'linear')
    F = scatteredInterpolant(obj.X(obj.act,1), obj.X(obj.act,2), obj.X(obj.act,3), 'linear', 'none');
    zq = F(xq, yq);
end

if strcmpi(p.RasterValue, 'Mask')
    zq = 1;
end

if strcmpi(p.RasterValue, 'plane')
    idxAct = find(obj.act);
    msg('S', {procHierarchy{:} 'BUILD 2D KD-TREE'});
    ns = createns(obj.X(idxAct,[1 2]));
    msg('E', {procHierarchy{:} 'BUILD 2D KD-TREE'});
    msg('S', {procHierarchy{:} 'NNSEARCH'});
    idxSearchRadius = ns.rangesearch([xq yq], p.SearchRadius);
    msg('E', {procHierarchy{:} 'NNSEARCH'});

    msg('S', {procHierarchy{:} 'PLANE INTERPOLATION'});
    for c = 1:numel(xq)

        x = obj.X(idxAct(idxSearchRadius{c}),1);
        y = obj.X(idxAct(idxSearchRadius{c}),2);
        z = obj.X(idxAct(idxSearchRadius{c}),3);

        xm = mean(x);
        ym = mean(y);
        zm = mean(z);

        C = cov([x-xm, y-ym, z-zm]);
        [V, ~] = eig(C);
        n = V(:,1);

        if numel(n) ~= 3
            zq(c) = NaN;
        else
            zq(c) = zm - (n(1)*(xq(c)-xm) + n(2)*(yq(c)-ym)) / n(3);
        end

    end
    msg('E', {procHierarchy{:} 'PLANE INTERPOLATION'});

end


sizeA = max(rowCol)-min(rowCol)+1;

W = [p.CellSize           0 min(xq)
              0 -p.CellSize max(yq)];

R = maprasterref(W, [sizeA(2) sizeA(1)]); % cols -> x, rows -> y

A = NaN(sizeA);

idxLin = sub2ind(size(A), rowCol(:,1)-min(rowCol(:,1))+1, ...
                          rowCol(:,2)-min(rowCol(:,2))+1);

A(idxLin) = zq;

A = flipud(A');

if strcmpi(p.RasterValue, 'mask')
    RedPoi = [obj.redPoi(1) obj.redPoi(2) 0]; % no height reduction
else
    RedPoi = obj.redPoi;
end

obj.raster = raster({A R}, ...
                    obj.label, ...
                    'RedPoi', RedPoi);


msg('E', procHierarchy);



end"
3741,createRateLimiter.m,71.99,100,68.97,45,100.0,45.98,70-80,"function SubsysHandle = createRateLimiter( simulinkPth, RLBlkName, xyPos,...
    gainStrEntry, risingSlewRate, fallingSlewRate, setColor )


    xWidth = 170;
    yWidth = 30;

    SubsysFullPth = [ simulinkPth, '/', RLBlkName ];
    SubsysHandle = add_block( 'built-in/Subsystem', SubsysFullPth, ...
        'MAKENAMEUNIQUE', 'ON' );
    SubsysFullPth = [ simulinkPth, '/', get_param( SubsysHandle, 'Name' ) ];

    SubsysBlkPos = [ xyPos(1),   xyPos(2),   xyPos(1) + xWidth,   xyPos(2 ) +  yWidth ];
    set_param( SubsysHandle, 'Position', SubsysBlkPos );

    inPortName = 'RateLimiter Input';
    outPortName = 'RateLimiter Output';
    inPortNamePth = [ SubsysFullPth, '/', inPortName ];
    outPortNamePth = [ SubsysFullPth, '/', outPortName ];

    inputHandle = add_block( 'simulink/Sources/In1', inPortNamePth,...
        'MAKENAMEUNIQUE', 'ON' );
    outputHandle = add_block( 'simulink/Sinks/Out1', outPortNamePth,...
        'MAKENAMEUNIQUE', 'ON' );

    if setColor
        set_param( inputHandle, 'BackgroundColor', 'green' );
        set_param( outputHandle, 'BackgroundColor', 'red' );
    end

    inPortHandle = get_param( inputHandle, 'PortHandles' );
    inPortHandleOutport = inPortHandle.Outport;

    outPortHandle = get_param( outputHandle, 'PortHandles' );


    sumNamePth = [ SubsysFullPth, '/', 'Sum' ];
    sumHandle = add_block( 'built-in/Sum', sumNamePth,...
        'MAKENAMEUNIQUE', 'ON', 'IconShape', 'round', 'Inputs', '|+-' );
    sumPos = get_param( sumHandle, 'Position' );
    sumPos = [ sumPos(1), sumPos(2), sumPos(1) + 20 sumPos(2) + 20 ];
    set_param( sumHandle, 'Position', sumPos );
    sumPos = getHorizPosOf( inPortHandleOutport, sumHandle, +30 );
    set_param( sumHandle, 'Position', sumPos );
    sumPortHandle = get_param( sumHandle, 'PortHandles' );

    gainNamePth = [ SubsysFullPth, '/', 'Gain' ];
    gainHandle = add_block( 'built-in/Gain', gainNamePth,...
        'MAKENAMEUNIQUE', 'ON' );
    gainPos = getHorizPosOf( sumPortHandle.Outport, sumHandle, +30 );
    set_param( gainHandle, 'Position', gainPos );
    set_param( gainHandle, 'Gain', gainStrEntry );
    gainPortHandle = get_param( gainHandle, 'PortHandles' );

    integratorNamePth = [ SubsysFullPth, '/', 'Integrator' ];
    integratorHandle = add_block( 'built-in/DiscreteIntegrator', integratorNamePth,...
        'MAKENAMEUNIQUE', 'ON' );
    integratorPos = getHorizPosOf( gainPortHandle.Outport, integratorHandle, ...
        +90 );
    set_param( integratorHandle, 'Position', integratorPos );
    integratorPortHandle = get_param( integratorHandle, 'PortHandles' );
    set_param( integratorHandle, 'SampleTime', '-1' );

    satFullPth = [ SubsysFullPth, '/', 'Saturation' ];
    saturationHandle = add_block( 'simulink/Discontinuities/Saturation', satFullPth, ...
    'MAKENAMEUNIQUE', 'ON' );
    satPos = getHorizPosOf( gainPortHandle.Outport, saturationHandle, ...
        +30 );
    set_param( saturationHandle, 'Position', satPos );
    saturationPortHandle = get_param( saturationHandle, 'PortHandles' );

    outpuPos = getHorizPosOf( integratorPortHandle.Outport, outputHandle, 30 );
    set_param( outputHandle, 'Position', outpuPos );

    add_line( SubsysFullPth, inPortHandle.Outport, sumPortHandle.Inport(1),...
            'autorouting','on');
    add_line( SubsysFullPth, integratorPortHandle.Outport, sumPortHandle.Inport(2),...
            'autorouting','on');
    add_line( SubsysFullPth, sumPortHandle.Outport, gainPortHandle.Inport,...
            'autorouting','on');
    add_line( SubsysFullPth, gainPortHandle.Outport, saturationPortHandle.Inport,...
            'autorouting','on');
    add_line( SubsysFullPth, saturationPortHandle.Outport, integratorPortHandle.Inport,...
            'autorouting','on');
    add_line( SubsysFullPth, integratorPortHandle.Outport, outPortHandle.Inport,...
            'autorouting','on');
end"
