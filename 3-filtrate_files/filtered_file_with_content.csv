5750,DEM_evidence_accumulation.m,72.0,100,65.0,45,100.0,50.0,70-80,"function DEM = DEM_evidence_accumulation
 
 
 
 
 
M(1).E.s = 1/2;                                % smoothness
M(1).E.n = 3;                                  % order of
