3943,cRosenSuzuki.m,78.0,60,100.0,30,100.0,100.0,70-80,"function [c,ceq,GC,GCeq]=cRosenSuzuki(x)
x=x(:);
c = [ [1, -1, 1, -1]*x + [1, 1, 1, 1]*x.^2 - 8
      [-1, 0, 0, -1]*x + [1, 2, 1, 2]*x.^2 - 10
      [2, -1, 0, -1]*x + [2, 1, 1, 0]*x.^2 - 5];
ceq = [];
GC  = [ [1, -1, 1, -1] + [1, 1, 1, 1].*x'*2
        [-1, 0, 0, -1] + [1, 2, 1, 2].*x'*2
        [2, -1, 0, -1] + [2, 1, 1, 0].*x'*2]';
GCeq = [];
end"
3944,crossARH.m,72.0,30,100.0,30,100.0,100.0,70-80,"function [w] = crossARH(u,v)
