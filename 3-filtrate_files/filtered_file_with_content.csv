2784,ConstructHaarMat.m,76.5,60,81.25,60,100.0,81.25,70-80,"function HaarTransformationMatrix=ConstructHaarMat(WidthOfSquareMatrix)

n=WidthOfSquareMatrix; % copy the parameter

Level=log2(n);
if 2^Level<n, error('please ensure the value of input parameter is the power of 2');end 

H=[1];
NC=1/sqrt(2);%normalization constant
LP=[1 1]; 
HP=[1 -1];

for i=1:Level
    H=NC*[kron(H,LP);kron(eye(size(H)),HP)];
end
HaarTransformationMatrix=H;"
2785,constructheaderstringc.m,72.592,80,51.75,75,100.0,56.21,70-80,"function [hFString] = constructheaderstringc(CGen,hStruct)

