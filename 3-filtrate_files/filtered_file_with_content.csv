475,Conv.m,82.0,100,90.62,60,100.0,59.38,80-90,"function Z=conv(X,Y)

if isnumeric(X)
    temp = X;
    X = Y;
    Y = temp;
end
if isa(X,'sdpvar') & isa(Y,'sdpvar')
    error('nonlinear CONV not supported yet. Make feature request');
end
x_lmi_variables = X.lmi_variables;
n = X.dim(1);
m = X.dim(2);
Z=X;
ii = [];
jj = [];
ss = [];
for i = 1:length(x_lmi_variables)+1
    x=reshape(X.basis(:,i),n,m);
    z=conv(full(x),full(Y));
    [iiz,jjz,ssz] = find(z(:));
    ii = [ii iiz(:)'];
    jj = [jj jjz(:)'+i-1];
    ss = [ss ssz(:)'];    
end  
Z.basis = sparse(ii,jj,ss);
Z.dim(1) = size(z,1);
Z.dim(2) = size(z,2);
Z = clean(Z);
if isa(Z,'sdpvar')
    Z.conicinfo = [0 0];    
end"
476,conv2bim.m,84.446,100,66.67,100,100.0,55.56,80-90,"function [bim, mins] = conv2bim(inObjectName, resampleFactor, saveBIM)

bim = [];
mins = [];

if ~ischar(inObjectName)
    disp('inObjectName should a string of input filename or list of input filenames');
    return;
elseif ~exist(inObjectName, 'file')
    disp('Input object file does not exist');
    return;
end

[path,name,ext] = fileparts(inObjectName);

if strcmp(lower(ext), '.txt')
    token = 'TRACE';
elseif strcmp(lower(ext), '.hdr') | strcmp(lower(ext), '.nii')
    token = 'NIfTI';
else
    disp('This file format can not be processed');
    return;
end

switch (token)
    case 'TRACE'
    case 'NIfTI'
        [bim, mins] = NIfTI2bim(inObjectName, resampleFactor);    
end

if (saveBIM)
    new_name = [name '_bim'];
