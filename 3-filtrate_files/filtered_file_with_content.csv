zMax=max(V(indV_FE_bottom,3));
zThreshold=zMax-(h/2);

indV_bottom=unique(F_bottom(:));
indV_bottomTop=indV_FE_bottom(V(indV_FE_bottom,3)>zThreshold);


F_side=Fb(Cb==2,:);

logicSideBottom=all(ismember(F_side,indV_FE_bottom),2);
