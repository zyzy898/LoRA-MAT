2512,comp_fwtpack2cell.m,71.476,60,80.95,45,100.0,71.43,70-80,"function ccell=comp_fwtpack2cell(F,c)

w = F.g;
filtNo = numel(w.g);
J = F.J;
subbNo = (filtNo-1)*J+1;
Lc = zeros(subbNo,1);

runPtr = 0;
levelLen = size(c,1)/F.red;

for jj=1:J
     for ff=filtNo:-1:2
        Lc(end-runPtr) = ceil(levelLen/w.a(ff));
