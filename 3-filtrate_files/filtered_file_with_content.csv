plot(get(gca,'XLim'),[1 1]*c,'r--','LineWidth',2)
plot([1 1]*W/(2*pi),get(gca,'YLim'),'b--','LineWidth',2)
hold off
set(gca,'YDir','normal')
xlabel('\\Omega/2\\pi','FontSize',11)
title('Stability Region','FontSize',11,'FontWeight','bold')
grid on

