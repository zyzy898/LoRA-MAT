DD    = kron(eye(m,m) + 1/8,D*ones(1,length(D)));
DD    = DD*diag(1./sum(DD));
for j = 1:128
    
    MDP.D  = kron(ones(m,1)/m,D);
    RDP.D  = kron(ones(m,1)/m,D);
    ss     = find(rand < cumsum(ones(1,m)/m),1);
