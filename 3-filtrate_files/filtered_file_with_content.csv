Ytest = Ytest.*repmat(origScale, size(Ytest, 1), 1);

options = fgplvmOptions('fitc');
options.optimiser = 'conjgrad';
options.back = 'mlp';
options.backOptions = mlpOptions(10);
options.numActive = 100;
