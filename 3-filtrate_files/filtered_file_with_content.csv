Eq     = Eq/7; Sq = Sq/7;
txt{2} = sprintf(' Cases/day : %.0f (%0.0f - %.0f)',Eq(j),Eq(j) - Sq(j),Eq(j) + Sq(j));
Eq     = Eq/exp(Ep.N)/10; Sq = Sq/exp(Ep.N)/10;
