6710,CS4300_Tell.m,69.0,60,56.67,75,100.0,53.33,61-70,"function KB_out = CS4300_Tell(KB,sentence)

for clause = sentence
    
    if length(clause) == 1
        if clause == 81
            for i = length(KB):-1:1
                KB_clause = KB(i).clauses;
                if any(abs(KB_clause) > 48)
                    KB(i) = [];
                end
            end
            for i = 65:80
                KB(end + 1).clauses = i;
            end
        else 
            for i = length(KB):-1:1
                KB_clause = KB(i).clauses;
                if length(KB_clause) == 1 && abs(clause) == abs(KB_clause)
                    KB(i) = [];
                end
            end
        end
    end
    if ~any(abs(clause) == 81)
        KB(end + 1).clauses = clause;
    end
end

KB_out = KB;"
6711,collimator2Scan.m,66.53,100,67.65,15,100.0,50.0,61-70,"function scan3V = collimator2Scan(coll3V, gantryAngle, couchAngle, collimatorAngle, isocenter, isodistance)

transM = eye(4);
transM = transM([1 2 3], :);

collRot  = [cos(collimatorAngle)     sin(collimatorAngle)     0;...
            -sin(collimatorAngle)    cos(collimatorAngle)     0;...
            0                   0                             1];

transM = inv(collRot) * transM;

transM(3,4) = transM(3,4) + isodistance;

gantryRot = [cos(gantryAngle)   0   -sin(gantryAngle);...
             0                  1                   0;...
             sin(gantryAngle)   0   cos(gantryAngle)];
     
transM = inv(gantryRot) * transM;

couchRot = [cos(couchAngle)     sin(couchAngle)     0;...
            -sin(couchAngle)    cos(couchAngle)     0;...
            0                   0                   1];
    
transM = couchRot * transM;

transM = transM([1 3 2],:);

transM(3,:) = -transM(3,:);

transM(1,4) = transM(1,4) + isocenter(1);
transM(2,4) = transM(2,4) + isocenter(2);
transM(3,4) = transM(3,4) + isocenter(3);

scan3V = applyTransM(transM, coll3V);"
