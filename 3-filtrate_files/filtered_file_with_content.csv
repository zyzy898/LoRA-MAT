    PopObj(:,1) = X1 .* X2 + sum1;
    PopObj(:,2) = X2 .* (1 - X1) +  sum1;
    PopObj(:,3) = 1 - X2 + sum1;
    PopCon(:,1) = b - sin(a * pi * X1);
