5165,DemoAll.m,74.2,100,78.0,45,100.0,48.0,70-80,"k2=Kin2('color','depth','infrared','body_index','body', ...
'face','HDface');

depth = zeros(424,512,'uint16');
color = zeros(1080,1920,3,'uint8');
d.h=figure; d.ax=axes; d.im=imshow(depth,[0 4000]);
