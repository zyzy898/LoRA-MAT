3416,covDiv.m,79.714,100,62.86,90,100.0,45.71,70-80,"function cdVec = covDiv(gl, gu, vecU, vecD, idxDiv, idxVec, delta, stairSel)

diff_1_gl = cell(4, 4, 4);
s = size(gl{1, 1});
for i = 1:4
    for j = 1:4
        if i == 2 && j == 2 && s(2) == 1
            phiphiFlag = 1;
        else
            phiphiFlag = 0;
        end
        for k = 1:4
            diff_1_gl{i, j, k} = takeFiniteDifference1(gl{i, j}, k, delta, phiphiFlag);
        end
    end
end

if stairSel == 0 
    cdVec = takeFiniteDifference1(vecD{idxVec}, idxDiv, delta, 0);
    for i = 1:4
        Gamma = getChristoffelSym(gu, diff_1_gl, i, idxVec, idxDiv);
        cdVec = cdVec-Gamma .* vecD{i};
    end
elseif stairSel == 1 %covariant dereivative of contravariant vector
    cdVec = takeFiniteDifference1(vecU{idxVec}, idxDiv, delta, 0);
    for i = 1:4
        Gamma = getChristoffelSym(gu, diff_1_gl, idxVec, idxDiv, i);
        cdVec = cdVec+Gamma .* vecU{i};
    end
else
    error('Invalid variance selected')
end


end"
3417,cover2d.m,72.488,100,68.29,60,100.0,34.15,70-80,"function [cnt, grd1,grd2] =cover2d(x, delta1, delta2)

x1 = x(1,:);
xmin1 = min(x1); 
xmax1 = max(x1);

if nargin<=1
    delta1 = (xmax1-xmin1)/10; 
end
grd1 = xmin1:delta1:xmax1;

Gabove1 = repmat(grd1', 1, size(x1,2));
Gbelow1 = Gabove1(2:end,:);
