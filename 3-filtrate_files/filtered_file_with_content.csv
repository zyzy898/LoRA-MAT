1676,coldwtfilt.m,73.896,60,79.31,75,100.0,55.17,70-80,"function Y = coldwtfilt(X, h, offset)

[r,c] = size(X);
if rem(r,2) > 0
   error('No of rows in X must be a multiple of 2!');
end

m = length(h);
m2 = fix(m/2);

if any(X(:))
   if rem(m,2),  % Odd length h.
      xe = reflect([(1-m2):(r+m2)], 1, r); % Use 'reflect' so r < m2 works OK.
      t1 = [1:2:(r+m-2)] + offset; 
      t2 = [2:2:(r+m-3)] + offset;
   else          % Even length h.
      xe = reflect([(1-m2):(r+m2)], 0.5, r+0.5); % Use 'reflect' so r < m2 works OK.
      t2 = 2:2:(r+m-2); 
      t1 = 3:2:(r+m-1);
   end 
   
   ho = h(1:2:m); 
   he = h(2:2:m);
   
   Y = conv2(X(xe(t1),:),ho(:),'valid') + conv2(X(xe(t2),:),he(:),'valid');
else
   Y = zeros(r/2,c);
end
return;"
