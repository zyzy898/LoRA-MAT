                            'lat=%f&' ...
                            'lon=%f&' ...
                            'format=json&' ...
                            'addressdetails=1&' ...
                            'namedetails=0&' ...
                            'extratags=0'], lat, lon);
                    else
                        fprintf('Requesting location info of (%.4f, %.4f) from mapquestapi.com\\n', lat, lon);
                        request_url = sprintf(['http://open.mapquestapi.com/nominatim/v1/reverse.php?' ...
                            'key=%s&', ...
                            'format=json&' ...
                            'lat=%f&' ...
