4295,cumtrapz.m,79.566,60,82.61,90,100.0,65.22,70-80,"function X=cumtrapz(X,I)

if nargin == 1 && min(X.dim)==1
    B = cumtrapz(X.basis);
else
    if nargin == 1
        I = find(X.dim>1,1);
        if isempty(I)
            I = 1;
        end
    end
    
    B = [];
    for i = 1:length(X.lmi_variables)+1
        C = reshape(X.basis(:,i),X.dim);
        C = cumtrapz(C,I);
        B = [B C(:)];
    end
end
X.basis = B;
X.conicinfo = [0 0];
X.extra.opname = '';
X = clean(X);"
4296,cumtrapzf.m,70.666,60,73.33,60,100.0,60.0,70-80,"function z = cumtrapzf(x,y)

m = numel(x);
if m == 1;
    z = 0;
    return
end

x = x(:);
y = y(:);

dt = diff(x,1,1)/2;
z  = [0; cumsum(dt .* (y(1:m-1,:) + y(2:m,:)),1)];

end"
4297,cumulant.m,79.626,100,96.88,45,100.0,56.25,70-80,"function [co]=cumulant(Y)
[N,~]=size(Y);
co=zeros(N,10);
for i=1:N
    y=Y(i,:);
    cy=conj(y);
    M20=moment1(y,cy,2,0);
    M21=moment1(y,cy,2,1);
    M22=moment1(y,cy,2,2);
    M40=moment1(y,cy,4,0);
    M41=moment1(y,cy,4,1);
    M42=moment1(y,cy,4,2);
    M43=moment1(y,cy,4,3);
    M60=moment1(y,cy,6,0);
    M61=moment1(y,cy,6,1);
    M62=moment1(y,cy,6,2);
    M63=moment1(y,cy,6,3);
    M80=moment1(y,cy,8,0);
    C20=M20;
    C21=M21;
    C40=M40-3*M20^2;
    C41=M41-3*M20*M21;
    C42=M42-abs(M20)^2-2*M21^2;
    C60=M60-15*M40*M20+30*M20^3;
    C61=M61-5*M40*M21-10*M41*M20+30*M20^2*M21;
    C62=M62-6*M42*M20-8*M41*M21-M40*M22+6*M20^2*M22+24*M21^2*M20;
    C63=M63-9*M42*M21+12*M21^3-3*M43*M20-3*M41*M22+18*M22*M21*M20;
    C80=M80-28*M60*M20-35*M40^2+420*M40*M20^2-630*M20^4;
    co(i,:)=[C20,C21,C40^(1/2),C41^(1/2),C42^(1/2),C60^(1/3),C61^(1/3),C62^(1/3),C63^(1/3),C80^(1/4)];
end
co=[real(co),imag(co)];
end"
4298,cumulants4Moments.m,70.742,80,60.38,60,100.0,53.33,70-80,"function cumMat=cumulants4Moments(momentMat)

numDimList=size(momentMat);
maxDeg=numDimList(1)-1;
numIdx=length(numDimList);

if(numIdx==2&&numDimList(2)==1)
    numIdx=1;
end

binomTable=makeBinomTable(maxDeg);

cumMat=zeros(numDimList);
negCumMomMat=zeros(numDimList);

negCumMomMat(1)=1;
cumMat(1)=0;

for n=1:maxDeg
    cumMat(n+1)=momentMat(n+1);
    for i=1:(n-1)
        cumMat(n+1)=cumMat(n+1)-binomTable(n-1+1,i+1)*cumMat(n-i+1)*momentMat(i+1);
    end
    
    for i=0:(n-1)
        negCumMomMat(n+1)=negCumMomMat(n+1)+binomTable(n-1+1,i+1)*(-cumMat(n-i+1))*negCumMomMat(i+1);
    end
end

for numNonzeroIdx=2:numIdx
    for nonzeroDegVal=1:maxDeg
        for curDeg=0:(maxDeg-nonzeroDegVal)
            curPart=getNextMPartition(numNonzeroIdx-1+curDeg,numNonzeroIdx-1);
            while(~isempty(curPart))
                lowerIdxPerms=genAllMultisetPermutations(curPart);
                numPerms=size(lowerIdxPerms,2);
                
                for curPerm=1:numPerms
                    r=[lowerIdxPerms(:,curPerm)-1;nonzeroDegVal];
                    
                    idxVal=nDim2Index(numDimList(1:numNonzeroIdx),r+1);

                    cumMat(idxVal)=equation1012Update(r,momentMat,negCumMomMat,1,binomTable);
                    
                    negCumMomMat(idxVal)=equation1012Update(r,cumMat,negCumMomMat,-1,binomTable);
                end
                curPart=getNextMPartition(curPart);
            end
        end
    end
end

end

function sumVal=equation1012Update(r,mat1,mat2,signMat1,binomTable)

numIdx=length(r);
maxDim=size(mat2);
maxDim=maxDim(1:numIdx);%Only the first numIdx indices are considered.

binomProdVal=ones(numIdx-1,1);

iVec=zeros(numIdx,1);

curLevel=numIdx;
isAscending=false;
sumVal=0;
while(curLevel>=1)
    if(curLevel==numIdx)
        for i=0:(r(numIdx)-1)
            binomVal=binomProdVal(numIdx-1)*binomTable(r(numIdx)-1+1,i+1);
            
            iVec(numIdx)=i;
            kIdxVec=r-iVec;
            
            idx=nDim2Index(maxDim,iVec+1);
            kidx=nDim2Index(maxDim,kIdxVec+1);
            
            sumVal=sumVal+binomVal*(signMat1*mat1(kidx))*mat2(idx);
        end
        curLevel=curLevel-1;
        isAscending=true;
        continue;
    elseif(isAscending)
        iVec(curLevel)=iVec(curLevel)+1;
        if(iVec(curLevel)<=r(curLevel))
            if(curLevel~=1)
                binomProdVal(curLevel)=binomProdVal(curLevel-1)*binomTable(r(curLevel)+1,iVec(curLevel)+1);
            else
                binomProdVal(curLevel)=binomTable(r(curLevel)+1,iVec(curLevel)+1);
            end
            isAscending=false;
            curLevel=curLevel+1;
            continue;
        else
            curLevel=curLevel-1;
            continue;
        end
    else%We are descending in the sums here.
        iVec(curLevel)=0;
        binomProdVal(curLevel)=binomProdVal(curLevel-1);
        curLevel=curLevel+1;
    end
end

end"
4299,cumulative_histogram_mapping.m,76.43,100,64.29,75,100.0,42.86,70-80,"function [new_im_dst, chist_dst, chist_ref, map, M] = cumulative_histogram_mapping(im_dst, im_ref, edges)


[N,d] = size(im_ref);
   
for i=1:d
    cens{i} = (edges{i}(1:end-1)+edges{i}(2:end))/2;    
    chist_dst{i} = compute_cumulative_histogram(im_dst(:,i), edges{i});
    chist_ref{i} = compute_cumulative_histogram(im_ref(:,i), edges{i});
    
    [map{i}, M{i}] = map_cumulative_histograms(chist_dst{i}, chist_ref{i}, edges{i}, cens{i}, im_ref(:,i));
end

new_im_dst = convert_image(im_dst, map, edges);


function chist = compute_cumulative_histogram(data, edges)

data = double(data(:));

H = histc(data, edges); 
H = H(1:end-1);  % discard the last fake bin
nhist = H/sum(H);  % normalized histogram
chist = cumsum(nhist);


function [map, M] = map_cumulative_histograms(chist_dst, chist_ref, edges, cens, im_ref)

n = length(chist_dst);

M = zeros(n,1);
t = 1;  % searching starting point
for v=1:n
    chist_diff = chist_ref - chist_dst(v);
    idx = find(chist_diff<=0);
    if isempty(idx)
        M(v) = 1;
    else
        M(v) = idx(end);
    end
end

for i=1:n
    map(i) = cens(M(i));
end

im_ref = double(im_ref(:));
data = im_ref(find(edges(1)<=im_ref & im_ref<edges(2)));
St = sum(data)./length(data);
map(find(M==1)) = St;

data = im_ref(find(edges(n)<=im_ref & im_ref<edges(n+1)));
Su = sum(data)./length(data);
map(find(M==n)) = Su;


function new_im = convert_image(im, map, edges)

[N,d] = size(im);
new_im = zeros(N,d);

for i=1:d  % for each channle
    curr_map = map{i};
    curr_edges = edges{i};
    
    for j=1:length(curr_map)  % for each histgram bin
        idx = find(curr_edges(j)<=im(:,i) & im(:,i)<curr_edges(j+1));
        new_im(idx,i) = curr_map(j);
    end
end"
4300,cunion.m,74.0,60,56.67,100,100.0,53.33,70-80,"function [u,ind] = cunion(s,eqfun)

if isempty(s)
	u = [];
    return
else
		
	if isa(s,'double')
		u = s(1);
    ind = 1;
		
		for i=1:length(s)
			if ~any(isnull(abs(u-s(i))))
				u = [u,s(i)]; %#ok<AGROW>
        ind = [ind,i];%#ok<AGROW>
			end
		end
	else
		u = s(1);
    ind = 1;
    if nargin == 1, eqfun = @(a,b) isnull(norm(a-b));end
		
		for i=1:length(s)
			if ~any(eqfun(u,s(i)))
				u = [u,s(i)]; %#ok<AGROW>
        ind = [ind,i]; %#ok<AGROW>
			end
		end
	end
end"
