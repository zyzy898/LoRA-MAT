5684,DEM_birdsong.m,73.714,100,70.0,60,100.0,38.57,70-80,"function [S] = DEM_birdsong(file)


if ~nargin
    file = fullfile(fileparts(mfilename('fullpath')),'lebi3.wav');
end
if spm_check_version('matlab','8.0') > 0
    [Y,FS] = audioread(file);
else
    [Y,FS] = wavread(file); %#ok
end

Y   = Y(1:2^15);
T   = length(Y)/FS;                   % duration (seconds)

Nm  = 3;                              % number of frequency modes
cpw = 4;                              % minimum cycles per window
pst = (1:length(Y))/FS;               % peristimulus time (seconds)
Hz  = (1:64)*4000/64;                 % frequencies
k   = cpw*Hz/Hz(1);
n   = cpw*FS/Hz(1);

C   = spm_wft(Y(:),k,n);
C   = spm_conv(C,8,1);
Y   = spm_iwft(C,k,n);

U   = spm_svd(C*C');
U   = U(:,1:Nm);
V   = U'*C;
c   = U*V;

y   = spm_iwft(c,k,n);
y   = y/max(abs(y));

S.U  = U;
S.V  = V;
S.Hz = Hz;


subplot(2,2,1)
imagesc(pst,Hz,abs(C))
axis xy
xlabel('Time (sec)')
ylabel('Frequency (Hz)')
title('(with three modes')

h      = get(gca,'Children');
set(h(1),'Userdata',{Y,FS})
set(h(1),'ButtonDownFcn','spm_DEM_ButtonDownFcn')

subplot(2,2,2)
imagesc(pst,Hz,abs(c))
axis xy
xlabel('Time (sec)')
ylabel('Frequency (Hz)')
title('spectrogram')

h      = get(gca,'Children');
set(h(1),'Userdata',{y,FS})
set(h(1),'ButtonDownFcn','spm_DEM_ButtonDownFcn')

subplot(2,2,3)
plot(Hz,U)
xlabel('Frequency (Hz)')
title('Frequency modes')

subplot(2,2,4)
plot(pst,V)
xlabel('Time (sec)')
title('temporal modes')"
5685,DEM_cells.m,77.544,80,66.67,100,100.0,41.05,70-80,"function DEM = DEM_cells

 

clear global
rng('default')
N         = 32;                              % duration of process

M(1).E.d  = 1;                               % approximation order
M(1).E.n  = 2;                               % embedding order
M(1).E.s  = 1;                               % smoothness
M(1).E.dt = 2;                               % time step

n     = [1 6 9];                             % internal, active and sensory
r     = [0 1 3];                             % radial distance from centre
pos   = [];                                  % position
typ   = [];                                  % cell type
for j = 1:length(n)
    for i = 1:n(j)
        pos(:,end + 1) = r(j)*[sin(2*pi*i/n(j));cos(2*pi*i/n(j))];
        typ(j,end + 1) = 1;
    end
end

sen   = foxhound(pos,typ);
for i = 1:3
    P.sen(:,i) = mean(sen(:,find(typ(i,:))),2);
end

disp(P.sen)

v     = typ/2 + randn(size(typ))/8;          % states (identity)                          % predicted sensations
a.pos = pos/2 + randn(size(pos))/8;          % chemotaxis
a.sec = spm_softmax(v);                      % secretion
g     = Mg([],v,P);
   
n     = sum(n);                              % number of cells
ns(1) = size(g.sec,1);                       % number of secretions
ns(2) = size(g.sen,1);                       % number of sensations
na(1) = size(a.pos,1);                       % number of positions
na(2) = size(a.sec,1);                       % number of secretions

In    = eye(n,n);
R     = spm_cat({kron(In,ones(ns(1),na(1))) kron(In,ones(ns(1),na(2)));
                 kron(In,ones(ns(2),na(1))) kron(In,ones(ns(2),na(2)))});

G(1).g  = @(x,v,a,P) Gg(x,v,a,P);
G(1).v  = Gg([],[],a,a);
G(1).V  = exp(16);                           % precision (noise)
G(1).U  = exp(-2);                           % precision (action)
G(1).R  = R;                                 % rate matrix
G(1).pE = a;                                 % form (action)
G(1).aP = exp(-8);                           % precision (action)


G(2).a  = spm_vec(a);                        % endogenous cause (action)
G(2).v  = 0;                                 % exogenous  cause
G(2).V  = exp(16);



M(1).g  = @(x,v,P) Mg([],v,P);
M(1).v  = g;
M(1).V  = exp(4);                            % precision of sensations
M(1).pE = P;

M(2).v  = v;
M(2).V  = exp(-4);                           % prior precision of identity

U     = zeros(n*3,N);
C     = zeros(1,N);

DEM.M = M;
DEM.G = G;
DEM.C = C;
DEM.U = U;

DEM   = spm_ADEM(DEM);
spm_DEM_qU(DEM.qU,DEM.pU);



subplot(2,2,2)
for t = 1:N
    v = spm_unvec(DEM.qU.a{2}(:,t),a);
    c = spm_unvec(DEM.qU.v{2}(:,t),DEM.M(2).v);
    for i = 1:n
        x = v.pos(1,i);
        y = v.pos(2,i);
        R = spm_softmax(c(:,i),2);
        plot(x,y,'o','markersize',4,'markeredgecolor',[0 0 0],'markerfacecolor',R); hold on
        if t == N
            plot(x,y,'o','markersize',10,'markeredgecolor',[0 0 0],'markerfacecolor',R); hold on
        end
    end
    title ('Self-organisation','fontsize',15);
    xlabel('position');
    ylabel('position');
    axis([-1 1 -1 1]*r(end))
    axis equal off, drawnow
end


function g = Gg(x,v,a,P)

a      = spm_unvec(a,P);                   % action
g.sec  = a.sec;                            % secretion
g.sen  = foxhound(a.pos,a.sec);            % sensation

return

function g = Mg(x,v,P)

p      = spm_softmax(v);                   % expected identity
g.sec  = p;                                % secretion
g.sen  = P.sen*p;                          % sensation

return

function sen = foxhound(x,y)


[m,n] = size(y);                          % number of signals and cells
sen   = zeros(m,n);                       % extracellular signals
k     = 2;                                % spatial decay constant
for i = 1:n
    for j = 1:n
        
        d = x(:,i) - x(:,j);
        d = d'*d;
        
        if i ~= j
           sen(:,i) = sen(:,i) + exp(-k*d)*y(:,j);
        end

    end
end
return"
