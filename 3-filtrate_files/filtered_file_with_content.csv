showPotts(f, pottsL1, original, 'L1-Potts')"
6809,comp_idgt_fb.m,57.958,100,33.7,30,100.0,26.09,51-60,"function [f]=comp_idgt_fb(coef,g,L,a,M)


N=L/a;
b=L/M;

W = size(coef,3);

N=L/a;
b=L/M;

gl=length(g);
glh=floor(gl/2);  % gl-half


coef=ifft(coef)*sqrt(M);


g=fftshift(g);

f=zeros(L,W,assert_classname(coef,g));

ff=zeros(gl,1,assert_classname(coef,g));

for w=1:W
  
    
  for n=0:ceil(glh/a)-1
    delay=mod(-n*a+glh,M);
    for ii=0:gl/M-1
      for m=0:delay-1
        ff(m+ii*M+1)=coef(M-delay+m+1,n+1,w)*g(m+ii*M+1);
      end;
      for m=0:M-delay-1
        ff(m+ii*M+delay+1)=coef(m+1,n+1,w)*g(m+delay+ii*M+1);
      end;
    end;
    
    sp=mod(n*a-glh,L);
    ep=mod(n*a-glh+gl-1,L);
    
    for ii=0:L-sp-1
      f(sp+ii+1,w)=f(sp+ii+1,w)+ff(1+ii);
    end;
    for ii=0:ep
      f(1+ii,w)=f(1+ii,w)+ff(L-sp+1+ii); 
    end;
  end;

  for n=ceil(glh/a):floor((L-ceil(gl/2))/a)
    delay=mod(-n*a+glh,M);    
    for ii=0:gl/M-1
      for m=0:delay-1
        ff(m+ii*M+1)=coef(M-delay+m+1,n+1,w)*g(m+ii*M+1);
      end;
      for m=0:M-delay-1
        ff(m+ii*M+delay+1)=coef(m+1,n+1,w)*g(m+delay+ii*M+1);
      end;
    end;

    sp=mod(n*a-glh,L);
    ep=mod(n*a-glh+gl-1,L);
  
    for ii=0:ep-sp
      f(ii+sp+1,w)=f(ii+sp+1,w)+ff(ii+1);
    end;
  end;

  for n=floor((L-ceil(gl/2))/a)+1:N-1
    delay=mod(-n*a+glh,M);
    for ii=0:gl/M-1
      for m=0:delay-1
        ff(m+ii*M+1)=coef(M-delay+m+1,n+1,w)*g(m+ii*M+1);
      end;
      for m=0:M-delay-1
        ff(m+ii*M+delay+1)=coef(m+1,n+1,w)*g(m+delay+ii*M+1);
      end;
    end;
    
    sp=mod(n*a-glh,L);
    ep=mod(n*a-glh+gl-1,L);
    
    for ii=0:L-sp-1
      f(sp+ii+1,w)=f(sp+ii+1,w)+ff(1+ii);
    end;
    for ii=0:ep
      f(1+ii,w)=f(1+ii,w)+ff(L-sp+1+ii); 
    end;
  end;
end;

f=sqrt(M)*f;"
