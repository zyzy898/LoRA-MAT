    case 1
        nConnectivity = 26;
        nDirection = 13;
end

checkOriginal = any(any(any(image3D,3)));
checkReverse  = any(any(any(image3DInverse,3)));

if and(checkOriginal, checkReverse)
    try
        porosity = 1 - imVolumeDensity(image3D);
    catch
