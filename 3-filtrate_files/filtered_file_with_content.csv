            obj.encoding = ones(1,obj.D);
        end
        function PopObj = CalObj(obj,X)
            x_all = X(:,3:1:end); 
            g_1   = sum((x_all - 0.5) .* (x_all - 0.5) - cos(20.0 * pi .* ( x_all - 0.5)),2);
            sum1  = obj.D - 2 + g_1;
            PopObj(:,1) = X(:,1) .* X(:,2) + sum1;
            PopObj(:,2) = X(:,2) .* (1 - X(:,1)) +  sum1;
            PopObj(:,3) = 1 - X(:,2) + sum1;
        end
        function PopCon = CalCon(obj,X)
            x_all  = X(:,3:1:end); 
            g_1    = sum((x_all - 0.5) .* (x_all - 0.5) - cos(20.0 * pi .* ( x_all - 0.5)),2);
            sum1   = obj.D - 2 + g_1;
            PopCon = Constraint(X(:,1),X(:,2),sum1);
        end
        function R = GetOptimum(obj,N)
            R = UniformPoint(N,3);
            X(:,1) = 1./(1+R(:,2)./R(:,1));
            X(:,2) = R(:,1)./X(:,1);
            C(:,1) = -sin(20*pi*X(:,1));
            C(:,2) = -cos(20*pi*X(:,2));
            R(any(C>1e-2,2),:) = [];
            R = R + 0.5;
        end 
        function R = GetPF(obj)
            [X1,X2] = meshgrid(linspace(0,1,100));
            x = X1.*X2;
            y = (1-X1).*X2;
            z = (1-X2);
            fes = all(Constraint(X1(:),X2(:),0.5)<=0,2);
            z(reshape(~fes,size(z))) = nan;
            R = {x+0.5,y+0.5,z+0.5};
        end
    end
