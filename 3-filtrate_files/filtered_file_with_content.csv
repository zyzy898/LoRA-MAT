4587,data2model.m,77.98,80,62.88,100,100.0,47.02,70-80,"function model_out = data2model(data,description,database)


model_out = [];
S = size(data);
data_in = {};
data_out = {};
cnt_in = 1; cnt_out = 1;
for i = 1:size(data,1)
    if data{i,1} == true
        data_in(cnt_in,:) = data(i,:);
        cnt_in = cnt_in + 1;
    else
        data_out(cnt_out,:) = data(i,:);
        cnt_out = cnt_out + 1;
    end
end

data = data_in;

S = size(data);

u_data = unique(data(:,2));
d_entry = [];
if size(u_data,1) ~= size(data,1)
    for i = 1:size(u_data,1)
        if sum(strcmp(u_data{i}, data(:,2))) > 1
            d_entry = [d_entry i];
            
        end
    end
    
    if isempty(d_entry)
        msgbox(['Reactions are non-unique but the script was unable to locate'...
            ' the duplicate entries.'],'Warning','warn');
    else
        str = 'Reactions: ';
        for i = 1:length(d_entry)
            str = [str u_data{d_entry(i)} ' '];
        end
        str = [str ' are accounted for more than once in this model. '...
            'Please fix this and try again.'];
    end
    msgbox(str,'Warning', 'warn');
    return;
end



if isempty(data)
    msgbox('There are no reactions to save.','No reactions.','error');
    return
end

UB = [];
LB = [];
rev = [];
for i = 1:S(1)
    UB(i) = data{i,8};%model creator can't take in cells for ub and lb
    LB(i) = data{i,7};
    if data{i,5} == 0
        rev(i) = false;
    else
        rev(i) = true;
    end
end

model = createModel(data(:,2),data(:,3),data(:,4),rev,LB,...
    UB,data(:,10), data(:,6));


model.mets = columnVector(model.mets);
model.rxns = columnVector(model.rxns);
model.rules = columnVector(model.rules);
model.lb = columnVector(model.lb);
model.ub = columnVector(model.ub);
model.c = columnVector(model.c);
model.grRules = columnVector(model.grRules);
model.subSystems = columnVector(model.subSystems);
model.rxnNames = data(:,3);
model.comments = data(:,12);
model.citations = data(:,11);
model.rxnConfidenceScores = data(:,9);
model.rxnECNumbers = data(:,13);
model.rxnKEGGID = data(:,14);


model.metCharges = {};




if exist('database','var') && isfield(database,'reactions') && isfield(database,'metabolites')
    reactions=database.reactions;
    metabolites=database.metabolites;
else
    reactions   = rBioNetSaveLoad('load','rxn');
    metabolites = rBioNetSaveLoad('load','met');
end

mets = model.mets;



S = length(mets);
missing_met = cell(1,1);
cnt_m = 0;
met_k = cell(S,9); %Add information that is not added with CreateModel.m

for k = 1:S(1) % Check all metabolites in model
    met = regexpi(mets{k},'[','split');
    line = find(strcmp(met{1},metabolites(:,1)),1);
    if isempty(line)
        cnt_m = cnt_m + 1;
        missing_met{cnt_m,1} = met{1};
    else
        met_k{k,1} = metabolites{line,2};   %metNames
        met_k{k,2} = metabolites{line,4};   %metFormulas
        met_k{k,3} = metabolites{line,5};   %metCharges
        met_k{k,4} = metabolites{line,8};   %metChEBIID
        met_k{k,5} = metabolites{line,6};   %metKEGGID
        met_k{k,6} = metabolites{line,7};   %metPubChemID
        met_k{k,7} = metabolites{line,9};   %metInChIString
        met_k{k,8} = metabolites{line,11};  %metHMDB
        met_k{k,9} = metabolites{line,10};  %metSmiles
    end
end


rxns = model.rxns;

S = length(rxns);
missing_rxn = cell(1,size(data,2));
cnt_r = 0;
for k = 1:S(1) % Check all reactions in model
    rxn = rxns{k};
    line = any(strcmp(rxn,reactions(:,1)),1);
    if line == 0
        
        cnt_r = cnt_r + 1;
        missing_rxn(cnt_r,:) = data(k,:);
        
    end
end
answer = [];

if cnt_r ~=0 || cnt_m ~=0
    
    if cnt_r ~=0 && cnt_m ~=0
        m_mets = ['Metabolites: ' mets2str(missing_met) '.'];
        m_rxns = ['Reactions: ' mets2str(missing_rxn(:,2)) '.'];
        
        answer = questdlg(char(m_mets,m_rxns,'',['Are missing from database.'...
            'The reconstruction cannot be completed without them. Do you want',...
            ' to add them now?']),'Missing metabolites/reactions','Yes',...
            'No','Yes');
    elseif cnt_r ~=0 && cnt_m == 0
        m_rxns = ['Reactions: ' mets2str(missing_rxn(:,2)) '.'];
        answer = questdlg(char(m_rxns,'',['Are missing from database.'...
            'The reconstruction cannot be completed without them. Do you want',...
            ' to add them now?']),'Missing metabolites/reactions','Yes',...
            'No','Yes');
    else
        m_mets = ['Metabolites: ' mets2str(missing_met) '.'];
        answer = questdlg(char(m_mets,'',['Are missing from database,'...
            'The reconstruction cannot be completed without them. Do you want',...
            ' to add them now?']),'Missing metabolites/reactions','Yes',...
            'No','Yes');
    end
    
    if isempty(answer)
        answer = 'No';
    end
end

if ~isempty(answer)
    switch answer
        case 'Yes'
            msgbox(['Sorry this option has been disabled. Please go to'...
                ' ReconstructionTool and try the Add reconstruction to db'...
                ' option.'],'Option disabled','error');
            return
        otherwise
            return
    end
end




model.metNames = met_k(:,1);
model.metFormulas = met_k(:,2);
model.metCharges = str2double(met_k(:,3));
model.metChEBIID = met_k(:,4);
model.metKEGGID = met_k(:,5);
model.metPubChemID = met_k(:,6);
model.metInChIString = met_k(:,7);
model.metHMDBID = met_k(:,8);
model.metSmiles = met_k(:,9);



time = clock;
date = [];
for i = 1:length(time)-3
    if isempty(date)
        date = [num2str(round(time(i)))];
    else
        
        date = [date '/' num2str(round(time(i)))];
    end
end

handles.model_description.date = date;


model_description = struct;
model_description.name = description{1};
model_description.organism = description{2};
model_description.author = description{3};
model_description.geneindex = description{4};
model_description.genedate = description{5};
model_description.genesource = description{6};
model_description.notes = description{7};
model.description = model_description;

model.disabled = data_out; %the disabled data follows.

model_out = model;"
4588,data2NonLinSys.m,71.0,80,65.55,60,100.0,49.45,70-80,"function sys = data2NonLinSys(data,functionName,path)



Comp = data.components{1,1};
automaton_id = data.componentID;

functionStr = ""function sys = "" + functionName + ""(~)"";
dateComment = ""%% Generated on "" + datestr(date);
aCommentStr = aux_padComment(""Automaton created from Component '"" + automaton_id + ""'"");
automatonStr = functionStr + aux_newlines(3) + dateComment + aux_newlines(2) + aCommentStr + aux_newlines(2);

infoCommentStr = ""%% Interface Specification:"" + newline +...
    ""%   This section clarifies the meaning of state, input & output dimensions"" + newline +...
    ""%   by showing their mapping to SpaceEx variable names. "" + aux_newlines(2);

infoStr = """";
compInfoStr = ""% Component ("" + Comp.name + ""):"" + newline;
    
stateNames = [Comp.states.name];
stateStr = ""%  state x := ["" + stateNames(1);
if(length(stateNames) > 1)
    stateStr = stateStr + sprintf(""; %s"",stateNames(2:end));
end
stateStr = stateStr + ""]"" + newline;
    
inputNames = [Comp.inputs.name];
inputStr = ""%  input u := ["" + inputNames(1);
if(length(inputNames) > 1)
    inputStr = inputStr + sprintf(""; %s"",inputNames(2:end));
end
inputStr = inputStr + ""]"" + newline;
    
if ~isempty(Comp.outputsGlobal)
    outputNames = [Comp.outputsGlobal.name];
    outputStr = ""%  output y := ["" + outputNames(1);
    if(length(outputNames) > 1)
        outputStr = outputStr + sprintf(""; %s"",outputNames(2:end));
    end
    outputStr = outputStr + ""]"" + aux_newlines(2);
else
    outputStr = newline;
end

infoStr = infoStr + compInfoStr + stateStr + inputStr + outputStr;

automatonStr = automatonStr + infoCommentStr + infoStr;

component_id = Comp.name;
State = Comp.States(1,1);
    
cCommentStr = aux_padComment(""Component "" + component_id) + aux_newlines(2);
componentStr = cCommentStr;

sCommentStr = aux_padComment(""State "" + State.name) + aux_newlines(2);
stateStr = sCommentStr;

dynamicsC = aux_text2comment(""equation:"" + newline + State.Flow.Text) + newline;
if isfield(State.Flow,'A')
    linsysA = printMatrixConverter(State.Flow.A);
    linsysAStr = ""dynA = ..."" + newline + linsysA + "";"" + newline;
    linsysB = printMatrixConverter(State.Flow.B);
    linsysBStr = ""dynB = ..."" + newline + linsysB + "";"" + newline;
    linsysc = printMatrixConverter(State.Flow.c);
    linsyscStr = ""dync = ..."" + newline + linsysc + "";"" + newline;
    if isempty(Comp.outputsGlobal)
        dynamicsStr = dynamicsC + linsysAStr + linsysBStr + linsyscStr + ...
            ""sys = linearSys(dynA, dynB, dync);"" + aux_newlines(2);
    else
        linsysC = printMatrixConverter(State.Flow.C);
        linsysCStr = ""dynC = ..."" + newline + linsysC + "";"" + newline;
        linsysD = printMatrixConverter(State.Flow.D);
        linsysDStr = ""dynD = ..."" + newline + linsysD + "";"" + newline;
        linsysk = printMatrixConverter(State.Flow.k);
        linsyskStr = ""dynk = ..."" + newline + linsysk + "";"" + newline;
        dynamicsStr = dynamicsC + linsysAStr + linsysBStr + linsyscStr + ...
            linsysCStr + linsysDStr + linsyskStr + aux_newlines(2) + ...
            ""sys = linearSys(dynA, dynB, dync, dynC, dynD, dynk);"" + aux_newlines(2);
    end
else
    nonlinName = sprintf(""%s_St%d_FlowEq"",functionName,1);

    statedims = num2str(length(Comp.states));
    inputdims = num2str(length(Comp.inputs));

    printDynamicsFile(path,nonlinName,State.Flow.FormalEqs,'flow');

    dynamicsStr = dynamicsC + ""sys = nonlinearSys(@"" + nonlinName + ...
                  "","" + statedims + "","" + inputdims +""); "" + aux_newlines(2);
end

componentStr = componentStr + stateStr + dynamicsStr;


sys = automatonStr + componentStr + newline + ""end"";

end



function str = aux_padComment(comment,maxLineLength)
    if(nargin<2)
        maxLineLength = 75;
    end
    
    lenComment = strlength(comment);
    lenLeft = floor((maxLineLength - lenComment)/2) - 1;
    lenRight = maxLineLength - lenLeft - lenComment;
    
    str = ""%"" + repmat('-',1,lenLeft-1) + comment + repmat('-',1,lenRight);
end

function str = aux_newlines(lines)
    str = string(repmat(newline(),1,lines));
end

function str = aux_text2comment(text)
    str = ""%% "" + strrep(text,newline,newline + ""%   "");
end"
4589,data2ParallelHA.m,75.178,70,54.89,100,100.0,51.0,70-80,"function HA = data2ParallelHA(data,functionName,resultpath)



components = data.components;
automaton_id = data.componentID;

functionStr = ""function HA = "" + functionName + ""(~)"";
dateComment = ""%% Generated on "" + datestr(datetime);
createdStr = aux_padComment(""Automaton created from Component '"" + automaton_id + ""'"");
automatonStr = functionStr + aux_newlines(3) + dateComment + aux_newlines(2) + createdStr + aux_newlines(2);

infoCommentStr = ""%% Interface Specification:"" + newline +...
    ""%   This section clarifies the meaning of state, input & output dimensions"" + newline +...
    ""%   by showing their mapping to SpaceEx variable names. "" + aux_newlines(2);

nrComp = length(components);
isFlatHA = nrComp == 1;


infoStr = aux_infoStr(components);

automatonStr = automatonStr + infoCommentStr + infoStr;

componentStr = """";

for iComp = 1:nrComp
    comp = components{iComp};
    
    cCommentStr = aux_padComment(""Component "" + comp.name) + aux_newlines(2);
    componentStr = componentStr + cCommentStr;

    componentStr = componentStr + ""clear loc"" + aux_newlines(2);
    
    locs = comp.States;
    
    nrLocs = length(locs);
    for iLoc = 1:nrLocs
        loc = locs(iLoc);
        allTrans = loc.Trans;
        
        locStr = aux_padComment(""Location "" + loc.name) + aux_newlines(2);
        
        dynamicsStr = aux_dynamicsStr(loc,iLoc,comp,iComp,isFlatHA,resultpath,functionName);
        
        invariantStr = aux_invariantStr(loc,allTrans,isFlatHA);
        
        transitionStr = ""trans = transition();"" + newline;

        for iTrans = 1:length(allTrans)
            trans = allTrans(iTrans);
            
            targetStr = num2str(trans.destination);

            resetStr = aux_resetStr(trans,numel(comp.states),numel(comp.inputs),...
                iComp,iLoc,iTrans,isFlatHA,resultpath,functionName);
            
            guardStr = aux_guardStr(trans,loc);

            if ~isFlatHA && strlength(trans.label) > 0
                transStr = ""trans("" + num2str(iTrans) + ...
                    "") = transition(guard, reset, "" + ...
                    targetStr + "", '"" + trans.label + ""');"" + aux_newlines(2);
            else
                transStr = ""trans("" + num2str(iTrans) + ...
                    "") = transition(guard, reset, "" + ...
                    targetStr + "");"" + aux_newlines(2);
            end
            transitionStr = transitionStr + resetStr + guardStr + transStr;
            
        end
        
        if locs(iLoc).name == """"
            locName = ""S"" + iLoc;
        else
            locName = locs(iLoc).name;
        end
        locNameStr = ""loc("" + num2str(iLoc) + "") = location('"" + locName + ...
            ""', inv, trans, dynamics);"" + aux_newlines(4);

        locStr = locStr + dynamicsStr + invariantStr + transitionStr + locNameStr;
        componentStr = componentStr + locStr;
        
    end
    
    if ~isFlatHA
        inputBindsStr = aux_inputBindsStr(comp,iComp,components);
        componentStr = componentStr + inputBindsStr;
    end
    
end

if isFlatHA
    objectStr = ""HA = hybridAutomaton(loc);"";
else
    objectStr = ""HA = parallelHybridAutomaton(comp,iBinds);"";
    
end

HA = automatonStr + componentStr + objectStr + aux_newlines(2) + ""end"";

end



function infoStr = aux_infoStr(components)
    
nrComp = length(components);
isFlatHA = nrComp == 1;

infoStr = """";

for iComp = 1:nrComp

    comp = components{iComp};
    compInfoStr = ""% Component "" + int2str(iComp) + "" ("" + comp.name + ""):"" + newline;
    
    if ~isempty(comp.states)
        stateStr = ""%  state x := ["" + strjoin([comp.states.name],""; "") + ""]"" + newline;
    else
        stateStr = ""%  state x := [];"" + newline;
    end
    
    if ~isempty(comp.inputs)
        inputStr = ""%  input u := ["" + strjoin([comp.inputs.name],""; "") + ""]"" + newline;
    else
        stateStr = ""%  input u := [];"" + newline;
    end

    if isFlatHA
        if ~isempty(comp.outputsGlobal)
            outputStr = ""%  output y := ["" + strjoin([comp.outputsGlobal.name],""; "") + ""]"" + aux_newlines(2);
        else
            outputStr = newline;
        end
    else
        if ~isempty(comp.outputsLocal)
            outputStr = ""%  output y := ["" + strjoin([comp.outputsLocal.name],""; "") + ""]"" + aux_newlines(2);
        else
            outputStr = newline;
        end
    end
    
    infoStr = infoStr + compInfoStr + stateStr + inputStr + outputStr;
end

end

function dynamicsStr = aux_dynamicsStr(loc,iLoc,comp,iComp,isFlatHA,resultpath,functionName)

dynamicsCommFlow = aux_text2comment(""flow equation:"" + newline + loc.Flow.Text) + newline;
dynamicsCommOutput = aux_text2comment(""output equation:"" + newline + loc.Invariant.Text_output) + newline;

if isfield(loc.Flow,'A')

    linsys_A = printMatrixConverter(loc.Flow.A);
    linsys_AStr = ""dynA = ..."" + newline + linsys_A + "";"" + newline;
    linsys_B = printMatrixConverter(loc.Flow.B);
    linsys_BStr = ""dynB = ..."" + newline + linsys_B + "";"" + newline;
    linsys_c = printMatrixConverter(loc.Flow.c);
    linsys_cStr = ""dync = ..."" + newline + linsys_c + "";"" + newline;
    
    if (isFlatHA && isempty(comp.outputsGlobal)) || ...
        (~isFlatHA && isempty(comp.outputsLocal) && isempty(comp.outputsGlobal))
        dynamicsStr = dynamicsCommFlow + linsys_AStr + linsys_BStr + linsys_cStr + ...
            ""dynamics = linearSys(dynA, dynB, dync);"" + aux_newlines(2);
    else
        linsys_C = printMatrixConverter(loc.Flow.C);
        linsys_CStr = ""dynC = ..."" + newline + linsys_C + "";"" + newline;
        linsys_D = printMatrixConverter(loc.Flow.D);
        linsys_DStr = ""dynD = ..."" + newline + linsys_D + "";"" + newline;
        linsys_k = printMatrixConverter(loc.Flow.k);
        linsys_kStr = ""dynk = ..."" + newline + linsys_k + "";"" + newline;
        dynamicsStr = dynamicsCommFlow + linsys_AStr + linsys_BStr + linsys_cStr + ...
            newline + dynamicsCommOutput + linsys_CStr + linsys_DStr + linsys_kStr + ...
            ""dynamics = linearSys(dynA, dynB, dync, dynC, dynD, dynk);"" + aux_newlines(2);
    end
else
    if isFlatHA
        nonlinName = sprintf(""%s_Loc%d_FlowEq"",functionName,iLoc);
        nonlinName_out = sprintf(""%s_Loc%d_OutputEq"",functionName,iLoc);
    else
        nonlinName = sprintf(""%s_Comp%d_Loc%d_FlowEq"",functionName,iComp,iLoc);
        nonlinName_out = sprintf(""%s_Comp%d_Loc%d_OutputEq"",functionName,iComp,iLoc);
    end
    
    statedims = num2str(length(comp.states));
    inputdims = num2str(length(comp.inputs));
    
    printDynamicsFile(resultpath,nonlinName,loc.Flow.FormalEqs,""flow"");
    
    if isFlatHA || strlength(loc.Invariant.Text_output) == 0
        dynamicsStr = dynamicsCommFlow + ""dynamics = nonlinearSys(@"" + ...
            nonlinName + "","" + statedims + "","" + inputdims + ""); "" + newline;

    else
        printDynamicsFile(resultpath,nonlinName_out,loc.Flow.FormalEqs_out,""flow"");

        outputdims = num2str(length(comp.outputsLocal));
        
        dynamicsStr = dynamicsCommFlow + dynamicsCommOutput + ...
            ""dynamics = nonlinearSys(@"" + nonlinName + "","" + statedims + ...
            "","" + inputdims + "",..."" + newline + ""    "" + ...
            ""@"" + nonlinName_out + "","" + outputdims + ""); "" + aux_newlines(2);
    end
end

end

function invariantStr = aux_invariantStr(loc,allTrans,isFlatHA)

InvText = loc.Invariant.Text;
if isa(loc.Invariant.set,'fullspace')
    n = length(loc.Flow.expressions);
    [str1,str2] = aux_fullspaceString(n,allTrans,isFlatHA);
elseif isa(loc.Invariant.set,'polytope')
    [str1,str2] = aux_polytopeString(loc.Invariant.set);
elseif isa(loc.Invariant.set,'levelSet')
    [str1,str2] = aux_levelSetString(loc.Invariant.set);
else
    throw(CORAerror('CORA:converterIssue',...
        'Invariant has to be either empty, a polytope, or a levelSet'));
end

invariantComm = aux_text2comment(""invariant equation:"" + newline + InvText) + newline;
invariantStr = invariantComm + str1 + ""inv = "" + str2 + aux_newlines(2);

end

function resetStr = aux_resetStr(trans,n,m,iComp,iLoc,iTrans,isFlatHA,resultpath,functionName)

if isfield(trans.reset,'A')
    reset_A = printMatrixConverter(trans.reset.A);
    reset_AStr = ""resetA = ..."" + newline + reset_A + "";"" + newline;
    reset_B = printMatrixConverter(trans.reset.B);
    reset_BStr = ""resetB = ..."" + newline + reset_B + "";"" + newline;
    reset_c = printMatrixConverter(trans.reset.c);
    reset_cStr = ""resetc = ..."" + newline + reset_c + "";"" + newline;
    
    tranResetText = trans.reset.Text;
    if tranResetText == """"
        tranResetText = ""no reset equation given"";
    end
    resetComm = aux_text2comment(""reset equation:"" + newline + tranResetText) + newline;
    resetStr = resetComm + reset_AStr + reset_BStr + reset_cStr + ...
        ""reset = linearReset(resetA,resetB,resetc);"" + aux_newlines(2);
else
                   
    if isFlatHA
        resetFuncName = sprintf(""%s_Loc%d_Trans%d_ResetEq%d"",...
            functionName,iLoc,iTrans);
    else
        resetFuncName = sprintf(""%s_Comp%d_Loc%d_Trans%d_ResetEq%d"",...
            functionName,iComp,iLoc,iTrans);
    end

    printDynamicsFile(resultpath,resetFuncName,trans.reset.FormalEqs,""reset"");
    tranResetText = trans.reset.Text;
    if tranResetText == """"
        tranResetText = ""no reset equation given"";
    end
    
    resetComm = aux_text2comment(""reset equation:"" + ...
        newline + tranResetText) + newline;
    resetStr = resetComm + ""reset = nonlinearReset(@"" + ...
            resetFuncName + "","" + n + "","" + m + "","" + n + "");"" + aux_newlines(2);
end

end

function guardStr = aux_guardStr(trans,loc)

tranGuardText = trans.guard.Text;
if tranGuardText == """"
    tranGuardText = ""no guard set given -> instant transition"";
end

if isa(trans.guard.set,'fullspace')
    str1 = """";
    str2 = ""fullspace("" + length(loc.Flow.expressions) + "");"";

elseif isa(trans.guard.set,'polytope')
    try
        G = loc.Invariant.set & trans.guard.set;
    catch
        G = trans.guard.set;
    end
    
    if isa(G,'levelSet')
        [str1,str2] = aux_levelSetString(G);
    elseif isa(G,'polytope')
        [str1,str2] = aux_polytopeString(G);
    else
        throw(CORAerror('CORA:converterIssue',...
            'Unexpected set representation in conversion of guard set.'));
    end

elseif isa(trans.guard.set,'levelSet')
    try
        G = loc.Invariant.set & trans.guard.set;                    
    catch
        G = trans.guard.set;
    end
    [str1,str2] = aux_levelSetString(G);

else
    throw(CORAerror('CORA:converterIssue',...
        'Guard set has to be empty, a polytope or a levelSet.')); 
end

guardComm = aux_text2comment(""guard equation:"" + newline + tranGuardText) + newline;
guardStr = guardComm + str1 + ""guard = "" + str2 + aux_newlines(2);

end

function inputBindsStr = aux_inputBindsStr(comp,iComp,components)

parallelComm = aux_text2comment(""composition: hybrid automaton and input binds"") + ...
    newline + ""comp("" + num2str(iComp) + "") = hybridAutomaton(loc);"" + aux_newlines(2);


if strcmp(comp.inputs(1).name,'uDummy')
    inputBindsStr = ""% only dummy input"" + newline + ...
        ""iBinds{"" + iComp + ""} = [0 1];"" + aux_newlines(2);

else

    inputBindsStr = ""% input names: "" + strjoin([comp.inputs.name],"", "") ...
        + newline + ""iBinds{"" + iComp + ""} = [["";

    for inp=1:length(comp.inputs)
        if inp > 1
            inputBindsStr = inputBindsStr + "";["";
        end
        inputName = comp.inputs(inp).name;
        origin = 0;
        outputOfOrigin = 1;
        for c=1:length(components)
            idx = strcmp([components{c}.outputsLocal.name],inputName);
            if any(idx)
                origin = c;
                if nnz(idx) > 1
                    throw(CORAerror('CORA:converterIssue',...
                        ['The input name of an input bind could not be resolved '...
                        'because the name occurs twice in another component.']));
                end
                outputOfOrigin = find(idx,1,'first');
                break
            end
        end
        inputBindsStr = inputBindsStr + num2str(origin) + "","" +...
            num2str(outputOfOrigin) + ""]"";
    end
    inputBindsStr = inputBindsStr + ""];"" + aux_newlines(2);
end

inputBindsStr = parallelComm + inputBindsStr;

end


function [str1,str2] = aux_fullspaceString(n,allTrans,isFlatHA)

if isempty(allTrans) || n == 0 || (~isFlatHA && ...
        all(arrayfun(@(x) ~strcmp(x,''),[allTrans.label],'UniformOutput',true)) )
    str1 = """";
    str2 = ""fullspace("" + n + "");"";
else
    inv = fullspace(n);
    for t=1:length(allTrans)
        if isFlatHA || strcmp(allTrans(t).label,'')
            guard = allTrans(t).guard.set;
            if isa(guard,'polytope') && ...
                  ( contains(allTrans(t).guard.Text,""<"") || ...
                    contains(allTrans(t).guard.Text,"">"") ) && ...
                 ~( contains(allTrans(t).guard.Text,"">="") || ...
                    contains(allTrans(t).guard.Text,""<="") )
                guard = guard + 1e-12*ones(n,1);
            end
    
            if isa(guard,'polytope') || isa(guard,'levelSet') ...
                    || isa(guard,'fullspace')
                temp = ~guard;
            else
                throw(CORAerror('CORA:converterIssue',...
                    'Issue in conversion of empty invariant and non-empty guard sets.'));
            end
    
            inv = and_(inv,temp,'exact');
    
            if isa(inv,'emptySet')
                break
            end
        end
    end
    if isa(inv,'emptySet') || (isa(inv,'polytope') && isempty(inv))
        str1 = """"; str2 = ""emptySet("" + n + "");"";
    elseif isa(inv,'polytope')
        [str1,str2] = aux_polytopeString(inv);
    elseif isa(inv,'levelSet')
        [str1,str2] = aux_levelSetString(inv);
    else
        throw(CORAerror('CORA:converterIssue',...
            'Issue in conversion of empty invariant.'));
    end
end

end

function [str1,str2] = aux_polytopeString(P)

    P = compact_(P,'AtoAe',1e-12);

    A = printMatrixConverter(P.A);
    AStr = ""P_A = ..."" + newline + A + "";"" + newline;
    b = printMatrixConverter(P.b);
    bStr = ""P_b = ..."" + newline + b + "";"" + newline;
    if ~isempty(P.Ae)
        Ae = printMatrixConverter(P.Ae);
        AeStr = ""P_Ae = ..."" + newline + Ae + "";"" + newline;
        be = printMatrixConverter(P.be);
        beStr = ""P_be = ..."" + newline + be + "";"" + newline;
        str2 = 'polytope(P_A,P_b,P_Ae,P_be);';
    else
        AeStr = """";
        beStr = """";
        str2 = 'polytope(P_A,P_b);';
    end
    str1 = AStr + bStr + AeStr + beStr + newline;
end

function [str1,str2] = aux_levelSetString(ls)
    
    varStr = ""vars = sym('x',["" + num2str(length(ls.vars)) + "",1]);"" + newline;
    
    varStr = varStr + ""syms "";
    for i = 1:length(ls.vars)
        if i ~= length(ls.vars)
            varStr = varStr + ""x"" + num2str(i) + "" "";
        else
            varStr = varStr + ""x"" + num2str(i) + "";"";
        end
    end
    
    x = sym('x',[length(ls.vars),1]);
    eq = ls.funHan(x);
    
    if length(eq) == 1
        eqStr = ""eq = "" + string(eq) + "";"";
    else
        eqStr = ""eq = ["";
        for i = 1:length(eq)
            if i ~= length(eq)
                eqStr = eqStr + string(eq(i)) + ""; ..."" + newline;
            else
                eqStr = eqStr + string(eq(i));
            end
        end
        eqStr = eqStr + ""];"";
    end
    
    if ~iscell(ls.compOp)
        compStr = ""compOp = '"" + ls.compOp + ""';""; 
    else
        compStr = ""compOp = {"";
        for i = 1:length(ls.compOp)
           if i ~= length(ls.compOp)
                compStr = compStr + ""'"" + ls.compOp{i} + ""',"";
           else
                compStr = compStr + ""'"" + ls.compOp{i} + ""'};"";
           end
        end
    end
    
    str1 = varStr + newline + eqStr + newline + compStr + aux_newlines(2);
    str2 = ""levelSet(eq,vars,compOp);"";

end


function str = aux_padComment(comment,maxLineLength)

    if nargin < 2
        maxLineLength = 75;
    end
    
    lenComment = strlength(comment);
    lenLeft = floor((maxLineLength - lenComment)/2) - 1;
    lenRight = maxLineLength - lenLeft - lenComment;
    
    str = ""%"" + repmat('-',1,lenLeft-1) + comment + repmat('-',1,lenRight);

end

function str = aux_newlines(lines)
    str = string(repmat(newline(),1,lines));
end

function str = aux_text2comment(text)
    str = ""%% "" + strrep(text,newline,newline + ""%   "");
end"
4590,data2psiX.m,74.188,100,52.7,75,100.0,43.24,70-80,"function psi = data2psiX(data,srate,freqbins,permtest)





if nargin<2
    help data2psiX
    error('Read help file.');
elseif nargin==2
    permtest = 0;
    freqbins = [];
elseif nargin==3
    permtest = 0;
end

n_permutes = 1000;


[nchan,npnts,ntrials]=size(data);

hz  = linspace(0,srate/2,floor(npnts/2)+1);
nhz = length(hz);

cs  = zeros(nchan,nchan,nhz);
psi = zeros(nchan,nchan,size(freqbins,1));


datafft = fft(bsxfun(@times,data,hanning(npnts)'),[],2);

for triali=1:ntrials
    for freqi=1:nhz
        
        tempfftdat = squeeze(datafft(:,freqi,triali))';
        cs(:,:,freqi) = cs(:,:,freqi) + tempfftdat'*conj(tempfftdat);
    end
end
cs = cs./triali;


for freqbini=1:size(freqbins,1)
    
    freqidx = dsearchn(hz',freqbins(freqbini,1)) : dsearchn(hz',freqbins(freqbini,2));
    nfidx   = length(freqidx);
    
    if nfidx<4
        warning('There are fewer than four frequency bins. Consider using longer time windows or wider frequency bands.')
    end
    
    pp = zeros(nchan,nchan,nfidx);
    
    for fi=1:nfidx
        pp(:,:,fi) = cs(:,:,freqidx(fi))./sqrt(diag(cs(:,:,freqidx(fi)))*diag(cs(:,:,freqidx(fi)))');
    end
    
    psi(:,:,freqbini) = sum(imag(conj(pp(:,:,1:end-1)).*pp(:,:,2:end)),3);
    
    
    
    if permtest
        
        nulldist = zeros(nchan,nchan,n_permutes);
        for permi=1:n_permutes
            nulldist(:,:,permi) = sum(imag(conj(pp(:,:,randperm(nfidx))).*pp(:,:,randperm(nfidx))),3);
        end
        
        psi(:,:,freqbini) = ( psi(:,:,freqbini)-mean(nulldist,3) ) ./ std(nulldist,[],3);
    end
    
    tmp = squeeze(psi(:,:,freqbini));
    tmp(logical(eye(nchan))) = 0;
    psi(:,:,freqbini) = tmp;
    
end"
4591,data2raw.m,78.51,80,61.24,100,100.0,51.31,70-80,"function [data, dimord] = data2raw(data);



if isfield(data, 'label') && ~isfield(data, 'avg') && isfield(data, 'trial') && iscell(data.trial)
  dimord = [];                  % output of PREPROCESSING
elseif isfield(data, 'label') && isfield(data, 'avg') && ~isfield(data, 'trial') && ~isfield(data, 'individual')
  dimord = 'chan_time';         % output of TIMELOCKANALYSIS with keeptrials=no or TIMELOCKGRANDAVERAGE with keepindividual=no
elseif isfield(data, 'label') && isfield(data, 'avg') &&  isfield(data, 'trial') && ~isfield(data, 'individual')
  dimord = 'rpt_chan_time';     % output of TIMELOCKANALYSIS with keeptrials=yes
elseif isfield(data, 'label') && isfield(data, 'avg') && ~isfield(data, 'trial') &&  isfield(data, 'individual')
  dimord = 'subj_chan_time';    % output of TIMELOCKGRANDAVERAGE with keepindividual=yes
elseif isfield(data, 'pos') && isfield(data, 'avg') && isfield(data.avg, 'mom')
  mom = data.avg.mom{data.inside(1)};
  if size(mom,1)==1
    dimord = 'source_time';
  else
    error('the source activity should be projected on a single orientation');
  end
elseif isfield(data, 'pos') && isfield(data, 'trial') && isfield(data.trial, 'mom')
  mom = data.trial(1).mom{data.inside(1)};
  if size(mom,1)==1
    dimord = 'rpt_source_time';
  else
    error('the source activity should be projected on a single orientation');
  end
else
  warning('unrecognized input data');
  dimord = [];
end

if isempty(dimord)
  return
end

switch dimord
  case 'chan_time'
    fprintf('converting average to raw data with only a single trial\\n');
    data.trial{1} = data.avg;
    data.time     = {data.time};
    data          = rmfield(data, 'avg');

  case 'rpt_chan_time'
    fprintf('converting timelocked trials to raw trials\\n');
    tmptrial = {};
    tmptime  = {};
    ntrial = size(data.trial,1);
    nchan  = size(data.trial,2);
    ntime  = size(data.trial,3);
    for i=1:ntrial
      tmptrial{i} = reshape(data.trial(i,:,:), [nchan, ntime]);
      tmptime{i}  = data.time;
    end
    data = rmfield(data, 'trial');
    data.trial = tmptrial;
    data.time  = tmptime;

  case 'subj_chan_time'
    fprintf('converting individual subject averages to raw trials\\n');
    tmptrial = {};
    tmptime  = {};
    ntrial = size(data.individual,1);
    nchan  = size(data.individual,2);
    ntime  = size(data.individual,3);
    for i=1:ntrial
      tmptrial{i} = reshape(data.individual(i,:,:), [nchan, ntime]);
      tmptime{i}  = data.time;
    end
    data = rmfield(data, 'individual');
    data.trial = tmptrial;
    data.time  = tmptime;

  case 'source_time'
    fprintf('converting average source reconstructed timecourse to a raw trial\\n');
    nsource = length(data.inside);
    ntime = size(data.avg.mom{data.inside(1)},2); % use the first dipole to determine the length
    tmptrial = {};
    tmptime  = {};
    tmptrial{1} = zeros(nsource, ntime);
    for j=1:nsource
      mom = data.avg.mom{data.inside(j)};
      tmptrial{1}(j,:) = mom;
    end
    tmptime{1} = data.time;
    data = rmfield(data, 'avg');
    data.trial = tmptrial;
    data.time  = tmptime;
    data.label = {};
    for i=1:length(data.inside)
      data.label{i} = sprintf('source%d', data.inside(i));
    end
    data.label = data.label(:);

  case 'rpt_source_time'
    fprintf('converting single-trial source reconstructed timecourses to raw trials\\n');
    ntrial = length(data.trial);
    nsource = length(data.inside);
    ntime = size(data.trial(1).mom{data.inside(1)},2); % use the first trial and dipole to determine the length
    tmptrial = {};
    tmptime  = {};
    for i=1:ntrial
      tmptrial{i} = zeros(nsource, ntime);
      for j=1:nsource
        mom = data.trial(i).mom{data.inside(j)};
        tmptrial{i}(j,:) = mom;
      end
      tmptime{i} = data.time;
    end
    data = rmfield(data, 'trial');
    data.trial = tmptrial;
    data.time  = tmptime;
    data.label = {};
    for i=1:length(data.inside)
      data.label{i} = sprintf('source%d', data.inside(i));
    end
    data.label = data.label(:);

  otherwise

end

if ~isfield(data, 'fsample')
  data.fsample = 1/(data.time{1}(2)-data.time{1}(1));
end

if isfield(data, 'avg'),   data = rmfield(data, 'avg');   end
if isfield(data, 'var'),   data = rmfield(data, 'var');   end
if isfield(data, 'cov'),   data = rmfield(data, 'cov');   end
if isfield(data, 'blcov'), data = rmfield(data, 'blcov'); end"
4592,data2struct.m,75.0,60,64.29,90,100.0,60.71,70-80,"function data = data2struct(data,T,options)

if length(options.embeddedlags)>1
    L = -min(options.embeddedlags) + max(options.embeddedlags);
else
    L = options.maxorder;
end

if ~isstruct(data), data = struct('X',data); end
if ~isfield(data,'C')
    if options.K>1, data.C = NaN(size(data.X,1)-L*length(T),options.K);
    else data.C = ones(size(data.X,1)-L*length(T),1);
    end
elseif size(data.C,1)==sum(T) && L>0 % we need to trim C
    ind = [];
    for j=1:length(T)
        t0 = sum(T(1:j-1)) - L*(j-1);
        if length(options.embeddedlags)>1
            ind = [ind (t0+1-min(options.embeddedlags)):(t0+T(j)-max(options.embeddedlags)) ];
        else
            ind = [ind (t0+options.maxorder+1:t0+T(j))];
        end
    end
    data.C = data.C(ind,:);
end


end"
4593,Data2Timeseries.m,79.618,100,83.33,60,100.0,54.76,70-80,"function []=Data2Timeseries(opt)
defaultopt=struct(                                                         ...
        'DoIt'               ,        'on'                   ,            ...
        'in_name'            ,        'off'                   ,            ...
        'out_name'           ,        'off'                   ,            ...
        'pattern'            ,        ['PO* filesep geo*[0-9].unw'] ,      ...
        'timeseries_name'    ,        'off'                   ,            ...
        'rating'             ,        'off'                   ,            ...
        'loadopt'             ,        'off'                   ,            ...
        'unw_thresh'         ,         0.99                   ,            ...
        'corfile'            ,        'off'                   ,            ...
        'cormask_thresh'     ,         0.2                    ,            ...
        'cormask_area_open'  ,         10                     ,            ...
        'Unit'               ,         'radian'               ,            ...
        'plotdataopt'        ,        'off'      )            ;
if ~exist('opt','var')  [opt]=read_options_fromfile([mfilename '.min'],defaultopt); end ;
[opt]=process_defaultoptions(opt,defaultopt);  %display(opt)
f=fieldnames(opt) ; for i=1:length(f) eval([char(f{i}) '= opt.(f{i}) ;' ]) ; end
if  ~DoIt                    return; end
if  CheckInOut('',out_name)  return; end

dir_in=in_name ;
filematch=fullfile(dir_in,pattern);

[junk,junk,DataSet]=extract_ProjectName(dir_in);
if ~timeseries_name
    timeseries_name         = [ 'timeseries_' DataSet  '.mat'] ;
end

   loadopt.unw_thresh=unw_thresh; 
   loadopt.Unit=Unit; 

   [timeseries,datelist,N_timevector]=LoadData(filematch,loadopt);

   for i=1:length(timeseries)
       timeseries(i).DataSet  = DataSet;
   end

