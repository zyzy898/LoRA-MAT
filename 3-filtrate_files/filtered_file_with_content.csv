1841,compactWrapper.m,77.262,100,53.68,100,100.0,32.63,70-80,"function obj = compactWrapper(obj, wrapper)

if nargin == 1
    wrapper = obj.wrapper;
end

kFold = 10;
if strcmp(wrapper, 'back')
    [ cmptFea, errRcd ] = backWrapper(obj.dataX, obj.dataC, obj.candiFea, obj.classifier, kFold);
elseif strcmp(wrapper, 'for')
    [ cmptFea, errRcd ] = forWrapper(obj.dataX, obj.dataC, obj.candiFea, obj.classifier, kFold);
end

obj.cmptFea = cmptFea;
obj.errRcd  = errRcd;
obj.wrapper = wrapper;

end


function [ cmptFea, errRcd ] = backWrapper(dataX, dataC, candiFea, classifier, kFold)

conti       = true;
errClass    = cvErrEst(dataX(:,candiFea), dataC, classifier, kFold);
errRcd      = errClass;

while conti

    m       = length(candiFea);
    if (m==0); break; end;
    errK    = 1;
    badIdx  = 0;
    
    for Sid = 1 : m
        idx = candiFea( [1:Sid-1, Sid+1:m] );
        errNow = cvErrEst(dataX(:,idx), dataC, classifier, kFold);
        if errNow < errK
            errK    = errNow;
            badIdx  = Sid;
        end
    end
    
    if errK <= errClass
        candiFea(badIdx)    = [];
        errClass            = errK;
        errRcd              = [errRcd; errClass];
    else
        cmptFea             = candiFea;
        conti               = false;
    end

end
    
end

function [ cmptFea, errRcd ] = forWrapper(dataX, dataC, candiFea, classifier, kFold)

conti       = true;

errClass    = 1;
cmptFea     = [];
cmptIdx     = 0;
errRcd      = 1;

while conti
    
    m       = length(candiFea);
    
    errK    = 1;
    goodIdx = 0;
    
    for Sid = 1 : m
        idx = [cmptFea; candiFea(Sid)];
        errNow = cvErrEst(dataX(:,idx), dataC, classifier, kFold);
        if errNow < errK
            errK    = errNow;
            goodIdx = Sid;
        end
    end
    
    if errK <= errClass
        cmptFea = [cmptFea; candiFea(goodIdx)];
        candiFea(goodIdx)    = [];
        if errK < errClass; cmptIdx = length(cmptFea); end;
        errClass = errK;
        errRcd  = [errRcd; errClass];
    else
        cmptFea = cmptFea(1:cmptIdx);
        errRcd  = errRcd(1:cmptIdx+1);
        conti   = false;
    end
    
end

end"
1842,compact_.m,79.258,100,53.7,100,100.0,42.59,70-80,"function Z = compact_(Z,method,tol,varargin)



switch method
    case 'zeros'
        Z = aux_deleteZeros(Z,tol);
    case 'all'
        Z = aux_deleteAligned(Z,tol);
end

end



function Z = aux_deleteZeros(Z,tol)
    
    Z.G = nonzeroFilter(Z.G,tol);

end

function Z = aux_deleteAligned(Z,tol)
    
    G = nonzeroFilter(Z.G,tol);

    if dim(Z) == 1
        Z.G = sum(abs(G));
        return
    end
    
    G_norm = G ./ vecnorm(G);
    nrGen = size(G,2);
    
    idxKeep = true(1,nrGen);
    for i=1:nrGen
        if idxKeep(i)
            dotprod = G_norm(:,i)' * G_norm;

            idxParallel = withinTol(dotprod,1,tol);
            idxAntiParallel = withinTol(dotprod,-1,tol);

            if nnz(idxParallel) > 1 || any(idxAntiParallel)
                G(:,i) = sum(G(:,idxParallel),2) ...
                        - sum(G(:,idxAntiParallel),2);

                idxParallel(i) = false;
                idxKeep = idxKeep & ~idxParallel & ~idxAntiParallel;
            end
        end
    end

    Z.G = G(:,idxKeep);

end"
