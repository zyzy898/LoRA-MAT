                        file_name = strrep(file_name, '${NOW}', GPS_Time.now.toString('yyyymmdd_HHMMSS'));
                        [file_dir, file_name, file_ext] = fileparts(file_name);
                        if ~isempty(file_dir)
                            if ~exist(file_dir, 'file')
                                mkdir(file_dir);
                            end
                        end
                        if isempty(file_ext)
