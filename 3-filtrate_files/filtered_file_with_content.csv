    if numel(faceval)==3
        xvalue = faceval(1).*ones(mn(1)+1, mn(2), mn(3));
        yvalue = faceval(2).*ones(mn(1), mn(2)+1, mn(3));
        zvalue = faceval(3).*ones(mn(1), mn(2), mn(3)+1);
