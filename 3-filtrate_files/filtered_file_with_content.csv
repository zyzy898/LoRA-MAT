5758,DEM_self_entropy.m,77.518,80,63.79,100,100.0,43.8,70-80,"function DEM_self_entropy



spm_figure('GetWin','Figure 1'); clf
rng('default')

n     = 128;                            % number of (SxH) bins
m     = 16;                             % numer of (A) active bins
dt    = 1;                              % time step for solution
N     = 18;                             % 2^N solution

a     = zeros(n,n);
for i = 1:n
    for j = 1:n
        es     = (j - n/2).^2/32 + n/8;
        vs     = (es/8)^2;
        a(i,j) = exp(-(i - es).^2/vs);
    end
end

A     = zeros(n,n,m);
for k = 1:m
    s        = 1 + 8*(k - 1);
    A(:,:,k) = spm_softmax(log(a)/s);
end
for j = 1:n
    for k = 1:m
        A(:,j,k) = A(:,j,k)/sum(A(:,j,k) + exp(-32));
    end
end


pH    = exp(-((1:n) - n/2 - n/8).^2/n*2)/2 + exp(-((1:n) - n/2 + n/8).^2/n);
lnpH  = log(pH(:));
lnpA  = ones(m,1);

ni    = [1 3 4];                        % batches of iterations
for g = 1:3
    for ii = 1:ni(g)
        
        [HB,Gi,Ge] = spm_G(A,lnpH,lnpA);
        
        pH     = spm_softmax(lnpH);
        pA     = spm_softmax(lnpA);
        
        for i = 1:n
            for j = 1:m
                pSxHxA(:,i,j) = A(:,i,j)*pH(i)*pA(j);
            end
        end
        pSxH   = sum(pSxHxA,3);
        pS     = sum(pSxH,2);
        
        Hh(g,1) = HB;
        He(g,1) = Ge;
        Hi(g,1) = Gi;
        
        
        dp   = spm_diff(@spm_G,A,lnpH,lnpA,3);
        
        lnpA = log(spm_softmax(lnpA - dp(:)*8));
        
        subplot(3,2,1),     imagesc(1 - sum(A,3))
        title('Likelihood','FontSize',16)
        xlabel('Hidden states'), ylabel('Sensory states')
        axis square, axis xy
        
        subplot(3,2,2),     bar([Hh,He,Hi])
        title('Expected surpise','FontSize',16)
        xlabel('Iteration'),ylabel('Information (nats)')
        axis square, axis xy,
        legend({'H(B)','H(B|E)','I(B,E)'})
        set(gca,'XTickLabel',ni)
        
        subplot(3,3,g + 3), imagesc(1 - pSxH)
        j  = sum(ni(1:(g - 1))) + ii;
        title(sprintf('Iteration %i',j),'FontSize',16)
        xlabel('Hidden states'), ylabel('Sensory states')
        axis square, axis xy
        
        hold on
        plot(pH*n*n/8,'k')
        plot(pS*n*n/8,(1:n),'r')
        hold off
        drawnow
        
    end
    
    
    G       = eye(2,2);                  % amplitude of random fluctuations
    Q       = [0 -1;1 0]/4;              % solenoidal flow
    [gh,gs] = gradient(log(pSxH));       % gradients
    f       = [gh(:),gs(:)]*(G - Q);     % flow
    fh      = spm_unvec(f(:,1),gh);
    fs      = spm_unvec(f(:,2),gs);
    [gi,gj] = meshgrid(1:n,1:n);
    i       = 1:8:n;
    
    subplot(3,2,5), hold off, quiver(gi(i,i),gj(i,i),fh(i,i),fs(i,i),'k')
    title('Flow and trajectories','FontSize',16)
    xlabel('Hidden states'), ylabel('Blanket states')
    axis square, axis xy
    
    
    [~,k] = max(pSxH(:));
    [p,q] = ind2sub([n,n],k);
    x     = [q;p];
    for t = 1:(2^N)
        x(:,t)     = max(1,min(n,x(:,t)));
        k          = sub2ind([n,n],round(x(2,t)),round(x(1,t)));
        dx         = f(k,:)' + sqrt(G/2)*randn(2,1);
        x(:,t + 1) = x(:,t)  + dx*dt;
    end
    
    s     = abs(fft(x(1,:)')).^2;
    w     = (1:2^12)';
    W     = w;
    S     = s(w + 1);
    
    S     = decimate(log(S),N - 4);
    W     = log(decimate(W,N - 4));
    X     = [ones(size(W)),W];
    
    [~,i] = max(abs(diff(spm_conv(x(1,:),2^(N - 8)))));
    nn    = 2^10;
    i     = (-nn:nn) + i;
    i     = i(i > 0 & i < size(x,2));
    hold on, plot(x(1,i),x(2,i),'b'), hold off
    axis([1,n,1,n]),drawnow
    
    [~,~,beta] = spm_ancova(X,[],S,[0;1]);
    
    if g == 3
        subplot(3,2,6), plot(W,S,'b.',W,X*beta,'b','LineWidth',1)
    elseif g == 1
        subplot(3,2,6), plot(W,S - 4,'c.'), hold on
    else
        subplot(3,2,6), plot(W,S - 2,'m.'), hold on
    end
    title(sprintf('alpha = %-2.2f',beta(2)),'FontSize',16)
    ylabel('Log power'), xlabel('Log frequency')
    axis square, axis xy, spm_axis tight
    
end

return


function [HB,HBH,IBH] = spm_G(A,lnpH,lnpA)


n     = size(A,2);
m     = size(A,3);
pH    = spm_softmax(lnpH);
pA    = spm_softmax(lnpA);

ln    = @(p)log(spm_vec(p) + 1e-16);
H     = @(p)-spm_vec(p)'*ln(p);

for i = 1:n
    for j = 1:m
        pSxHxA(:,i,j) = A(:,i,j)*pH(i)*pA(j);
    end
end

pB    = spm_vec(sum(pSxHxA,2));
HB    = H(pB);
if nargout > 1
    IBH = H(pB) + H(pH) - H(pSxHxA);
    HBH = HB - IBH;
end

return"
5759,DEM_sharing.m,73.146,70,55.73,100,100.0,40.0,70-80,"function MDP = DEM_sharing



rng('default')



los   = 9;                          % number of lines of sight
cm    = [3 5 7];                    % central lines of sight for each agent

for i = 1:los
    Attribute{1}{i} = sprintf('%i',i);
end
Attribute{2} = {'close','near','gone'};
Attribute{3} = {'slowly','right','left','away','closer'};
Attribute{4} = {'Girl','Boy'};

for i = 1:numel(Attribute)
    N(i) = numel(Attribute{i});
end

for j = 1:prod(N)

    [a1,a2,a3,a4]    = spm_ind2sub(N,j);    % attributes of object
    label.name{1}{j} = [Attribute{4}{a4} ', ' ...
        Attribute{2}{a2} ' moving ' ...
        Attribute{3}{a3} ' at ' ...
        Attribute{1}{a1}];
end

label.factor = [{'scene'} {'gaze'}];
label.name   = [label.name   {{'right','centre','left'}} ];
label.action = [{'none'} {{'right','centre','left'}}];

label.modality = {...
    'what',...
    'contrast-left',...
    'contrast-centre',...
    'contrast-right',...
    'motion-left',...
    'motion-centre',...
    'motion-right',...
    'spoken'};

label.outcome{1} = {  ...
    'person-near-right-yes',...
    'person-near-right-no',...
    'person-near-front-yes',...
    'person-near-front-no',...
    'person-near-left-yes',...
    'person-near-left-no',...
    'person-near-back',...
    'person-far-right',...
    'person-far-front',...
    'person-far-left',...
    'person-far-back',...
    'background'};

for i = 2:7
    label.outcome{i} = {'near','far','none'};
end

label.outcome{8} = label.name{1};


for i = 1:size(N,1)
    for j = 1:size(N,2)
        I{i,j} = speye(N(i,j),N(i,j));
    end
end

disp('specifying generative model (c.f., training)'), disp(' ')
for f = 1:size(N,1)

    for u = 1

        b     = cell(N(f,3),N(f,3));
        c     = 0;                            % head movements
        d     = [0 -1  1  0  0];              % object movements

        for i = 1:N(f,3)
            b{i,i} = spm_speye(N(f,1),N(f,1),d(i) + c(u),1);
        end

        b     = spm_kron({spm_cat(b),I{f,2},I{f,4}});
        B{1}  = spm_permute_kron(b,N(f,[1,3,2,4]),[1,3,2,4]);

        b     = cell(N(f,3),N(f,3));
        d     = [0  0  0 -1  1];

        for i = 1:N(f,3)
            b{i,i} = spm_speye(N(f,2),N(f,2),d(i),2);
        end
        b     = spm_kron({I{f,1}, spm_cat(b),I{f,4}});
        B{2}  = spm_permute_kron(b,N(f,[1 2 3 4]),[1 2 3 4]);

        b      = cell(3,3);
        b{1,1} = [...     % when near...
            1 0 0 1 1;    % when near and standing tend to move or withdraw
            4 1 0 0 0;    % when near continue moving or withdraw
            4 0 1 0 0;    % when near continue moving or withdraw
            1 1 1 0 0;    % when near and withdrawing stand still
            0 0 0 0 0];   % when near and approaching stand still
        b{2,2} = [...     % when far...
            1 0 0 1 1;    % when Far and standing tend to move or approach
            4 4 0 0 0;    % ...
            4 0 4 0 0;
            1 0 0 0 0;
            4 1 1 0 0];
        b{3,3} = [...     % when distant...
            1 1 1 1 1;
            0 4 0 0 0;
            0 0 4 0 0;
            0 0 0 0 0;
            4 0 0 0 0];

        for i = 1:3
            b{i,i} = b{i,i}(1:N(f,3),1:N(f,3));
        end
        b     = b(1:N(f,2),1:N(f,2));
        b     = spm_kron({I{f,1}, spm_cat(b),I{f,4}});
        b     = bsxfun(@rdivide,b,sum(b));
        B{3}  = spm_permute_kron(b,N(f,[1 3 2 4]),[1 3 2 4]);


        B{4}  = spm_kron({I{f,1},I{f,2},I{f,3},I{f,4}});

        b  = 1;
        for i = 1:numel(B)
            b = full(b*B{i});
        end

        T{f}(:,:,u) = b;

    end
end

nx    = numel(label.name{end});
nu    = numel(label.action{end});
b     = zeros(nx,nx,nu);
for u = 1:nu
    b(u,:,u) = 1;
end

B     = [T b];
for f = 1:numel(B)
    Nf(f) = size(B{f},1);
end


for i = 1:numel(label.modality)
    mA{i} = zeros([numel(label.outcome{i}),Nf]);
end


nm    = numel(cm);                    % number of agents
for m = 1:nm
    A      = mA;                      % reset likelihood denser
    for o1 = 1:Nf(1)
        for u = 1:Nf(2)

            c        = cm(m) - 2 + u;


            [a1,a2,a3,a4] = spm_ind2sub(N,o1);   % attributes of object
            a        = [a1,a2,a3,a4];            % object x attribute array




            o            = spm_what(a,c);
            A{1}(o,o1,u) = 1;



            o     = spm_contrast_energy(a,c - 1);
            A{2}(o,o1,u) = 1;
            o     = spm_motion_energy(a,c - 1);
            A{5}(o,o1,u) = 1;

            o     = spm_contrast_energy(a,c);
            A{3}(o,o1,u) = 1;
            o     = spm_motion_energy(a,c);
            A{6}(o,o1,u) = 1;

            o     = spm_contrast_energy(a,c + 1);
            A{4}(o,o1,u) = 1;
            o     = spm_motion_energy(a,c + 1);
            A{7}(o,o1,u) = 1;

            A{8}(o1,o1,u) = 1;

        end

    end

    Am{m} = A;

end


C{1}  = [4 4 4 4 4 4 4 2 2 2 2 0];

for i = 2:numel(A)
    C{i}  = zeros(1,size(A{i},1));
end

D{1} = ones(1,prod(N));                                    % uninformative
D{2} = [0,1,0];                                            % centre gaze

U     = [ ...
    1 1;          % saccade to right line of sight
    1 2;          % saccade to centre line of sight
    1 3];         % saccade to left line of sight

T      = 10;
m      = [1,0];                     % first (scene) is factor shared
n      = zeros(numel(A),1);
n(end) = -1;


mdp.T = T;                        % numer of moves
mdp.U = U;                        % actions
mdp.A = A;                        % likelihood probabilities
mdp.B = B;                        % transition probabilities
mdp.C = C;                        % prior preferences
mdp.D = D;                        % prior over initial states
mdp.N = 0;                        % policy depth
mdp.m = m;                        % shared outcomes
mdp.n = n;                        % shared states

mdp.label = label;


for i = 1:numel(Am)
    MDP(i,1)   = mdp;
    MDP(i,1).A = Am{i};
end

disp('inverting generative model (c.f., active inference)'), disp(' ')

MDP  = spm_MDP_VB_XX(MDP);

spm_figure('GetWin','Active inference'); clf
spm_surveillance_percept(MDP,N,cm)

for i = 1:numel(Am)
    NDP(i,1)        = mdp;
    NDP(i,1).A      = Am{i};
end
for i = 1:numel(Am)
    NDP(i,1).s      = MDP(i,1).s;                  % reproduce scene
    NDP(i,1).s(2,:) = 0;                           % but not gaze
    NDP(i,1).A{end} = ones(size(MDP(i,1).A{end})); % disable language
end

NDP  = spm_MDP_VB_XX(NDP);

spm_figure('GetWin','comparison'); clf

for m = 1:numel(MDP)

    for t = 1:T
        q = MDP(m).X{1}(:,t);
        q = spm_sum(reshape(q,N),[2,3,4]);
        Q(:,t) = q;
    end
    subplot(6,2,(m*2) - 1), image(64*(1 - Q))
    xlabel('time'), ylabel('location')
    hold on
    i   = find(MDP(m).s(2,:) ~= NDP(m).s(2,:));
    plot(1:T,MDP(m).s(2,:) + cm(m) - 2,'.c','MarkerSize',16)
    plot(i,  MDP(m).s(2,i) + cm(m) - 2,'.r','MarkerSize',16)

    for t = 1:T
        q = NDP(m).X{1}(:,t);
        q = spm_sum(reshape(q,N),[2,3,4]);
        Q(:,t) = q;
    end
    subplot(6,2,(m*2) - 0), image(64*(1 - Q))
    xlabel('time'), ylabel('location')
    hold on
