fprintf('CPU time for knnsearch = %g\\n',t1-t0);
fprintf('CPU time for delaunay  = %g\\n',t2-t1);

[Q,R,K,fident] = parseinputs(varargin{:});

error(nargoutchk(0,2,nargout));

[N,M] = size(Q);
L=size(R,1);
idx = zeros(N,K);
D = idx;

if K==1
    for k=1:N
        d=zeros(L,1);
        for t=1:M
            d=d+(R(:,t)-Q(k,t)).^2;
        end
        if fident
            d(k)=inf;
        end
        [D(k),idx(k)]=min(d);
    end
else
    for k=1:N
        d=zeros(L,1);
        for t=1:M
            d=d+(R(:,t)-Q(k,t)).^2;
        end
        if fident
            d(k)=inf;
        end
        [s,t]=sort(d);
        idx(k,:)=t(1:K);
        D(k,:)=s(1:K);
    end
end
if nargout>1
    D=sqrt(D);
end

function [Q,R,K,fident] = parseinputs(varargin)
error(nargchk(1,3,nargin));

Q=varargin{1};

if nargin<2
    R=Q;
    fident = true;
else
    fident = false;
    R=varargin{2};
end

if isempty(R)
    fident = true;
    R=Q;
end

if nargin<3
    K=1;
else
    K=varargin{3};
end"
2402,compute_neighborhood.m,72.0,60,75.0,60,100.0,65.0,70-80,"function M =  compute_neighborhood(distance_matrix, r_comm, max_neig)
    
    [~,N]   = size(distance_matrix);
    M       = ones(N,N)-eye(N,N);
    to_cut  = eye(N,N);
    to_cut  = to_cut(:);
    distance_matrix(to_cut==1) = Inf;
    
    M(distance_matrix > r_comm) = 0;
    nn = sum(M,1);

    to_cut  = find(nn > max_neig);
    if ~isempty(to_cut)
        [~,I]   = sort(distance_matrix(:,to_cut), 1);
        for agent = 1:length(to_cut)
            M(I((max_neig+1):end,agent),agent) = 0; 
        end
    end

end"
2403,compute_nn_distance.m,74.326,100,62.92,75,100.0,33.71,70-80,"function [D,nn_list] = compute_nn_distance(X,nbr_nn, options)


options.null = 0;

if isfield(options, 'use_nntools')
    use_nntools = options.use_nntools;
else
    use_nntools = 1;
end
if isfield(options, 'exlude_self')
    exlude_self = options.exlude_self;
else
    exlude_self = 0;
end

if isfield(options, 'Y')
    Y = options.Y;
else
    Y = [];
end
if exlude_self && ~isempty(Y)
    warning('You can not use exlude_self with options.Y enabled.');
end

if nargin<2
    nbr_nn = size(X,2);
end


nbr_nn = min(nbr_nn,size(X,2));

d = size(X,1);
n = size(X,2);
if d>2*n
    warning('Matrix seems to be of wrong dimension, should be dimension x nbr_points');
end

if isfield(options, 'pca_numvecs')
    m = options.pca_numvecs;
else
    m = d;
end
if m>0 && m<d
    [P,tmp,v,Psi] = pca(X,m);
    X = X - repmat(Psi,[1,size(X,2)]);
    X = P' * X;
    if ~isempty(Y)
        Y = Y - repmat(Psi,[1,size(Y,2)]);
        Y = P' * Y;
    end
    d = m;
end

if not(exist('nn_prepare')==3) && use_nntools
    warning('TSTool not installed, use slow Matlab code instead.');
    use_nntools = 0;
end


if isempty(Y)
    if exlude_self==0
        nbr_nn = nbr_nn - 1;
    end
    if use_nntools
        atria = nn_prepare(X');
        [nn_list,D] = nn_search(X', atria, 1:n, nbr_nn, 0);
    else
        D1 = sqrt( compute_distance_matrix(X) );
        D1 = D1 + diag( Inf + zeros(size(D1,1),1) );
        [D,nn_list] = sort(D1);
        D = D(1:nbr_nn,:)';
        nn_list = nn_list(1:nbr_nn,:)';
    end
    if exlude_self==0
        nn_list = [(1:n)', nn_list];
        D = [zeros(n,1), D];
    end
else
    if exist('nn_prepare')>0 && use_nntools
        atria = nn_prepare(X');
        [nn_list,D] = nn_search(X', atria, Y', nbr_nn, 0);
    else
        D1 = sqrt( compute_distance_matrix(X,Y) );
        [D,nn_list] = sort(D1,2);
        D = D(:,1:nbr_nn)';
        nn_list = nn_list(:,1:nbr_nn)';
    end
end"
