6114,coupledVanDerPol1.m,63.456,60,72.73,30,100.0,54.55,61-70,"function f = coupledVanDerPol1(x,u)



    mu = 1;
    
    f(1,1) = x(2);
    f(2,1) = mu*(1-x(1)^2)*x(2) - 2*x(1) + x(3);
    f(3,1) = x(4);
    f(4,1) = mu*(1-x(3)^2)*x(4) - 2*x(3) + x(1);
end"
6115,composeAffine.m,69.666,60,83.33,30,100.0,75.0,61-70,"function C = composeAffine(A, B)

siz = size(A);
n = siz(1);
assert(isequal(siz, size(B)));
assert(isequal(siz, [n n+1]));

C = zeros(siz);
C(1:3, 1:3) = A(1:3, 1:3) * B(1:3, 1:3);
C(:, 4) = A(1:3, 1:3) * B(:, 4) + A(:, 4);

end"
