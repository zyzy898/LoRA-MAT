3349,cos_pos.m,75.078,100,66.67,60,100.0,48.72,70-80,"function y = cos_pos(x,rnd)


  INTLAB_STDFCTS_SIN = getappdata(0,'INTLAB_STDFCTS_SIN');
  INTLAB_STDFCTS_COS = getappdata(0,'INTLAB_STDFCTS_COS');

  setround(0)
  xs = pow2( floor(pow2(x,14)) , -14 );  % max. 14 bits of mantissa,
  d = x - xs;                            % 0 <= d < 2^-14
  sinxs = sin(xs);
  cosxs = cos(xs);


  if rnd==-1                         % result rounded downwards

    setround(1)                      % rounding upwards
    sinxssup = sinxs*(1+INTLAB_STDFCTS_SIN.EPS);
    sind = d + (((( d.*d/20 - 1 ).*d).*d).*d)/6;

    setround(-1)                     % rounding downwards
    y = cosxs + ...
        ( ( cosxs.*((-d).*d)/2 + ...
            cosxs.*( INTLAB_STDFCTS_COS.EPS.*(d.*d/2-1) ) ) + ...
          (-sinxssup).*sind );

  else                               % result rounded upwards

    setround(-1)                     % rounding downwards
    sinxsinf = sinxs*(1-INTLAB_STDFCTS_SIN.EPS);
    sind = d + (((-d).*d).*d)/6;
    setround(1)                      % rounding upwards
    cosd_ = ( d.*d/12 - 1 ) .* d.*d/2;

    y = cosxs + ...
        ( ( cosxs.*cosd_ + ...
            cosxs.*( INTLAB_STDFCTS_COS.EPS.*(1+cosd_) ) ) + ...
          (-sinxsinf).*sind );

  end"
3350,cot.m,79.524,60,76.19,90,100.0,71.43,70-80,"function varargout = cot(varargin)

switch class(varargin{1})

    case 'sdpvar'
        varargout{1} = InstantiateElementWise(mfilename,varargin{:});

    case 'char'

        operator = CreateBasicOperator('callback');
        operator.derivative = @(x)(-csc(x).^2);
        operator.singularity = [0 -inf inf];
        operator.inflection = [-inf -1 0 1];

        varargout{1} = [];
        varargout{2} = operator;
        varargout{3} = varargin{3};

    otherwise
        error(['SDPVAR/' upper(mfilename) ' called with weird argument']);
end"
3351,cotangent.m,79.778,100,67.78,100,100.0,31.11,70-80,"function C = cotangent(V,F,varargin)

  switch size(F,2)
  case 3

    l = [];
    params_to_variables = containers.Map( ...
      {'SideLengths'}, {'l'});
    v = 1;
    while v <= numel(varargin)
      param_name = varargin{v};
      if isKey(params_to_variables,param_name)
        assert(v+1<=numel(varargin));
        v = v+1;
        feval(@()assignin('caller',params_to_variables(param_name),varargin{v}));
      else
        error('Unsupported parameter: %s',varargin{v});
      end
      v=v+1;
    end
    assert(numel(varargin) == 0);

    if isempty(l)
      l = [ ...
        sqrt(sum((V(F(:,2),:)-V(F(:,3),:)).^2,2)) ...
        sqrt(sum((V(F(:,3),:)-V(F(:,1),:)).^2,2)) ...
        sqrt(sum((V(F(:,1),:)-V(F(:,2),:)).^2,2)) ...
        ];
    end
    i1 = F(:,1); i2 = F(:,2); i3 = F(:,3);
    l1 = l(:,1); l2 = l(:,2); l3 = l(:,3);
    s = (l1 + l2 + l3)*0.5;
    dblA = 2*sqrt( s.*(s-l1).*(s-l2).*(s-l3));
    C = [ ...
      (l2.^2 + l3.^2 -l1.^2)./dblA/4 ...
      (l1.^2 + l3.^2 -l2.^2)./dblA/4 ...
      (l1.^2 + l2.^2 -l3.^2)./dblA/4 ...
      ];
  case 4
    T = F;

    l = [];
    s = [];
    v = 1;
    while v <= numel(varargin)
      switch varargin{v}
      case 'SideLengths'
        assert((v+1)<=numel(varargin));
        v = v+1;
        l = varargin{v};
      case 'FaceAreas'
        assert((v+1)<=numel(varargin));
        v = v+1;
        s = varargin{v};
      otherwise
        error(['Unsupported parameter: ' varargin{v}]);
      end
      v = v+1;
    end
    if isempty(l)
      l = [ ...
        sqrt(sum((V(T(:,4),:)-V(T(:,1),:)).^2,2)) ...
        sqrt(sum((V(T(:,4),:)-V(T(:,2),:)).^2,2)) ...
        sqrt(sum((V(T(:,4),:)-V(T(:,3),:)).^2,2)) ...
        sqrt(sum((V(T(:,2),:)-V(T(:,3),:)).^2,2)) ...
        sqrt(sum((V(T(:,3),:)-V(T(:,1),:)).^2,2)) ...
        sqrt(sum((V(T(:,1),:)-V(T(:,2),:)).^2,2)) ...
      ];
    end
    if isempty(s)
      s = 0.5*[ ...
        doublearea_intrinsic(l(:,[2 3 4])) ...
        doublearea_intrinsic(l(:,[1 3 5])) ...
        doublearea_intrinsic(l(:,[1 2 6])) ...
        doublearea_intrinsic(l(:,[4 5 6]))];
    end

    [~,cos_theta] = dihedral_angles([],[],'SideLengths',l,'FaceAreas',s);

    vol = volume_intrinsic(l);


    sin_theta = bsxfun(@rdivide,vol,(2./(3*l)) .* s(:,[2 3 1 4 4 4]) .* s(:,[3 1 2 1 2 3]));

    C = 1/6 * l .* cos_theta ./ sin_theta;
  otherwise
    error('Unsupported simplex type');
  end

end"
