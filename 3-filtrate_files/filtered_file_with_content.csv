        '_l_', num2str(lambda), '_e_', num2str(eta), '_', t, '.mat'));
    disp(fn);
    save(fn, 'acc', 'rt'); 
    best_acc = max(acc);
end"
558,COPAR_updateD.m,86.112,100,88.89,75,100.0,66.67,80-90,"function D = COPAR_updateD(Y, Y_range, D, X, opts) % and DCp1 
    if nargin == 0 
        clc;
        addpath(fullfile('..', 'utils'));
        addpath(fullfile('..', 'DLSI'));
        C = 10;    N = 7;    d = 300;      
        k = 7;
        opts.k0          = 10;
        opts.lambda      = 0.01;
        opts.eta         = 0.1;
        opts.D_range     = k* (0:C);
        opts.D_range_ext = [opts.D_range opts.D_range(end)+opts.k0];
        opts.max_iter    = 10;
        opts.verbose      = true;
        

        load('tmp2.mat', 'Y', 'Y_range', 'D', 'X');
    end         
    
    C              = numel(Y_range) - 1;
    D_range_ext    = opts.D_range_ext;    
    DCp1           = get_block_col(D, C+1, D_range_ext);
    optsD          = opts;
    optsD.verbose   = false;
    optsD.max_iter = 100;    
    Yhat           = zeros(size(Y));
    for c = 1: C 
        Dc_range = D_range_ext(c)+1: D_range_ext(c+1);
        Yc_range = Y_range(c)+1: Y_range(c+1);
        Yc       = Y(:, Yc_range);
        Dc       = D(:, Dc_range);
        Xc       = X(:, Yc_range);
        Xcc      = get_block_row(Xc, c, D_range_ext);
        XCp1c    = get_block_row(Xc, C+1, D_range_ext);
        Ychat    = Yc - D*Xc + Dc*Xcc;
        Ycbar    = Yc - DCp1*XCp1c;
        E        = (Ychat + Ycbar)*Xcc';
        F        = 2*Xcc*Xcc';
        A        = D;
        A(:,Dc_range)     = []; 
        D(:, Dc_range)    = DLSI_updateD(Dc, E, F, A', opts.eta, optsD);
        Yhat(:, Yc_range) = Yc - D(:, Dc_range)*Xcc;            
    end 
    XCp1       = X(D_range_ext(C+1) + 1 : D_range_ext(C+2), :);
    Ybar       = Y - D(:, 1: D_range_ext(end-1))*X(1: D_range_ext(end-1), :);
    E          = (Ybar + Yhat)*XCp1';
    F          = 2*XCp1*XCp1';
    A          = D(:, 1: D_range_ext(C+1));
    DCp1_range = D_range_ext(C+1) + 1: D_range_ext(C+2);
    D(:, DCp1_range) = DLSI_updateD(D(:, DCp1_range), E, F, A', opts.eta,  optsD);         
    if nargin == 0
        D = [];
    end 
end"
559,COPAR_updateX.m,84.5,100,87.5,75,100.0,60.0,80-90,"function X = COPAR_updateX(Y, Y_range, D, X, opts) 
    if nargin == 0
        addpath(fullfile('..', 'utils'));
        fprintf('Test most\\n');
        d = 3000;
        N = 30;
        k = 20;
        k0 = 50;
        C = 100 ;
        opts.k0 = k0;
        opts.lambda = 0.01;
        opts.eta = 0.1;
        Y = normc(rand(d, C*N));
        D = normc(rand(d, C*k + k0));
        X = zeros(size(D,2), size(Y,2));
        Y_range = N*(0:C);
        opts.D_range = k* (0:C);
        opts.D_range_ext = [opts.D_range opts.D_range(end)+k0];
        opts.verbose = false;
        opts.max_iter = 30;
    end 
    C = numel(Y_range) - 1;
    DtD = D'*D;
    DtY = D'*Y;
    L = 2*max(eig(DtD)) + 10;    
    optsX = opts;
    optsX.max_iter = 100;
    for c = 1: C
        Xc = get_block_col(X, c, Y_range);
        X(:, Y_range(c)+1: Y_range(c+1)) = ...
            COPAR_updateXc(DtD, DtY, Y_range, Xc, c, L, optsX);
        if opts.verbose
            costXc = COPAR_cost(Y, Y_range, D, X, opts);
            fprintf('class = %3d | costXc: %5f\\n', c, costXc);
        end
    end
    if nargin == 0
        X = [];
    end
end"
560,COPAR_updateX2.m,86.75,100,85.42,90,100.0,58.33,80-90,"function X = COPAR_updateX2(Y, Y_range, D, X, opts) 
    if nargin == 0
        addpath(fullfile('..', 'utils'));
        fprintf('Test most\\n');
        d = 30;
        N = 7;
        k = 7;
        k0 = 10;
        C = 20 ;
   
        load(fullfile('..', 'dictol_python', 'data', 'tmp5.mat'), ...
            'Y', 'D', 'X', 'Y_range');
        
        opts.k0 = k0;
