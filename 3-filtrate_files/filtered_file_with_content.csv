h1 = fopen(outname,'W');
for i = timeperiod(1)+1:timeperiod(2)
    fwrite(h1,m.Data((i-1)*NumCh*SampRate+1:i*NumCh*SampRate),'uint16');
end
fclose(h1);

d = dir('analogin.dat');
if ~isempty(d)
    disp('Writing analogin file')
