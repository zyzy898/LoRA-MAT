    function wave = wavelet_function(j, k, n, parameter)
        qmf = spx.wavelet.coiflet.quad_mirror_filter(parameter);
        w = zeros(1, n);
        index = spx.wavelet.dyad_to_index(j, k);
        w(index) = 1;         
        wave = spx.wavelet.transform.inverse_periodized_orthogonal(qmf, w, j);
    end

    function wave = scaling_function(j, k, n, parameter)
        qmf = spx.wavelet.coiflet.quad_mirror_filter(parameter);
        w = zeros(1, n);
        w(k) = 1;
        wave = spx.wavelet.transform.inverse_periodized_orthogonal(qmf, w, j);
    end

end


end"
1659,CoilBiotSavart.m,72.834,100,68.75,60,100.0,35.42,70-80,"function [B1x,B1y,B1z]=CoilBiotSavart(points)

global VMco

x=points(1,:);
y=points(2,:);
z=points(3,:);

xgrid=VMco.xgrid;
ygrid=VMco.ygrid;
zgrid=VMco.zgrid;

mu0 = 4*pi*1e-7;       % Permeability of free space (T*m/A)
I_current = 1;       % Current in the loop (A)
Constant = mu0/(4*pi) * I_current;   % Useful constant

B1x = zeros(size(xgrid));
B1y = zeros(size(xgrid));
B1z = zeros(size(xgrid));

for i=1:length(x)-1
    
    dlx = x(i+1)-x(i);
    dly = y(i+1)-y(i);
    dlz = z(i+1)-z(i);
    
    xc = (x(i+1)+x(i))/2;
    yc = (y(i+1)+y(i))/2;
    zc = (z(i+1)+z(i))/2;
    
    rx = xgrid - xc;
    ry = ygrid - yc;
    rz = zgrid - zc;
    
    r3 = sqrt(rx.^2 + ry.^2 + rz.^2).^3;
    
    dlXr_x = dly.*rz - dlz.*ry;
    dlXr_y = dlz.*rx - dlx.*rz;
    dlXr_z = dlx.*ry - dly.*rx;
    
    B1x = B1x + Constant.*dlXr_x./r3;
    B1y = B1y + Constant.*dlXr_y./r3;
    B1z = B1z + Constant.*dlXr_z./r3;
    
    
end

end"
1660,CoilDesignPanel.m,72.758,70,49.09,100,100.0,44.7,70-80,"function varargout = CoilDesignPanel(varargin)



