2045,compTriangle.m,76.396,100,69.77,75,100.0,37.21,70-80,"img = logical(zeros(100, 100));
img(26:75, 26:75) = 1;

N = 96;

for i = 1:N
    angle = (i-1)*2*pi/N;
    x0 = 50;
    y0 = 50;
    dx = cos(angle);
    dy = sin(angle);

    len = 1;
    if abs(dx)>abs(dy)
        trueY = y0;
        dx = sign(dx);
        while img(y0, x0)
            x0 = x0 + dx;
            trueY = trueY + dy;
            if abs(trueY - y0) > .5
                y0 = y0+sign(dy);
                len = len+sqrt(2);
            else
                len = len + 1;
            end
        end
    else
        trueX = x0;
        dy = sign(dy);
        while img(y0, x0)
            y0 = y0 + dy;
            trueX = trueX + dx;
            if abs(trueX - x0) > .5
                x0 = x0+sign(dx);
                len = len+sqrt(2);
            else
                len = len + 1;
            end
        end
    end

    ori(i) = len;
end"
