1787,combinestructs.m,78.868,100,56.6,100,100.0,37.74,70-80,"function s1 = combinestructs(s1,s2,mode)

if nargin<3 || isempty(mode)
  mode = 'replace';
end


if nargin>=2 && ~isempty(s2)                      % [] is a valid options argument
  N1 = numel(s1);
  N2 = numel(s2);
 
  
  
    s2Names  = fieldnames(s2).';
    s1Names  = fieldnames(s1).';
  
    switch mode
      case {'a','add'} % add
        fnames = setdiff(s2Names,s1Names);
      case {'m','merge'}
        fnames = s2Names;
      otherwise
        fnames = intersect(s2Names,s1Names);
        
        

    end
    flag  =  2*(N1>1) + N2>1;
    
    
    N = max(N1,N2);
    
    switch flag
      case 0
        for fn = fnames
          s1.(fn{1}) = s2.(fn{1});
        end
      case 1
        for fn = s1Names
          [s1(1:N).(fn{1})] = deal(s1(1).(fn{1}));
        end
        for fn = fnames
          [s1(1:N).(fn{1})] = deal(s2.(fn{1}));
        end
      case {2,3}
        for fn = fnames
          [s1.(fn{1})] = deal(s2.(fn{1}));
        end
    end
end


return"
