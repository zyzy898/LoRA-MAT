hold on
 
 
G.x  = [0; -4];
U.dt = 1/32;
U.u  = sparse(512,0);

G.f  = @(x,u,P,M)([0 P.Q;-P.Q 0]*dLdx(x,P));
y    = spm_int_J(P,G,U);

 
subplot(hL)
plot3(y(:,2),y(:,1),L(y',Ep),'r')
subplot(hC)
plot3(y(:,2),y(:,1),L(y',Ep),'r')
subplot(hP)
plot3(y(:,2),y(:,1),exp(-L(y',Ep)),'r')

G.f  = f;
