    fprintf('-------------------------------------------------------\\n')
    res(i).MI = MI;
    res(i).NMI = NMI;
    res(i).QABF = QABF;
    res(i).VIFF = VIFF;
    
    figure,imshow(imgF0,[]),title('Fused Image')
    pause(2);
    close all;

end"
