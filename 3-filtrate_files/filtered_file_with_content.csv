end
 pp = @(r,j,v,f) max(1-r,0).^(j+v).*f(r,j);
dpp = @(r,j,v,f) max(1-r,0).^(j+v-1).*r.*( (j+v)*f(r,j) - max(1-r,0).*df(r,j) );

