        val = ctr.Xmask_filename;
    case {'require_way'}
        val = ctr.require_way;
    case {'compute_fa'}
        val = ctr.compute_fa;
    case {'sampler_type'}
        val = ctr.sampler_type;
    case {'desired_samples'}
        val = ctr.desired_samples;
    case {'burnin'}
        val = ctr.burnin;
    case {'max_nodes'}
        val = ctr.max_nodes;
    case {'min_nodes'}
        val = ctr.min_nodes;
    case {'step_size'}
        val = ctr.step_size;
    case {'skip_samples'}
        val = ctr.skip_samples;
    case {'roi'}
        if length(varargin) ~= 2, error('Incomplete ctrGet for ROI'); end
        arg1 = varargin{1};
        arg2 = varargin{2};
        switch lower(arg2)
            case {'coords'}
                val = ctr.roi{arg1}.coords;
            case {'valid_cortex'}
                val = ctr.roi{arg1}.valid_cortex;
            case {'seed_region'}
                val = ctr.roi{arg1}.seed_region;
        end
    case {'translate'}
        val = ctr.translate;
    case {'isr'}
        val = ctr.isr;
    case {'esr'}
        val = ctr.esr;
    case {'temp_swap'}
