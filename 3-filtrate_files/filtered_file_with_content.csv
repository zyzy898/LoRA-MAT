                if A(4)<B(4)
                    row = 5;
                elseif A(4)==B(4)
                    row = 6;
                else 
                    row = 10;
                end
            elseif A(2)==B(4)
                row = 11;
            elseif A(2)>B(4)
                row = 12;
            end
        end
    end
    
    [core9state, topr, dir, dis] = core9config(row,col);
end"
