3332,cosspace.m,74.0,60,85.0,60,100.0,65.0,70-80,"function x = cosspace(x1, x2, N, flag)

L = x2 - x1;

switch flag
    case 'start'
        t = linspace(pi,pi/2,N)';
        x = x1 + L.*(1 + cos(t));
    case 'end'
        t = linspace(pi/2,0,N)';
        x = x1 + L.*cos(t);
    case 'both'
        t = linspace(pi,0,N)';
        x = x1 + L.*(1 + cos(t))./2;
end

x(1)   = x1;    % fixes rounding errors from floating point
x(end) = x2;    % fixes rounding errors from floating point

end % function cosspace"
