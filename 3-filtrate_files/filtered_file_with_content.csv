6588,convert2avi.m,69.454,60,68.18,60,100.0,59.09,61-70,"function [] = convert2avi(infile, outfile)

    v = VideoReader(infile);

    if ~strcmp(v.VideoFormat,'RGB24')
        error('color space of video file not recognized');
    end

    cnt = 1;
    while hasFrame(v)
        tmp = readFrame(v);
        [y, cb, cr] = rgb2ycbcr_double(single(tmp), '128', 'y_cb_cr');

        all_y(:,:,cnt) = y;
        all_cb(:,:,cnt) = cb;
        all_cr(:,:,cnt) = cr;
        
        cnt = cnt + 1;
    end
    
    write_avi('YCbCr', all_y, all_cb, all_cr, 'YCbCr', outfile, v.FrameRate, '128');
end"
6589,Derive_acrobot.m,65.66,100,75.47,0,100.0,52.83,61-70,"syms q1 q2 dq1 dq2 ddq1 ddq2 'real'   % states
syms u 'real' % actuation
syms m1 m2 g l1 l2 'real' % physical parameters

i = sym([1;0]);
j = sym([0;1]);

e1 = cos(q1)*(-j) + sin(q1)*(i);    % shoulder -> elbow
e2 = cos(q2)*(-j) + sin(q2)*(i);    % elbow -> wrist

z = [q1;q2;dq1;dq2];
dz = [dq1;dq2;ddq1;ddq2];

p1 = l1*e1;
p2 = p1 + l2*e2;

dp1 = jacobian(p1,z)*dz;  %Chain rule to get velocity of elbow joint
dp2 = jacobian(p2,z)*dz; 

ddp1 = jacobian(dp1,z)*dz;  
ddp2 = jacobian(dp2,z)*dz; 

cross2d = @(a,b)(a(1)*b(2) - a(2)*b(1));

sumTorques1 = cross2d(p1,-m1*g*j) + cross2d(p2,-m2*g*j);
sumInertial1 = cross2d(p1,m1*ddp1) + cross2d(p2,m2*ddp2);
eqn1 = sumTorques1-sumInertial1;

sumTorques2 = cross2d(p2-p1,-m2*g*j) + u;
sumInertial2 = cross2d(p2-p1,m2*ddp2);
eqn2 = sumTorques2-sumInertial2;

ddq = [ddq1;ddq2];
eqns = [eqn1;eqn2];
[MM,ff] = equationsToMatrix(eqns,ddq); 

matlabFunction(MM(1,1),MM(1,2),MM(2,1),MM(2,2),ff(1),ff(2),G,B,...
    'file','autoGen_acrobotDynamics.m',...
    'vars',{q1,q2,dq1,dq2,u,m1,m2,g,l1,l2},...
    'outputs',{'M11','M12','M21','M22','f1','f2'});

U = m1*g*dot(p1,j) + m2*g*dot(p2,j);   %Potential Energy
T = 0.5*m1*dot(dp1,dp1) + 0.5*m2*dot(dp2,dp2);   %Kinetic Energy

matlabFunction(U,T,...
    'file','autoGen_acrobotEnergy.m',...
    'vars',{q1,q2,dq1,dq2,m1,m2,g,l1,l2},...
    'outputs',{'U','T'});

matlabFunction(p1,p2,dp1,dp2,...
    'file','autoGen_acrobotKinematics.m',...
    'vars',{q1,q2,dq1,dq2,l1,l2},...
    'outputs',{'p1','p2','dp1','dp2'});"
6590,covEye.m,67.81,60,76.19,60,100.0,42.86,61-70,"function K = covEye(hyp, x, z, i)


tol = eps;   % threshold on the norm when two vectors are considered to be equal
if nargin<2, K = '0'; return; end                  % report number of parameters
if nargin<3, z = []; end                                   % make sure, z exists
dg = strcmp(z,'diag');                                          % determine mode

n = size(x,1);

if dg                                                               % vector kxx
  K = ones(n,1);
else
  if isempty(z)                                           % symmetric matrix Kxx
    K = eye(n);
  else                                                   % cross covariances Kxz
    K = double(sq_dist(x',z')<tol*tol);
  end
end

if nargin==4, error('Unknown hyperparameter'), end                 % derivatives"
6591,codeDiscrim.m,61.666,60,80.0,15,100.0,53.33,61-70,"function tR = codeDiscrim(signalSettings,tR,ch)

trackChannelData = tR.channel(ch);
loopCnt = tR.loopCnt;
I_E = trackChannelData.I_E;
Q_E = trackChannelData.Q_E;
I_L = trackChannelData.I_L;
Q_L = trackChannelData.Q_L;

codeError = (sqrt(I_E * I_E + Q_E * Q_E) - sqrt(I_L * I_L + Q_L * Q_L)) / ...
           (sqrt(I_E * I_E + Q_E * Q_E) + sqrt(I_L * I_L + Q_L * Q_L)) ;              

trackChannelData.dllDiscr(loopCnt)     = codeError;

tR.channel(ch) = trackChannelData;"
