                try
                    model.(translation{j,2}){i} = strrep(model.(translation{j,2}){i},'CHEBI:','');
                    model.(translation{j,2}){i} = strrep(model.(translation{j,2}){i},'META:','');
                    metabolite_structure.(tok).(translation{j,1}) = model.(translation{j,2}){i};
                catch
                    metabolite_structure.(tok).(translation{j,1}) = model.(translation{j,2})(i);
                end
                 metabolite_structure.(tok).([translation{j,1},'_source']) = model.modelID;
            end
        end
    end
end

metabolite_structure= addField2MetStructure(metabolite_structure);
[metabolite_structure] = cleanUpMetabolite_structure(metabolite_structure);"
511,ConvertNetwork.m,80.646,80,56.73,100,100.0,66.5,80-90,"function [F, names, valNames] = ConvertNetwork(filename)

nameToIdx = struct(); % using the struct as an associative array
valNames = {};
varCard = []; % cardinality of variables
F = struct('var', {}, 'card', {}, 'val', {});

fid = fopen(filename, 'rt');
assert(fid ~= -1, ['Error opening file ', filename]);

tline = fgetl(fid);
while ischar(tline)    
  if strfind(tline, 'node ') == 1
    tmp = textscan(tline, '%*s %s');
    curName = char(tmp{1});
    nameToIdx.(curName) = numel(fieldnames(nameToIdx)) + 1;

    tline = fgetl(fid);
    while tline(1) ~= '}'
      if ~isempty(strfind(tline, 'states'))
        startIdx = strfind(tline, '(') + 1;
        endIdx = strfind(tline, ')');
        assert(~isempty(endIdx), 'Error: state string spans multiple lines');
        endIdx = endIdx - 1;
        stateNames = tline(startIdx:endIdx);
        
        curStateNames = {};
        while true
          [str stateNames] = strtok(stateNames);          
          if isempty(str), break; end          
          str = str(2:end-1); % remove quotes
          curStateNames{end+1} = str;          
        end
        valNames{end+1} = curStateNames;
        varCard(end+1) = numel(curStateNames);
        break;
      end      
      tline = fgetl(fid);
    end
    
    tline = fgetl(fid);
    while tline(1) ~= '}'
      tline = fgetl(fid);
    end
    
  elseif strfind(tline, 'potential ') == 1
    obIdx = strfind(tline, '(');
    cbIdx = strfind(tline, ')');
    barIdx = strfind(tline, '|');
    
    varName = strtrim(tline(obIdx+1:barIdx-1));    
    parents = strtrim(tline(barIdx+1:cbIdx-1));
    
    if (isempty(parents))
      allVars = cellstr(varName);
    else
      parentVars = {};
      while true
        [str parents] = strtok(parents);
        if isempty(str), break; end
        parentVars{end+1} = str;
      end
      allVars = parentVars;
      allVars{end+1} = varName;
    end
   
    varIds = zeros(1, numel(allVars));    
    for i = 1:numel(allVars)
      varIds(i) = nameToIdx.(allVars{i});
    end
    cards = varCard(varIds);
    
    tline = fgetl(fid);
    while isempty(strfind(tline, 'data '))
      tline = fgetl(fid);      
    end
    
    obIdx = strfind(tline, '(');
    
    valString = tline(obIdx+1:end);
    while isempty(strfind(tline, ';'))
      tline = fgetl(fid);
      valString = [valString tline];      
    end
    valString = strtrim(regexprep(valString, '[();]', ' '));
    
    tmp = textscan(valString, '%f', prod(cards));
    vals = tmp{1};
    
    F(end + 1) = struct('var', fliplr(varIds), 'card', fliplr(cards), 'val', vals(:)');
    
    tline = fgetl(fid);
    while tline(1) ~= '}'
      tline = fgetl(fid);
    end    
  end  
  
  tline = fgetl(fid);
end

fclose(fid);
names = fieldnames(nameToIdx);

end"
512,convertOldCouplingFormat.m,87.352,100,85.29,75,100.0,76.47,80-90,"function model = convertOldCouplingFormat(model, printLevel)

if nargin < 2
    printLevel = 0;
end

if isfield(model,'A') && isfield(model,'S')
    
    if printLevel >=1
        warning('The inserted Model contains an old style coupling matrix (A). The Matrix will be converted into a Coupling Matrix (C) and fields will be adapted.')
    end
    slacks = strncmp('slack_',model.mets,length('slack_'));
    if all(size(model.A) == size(model.S)) && any(slacks)
        C = model.S(slacks,:);
        ctrs = model.mets(slacks);
        d = model.b(slacks);
        dsense = model.csense(slacks);
        model = removeMetabolites(model,model.mets(slacks),false);
    else
        nMets = size(model.S,1);
        C = model.A(nMets+1:end,:);
        ctrs = columnVector(model.mets(nMets+1:end));
        dsense =  columnVector(model.csense(nMets+1:end));
        d = columnVector(model.b(nMets+1:end));
        model.mets = columnVector(model.mets(1:nMets));
        model.b = columnVector(model.b(1:nMets));
        model.csense = columnVector(model.csense(1:nMets));
    end
    model.C = C;
    model.ctrs = ctrs;
    model.dsense = dsense;
    model.d = d;
    model = rmfield(model,'A');
end"
513,ConvertRawDataToRRIntervals.m,82.446,100,66.67,90,100.0,55.56,80-90,"function [t,rr,jqrs_ann,SQIjw, StartSQIwindows_jw] = ConvertRawDataToRRIntervals(ECG_RawData ,HRVparams, subjectID)

if nargin < 3
    error('Wrong number of arguments in ConvertRawDataToRRIntervals')
end


GainQrsDetect = 2000; % Default value for gain (adu/physical unit) 

if size(ECG_RawData,1)<size(ECG_RawData,2)
    ECG_RawData = ECG_RawData';
end

ECG_RawData = ECG_RawData(:,1); % If more the one leads use only the first

jqrs_ann = run_qrsdet_by_seg(ECG_RawData,HRVparams);

sqrs_ann = run_sqrs(ECG_RawData*GainQrsDetect,HRVparams,0);

wqrs_ann = wqrsm_fast(ECG_RawData*GainQrsDetect,HRVparams.Fs);

[SQIjs, StartSQIwindows_js] = bsqi(jqrs_ann(:),sqrs_ann(:),HRVparams);
[SQIjw, StartSQIwindows_jw] = bsqi(jqrs_ann(:),wqrs_ann(:),HRVparams);


rr = diff(jqrs_ann./HRVparams.Fs);
t = jqrs_ann(2:end)./HRVparams.Fs;


WriteAnnotationFolder = [HRVparams.writedata filesep 'Annotation'];
if ~exist(WriteAnnotationFolder, 'dir')
   mkdir(WriteAnnotationFolder)
   fprintf('Creating a new folder: ""Annotation"", folder is located in %s \\n',[pwd filesep WriteAnnotationFolder]);
end
addpath(WriteAnnotationFolder)

AnnFile = strcat(WriteAnnotationFolder, filesep, subjectID);
write_hea(AnnFile, HRVparams.Fs, length(ECG_RawData), 'jqrs', 1, 0,'mV')
write_ann(AnnFile, HRVparams,'jqrs',jqrs_ann);
write_ann(AnnFile, HRVparams,'sqrs',sqrs_ann);
write_ann(AnnFile, HRVparams,'wqrs',wqrs_ann);
fakeAnnType = repmat('S',[length(SQIjs), 1]);
write_ann(AnnFile, HRVparams,'sqijs', StartSQIwindows_js.*HRVparams.Fs, fakeAnnType ,round(SQIjs*100));%write_ann(AnnFile, HRVparams,'sqijs', StartSQIwindows_js, fakeAnnType ,round(SQIjs*100)); 
fakeAnnType = repmat('S',[length(SQIjw), 1]);
write_ann(AnnFile, HRVparams,'sqijw', StartSQIwindows_jw.*HRVparams.Fs,fakeAnnType ,round(SQIjw*100));%write_ann(AnnFile, HRVparams,'sqijw', StartSQIwindows_jw,fakeAnnType ,round(SQIjw*100));"
514,convertRecon3DToRaven.m,81.154,100,76.92,75,100.0,53.85,80-90,"load('/Users/haowa/Box Sync/HMR3/Recon3D/Published/ModelFiles/Recon3D_301/Recon3D_301.mat');

load('HMRdatabase2_00.mat');

Recon3D.comps=[ihuman.comps;'i'];
Recon3D.compNames=[ihuman.compNames;'Inner mitochondria'];

Recon3D.originalMets=Recon3D.mets;   % Make a backup
Recon3D.mets=regexprep(Recon3D.mets,'\\[e\\]','[s]');
Recon3D.mets=regexprep(Recon3D.mets,'\\[x\\]','[p]');

Recon3D=rmfield(Recon3D,'metPubChemID');

Recon3DRaven=ravenCobraWrapper(Recon3D);

Recon3DRaven.rxnEquations=constructEquations(Recon3DRaven);
