4969,deep_seminmf.m,75.164,80,53.24,100,100.0,42.58,70-80,"function [ Z, H, dnorm ] = deep_seminmf ( X, layers, varargin )

pnames = { ...
    'z0' 'h0' 'bUpdateH' 'bUpdateLastH' 'maxiter' 'TolFun', 'verbose', 'bUpdateZ', 'cache' ...
};


X = bsxfun(@rdivide,X,sqrt(sum(X.^2,1)));

num_of_layers = numel(layers);

Z = cell(1, num_of_layers);
H = cell(1, num_of_layers);

dflts  = {0, 0, 1, 1, 500, 1e-5, 1, 1, 1};

[z0, h0, bUpdateH, bUpdateLastH, maxiter, tolfun, verbose, bUpdateZ, cache] = ...
        internal.stats.parseArgs(pnames,dflts,varargin{:});

if  ~iscell(h0)
    for i_layer = 1:length(layers)
        if i_layer == 1
            V = X;
        else 
            V = H{i_layer-1};
        end
        
        if verbose
            display(sprintf('Initialising Layer #%d with k=%d with size(V)=%s...', i_layer, layers(i_layer), mat2str(size(V))));
        end
        if ~iscell(z0)
            [Z{i_layer}, H{i_layer}, ~] = ...
                 seminmf(V, ...
                     layers(i_layer), ...
                     'maxiter', maxiter, ...
                     'bUpdateH', true, 'bUpdateZ', bUpdateZ, 'verbose', verbose, 'save', cache, 'fast', 1); 
        else
            display('Using existing Z');
            [Z{i_layer}, H{i_layer}, ~] = ...
                 seminmf(V, ...
                     layers(i_layer), ...
                     'maxiter', 1, ...
                     'bUpdateH', true, 'bUpdateZ', 0, 'z0', z0{i_layer}, 'verbose', verbose, 'save', cache, 'fast', 1); 
        end
    end

else
    Z=z0;
    H=h0;
    
    if verbose
        display('Skipping initialization, using provided init matrices...');
    end
end


dnorm0 = cost_function(X, Z, H);
dnorm = dnorm0 + 1;

if verbose
    display(sprintf('#%d error: %f', 0, dnorm0));
end

if verbose
    display('Finetuning...');
end
H_err = cell(1, num_of_layers);


for iter = 1:maxiter  
    H_err{numel(layers)} = H{numel(layers)};
    for i_layer = numel(layers)-1:-1:1
        H_err{i_layer} = Z{i_layer+1} * H_err{i_layer+1};
    end
    
    for i = 1:numel(layers)
        if bUpdateZ
            try
                if i == 1
                    Z{i} = X  * pinv(H_err{1});
                else
                    Z{i} = pinv(D') * X * pinv(H_err{i});
                end
            catch 
                display(sprintf('Convergance error %f. min Z{i}: %f. max %f', norm(Z{i}, 'fro'), min(min(Z{i})), max(max(Z{i})))); 
            end
        end
        
        if i == 1
            D = Z{1}';
        else
            D = Z{i}' * D;
        end
       
        if bUpdateH && (i < numel(layers) || (i == numel(layers) && bUpdateLastH))
            A = D * X;
            Ap = (abs(A)+A)./2;
            An = (abs(A)-A)./2;

            B = D * D';
            
            Bp = (abs(B)+B)./2;
            Bn = (abs(B)-B)./2;
    
       
            H{i} = H{i} .* sqrt((Ap + Bn * H{i}) ./ max(An + Bp * H{i}, 1e-10));
        end
    end
    
    assert(i == numel(layers));
    
    dnorm = cost_function(X, Z, H);
    
    if verbose
        display(sprintf('#%d error: %f', iter, dnorm));
    end
    
    assert(dnorm <= dnorm0 + 0.01, ...
        sprintf('Rec. error increasing! From %f to %f. (%d)', ...
        dnorm0, dnorm, iter) ...
    );
    
    dnorm0 = dnorm;
end
end

function error = cost_function(X, Z, H)
    error = norm(X - reconstruction(Z, H), 'fro');
end

function [ out ] = reconstruction( Z, H )

    out = H{numel(H)};

    for k = numel(H) : -1 : 1;
        out =  Z{k} * out;
    end

end"
4970,deep_seminmf_nonlinear.m,74.916,80,48.73,100,100.0,45.85,70-80,"function [ Z, H, dnorm, R ] = deep_seminmf_nonlinear ( X, layers, varargin )

pnames = { ...
    'z0' 'h0' 'bUpdateH' 'bUpdateLastH' 'maxiter' 'g', 'g_inv', ...
    'g_inv_diff', 'TolFun', 'save', 'nonlinearity', 'gnd' ...
};

num_of_layers = numel(layers);


X = bsxfun(@rdivide,X,sqrt(sum(X.^2,1)));


Z = cell(1, num_of_layers);
H = cell(1, num_of_layers);

dflts  = {0, 0, 1, 1, 300, @(x) x, @(x) x, @(x) x, 1e-5, 1, 'tanh', []};

[z0, h0, bUpdateH, bUpdateLastH, maxiter, g, g_inv, g_inv_diff, tolfun, doSave, nonlinearity, gnd] = ...
        internal.stats.parseArgs(pnames,dflts,varargin{:});


if strcmp(nonlinearity, 'tanh') == 1
    g = @(x) 3 .* atanh(x./1.7159 ) ./2;
    g_inv = @(x) 1.7159 * tanh( 2/3 * x);
    g_inv_diff = @(x)  1.7159 * 2 / 3 .* (sech((2 .* x) ./ 3) .^ 2);
elseif strcmp(nonlinearity, 'square') == 1
    g = @(x) x .^ 0.5;
    g_inv = @(x) x .* x;
    g_inv_diff = @(x) 2 * x;
elseif strcmp(nonlinearity, 'sigmoid') == 1
    sigmoid = @(x) (1./(1+exp(-x)));
    g_inv = sigmoid;
    g_inv_diff = @(x) sigmoid(x) .* (1 - sigmoid(x));
    g = @(x) log(x ./ (1 - x));
elseif strcmp(nonlinearity, 'softplus') == 1
    g_inv = @(x) log(1 + exp(x));
    g_inv_diff = @(x) exp(x) ./ (1 + exp(x));
    g = @(x) log(exp(x) - 1);
else
    
    assert(strcmp(nonlinearity, 'manual') == 1)
            
end



R = cell(numel(layers) - 1, 1);

if ~iscell(z0) && ~iscell(h0)
    for i_layer = 1:length(layers)
        if i_layer == 1
            R{i_layer} = 1; %max(max(X(:)), 1);
            V = X ./ R{i_layer};
        else 
            R{i_layer} = max(max(max(H{i_layer-1})), 1);
            V = g(H{i_layer-1} ./ R{i_layer});
        end
        
        
        display(sprintf('Initialising Layer #%d...', i_layer));
    
        [Z{i_layer}, H{i_layer}, ~] = ...
             seminmf(V, ...
                 layers(i_layer), ...
                 'maxiter', 300, ...
                 'bUpdateH', true, 'save', doSave, 'fast', 1); 
             
    end

else
    Z=z0;
    H=h0;
    
    display('Skipping initialization, using provided init matrices...');
end

dnorm0 = norm(X - deep_recon(Z, H, R, g_inv), 'fro');
dnorm = dnorm0;

display(sprintf('#%d error: %f', 0, dnorm0));

for i = 1:numel(layers)
    display(sprintf('R[%d] = %f', i, R{i}));
end

display('Finetuning...');

for iter = 1:maxiter  
    for i = numel(layers):-1:1
        
        if i == 2    
            KSI = Z{1}' * X;
            PSI = Z{1}' * Z{1} * (R{1} * R{2});
        end
        
        if  bUpdateH && (i < numel(layers) || (i == numel(layers) && bUpdateLastH))  
            
            if i == 1
                
                
                H{1} = R{2} * g_inv(Z{2} * H{2});
                H{i}(H{i} <= 0) = eps;
            else 
                c = R{2} * g_inv_diff(Z{2} * H{2});
                
                A = KSI;
                B = PSI  * g_inv(Z{2} * H{2});
                
                C = Z{2}' * ((B - A) .* c);
                [H, ~] = gd_H(X, Z, H, R, C, i, g_inv, dnorm);          
            end
        end
        
        dnorm = norm(X - deep_recon(Z, H, R, g_inv), 'fro');
        
        
        assert(~any(any(isnan(H{i}))));
        assert(isreal(H{i}));
        
        if i == 1
           Z{i} = X  * pinv(g_inv(Z{2} * H{2}));
           
        else
            c =  g_inv_diff(Z{2} * H{2}); 
            C =((Z{1}' * (Z{1} * g_inv(Z{2} * H{2}) - X) .* c)) * H{2}';
            
            Z = gd_Z(X, Z, H, R, C, i, g_inv, dnorm);       
        end
        
        
        
        dnorm = norm(X - deep_recon(Z, H, R, g_inv), 'fro');
        
        
        assert(isreal(Z{i}));
        assert(~any(any(isnan(Z{i}))));
    end
    
    
    dnorm = norm(X - deep_recon(Z, H, R, g_inv), 'fro');
    
    display(sprintf('#%d error: %f', iter, dnorm));

    if length(gnd) > 0 && mod(iter, 10) == 0
      ac = evalResults(H, gnd);
      fprintf(1, 'Having %f clustering accuracy\\n', ac);
    end
    
    
    if 0 && dnorm0-dnorm <= tolfun*max(1,dnorm0)
        display( ...
            sprintf('Stopped at %d: dnorm: %f, dnorm0: %f', ...
                iter, dnorm, dnorm0 ...
            ) ...
        );
        break;
    end
    
    dnorm0 = dnorm;
end



end


function [Z, dnorm1] = gd_Z(X, Z, H, R, c, i, g_inv, dnorm)
    eta = 0.01;
    oldZ = Z{i};
    iter = 0;
    
    while(1)
        iter = iter + 1;
        eta = eta / 2;
        Z{i} = oldZ - eta .* c;
        
        dnorm1 = norm(X - deep_recon(Z, H, R, g_inv), 'fro');
       
        if  eta < 0.00001
           Z{i} = oldZ; 
           dnorm1 = dnorm;
           break;
        end

         fprintf(1, 'Z(%d) eta: %f iter: %d dnorm: %f\\n', i, eta, iter, dnorm1);
        if dnorm1 <= dnorm
            fprintf(1, 'Z(%d) eta: %f iter: %d dnorm: %f\\n', i, eta, iter, dnorm1);
            break;
        end                              

    end
    
end


function [H, dnorm1] = gd_H(X, Z, H, R, c, i, g_inv, dnorm)
    eta = .01;
    oldH = H{i};
    iter = 0;
    
    if i == 1
        dnorm = norm(X - R{1} * Z{1} * H{1}, 'fro');
    end
        
    while(1)
        iter = iter + 1;
        eta = eta / 2;
        H{i} = oldH - eta .* c;
        H{i}(H{i} <= 0) = eps;
        
        if i == 1
           dnorm1 =  norm(X - R{1} * Z{1} * H{1}, 'fro');
        else
           dnorm1 = norm(X - deep_recon(Z, H, R, g_inv), 'fro');
        end
        

        if  eta < 0.00001
           H{i} = oldH; 
           dnorm1 = dnorm;
           break;
        end
        

        if dnorm1 <= dnorm
            fprintf(1, 'H(%d) eta: %f iter: %d dnorm: %f\\n', i, eta, iter, dnorm1);
            break;
        end                              
    end
end


function factor = NormaliseFactor(fea)
    factor = repmat(sqrt(sum(fea.^2,1)), size(fea, 1), 1);
end"
4971,deep_semi_nmf.m,74.148,80,52.82,100,100.0,37.92,70-80,"function [x, infos] = deep_semi_nmf(X, rank_layers, in_options)


    m = size(X, 1);
    n = size(X, 2);
    
    num_of_layers = numel(rank_layers);

    local_options.bUpdateZ      = true;
    local_options.bUpdateH      = true;
    local_options.bUpdateLastH  = true;
    local_options.updateH_alg   = 'mu';  % 'mu' or 'apg'
    local_options.apg_maxiter   = 100;    
    local_options.eval_clustering_acc   = 0;
    local_options.eval_clustering_num   = 10;    
    local_options.classnum              = 0;
    local_options.initialize_max_epoch  = 100;
    
    if ~exist('in_options', 'var') || isempty(in_options)
        in_options = struct();
    end      
    options = mergeOptions(get_nmf_default_options(), local_options);   
    options = mergeOptions(options, in_options);  
    
    method_name = 'Deep-Semi';
    epoch = 0;    
    grad_calc_count = 0;

    if options.verbose > 0
        fprintf('# %s: started ...\\n', method_name);           
    end     
    
    if ~isempty(options.gnd) && options.classnum > 1
        options.eval_clustering_acc = 1;
    end
    
    
    Z = cell(1, num_of_layers);
    H = cell(1, num_of_layers); 
    if ~isfield(options, 'x_init')
        
        for i_layer = 1:num_of_layers

            if options.verbose > 1
                fprintf('### Initializing by %s for layer %d ... ', method_name, i_layer);
            end

            if i_layer == 1
                V = X;
            else 
                V = H{i_layer-1};
            end

            semi_nmf_options.max_iter  = options.initialize_max_epoch;
            semi_nmf_options.bUpdateH  = options.bUpdateH;
            semi_nmf_options.bUpdateZ  = options.bUpdateZ;
            semi_nmf_options.verbose   = 0;

            [semi_nmf_x, ~] = semi_mu_nmf(V, rank_layers(i_layer), semi_nmf_options);
            Z{i_layer} = semi_nmf_x.W;
            H{i_layer} = semi_nmf_x.H;

            if options.verbose > 1
                fprintf('done\\n');
            end            
        end
    end


    Hm = H{num_of_layers};


    
    disp_freq = set_disp_frequency(options);      
    
   
    clear infos;
    Z_rec = reconst_Z(Z, num_of_layers);    
    [infos, f_val, optgap] = store_nmf_info(X, Z_rec, Hm, [], options, [], epoch, grad_calc_count, 0);
    
    if ~isempty(options.gnd) && options.classnum > 1
        [infos] = store_clustering_accuracy(Hm, options.gnd, options.classnum, infos, options.eval_clustering_num, 0);
    end    

    if options.verbose > 1
        fprintf('%s: Epoch = 0000, cost = %.16e, optgap = %.4e\\n', method_name, f_val, optgap); 
    end  

    start_time = tic();

    while true
        
        [stop_flag, reason, max_reached_flag] = check_stop_condition(epoch, infos, options);
        if stop_flag
            display_stop_reason(epoch, infos, options, method_name, reason, max_reached_flag);
            break;
        end
        
        [Z, Hm] = calc_deep_matrices(X, Z, Hm, num_of_layers, options);
        
        elapsed_time = toc(start_time);        
        
        grad_calc_count = grad_calc_count + m*n;

        epoch = epoch + 1;         
        
        Z_rec = reconst_Z(Z, num_of_layers);
        [infos, f_val, optgap] = store_nmf_info(X, Z_rec, Hm, [], options, infos, epoch, grad_calc_count, elapsed_time);  
        
        if options.eval_clustering_acc
            [infos] = store_clustering_accuracy(Hm, options.gnd, options.classnum, infos, options.eval_clustering_num, epoch);
        end
        
        if options.verbose > 1
            if ~mod(epoch, disp_freq)

                if ~options.eval_clustering_acc
                    fprintf('%s: Epoch = %04d, cost = %.16e, optgap = %.4e\\n', method_name, epoch, f_val, optgap);
                else
                    fprintf('%s: Epoch = %04d, cost = %.16e, optgap = %.4e, acc = %.4f, nmi = %.4f, purity = %.4f, f = %.4f\\n', ...
                        method_name, epoch, f_val, optgap, infos.clustering_acc(end).acc, infos.clustering_acc(end).nmi, infos.clustering_acc(end).purity, infos.clustering_acc(end).f_val);
                end

            end
            
        elseif options.verbose == 1
            textwaitbar(epoch, options.max_epoch, '  progress');
        end            
    end
    
    H{num_of_layers} = Hm;
    
    x.Z = Z;
    x.H = H;

end


function [Z, Hm] = calc_deep_matrices(X, Z, Hm, num_of_layers, options)

    A = cell(1, num_of_layers+1); 
    B = cell(1, num_of_layers);
    
    m = size(Z, 1);
    
    B{num_of_layers} = Hm;
    for i_layer = num_of_layers-1:-1:1
        B{i_layer} = Z{i_layer+1} * B{i_layer+1};
    end

    Z{1} = X  * pinv(B{1});    

    A{1} = eye(m);
    for i = 2 : num_of_layers

        if i == 2
            A{i} = Z{i-1};
        else
            A{i} = A{i-1} * Z{i-1};
        end

        Z{i} = pinv(A{i}) * X * pinv(B{i});

    end

    A{num_of_layers+1} = A{num_of_layers} * Z{num_of_layers};
    if strcmp(options.updateH_alg, 'mu')
        P = A{num_of_layers+1}' * X;
        Pp = (abs(P)+P)./2;
        Pn = (abs(P)-P)./2;

        Q = A{num_of_layers+1}' * A{num_of_layers+1};

        Qp = (abs(Q)+Q)./2;
        Qn = (abs(Q)-Q)./2;

        Hm = Hm .* sqrt((Pp + Qn * Hm) ./ max(Pn + Qp * Hm, 1e-10));        
    else
        
        [tmpH, ~, ~] = nesterov_mnls_general(X', [], A{num_of_layers+1}, Hm', 1, options.apg_maxiter, 'basic');
        Hm = tmpH';
    end    
    
end


function Z_rec = reconst_Z(Z, num_of_layers)

    Z_rec = Z{num_of_layers};
    
    for k = num_of_layers-1 : -1 : 1
        Z_rec =  Z{k} * Z_rec;
    end

end"
