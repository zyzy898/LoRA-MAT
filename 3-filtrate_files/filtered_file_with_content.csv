    save([bufname config.objHypoFile3D],'CAN_POOL');
end
fprintf('finish.\\n');
end"
148,ComposeEuler.m,80.8,60,80.0,100,100.0,64.0,80-90,"function [Eout, Rout] = ComposeEuler(varargin)

	Num = length(varargin);
	if Num <= 0
		Eout = [0 0 0];
		Rout = eye(3);
	elseif Num == 1
		Eout = varargin{1};
		if nargout >= 2
			Rout = RotmatFromEuler(Eout);
		end
	else
		Rout = RotmatFromEuler(varargin{1});
		for k = 2:Num
			E = varargin{k};
			if numel(E) ~= 3
				warning('Ignoring an invalid rotation parameter!');
				continue;
			end
			Rout = Rout * RotmatFromEuler(E);
		end
		Eout = EulerFromRotmat(Rout);
	end

end"
