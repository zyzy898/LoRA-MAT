        fprintf( '%s\\n', line );
        fprintf( result(1+(result(1)==10):end) );
        success = false;
    end
end


if success,
    tname = [ tdir, fs, 'gurobi.lic' ];
    [fid,msg] = fopen( tname, 'r' );
    if fid == 0,
        jprintf({
            'An unexpected error occured: the Gurobi license file could not be'
