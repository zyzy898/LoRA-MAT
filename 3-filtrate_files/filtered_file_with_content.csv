    Hhatcros{ii} = Hhatcros{ii}.*(Gmulti{ll}(foldindrest{ii},centfind)'*Gmulti{ll}(foldindrest{ii},centfind))/length(foldindrest{ii}); 
    
end;

lam = lambda;
val = 0;
