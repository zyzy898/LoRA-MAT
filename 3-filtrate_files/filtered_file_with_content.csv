1074,cvx_recip.m,82.0,100,64.0,100,100.0,46.0,80-90,"function y = cvx_recip( x )



narginchk(1,1);
persistent remap
if isempty( remap ),
    remap_1 = cvx_remap( 'constant' ) & ~cvx_remap( 'zero' );
    remap_2 = cvx_remap( 'log-valid' ) & ~remap_1;
    remap = remap_1 + 2 * remap_2;
end
vr = remap( cvx_classify( x ) );
vu = sort( vr(:) );
vu = vu([true;diff(vu)~=0]);
nv = length( vu );


if nv ~= 1,
    y = cvx( x.size_, [] );
end
for k = 1 : nv,


    if nv == 1,
        xt = x;
    else
        t = vr == vu( k );
        xt = cvx_subsref( x, t );
    end


    switch vu( k ),
        case 0,
            error( 'Disciplined convex programming error:\\n    Cannot perform the operation recip( {%s} )', cvx_class( x, false, false, true ) );
        case 1,
            yt = cvx( 1.0 ./ cvx_constant( xt ) );
        case 2,
            yt = exp( -log( xt ) );
        otherwise,
            error( 'Shouldn''t be here.' );
    end


    if nv == 1,
        y = yt;
    else
        y = cvx_subsasgn( y, t, yt );
    end

end"
1075,cvx_reduce_size.m,84.856,100,77.14,90,100.0,57.14,80-90,"function [ x, sx, sy, zx, zy, nx, nv, perm ] = cvx_reduce_size( x, dim, do_reduce )


