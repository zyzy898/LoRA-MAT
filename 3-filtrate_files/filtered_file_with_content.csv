1646,coeflift.m,73.038,100,54.9,75,100.0,35.29,70-80,"function cl = coeflift(naca,alpha)
clc
npanel=100; %total number of panels on the airfoil surface 

x  = zeros(npanel+1,1);
y  = zeros(npanel+1,1);
cp = zeros(npanel+1,1);


[x,y] = naca4(naca,npanel,x,y);


l    = zeros(npanel,1);
st   = zeros(npanel,1);
ct   = zeros(npanel,1);
xbar = zeros(npanel,1);
ybar = zeros(npanel,1);

[l,st,ct,xbar,ybar] = panel_geometry(x,y,npanel);


ainfl = zeros(npanel+1);

ainfl = infl_coeff(x,y,xbar,ybar,st,ct,ainfl,npanel);

b  = zeros(npanel+1,1);

al = alpha * pi / 180;

for i=1:npanel
    b(i) = st(i)*cos(al) -sin(al)*ct(i);
end

b(npanel+1) = -(ct(1)     *cos(al) +st(1)     *sin(al)) ...
              -(ct(npanel)*cos(al) +st(npanel)*sin(al));
         

qg = inv(ainfl) * b;


vt = veldis(qg,x,y,xbar,ybar,st,ct,al,npanel);



cp = 1 -vt.^2;

[cl,cd] = aero_coeff(x,y,cp,al,npanel);



return"
1647,cofactor_matrix_SA.m,77.848,60,84.62,60,100.0,84.62,70-80,"function [Q] = cofactor_matrix_SA(elR, snr_R)

snr_0=10; snr_1=50; snr_a=30;snr_A=30;

n = length(elR);

if (~any(elR) || ~any(snr_R))
    Q = eye(n);
else
    q_R = 1 ./ (sin(elR * pi/180).^2) .* (10.^(-(snr_R-snr_1)/snr_a) .* ((snr_A/10.^(-(snr_0-snr_1)/snr_a)-1)./(snr_0-snr_1).*(snr_R-snr_1)+1));
    q_R(snr_R >= snr_1) = 1;
    Q = diag(q_R);
end"
1648,COFMEn.m,79.368,100,61.05,100,100.0,35.79,70-80,"function COFMEn = COFMEn(data, m, r,fs)


N=length(data);
for i=1:N-m
    x1(i,:)=data(i:i+m-1);
    x2(i,:)=data(i:i+m);
end

ratio=0.4;
if N>20
    Thr=5;
else
    Thr=5;
end


Min_numerator=0;
kk=0;
while Min_numerator<Thr
    [Min_numerator,r]=ReGet_min_numerator(x1,x2,N,m,r,fs);
    kk=kk+1;    
end
if kk==1 || kk>20
   if N<20
        r=r-1;
    else
        r=r-1000/fs;
    end
end

if Min_numerator==N-m
    while Min_numerator>=Thr
        [Min_numerator,r]=ReGet_min_numerator2(x1,x2,N,m,r,fs);
    end
    if r<0
        r=r+2;
    else 
        r=r+1;
    end
end

x=data;
r_l   = r;
r_g   = r;
n_l   = 2;
n_g   = 2;
D_l   = zeros(N-m,1); % initiate the mean local distance vector
D_g   = zeros(N-m,1); % initiate the mean global distance vector
for i = 1:N-m
    distance_l = zeros(N-m,1); % initiate the local distance vector for the ith vector
    distance_g = zeros(N-m,1); % initiate the global distance vector for the ith vector
    for j = 1:N-m
        if j==i
            d_l = 0;
            d_g = 0;
        else
        d_l = max(abs(x(i:i+m-1)-mean(x(i:i+m-1))-x(j:j+m-1)+mean(x(j:j+m-1))));
        d_g = max(abs(x(i:i+m-1)-x(j:j+m-1)));
        end
        distance_l(j) = exp(-(d_l.^n_l/r_l));
        distance_g(j) = exp(-(d_g.^n_g/r_g));
    end
    D_l(i) = sum(distance_l)/(N-m-1);
    D_g(i) = sum(distance_g)/(N-m-1);
end
Bm_l = mean(D_l);
Bm_g = mean(D_g);

m=m+1;
D_l   = zeros(N-m,1);
D_g   = zeros(N-m,1);
for i = 1:N-m
    distance_l = zeros(N-m,1);
    distance_g = zeros(N-m,1);
    for j = 1:N-m
        if j==i
            d_l = 0;
            d_g = 0;
        else
        d_l = max(abs(x(i:i+m-1)-mean(x(i:i+m-1))-x(j:j+m-1)+mean(x(j:j+m-1))));
        d_g = max(abs(x(i:i+m-1)-x(j:j+m-1)));
        end
        distance_l(j) = exp(-(d_l.^n_l/r_l));
        distance_g(j) = exp(-(d_g.^n_g/r_g));
    end
    D_l(i) = sum(distance_l)/(N-m-1);
    D_g(i) = sum(distance_g)/(N-m-1);
end
Am_l = mean(D_l);
Am_g = mean(D_g);

FuzzyLMEn = -log(Am_l/Bm_l);  % local fuzzy measure entropy
FuzzyGMEn = -log(Am_g/Bm_g);  % global fuzzy measure entropy
COFMEn  = FuzzyLMEn+FuzzyGMEn+2*log(2*r/1000)-2*log(mean(data)/1000);"
1649,coherence.m,70.334,60,80.0,45,100.0,66.67,70-80,"function [ mu, i, j ] = coherence( A )



G = A' * A;
absG = abs(G);
absG(logical(eye(size(absG)))) = 0;
[mu, index] = max(absG(:));
[i, j] = ind2sub(size(G), index);
if i > j
    t = i;
    i = j;
    j = t;
end
end"
1650,coherence_receive.m,77.354,100,66.18,75,100.0,45.59,70-80,"function [count,capacity] = coherence_receive(N,Mi,S,K,scheduled,Tc,s,x,H,sigma2,w,u,p);

count=0;
capacity=0;

s_now=zeros(K*S,2*Tc);      % If the modulation method is different, the amount of columns may be changed.
x_now=zeros(K*S,Tc);
H_now=zeros(K*Mi,N);
w_now=zeros(K*Mi,Tc);

for i1=1:K,
    s_now((i1-1)*S+1:i1*S,:)=s((scheduled(1,i1)-1)*S+1:scheduled(1,i1)*S,:);
    x_now((i1-1)*S+1:i1*S,:)=x((scheduled(1,i1)-1)*S+1:scheduled(1,i1)*S,:);
    H_now((i1-1)*Mi+1:i1*Mi,:)=H((scheduled(1,i1)-1)*Mi+1:scheduled(1,i1)*Mi,:);
    w_now((i1-1)*Mi+1:i1*Mi,:)=w((scheduled(1,i1)-1)*Mi+1:scheduled(1,i1)*Mi,:);
end

y=zeros(K*Mi,Tc);
y=H_now*u*sqrt(diag(p))*x_now+w_now;
r=zeros(K*S,K*Mi);
temp2=zeros(S,Mi);
for i1=1:K,
    HHH=zeros(Mi,N);
    HHH=H_now((i1-1)*Mi+1:i1*Mi,:);
    temp2=(HHH*u(:,(i1-1)*S+1:i1*S))';
    temp2=temp2/(sqrt(trace(temp2*temp2')));
    r((i1-1)*S+1:i1*S,(i1-1)*Mi+1:i1*Mi)=temp2;
end

yy=zeros(K*S,Tc);
yy=r*y;

ss=zeros(K*S,2*Tc);
for i1=1:K*S,
    for i2=1:Tc,
        if real(yy(i1,i2))>=0,
            ss(i1,i2)=0;
        else
            ss(i1,i2)=1;
        end
        if imag(yy(i1,i2))>=0,
            ss(i1,i2+Tc)=0;
        else
            ss(i1,i2+Tc)=1;
        end
    end
end

for i1=1:K*S,
    for i2=1:2*Tc,
        if s_now(i1,i2)~=ss(i1,i2),
            count=count+1;
        end
    end
end

tempC=0;
for i1=1:K,
    temp4=Mi*sigma2*eye(S);
    HHH=H_now((i1-1)*Mi+1:i1*Mi,:);
    for i2=1:K,
        if i2~=i1,
            temp4=temp4+u(:,(i2-1)*S+1:i2*S)'*HHH'*HHH*u(:,(i2-1)*S+1:i2*S);
        end
    end
    tempC=tempC+log2(det(eye(S)+u(:,(i1-1)*S+1:i1*S)'*HHH'*HHH*u(:,(i1-1)*S+1:i1*S)*inv(temp4)));
end
capacity=tempC;"
1651,coherence_receive_MultiAnt.m,73.25,100,55.0,75,100.0,36.25,70-80,"function [count,capacity] = coherence_receive_MultiAnt(MT,R,K_all,K,KK,Tc,s,x,H,sigma2,w,u,index,ant_num);

count=0;
capacity=0;

s_now=zeros(K,Tc);    % Attention: the number of columns is influenced by the modulation method
x_now=zeros(K,Tc);
H_now=zeros(sum(ant_num),MT);
w_now=zeros(sum(ant_num),Tc);

for i1=1:K,
    s_now(i1,:)=s(KK(1,i1),:);
    x_now(i1,:)=x(KK(1,i1),:);
    temp1=0;
    if i1~=1,
        temp1=sum(ant_num(1,1:(i1-1)));
    end
    for i2=1:ant_num(1,i1),
        H_now(temp1+i2,:)=H((KK(1,i1)-1)*R+index(1,(i1-1)*R+i2),:);
        w_now(temp1+i2,:)=w((KK(1,i1)-1)*R+index(1,(i1-1)*R+i2),:);
    end
end

y=zeros(sum(ant_num),Tc);
y=H_now*u*x_now+w_now;
r=zeros(K,sum(ant_num));
for i1=1:K,
    temp1=0;
    if i1~=1,
        temp1=sum(ant_num(1,1:(i1-1)));
    end
    HHH=zeros(ant_num(1,i1),MT);
    HHH=H_now(temp1+1:temp1+ant_num(1,i1),:);
    temp2=zeros(1,ant_num(1,i1));
    temp2=(HHH*u(:,i1))';
    temp2=temp2/(sqrt(trace(temp2*temp2')));
    r(i1,temp1+1:temp1+ant_num(1,i1))=temp2;
end

yy=zeros(K,Tc);
yy=r*y;

ss=zeros(K,Tc);
for i1=1:K,
    for i2=1:Tc,
        if real(yy(i1,i2))>=0,
            ss(i1,i2)=0;
        else
            ss(i1,i2)=1;
        end
        

    end
end

for i1=1:K,
    for i2=1:Tc,
        if s_now(i1,i2)~=ss(i1,i2),
            count=count+1;
        end
    end
end

tempC=0;
for i1=1:K,
    temp4=ant_num(1,i1)*sigma2;
    temp1=0;
    if i1~=1,
        temp1=sum(ant_num(1,1:(i1-1)));
    end
    HHH=zeros(ant_num(1,i1),MT);
    HHH=H_now(temp1+1:temp1+ant_num(1,i1),:);
    for i2=1:K,
        if i2~=i1,
            temp4=temp4+u(:,i2)'*HHH'*HHH*u(:,i2);
        end
    end
    tempC=tempC+log2(1+u(:,i1)'*HHH'*HHH*u(:,i1)/temp4);
end
capacity=tempC;"
