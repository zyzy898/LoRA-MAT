addParameter(p, 'thresholdStep', defaultThresholdStep, @isnumeric);
addParameter(p, 'isPadding', defaultPaddingFlag);
addParameter(p, 'sshUnits', defaultSSHUnits);

parse(p, ssh_path, eddies_save_path, fake_eddies, varargin{:});

lat = p.Results.lat;
lon = p.Results.lon;
