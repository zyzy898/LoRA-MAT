1199,dbFnGenerateTestImages.m,80.066,80,67.54,90,100.0,62.79,80-90,"function ret = dbFnGenerateTestImages(imgPath, imagesBasePath, outputBasePath, annotation, varargin) 


addpath ../../3rd_party/parseArgs;
addpath ../../3rd_party/LabelMeToolbox;
addpath ../msStitching;
addpath ../database;
addpath ../xml;

defaultArgs = struct('Recompute', 1, 'Database', [], 'ImgPath', '', ...
    'IndSegmentedImg', [], 'ImgFilename', []);
args = parseargs(defaultArgs, varargin{:});

img = imread(imgPath);

imgInfo.image.filename = annotation.filename;
imgInfo.image.folder = annotation.folder;

[h,w,d] = size(img);
img = imresize(img, [256 256], 'bilinear');
imgInfo.image.size.width = 256;
imgInfo.image.size.height = 256;
imgInfo.image.origSize.width = w;
imgInfo.image.origSize.height = h;

minArea = 256*256*0.05;
maxArea = 256*256*0.6;

ret = 0;

if isfield(annotation, 'object')
    isOk = 0;
    indRand = randperm(length(annotation.object));
    for i=indRand
        [xPoly, yPoly] = getLMpolygon(annotation.object(i).polygon);
        objPoly = [xPoly yPoly]';
        objPoly = objPoly .* repmat(([256 256]' ./ [w h]'), 1, size(objPoly, 2));

        areaObj = nnz(poly2mask(objPoly(1,:), objPoly(2,:), 256, 256));
        if areaObj > minArea && areaObj < maxArea
            isOk = 1;
            indObjOriginal = i;
            break;
        end
    end
    if ~isOk
        fprintf('Selected image contains no object of sufficient size! Skipping...\\n');
        return;
    end
else
    fprintf('Selected image contains no object! Skipping...\\n');
    return;
end

indSegmentedImages = args.IndSegmentedImg;

areaObj = 0;
while areaObj < minArea || areaObj > maxArea
    randInd = ceil(rand * length(indSegmentedImages));
    indImg = indSegmentedImages(randInd);
    randAnnotation = args.Database(indImg);

    randInd = ceil(rand * length(randAnnotation.annotation.object));
    [xPoly, yPoly] = getLMpolygon(randAnnotation.annotation.object(randInd).polygon);
    objPoly = [xPoly yPoly]';
    
    srcFile = fullfile(args.ImgPath, randAnnotation.annotation.folder, randAnnotation.annotation.filename);
    srcImg = imread(srcFile);
    
    [h,w,d] = size(srcImg);
    srcImg = imresize(srcImg, [256 256], 'bilinear');
    objPoly = objPoly .* repmat(([256 256]' ./ [w h]'), 1, size(objPoly, 2));
    
    areaObj = nnz(poly2mask(objPoly(1,:), objPoly(2,:), 256, 256));
end

fakeImg = pasteObjectOnImage(img, objPoly, srcImg, objPoly, srcImg);

outputImgDir = fullfile(outputBasePath, 'images');
[s,m,m] = mkdir(outputImgDir);

imgInfo.image.generated = 1;
imgInfo.object = randAnnotation.annotation.object(randInd);
imgInfo.object.imgSrc = srcFile;
imgInfo.object.indSrc = randInd;

outputImgPath = fullfile(outputImgDir, sprintf('%s_generated.jpg', args.ImgFilename));
xmlPath = fullfile(outputBasePath, sprintf('%s.xml', args.ImgFilename));
imwrite(fakeImg, outputImgPath, 'Mode', 'lossless', 'Quality', 100);

imgInfo.image.filename = sprintf('%s_generated.jpg', args.ImgFilename);
imgInfo.image.folder = 'images';
imgInfo.image.originalFolder = annotation.folder;
imgInfo.image.originalFilename = annotation.filename;

fprintf('Saving xml file: %s\\n', xmlPath);
[pathstr, name, ext, versn] = fileparts(xmlPath);
xmlPath = fullfile(pathstr, sprintf('%s_generated.xml', name));
writeStructToXML(imgInfo, xmlPath);

imgInfo.object = annotation.object(indObjOriginal);

outputImgPath = fullfile(outputImgDir, sprintf('%s.jpg', args.ImgFilename));
imwrite(img, outputImgPath, 'Mode', 'lossless', 'Quality', 100);
   
imgInfo.image.generated = 0; % mention that this is the original image
imgInfo.image.filename = sprintf('%s.jpg', args.ImgFilename);
imgInfo.image.folder = 'images';
imgInfo.image.originalFolder = annotation.folder;
imgInfo.image.originalFilename = annotation.filename;
xmlPath = fullfile(pathstr, sprintf('%s.xml', name));
writeStructToXML(imgInfo, xmlPath);

ret = 1;"
1200,dbFnLoad3x3Patches.m,85.66,100,74.47,90,100.0,63.83,80-90,"function dbFnLoad3x3Patches(imgPath, imagesBasePath, outputBasePath, annotation, varargin)global patches3x3;
 


addpath ../../3rd_party/parseArgs;
addpath ../../3rd_party/color;

defaultArgs = struct('ColorSpace', 'lab');
args = parseargs(defaultArgs, varargin{:});

fprintf('Computing patches...');
img = imread(imgPath);
img = imresize(img, [256 256], 'bilinear');

if strcmp(args.ColorSpace, 'lab')
    fprintf('Converting to L*a*b*...');
    img = rgb2lab(img);
    
    mins = [0 -100 -100];
    maxs = [100 100 100];
    type = 1;
elseif strcmp(args.ColorSpace, 'rgb')
    mins = [0 0 0];
    maxs = [255 255 255];
    type = 2;
    error('No ordering method implemented for rgb!');
else
    error('Color Space %s unsupported!', args.ColorSpace);
end

imagePatches = zeros(254*254, 27, 'single');

for i=2:255
    for j=2:255
        patch = reshape(img(i-1:i+1, j-1:j+1, :), 9, 3);
        
        [s, ind] = sort(patch(:,1));
        patch = reshape(patch(ind, :), 1, 27);
        imagePatches((i-2)*254+j-1, :) = patch;
    end
end

divs = 64;
indPatches = randperm(254^2);
indPatches = indPatches(1:floor(254^2/divs));
patches3x3 = [patches3x3; imagePatches(indPatches, :)];
fprintf('done!\\n');"
1201,dbFnLoadNxNPatches.m,85.408,100,75.93,90,100.0,61.11,80-90,"function dbFnLoadNxNPatches(imgPath, imagesBasePath, outputBasePath, annotation, varargin)global patches;
 


addpath ../../3rd_party/parseArgs;
addpath ../../3rd_party/color;

defaultArgs = struct('ColorSpace', 'lab', 'N', 1);
args = parseargs(defaultArgs, varargin{:});

fprintf('Computing patches...');
img = imread(imgPath);
img = imresize(img, [256 256], 'bilinear');

if strcmp(args.ColorSpace, 'lab')
    fprintf('Converting to L*a*b*...');
    img = rgb2lab(img);
    
    mins = [0 -100 -100];
    maxs = [100 100 100];
    type = 1;
elseif strcmp(args.ColorSpace, 'rgb')
    mins = [0 0 0];
    maxs = [255 255 255];
    type = 2;
    error('No ordering method implemented for rgb!');
else
    error('Color Space %s unsupported!', args.ColorSpace);
end

N = args.N;
nbPatchesRow = 256-N+1;
imagePatches = zeros(nbPatchesRow^2, (N^2)*3, 'single');

lims = ceil(N/2):ceil(N/2)+nbPatchesRow-1;
halfSize = floor(N/2);

c = 1;
for i=lims
    for j=lims
        patch = reshape(img(i-halfSize:i+halfSize, j-halfSize:j+halfSize, :), N^2, 3);
        
        ind = 1:size(patch,1);
        patch = reshape(patch(ind, :), 1, N^2*3);
        imagePatches(c, :) = patch;
        c = c+1;
    end 
end

divs = 110; % This should generate ~400MB of data, if we have 2500 images
indPatches = randperm(nbPatchesRow^2);
indPatches = indPatches(1:floor(nbPatchesRow^2/divs));
patches = [patches; single(imagePatches(indPatches, :))];
fprintf('done!\\n');"
1202,dbFnPrecomputeDistancesNN.m,83.052,80,64.76,100,100.0,70.5,80-90,"function r=dbFnPrecomputeDistancesNN(outputBasePath, annotation, varargin) 

r=0;

defaultArgs = struct('ColorSpace', [], 'ObjectDbPath', [], ...
    'DbPath', [], 'ImagesPath', [], 'ConcatHisto', [], 'Type', [], 'NbBins', [], ...
    'ActiveInd', [], 'NbDistances', 0);
args = parseargs(defaultArgs, varargin{:});

imgPath = fullfile(args.ImagesPath, annotation.image.folder, annotation.image.filename);
img = imread(imgPath);
[h,w,c] = size(img);

xmlPath = fullfile(outputBasePath, annotation.file.folder, annotation.file.filename);
imgInfo = loadXML(xmlPath);

if strcmp(args.ColorSpace, 'lab')
    fprintf('Converting to L*a*b*...\\n');
    imgColor = rgb2lab(img);
    
    mins = [0 -100 -100];
    maxs = [100 100 100];
    type = 1;
    
elseif strcmp(args.ColorSpace, 'rgb')
    fprintf('Keeping RGB ...\\n');
    imgColor = img;
    
    mins = [0 0 0];
    maxs = [255 255 255];
    type = 2;
    
elseif strcmp(args.ColorSpace, 'hsv')
    fprintf('Converting to HSV...\\n');
    imgColor = rgb2hsv(img);
    
    mins = [0 0 0];
    maxs = [1 1 1];
    type = 3;
    
elseif strcmp(args.ColorSpace, 'lalphabeta')
    fprintf('Converting to L-alpha-beta...\\n');
    imgColor = rgb2lalphabeta(img);

    mins = [-10 -3 -0.5];
    maxs = [0 3 0.5];
    type = 4;
    
else
    error('Color Space %s unsupported!', args.ColorSpace);
end

imgVec = double(reshape(imgColor, [h*w c]));

load(fullfile(args.DbPath, annotation.file.folder, annotation.object.masks.filename)); %#objMask, bgMask
validInd = cellfun(@(x) ~isempty(x), args.ConcatHisto);

distances = [];
try
    load(fullfile(args.DbPath, annotation.file.folder, imgInfo.global.distNN.(args.Type)(type).distChi.filename));
catch
    distances = -ones(1, args.NbDistances);
end

if ~isempty(strfind(args.Type, 'marg'))
    
    margHisto = zeros(args.NbBins, 3);
    if ~isempty(strfind(args.Type, 'Obj'))
        for c=1:3
            margHisto(:,c) = myHistoND(imgVec(objMask(:), c), args.NbBins, mins(c), maxs(c));
        end
    else
        for c=1:3
            margHisto(:,c) = myHistoND(imgVec(bgMask(:), c), args.NbBins, mins(c), maxs(c));
        end
    end
    
    dist = cellfun(@(x) chisq(x(:,1), margHisto(:,1)) + chisq(x(:,2), margHisto(:,2)) + chisq(x(:,3), margHisto(:,3)), ...
        args.ConcatHisto(validInd));
    dist = dist ./ 3;
    distances(validInd) = dist;
    
else
    if ~isempty(strfind(args.Type, 'Obj'))
        jointHisto = myHistoND(imgVec(objMask(:), :), args.NbBins, mins, maxs);
    else
        jointHisto = myHistoND(imgVec(bgMask(:), :), args.NbBins, mins, maxs);
    end
    jointHisto = jointHisto(args.ActiveInd);
    
    dist = cellfun(@(x) chisq(x, jointHisto), args.ConcatHisto(validInd));
    distances(validInd) = dist;
end

imgInfo.global.distNN.(args.Type)(type).distChi.filename = fullfile('global', 'distNN', args.Type, args.ColorSpace, sprintf('%s_chi.mat', strrep(annotation.file.filename, '.xml', '')));
imgInfo.global.distNN.(args.Type)(type).nbBins = args.NbBins;
imgInfo.global.distNN.(args.Type)(type).colorSpace = args.ColorSpace;

outputFile = fullfile(outputBasePath, imgInfo.file.folder, imgInfo.global.distNN.(args.Type)(type).distChi.filename);
[m,m,m] = mkdir(fileparts(outputFile));
save(outputFile, 'distances');

xmlPath = fullfile(outputBasePath, annotation.file.folder, annotation.file.filename);
fprintf('Saving xml file: %s\\n', xmlPath);
writeXML(xmlPath, imgInfo);"
