2114,computeDistMatrix_AVFC.m,79.692,100,55.38,100,100.0,43.08,70-80,"function D = computeDistMatrix_AVFC (data,T,options)

if ~iscell(data) || ~iscell(T), error('X and T must both be cells'); end 

if nargin<3, options = struct(); end

N = length(data);

for n = 1:N
    if ischar(data{n})
        fsub = data{n};
        loadfile_sub;
    else
        X = data{n};
    end
    X = preprocdata(X,T{n},options);
    if n == 1
        ndim = size(X,2);
        V = zeros(ndim,ndim,N);
    end
    V(:,:,n) = X' * X;
end

D = NaN(N);
try
    for n1 = 1:N-1
        for n2 = n1+1:N
            D(n1,n2) =  ( wishart_kl(V(:,:,n1),V(:,:,n2),sum(T{n1}),sum(T{n2})) + ...
                wishart_kl(V(:,:,n2),V(:,:,n1),sum(T{n2}),sum(T{n1})) ) /2;
            D(n2,n1) = D(n1,n2);
        end
    end
catch
    for n = 1:N
        V(:,:,n) = V(:,:,n) + 0.0001*eye(ndim);
    end
    for n1 = 1:N-1
        for n2 = n1+1:N
            D(n1,n2) =  ( wishart_kl(V(:,:,n1),V(:,:,n2),sum(T{n1}),sum(T{n2})) + ...
                wishart_kl(V(:,:,n2),V(:,:,n1),sum(T{n2}),sum(T{n1})) ) /2;
            D(n2,n1) = D(n1,n2);
        end
    end    
end

end


function X = preprocdata(X,T,options)

if isfield(options,'filter') && ~isempty(options.filter)
    X = filterX(X,T,options.Fs,options.filter);
end
if isfield(options,'detrend') && options.detrend
    X = detrendX(X,T);
end
if isfield(options,'onpower') && options.onpower
    X = rawsignal2power(X,T);
end
if isfield(options,'embeddedlags') && length(options.embeddedlags) > 1
    X = embeddata(X,T,options.embeddedlags);
end
X = zscore(X);

end"
2115,computeDMFromDV.m,77.526,60,89.47,75,100.0,63.16,70-80,"function [dmasses] = computeDMFromDV(masses, dv, Isp, propType)
    
    m0 = sum(masses);
    m1 = revRocketEqn(m0, Isp, dv);
    dm = m0 - m1;
    
    dmasses = masses;
    switch propType
        case 'fuelOxMass'
            dmasses(2) = dmasses(2) - dm;
        case 'monoMass'
            dmasses(3) = dmasses(3) - dm;
        case 'xenonMass'
            dmasses(4) = dmasses(4) - dm;
        case 'none'
        otherwise
            error(['Unknown propellant type: ', propType]);
    end
end"
2116,ComputedTorque.m,78.0,60,100.0,30,100.0,100.0,70-80,"function taulist = ComputedTorque(thetalist, dthetalist, eint, g, ...
                                  Mlist, Glist, Slist, thetalistd, ...
                                  dthetalistd, ddthetalistd, Kp, Ki, Kd)

e = thetalistd - thetalist;
taulist ...
= MassMatrix(thetalist, Mlist, Glist, Slist) ...
  * (Kp * e + Ki * (eint + e) + Kd * (dthetalistd - dthetalist)) ...
  + InverseDynamics(thetalist, dthetalist, ddthetalistd, g, ...
                    zeros(6, 1), Mlist, Glist, Slist);
end"
