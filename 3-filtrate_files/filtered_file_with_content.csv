        for i = 1 : length(filepaths)
            label  = imread(fullfile(folderTestCur,filepaths(i).name));
            [~,imageName,ext] = fileparts(filepaths(i).name);
            chanel = size(label,3);
            if chanel == 3
                label = rgb2ycbcr(label);
