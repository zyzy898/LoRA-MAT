2821,consumeSomething.m,79.594,80,71.19,100,100.0,46.78,70-80,"function [solution, metabolite]=consumeSomething(model,ignoreMets,isNames,minNrFluxes,params,ignoreIntBounds)

if nargin<2
    ignoreMets=[];
elseif ~islogical(ignoreMets) && ~isnumeric(ignoreMets)
    ignoreMets=convertCharArray(ignoreMets);
end
if nargin<3
    isNames=false;
end
if nargin<4
    minNrFluxes=false;
end
if nargin<5
    params.relGap=0.8;
end
if nargin<6
    ignoreIntBounds=false;
end

if isNames==true && ~isempty(ignoreMets)
    if iscellstr(ignoreMets)==false
        EM='Must supply a cell array of strings if isNames=true';
        dispEM(EM);
    end
end

if isNames==false
    indexesToIgnore=getIndexes(model,ignoreMets,'mets');
else
    indexesToIgnore=[];
    for i=1:numel(ignoreMets)
        indexesToIgnore=[indexesToIgnore;find(strcmp(ignoreMets(i),model.metNames))];
    end
end

if ignoreIntBounds==true
    [~, I]=getExchangeRxns(model);
    nonExc=true(numel(model.rxns),1);
    nonExc(I)=false;
    model=setParam(model,'lb',nonExc,-1000);
    model=setParam(model,'ub',nonExc,1000);
    model=setParam(model,'rev',nonExc,1);
end

solution=[];
metabolite=[];

nRxns=numel(model.rxns);
nMets=numel(model.mets);

model.S=[model.S speye(nMets)];

model.S=[model.S;[sparse(1,nRxns) ones(1,nMets)*-1]];

model.S(:,indexesToIgnore+nRxns)=0;

model.S(size(model.S,1),size(model.S,2)+1)=1;
model.b=[model.b;zeros(1,size(model.b,2))];
model.lb=[model.lb;zeros(nMets,1);1];
model.ub=[model.ub;inf(nMets+1,1)];
model.rev=[model.rev;zeros(nMets+1,1)];
model.c=zeros(size(model.S,2),1);

padding=1:numel(model.rev);
padding=num2cell(padding)';
padding=cellfun(@num2str,padding,'uniformoutput',false);
model.rxns=padding;
model.rxnNames=padding;
model.eccodes=padding;
model.rxnMiriams=padding;
model.grRules=padding;
if isfield(model,'genes')
    model.rxnGeneMat=sparse(numel(model.rev),numel(model.genes));
end
model.subSystems=padding;
model.rxnFrom=padding;
model.rxnComps=ones(numel(model.rev),1);
model.rxnNotes=padding;
model.rxnReferences=padding;
model.rxnConfidenceScores=NaN(numel(model.rev),1);

sol=solveLP(model,1);
if any(sol.x)
    I=setdiff(find(sol.x(nRxns+1:end)>0.1),size(model.S,1));
    
    if any(I) %This should always be true
        
        oldS=model.S;
        foundSingle=false;
        for i=1:numel(I)
            model.S=oldS;
            J=nRxns+1:numel(model.lb)-1;
            J(I(i))=[];
            model.S(:,J)=0;
            sol=solveLP(model);
            if any(sol.x)
                foundSingle=true;
                break;
            end
        end
        if foundSingle==false
            model.S=oldS;
        end
        if minNrFluxes==true
            model.rxns=cell(numel(model.lb),1);
            model.rxns(:)={'TEMP'};
            model.mets=cell(size(model.b,1),1);
            model.mets(:)={'TEMP'};
            sol=solveLP(model,3,params);
        else
            sol=solveLP(model,1);
        end
        solution=sol.x(1:nRxns);
        metabolite=find(sol.x(nRxns+1:end-1)>0.1);
    end
end
end"
2822,cons_smacof_pip.m,71.596,70,50.44,100,100.0,37.54,70-80,"function [y, stopCondition, sigma, sigma0, t] ...
    = cons_smacof_pip(dx, y, isFree, bnd, w, con, smacof_opts, scip_opts)



narginchk(6, 8);
nargoutchk(0, 5);

tic

N = size(dx, 1);

D = size(y, 2);
if ((D ~= 2) && (D ~= 3))
    error('Only implemented for 2D output')
end
        

if (N ~= size(dx, 2))
    error('D must be a square matrix')
end
if (N ~= size(y, 1))
    error('Y0 must have the same number of rows as D')
end

if (nargin < 3 || isempty(isFree))
    isFree = true(N, 1);
end
Nfree = nnz(isFree);

if (isempty(w))
    w = double(dx ~= 0);
    if (any(diag(w)) ~= 0)
        error('Assertion error: W matrix has diagonal elements that are non-zero')
    end
end
if (any(size(w) ~= [N N]))
    error('W must be a square matrix with the same size as D')
end

if (Nfree == 0)
    stopCondition = 'No free vertices to optimise';
    sigma = [];
    dy = dmatrix_con(dx, y);
    sigma0 = 0.5 * sum(sum(w .* (dx - dy).^2));
    t = [];
    return;
end

if (nargin < 7 || isempty(smacof_opts) || ~isfield(smacof_opts, 'MaxIter'))
    smacof_opts.MaxIter = 100;
end
if (nargin < 7 || isempty(smacof_opts) || ~isfield(smacof_opts, 'Epsilon'))
    smacof_opts.Epsilon = 0;
end
if (nargin < 7 || isempty(smacof_opts) || ~isfield(smacof_opts, 'Display'))
    smacof_opts.Display = 'off';
end
if (nargin < 7 || isempty(smacof_opts) || ~isfield(smacof_opts, 'TolFun'))
    smacof_opts.TolFun = 1e-12;
end

if (nargin < 8 || isempty(scip_opts) || ~isfield(scip_opts, 'scipbin'))
    
    if (isunix)
        SCIPBIN = 'scip.linux.x86_64.gnu.opt.spx';
    elseif (ismac)
        SCIPBIN = 'scip.darwin.x86_64.gnu.opt.spx';
    elseif (ispc)
        SCIPBIN = 'scip.mingw.x86_64.intel.opt.spx.exe';
    else
        error('Operating system not recognized: I do not know what is the default name for the SCIP binary')
    end
end

scip_opts_comm = {};
if (nargin >= 8 && ~isempty(scip_opts))
    
    if (isfield(scip_opts, 'scipbin'))
        SCIPBIN = scip_opts.scipbin;
    end
    
    QUIETFLAG = [];
    OUTPUTREDIR = []; % output redirecton, e.g. ""> /dev/null""
    if isfield(scip_opts, 'display_verblevel')
        if (scip_opts.display_verblevel == 0)
            QUIETFLAG = ' -q ';
            
            if strcmp(SCIPBIN, 'scip-3.1.0.linux.x86_64.gnu.opt.spx')
                QUIETFLAG = [];
                OUTPUTREDIR = ' > /dev/null';
            end
            
        end
        scip_opts_comm{end+1} = [' -c ""set display verblevel ' num2str(scip_opts.display_verblevel) '""'];
    end
    
    if (isfield(scip_opts, 'display_freq'))
        scip_opts_comm{end+1} = [' -c ""set display freq ' num2str(scip_opts.display_freq) '""'];
    end
    
    
    if (isfield(scip_opts, 'limits_absgap'))
        scip_opts_comm{end+1} = [' -c ""set limits absgap ' num2str(scip_opts.limits_absgap) '""'];
    end
    
    if (isfield(scip_opts, 'limits_gap'))
        scip_opts_comm{end+1} = [' -c ""set limits gap ' num2str(scip_opts.limits_gap) '""'];
    end
    
    if (isfield(scip_opts, 'limits_time'))
        scip_opts_comm{end+1} = [' -c ""set limits time ' num2str(scip_opts.limits_time) '""'];
    end
    
    if (isfield(scip_opts, 'limits_solutions'))
        scip_opts_comm{end+1} = [' -c ""set limits solutions ' num2str(scip_opts.limits_solutions) '""'];
    end
    
    
    if (isfield(scip_opts, 'lp_threads'))
        scip_opts_comm{end+1} = [' -c ""set lp advanced threads ' num2str(scip_opts.lp_threads) '""'];
    end
    
    
    if (isfield(scip_opts, 'numerics_feastol'))
        scip_opts_comm{end+1} = [' -c ""set numerics feastol ' num2str(scip_opts.numerics_feastol) '""'];
    end
    
end


V = -w;
V(1:N+1:end) = sum(w, 2);


dx = tril(dx);

dx(~isFree, ~isFree) = 0;

Nterms = nnz(dx);
objfunq = cell(1, Nterms + Nfree);
count = 1;
for idx = find(dx)'
    
    [J, I] = ind2sub(size(dx), idx);
    
    
    if (D == 2)
        
        if (isFree(I) && isFree(J))
            objfunq{count} = sprintf(...
                '+%.16g x%d x%d + %.16g y%d y%d', ...
                2*full(V(I, J)), I, J, ...
                2*full(V(I, J)), I, J);
        elseif (isFree(I) && ~isFree(J))
            objfunq{count} = sprintf(...
                '+%.16g x%d + %.16g y%d', ...
                2*full(V(I, J)) * y(J, 1), I, ...
                2*full(V(I, J)) * y(J, 2), I);
        elseif (~isFree(I) && isFree(J))
            objfunq{count} = sprintf(...
                '+%.16g x%d + %.16g y%d', ...
                2*full(V(I, J)) * y(I, 1), J, ...
                2*full(V(I, J)) * y(I, 2), J);
        end
        count = count + 1;
        
    elseif (D == 3)
        
        if (isFree(I) && isFree(J))
            objfunq{count} = sprintf(...
                '+%.16g x%d x%d + %.16g y%d y%d + %.16g z%d z%d', ...
                2*full(V(I, J)), I, J, ...
                2*full(V(I, J)), I, J, ...
                2*full(V(I, J)), I, J);
        elseif (isFree(I) && ~isFree(J))
            objfunq{count} = sprintf(...
                '+%.16g x%d + %.16g y%d + %.16g z%d', ...
                2*full(V(I, J)) * y(J, 1), I, ...
                2*full(V(I, J)) * y(J, 2), I, ...
                2*full(V(I, J)) * y(J, 3), I);
        elseif (~isFree(I) && isFree(J))
            objfunq{count} = sprintf(...
                '+%.16g x%d + %.16g y%d + %.16g z%d', ...
                2*full(V(I, J)) * y(I, 1), J, ...
                2*full(V(I, J)) * y(I, 2), J, ...
                2*full(V(I, J)) * y(I, 3), J);
        end
        count = count + 1;
        
    else
        error('Assertion fail: Output dimension D is not 2 or 3')
    end
end

for I = find(isFree)'
    
    if (D == 2)

        objfunq{count} = sprintf(...
            '+%.16g x%d^2 + %.16g y%d^2', ...
            full(V(I, I)), I, ...
            full(V(I, I)), I);
        
    elseif (D == 3)
        
        objfunq{count} = sprintf(...
            '+%.16g x%d^2 + %.16g y%d^2 + %.16g z%d^2', ...
            full(V(I, I)), I, ...
            full(V(I, I)), I, ...
            full(V(I, I)), I);
        
    else
        error('Assertion fail: Output dimension D is not 2 or 3')
    end
    count = count + 1;
        
end
objfunq{1} = [' obj: ' objfunq{1}];



[~, aux] = fileparts(tempname);
pipfilename = [tempdir 'model-' aux '.pip']; % PIP model
solfilename = [tempdir 'model-' aux '.sol']; % output solution
sol0filename = [tempdir 'model-' aux '.sol0']; % initial guess

stopCondition = [];

dy = dmatrix_con(dx, y);

sigma0 = 0.5 * sum(sum(w .* (dx - dy).^2));

sigma0 = full(sigma0);

sigma = zeros(1, smacof_opts.MaxIter);

t = zeros(1, smacof_opts.MaxIter); % time past from 0th iteration
if (strcmp(smacof_opts.Display, 'iter'))
    fprintf('Iter\\t\\tSigma\\t\\t\\tTime (sec)\\n')
    fprintf('===================================================\\n')
    fprintf('%d\\t\\t%.4e\\t\\t%.4e\\n', 0, sigma0, 0.0)
end

mwdx = -w .* dx;

sigmabest = Inf;
ybest = nan(size(y));

for I = 1:smacof_opts.MaxIter

    B = mwdx ./ dy;
    B(isnan(B)) = 0;

    B(1:N+1:end) = -sum(B, 2);
    
    f = -2 * B * y;
    
    objfunl = cell(1, Nfree);
    J = find(isFree);
    for idx = 1:length(J)

        if (D == 2)
            
            objfunl{idx} = sprintf(...
                '+%.16g x%d +%.16g y%d', ...
                f(J(idx), 1), J(idx), f(J(idx), 2), J(idx));
            
        elseif (D == 3)
            
            objfunl{idx} = sprintf(...
                '+%.16g x%d +%.16g y%d +%.16g z%d', ...
                f(J(idx), 1), J(idx), f(J(idx), 2), J(idx), ...
                f(J(idx), 3), J(idx));
            
        else
            error('Assertion fail: Output dimension D is not 2 or 3')
        end
        
    end
    
    fid = fopen(pipfilename, 'w');
    if (fid == -1)
        error(['Cannot open file ' pipfilename ' to save PIP model'])
    end
    fprintf(fid, '%s\\n%s\\n%s\\n%s\\n%s\\n%s\\n', ...
        'Minimize', objfunq{:}, objfunl{:}, bnd{:}, con{:}, 'End');
    if (fclose(fid) == -1)
        error(['Cannot close file ' pipfilename ' to save PIP model'])
    end
    
    write_solution(sol0filename, y);
    
    system([...
        SCIPBIN...
        QUIETFLAG ...
        ' -c ""read ' pipfilename '""'...
        strcat(scip_opts_comm{:}) ...
        ' -c ""optimize""'...
        ' -c ""write solution ' solfilename '""'...
        ' -c ""quit""' ...
        OUTPUTREDIR]);
    
    [aux, status] = read_solution(solfilename, size(y));
    
    if (exist(pipfilename, 'file')), delete(pipfilename); end
    if (exist(solfilename, 'file')), delete(solfilename); end
    if (exist(sol0filename, 'file')), delete(sol0filename); end
    
    if (isempty(aux))
        stopCondition{end+1} = ['SCIP: ' status];
        sigma(I) = NaN;
        t(I) = toc;
        break;
    end

    y(isFree, :) = aux(isFree, :);
    
    if (size(unique(y, 'rows'), 1) ~= N)
        stopCondition{end+1} = 'Duplicated vertex/vertices';
        break
    end
    
    dy = dmatrix_con(dx, y);

    sigma(I) = 0.5 * sum(sum(w .* (dx - dy).^2));
    
    if (sigma(I) < sigmabest)
        sigmabest = sigma(I);
        ybest = y;
    end
    
    t(I) = toc;
    if (strcmp(smacof_opts.Display, 'iter'))
        fprintf('%d\\t\\t%.4e\\t\\t%.4e\\n', I, sigma(I), t(I))
    end
    
    if (sigma(I) < smacof_opts.TolFun)
        stopCondition{end+1} = 'TolFun';
    end
    
    if (I > 1)
        if ((sigma(I-1)-sigma(I))/sigma(I-1) < smacof_opts.Epsilon ...
                && (sigma(I-1)-sigma(I))/sigma(I-1) >= 0)
            stopCondition{end+1} = 'Epsilon';
        end
    end

    if (~isempty(stopCondition))
        break;
    end
    
end

y = ybest;

if (I == smacof_opts.MaxIter)
    stopCondition{end+1} = 'MaxIter';
end

sigma(I+1:end) = [];
t(I+1:end) = [];

end

function [y, status] = read_solution(file, sz)

if ((sz(2) ~= 2) && (sz(2) ~= 3))
    error('We only know how to read solutions that are sets of 2D or 3D points')
end

fid = fopen(file, 'r');
if (fid == -1)
    error(['Cannot open file ' file ' to read solution'])
end

status = fgetl(fid);
if ((isnumeric(status) && status == -1) ...
        || ~strcmp(status(1:16), 'solution status:'))
    error(['Assertion fail: File with SCIP solution does not start with string ''solution status:''. File ' file])
end
status = status(18:end);

if (~strcmp(status, 'optimal solution found') ...
        && ~strcmp(status, 'solution limit reached'))
    fclose(fid);
    y = [];
    return;
end

aux = fgetl(fid);
if (~strcmp(aux(1:16), 'objective value:'))
    error(['Assertion fail: Second line in file with SCIP solution does not start with string ''objective value:''. File ' file])
end

c = textscan(fid, '%s%f%s', 'Delimiter', ' ', 'MultipleDelimsAsOne', true);
fclose(fid);

if isempty(c{1})
    error('SCIP did not return any solution')
end

y = zeros(sz);
for I = 1:length(c{1})-1
    
    varname = c{1}{I};
    
    if (strcmp(varname, 'quadobjvar'))
        break;
    end
    
    idx = str2double(varname(2:end));
    
    if (c{1}{I}(1) == 'x') % this is an x-coordinate
        y(idx, 1) = c{2}(I);
    elseif (c{1}{I}(1) == 'y') % this is a y-coordinate
        y(idx, 2) = c{2}(I);
    elseif (c{1}{I}(1) == 'z') % this is a z-coordinate
        y(idx, 3) = c{2}(I);
    end
    
end

end

function write_solution(file, y)

sz = size(y);

if ((sz(2) ~= 2) && (sz(2) ~= 3))
    error('We only know how to read solutions that are sets of 2D or 3D points')
end

fid = fopen(file, 'w');
if (fid == -1)
    error(['Cannot open file ' file ' to write solution'])
end

for I = 1:sz(1)
    
    fprintf(fid, '%s%d\\t%.16e\\t%s\\n', 'x', I, y(I, 1), '(obj:0)');

    fprintf(fid, '%s%d\\t%.16e\\t%s\\n', 'y', I, y(I, 2), '(obj:0)');
    
    if (sz(2) == 3)
        fprintf(fid, '%s%d\\t%.16e\\t%s\\n', 'z', I, y(I, 3), '(obj:0)');
    end
    
end

st = fclose(fid);
if (st == -1)
    error(['Cannot close file ' file ' after writing solution'])
end

end"
2823,ContactFrame.m,74.894,100,40.43,100,100.0,34.04,70-80,"classdef  (InferiorClasses = {?CoordinateFrame})  ContactFrame < CoordinateFrame & matlab.mixin.Copyable
    
    
