6435,cycleSlip_articifial.m,69.384,60,65.38,60,100.0,61.54,61-70,"function Epoch = cycleSlip_articifial(Epoch, use_column)




cs_on = false;

if cs_on
    cs_start = 5;                     % [epoch]
    cs_lgth = 5;                        % [epoch]
    cs_ende = cs_start + cs_lgth;   	% [epoch]
    cs_size = 1000000;                       % [cycles]
    prn  = 02;                     % prn of affected satellite
    
    if prn < 200
        col = use_column{1,1};
    elseif prn > 200
        col = use_column{3,1};
    end
    
    idx_sat = find(Epoch.sats == prn & (Epoch.gps | Epoch.gal));
    if Epoch.q >= cs_start && Epoch.q <= cs_ende
        Epoch.obs(idx_sat, col) = Epoch.obs(idx_sat, col) + cs_size*Const.GPS_L1;
    end
    
end"
6436,comp_filterbankphasegrad.m,64.092,60,72.73,15,100.0,72.73,61-70,"function [tgrad,fgrad,s] = comp_filterbankphasegrad(c,ch,cd,L,minlvl)

temp = cell2mat(c);
minlvl = minlvl*max(abs(temp(:)).^2);
s = cellfun(@(x) max(abs(x).^2,minlvl),c,'UniformOutput',false);

tgrad=cellfun(@(x,y,z) real(x.*conj(y)./z)/L*2,cd,c,s,'UniformOutput',false);

tgrad = cellfun(@(fEl) fEl.*(abs(fEl)<=2) ,tgrad,'UniformOutput',0);

