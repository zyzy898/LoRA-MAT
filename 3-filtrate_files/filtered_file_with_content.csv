6326,convexhullGeneral.m,67.63,60,89.47,15,100.0,73.68,61-70,"function [Ax,Ay,b,K] = convexhullGeneral(xL,xU,f)

z = linspace(xL,xU,100);
fz = f(z);
[minval,minpos] = min(fz);
[maxval,maxpos] = max(fz);
xtestmin = linspace(z(max([1 minpos-5])),z(min([100 minpos+5])),100);
xtestmax = linspace(z(max([1 maxpos-5])),z(min([100 maxpos+5])),100);

fz1 = f(xtestmin);
fz2 = f(xtestmax);
z = [z(:);xtestmin(:);xtestmax(:)];
fz = [fz(:);fz1(:);fz2(:)];
[z,sorter] = sort(z);
fz = fz(sorter);
[z,ii,jj]=unique(z);
fz = fz(ii);

[Ax,Ay,b,K] = convexhullFromSampled(z,fz,xL,xU);"
6327,detectmult.m,67.0,60,54.17,75,100.0,45.83,61-70,"function doublepeaks = detectmult(TGEI,maxF)


doublepeaks(length(TGEI(:,1))) = 0;

if length(TGEI(:,1)) > 1
	for z = 1: length(TGEI(:,1)) - 1
        if 1 / ( TGEI(z + 1,3) - TGEI(z,3) ) > maxF
            if z == 1
                doublepeaks(z) = 1;
                doublepeaks(z + 1) = 3;
            elseif ismember(doublepeaks(z - 1),[0 3])
                doublepeaks(z) = 1;
                doublepeaks(z + 1) = 3;
            elseif ismember(doublepeaks(z - 1),[1 2])
                doublepeaks(z) = 2;
                doublepeaks(z + 1) = 3;
            end
            
        end

	end

end"
6328,computeVelCoeffsMtx.m,66.216,60,73.91,45,100.0,52.17,61-70,"function A_xyz = computeVelCoeffsMtx(sectorOrder)

Ns = sectorOrder;
Nxyz = Ns+1;

x1 = sqrt(2*pi/3);
x3 = -sqrt(2*pi/3);
y1 = 1i*sqrt(2*pi/3);
y3 = 1i*sqrt(2*pi/3);
z2  = sqrt(4*pi/3);

A_xyz = zeros((Nxyz+1)^2, (Ns+1)^2, 3);

G_mtx = gaunt_mtx(Ns, 1, Nxyz);

for ii=1:(Nxyz+1)^2
    for jj=1:(Ns+1)^2
        
        A_xyz(ii,jj,1) = x1*G_mtx(jj,2,ii) + x3*G_mtx(jj,4,ii);
        A_xyz(ii,jj,2) = y1*G_mtx(jj,2,ii) + y3*G_mtx(jj,4,ii);
        A_xyz(ii,jj,3) = z2*G_mtx(jj,3,ii);
    end
end"
