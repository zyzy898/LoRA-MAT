2455,compute_strides.m,78.112,60,77.78,75,100.0,77.78,70-80,"function strides = compute_strides(bnet)

num_cpts = size(bnet.CPD, 2);
max_cpt_dim = 1 + max(sum(bnet.dag));
strides = zeros(num_cpts, max_cpt_dim);

for i = 1:num_cpts
  c = CPT(bnet, i);
  siz = size(CPT(bnet, i));
  
  if siz(2) == 1
    dim = 1;
  else
    dim = size(siz, 2);
  end

