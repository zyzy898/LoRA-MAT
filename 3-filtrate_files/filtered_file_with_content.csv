E = zonotope(E,'outer:norm',28);

c = [ 3 ; 0 ; 0];
G = [ 0.123 0.018 0.080 0.556 -0.215 0.007 ; 0.568 -0.093 -0.054 -0.167 -0.028 -0.088 ; 0.190 0.122 -0.090 -0.008 0.237 -0.354 ];
