performance1=PSNR(x_0(:),x_hat1(:));
[num2str(SamplingRate*100),'% Sampling ', denoiser1, '-AMP Reconstruction PSNR=',num2str(performance1)]

subplot(1,2,1);
imshow(uint8(x_0));title('Original Image');
subplot(1,2,2);
imshow(uint8(x_hat1));title([denoiser1, '-AMP']);"
942,ct2lg_GT.m,82.096,100,83.87,75,100.0,51.61,80-90,"function [dx,dy,dz]=ct2lg_GT(dX,dY,dZ,lat,lon)


if nargin ~= 5
  warning('Incorrect number of input arguements');
  return
end

n=length(dX);
if length(lat)==1
  lat=ones(n,1)*lat;
  lon=ones(n,1)*lon;
end
R=zeros(3,3,n);

R(1,1,:)=-sin(lat').*cos(lon');
R(1,2,:)=-sin(lat').*sin(lon');
R(1,3,:)=cos(lat');
R(2,1,:)=-sin(lon');
R(2,2,:)=cos(lon');
R(2,3,:)=zeros(1,n);
R(3,1,:)=cos(lat').*cos(lon');
R(3,2,:)=cos(lat').*sin(lon');
R(3,3,:)=sin(lat');

RR=reshape(R(1,:,:),3,n);
dx=sum(RR'.*[dX dY dZ],2);
RR=reshape(R(2,:,:),3,n);
dy=sum(RR'.*[dX dY dZ],2);
RR=reshape(R(3,:,:),3,n);
dz=sum(RR'.*[dX dY dZ],2);"
943,CTAEA.m,84.49,100,73.47,100,100.0,48.98,80-90,"classdef CTAEA < ALGORITHM


    methods
        function main(Algorithm,Problem)
            [W,Problem.N] = UniformPoint(Problem.N,Problem.M);

            Population = Problem.Initialization();
            CA = UpdateCA([],Population,W);
            DA = UpdateDA(CA,[],Population,W);

            while Algorithm.NotTerminated(CA)
                Hm = [CA,DA];                         
                [FrontNo,~] = NDSort(Hm.objs,inf);
                FrontNo_C   = FrontNo(1:ceil(length(Hm)/2));
                Nc = size(find(FrontNo_C==1),2);      
                Pc = Nc/length(Hm);
                FrontNo_D = FrontNo(ceil(length(Hm)/2)+1:length(Hm));
                Nd = size(find(FrontNo_D==1),2);      
                Pd = Nd/length(Hm);

                [FrontNo,~] = NDSort(CA.objs,inf);
                NC = size(find(FrontNo==1),2);         
                PC = NC/length(CA);                     % PC denotes the proportion of non-dominated solutions in CA,it is different from Pc

                Q = [];
                for i = 1 : size(W,1)
                    if Pc > Pd
                        P1 = MatingSelection(CA); 
                    else
                        P1 = MatingSelection(DA);
                    end
                    pf = rand();
                    if pf < PC
                        P2 = MatingSelection(CA);
                    else
                        P2 = MatingSelection(DA);
                    end
                    MatingPool = [P1,P2];
                    Offspring  = OperatorGAhalf(Problem,MatingPool);
                    Q = [Q,Offspring];
                end

                CA = UpdateCA(CA,Q,W);
                DA = UpdateDA(CA,DA,Q,W);
            end
        end
    end
end"
944,ctd_rmloops.m,80.068,100,70.11,90,100.0,40.23,80-90,"function data = ctd_rmloops(data, wthresh, updn)

tsmooth = .25; % seconds
fs = 24; % Hz
np = length(data.p);
data.w = wsink(data.p, tsmooth, fs); % down/up +/-ve
iloop = [];

if updn
  flp = find(data.w < wthresh); 
  if length(flp)>=1
    ilp = findsegments(flp);
    nlp = length(ilp.start);
    for ii = 1:nlp
      pm = max(data.p(1:ilp.stop(ii)));
      pmi(ii) = min(find(data.p == pm));
      tmp = find(data.p(pmi(ii):end) < pm);
      wmin=min(data.w(ilp.start(ii):ilp.stop(ii)));
      overshoot_depth=-1.4*wmin+1;
      if pmi(ii) == length(data.p)
	iloop = [iloop; [pmi(ii)]];
      else
       icont = find(data.p > (pm+overshoot_depth) & [1:np]' > ilp.stop(ii), 1, 'first');
       iloop = [iloop; [ilp.start(ii):(icont) - 1]'];
      end
    end
  else
    nlp=[]; iloop=[];
  end
else 
  flp = find(data.w > -wthresh); 
  if length(flp)>1
    ilp = findsegments(flp);
    nlp = length(ilp.start);
    for ii = 1:nlp
      pm = min(data.p(1:ilp.stop(ii)));
      pmi(ii) = find(data.p == pm);
      tmp = find(data.p(1:pmi(ii)) < pm);
      wmin=min(-data.w(ilp.start(ii):ilp.stop(ii)));
      overshoot_depth=-1.4*wmin+1.7+1.5; % 1.5 meter more on way up because ctd at bottom of rosette!
      if pmi(ii) == length(data.p)
	iloop = [iloop; [pmi(ii)]];
      else
       icont = find(data.p < (pm-overshoot_depth) & [1:np]' > ilp.stop(ii), 1, 'first');
       iloop = [iloop; [ilp.start(ii):(icont) - 1]'];
      end
    end
  else
    nlp=[]; iloop=[];
  end
end

disp(['n loops = ' num2str(nlp)]);
disp(['n data in loops = ' num2str(length(iloop))]);



data.t1(iloop) = NaN;

data.t2(iloop) = NaN;
data.c1(iloop) = NaN;
data.c2(iloop) = NaN;
data.s1(iloop) = NaN;
data.s2(iloop) = NaN;
data.theta1(iloop) = NaN;
data.theta2(iloop) = NaN;
data.sigma1(iloop) = NaN;
data.sigma2(iloop) = NaN;
data.oxygen(iloop) = NaN;
data.trans(iloop) = NaN;
data.fl(iloop) = NaN;

figures = 0;

if figures
  figure
  ax(1) = subplot(211); plot(data.w); hold on; 
  plot(flp, data.w(flp), 'rx'); 
  plot(iloop, data.w(iloop), 'yo'); hold off
  ylabel('w'); title(['w < ' num2str(wthresh) ' m/s'])
  ax(2) = subplot(212); plot(data.p, 'bx'); hold on; 
  plot(flp, data.p(flp), 'rx'); 
  hold off; ylabel('p')
  linkaxes(ax, 'x')
  subplot(211); hold on; 
  subplot(212); hold on; plot(iloop, data.p(iloop), 'yo'); hold off
end"
