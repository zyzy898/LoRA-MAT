5943,detectMonotoneSDPObjective.m,71.406,60,74.07,60,100.0,62.96,70-80,"function p = detectMonotoneSDPObjective(p)
p.monotoneobjectiveresponse = 0;
if any(p.c) && isempty(p.evalMap) && nnz(p.Q) == 0 && all(p.variabletype == 0)
    s = setdiff(find(p.c),[p.binary_variables p.integer_variables]);
    if ~isempty(s)
        ci = p.c(s);
        baseSign = sign(ci(1));
        if all(sign(ci) == baseSign)
            if nnz(p.F_struc(1:p.K.f,1 + s))==0
                if (baseSign == 1 && all(all(p.F_struc(p.K.f+1:p.K.f+p.K.l,1 + s)>=0))) || (baseSign == -1 && all(all(p.F_struc(p.K.f+1:p.K.f+p.K.l,1 + s)<=0)))
                    if all(all(p.F_struc(p.K.f+p.K.l+1:p.K.f+p.K.l+sum(p.K.q)+3*sum(p.K.e)+sum(p.K.p),1 + s)==0))
                        top = startofSDPCone(p.K);
                        working = 1;
                        for i = 1:length(p.K.s)
                            B = p.F_struc(top:top+p.K.s(i)^2-1,1+s);
                            working = working==1 && all(sum(B | B,1) <= 1) && ((all(all(B >= 0)) && baseSign == 1) || (all(all(B <= 0)) && baseSign == -1));
                            top = top + p.K.s(i)^2;
                        end
                        if working
                            p.monotoneobjectiveresponse = baseSign;
                        end
                    end
                end
            end
        end
    end
end"
5944,detectmuscle.m,77.444,100,59.72,90,100.0,37.5,70-80,"function [INI,S,E] = detectmuscle(S, iter, Mode)



if nargin<2,
        iter=[];
end;
INI = [];

if Mode==1, 
	if isempty(iter) iter = 1; end; 
	TH = 5; 
	[se,INI.MU] = sem(S);
	if TH*se<abs(INI.MU),
		[S] = center(S);
	end;

	while iter>0,
        	[AR,RC,PE]= lattice(S',10);
		INI.InvFilter = ar2poly(AR);
        	E = zeros(size(S));
        	for k = 1:size(S,2),
                	E(:,k) = filter(INI.InvFilter(k,:),1,S(:,k));
	        end;
        	INI.V  = std(E);
	        INI.TH = INI.V * TH; 
        	iter   = iter-1;
        
	        for k = 1:size(S,2),
        	        S(E(:,k)>(INI.TH(k)) | E(:,k)<(-INI.TH(k)),k) = NaN;
	        end;
	end; 
	for k = 1:size(S,2),
                E(:,k) = filter(INI.InvFilter(k,:),1,S(:,k));
	end;

elseif Mode==2,
	Fs = iter; 
	ix1 = [abs(diff(S,[],1))>100;zeros(1,size(S,2))];
	
	
	ix2 = abs(filter([-1;zeros(Fs/10-1,1);1],1,S))>150;
	ix2 = [ix2(Fs/20+1:end,:);zeros(Fs/20+1,size(S,2))]; 

	ix3 = abs(S)>75;
	
	ix = filtfilt(ones(Fs/10,1),1,double(ix1|ix2|ix3))>0;
	S(ix) = NaN;	
	INI=[]; 


elseif Mode==3,
	Fs = iter; 
	E  = filter(ones(1,Fs),Fs,abs(diff(S))/Fs*250);
	Threshold = 11; % uV/sample [1]
	S(E>Threshold) = NaN;


elseif Mode==4,
	Fs = iter; 
	if Fs>= 250, 
		[A,B]=butter(5,25*2/Fs,'high');
	else 	
		[A,B]=butter(5,[25,125]*2/Fs);
	end; 
	E = filtfilt(ones(1,Fs),Fs,filtfilt(A,B,S).^2);
	Threshold = 0.9; % uV^2/Hz ??? [1]
 	S(E>Threshold) = NaN; 

end; 

if nargout<3, return; end;"
