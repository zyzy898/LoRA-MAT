    output_txt{end+1} = ['Z: ',num2str(pos(3),4)];
end"
4320,curvatureAnalysis_drive.m,74.672,80,75.36,75,100.0,43.0,70-80,"function [C]    = curvatureAnalysis_drive(astr_annotFile, astr_groupFileID, varargin)


    function    [C] = subregion_define(C, astr_lsArgs)
