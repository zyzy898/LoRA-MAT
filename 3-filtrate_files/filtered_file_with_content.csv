2251,computeTextons.m,74.334,60,91.67,45,100.0,75.0,70-80,"function [map,textons] = computeTextons(fim,k)

d = numel(fim);
n = numel(fim{1});
data = zeros(d,n);
for i = 1:d,
  data(i,:) = fim{i}(:)';
end

[map,textons] = kmeansML(k,data,'maxiter',30,'verbose',0);
[w,h] = size(fim{1});
