3954,crossing.m,79.538,100,63.46,90,100.0,44.23,70-80,"function [ind,t0,s0,t0close,s0close] = crossing(S,t,level,imeth)



narginchk(1,4);

if nargin < 2 || isempty(t)
    t = 1:length(S);
elseif length(t) ~= length(S)
    error('t and S must be of identical length!');    
end

if nargin < 3
    level = 0;
end

if nargin < 4
    imeth = 'linear';
end

t = t(:)';
S = S(:)';

S   = S - level;

ind0 = find( S == 0 ); ind0(ind0==1)=[];

S1 = S(1:end-1) .* S(2:end);
ind1 = find( S1 < 0 ); ind1(ind1==1)=[];

ind = sort([ind0 ind1]);

t0 = t(ind); 
s0 = S(ind);

if strcmp(imeth,'linear')
    for ii=1:length(t0)
        if abs(S(ind(ii))) > eps(S(ind(ii)))
            NUM = (t(ind(ii)+1) - t(ind(ii)));
            DEN = (S(ind(ii)+1) - S(ind(ii)));
            DELTA =  NUM / DEN;
            t0(ii) = t0(ii) - S(ind(ii)) * DELTA;
            s0(ii) = 0;
        end
    end
end

[CC,II] = min(abs([S(ind-1) ; S(ind) ; S(ind+1)]),[],1); 
ind2 = ind + (II-2); %update indices 

t0close = t(ind2);
s0close = S(ind2);"
