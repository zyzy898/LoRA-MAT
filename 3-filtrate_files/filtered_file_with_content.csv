3857,create_logisticloss_label.m,72.262,60,73.68,75,100.0,52.63,70-80,"function logloss_label = create_logisticloss_label(label_size, rPos, rNeg)
    label_side = label_size(1);
    logloss_label = single(zeros(label_side));
    label_origin = [ceil(label_side/2) ceil(label_side/2)];
    for i=1:label_side
        for j=1:label_side
            dist_from_origin = dist([i j], label_origin');
            if dist_from_origin <= rPos
                logloss_label(i,j) = +1;
            else
                if dist_from_origin <= rNeg
                    logloss_label(i,j) = 0;
                else
                    logloss_label(i,j) = -1;
                end
            end
        end
    end
end"
3858,create_map.m,72.286,60,100.0,30,100.0,71.43,70-80,"function map = create_map(I,target_sz,ratio)
w=size(I,2);
h=size(I,1);
hs=round(0.5*h-0.5*ratio*target_sz(1)):round(0.5*h+0.5*ratio*target_sz(1));
ws=round(0.5*w-0.5*ratio*target_sz(2)):round(0.5*w+0.5*ratio*target_sz(2));
center_region=I(hs,ws);
target_region=zeros(size(I));
target_region(round((h-target_sz(1))/2):round((h+target_sz(1))/2),round((w-target_sz(2))/2):round((w+target_sz(2))/2))=1;
me=mean(center_region(:));
sig=std(center_region(:),0);
map=zeros(size(I));
map(I>(me-sig)&I<(me+sig))=1;
map=map.*target_region;
end"
3859,create_marker_templates.m,73.5,100,75.0,30,100.0,62.5,70-80,"clear; clc;


f = figure();

markers_dir_path = fileparts(mfilename('fullpath'));
marker_config = util.read_data(fullfile(markers_dir_path, 'marker.conf'));

theta_samples = linspace(0, 2*pi, marker_config.num_samples_theta+1)';
theta_samples(end) = [];

radius_samples = linspace(marker_config.radius_marker*marker_config.range_r_norm(1), ...
                          marker_config.radius_marker*marker_config.range_r_norm(2), ...
                          marker_config.num_samples_radius)';

marker_templates_path = fullfile(markers_dir_path, 'marker_templates.txt');
fclose(fopen(marker_templates_path, 'w')); % Creates/clears file
for i = 1:numel(marker_config.marker_paths)
    array_marker = imread(marker_config.marker_paths{i});
    array_marker = rgb2gray(im2double(array_marker));

    x = cos(theta_samples)*radius_samples' + (size(array_marker, 2)+1)/2;
    y = sin(theta_samples)*radius_samples' + (size(array_marker, 1)+1)/2;

    polar_patch = alg.interp_array(array_marker, [x(:) y(:)], marker_config.interp);
    polar_patch = reshape(polar_patch, numel(theta_samples), []);

    a = subplot(4, 2, 2*(i-1)+1, 'parent', f);
    imshow(array_marker, [], 'parent', a);
    hold(a, 'on');
    plot(x(:), y(:), '-r', 'Parent', a);
    hold(a, 'off');

    a = subplot(4, 2, 2*i, 'parent', f);
    imshow(polar_patch, [], 'parent', a)

    util.write_comment(['Marker ' num2str(i)], marker_templates_path);
    util.write_array(polar_patch, 'polar_patches', marker_templates_path);
    util.write_newline(marker_templates_path);
end"
3860,create_masks.m,73.304,100,65.22,60,100.0,41.3,70-80,"function [ind_Mp, ind_Md] = create_masks(ge, gridnd)

chkarg(istypesizeof(ge, 'GT'), '""ge"" should be instance of GT.');  % ge: grid type for the E-field
chkarg(istypesizeof(gridnd, 'Grid2d') || istypesizeof(gridnd, 'Grid3d'), '""gridnd"" should be instance of Grid2d or Grid3d.');

v = Axis.x;
if istypesizeof(gridnd, 'Grid2d')
	v = Dir.h;
end

N = gridnd.N;
bc = gridnd.bc;
ind = cell(1, v.count);

mask_p = cell(1, v.count);
for w = v.elems  % mask w-component of field on primary grid
	mask = false(N);
	us = setdiff(v.elems, w);

	for u = us
		if (ge == GT.prim && bc(u) == BC.e) || (ge == GT.dual && bc(u) == BC.m)
			[ind{:}] = deal(':');  % ind = {':', ':', ':'} for grid3d
			ind{u} = 1;
			mask(ind{:}) = true;
		end
	end
	mask_p{w} = mask(:);
end

ind_Mp = cell2mat(mask_p);
ind_Mp = ind_Mp(:);

mask_d = cell(1, v.count);
for w = v.elems  % mask w-component of field on dual grid
	mask = false(N);
	
	if (ge == GT.prim && bc(w) == BC.e) || (ge == GT.dual && bc(w) == BC.m)
		[ind{:}] = deal(':');  % ind = {':', ':', ':'} for grid3d
		ind{w} = 1;
		mask(ind{:}) = true;
	end
	mask_d{w} = mask(:);
end

ind_Md = cell2mat(mask_d);
ind_Md = ind_Md(:);"
3861,create_mask_demo_gui.m,77.618,80,62.77,100,100.0,45.32,70-80,"function varargout = create_mask_demo_gui(im)
    if nargin < 1
        src = imread(fullfile(mexopencv.root(),'test','fruits.jpg'));
    elseif isempty(im)
        [im,cancel] = imgetfile();
        assert(~cancel, 'No file selected');
        src = imread(im);
    elseif ischar(im)
        src = cv.imread(im, 'Color',true);
    else
        src = im;
    end
    assert(size(src,3) == 3, 'Expecting a color source image');

    sz = size(src);
    out = [];        % output image
    pts = [];        % 2D points

    h = buildGUI();
    onReset([],[]);
    if nargout > 0, varargout{1} = h; end


    function h = buildGUI()

        h = struct();
        h.fig = figure('Name','Interactive Mask', 'Menubar','none', ...
            'Position',[200 200 sz(2) sz(1)]);
        if ~mexopencv.isOctave()
            movegui(h.fig, 'center');
        end
        h.ax = axes('Parent',h.fig, 'Units','normalized', 'Position',[0 0 1 1]);
        if ~mexopencv.isOctave()
            h.img = imshow(src, 'Parent',h.ax);
        else
            axes(h.ax);
            h.img = imshow(src);
        end
    end

    function onHelp(~,~)

        hd = helpdlg({
            'Left-click the mouse to define the vertices of the polygon.'
            'Right-click when finished to close the polygon, connecting'
            'the last vertex with the first.'
            'Hot keys:'
            '  h: usage dialog'
            '  r: reset'
            '  s: save current output image as PNG image'
            '  p: save current points matrix as MAT-file'
            '  q: quit the program'
        }, 'Interactive mask demo');
        set(hd, 'WindowStyle','modal');
    end

    function onReset(~,~)

        pts = zeros(0,2);
        out = src;

        set(h.fig, 'Pointer','cross', 'WindowKeyPressFcn',@onType, ...
            'WindowButtonDownFcn',@onMouseDown, ...
            'WindowButtonUpFcn',@onMouseUp);

        set(h.img, 'CData',out);
        drawnow;
    end

    function onType(~,e)

        switch e.Key
            case 'r'
                onReset([],[]);
            case 'h'
                onHelp([],[]);
            case 's'
                fname = [tempname() '.png'];
                imwrite(out, fname);
                fprintf('Output saved as ""%s""\\n', fname);
            case 'p'
                uisave({'pts'}, 'points.mat');
            case {'q', 'escape'}
                close(h.fig);
        end
    end

    function onMouseDown(~,~)

        if strcmp(get(h.fig,'SelectionType'), 'normal')
            pt = get(h.ax, 'CurrentPoint');
            pt = round(pt(1,1:2));

            out = cv.circle(out, pt, 2, ...
                'Color',[255 0 0], 'Thickness','Filled');

            pts(end+1,:) = pt;

            if size(pts,1) >= 2
                out = cv.line(out, pts(end-1,:), pts(end,:), ...
                    'Color',[255 0 0], 'Thickness',2);
            end

            set(h.img, 'CData',out);
            drawnow;
        else
            out = src;
            if ~isempty(pts)
                out = cv.polylines(out, pts, ...
                    'Closed',true, 'Color',[0 0 0], 'Thickness',2);
            end

            set(h.img, 'CData',out);
            drawnow;
        end
    end

    function onMouseUp(~,~)

        if strcmp(get(h.fig,'SelectionType'), 'normal'), return; end

        set(h.fig, 'Pointer','arrow', ...
            'WindowButtonDownFcn','', 'WindowButtonUpFcn','');

        mask = zeros(sz(1:2), 'uint8');
        if ~isempty(pts)
            mask = cv.fillPoly(mask, pts, 'Color',[255 255 255]);
        end
        cv.imwrite(fullfile(tempdir(), 'mask.png'), mask);
        disp(['Mask saved: ' fullfile(tempdir(), 'mask.png')]);

        out = bsxfun(@times, uint8(mask~=0), src);

        set(h.img, 'CData',out);
        drawnow;
    end
end"
3862,create_model_regression.m,71.25,100,46.25,75,100.0,35.0,70-80,"function [layers, options] = create_model_regression(input_size, Xval, Yval, model_name, EPOCHS, LEARN_RATE)

    
    if nargin<4
        model_name = '3dcnn';
    end
    if nargin<5
        EPOCHS = 100;
    end
    if nargin<6
        LEARN_RATE = 0.001;
    end
    
    
    
    if strcmp(model_name,'3dcnn')
                
        ts = input_size(3); % 3rd dimension is the number of timestamp
        
    
        layers = [
            
        image3dInputLayer(input_size)
        
                
        
        
        convolution3dLayer([3,3,ts],64,'Padding',[1,1,1],'Stride',[1,1,1])
        batchNormalizationLayer
        reluLayer
        maxPooling3dLayer([2,2,1],'Stride',[1,1,1]) % we do not reduce the size in the 1st pooling
        
        convolution3dLayer([3,3,ts],128,'Padding',[1,1,1],'Stride',[1,1,1])
        batchNormalizationLayer
        reluLayer
        maxPooling3dLayer([2,2,1],'Stride',[2,2,1]) % we only reduce the spatial size in the 2nd pooling
        
        convolution3dLayer([3,3,ts],256,'Padding',[1,1,1],'Stride',[1,1,1])
        batchNormalizationLayer
        reluLayer
        convolution3dLayer([3,3,ts],256,'Padding',[1,1,1],'Stride',[1,1,1])
        batchNormalizationLayer
        reluLayer
        maxPooling3dLayer([2,2,1],'Stride',[2,2,1]) % we only reduce the spatial size in the 3rd pooling
        
        convolution3dLayer([3,3,ts],512,'Padding',[1,1,1],'Stride',[1,1,1])
        batchNormalizationLayer
        reluLayer
        convolution3dLayer([3,3,ts],512,'Padding',[1,1,1],'Stride',[1,1,1])
        batchNormalizationLayer
        reluLayer
        maxPooling3dLayer([2,2,ts],'Stride',[2,2,ts]) % we use the original pooling for the 4rd maxPooling (timestaps) in this layer
        
        
        
        fullyConnectedLayer(1024)
        batchNormalizationLayer
        reluLayer
        fullyConnectedLayer(1)
        regressionLayer];
    
    
        options = trainingOptions('adam', ...
