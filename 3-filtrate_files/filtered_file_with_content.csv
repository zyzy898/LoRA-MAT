for i=1:numel(mergedRxns)
    duplRxn=transpose([mergedRxns(i),duplicateRxns(mergeTo==mergedRxns(i))]);
    if numel(unique(model.lb(duplRxn)))>1
        EM=['Duplicates of reaction ' model.rxns{mergedRxns(i)} ' have different lower bound. Uses the most negative/smallest lower bound'];
        dispEM(EM,false);
        model.lb(mergedRxns(i))=min(model.lb(duplRxn));
    end
    if numel(unique(model.ub(duplRxn)))>1
        EM=['Duplicates of reaction ' model.rxns{mergedRxns(i)} ' have different upper bound. Uses the most positive/largest upper bound'];
        dispEM(EM,false);
        model.ub(mergedRxns(i))=max(model.ub(duplRxn));
    end
    if numel(unique(model.c(duplRxn)))>1
        EM=['Duplicates of reaction ' model.rxns{mergedRxns(i)} ' has a different objective function coefficient. Uses the largest coefficient'];
        dispEM(EM,false);
        model.c(mergedRxns(i))=max(model.c(duplRxn));
    end
    if isfield(model,'grRules') && any(~isempty(model.grRules(duplRxn)))
        rules=model.grRules(duplRxn);
        allRules={};
        for j=1:numel(rules)
            rules{j}=ignoreORinComplex(rules{j});
            allRules=[allRules regexp(rules{j},' or ','split')];
        end
        allRules=unique(allRules);
        allRules=strrep(allRules,'__OR__',' or ');
        andRules=contains(allRules,' and ');
        allRules(andRules)=strcat('(',allRules(andRules),')');
        if numel(allRules)==1
            model.grRules{mergedRxns(i)}=allRules{1};
        else
            model.grRules{mergedRxns(i)}=strjoin(allRules,' or ');
        end
    end    
    if isfield(model,'eccodes') && any(~isempty(model.eccodes(duplRxn)))
        codes=model.eccodes(duplRxn);
        allCodes={};
        for j=1:numel(codes)
            allCodes=[allCodes regexp(codes{j},';','split')];
        end
        allCodes=unique(allCodes);
        if numel(allCodes)==1
            model.eccodes{mergedRxns(i)}=allCodes{1};
        else
            model.eccodes{mergedRxns(i)}=strjoin(allCodes,';');
        end
    end
    if numel(duplRxn)==2
        indexedDuplicateRxns{duplRxn(1)}=model.rxns{duplRxn(2)};
    else
        indexedDuplicateRxns{duplRxn(1)}=strjoin(model.rxns(duplRxn(2:end)),';');
    end
    if all(~cellfun(@isempty,regexp(model.rxns(duplRxn),'_EXP_\\d+$')))
        model.rxns(duplRxn(1))=regexprep(model.rxns(duplRxn(1)),'_EXP_\\d+$','');
    end
end

reducedModel=removeReactions(model,duplicateRxns);
removedRxns=model.rxns(duplicateRxns);
[~, index]=ismember(reducedModel.rxns,model.rxns);
indexedDuplicateRxns=indexedDuplicateRxns(index);

if isfield(reducedModel,'rxnGeneMat')
    [grRules,rxnGeneMat] = standardizeGrRules(reducedModel,true);
    reducedModel.grRules = grRules;
    reducedModel.rxnGeneMat = rxnGeneMat;
end
end

function grRule = ignoreORinComplex(grRule)
grRule=['(' grRule ')'];
brOpen=strfind(grRule,'(');
brClose=strfind(grRule,')');
andPos=strfind(grRule,' and ');
stillCapturing = 0;
for i=1:numel(andPos)
    searchPos = andPos(i);
    while stillCapturing == 0
        closestOpen = brOpen(max(find(brOpen<searchPos)));
        inbetweenClose = brClose(brClose<searchPos & brClose>closestOpen);
        if ~isempty(inbetweenClose)
            searchPos=max(inbetweenClose);
        else
            stillCapturing = 1;
            beginPos = closestOpen;
        end
    end
    stillCapturing = 0;
    searchPos = andPos(i);
    while stillCapturing == 0
        closestClose = brClose(min(find(brClose>searchPos)));
        inbetweenOpen = brOpen(brOpen>searchPos & brOpen<closestOpen);
        if ~isempty(inbetweenOpen)
            searchPos=min(closestClose);
        else
            stillCapturing = 1;
            endPos = closestClose;
        end
    end
    replacePart=regexprep(grRule(beginPos:endPos),' or ','__OR__');
    grRule=strrep(grRule,grRule(beginPos:endPos),replacePart);
end
grRule=grRule(2:end-1);
end"
2848,contractParallelLinearization.m,77.562,100,53.66,100,100.0,34.15,70-80,"function res = contractParallelLinearization(f,dom,jacHan,varargin)



    method = 'taylm';
    if nargin >= 4 && ~isempty(varargin{1})
       method = varargin{1}; 
    end

    mi = center(dom);
    A = jacHan(mi);

    if strcmp(method,'taylm')
       try
           tay = taylm(dom);
           J = interval(jacHan(tay));
       catch
           J = jacHan(dom); 
       end
    else
        J = jacHan(dom);
    end
    
    b = f(mi) - A * mi + (J - A) * (dom - mi);

    A_ = [-A;A];
    b_ = [supremum(b);-infimum(b)];
    
    infi = infimum(dom);
    sup = supremum(dom);
    
    problem.Aineq = A_;
    problem.bineq = b_;
    problem.Aeq = [];
    problem.beq = [];
    problem.options = optimoptions('linprog','Display','off', ...
                           'ConstraintTolerance',1e-9);
    
    n = length(mi);
    f = zeros(n,1);
    
    for i = 1:n
       
        f_ = f;
        f_(i) = 1;
        
        problem.f = f_;
        problem.lb = infi;
        problem.ub = sup;
        [~,temp] = CORAlinprog(problem);
        
        if ~isempty(temp)
            infi(i) = max(infi(i),temp);
        else
            poly = polytope([A_;eye(n);-eye(n)],[b_;sup;-infi]);
            
            if representsa_(poly,'emptySet',eps)
               res = [];
               return;
            end
        end
        
        problem.f = -f_;
        problem.lb = infi;
        problem.ub = sup;
        [~,temp] = CORAlinprog(problem);
        
        if ~isempty(temp)
            sup(i) = min(sup(i),-temp);
        else
            poly = polytope([A_;eye(n);-eye(n)],[b_;sup;-infi]);
            
            if representsa_(poly,'emptySet',eps)
               res = [];
               return;
            end
        end
    end
    
    res = interval(infi,sup);

end"
2849,contractPolyBoxRevise.m,71.072,80,45.73,100,100.0,29.63,70-80,"function res = contractPolyBoxRevise(f,dom)



    n = length(dom);

    x = sym('x',[n,1]);

    p = f(x);

    mins = infimum(dom);
    maxs = supremum(dom);
    
    try
        for i = 1:length(p)
            sym2poly(p(i));
        end
    catch ex
        if strcmp(ex.identifier,'symbolic:sym:sym2poly:errmsg2')
            throw(CORAerror('CORA:specialError',...
                ['Contractor ""polynomial"" is only applicable for ', ...
                   'polynomial constraints!']));
        end
    end

    for i = 1:n

        for j = 1:length(p)
        
            if infimum(dom(i)) < 0 && supremum(dom(i)) > 0

                 tmp = dom;
                 int1 = interval(infimum(tmp(i)),0);
                 dom(i) = int1;
                 res1_ = aux_contractBox(x(i),p(j),dom,i);

                 int2 = interval(0,supremum(tmp(i)));
                 dom(i) = int2;
                 res2_ = aux_contractBox(x(i),p(j),dom,i);
                 dom = tmp;

                 res_ = interval(min(res1_),max(res2_));

                 mins(i) = infimum(res_);
                 maxs(i) = supremum(res_);

                 if infimum(res_) < infimum(dom(i))
                     mins(i) = infimum(dom(i));
                 end

                 if infimum(res_) > supremum(dom(i))
                     maxs(i) = supremum(dom(i));
                 end
                 
                 dom = interval(mins,maxs) & dom;

                 continue
            end

            res_ = aux_contractBox(x(i),p(j),dom,i);
            mins(i) = min(res_);
            maxs(i) = max(res_);
            dom = interval(mins,maxs) & dom;
        end
     end

    res = dom;
end



function res_ = aux_contractBox(var,poly,dom,index)
    
    c = coeffs(poly,var,'All');

    d = length(c);

    infs = zeros(1,d);
    sups = zeros(1,d);

    n = length(dom);
    x = sym('x',[n,1]);

    if supremum(dom(index)) <= 0
        negInt = 1; 
    else
        negInt = 0;
    end

    for k = 1:d

        if c(k) == 0
            continue
        end

        g = matlabFunction(c(k),'Vars',{x});

        if isa(g(dom),'double') == 1
            infs(k) = g(dom);
            sups(k) = g(dom);
            continue
        end 

        if (mod(d,2) == 1 && mod(k,2) == 0 && negInt == 1) || ...
           (mod(d,2) == 0 && mod(k,2) == 1 && negInt == 1)
            infs(k) = supremum(g(dom));
            sups(k) = infimum(g(dom));
            continue
        end

        infs(k) = infimum(g(dom));
        sups(k) = supremum(g(dom));     
    end

    inffuc = poly2sym(infs);
    infHan = matlabFunction(inffuc);
    supfuc = poly2sym(sups);
    supHan = matlabFunction(supfuc);


    l = infimum(dom(index));

    if polyval(infs,infimum(dom(index))) <= 0 && ...
       polyval(sups,infimum(dom(index))) >= 0
        l = infimum(dom(index));
    end

    if polyval(infs,infimum(dom(index))) > 0

        if d < 4 
            l_ = roots(infs);
            if ~isempty(l_) && isreal(l_) && min(l_) > l
                l = l_;
            end
        else
            int = contractForwardBackward(infHan,dom(index));

            if ~isempty(int)
                 l = infimum(int);
            end
        end
    end

    if polyval(sups,infimum(dom(index))) < 0

        if d < 4
            l_ = roots(sups);
            if ~isempty(l_) && isreal(l_) && min(l_) > l
                l = l_;
            end
        else
            int = contractForwardBackward(supHan,dom(index));
            
            if ~isempty(int)
               l = infimum(int); 
            end
        end    
    end


    r = supremum(dom(index));

    if polyval(infs,supremum(dom(index))) <= 0 && ...
       polyval(sups,supremum(dom(index))) >= 0
        r = supremum(dom(index));

    elseif polyval(infs,supremum(dom(index))) > 0

        if d < 4 
            r_ = roots(infs);
            if ~isempty(r_) && isreal(r_) && max(r_) < r
                r = max(roots(infs));
            end
        else
            int = contractForwardBackward(infHan,dom(index));
            
            if ~isempty(int)
               r = supremum(int); 
            end
        end 

    elseif polyval(sups,supremum(dom(index))) < 0

        if d < 4
            r_ = roots(sups);
            if ~isempty(r_) && isreal(r_) && max(r_) < r
                r = max(r_);
            end
        else
            int = contractForwardBackward(supHan,dom(index));
            
            if ~isempty(int)
               r = supremum(int); 
            end
        end    
    end

    res_ = [l;r];
end"
