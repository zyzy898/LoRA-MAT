TFEint.Data.Imag=zeros(1,2,TFEint.API.N,TFEint.API.E);
for ii=1:TFEint.API.R
  for jj=1:TFEint.API.N
    TFEint.Data.Real(1,ii,jj,:)=Sint*squeeze(SH.Data.Real(1,ii,jj,:));
