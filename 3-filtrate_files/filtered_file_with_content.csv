4755,db_delete_subjects.m,79.646,100,76.47,60,100.0,61.76,70-80,"function errFolders = db_delete_subjects( iSubjects )


ProtocolInfo     = bst_get('ProtocolInfo');
ProtocolSubjects = bst_get('ProtocolSubjects');
errFolders = {};

iInvalid = find(iSubjects <= 0);
if ~isempty(iInvalid)
    disp('DELETE> Cannot delete default subject.');
    iSubjects(iInvalid) = [];
end

for i = 1:length(iSubjects)
    SubjectFile = ProtocolSubjects.Subject(iSubjects(i)).FileName;
    [sStudies, iStudies] = bst_get('StudyWithSubject', SubjectFile, 'intra_subject', 'default_study');
    if ~isempty(sStudies)
        errFolders = cat(2, errFolders, db_delete_studies(iStudies));
        subjDataDir = bst_fullfile(ProtocolInfo.STUDIES, bst_fileparts(bst_fileparts(sStudies(1).FileName)));
        if (file_delete(subjDataDir, 1, 1) ~= 1)
            errFolders{end+1} = subjDataDir;
            return;
        end
    end    
    subjAnatDir = bst_fullfile(ProtocolInfo.SUBJECTS, bst_fileparts(SubjectFile));
    if (file_delete(subjAnatDir, 1, 1) ~= 1)
        errFolders{end+1} = subjAnatDir;
        return;
    end
end
ProtocolSubjects.Subject(iSubjects) = [];
bst_set('ProtocolSubjects', ProtocolSubjects);
panel_protocols('UpdateTree');
db_save();"
4756,db_edit_protocol.m,78.756,80,63.36,100,100.0,50.42,70-80,"function iProtocol = db_edit_protocol(action, sProtocol, iProtocol)



global GlobalData;
sProtocolsListInfo     = GlobalData.DataBase.ProtocolInfo;
sProtocolsListSubjects = GlobalData.DataBase.ProtocolSubjects;
sProtocolsListStudies  = GlobalData.DataBase.ProtocolStudies;
isProtocolLoaded       = GlobalData.DataBase.isProtocolLoaded;
isProtocolModified     = GlobalData.DataBase.isProtocolModified;
nbProtocols = length(sProtocolsListInfo);
switch (action)
    case {'create', 'load'}
        if (nargin < 2)
            error('Usage:  db_edit_protocol(''create'', sProtocol).');
        end
        iProtocol = nbProtocols + 1;
    case 'edit'
        if (nargin < 3)
            error('Usage:  db_edit_protocol(action, sProtocol, iProtocol).');
        end
        if ((iProtocol <= 0) || (iProtocol > nbProtocols))
            error('Protocol #%d does not exist.', iProtocol);
        end
    otherwise
        error('Unknown action.');
end


if ~isdir(sProtocol.SUBJECTS)
    if ~mkdir(sProtocol.SUBJECTS)
        bst_error(['Could not create directory ""' sProtocol.SUBJECTS '"".'], 'Protocol editor', 0);
        iProtocol = -1;
        return
    end
elseif strcmpi(action, 'create') && (length(dir(sProtocol.SUBJECTS)) > 2)
    bst_error(['Folder ""' sProtocol.SUBJECTS '"" is not empty.'], 'Protocol editor', 0);
    iProtocol = -1;
    return
end
if ~isdir(sProtocol.STUDIES)
    if ~mkdir(sProtocol.STUDIES)
        bst_error(['Could not create directory ""' sProtocol.STUDIES '"".'], 'Protocol editor', 0);
        iProtocol = -1;
        return
    end
elseif strcmpi(action, 'create') && (length(dir(sProtocol.STUDIES)) > 2)
    bst_error(['Folder ""' sProtocol.STUDIES '"" is not empty.'], 'Protocol editor', 0);
    iProtocol = -1;
    return
end
if strcmpi(action, 'load') || strcmpi(action, 'create')
    if any(strcmpi(sProtocol.Comment, {sProtocolsListInfo.Comment})) 
        bst_error(sprintf('Protocol ''%s'' already exists in database.', sProtocol.Comment), 'Protocol editor', 0);
        iProtocol = -1;
        return
    end
end

sProtocolsListInfo(iProtocol).Comment  = sProtocol.Comment;
sProtocolsListInfo(iProtocol).SUBJECTS = sProtocol.SUBJECTS;
sProtocolsListInfo(iProtocol).STUDIES  = sProtocol.STUDIES;
if strcmpi(action, 'edit') || strcmpi(action, 'create')
    sProtocolsListInfo(iProtocol).UseDefaultAnat = sProtocol.UseDefaultAnat;
    sProtocolsListInfo(iProtocol).UseDefaultChannel = sProtocol.UseDefaultChannel;
end

if strcmpi(action, 'load')
    db_update(GlobalData.DataBase.DbVersion, sProtocol);
end

if strcmpi(action, 'load') || strcmpi(action, 'create')
    if isempty(sProtocolsListSubjects) || isempty(sProtocolsListStudies)
        sProtocolsListSubjects = db_template('ProtocolSubjects');
        sProtocolsListStudies  = db_template('ProtocolStudies');
        isProtocolLoaded       = 0;
        isProtocolModified     = 1;
    else
        sProtocolsListSubjects(iProtocol) = db_template('ProtocolSubjects');
        sProtocolsListStudies(iProtocol)  = db_template('ProtocolStudies');
        isProtocolLoaded(iProtocol)       = 0;
        isProtocolModified(iProtocol)     = 1;
    end
    
    defaultDir = bst_fullfile(sProtocolsListInfo(iProtocol).SUBJECTS, bst_get('DirDefaultSubject'));
    if ~isdir(defaultDir)
        mkdir(defaultDir);
    end
    newSubjectFile = bst_fullfile(defaultDir, 'brainstormsubject.mat');
    if ~file_exist(newSubjectFile)
        SubjectMat = db_template('subjectmat');
        SubjectMat.UseDefaultAnat    = 1;
        SubjectMat.UseDefaultChannel = 1;
        bst_save(newSubjectFile, SubjectMat, 'v7');
    end

    defaultDir = bst_fullfile(sProtocolsListInfo(iProtocol).STUDIES, bst_get('DirDefaultStudy'));
    if ~isdir(defaultDir)
        mkdir(defaultDir);
    end
    newStudyFile = bst_fullfile(defaultDir, 'brainstormstudy.mat');
    if ~file_exist(newStudyFile)
        StudyMat = db_template('studymat');
        StudyMat.Name = bst_get('DirDefaultStudy');
        bst_save(newStudyFile, StudyMat, 'v7');
    end
    
    defaultDir = bst_fullfile(sProtocolsListInfo(iProtocol).STUDIES, bst_get('DirAnalysisInter'));
    if ~isdir(defaultDir)
        mkdir(defaultDir);
    end
    newStudyFile = bst_fullfile(defaultDir, 'brainstormstudy.mat');
    if ~file_exist(newStudyFile)
        StudyMat = db_template('studymat');
        StudyMat.Name = bst_get('DirAnalysisInter');
        bst_save(newStudyFile, StudyMat, 'v7');
    end
    
    GlobalData.DataBase.ProtocolInfo       = sProtocolsListInfo;
    GlobalData.DataBase.ProtocolSubjects   = sProtocolsListSubjects;
    GlobalData.DataBase.ProtocolStudies    = sProtocolsListStudies;
    GlobalData.DataBase.isProtocolLoaded   = isProtocolLoaded;
    GlobalData.DataBase.isProtocolModified = isProtocolModified;
    gui_brainstorm('UpdateProtocolsList');

elseif strcmpi(action, 'edit')
    sProtocolsListInfo(iProtocol).Comment = sProtocol.Comment;
    GlobalData.DataBase.ProtocolInfo = sProtocolsListInfo;
    GlobalData.DataBase.isProtocolModified(iProtocol) = 1;
    panel_protocols('UpdateTree');
end"
4757,db_edit_subject.m,77.6,80,62.5,100,100.0,45.5,70-80,"function iSubject = db_edit_subject(varargin)


iSubject  = [];

ProtocolInfo = bst_get('ProtocolInfo');
ProtocolSubjects = bst_get('ProtocolSubjects');
if isempty(ProtocolSubjects)
    error('No selected protocol'); 
end
nbSubjects = length(ProtocolSubjects.Subject);
if (nargin == 0)
    iSubjectsList = nbSubjects + 1;
elseif (nargin == 1)
    iSubjectsList = varargin{1};
    if (iSubjectsList <= 0)
        error('Subject #%d does not exist.', iSubjectsList);
    end
else
    error('Usage : db_edit_subject([iSubject])');
end


panelSubjectEditor = panel_subject_editor('CreatePanel');
ctrl = get(panelSubjectEditor, 'sControls');

java_setcb(ctrl.jButtonSave, 'ActionPerformedCallback', @updateSubjectModifications);
panelContainer = gui_show(panelSubjectEditor, 'JavaWindow', 'Edit subject', [], 1, 0, 0);

iSubject = iSubjectsList(1);
UpdatePanel();



    function UpdatePanel()
        nbSubjects = bst_get('SubjectCount');
        isNewSubject = (iSubject > nbSubjects);
        sDefaultSubject = bst_get('Subject', 0);
        
        if ~isNewSubject
            panelTitle = sprintf('Edit subject #%d',iSubject);
            sSubject = bst_get('Subject', iSubject, 1);
        else
            panelTitle = sprintf('Create subject #%d',iSubject);
            sSubject = db_template('Subject');
            sSubject.Name     = sprintf('Subject%02d', iSubject);
            sSubject.FileName = bst_fullfile(sprintf('Subject%02d', iSubject), 'brainstormsubject.mat');
            sSubject.UseDefaultAnat    = ProtocolInfo.UseDefaultAnat;
            sSubject.UseDefaultChannel = ProtocolInfo.UseDefaultChannel;
        end

        panelContainer.handle{1}.setTitle(panelTitle);
        ctrl.jTextSubjectName.setText(sSubject.Name);
        ctrl.jTextSubjectComments.setText(sSubject.Comments);
        if (~isfield(sSubject, 'UseDefaultAnat') || ~sSubject.UseDefaultAnat) || isempty(sDefaultSubject)
            ctrl.jRadioAnatomyIndividual.setSelected(1);
        else
            ctrl.jRadioAnatomyDefault.setSelected(1);
        end
        if (~isfield(sSubject, 'UseDefaultChannel') || (sSubject.UseDefaultChannel == 0))
            ctrl.jRadioChannelIndividual.setSelected(1);
        elseif (sSubject.UseDefaultChannel == 1)
            ctrl.jRadioChannelDefaultSubject.setSelected(1);
        elseif (sSubject.UseDefaultChannel == 2)
            ctrl.jRadioChannelDefaultGlobal.setSelected(1);
        end

        if isempty(sDefaultSubject)
            ctrl.jRadioAnatomyDefault.setEnabled(0);
        end
    end

        
    function updateSubjectModifications(varargin)       
        nbSubjects = bst_get('SubjectCount');
        isNewSubject = (iSubject > nbSubjects);
        if isNewSubject
            sSubject = db_template('Subject');
        else
            sOldSubject = bst_get('Subject', iSubject);
            sSubject = sOldSubject;
        end
        sSubject.Name     = char(ctrl.jTextSubjectName.getText());
        sSubject.FileName = [sSubject.Name, '/brainstormsubject.mat'];
        sSubject.Comments = char(ctrl.jTextSubjectComments.getText());
        sSubject.UseDefaultAnat = ctrl.jRadioAnatomyDefault.isSelected();
        if ctrl.jRadioChannelIndividual.isSelected()
            sSubject.UseDefaultChannel = 0;
        elseif ctrl.jRadioChannelDefaultSubject.isSelected()
            sSubject.UseDefaultChannel = 1;
        elseif ctrl.jRadioChannelDefaultGlobal.isSelected()
            sSubject.UseDefaultChannel = 2;
        end
        
        if isempty(sSubject.Name)
            bst_error('You must specify a subject name.', 'Subject editor', 0);
            return
        end
        stdName = file_standardize(sSubject.Name);
        if ~strcmpi(stdName, sSubject.Name)
            ctrl.jTextSubjectName.setText(stdName);
            return
        end
        if ~isNewSubject && ~strcmpi(sOldSubject.Name, sSubject.Name) && file_exist(bst_fullfile(ProtocolInfo.SUBJECTS, sSubject.Name))
            bst_error(['Subject ""' sSubject.Name '"" already exists.'], 'Subject editor', 0);
            return
        end

        gui_hide('panel_subject_editor');
        
        if isNewSubject
            sSubject = db_add_subject(sSubject, iSubject);
            if isempty(sSubject)
                bst_error('Subject could not be created.', 'Subject editor', 0);
                return
            end
        else
            iOldChannelStudies = bst_get('ChannelStudiesWithSubject', iSubject, 'NoIntra');
            if (sOldSubject.UseDefaultChannel < sSubject.UseDefaultChannel) && (length(iOldChannelStudies) > 1)
                isOk = java_dialog('confirm', ...
                    ['Grouping several channel files into one requires a co-registration of the runs or subjects.' 10 ...
                     'This is done by calling the process ""Co-register MEG runs"".' 10 10 ...
                     'Apply this co-registration now?'], 'Edit subject');
                if isOk 
                    RegisterMegRuns(iOldChannelStudies);
                end
            end
            if ~strcmpi(sOldSubject.Name, sSubject.Name)
                db_rename_subject(sOldSubject.Name, sSubject.Name);
                [sOldSubject, iSubject] = bst_get('Subject', sSubject.Name);
            end
            sSubject = db_add_subject(sSubject, iSubject);
            if (sSubject.UseDefaultChannel ~= sOldSubject.UseDefaultChannel)
                iNewChannelStudies = bst_get('ChannelStudiesWithSubject', iSubject);
                UpdateSubjectChannelFiles(sOldSubject.UseDefaultChannel, iOldChannelStudies, sSubject.UseDefaultChannel, iNewChannelStudies);
                db_links('Subject', iSubject);
            end
        end
        
        bst_memory('UnloadAll', 'Forced');
        db_reload_subjects(iSubject);
        panel_protocols('UpdateTree');
        db_save();
    end        
end


function UpdateSubjectChannelFiles(oldStat, iOldChanStudy, newStat, iNewChanStudy)
    if (oldStat > newStat) 
        sSourceStudy = bst_get('Study', iOldChanStudy);
        sNewChanStudy = bst_get('Study', iNewChanStudy);
        if isempty(sSourceStudy.Channel)
            return
        end
        for i = 1:length(iNewChanStudy)
            if isempty(sNewChanStudy(i).Data) && isempty(sNewChanStudy(i).Result) && isempty(sNewChanStudy(i).Stat) && isempty(sNewChanStudy(i).Timefreq) && isempty(sNewChanStudy(i).Matrix)
                continue;
            end
            db_set_channel(iNewChanStudy(i), sSourceStudy.Channel(1).FileName, 0, 0);
        end
        
    else
        bst_progress('start', 'Setting channel files...', 'Subject editor');
        allChannelFiles = {};
        for i = 1:length(iOldChanStudy)
            sStudy = bst_get('Study', iOldChanStudy(i));
            if ~isempty(sStudy.Channel) && ~isempty(sStudy.Channel.FileName)
                allChannelFiles{end+1} = sStudy.Channel.FileName;
            end
        end
        if (length(allChannelFiles) >= 1)
            db_set_channel(iNewChanStudy, allChannelFiles{1}, 0, 0);
        end
        bst_progress('stop');
    end
end


function RegisterMegRuns(iChanStudies)
    allChannelFiles = {};
    for i = 1:length(iChanStudies)
        sStudy = bst_get('Study', iChanStudies(i));
        if ~isempty(sStudy.Channel) && ~isempty(sStudy.Channel.FileName)
            allChannelFiles{end+1} = sStudy.Channel.FileName;
        end
    end
    if (length(allChannelFiles) > 1)
        allDataFiles = {};
        for i = 1:length(allChannelFiles)
            tmp = bst_get('DataForChannelFile', allChannelFiles{i});
            if ~isempty(allChannelFiles)
                allDataFiles = cat(2, allDataFiles, tmp);
            end
        end
        if ~isempty(allDataFiles)
            disp('BST> Applying process_megreg to the data, this will most likely alter the recordings.');
            bst_process('CallProcess', 'process_megreg', allDataFiles, [], 'targetchan', 1, 'sharechan', 2);
        end
    end
end"
4758,db_fix_protocol.m,78.244,80,59.33,100,100.0,51.89,70-80,"function [isError, isFixed] = db_fix_protocol()



isProgressBar = ~bst_progress('isVisible');
if isProgressBar
    bst_progress('start', 'db_fix_database', 'Fixing database errors...');
else
    bst_progress('text', 'Fixing database errors...');
end
isError = 0;
isFixed = 1;
ProtocolInfo     = bst_get('ProtocolInfo');
ProtocolSubjects = bst_get('ProtocolSubjects');
ProtocolStudies  = bst_get('ProtocolStudies');
if ~file_exist(ProtocolInfo.SUBJECTS)
    error(['Anatomy directory does not exist and can''t be created: ""', ProtocolInfo.SUBJECTS '"".']);
    isError = 1;
end
if ~file_exist(ProtocolInfo.STUDIES)
    error(['Data directory does not exist and cannot be created: ""', ProtocolInfo.STUDIES '"".']);
    isError = 1;
end


missingSubj = {};
allSubj = {};
defSubjDir = bst_fullfile(ProtocolInfo.SUBJECTS, bst_get('DirDefaultSubject'));
if ~file_exist(defSubjDir) || ~file_exist(bst_fullfile(defSubjDir, 'brainstormsubject.mat'))
    missingSubj{end+1} = bst_get('DirDefaultSubject');
end
for iSubj = 1:length(ProtocolSubjects.Subject)
    allSubj{end+1} = bst_fileparts(ProtocolSubjects.Subject(iSubj).FileName);
    if ~file_exist(bst_fullfile(ProtocolInfo.SUBJECTS, ProtocolSubjects.Subject(iSubj).FileName))
        missingSubj{end+1} = allSubj{end};
    end
end
listSubjFile = unique({ProtocolStudies.Study.BrainStormSubject});
for iSubj = 1:length(listSubjFile)
    SubjName = bst_fileparts(listSubjFile{iSubj});
    if strcmpi(SubjName, bst_get('DirDefaultSubject'))
        continue;
    end
    allSubj{end+1} = SubjName;
    if ~file_exist(bst_fullfile(ProtocolInfo.SUBJECTS, listSubjFile{iSubj}))
        missingSubj{end+1} = SubjName;
    end
end
listStudyFile = unique({ProtocolStudies.Study.FileName});
for iStudy = 1:length(listStudyFile)
    SubjName = bst_fileparts(bst_fileparts(listStudyFile{iStudy}), 1);
    if strcmpi(SubjName, bst_get('DirDefaultSubject'))
        continue;
    end
    allSubj{end+1} = SubjName;
    if ~file_exist(bst_fullfile(ProtocolInfo.SUBJECTS, allSubj{end}))
        missingSubj{end+1} = SubjName;
    end
end
listFolders = dir(ProtocolInfo.STUDIES);
for iDir = 1:length(listFolders)
    if ~listFolders(iDir).isdir || (listFolders(iDir).name(1) == '.') || ismember(listFolders(iDir).name, {bst_get('DirDefaultSubject'), bst_get('DirDefaultStudy'), bst_get('DirAnalysisInter')})
        continue;
    end
    allSubj{end+1} = listFolders(iDir).name;
    if ~file_exist(bst_fullfile(ProtocolInfo.SUBJECTS, listFolders(iDir).name))
        missingSubj{end+1} = allSubj{end};
    end
end
strrep(allSubj, '/', '');
strrep(allSubj, '\\', '');
allSubj = unique(allSubj);
if ~isempty(missingSubj)
    strrep(missingSubj, '/', '');
    strrep(missingSubj, '\\', '');
    missingSubj = unique(missingSubj);
    isError = 1;
end

for iSubj = 1:length(missingSubj)
    disp(['DB_FIX> Missing subject: ""' missingSubj{iSubj} '""...']);
    
    if strcmpi(missingSubj{iSubj}, bst_get('DirDefaultSubject'))
        res = java_dialog('question', ['Subject ""' missingSubj{iSubj} '"" is missing in the database.' 10 'Create the missing files and folders in the anatomy folder?'], ...
                          'Database error', [], {'Yes', 'No', 'Cancel'}, 'Cancel');
        switch (res)
            case 'Yes',    % Nothing to do
            case 'No',     isFixed = 0;  continue;
            case 'Cancel', return;
        end
        subjDir = bst_fullfile(ProtocolInfo.SUBJECTS, missingSubj{iSubj});
        if ~file_exist(subjDir)
            try
                isCreated = mkdir(subjDir);
            catch
                isCreated = 0;
            end
            if ~isCreated
                disp(['DB_FIX> Error: cannot create folder ""' missingSubj{iSubj} '"".']);
                isFixed = 0;
                continue
            end
        end
        subjFile = bst_fullfile(subjDir, 'brainstormsubject.mat');
        if ~file_exist(subjFile)
            SubjectMat = db_template('subjectmat');
            if strcmpi(missingSubj{iSubj}, bst_get('DirDefaultSubject')) || isempty(ProtocolInfo.UseDefaultAnat)
                SubjectMat.UseDefaultAnat    = 1;
                SubjectMat.UseDefaultChannel = 1;
            else
                SubjectMat.UseDefaultAnat    = ProtocolInfo.UseDefaultAnat;
                SubjectMat.UseDefaultChannel = ProtocolInfo.UseDefaultChannel;
            end
            try
                bst_save(subjFile, SubjectMat, 'v7');
            catch
                disp(['DB_FIX> Error: Could not create subject file ""' subjFile '"". Ignoring subject...']);
                isFixed = 0;
            end
        end
    else
        [sSubjectRm, iSubjectRm] = bst_get('Subject', missingSubj{iSubj});
        if ~isempty(iSubjectRm)
            SubjectFile = ProtocolSubjects.Subject(iSubjectRm).FileName;
            ProtocolSubjects.Subject(iSubjectRm) = [];
            bst_set('ProtocolSubjects', ProtocolSubjects);
        else
            SubjectFile = bst_fullfile(missingSubj{iSubj}, 'brainstormsubject.mat');
        end
        iStudiesRm = find(file_compare(SubjectFile, {ProtocolStudies.Study.BrainStormSubject}));
        if ~isempty(iStudiesRm)
            ProtocolStudies.Study(iStudiesRm) = [];
            bst_set('ProtocolStudies', ProtocolStudies);
        end 
        allSubj = setdiff(allSubj, missingSubj{iSubj});
    end
end


missingStudy = {};
defStudyFile = bst_fullfile(bst_get('DirDefaultStudy'), 'brainstormstudy.mat');
if ~file_exist(bst_fullfile(ProtocolInfo.STUDIES, defStudyFile))
    missingStudy{end+1} = defStudyFile;
end
interStudyFile = bst_fullfile(bst_get('DirAnalysisInter'), 'brainstormstudy.mat');
if ~file_exist(bst_fullfile(ProtocolInfo.STUDIES, interStudyFile))
    missingStudy{end+1} = interStudyFile;
end
for iSubj = 1:length(allSubj)
    defStudyFile = bst_fullfile(allSubj{iSubj}, bst_get('DirDefaultStudy'), 'brainstormstudy.mat');
    if ~file_exist(bst_fullfile(ProtocolInfo.STUDIES, defStudyFile))
        missingStudy{end+1} = defStudyFile;
    end
    intraStudyFile = bst_fullfile(allSubj{iSubj}, bst_get('DirAnalysisIntra'), 'brainstormstudy.mat');
    if ~file_exist(bst_fullfile(ProtocolInfo.STUDIES, intraStudyFile))
        missingStudy{end+1} = intraStudyFile;
    end
end
if ~isempty(missingStudy)
    isError = 1;
end

for iStudy = 1:length(missingStudy)
    disp(['DB_FIX> Missing folder ""' bst_fileparts(missingStudy{iStudy}) '"". Fixing...']);
    res = java_dialog('question', ['Folder ""' bst_fileparts(missingStudy{iStudy}) '"" is missing in the database.' 10 'Create the missing files and folders in the data folder?'], ...
                      'Database error', [], {'Yes', 'No', 'Cancel'}, 'Cancel');
    switch (res)
        case 'Yes',    % Nothing to do
        case 'No',     isFixed = 0; continue;
        case 'Cancel', return;
    end
    studyDir = bst_fullfile(ProtocolInfo.STUDIES, bst_fileparts(missingStudy{iStudy}));
    if ~file_exist(studyDir)
        try
            isCreated = mkdir(studyDir);
        catch
            isCreated = 0;
        end
        if ~isCreated
            disp(['DB_FIX> Error: cannot create folder ""' studyDir '"".']);
            isFixed = 0;
            continue
        end
    end
    studyFile = bst_fullfile(studyDir, 'brainstormstudy.mat');
    if ~file_exist(studyFile)
        [SubjectName, ConditionName] = bst_fileparts(bst_fileparts(missingStudy{iStudy}, 1), 1);
        StudyMat = db_template('studymat');
        StudyMat.Name = ConditionName;
        try
            bst_save(studyFile, StudyMat, 'v7');
        catch
            disp(['DB_FIX> Error: Could not create study file ""' studyFile '"". Ignoring subject...']);
            isFixed = 0;
        end
    end
end


if isProgressBar
    bst_progress('stop');
end
if isError
    if isFixed
        disp(['DB_FIX> There were errors in protocol ""' ProtocolInfo.Comment '"". You should reload the database...']);
    else
        disp(['DB_FIX> Error: There were errors in protocol ""' ProtocolInfo.Comment '"" that could not be fixed.']);
    end
end"
4759,db_gt.m,75.796,80,61.06,90,100.0,47.92,70-80,"function [ground_truth, gt_set, im, anns] = db_gt( database, image_id )

    if strcmp(database,'Pascal') 
        gt_object = imread(fullfile(db_root_dir(database), 'SegmentationObject', [image_id '.png']));
        gt_class  = imread(fullfile(db_root_dir(database), 'SegmentationClass', [image_id '.png']));
        
        obj_ids   = unique(gt_object);
        obj_ids(obj_ids==0) = [];
        obj_ids(obj_ids==255) = [];
        for ii=1:length(obj_ids)
            ground_truth.masks{ii}    = (gt_object==obj_ids(ii));
            ground_truth.category(ii) = gt_class(find(ground_truth.masks{ii}==1,1,'first'));
            ground_truth.obj_id(ii)   = ii;
            ground_truth.im_id{ii}    = image_id;
        end
        
        ground_truth.valid_pixels = (gt_object<255);
        
    elseif strcmp(database,'SBD')
        gt = loadvar(fullfile(db_root_dir(database), 'inst', [image_id '.mat']),'GTinst');
        n_objs = length(gt.Boundaries);
        for ii=1:n_objs
            ground_truth.masks{ii}    = (gt.Segmentation==ii);
            ground_truth.category(ii) = gt.Categories(ii);
            ground_truth.obj_id(ii)   = ii;
            ground_truth.im_id{ii}    = image_id;
        end
        
        ground_truth.valid_pixels = (gt.Segmentation<255);
    elseif strcmp(database,'COCO')
        
        folds = dir(fullfile(db_root_dir(database),'images'));
        gt_set = '';
        for ii=1:length(folds)
            if (folds(ii).isdir && folds(ii).name(1)~='.')
                if exist(fullfile(db_root_dir(database), 'images', folds(ii).name, [image_id '.jpg']),'file')
                    gt_set = folds(ii).name;
                    break;
                end
            end
        end
        if strcmp(gt_set,'')
            error(['Image not found: ' image_id ' in ' db_root_dir(database)]);
        end
        
        im = imread(fullfile(db_root_dir(database), 'images', gt_set, [image_id '.jpg']));
        
        
        annFile = fullfile(db_root_dir('COCO'),'annotations',['instances_' gt_set '.json']);
        if ~evalin('base',['exist(''coco_' gt_set ''',''var'')'])
            disp(['Loading ' annFile])
            evalin('base',['coco_' gt_set '=CocoApi(''' annFile ''');']);
        end
        coco = evalin('base', ['coco_' gt_set]);
        
        undersc = strfind(image_id,'_');
        assert(length(undersc)==2);
        im_id  = str2double(image_id(undersc(2)+1:end));
        annIds = coco.getAnnIds('imgIds',im_id,'iscrowd',0);
        anns   = coco.loadAnns(annIds);
        
        for ii=1:length(anns)
            ground_truth.masks{ii} = MaskApi.decode(MaskApi.frPoly(anns(ii).segmentation,size(im,1),size(im,2)))>0;
            ground_truth.boxes{ii} = round([anns(ii).bbox(2) anns(ii).bbox(1) anns(ii).bbox(2)+anns(ii).bbox(4) anns(ii).bbox(1)+anns(ii).bbox(3)]);
            ground_truth.boxes{ii}(ground_truth.boxes{ii}<=0) = 1;
            if(ground_truth.boxes{ii}(3)>size(im,1))
                ground_truth.boxes{ii}(3) = size(im,1);
            end
            if(ground_truth.boxes{ii}(4)>size(im,2))
                ground_truth.boxes{ii}(4) = size(im,2);
            end
            ground_truth.category(ii) = anns(ii).category_id;
            ground_truth.obj_id(ii)   = anns(ii).id;
            ground_truth.im_id{ii}    = image_id;
        end
        
        if ~exist('ground_truth','var')
            ground_truth.masks    = {};
            ground_truth.boxes    = {};
            ground_truth.category = [];
            ground_truth.obj_id   = [];
            ground_truth.im_id    = {};
        end
        
        ground_truth.valid_pixels = true(size(im,1),size(im,2));
        
    elseif strcmp(database,'bsds_object_gt')
        
        gt_object = loadvar(fullfile(db_root_dir(database), 'groundTruth', [image_id '_gt.mat']),'objmask');
        
        obj_ids   = unique(gt_object);
        obj_ids(obj_ids==0) = [];
        for ii=1:length(obj_ids)
            ground_truth.masks{ii} = (gt_object==obj_ids(ii));
            ground_truth.category(ii) = 1;
            ground_truth.obj_id(ii)   = ii;
            ground_truth.im_id{ii}    = image_id;
        end
        
        if isempty(obj_ids)
            ground_truth.masks = {};
            ground_truth.boxes    = {};
            ground_truth.category = [];
            ground_truth.obj_id   = [];
            ground_truth.im_id    = [];
        end
        
        ground_truth.valid_pixels = (gt_object<255);
        
    else
        error(['Ground truth not implemented for: ' database]);
    end
end"
