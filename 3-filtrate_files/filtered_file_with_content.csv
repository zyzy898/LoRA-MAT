function drawAnalysis(~,~,handles)
a = str2double(get(handles.alpha,'String'));
b1 = str2double(get(handles.beta1,'String'));
l = str2double(get(handles.lambda,'String'));
m1 = str2double(get(handles.mu1,'String'));
