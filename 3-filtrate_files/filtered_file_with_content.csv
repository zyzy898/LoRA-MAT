    xlabel(label_xAxis)
    dcm = datacursormode(fig_cov_para);
    datacursormode on
    set(dcm, 'updatefcn', @vis_customdatatip_h)
    
elseif DecoupledClockModel
    subplot(n,1,2);
    leg_txt_clk = {}; i = 1;
