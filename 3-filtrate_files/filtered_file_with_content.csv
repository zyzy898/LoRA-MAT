        ibandpass=ibandpass+1;
        ibandpass(ibandpass<1)=1; ibandpass(ibandpass>N)=N;    
    
        featCOH(n,p)=nanmean(coh(p,ibandpass));
        [crap,imax]=max(coh(p,ibandpass));
        featMAX(n,p)=fp(ibandpass(imax));
    end
end
