4945,DeDvKalman.m,74.856,100,68.57,60,100.0,45.71,70-80,"function [pos vel] = DeDvKalman(z)
persistent A H Q R 
persistent x P
persistent firstRun


if isempty(firstRun)
  firstRun = 1;
  
  dt = 0.1;
  
  A = [ 1 dt;
        0 1  ];
  H = [1 0];
  
  Q = [ 1 0;
        0 3 ];
  R = 10;

  x = [ 0 20 ]';
  P = 5*eye(2);
end


xp = A*x;  
Pp = A*P*A' + Q;    

K = 1 / (Pp(1,1) + R) * [Pp(1,1) Pp(2,1)]';  % Pp*H'*inv(H*Pp*H' + R);

x = xp + K*(z - H*xp);
P = Pp - K*H*Pp;   
  
 
pos = x(1);
vel = x(2);"
