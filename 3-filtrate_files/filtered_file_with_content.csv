6291,demoGeom3d.m,65.676,100,62.9,30,100.0,35.48,61-70,"function demoGeom3d(varargin)




p1 = [10 20 30];
p2 = [80 10 20];
p3 = [20 50 10];

points = [p1;p2;p3];

line12 = createLine3d(p1, p2);

edge13 = [p1 p3];

