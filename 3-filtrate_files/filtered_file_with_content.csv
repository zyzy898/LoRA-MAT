1845,compareAgents.m,76.45,80,55.7,100,100.0,46.55,70-80,"function [reachSets,Reward,RewardAdvNaive,RewardAdvGrad] = compareAgents(agents,env,pertubation,stateLabels,initialOps)



numAgents = length(agents);

saveBool = true;
