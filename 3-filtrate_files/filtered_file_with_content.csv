4641,data_argument.m,74.0,100,64.0,60,100.0,46.0,70-80,"clear;
clc;

ori_root = './train_argu/';
ori_images = dir(fullfile(ori_root,'*.jpg'));
ori_gts = dir(fullfile(ori_root,'*.png'));

save_path = './train_argu/';

for i=1: length(ori_images)
    i
    ro_degree = 0; %rand(1,1)*360-180;
    
    w_e = rand(1,1)-0.3;
    h_e = rand(1,1)-0.3;
    
    
    nn = ori_images(i).name;
    
    if strcmp(nn(1),'d') || strcmp(nn(1),'e')
        continue;
    end
    
    image = imread([ori_root ori_images(i).name]);
    gt = imread([ori_root ori_gts(i).name]);
    
    [h,w,~]=size(image);
    
    
    new_im = imrotate(image,ro_degree);
    new_gt = imrotate(gt,ro_degree);
    [new_h,new_w,~]=size(new_im);
    
    if (ro_degree<=45 && ro_degree>=-45) || (ro_degree>=135 && ro_degree<=-135)
        f_new_im = new_im(max(new_h/2-h/2,1):min(h/2+new_h/2,size(new_im,1)),max(new_w/2-w/2,1):min(w/2+new_w/2,size(new_im,2)),:);
        f_new_gt = new_gt(max(new_h/2-h/2,1):min(h/2+new_h/2,size(new_im,1)),max(new_w/2-w/2,1):min(w/2+new_w/2,size(new_im,2)),:);
    else
        f_new_im = new_im(max(new_w/2-w/2,1):min(w/2+new_w/2,size(new_im,1)),max(new_h/2-h/2,1):min(h/2+new_h/2,size(new_im,2)),:);
        f_new_gt = new_gt(max(new_w/2-w/2,1):min(w/2+new_w/2,size(new_im,1)),max(new_h/2-h/2,1):min(h/2+new_h/2,size(new_im,2)),:);
    end
   

    f_new_im = imresize(f_new_im, [h*(1+h_e), w*(1+w_e)]);
    f_new_gt = imresize(f_new_gt, [h*(1+h_e), w*(1+w_e)]);
    
    
    imwrite(f_new_im,[save_path 'f_' ori_images(i).name]);
    imwrite(f_new_gt,[save_path 'f_' ori_gts(i).name]);
    
end"
4642,data_aug.m,76.864,100,70.27,60,100.0,54.05,70-80,"clear; 
folder = '291/';
savepath = '291-aug/';
filepaths_91 = dir(fullfile(folder,'*.bmp'));
filepaths_200 = dir(fullfile(folder,'*.jpg'));
filepaths = cat(1,filepaths_91,filepaths_200);
if ~exist(savepath,'file')
    mkdir(savepath);
end

for i = 1 : length(filepaths)
    filename = filepaths(i).name;
    [add, im_name, type] = fileparts(filepaths(i).name);  %add is path, im_name is filename, and type is extention name
    image = imread(fullfile(folder, filename));
    
    count = 0;
    
    for angle = 0: 90 :270
        
        im_rot = imrotate(image, angle);
        
        for scale = 1.0 : -0.1 : 0.6
            im_down = imresize(im_rot, scale, 'bicubic');

            for j = 3 : -2 : 1  % 3--> not flip, 1-->flip horizontally
                if j == 3
                    im_flip = im_down;
                else
                    im_flip = flip(im_down, j);
                end
                imwrite(im_flip, [savepath im_name, '_' num2str(count) '.bmp']);
                count = count + 1;
            end

        end
    end  
end"
