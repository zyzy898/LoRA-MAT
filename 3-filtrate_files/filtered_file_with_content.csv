end
end"
5085,deletewithsemaphores.m,79.166,60,75.0,90,100.0,70.83,70-80,"function deletewithsemaphores(fileList)

checkWaitTime = 0.1;
nrOfAttempts  = 10;

showWarnings  = 0;

if ischar(fileList)
  fileList = {fileList};
end

for fileNr = 1:length(fileList)
  sem = setfilesemaphore(fileList{fileNr});
  for attemptNr = 1:nrOfAttempts
    throwError = 0;
    showWarningsNow = showWarnings && (attemptNr == nrOfAttempts); % only in last attempt
    if mbdelete(fileList{fileNr}, showWarningsNow, throwError)
      break
    else
      pause(checkWaitTime);
    end
  end
  removefilesemaphore(sem);
end"
