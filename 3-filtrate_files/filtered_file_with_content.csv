obs_old_qzss = Epoch.old.obs(Epoch.old.qzss, :);

w1_now_gps = Epoch.l1(Epoch.gps);
w1_old_gps = Epoch.old.l1(Epoch.old.gps);
w2_now_gps = Epoch.l2(Epoch.gps);
w2_old_gps = Epoch.old.l2(Epoch.old.gps);
w3_now_gps = Epoch.l3(Epoch.gps);
w3_old_gps = Epoch.old.l3(Epoch.old.gps);
w1_now_glo = Epoch.l1(Epoch.glo);
w1_old_glo = Epoch.old.l1(Epoch.old.glo);
w2_now_glo = Epoch.l2(Epoch.glo);
w2_old_glo = Epoch.old.l2(Epoch.old.glo);
w3_now_glo = Epoch.l3(Epoch.glo);
w3_old_glo = Epoch.old.l3(Epoch.old.glo);
w1_now_gal = Epoch.l1(Epoch.gal);
w1_old_gal = Epoch.old.l1(Epoch.old.gal);
w2_now_gal = Epoch.l2(Epoch.gal);
w2_old_gal = Epoch.old.l2(Epoch.old.gal);
w3_now_gal = Epoch.l3(Epoch.gal);
w3_old_gal = Epoch.old.l3(Epoch.old.gal);
w1_now_bds = Epoch.l1(Epoch.bds);
w1_old_bds = Epoch.old.l1(Epoch.old.bds);
w2_now_bds = Epoch.l2(Epoch.bds);
w2_old_bds = Epoch.old.l2(Epoch.old.bds);
w3_now_bds = Epoch.l3(Epoch.bds);
w3_old_bds = Epoch.old.l3(Epoch.old.bds);
w1_now_qzss = Epoch.l1(Epoch.qzss);
w1_old_qzss = Epoch.old.l1(Epoch.old.qzss);
w2_now_qzss = Epoch.l2(Epoch.qzss);
w2_old_qzss = Epoch.old.l2(Epoch.old.qzss);
w3_now_qzss = Epoch.l3(Epoch.qzss);
w3_old_qzss = Epoch.old.l3(Epoch.old.qzss);

if settings.INPUT.rawDataAndroid
    w1_now_gps(:)=1; w1_old_gps(:)=1; w2_now_gps(:)=1; w2_old_gps(:)=1; w3_now_gps(:)=1; w3_old_gps(:)=1;
    w1_now_glo(:)=1; w1_old_glo(:)=1; w2_now_glo(:)=1; w2_old_glo(:)=1; w3_now_glo(:)=1; w3_old_glo(:)=1;
    w1_now_gal(:)=1; w1_old_gal(:)=1; w2_now_gal(:)=1; w2_old_gal(:)=1; w3_now_gal(:)=1; w3_old_gal(:)=1;
    w1_now_bds(:)=1; w1_old_bds(:)=1; w2_now_bds(:)=1; w2_old_bds(:)=1; w3_now_bds(:)=1; w3_old_bds(:)=1;
    w1_now_qzss(:)=1; w1_old_qzss(:)=1; w2_now_qzss(:)=1; w2_old_qzss(:)=1; w3_now_qzss(:)=1; w3_old_qzss(:)=1;
end

[L1_now, L1_old] = getPhase(obs_now_gps, obs_old_gps, obs_now_glo, obs_old_glo, obs_now_gal, obs_old_gal, obs_now_bds, obs_old_bds, obs_now_qzss, obs_old_qzss, l1_gps, l1_glo, l1_gal, l1_bds, l1_qzss, gps_now, gps_old, glo_now, glo_old, gal_now, gal_old, bds_now, bds_old, qzss_now, qzss_old, w1_now_gps, w1_old_gps, w1_now_glo, w1_old_glo, w1_now_gal, w1_old_gal, w1_now_bds, w1_old_bds, w1_now_qzss, w1_old_qzss);
[L2_now, L2_old] = getPhase(obs_now_gps, obs_old_gps, obs_now_glo, obs_old_glo, obs_now_gal, obs_old_gal, obs_now_bds, obs_old_bds, obs_now_qzss, obs_old_qzss, l2_gps, l2_glo, l2_gal, l2_bds, l2_qzss, gps_now, gps_old, glo_now, glo_old, gal_now, gal_old, bds_now, bds_old, qzss_now, qzss_old, w2_now_gps, w2_old_gps, w2_now_glo, w2_old_glo, w2_now_gal, w2_old_gal, w2_now_bds, w2_old_bds, w2_now_qzss, w2_old_qzss);
[L3_now, L3_old] = getPhase(obs_now_gps, obs_old_gps, obs_now_glo, obs_old_glo, obs_now_gal, obs_old_gal, obs_now_bds, obs_old_bds, obs_now_qzss, obs_old_qzss, l3_gps, l3_glo, l3_gal, l3_bds, l3_qzss, gps_now, gps_old, glo_now, glo_old, gal_now, gal_old, bds_now, bds_old, qzss_now, qzss_old, w3_now_gps, w3_old_gps, w3_now_glo, w3_old_glo, w3_now_gal, w3_old_gal, w3_now_bds, w3_old_bds, w3_now_qzss, w3_old_qzss);



dL1 = (L1_now - L1_old);    % difference L1 current epoch - last epoch [m]
dL2 = (L2_now - L2_old);    % difference L2 current epoch - last epoch [m]
dL3 = (L3_now - L3_old);    % difference L3 current epoch - last epoch [m]

diff_12 = abs(dL1 - dL2);
diff_13 = abs(dL1 - dL3);
diff_23 = abs(dL2 - dL3);

diff_12(Epoch.tracked <= 1) = 0;
diff_13(Epoch.tracked <= 1) = 0;
diff_23(Epoch.tracked <= 1) = 0;

diff_12 = diff_12(Epoch.sats);
diff_13 = diff_13(Epoch.sats);
diff_23 = diff_23(Epoch.sats);

Epoch.cs_dL1dL2 = dL1 - dL2;        
Epoch.cs_dL1dL3 = dL1 - dL3;
Epoch.cs_dL2dL3 = dL2 - dL3;
Epoch.cs_dL1dL2(isnan(Epoch.cs_dL1dL2)) = 0;
Epoch.cs_dL1dL3(isnan(Epoch.cs_dL1dL3)) = 0;
Epoch.cs_dL2dL3(isnan(Epoch.cs_dL2dL3)) = 0;

cs_found_12 = diff_12 > thresh;            % exceeds dL1 - dL2 threshold?
cs_found_13 = diff_13 > thresh;
cs_found_23 = diff_23 > thresh;

cs_found_12(isnan(diff_12)) = true;
cs_found_13(isnan(diff_13)) = true;
cs_found_23(isnan(diff_23)) = true;

new_cs = cs_found_12';      % e.g. IF LC
if num_freq == 2
    new_cs = [cs_found_12', cs_found_12'];
elseif num_freq == 3
    cs_found_L1 = cs_found_12 & cs_found_13 & (~isnan(diff_12) | ~isnan(diff_13));
    cs_found_L2 = cs_found_12 & cs_found_23 & (~isnan(diff_12) | ~isnan(diff_23));
    cs_found_L3 = cs_found_13 & cs_found_23 & (~isnan(diff_13) | ~isnan(diff_23));
    new_cs = [cs_found_L1', cs_found_L2', cs_found_L3'];
end

if any(any(new_cs))
    Epoch.cs_found = Epoch.cs_found | new_cs;
end

end



function [L_now, L_old] = ...
    getPhase(obs_now_gps, obs_old_gps, obs_now_glo, obs_old_glo, obs_now_gal, obs_old_gal, obs_now_bds, obs_old_bds, obs_now_qzss, obs_old_qzss, ...
    l_gps, l_glo, l_gal, l_bds, l_qzss, ...
    gps_now, gps_old, glo_now, glo_old, gal_now, gal_old, bds_now, bds_old, qzss_now, qzss_old, ...
    w_now_gps, w_old_gps, w_now_glo, w_old_glo, w_now_gal, w_old_gal, w_now_bds, w_old_bds, w_now_qzss, w_old_qzss)

L_old = NaN(1,410);   L_now = NaN(1,410);
if ~isempty(l_gps)
    L_now(gps_now) = obs_now_gps(:,l_gps) .* w_now_gps;     % Phase-observations of current epoch [m]
    L_old(gps_old) = obs_old_gps(:,l_gps) .* w_old_gps; 	% Phase-observations of last epoch [m]
end
if ~isempty(l_glo)
    L_now(glo_now) = obs_now_glo(:,l_glo) .* w_now_glo;     % Phase-observations of current epoch [m]
    L_old(glo_old) = obs_old_glo(:,l_glo) .* w_old_glo;     % Phase-observations of last epoch [m]
end
if ~isempty(l_gal)
    L_now(gal_now) = obs_now_gal(:,l_gal) .* w_now_gal;     % Phase-observations of current epoch [m]
    L_old(gal_old) = obs_old_gal(:,l_gal) .* w_old_gal;     % Phase-observations of last epoch [m]
end
if ~isempty(l_bds)
    L_now(bds_now) = obs_now_bds(:,l_bds) .* w_now_bds;     % Phase-observations of current epoch [m]
    L_old(bds_old) = obs_old_bds(:,l_bds) .* w_old_bds;     % Phase-observations of last epoch [m]
end
if ~isempty(l_qzss)
    L_now(qzss_now) = obs_now_qzss(:,l_qzss) .* w_now_qzss;     % Phase-observations of current epoch [m]
    L_old(qzss_old) = obs_old_qzss(:,l_qzss) .* w_old_qzss;     % Phase-observations of last epoch [m]
end
L_old(L_old == 0) = NaN;
L_now(L_now == 0) = NaN;
end


function [] = printCSinfo(bool_cs, Epoch, diff1, diff2, frq, str1, str2)
prns = Epoch.sats(bool_cs);
values_1 = diff1(bool_cs);
values_2 = diff2(bool_cs);
for ii = 1:length(prns)
    fprintf('Cycle-Slip found on %s in epoch: %d, sat %03.0f, %s: %06.3f[m], %s: %06.3f[m]            \\n', ...
        frq, Epoch.q, prns(ii), str1, values_1(ii), str2, values_2(ii));
end
end"
4502,cycle_graph.m,72.696,60,78.26,60,100.0,65.22,70-80,"function [A xy] = cycle_graph(n,varargin)



[trans] = get_matlab_bgl_options(varargin{:});
