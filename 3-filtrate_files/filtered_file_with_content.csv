6406,Compute_Surrogate_Prior.m,64.556,30,88.89,15,100.0,88.89,61-70,"function value = Compute_Surrogate_Prior(voxel_distance,sigma,p,q,c)

vd = abs(voxel_distance);
tmp = p-q;

denom = 1+(vd/c)^tmp;
value = p - (tmp*vd^tmp)/(denom*c^tmp);
value = value*(vd^(p-2))/denom;
value = value/(p*sigma^p);"
6407,ConvertXYZtoYxy.m,66.0,60,67.86,45,100.0,57.14,61-70,"function imgOut = ConvertXYZtoYxy(img, inverse)

check3Color(img);
[r, c, col] = size(img);
imgOut = zeros(r, c, col);

if(inverse == 0)%forward transform   
    norm = zeros(r, c);
    for i=1:3
        norm = norm + img(:,:,i);
    end
    
    imgOut(:,:,1) = img(:,:,2);
    
    imgOut(:,:,2) = img(:,:,1) ./ (norm);
    imgOut(:,:,3) = img(:,:,2) ./ (norm);
end

if(inverse == 1)%inverse transform
    Y_over_y = img(:,:,1) ./ img(:,:,3); 
    imgOut(:,:,1) = Y_over_y .* img(:,:,2);
    imgOut(:,:,2) = img(:,:,1);
    imgOut(:,:,3) = Y_over_y .* (1.0 - img(:,:,2) - img(:,:,3));
end

imgOut = RemoveSpecials(imgOut);

end"
