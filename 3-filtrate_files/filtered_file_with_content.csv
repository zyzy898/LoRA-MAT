6577,comp_filterbank_a.m,69.352,100,50.0,60,100.0,36.76,61-70,"function [a,info]=comp_filterbank_a(a,M,info)



info.isfractional=0;
info.isuniform=0;



if ~isnumeric(a) || any(a(:)<=0)
    error('%s: All subsampling factors must be positive.',upper(mfilename));
end

if isscalar(a)
   a = a*ones(M,1); 
end


if M==1 && (size(a,1)~=1 || ~any(size(a,2)==[1,2]))
   error('%s: One channel, but more subsampling factors.',upper(mfilename));
end

if M==1 && size(a,2)==1
   a = [a,1];
end

if M==2 && ~any(size(a)==2)  
   error('%s: Bad format of a.',upper(mfilename)); 
end

if M==2 && isvector(a)
   a = [a(:),ones(numel(a),1)];
end


if M>2 && isvector(a)
    a = a(:);
end


if isvector(a) && M~=1 && size(a,2)<2
    if numel(a)~=M
        error(['%s: The number of entries in ""a"" must match the number of ' ...
                'filters.'],upper(mfilename));
    end
        
    if all(a==a(1))
        info.isuniform=1;
    end;

    a=[a,ones(M,1)];
else
    if size(a,2)>2
       error(['%s: Bad format of a.'],upper(mfilename)); 
    end
    if isequal(a(:,2),ones(M,1))
        if all(a(:,1)==a(1))
            info.isuniform=1;
        end;        
    else
        info.isfractional=1;
    end;
    
    

end;

info.a=a;"
6578,computeBounds.m,65.2,60,76.0,30,100.0,60.0,61-70,"function bounds = computeBounds(config)


m1 = config.dyn.m1;
g = config.dyn.g;
l = config.dyn.l;

bounds.initialState.lower = [0;0;0;0];
bounds.initialState.upper = bounds.initialState.lower;
bounds.finalState.lower = [config.guess.state(1:2,end);0;0];
bounds.finalState.upper = bounds.finalState.lower;

wn = sqrt(l/g);
bounds.initialTime.lower = 0;
bounds.initialTime.upper = 0;
bounds.finalTime.lower = 0.5*(2*pi*wn);
bounds.finalTime.upper = 4*(2*pi*wn);

bounds.state.lower = [-1.0*l; -2*pi; -10*l/wn; -10*pi/wn];
bounds.state.upper = [1.0*l; 2*pi; 10*l/wn; 10*pi/wn];

bounds.control.lower = -5*m1*g;
