axis square
xlabel time
title('true stimulus','FontSize',16)
 
subplot(2,2,4)
imagesc(Q)
axis square
xlabel time
title('internal prediction','FontSize',16)"
6158,computeEMLoglik.m,67.092,60,72.73,30,100.0,72.73,61-70,"function loglik = computeEMLoglik(xInit,PInit,xSmooth,y,F,H,Q,R,B,u)

    [xDim, N] = size(xSmooth);
    yDim = size(y,1);
    
    loglik = -sum((y-H*xSmooth).^2)/(2*R) - N/2*log(abs(R))...
        -1/2*sum((xSmooth(2:N)-F*xSmooth(1:N-1)-B*u(2:N)).^2)/(Q) - (N-1)/2*log(abs(Q))...
        -sum((xSmooth(1)-xInit).^2)/(2*PInit) - 0.5*log(abs(PInit)) - N*log(2*pi);
    
    
end"
