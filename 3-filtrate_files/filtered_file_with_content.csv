    Y(:,(tt-1)*n_t+1:tt*n_t) = y;
    x0 = x(:,end);
           
    try
        set(pl(1), 'XData', 1 : tt*n_t);
        set(pl(1), 'YData', [get(pl(1), 'YData') y(1,:)]);
        set(pl(2), 'XData', 1 : tt*n_t);
        set(pl(2), 'YData', [get(pl(2), 'YData') y(2,:)]);
    catch
        pl(1) = plot(ha2,1:n_t,y(1,:),'m');
        pl(2) = plot(ha2,1:n_t,y(2,:),'b');
