3273,correction.m,70.974,100,56.41,60,100.0,38.46,70-80,"function [ precision , PM ] = correction( C, str )


fid = fopen('antibody.txt','rt');
tmp = textscan(fid, '%s %s %s %s %s');
AP=affinity_ag(tmp,str);
AN=neg_check(tmp,str);
positive=0;
negative=0;
for i= 1:50
     if(C(i)>25)   
        positive = positive + AP(i)*C(i);
     end
end

for i= 1:50
     if(C(i)<20)   
        negative = negative - AN(i)*C(i);
     end
end

precision = positive + negative;
total = 0;

if (precision <= 0)
    for i = 1:50
        total = total + NCW_ag(tmp,str,i)*C(i);        
    end
    
    for i = 1:50
        PM(i) = (NCW_ag(tmp,str,i)*C(i))/total;       
    end
end

if (precision > 0)
   PM = 0; 
end

end"
3274,correction_step.m,79.154,100,57.69,90,100.0,48.08,70-80,"function particles = correction_step(particles, z)


numParticles = length(particles);

m = size(z, 2);

Q_t = [0.1, 0.0;
       0.0, 0.1]; 

for i = 1:numParticles
  robot = particles(i).pose;
  for j = 1:m
    l = z(j).id;


    if (particles(i).landmarks(l).observed == false)

      robot_x = robot(1);
      robot_y = robot(2);
      robot_r = robot(3);
      particles(i).landmarks(l).mu = [ robot_x + z(j).range * cos(normalize_angle(z(j).bearing + robot_r));
                                       robot_y + z(j).range * sin(normalize_angle(z(j).bearing + robot_r))];

      [h, H] = measurement_model(particles(i), z(j));

      particles(i).landmarks(l).sigma = inv(H) * Q_t * inv(H)';

      particles(i).landmarks(l).observed = true;

    else

      [expectedZ, H] = measurement_model(particles(i), z(j));

      Q = (H * particles(i).landmarks(l).sigma * H') + Q_t;


      K = particles(i).landmarks(l).sigma * H' * inv(Q);

      Z_diff = [z(j).range - expectedZ(1); normalize_angle(z(j).bearing - expectedZ(2))];

      particles(i).landmarks(l).mu = particles(i).landmarks(l).mu + K * (Z_diff);
      particles(i).landmarks(l).sigma = (eye(2) - K * H) * particles(i).landmarks(l).sigma;

      particles(i).weight = particles(i).weight * 1/sqrt(det(2 * pi * Q)) * exp(-0.5 * (Z_diff)' * inv(Q) * Z_diff);

    end

  end % measurement loop
end % particle loop

end"
3275,correction_step_bkup.m,76.176,100,61.76,75,100.0,44.12,70-80,"function [mu, sigma, map] = correction_step(mu, sigma, z, map);

global scale;

m = size(z, 2);

Q = 0.01*eye(2);
n = length(mu);
zm = zeros(2,1);
S = zeros(2);
xbar = 0;
ybar = 0;


for i = 1:m


	if (isempty(find(map == z(i).id)))
            [mu, sigma, map] = add_landmark_to_map(mu, sigma, z(i), map, Q);
	    continue;
	endif
	n=length(mu);
	sigma_x_z = zeros(n,2);
	sigma_points = compute_sigma_points(mu, sigma);
	sigma_points(3,:) = normalize_angle(sigma_points(3,:));

	n = length(mu);
	num_sig = size(sigma_points,2);
	lambda = scale - n;

	landmarkIndex = find(map==(z(i).id));
	landmarkXs = sigma_points(2*landmarkIndex + 2, :);
	landmarkYs = sigma_points(2*landmarkIndex + 3, :);

	z_points(:,:) = [landmarkXs;landmarkYs] + repmat([z(i).range*cos(normalize_angle(z(i).bearing + mu(3)));z(i).range*sin(normalize_angle(z(i).bearing + mu(3)))],1,2*n+1);

        wm = [lambda/scale, repmat(1/(2*scale), 1, 2*n)];
        wc = wm;

	for j=1:2*n+1
	    zm(1,1) = zm(1,1) + wm(j)*z_points(1,j);
	    xbar = xbar + wm(j)*cos(z_points(2,j));
	    ybar = ybar + wm(j)*sin(z_points(2,j));
	endfor
	    zm(2,1) = atan2(ybar,xbar);

	for j=1:2*n+1
	    S = S + wc(j)*(z_points(:,j)-zm)*(z_points(:,j)-zm)' + Q;
	endfor
	
	n = length(mu);
	for j=1:2*n+1
	    sigma_x_z = sigma_x_z + wc(j)*(sigma_points(:,j) - mu)*(z_points(:,j)-zm)';
	endfor

	K = sigma_x_z/S;

	z_actual = [z(i).range; z(i).bearing];

	zdiff = z_actual - zm;
	zdiff(2) = normalize_angle(zdiff(2));	
	mu = mu + K*zdiff;
	mu(3) = normalize_angle(mu(3));


endfor

end"
3276,correction_step_bkup2.m,76.56,100,63.64,75,100.0,44.16,70-80,"function [mu, sigma, map] = correction_step(mu, sigma, z, map);

global scale;

m = size(z, 2);

Q = 0.01*eye(2);
n = length(mu);
zm = zeros(2,1);
S = zeros(2);
xbar = 0;
ybar = 0;


for i = 1:m


	if (isempty(find(map == z(i).id)))
            [mu, sigma, map] = add_landmark_to_map(mu, sigma, z(i), map, Q);
	    continue;
	endif
	n=length(mu);
	sigma_x_z = zeros(n,2);
	sigma_points = compute_sigma_points(mu, sigma)
	sigma_points(3,:) = normalize_angle(sigma_points(3,:));

	n = length(mu);
	num_sig = size(sigma_points,2);
	lambda = scale - n;

	landmarkIndex = find(map==(z(i).id));
	landmarkXs = sigma_points(2*landmarkIndex + 2, :);
	landmarkYs = sigma_points(2*landmarkIndex + 3, :);

	z_points(:,:) = [landmarkXs;landmarkYs] + repmat([z(i).range*cos(z(i).bearing + mu(3)); z(i).range*sin(z(i).bearing + mu(3))],1,2*n+1);

        wm = [lambda/scale, repmat(1/(2*scale), 1, 2*n)];
        wc = wm;

	
	for j=1:2*n+1
	    zm(1,1) = zm(1,1) + wm(j)*z_points(1,j);
	    xbar = xbar + wm(j)*cos(z_points(2,j));
	    ybar = ybar + wm(j)*sin(z_points(2,j));
	endfor
	    zm(2,1) = atan2(ybar,xbar);

	for j=1:2*n+1
	    tmp = z_points(:,j) - zm;
	    tmp(2) = normalize_angle(tmp(2));
	    S = S + wc(j)*tmp*tmp' + Q;
	endfor	

	n = length(mu);
	for j=1:2*n+1
	    tmp2 = sigma_points(:,j) - mu;
	    tmp2(3,1) = normalize_angle(tmp2(3,1));
	    tmp3 = z_points(:,j)-zm;
	    tmp3(2) = normalize_angle(tmp3(2));
	    sigma_x_z = sigma_x_z + wc(j)*tmp2*tmp3';
	endfor

	K = sigma_x_z/S;

	z_actual = [z(i).range; z(i).bearing];

	zdiff = z_actual - zm;
	zdiff(2) = normalize_angle(zdiff(2));	
	mu = mu + K*zdiff;
	mu(3) = normalize_angle(mu(3));
	
	sigma = sigma - K*S*K';


endfor

end"
3277,correctKnownLmks.m,75.436,100,51.28,90,100.0,35.9,70-80,"function [Rob,Sen,Lmk,Obs] = correctKnownLmks(Rob, Sen, Raw, Lmk, Obs, Opt)




global Map

Rob = map2rob(Rob);
Sen = map2sen(Sen);

for lmk = find([Lmk.used])

    Obs(lmk) = projectLmk(Rob,Sen,Lmk(lmk),Obs(lmk),Opt);
    
end  % --- all landmarks are now projected.

vis = [Obs.vis];

if any(vis) % Consider only visible observations

    [lmksToObs,lmksToSkip] = selectLmksToObserve(Obs(vis),Opt.correct.nUpdates);

    [Obs(lmksToSkip).measured] = deal(false);
    [Obs(lmksToSkip).matched]  = deal(false);
    [Obs(lmksToSkip).updated]  = deal(false);

    for lmk = lmksToObs % for each landmark to correct

        Lmk(lmk).nSearch = Lmk(lmk).nSearch + 1;

        Obs(lmk) = matchFeature(Sen,Raw,Obs(lmk));

        if Obs(lmk).matched

            Lmk(lmk).nMatch = Lmk(lmk).nMatch + 1;

            Rob = map2rob(Rob);
            Sen = map2sen(Sen);

            if Opt.correct.reprojectLmks
                Obs(lmk) = projectLmk(Rob,Sen,Lmk(lmk),Obs(lmk),Opt);
            end

            Obs(lmk) = observationInnovation(Obs(lmk),Opt.correct.lines.innType);

            if Obs(lmk).inn.MD2 < Opt.correct.MD2th

                Lmk(lmk).nInlier = Lmk(lmk).nInlier + 1;

                [Rob,Sen,Lmk(lmk),Obs(lmk)] = correctLmk(...
                    Rob,      ...
                    Sen,      ...
                    Lmk(lmk), ...
                    Obs(lmk), ...
                    Opt          );
                
            else % obs is inconsistent - do not update

                Obs(lmk).updated = false;

            end % if consistent

        end % if matched

    end % for lmk = lmkList

    for lmk = find([Obs.vis])
        
        [Lmk(lmk),Obs(lmk)] = smartDeleteLmk(Lmk(lmk),Obs(lmk));
        
    end

    Map.P(Map.used,Map.used) = (Map.P(Map.used,Map.used) + Map.P(Map.used,Map.used)')/2;


end % if any(vis)

end % function"
