    M.T    = Y;                    % data structure
    U      = [Y.U];                % outputs to model
    
    [Ep,Cp,Eh,F] = spm_nlsi_GN(M,U,xY);
    
    DCM(r).M  = M;
    DCM(r).Ep = Ep;
    DCM(r).Eh = Eh;
    DCM(r).Cp = Cp;
    DCM(r).Y  = Y;
    DCM(r).xY = xY;
