1132,DASCMOP1.m,84.532,100,81.33,100,100.0,41.33,80-90,"classdef DASCMOP1 < PROBLEM


    
    methods
        function Setting(obj)
            obj.M = 2;
            if isempty(obj.D); obj.D = 30; end
            obj.lower    = zeros(1,obj.D);
            obj.upper    = ones(1,obj.D);
            obj.encoding = ones(1,obj.D);
        end
        function PopObj = CalObj(obj,X)
            x_all = X(:,1:1:end); 
            sum1  = sum((x_all - sin(0.5 * pi * X(:,1))).^2,2);
            PopObj(:,1) = X(:,1) + sum1;
            PopObj(:,2) = 1 - X(:,1) .^ 2 + sum1;
        end
        function PopCon = CalCon(obj,X)  
            x_all  = X(:,1:1:end); 
            sum1   = sum((x_all - sin(0.5 * pi * X(:,1))).^2,2);
            PopCon = Constraint(X(:,1),sum1);
        end
        function R = GetOptimum(obj,N)
            R(:,1) = linspace(0,1,N)';
            R(:,2) = 1 - R(:,1).^2;
            R      = R + 0.5;
            X1     = (sqrt(1-4*(-R(:,1)+R(:,2)-1))-1)/2;
            sum1   = R(:,1) - X1;
            C      = Constraint(X1,sum1);
            R(any(C>0,2),:) = [];
            R = [R;1.5,0.5];
        end 
        function R = GetPF(obj)
            [x,y] = meshgrid(linspace(0.5,2.5,400));
            X1    = (sqrt(1-4*(-x+y-1))-1)/2;
            sum1  = x - X1;
            fes   = all(Constraint(X1(:),sum1(:))<=0,2);  
            z     = nan(size(x));
            z(reshape(fes,size(z))) = 0;
            R = {x,y,z};
        end
    end
end

function PopCon = Constraint(X1,sum1)
    DifficultyFactors = [0,0.5,0.5];
    a = 20;
    b = 2 * DifficultyFactors(1) - 1;
    d = 0.5;
    if DifficultyFactors(2) == 0.0
        d = 0.0;
    end
    e = d - log(DifficultyFactors(2));
    if isfinite(e) == 0
        e = 1e+30;
    end
    r = 0.5 * DifficultyFactors(3);
    PopObj(:,1) = X1 + sum1;
	PopObj(:,2) = 1 - X1 .^ 2 + sum1;
    PopCon(:,1) = b - sin(a * pi * X1);
    PopCon(:,2) = -(e - sum1) .* (sum1 - d);
    if DifficultyFactors(2) == 1.0                               
        PopCon(:,2) = 1e-4 - abs(sum1 - e);
    end
    p_k = [0.0, 1.0, 0.0, 1.0, 2.0, 0.0, 1.0, 2.0, 3.0];
    q_k = [1.5, 0.5, 2.5, 1.5, 0.5, 3.5, 2.5, 1.5, 0.5];
    a_k = 0.3;
    b_k = 1.2;
    theta_k = -0.25 * pi;
    for k=1:length(p_k)
        PopCon(:,2+k) = r - ((PopObj(:,1) - p_k(k)) * cos(theta_k) - (PopObj(:,2) - q_k(k)) * sin(theta_k)).^2 ./ a_k -...
            ((PopObj(:,1) - p_k(k)) * sin(theta_k) + (PopObj(:,2) - q_k(k)) * cos(theta_k)).^2 ./ b_k;
    end
end"
1133,DASCMOP2.m,84.25,100,76.25,100,100.0,45.0,80-90,"classdef DASCMOP2 < PROBLEM


    
    methods
        function Setting(obj)
            obj.M = 2;
            if isempty(obj.D); obj.D = 30; end
            obj.lower    = zeros(1,obj.D);
            obj.upper    = ones(1,obj.D);
            obj.encoding = ones(1,obj.D);
        end
        function PopObj = CalObj(obj,X)
            x_all = X(:,1:1:end); 
            sum1  = sum((x_all - sin(0.5 * pi * X(:,1))).^2,2);
            PopObj(:,1) = X(:,1) + sum1;
            PopObj(:,2) = 1 - sqrt(X(:,1)) + sum1;
        end
        function PopCon = CalCon(obj,X)
            x_all  = X(:,1:1:end); 
            sum1   = sum((x_all - sin(0.5 * pi * X(:,1))).^2,2);
            PopCon = Constraint(X(:,1),sum1);
        end
        function R = GetOptimum(obj,N)
            R(:,1) = linspace(0,1,N)';
            R(:,2) = 1 - sqrt(R(:,1));
            R      = R + 0.5;
            theta_k = -0.25 * pi;
            C = 0.25 - ((R(:,1) - 1) * cos(theta_k) - (R(:,2) - 0.5) * sin(theta_k)).^2 ./ 0.3 -...
                ((R(:,1) - 1) * sin(theta_k) + (R(:,2) - 0.5) * cos(theta_k)).^2 ./ 1.2;
            invalid = C>0;
            while any(invalid)
                R(invalid,:) = (R(invalid,:)-0.5).*1.001 + 0.5;
                C = 0.25 - ((R(:,1) - 1) * cos(theta_k) - (R(:,2) - 0.5) * sin(theta_k)).^2 ./ 0.3 -...
                    ((R(:,1) - 1) * sin(theta_k) + (R(:,2) - 0.5) * cos(theta_k)).^2 ./ 1.2;
                invalid = C>0;
            end
        end
        function R = GetPF(obj)
            [x,y] = meshgrid(linspace(0.5,2.5,400));
            X1    = ((sqrt(1-4*(-x+y-1))-1)/2).^2;
            sum1  = x - X1;
            fes   = all(Constraint(X1(:),sum1(:))<=0,2);  
            z     = nan(size(x));
            z(reshape(fes,size(z))) = 0;
            R = {x,y,z};
        end
    end
end

function PopCon = Constraint(X1,sum1)
    DifficultyFactors = [0,0.5,0.5];
    a = 20;
    b = 2 * DifficultyFactors(1) - 1;
    d = 0.5;
    if DifficultyFactors(2) == 0.0
        d = 0.0;
    end
    e = d - log(DifficultyFactors(2));
    if isfinite(e) == 0
        e = 1e+30;
    end
    r = 0.5 * DifficultyFactors(3);
    PopObj(:,1) = X1 + sum1;
	PopObj(:,2) = 1 - sqrt(X1) + sum1;
    PopCon(:,1) = b - sin(a * pi * X1);
    PopCon(:,2) = -(e - sum1) .* (sum1 - d);
    if DifficultyFactors(2) == 1.0
        PopCon(:,2) = 1e-4 - abs(sum1 - e);
    end
    p_k = [0.0, 1.0, 0.0, 1.0, 2.0, 0.0, 1.0, 2.0, 3.0];
    q_k = [1.5, 0.5, 2.5, 1.5, 0.5, 3.5, 2.5, 1.5, 0.5];
    a_k = 0.3;
