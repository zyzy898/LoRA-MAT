2397,compute_MPIS.m,77.684,60,89.47,60,100.0,78.95,70-80,"function [Xmpi]=compute_MPIS(Xc,Ak)
    
    rhe2one = @(poly) poly.A./repmat(poly.b, 1, size(poly.A, 2));
    F=rhe2one(Xc);
    Fpi = @(i) (F)*Ak^i;
    Xpi = @(i) Polyhedron(Fpi(i), ones(size(Fpi(i), 1), 1));
    Xmpi = Xpi(0);
    i= 0;
    while(1) % 
        i = i + 1;
        Xmpi_tmp = Xmpi & Xpi(i);
        if Xmpi_tmp == Xmpi
            break;
        else
            Xmpi = Xmpi_tmp;
        end
    end
    fprintf(""Iterations : %d\\n"",i);
end"
2398,compute_M_ver2.m,70.142,100,65.71,45,100.0,40.0,70-80,"function M=compute_M(U,Alph,A)


n=size(Alph,1); %number of 3d points

fu=A(1,1);
fv=A(2,2);
u0=A(1,3);
v0=A(2,3);

nrows_M=2*n;
ncols_M=12;
M=zeros(nrows_M,ncols_M);



for i=1:n
    a1=Alph(i,1);
    a2=Alph(i,2);
    a3=Alph(i,3);
    a4=Alph(i,4);
    
    ui=U(i,1);
    vi=U(i,2);
    
    M_=[a1*fu, 0, a1*(u0-ui), a2*fu, 0, a2*(u0-ui), a3*fu, 0, a3*(u0-ui), a4*fu, 0, a4*(u0-ui);
        0, a1*fv, a1*(v0-vi), 0, a2*fv, a2*(v0-vi), 0, a3*fv, a3*(v0-vi), 0, a4*fv, a4*(v0-vi)];
    
    
    row_ini=i*2-1;
    row_end=i*2;
        
    M(row_ini:row_end,:)=M_;
     
end"
2399,Compute_N2_dTdz_forChi_line.m,74.79,100,67.44,60,100.0,46.51,70-80,"function ctd=Compute_N2_dTdz_forChi_line(ctd,bin_size)

ctd.s1 = interp_missing_data(ctd.s1,100);
ctd.t1 = interp_missing_data(ctd.t1,100);

ptmp = sw_ptmp(ctd.s1, ctd.t1, ctd.p, 0);
sgth = sw_pden(ctd.s1, ctd.t1, ctd.p, 0);

p_bins = [ 0.5 : bin_size : nanmax(ctd.p) ] ;

dTdz = nan*ones(length(p_bins),1);
N2   = nan*ones(length(p_bins),1);

clear t_pot t_pot_sort
[ptmp_sort , Iptmp] = sort(ptmp,1,'descend');

[sgth_sort , Isgth] = sort(sgth,1,'ascend');

for ibin = 1:length(p_bins)
    
    clear iz z1 z2
    z1 = p_bins(ibin) - bin_size ;
    z2 = p_bins(ibin) + bin_size ;
    iz = find(ctd.p>z1 & ctd.p<z2) ;
    
    clear P
    P = polyfit(ctd.p(iz),ptmp_sort(iz),1);
    dTdz(ibin) = -P(1);
    
    clear P1 drhodz
    P1 = polyfit(ctd.p(iz),sgth_sort(iz),1);
    clear drhodz n2_2 drho dz n2_3
    drhodz = -P1(1);
    N2(ibin) = -9.81/nanmean(sgth)*drhodz;
    
end


ctd.N2 = interp1(p_bins,N2,ctd.p);
ctd.dTdz = interp1(p_bins,dTdz,ctd.p);


return"
