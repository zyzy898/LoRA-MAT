3927,CropStackDialog.m,73.126,80,54.95,100,100.0,30.68,70-80,"classdef CropStackDialog < handle



properties
    Parent;
    
    Handles;
end % end properties


methods
    function obj = CropStackDialog(parent, varargin)
        
        obj = obj@handle();
        obj.Parent = parent;

        fig = figure(...
            'MenuBar', 'none', ...
            'NumberTitle', 'off', ...
            'HandleVisibility', 'On', ...
            'Name', 'Crop 3D Stack', ...
            'CloseRequestFcn', @obj.close);
        obj.Handles.Figure = fig;
            
        setupLayout(fig);
        
        function setupLayout(hf)
       
            pos = get(hf, 'Position');
            pos(3:4) = [200 180];
            set(hf, 'Position', pos);
            set(hf, 'Units', 'normalized');
       
            bgColor = get(0, 'defaultUicontrolBackgroundColor');
            if ispc
