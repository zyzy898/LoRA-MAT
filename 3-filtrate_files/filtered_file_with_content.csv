axis([-1 1 -1 1]*A)
axis square, box off
hold off
 
 
subplot(2,2,3); cla;
for t = 1:N
    v = spm_unvec(DEM.qU.a{2}(:,t),a);
    for i = 1:n
        x = v.x(1,i);
