    case{1} % TVD 0(h^2)
        a = v(:,1);        
        f = f0;
               f_eq = f_equilibrium_1d(r,ux,v,t,theta);
                 u_next = zeros(1,nx);
                 u_eq = zeros(1,nx);
                 u = zeros(1,nx);
