6641,D02DPeriodic.m,64.364,60,81.82,30,100.0,50.0,61-70,"function [D0x, D0y] = D02DPeriodic(N, h);


M = N * N;
e              = ones(M,1);
eu1            = ones(M,1);
eu1((N+1):N:M) = 0;
ed1            = ones(M,1);
ed1(N:N:M)     = 0;

D0x  = spdiags([-ed1 eu1], [-1 1], M, M);
D0y  = spdiags([-e e], [-N N], M, M);

for( i = 1:N )
  D0x( (i-1)*N + 1, i*N ) = -1;
  D0x( i*N, (i-1)*N + 1 ) = 1;
  D0y( i, N*N-N+i )       = -1;
  D0y( N*N-N+i, i )       = 1;
end

D0x = D0x / (2*h);
D0y = D0y / (2*h);"
