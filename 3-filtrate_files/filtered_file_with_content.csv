	inv1 = de_ftab_inv1(fit, sl{1}, 'type', itype);
	if im, inv1.plot(fit); end
end"
5973,de_ftab_invert.m,77.496,80,60.65,100,100.0,46.83,70-80,"function shat = de_ftab_invert(ftab, fhat, varargin)

