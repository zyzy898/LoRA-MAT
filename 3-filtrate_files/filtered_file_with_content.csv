function onChange(~,~,h)

    thresh = round(get(h.slid, 'Value'));
    set(h.txt, 'String',sprintf('Threshold: %3d',thresh));

    if true
        if thresh < 128
            bw = (h.src <= thresh);
        else
            bw = (h.src > thresh);
        end
    else
        if thresh < 128
            bw = cv.threshold(h.src, thresh, 'Type','BinaryInv');
        else
            bw = cv.threshold(h.src, thresh, 'Type','Binary');
        end
    end
    [labels, nLabels] = cv.connectedComponents(bw);

    labels = double(labels) + 1;  % cast as float-type with one-based indexing
    if false
        dst = label2rgb(labels, 'hsv', 'k');
    else
        clr = hsv(nLabels);
        clr(1,:) = 0;  % background
        dst = uint8(255 * ind2rgb(labels, clr));
    end

    set(h.img(2), 'CData',dst);
    drawnow;
end

function h = buildGUI(img)

    thresh = 100;
    max_thresh = 255;
    sz = size(img);
    sz(2) = max(sz(2), 200);  % minimum figure width

    h = struct();
    h.src = img;
    h.fig = figure('Name','Connected Components', ...
        'NumberTitle','off', 'Menubar','none', 'Resize','off', ...
        'Position',[200 200 sz(2)*2 sz(1)+29]);
    if ~mexopencv.isOctave()
        movegui(h.fig, 'center');
    end
    h.ax(1) = axes('Parent',h.fig, ...
        'Units','pixels', 'Position',[1 30 sz(2) sz(1)]);
    h.ax(2) = axes('Parent',h.fig, ...
        'Units','pixels', 'Position',[sz(2)+1 30 sz(2) sz(1)]);
    if ~mexopencv.isOctave()
        h.img(1) = imshow(img, 'Parent',h.ax(1));
        h.img(2) = imshow(img, 'Parent',h.ax(2));
    else
        axes(h.ax(1));
        h.img(1) = imshow(img);
        axes(h.ax(2));
        h.img(2) = imshow(img);
    end
    h.txt = uicontrol('Parent',h.fig, 'Style','text', 'FontSize',11, ...
        'Position',[5 5 130 20], 'String',sprintf('Threshold: %3d',thresh));
    h.slid = uicontrol('Parent',h.fig, 'Style','slider', 'Value',thresh, ...
        'Min',0, 'Max',max_thresh, 'SliderStep',[1 10]./(max_thresh-0), ...
        'Position',[135 5 sz(2)-135-5 20]);

    set(h.slid, 'Callback',{@onChange,h}, ...
        'Interruptible','off', 'BusyAction','cancel');
    onChange([],[],h);
end"
415,consensus_und.m,81.572,100,76.79,90,100.0,41.07,80-90,"function ciu = consensus_und(d,tau,reps)

n = length(d); flg = 1;
while flg == 1
    
    flg = 0;
    dt = d.*(d >= tau).*~eye(n);
    if nnz(dt) == 0
        ciu = (1:n)';
    else
        ci = zeros(n,reps);
        for iter = 1:reps
            ci(:,iter) = community_louvain(dt);
        end
        ci = relabel_partitions(ci);
        ciu = unique_partitions(ci);
        nu = size(ciu,2);
        if nu > 1
            flg = 1;
            d = agreement(ci)./reps;
        end
    end
    
end

function cinew = relabel_partitions(ci)
[n,m] = size(ci);
cinew = zeros(n,m);
for i = 1:m
    c = ci(:,i);
    d = zeros(size(c));
    count = 0;
    while sum(d ~= 0) < n
        count = count + 1;
        ind = find(c,1,'first');
        tgt = c(ind);
        rep = c == tgt;
        d(rep) = count;
        c(rep) = 0;
    end
    cinew(:,i) = d;
end

function ciu = unique_partitions(ci)
ci = relabel_partitions(ci);
ciu = [];
count = 0;
c = 1:size(ci,2);
while ~isempty(ci)
    count = count + 1;
    tgt = ci(:,1);
    ciu = [ciu,tgt];                %#ok<AGROW>
    dff = sum(abs(bsxfun(@minus,ci,tgt))) == 0;
    ci(:,dff) = [];
    c(dff) = [];
end"
416,conservative_edge_matching.m,82.63,100,73.68,100,100.0,39.47,80-90,"function [EE,I] = conservative_edge_matching(E_orig,varargin)

  if size(E_orig,1) == 0
    EE = E_orig;
    I = [];
    C = [];
    return;
  end


  method = 'one-per-component';
  params_to_variables = containers.Map( ...
    {'Method'}, ...
    {'method'});
  v = 1;
  while v <= numel(varargin)
    param_name = varargin{v};
    if isKey(params_to_variables,param_name)
      assert(v+1<=numel(varargin));
      v = v+1;
      feval(@()assignin('caller',params_to_variables(param_name),varargin{v}));
    else
      error('Unsupported parameter: %s',varargin{v});
    end
    v=v+1;
  end

  [~,~,E] = unique(E_orig(:));
  E = reshape(E,size(E_orig));


  switch method
  case 'one-per-component'
    ne = size(E,1);
    C = connected_components(E);
    C = C(E(:,1));
    E2C = sparse(1:ne,C,ne-(1:ne)+1,ne,max(C));
    I = max(E2C,[],1);
    I = I(I>0);
    I = ne - I + 1;
  case 'recursive'
    keep = 1:size(E,1);
    Ekeep = E(keep,:);
    J = 1:size(E,1);
    I = [];
    while true
      [~,Ikeep] = conservative_edge_matching(Ekeep,'Method','random');
      I = [I J(Ikeep)];
      keep = find(~any(ismember(Ekeep,Ekeep(Ikeep,:)),2));
      if isempty(keep)
        break;
      end
      J = J(keep);
      Ekeep = Ekeep(keep,:);
    end

  case 'random'
    ns = size(E,1);
    while true
      I = randperm(size(E,1));
      I = I(1:ns);
      [~,~,EI] = unique(E(I,:));
      V = full(sparse(EI,1,1));
      if max(V) == 1
        break;
      end
      ns = floor(ns/2);
      if ns <= 1
        I = 1;
        break;
      end
    end
  end

  EE = E_orig(I,:);
end"
