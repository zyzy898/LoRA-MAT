    display_graph('grad_calc_count','optimality_gap', {'SMU', 'SVRMU'}, {w_smu_nmf, w_svrmu_nmf}, {infos_smu_nmf, infos_svrmu_nmf});    
    
end"
5504,demo_normalized_random_walk.m,71.15,100,69.89,45,100.0,40.86,70-80,"close all;
clearvars;
clc;
rng default;
dataset_file = fullfile(spx.data_dir, 'clustering', ...
    'self_tuning_paper_clustering_data');
data = load(dataset_file);
datasets = data.XX;
raw_data = datasets{3};
raw_data = raw_data - repmat(mean(raw_data),size(raw_data,1),1);
raw_data = raw_data/max(max(abs(raw_data)));
num_clusters = data.group_num(1);
X = raw_data(:, 1);
Y = raw_data(:, 2);

spx.graphics.figure.full_screen;
axis equal;
plot(X, Y, '.', 'MarkerSize',16);
saveas(gcf, 'images/st3_nrw_raw_data.png');

sqrt_dist_mat = spx.commons.distance.sqrd_l2_distances_rw(raw_data);
spx.graphics.figure.full_screen;
imagesc(sqrt_dist_mat);
title('Distance Matrix');
colorbar;
saveas(gcf, 'images/st3_nrw_distances.png');

scale = 0.04;
W = spx.cluster.similarity.gauss_sim_from_sqrd_dist_mat(sqrt_dist_mat, scale);


spx.graphics.figure.full_screen;
imagesc(W);
title('Similarity Matrix');
colorbar;
saveas(gcf, 'images/st3_nrw_similarity.png');

[num_nodes, ~] = size(W);
Degree = diag(sum(W));
DegreeInv = Degree^(-1);
Laplacian = speye(num_nodes) - DegreeInv * W;

spx.graphics.figure.full_screen;
imagesc(Laplacian);
title('Normalized Random Walk Laplacian');
colorbar;
saveas(gcf, 'images/st3_nrw_laplacian.png');


[~, S, V] = svd(Laplacian);
singular_values = diag(S);


spx.graphics.figure.full_screen;
plot(singular_values, 'b.-');
grid on;
title('Singular values of the Laplacian');
saveas(gcf, 'images/st3_nrw_singular_values.png');


sv_changes = diff( singular_values(1:end-1) );
spx.graphics.figure.full_screen;
plot(sv_changes, 'b.-');
grid on;
title('Changes in singular values');
saveas(gcf, 'images/st3_nrw_sv_changes.png');


[min_val , ind_min ] = min(sv_changes);
num_clusters = num_nodes - ind_min;
num_clusters = sum(singular_values < 1e-6);

Kernel = V(:,num_nodes-num_clusters+1:num_nodes);

max_iterations = 1000; 
replicates = 100;
cluster_labels = kmeans(Kernel, num_clusters, ...
    'start','plus', ...
    'maxiter',max_iterations,...
    'replicates',replicates, ...
    'EmptyAction','singleton'...
    );

spx.graphics.figure.full_screen;
hold on;
axis equal;
for c=1:num_clusters
    points = raw_data(cluster_labels == c, :);
    X = points(:, 1);
    Y = points(:, 2);
    plot(X, Y, '.', 'MarkerSize',16);
end
saveas(gcf, 'images/st3_nrw_clustered_data.png');"
5505,demo_normalizeMatchingW.m,75.668,100,77.78,45,100.0,55.56,70-80,"function demo_normalizeMatchingW

n1 = 10;
n2 = 15;

E12 = rand(n1, n2) > 0.3; % E12 = ones(n1, n2) for full matching
n12 = nnz(E12); % nb of feasible matches

W = rand(n12, n12);
W = (W + W') / 2;

W = sparse(tril(W));

normalization = 'iterative';
nbIter = 10;
[W, D1, D2] = normalizeMatchingW(W, E12, normalization, nbIter);

W = trilW2W(W); % inverse operation from tril(W)
[I12(:, 1), I12(:, 2)] = find(E12);
indexes1 = classes2indexes(I12(:, 1), n1); %indexes1{i1}=set of matches e=i1i2 in I12 (across i2)
indexes2 = classes2indexes(I12(:, 2), n2); %indexes2{i2}=set of matches e=i1i2 in I12 (across i1)
Dn1 = compute_D(W, indexes1); %Dn1(i1,j1)=sum of W(i1i2,j1j2) (across i2,j2) 
Dn2 = compute_D(W, indexes2); %Dn2(i2,j2)=sum of W(i1i2,j1j2) (across i1,j1) 

std(Dn1(:))
std(Dn2(:))
0;

function D = compute_D(W, indexes)
n = length(indexes);
D = zeros(n);
for j = 1 : n
    for i = 1 : n
        D(i, j) = sum(sum(W(indexes{i}, indexes{j})));
    end
end"
