1186,dba_get_avg_vertarea.m,80.0,80,74.48,100,100.0,45.52,80-90,"function nbVert = dba_get_avg_vertarea(mesh_ref, mesh_2)

disp = 0;

[FaceArea_ref, VertexArea_ref] = tess_area(mesh_ref.Vertices, mesh_ref.Faces);
avg_ref = mean(VertexArea_ref);
std_ref = std(VertexArea_ref);
if disp
    figure('color','w'),
    subplot(131), title('mesh ref')
    hold on
    plot(VertexArea_ref), ylabel('Vertex area')
    plot(ones(1,length(VertexArea_ref))*avg_ref,'r')
    plot(ones(1,length(VertexArea_ref))*(avg_ref+std_ref),'g--')
    plot(ones(1,length(VertexArea_ref))*(avg_ref-std_ref),'g--')
end
 
[FaceArea_2, VertexArea_2] = tess_area(mesh_2.Vertices, mesh_2.Faces);
avg_2 = mean(VertexArea_2);
std_2 = std(VertexArea_2);
if disp
    subplot(132), title('mesh 2')
    hold on
    plot(VertexArea_2), ylabel('Vertex area')
    plot(ones(1,length(VertexArea_2))*avg_2,'r')
    plot(ones(1,length(VertexArea_2))*(avg_2+std_2),'g--')
    plot(ones(1,length(VertexArea_2))*(avg_2-std_2),'g--')
end

if avg_2 > avg_ref
    disp('DBA> Error : The order of mesh are not consistent with for subsampling. Try to invert the meshes entry positions.');
    nbVert = -1;
else
    r = 1; 
    cst = 0.025; % subsampling by steps of 2.5%
    while(avg_2 <= avg_ref)
        r = r-cst; 
        [mesh_2_tmp.Faces, mesh_2_tmp.Vertices] = reducepatch(mesh_2.Faces, mesh_2.Vertices, r);
        [FaceArea_tmp, VertexArea_tmp] = tess_area(mesh_2_tmp.Vertices, mesh_2_tmp.Faces);
        avg_2 = mean(VertexArea_tmp);
        std_2 = std(VertexArea_tmp);  
        if (std_2 > 2*std_ref)
            disp('DBA> Warning : The std of the new vertices area is twice time higher than the mesh ref vertices area.');
        end
    end
    nbVert = length(mesh_2_tmp.Vertices);
end

if disp
    subplot(133), title('mesh 2 new')
    hold on
    plot(VertexArea_tmp), ylabel('Vertex area')
    plot(ones(1,length(VertexArea_tmp))*avg_2,'r')
    plot(ones(1,length(VertexArea_tmp))*(avg_2+std_2),'g--')
    plot(ones(1,length(VertexArea_tmp))*(avg_2-std_2),'g--')
end




function [faces, vertices] = reducepatch_subdiv(TessMat, dsFactor)

newNbVertices       = length(TessMat.Vertices);

[NewTessMat.Faces, NewTessMat.Vertices] = reducepatch(TessMat.Faces, TessMat.Vertices, dsFactor * 0.94);
[tmp, I, J] = intersect(TessMat.Vertices, NewTessMat.Vertices, 'rows');
nVertLowInit = size(NewTessMat.Vertices,1);

bst_progress('start', 'Resample surface', 'Analyzing surface...');
FaceArea  = tess_area(NewTessMat.Vertices, NewTessMat.Faces);
VertConn    = tess_vertconn(NewTessMat.Vertices, NewTessMat.Faces);
[VertNormals, FaceNormals] = tess_normals(NewTessMat.Vertices, NewTessMat.Faces, VertConn);
Curvature   = tess_curvature(NewTessMat.Vertices, VertConn, VertNormals);
FaceCenter = (NewTessMat.Vertices(NewTessMat.Faces(:,1),:) + NewTessMat.Vertices(NewTessMat.Faces(:,2),:) + NewTessMat.Vertices(NewTessMat.Faces(:,3),:)) ./ 3;
SurfCenter = mean(NewTessMat.Vertices, 1);
iBigFaces = find((sum(FaceNormals .* bst_bsxfun(@minus, FaceCenter, [0 0 SurfCenter(3)]), 2) > 0.04) & ...  % Faces pointing outwards (normal in the same direction as position vector)
    (sum(Curvature(NewTessMat.Faces) > 0, 2) >= 2) & ...       % Curvature has to be > 0
    (FaceArea > mean(FaceArea) + 1*std(FaceArea)));            % Face area threshold
if (length(iBigFaces) < .75 * (newNbVertices - size(NewTessMat.Vertices,1)))
    iBigFaces = find(FaceArea > mean(FaceArea) + 2.5 * std(FaceArea));
end
disp(sprintf('BST> Subdividing %d faces from the %d faces generated by reducepatch.', length(iBigFaces), length(NewTessMat.Faces)));

iRmFaces = [];
bst_progress('start', 'Resample surface', 'Subdividing large faces...', 1, length(iBigFaces));
for i = 1:length(iBigFaces)
    bst_progress('inc', 1);
    f = NewTessMat.Faces(iBigFaces(i),:);
    v = NewTessMat.Vertices(f,:);
    c = mean(v,1);
    
    dmax = 1.2 * max(sqrt(sum(bst_bsxfun(@minus, v, c) .^ 2, 2)));
    iVertBox = find(sum(bst_bsxfun(@minus, TessMat.Vertices, c) .^ 2, 2) < dmax.^2);
    
    
    s1 = find(I(J == f(1)) == iVertBox);
    s2 = find(I(J == f(2)) == iVertBox);
    s3 = find(I(J == f(3)) == iVertBox);
    if isempty(s1) || isempty(s2) || isempty(s3)
        disp(sprintf('BST> Cannot subdivide big face #%d (box too small), skipping...', i));
        continue;
    end
    boxVertConn = TessMat.VertConn(iVertBox, iVertBox);
    
    iter_max = 20;
    iter = 1;
    sx = [];
    while isempty(sx) && (iter < iter_max)
        s1 = union(s1, find(any(boxVertConn(s1,:),1)));
        s2 = union(s2, find(any(boxVertConn(s2,:),1)));
        s3 = union(s3, find(any(boxVertConn(s3,:),1)));
        sx = intersect(intersect(s1, s2), s3);
        iter = iter + 1;
    end
    
    iter_max = 50;
    iter = 1;
    istop = 0;
    d1 = 0;
    d2 = 0;
    d3 = 0;
    while (istop < 2) && (iter <= iter_max)
        i1 = find(any(boxVertConn(s1,:),1));
        s1 = [s1, setdiff(i1,s1)];
        d1 = [d1, i1*0+iter];
        i2 = find(any(boxVertConn(s2,:),1));
        s2 = [s2, setdiff(i2,s2)];
        d2 = [d2, i2*0+iter];
        i3 = find(any(boxVertConn(s3,:),1));
        s3 = [s3, setdiff(i3,s3)];
        d3 = [d3, i1*0+iter];
        if (length(s1) == length(iVertBox)) && (length(s2) == length(iVertBox)) && (length(s3) == length(iVertBox))
            istop = 10;
        elseif (istop > 0) || (all(ismember([s2 s3],s1)) && all(ismember([s1 s3],s2)) && all(ismember([s1 s2],s3)))
            istop = istop + 1;
        else
            iter = iter + 1;
        end
    end
    if (iter > iter_max)
        disp(sprintf('BST> Cannot subdivide big face #%d (more than %d nodes distance), skipping...', i, iter_max));
        continue;
    end
    [sx,ix,jx] = intersect(s1, s2);
    d1 = d1(ix);
    d2 = d2(jx);
    [sx,ix,jx] = intersect(sx, s3);
    d1 = d1(ix);
    d2 = d2(ix);
    d3 = d3(jx);
    dx = d1 + d2 + d3;
    
    
    sx = iVertBox(sx);
    isInside = bst_intriangle(v(1,:), v(2,:), v(3,:), TessMat.Vertices(sx,:));
    sx = sx(isInside);
    dx = dx(isInside);
    if isempty(sx)
        disp(sprintf('BST> Cannot subdivide big face #%d (no candidate in the triangle), skipping...', i));
        continue;
    end
    
    pathLength = min(dx);
    sx = sx(dx <= pathLength + 2);
    
    [d,imin] = min(sqrt(sum(bst_bsxfun(@minus, TessMat.Vertices(sx,:), c) .^ 2, 2)));
    sx = sx(imin);
    if ismember(sx, I)
        disp(sprintf('BST> Cannot subdivide big face #%d (vertex already selected), skipping...', i));
        continue;
    end
    
    NewTessMat.Vertices = [NewTessMat.Vertices; c];
    iVertNew = size(NewTessMat.Vertices,1);
    I(end+1) = sx;
    J(end+1) = iVertNew;
    NewTessMat.Faces = [NewTessMat.Faces; ...
        f(1), f(2), iVertNew; ...
        f(1), iVertNew, f(3); ...
        iVertNew, f(2), f(3)];
    iRmFaces(end+1) = iBigFaces(i);
end
if (length(I) ~= length(unique(I)))
    disp('BST> Error: The same vertex was selected multiple times in the high-resolution brain.');
    disp('BST> Using the basic reducepatch results instead...');
    [NewTessFile, iSurface, I, J] = tess_downsize( TessFile, newNbVertices, 'reducepatch');
    return;
end
NewTessMat.Faces(iRmFaces,:) = [];

faces       = NewTessMat.Faces;
vertices    = NewTessMat.Vertices;"
1187,dba_vol_grids.m,81.556,100,80.0,90,100.0,37.78,80-90,"function [SourceLoc] = dba_vol_grids(tess)

fac  = tess.Faces;
vert = tess.Vertices;

Xmax = max(vert(:,1));
Xmin = min(vert(:,1));
Ymax = max(vert(:,2));
Ymin = min(vert(:,2));
Zmax = max(vert(:,3));
Zmin = min(vert(:,3));

V = dba_mesh_volume(tess);
V = V*10e6;

if V<5
    p = 0.002;
elseif V<15
    p = 0.003;
else
    p = 0.004;
end
[x,y,z] = meshgrid(Xmin:p:Xmax,Ymin:p:Ymax,Zmin:p:Zmax);

[nx ny nz] = size(x);
Nbsources = nx*ny*nz;
SourceLoc = zeros(Nbsources,3);
c=0;
for i=1:nx
    for j=1:ny
        for k=1:nz
            c=c+1;
            SourceLoc(c,:) = [x(i,j,k) y(i,j,k) z(i,j,k)];
        end
    end
end
clear x y z

IS = inpolyhd(SourceLoc,vert,fac);
II = find(IS == 0);
k=0;
for i=1:length(II)
    SourceLoc = [SourceLoc(1:II(i,1)-1-k,:);SourceLoc(II(i,1)+1-k:end,:)];
    k=k+1;
end"
1188,DBConnect.m,83.674,100,73.47,100,100.0,44.9,80-90,"function DBConnect(host,user,password)



global dbUser;

CheckMyM;

cfHost = '';
cfUser = '';
cfPassword = '';
file = fopen('~/.my.cnf');
if file ~= -1,
	while true,
		line = fgetl(file);
		if isempty(line) | line == -1, break; end
		equal = findstr('=',line);
		if isempty(equal), continue; end
		switch line(1:equal-1),
			case 'host',
				cfHost = line(equal+1:end);
			case 'user',
				cfUser = line(equal+1:end);
			case 'password',
				cfPassword = line(equal+1:end);
		end
	end
	fclose(file);
end

if nargin < 3,
	password = cfPassword;
else
	warning('FMAToolbox:DBConnect:InsecureLogin','Providing your login/password in the function call is not secure.\\nPlease consider storing this sensitive information in your .my.cnf file instead')
end
if nargin < 2,
	user = cfUser;
end
if nargin < 1,
	host = cfHost;
end

dbUser = user;

try
	h = mym('open',host,user,password);
catch e
   error(['Could not connect to MySQL. Check your login/password (' e.message ').']);
end"
1189,DBDisplay.m,84.486,100,72.97,90,100.0,59.46,80-90,"function DBDisplay(results)



CheckMyM;

if nargin < 1,
	error('Incorrect number of parameters (type ''help <a href=""matlab:help DBDisplay"">DBDisplay</a>'' for details).');
end

if ~isfield(results,'eid') || ~isfield(results,'name'),
	error('Incorrect query results (type ''help <a href=""matlab:help DBDisplay"">DBDisplay</a>'' for details).');
end


title1 = 'EID';
title2 = 'NAME';
if isempty(results.eid),
	width1 = 0;
	width2 = 0;
else
	width1 = max(cellfun(@length,results.eid));
	width2 = max(cellfun(@length,results.name));
end
width1 = max([width1 length(title1)]);
width2 = max([width2 length(title2)]);
spacing = '     ';
total = width1+width2+3*length(spacing);
disp(' ');
disp(repmat('=',1,total));
disp([spacing sprintf(['%-' int2str(width1) 's%s%-' int2str(width2) 's'],'EID',spacing,'NAME')]);
disp(repmat('-',1,total'));
for i = 1:length(results.eid),
	disp([spacing sprintf(['%-' int2str(width1) 's%s%-' int2str(width2) 's'],results.eid{i},spacing,results.name{i})]);
end
disp(repmat('=',1,total'));
disp(' ');"
1190,dbFnCompileMatchingResults.m,80.702,100,62.16,90,100.0,51.35,80-90,"function r=dbFnCompileMatchingResults(outputBasePath, annotation, varargin) 

r=0;
global scores1stOrder scores2ndOrder processDatabaseImgNumber;

defaultArgs = struct('ColorSpaces', [], 'Techniques', [], 'Distances', [], 'Eval', []);
args = parseargs(defaultArgs, varargin{:});

n = processDatabaseImgNumber;

for e=1:length(args.Eval)
    for c=1:size(args.ColorSpaces,1)
        color = args.ColorSpaces{c,2};

        for t=1:length(args.Techniques)
            for d=1:length(args.Distances)
                matchingName = args.Techniques{t};

                try
                    scores2ndOrder(e,c,n,t,d) = str2double(annotation.(args.Eval{e})(color).(matchingName).joint.(args.Distances{d}));
                catch
                    scores2ndOrder(e,c,n,t,d) = -1;
                end

                try
                    dist1stVec = zeros(1,3);
                    for k=1:3
                        dist1stVec(k) = str2double(annotation.(args.Eval{e})(color).(matchingName).marginal(k).(args.Distances{d}));
                    end
                    scores1stOrder(e,c,n,t,d) = mean(dist1stVec);
                catch
                    scores1stOrder(e,c,n,t,d) = -1;
                end
            end
        end
    end
end"
1191,dbFnCoOccurencesGMM.m,81.278,100,65.57,90,100.0,50.82,80-90,"function dbFnCoOccurencesGMM(imgPath, imagesBasePath, outputBasePath, annotation, varargin)global histoIndices processDatabaseImgNumber;
 

addpath ../../3rd_party/color;
addpath ../histogram;


nbBins = 64;


defaultArgs = struct('Recompute', 1, 'ColorSpaces', []);
args = parseargs(defaultArgs, varargin{:});
args.Recompute = 1;

[imgOrig, imgInfo, recompute, xmlPath] = readImageInfo(imgPath, outputBasePath, annotation, '', args.Recompute);

if ~recompute
    fprintf('Already computed. Skipping...\\n');
    return;
elseif isempty(imgOrig)
    imgOrig = imread(imgPath);
end

imgOrig = imresize(imgOrig, [256,256], 'bilinear');

for type=1:length(args.ColorSpaces)
    if strcmp(args.ColorSpaces{type}, 'lab')
        fprintf('Converting to L*a*b*...');
        img = rgb2lab(imgOrig);

        mins = [0 -100 -100];
        maxs = [100 100 100];
        
        if type ~= 1
            error('dbFnCooccurencesGMM: color spaces mismatch');
        end
    elseif strcmp(args.ColorSpaces{type}, 'rgb')
        fprintf('Keeping RGB format...');
        img = imgOrig;
        
        mins = [0 0 0];
        maxs = [255 255 255];
        
        if type ~= 2
            error('dbFnCooccurencesGMM: color spaces mismatch');
        end
    else
        error('Color Space %s unsupported!', args.ColorSpace);
    end

    imgHist = imageHisto3D(img, ones(size(img,1), size(img,2)), nbBins, mins, maxs);

    fprintf('Storing the image index...');
    tic
    indHist = find(imgHist);
    for j=indHist(:)'
        histoIndices{type}{1,j} = [histoIndices{type}{1,j} processDatabaseImgNumber];
    end
    t = toc;
    fprintf('done in %f seconds!\\n', t);
end"
1192,dbFnCoOccurencesTextons.m,80.6,100,68.0,90,100.0,45.0,80-90,"function dbFnCoOccurencesTextons(imgPath, imagesBasePath, outputBasePath, annotation, varargin) 


addpath ../../3rd_party/parseArgs;
addpath ../../3rd_party/color;
addpath ../../3rd_party/vgg_matlab/vgg_general;
addpath ../database;
addpath ../histogram;
addpath ../xml;

defaultArgs = struct('Recompute', 1, 'ColorSpace', 'lab', 'ClusterCenters', [], 'N', 0);
args = parseargs(defaultArgs, varargin{:});
args.Recompute = 1;

[img, imgInfo, recompute, xmlPath] = readImageInfo(imgPath, outputBasePath, annotation, 'colorStatistics', args.Recompute);

if ~recompute
    fprintf('Already computed. Skipping...\\n');
    return;   
elseif isempty(img)
    img = imread(imgPath);
end

img = imresize(img, [256,256], 'bilinear');

if strcmp(args.ColorSpace, 'lab')
    fprintf('Converting to L*a*b*...');
    img = rgb2lab(img);
    
    mins = [0 -100 -100];
    maxs = [100 100 100];
    type = 1;
elseif strcmp(args.ColorSpace, 'rgb')
    mins = [0 0 0];
    maxs = [255 255 255];
    type = 2;
    error('Color Space %s unsupported!', args.ColorSpace);
else
    error('Color Space %s unsupported!', args.ColorSpace);
end

imgInfo.colorStatisticsTextons5x5Unsorted(type).colorSpace = args.ColorSpace;
[pathstr, name, ext, versn] = fileparts(annotation.filename);

nbClusters = size(args.ClusterCenters, 2);

imgInfo.colorStatisticsTextons5x5Unsorted(type).nbClusters= nbClusters;

N = args.N;
nbPatchesRow = 256-N+1;
imagePatches = zeros(nbPatchesRow^2, (N^2)*3);

lims = ceil(N/2):ceil(N/2)+nbPatchesRow-1;
halfSize = floor(N/2);
fprintf('Gathering patches...'); tic;
c=1;
for i=lims
    for j=lims
        patch = reshape(img(i-halfSize:i+halfSize, j-halfSize:j+halfSize, :), N^2, 3);
        
        ind = 1:size(patch,1);
        patch = reshape(patch(ind, :), 1, N^2*3);
        
        imagePatches(c,:) = patch;
        c = c+1;
    end
end
t = toc;
fprintf('done in %.2f sec.\\n', t);

fprintf('Quantizing the image...'); tic;
[quantizedPatches, d] = vgg_nearest_neighbour(imagePatches', args.ClusterCenters);
t=toc; fprintf('done in %.2f sec.\\n', t);


textonHist1stOrder = sparse(myHistoND(quantizedPatches, nbClusters, 1, nbClusters));

outputDirName = fullfile('colorStatisticsTextons5x5Unsorted', args.ColorSpace, '1stOrder');
outputFileName = fullfile(outputDirName, sprintf('%s.mat', name));
[d,d,d] = mkdir(fullfile(outputBasePath, annotation.folder, outputDirName));
save(fullfile(outputBasePath, annotation.folder, outputFileName), 'textonHist1stOrder');

imgInfo.colorStatisticsTextons5x5Unsorted(type).firstOrder.file = outputFileName;


colorInd = find(textonHist1stOrder);

textonHist2ndOrder = sparse(nbClusters, nbClusters);

textonHist2ndOrder(colorInd,:) = repmat(textonHist1stOrder(:)', length(colorInd), 1);

outputDirName = fullfile('colorStatisticsTextons5x5Unsorted', args.ColorSpace, '2ndOrder');
outputFileName = fullfile(outputDirName, sprintf('%s.mat', name));
[d,d,d] = mkdir(fullfile(outputBasePath, annotation.folder, outputDirName));
save(fullfile(outputBasePath, annotation.folder, outputFileName), 'textonHist2ndOrder');

imgInfo.colorStatisticsTextons5x5Unsorted(type).secondOrder.file = outputFileName;

fprintf('Saving xml file: %s\\n', xmlPath);
writeStructToXML(imgInfo, xmlPath);"
1193,dbFnEvaluateMatchingHisto.m,82.304,80,69.52,90,100.0,72.0,80-90,"function dbFnEvaluateMatchingHisto(annotation, dbPath, outputBasePath, varargin)%% Initialize
addpath ../../3rd_party/parseArgs;
addpath ../../3rd_party/color;
addpath ../../3rd_party/LabelMeToolbox/;
addpath ../database;
addpath ../histogram;
addpath ../xml;
 

defaultArgs = struct('Recompute', 1, 'ColorSpace', 'rgb', 'Histo1stOrder', [], 'Histo2ndOrder', []);
args = parseargs(defaultArgs, varargin{:});

imgPath = fullfile(dbPath, annotation.image.folder, 'lossless', annotation.image.filename);
img = imread(imgPath);

[pathstr, fileName, ext, versn] = fileparts(annotation.image.filename);
xmlPath = fullfile(outputBasePath, sprintf('%s.xml', fileName));
if exist(xmlPath, 'file')
    imgInfo = readStructFromXML(xmlPath);
else
    imgInfo.image = annotation.image;
end

nbBins1stOrder = size(args.Histo1stOrder, 1);
nbBins2ndOrder = size(args.Histo2ndOrder, 1);


if strcmp(args.ColorSpace, 'lab')
    fprintf('Converting to L*a*b*...');
    img = rgb2lab(img);
    
    mins = [0 -100 -100];
    maxs = [100 100 100];
    type = 1;
elseif strcmp(args.ColorSpace, 'rgb')
    mins = [0 0 0];
    maxs = [255 255 255];
    type = 2;
else
    error('Color Space %s unsupported!', args.ColorSpace);
end

imgInfo.colorStatistics(type).colorSpace = args.ColorSpace;

if ~isfield(annotation, 'object')
    fprintf('Image contains no labelled objects. Skipping...\\n');
    return;
end

objInd = 1;

wSrc = sscanf(annotation.object(objInd).imgSrc.size.width, '%f');
hSrc = sscanf(annotation.object(objInd).imgSrc.size.height, '%f');

[xPoly, yPoly] = getLMpolygon(annotation.object(objInd).polygon);
objPoly = [xPoly yPoly]';
objPoly = objPoly .* repmat(([256 256]' ./ [wSrc hSrc]'), 1, size(objPoly, 2));
objMask = poly2mask(objPoly(1,:), objPoly(2,:), 256, 256); 


fprintf('1st-order...');
img = reshape(img, 256*256, 3);
histImage = myHistoND(img, nbBins1stOrder, mins, maxs);
histImage = histImage ./ sum(histImage(:));

args.Histo1stOrder = args.Histo1stOrder ./ sum(args.Histo1stOrder(:));

dist1stOrderChi = chisq(histImage, args.Histo1stOrder);
dist1stOrderDot = histImage(:)' * args.Histo1stOrder(:);

imgInfo.colorStatistics(type).matchingEvaluationHisto.firstOrder.distChi = dist1stOrderChi;
imgInfo.colorStatistics(type).matchingEvaluationHisto.firstOrder.distDot = dist1stOrderDot;

fprintf('2nd-order...');
histObj = myHistoND(img(objMask(:),:), nbBins2ndOrder, mins, maxs);
histObj = histObj ./ sum(histObj(:));

histBg = myHistoND(img(~objMask(:),:), nbBins2ndOrder, mins, maxs);
histBg = histBg ./ sum(histBg(:));

colorInd = find(histObj);

sumDbHist = zeros(size(histBg));
for c=colorInd(:)'
    [i1,i2,i3] = ind2sub(size(histObj), c);
    
    tmpHist = squeeze(args.Histo2ndOrder(i1,i2,i3,:,:,:));
    if sum(tmpHist(:)) ~= 0
        tmpHist = tmpHist ./ sum(tmpHist(:));
    end
    
    sumDbHist = sumDbHist + tmpHist;
end 

sumDbHist = sumDbHist ./ sum(sumDbHist(:));

dist2ndOrderChi = chisq(histBg, sumDbHist);
dist2ndOrderDot = histBg(:)' * sumDbHist(:);

imgInfo.colorStatistics(type).matchingEvaluationHisto.secondOrder.distChi = dist2ndOrderChi;
imgInfo.colorStatistics(type).matchingEvaluationHisto.secondOrder.distDot = dist2ndOrderDot;
fprintf('done!\\n');

fprintf('Saving xml file: %s\\n', xmlPath);
writeStructToXML(imgInfo, xmlPath);"
1194,dbFnEvaluateMatchingLocalSignatures.m,81.018,100,67.92,90,100.0,47.17,80-90,"function r=dbFnEvaluateMatchingLocalSignatures(outputBasePath, annotation, varargin) 

r=0;

defaultArgs = struct('ColorSpace', [], 'DbPath', [], 'ImagesPath', []);
args = parseargs(defaultArgs, varargin{:});

load(fullfile(args.DbPath, annotation.file.folder, annotation.object.masks.filename));

xmlPath = fullfile(outputBasePath, annotation.file.folder, annotation.file.filename);
imgInfo = loadXML(xmlPath);

if strcmp(args.ColorSpace, 'lab')
    type = 1;
    
elseif strcmp(args.ColorSpace, 'rgb')
    type = 2;
    
elseif strcmp(args.ColorSpace, 'hsv')
    type = 3;
    
elseif strcmp(args.ColorSpace, 'lalphabeta')
    type = 4;
else
    error('Color Space %s unsupported!', args.ColorSpace);
end

imgInfo.localEval(type).colorSpace = args.ColorSpace;

load(fullfile(args.DbPath, annotation.file.folder, annotation.signatures(type).filename));

distMat = pdist2(centersObj', centersBg');
[distEMD, flowEMD] = emd_mex(weightsObj', weightsBg', distMat);

sigma = 25;
clusterShift = zeros(length(centersObj), 3);
for c=1:length(centersObj)
    dstClusters = flowEMD(flowEMD(:,1) == c, 2);
    weights = flowEMD(flowEMD(:,1) == c, 3);
    
    shifts = centersBg(dstClusters, :) - repmat(centersObj(c, :), [length(dstClusters) 1]); %#ok
    clusterShift(c,:) = sum(shifts .* repmat(weights, [1 3]), 1) ./ sum(weights);
    
    clusterShift(c,:) = clusterShift(c,:) .* exp(-abs(clusterShift(c,:)).^2./(sigma.^2));
end

totClusterShift = sum(sqrt(sum(clusterShift.^2, 2)) .* weightsObj) ./ sum(weightsObj);

imgInfo.localEval(type).objBgDst.joint.distEMD = distEMD;
imgInfo.localEval(type).objBgDst.joint.distEMDWeighted = totClusterShift;

fprintf('Saving xml file: %s\\n', xmlPath);
writeXML(xmlPath, imgInfo);"
1195,dbFnEvaluateMatchingNN.m,83.424,100,72.88,90,100.0,54.24,80-90,"function r=dbFnEvaluateMatchingNN(outputBasePath, annotation, varargin)
r=0;

defaultArgs = struct('ColorSpaces', [], 'Types', [], 'CompTypes', [], 'DbPath', [], 'ObjectDb', []);
args = parseargs(defaultArgs, varargin{:});
clear('varargin');

xmlPath = fullfile(outputBasePath, annotation.file.folder, annotation.file.filename);
imgInfo = loadXML(xmlPath);

fprintf('Finding indices in the database...');
objImgInd = getDatabaseIndexFromFilename(args.ObjectDb, 'document', annotation.objImgSrc.folder, annotation.objImgSrc.filename);
bgImgInd = getDatabaseIndexFromFilename(args.ObjectDb, 'document', annotation.bgImgSrc.folder, annotation.bgImgSrc.filename);
fprintf('done.');

fprintf('Computing nearest-neighbors...');
for c=1:length(args.ColorSpaces)
    if strcmp(args.ColorSpaces{c}, 'lab')
        colorType = 1;
    elseif strcmp(args.ColorSpaces{c}, 'lalphabeta')
        colorType = 4;
    else
        error('Unsupported color type!');
    end
    
    for t=1:length(args.Types)
        compDistancesFile = fullfile(args.DbPath, annotation.file.folder, annotation.global.distNN.(args.CompTypes{t})(colorType).distChi.filename);
        load(compDistancesFile);
        compDistances = distances;

        distancesFile = fullfile(args.DbPath, annotation.file.folder, annotation.global.distNN.(args.Types{t})(colorType).distChi.filename);
        load(distancesFile);
        origDistances = distances;
        
        validOrigInd = origDistances >= 0;
        validCompInd = compDistances >= 0;
        
        validInd = find(validOrigInd & validCompInd);
        validInd = setdiff(validInd, [objImgInd bgImgInd]);
        
        for alpha=[0.25 0.5 0.75]
            dist = alpha.*origDistances(validInd) + (1-alpha).*compDistances(validInd);

            type = sprintf('%s_%d', args.Types{t}, alpha*100);
            
            if ~isempty(strfind(args.Types{t}, 'marg'))
                imgInfo.globalEval(colorType).(type).marginal(1).distChi = min(dist);
                imgInfo.globalEval(colorType).(type).marginal(2).distChi = min(dist);
                imgInfo.globalEval(colorType).(type).marginal(3).distChi = min(dist);
            else
                imgInfo.globalEval(colorType).(type).joint(1).distChi = min(dist);
            end
        end
    end
end
fprintf('done.\\n');

fprintf('Saving xml file: %s\\n', xmlPath);
writeXML(xmlPath, imgInfo);"
1196,dbFnEvaluateMatchingNNColorTextonThreshold.m,83.788,100,73.68,90,100.0,55.26,80-90,"function r=dbFnEvaluateMatchingNNColorTextonThreshold(outputBasePath, annotation, varargin)
r=0;

defaultArgs = struct('ColorSpaces', [], 'Types', [], 'CompTypes', [], 'TextonTypes',[], 'TextonCompTypes', [], ...
    'DbPath', [], 'ObjectDb', [], 'ImagesPath', []);
args = parseargs(defaultArgs, varargin{:});
clear('varargin');

xmlPath = fullfile(outputBasePath, annotation.file.folder, annotation.file.filename);
imgInfo = loadXML(xmlPath);

fprintf('Finding indices in the database...');
objImgInd = getDatabaseIndexFromFilename(args.ObjectDb, 'document', annotation.objImgSrc.folder, annotation.objImgSrc.filename);
bgImgInd = getDatabaseIndexFromFilename(args.ObjectDb, 'document', annotation.bgImgSrc.folder, annotation.bgImgSrc.filename);
fprintf('done.');

fprintf('Computing nearest-neighbors...');
for c=1:length(args.ColorSpaces)
    if strcmp(args.ColorSpaces{c}, 'lab')
        colorType = 1;
    elseif strcmp(args.ColorSpaces{c}, 'lalphabeta')
        colorType = 4;
    else
        error('Unsupported color type!');
    end
    
    for t=1:length(args.Types)
        compDistancesFile = fullfile(args.DbPath, annotation.file.folder, annotation.global.distNN.(args.CompTypes{t})(colorType).distChi.filename);
        load(compDistancesFile);
        compDistances = distances;

        distancesFile = fullfile(args.DbPath, annotation.file.folder, annotation.global.distNN.(args.Types{t})(colorType).distChi.filename);
        load(distancesFile);
        origDistances = distances;
        
        textonDistancesFile = fullfile(args.DbPath, annotation.file.folder, annotation.global.distTextonNN.(args.TextonTypes{t}).distChi.filename);
        load(textonDistancesFile);
        textonDistances = distances;
        
        textonDistancesFile = fullfile(args.DbPath, annotation.file.folder, annotation.global.distTextonNN.(args.TextonCompTypes{t}).distChi.filename);
        load(textonDistancesFile);
        textonCompDistances = distances;
        
        validOrigInd = origDistances >= 0;
        validCompInd = compDistances >= 0;
        validTextonInd = textonDistances >= 0;
        
        validInd = find(validOrigInd & validCompInd & validTextonInd);
        validInd = setdiff(validInd, [objImgInd bgImgInd]);
        
        alphas = 0.5;
        for alpha=alphas
            avgOrigDistances = alpha .* origDistances + (1-alpha) .* textonDistances;
            avgCompDistances = alpha .* compDistances + (1-alpha) .* textonCompDistances;

            [sortedDist, sortedInd] = sort(avgOrigDistances(validInd));
            goodInd = sortedInd(1:50);

            dist = avgCompDistances(validInd(goodInd));
            
            N = 10;
            nnMontage = zeros(256, 256, 3, N, 'uint8');
            for i=1:N
                nnImgInfo = args.ObjectDb(validInd(goodInd(i))).document;
                im = imread(fullfile(args.ImagesPath, nnImgInfo.image.folder, nnImgInfo.image.filename));
                nnMontage(:,:,:,i) = imresize(im, [256 256], 'bilinear');
                imwrite(im, sprintf('nnImg/nnImg_%04d.jpg', i), 'Quality', 100);
            end
            
            montage(nnMontage);
        end
    end
end
fprintf('done.\\n');

fprintf('Saving xml file: %s\\n', xmlPath);"
1197,dbFnEvaluateMatchingNNThreshold.m,83.0,100,73.33,90,100.0,51.67,80-90,"function r=dbFnEvaluateMatchingNNThreshold(outputBasePath, annotation, varargin)
r=0;

defaultArgs = struct('ColorSpaces', [], 'Types', [], 'CompTypes', [], 'DbPath', [], 'ObjectDb', []);
args = parseargs(defaultArgs, varargin{:});
clear('varargin');

xmlPath = fullfile(outputBasePath, annotation.file.folder, annotation.file.filename);
imgInfo = loadXML(xmlPath);

fprintf('Finding indices in the database...');
objImgInd = getDatabaseIndexFromFilename(args.ObjectDb, 'document', annotation.objImgSrc.folder, annotation.objImgSrc.filename);
bgImgInd = getDatabaseIndexFromFilename(args.ObjectDb, 'document', annotation.bgImgSrc.folder, annotation.bgImgSrc.filename);
fprintf('done.');

fprintf('Computing nearest-neighbors...');
for c=1:length(args.ColorSpaces)
    if strcmp(args.ColorSpaces{c}, 'lab')
        colorType = 1;
    elseif strcmp(args.ColorSpaces{c}, 'lalphabeta')
        colorType = 4;
    else
        error('Unsupported color type!');
    end
    
    for t=1:length(args.Types)
        compDistancesFile = fullfile(args.DbPath, annotation.file.folder, annotation.global.distNN.(args.CompTypes{t})(colorType).distChi.filename);
        load(compDistancesFile);
        compDistances = distances;

        distancesFile = fullfile(args.DbPath, annotation.file.folder, annotation.global.distNN.(args.Types{t})(colorType).distChi.filename);
        load(distancesFile);
        origDistances = distances;
        
        validOrigInd = origDistances >= 0;
        validCompInd = compDistances >= 0;
        
        validInd = find(validOrigInd & validCompInd);
        validInd = setdiff(validInd, [objImgInd bgImgInd]);
        
        [sortedDist, sortedInd] = sort(origDistances(validInd));
        goodInd = sortedInd(1:50);
        
        dist = compDistances(validInd(goodInd));
        
        type = sprintf('%s_threshold', args.Types{t});

        if ~isempty(strfind(args.Types{t}, 'marg'))
            imgInfo.globalEval(colorType).(type).marginal(1).distChi = min(dist);
            imgInfo.globalEval(colorType).(type).marginal(2).distChi = min(dist);
            imgInfo.globalEval(colorType).(type).marginal(3).distChi = min(dist);
        else
            imgInfo.globalEval(colorType).(type).joint(1).distChi = min(dist);
        end
    end
end
fprintf('done.\\n');

fprintf('Saving xml file: %s\\n', xmlPath);
writeXML(xmlPath, imgInfo);"
