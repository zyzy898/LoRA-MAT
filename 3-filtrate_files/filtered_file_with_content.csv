3222,CORAerror.m,74.546,70,58.73,100,100.0,44.0,70-80,"function ME = CORAerror(identifier,varargin)



st = dbstack(""-completenames"");

try
    [filename,classname,functionname,sprintfFilesep] = aux_readInfo(st);
catch ME
    if strcmp(ME.identifier, 'MATLAB:needMoreRhsOutputs')
        CORAwarning('CORA:global', ...
            ['You are very likely attempting to call CORAerror ',...
                'from the MATLAB console; please do not do that, as ',...
                'CORAerror will then be unable to trace back from where ',...
                'the error originates.']);

        filename = 'filename';
        classname = 'classname';
        functionname = 'functionname';
        sprintfFilesep = '/';
    else
        rethrow(ME);
    end
end

if ~strcmp(classname,functionname)
    helpmsg = sprintf(""  Type 'help %s%s%s' for more information."",...
        classname,sprintfFilesep,functionname);
else
    helpmsg = sprintf(""  Type 'help %s' for more information."",classname);
end

NVpairs = varargin;


switch identifier

    case 'CORA:wrongInputInConstructor'
        errmsg_form = 'Wrong input arguments for constructor of class: %s\\n  %s \\n%s';
        infomsg = varargin{1};
        errmsg = sprintf(errmsg_form,classname,infomsg,helpmsg);


    case 'CORA:noInputInSetConstructor'
        errmsg_form = 'No input arguments for constructor of class: %s\\n  %s \\n%s';
        infomsg = ['Please consider calling ' classname '.empty or ' classname '.Inf instead.'];
        errmsg = sprintf(errmsg_form,classname,infomsg,helpmsg);


    case 'CORA:dimensionMismatch'
        obj1 = varargin{1};
        obj2 = varargin{2};

        name1 = class(obj1);
        name2 = class(obj2);
        if isa(obj1,'contSet') && ~isa(obj1,'interval') && ~isa(obj1,'taylm') ...
                && ~isa(obj1,'zoo') && ~isa(obj1,'affine')
            dimOrSize1 = dim(obj1);
        else % range-bounding, matrixSet, numeric
            dimOrSize1 = size(obj1);
        end
        if isa(obj2,'contSet') && ~isa(obj2,'interval') && ~isa(obj2,'taylm') ...
                && ~isa(obj2,'zoo') && ~isa(obj2,'affine')
            dimOrSize2 = dim(obj2);
        else % range-bounding, matrixSet, numeric
            dimOrSize2 = size(obj2);
        end

        errmsg = ['The first object (' name1 ') '];
        if isscalar(dimOrSize1)
            errmsg = [errmsg 'is defined in dimension ' num2str(dimOrSize1)];
        else
            errmsg = [errmsg 'has size ' num2str(dimOrSize1(1)) '-by-' num2str(dimOrSize1(2))];
        end

        errmsg = [errmsg ',\\nbut the second object (' name2 ') '];
        if isscalar(dimOrSize2)
            errmsg = [errmsg 'is defined in dimension ' num2str(dimOrSize2)];
        else
            errmsg = [errmsg 'has size ' num2str(dimOrSize2(1)) '-by-' num2str(dimOrSize2(2))];
        end
        errmsg = [errmsg '.'];


    case 'CORA:emptySet'
        errmsg = 'Set is empty!';


    case 'CORA:converterIssue'
        infomsg = varargin{1};
        try
            convertername = aux_readConverter(st);
            errmsg = ['Error in converter ' convertername ':\\n  ' infomsg];
        catch
            errmsg = ['Error in converter:\\n  ' infomsg];
        end


    case 'CORA:configFile'
        issue = varargin{1};
        errmsg_form = 'Error in generation of configuration file:\\n   %s';
        errmsg = sprintf(errmsg_form,issue);


    case 'CORA:fileNotFound'
        providedfile = varargin{1};
        errmsg = ['File with name ' providedfile ' could not be found.'];


    case 'CORA:wrongValue'
        arg = varargin{1};
        explains = varargin{2};
        if iscell(explains)
            explains = strjoin(explains,', ');
        end

        if contains(arg,'name-value pair')
            errmsg_form = ""Wrong value for %s.\\n"" + ...
                ""  The right value: %s\\n%s"";
        else
            errmsg_form = ""Wrong value for the %s input argument.\\n"" + ...
                ""  The right value: %s\\n%s"";
        end
        errmsg = sprintf(errmsg_form,arg,explains,helpmsg);


    case 'CORA:noExactAlg'
        classlist = """";
        for i=1:length(varargin)-1
            classlist = classlist + string(class(varargin{i})) + "", "";
        end
        if ~isstring(varargin{end})
            classlist = classlist + string(class(varargin{end})) + ""."";
            errmsg = sprintf(...
                ""There is no exact algorithm for function %s with input arguments:\\n  %s"",...
                filename,classlist);
        else
            classlist = classlist;
            infomsg = varargin{end};
            errmsg = sprintf(...
                ""There is no exact algorithm for function %s with input arguments:\\n  %s %s"",...
                filename,classlist,infomsg);
        end
        
    case 'CORA:noSpecificAlg'
        algorithm = varargin{1};
        classlist = """";
        for i=2:length(varargin)-1
            classlist = classlist + string(class(varargin{i})) + "", "";
        end
        if ~isstring(varargin{end})
            classlist = classlist + string(class(varargin{end})) + ""."";
            errmsg = sprintf(...
                ""There is no algorithm '%s' for function %s with input arguments:\\n  %s"",...
                algorithm,filename,classlist);
        else
            classlist = classlist;
            infomsg = varargin{end};
            errmsg = sprintf(...
                ""There is no algorithm '%s' for function %s with input arguments:\\n  %s %s"",...
                algorithm,filename,classlist,infomsg);
        end

    
    case 'CORA:solverIssue'
        solver = '';
        if ~isempty(varargin)
            solver = [' (',varargin{1},')'];
        end
        errmsg = sprintf(...
            ""Solver%s in %s failed due to numerical/other issues! \\n %s"",...
            solver,filename,helpmsg);
    

    case 'CORA:noSuitableSolver'
        type = '';
        if ~isempty(varargin)
            type = varargin{1};
        end
        errmsg = sprintf(""No suitable %s solver found!"",type);


    case 'CORA:notConverged'
        issue = varargin{1};
        errmsg_form = '%s did not converge.';
        errmsg = sprintf(errmsg_form,issue);


    case 'CORA:emptyProperty'
        errmsg = 'Property is empty.';


    case 'CORA:wrongFieldValue'
        field = varargin{1};
        allowedValues = varargin{2};
        if ~iscell(allowedValues) && ischar(allowedValues)
            allowedValues = string(allowedValues);
        end
        allowedValues = ""'"" + strjoin(allowedValues,""', '"") + ""'"";

        errmsg_form = ""Wrong value for the field '%s'.\\n"" + ...
            ""  Admissible values: %s\\n"";
        errmsg = sprintf(errmsg_form,field,allowedValues);


    case 'CORA:plotProperties'
        num = varargin{1};
        if num == 1
            errmsg = 'At least one dimension has to be specified.';
        elseif num == 2 % deprecated
            errmsg = 'At least two dimensions have to be specified.';
        elseif num == 3
            errmsg = 'Only up to three dimensions can be specified.';
        else
            errmsg = 'Incorrect number of dimensions specified.';
        end

    case 'CORA:evenNumberInputArgs'
        errmsg_form = 'The function %s requires an even number of input argument(s).\\n %s';
        errmsg = sprintf(errmsg_form,filename,helpmsg);

    case 'CORA:oddNumberInputArgs'
        errmsg_form = 'The function %s requires an odd number of input argument(s).\\n %s';
        errmsg = sprintf(errmsg_form,filename,helpmsg);

    case 'CORA:numInputArgsConstructor'
        numValidArgs = varargin{1};
        if numValidArgs(end) == Inf
            numstr = char(strjoin(string(numValidArgs(1:end-2)),"", "") ...
                + "" or "" + string(numValidArgs(end-1)) + "" to Inf"");
        else
            numstr = char(strjoin(string(numValidArgs(1:end-1)),"", "")) ...
                + "" or "" + string(numValidArgs(end));
        end
        if numel(numValidArgs) == 1
            errmsg_form = 'The constructor of the %s class requires exactly %s input argument.\\n %s';
        else
            errmsg_form = 'The constructor of the %s class requires either %s input arguments.\\n %s';
        end
        errmsg = sprintf(errmsg_form,filename(1:end-2),numstr,helpmsg);


    case 'CORA:redundantNameValuePair'
        name = varargin{1};
        listofnames = varargin{2};
        errmsg_form = ['The name-value pair with the name ''%s'''...
            ' is redundant for the function %s.\\n' ...
            'The list of admissible names is: ''%s''.\\n%s'];
        errmsg = sprintf(errmsg_form,name,filename,...
            strjoin(listofnames,''', '''),helpmsg);


    case 'CORA:degenerateSet'
        errmsg = varargin{1};


    case 'CORA:YALMIP'
        errmsg = varargin{1};


    case 'CORA:outOfDomain'
        [NVpairs,validDomain] = readNameValuePair(NVpairs,'validDomain');
        if isa(validDomain,'interval')
            validDomain = string(validDomain);
        end
        varname = 'interval';
        if ~isempty(NVpairs) && (isstring(NVpairs{1}) || ischar(NVpairs{1}))
            varname = varargin{1};
        end
        errmsg_form = ['%s is not inside the valid domain (function %s).'...
            '\\n   Valid domain is: %s \\n %s'];
        errmsg = sprintf(errmsg_form,varname,filename,validDomain,helpmsg);


    case 'CORA:specialError'
        errmsg = varargin{1};


    case 'CORA:notSupported'
        errmsg = varargin{1};


    case 'CORA:notDefined'
        errmsg = sprintf('Undefined functionality: %s', varargin{1});
        if length(varargin) == 2
            errmsg = sprintf('%s\\nSee also: %s', errmsg, varargin{2});
        end


    case 'CORA:nnLayerNotSupported'
        layer = varargin{1};
        unsupComp = varargin{2};
        errmsg = sprintf(""Computation of %s is not supported by %s (%s)."", ...
            unsupComp, class(layer), layer.name);

    
    case 'CORA:reachSetExplosion'
        errmsg = 'Abort analysis due to reachable set explosion!';


    case 'CORA:outOfMemory'
        errmsg = sprintf('Out of memory. ');
        if length(varargin) == 2
            ME = varargin{2};
            errmsg = sprintf('%s%s\\n',errmsg,ME.message);
        end
        errmsg = sprintf('%s%s',errmsg,varargin{1});

    case 'CORA:noops'
        classlist = """";
        addinfo = """";
        punct = "", "";
        for i=1:length(varargin)
            if strcmp(string(class(varargin{i})),'double')
                if isscalar(varargin{i})
                    addinfo = ""-scalar"";
                elseif isvector(varargin{i})
                    if size(varargin{i},1) == 1
                        addinfo = ""-vector (row)"";
                    else
                        addinfo = ""-vector (column)"";
                    end
                else
                    addinfo = ""-matrix"";
                end
            elseif strcmp(string(class(varargin{i})),'levelSet')
                compOps = strjoin(cellstr(unique(varargin{i}.compOp)),',');
                addinfo = "" (comparison operator: '"" + compOps + ""')"";
            end
            if i == length(varargin)
                punct = ""."";
            end
            classlist = classlist + string(class(varargin{i})) + addinfo + punct;
            addinfo = """";
        end
        errmsg = sprintf(...
            ""The function '%s' is not implemented for the following arguments:\\n  %s \\n%s"",...
            filename,classlist,helpmsg);


    case 'CORA:install'
        errmsg = varargin{1};


    case 'CORA:reportToDev'
        infostr = 'Please report this error to the developers.';
        errmsg = sprintf(""%s\\n  %s"",varargin{1},infostr);
        

    otherwise
        error(""Bug: Identifier not specified!"");

end

ME = MException(identifier,errmsg);

end



function [filename,classname,functionname,sprintfFilesep] = aux_readInfo(st)

stlength = length(st);

errIdx = [];
for i=1:stlength
    if ~any(strcmp(st(i).name,{'CORAerror','inputArgsCheck'}))
        errIdx = i;
        if any(strcmp(st(i).name,...
                {'checkNameValuePairs','assertNarginConstructor'}))
            errIdx = i+1;
        end
        break
    end
end

if isempty(errIdx)
    filename = 'command window';
    classname = '<command window call>';
    functionname = '';
    sprintfFilesep = filesep;
    return
end

[~,filename,~] = fileparts(st(errIdx).file);
if contains(filename,'.')
    filename = filename(strfind(filename,'.')+1:end);
end

subfilename = st(errIdx).name;
if contains(subfilename,'.')
    subfilename = subfilename(strfind(subfilename,'.')+1:end);
end

if strcmp(filename, subfilename)
    filename = ['<strong>' filename '</strong>'];
else
    filename = ['<strong>' filename '>' subfilename '</strong>'];
end

filesepPos = strfind(st(errIdx).file,filesep);

atPos = strfind(st(errIdx).file,'@');
dotPos = strfind(st(errIdx).file,'.');
dotPos = dotPos(end); % in case multiple dots appear within the path

if ~isempty(atPos)
    filesepPosAfterAt = filesepPos(filesepPos > atPos);
    
    classname = extractBetween(st(errIdx).file,atPos+1,filesepPosAfterAt(1)-1);
    classname = classname{1};

    functionname = extractBetween(st(errIdx).file,filesepPosAfterAt(1)+1,dotPos-1);
    functionname = functionname{1};
else
    fileSepAfterCORA = filesepPos(filesepPos > length(CORAROOT));

    if isscalar(fileSepAfterCORA)
        classname = 'CORAROOT';
        functionname = st(errIdx).file(fileSepAfterCORA(1:end-1));
    else
        classname = extractBetween(st(errIdx).file,fileSepAfterCORA(1)+1,fileSepAfterCORA(end)-1);
        classname = classname{1};
    
        functionname = extractBetween(st(errIdx).file,fileSepAfterCORA(end)+1,dotPos-1);
        functionname = functionname{1};
    end
end

if filesep == '\\'
    sprintfFilesep = '\\\\';
    if contains(functionname,'\\')
        functionname = strrep(functionname,filesep,'\\\\');
    end
    if isempty(atPos) && contains(classname,'\\')
        classname = strrep(classname,filesep,'\\\\');
    end
else
    sprintfFilesep = filesep;
end

end

function convertername = aux_readConverter(st)

temp = st(2).file;

if contains(temp,[CORAROOT filesep 'converter'])
    convPos = strfind(temp,'converter');
    temp = temp(convPos+10:end);
    filesepPos = strfind(temp,filesep);
    convertername = temp(1:filesepPos(1)-1);
else
    throw(CORAerror('CORA:specialError',...
        'Converter error thrown outside of converter directory.'));
end

end"
3223,CORAGITBRANCH.m,78.918,100,54.05,100,100.0,40.54,70-80,"function gitbranch = CORAGITBRANCH()



gitbranch = '';

currDir = pwd;

try
    if isMATLABReleaseOlderThan('R2024a')
        throw(CORAerror('CORA:specialError','This function is only available for Matlab version >=R2024a.'))
    end

    cd(CORAROOT);

    matlab.git.addSafeDirectory(CORAROOT)
    
    repo = gitrepo;

    if isempty(repo.CurrentBranch)
       throw(MException('shared_cmlink:git:RepositoryNotFound','No git branch is available.')) % reusing identifier here.
    end
    gitbranch = repo.CurrentBranch.Name;

    cd(currDir)

catch ME
    cd(currDir)

    if strcmp(ME.identifier,'shared_cmlink:git:RepositoryNotFound')
        CORAwarning('CORA:global','CORA does not have a git repository associated with its root folder.')
    else 
        rethrow(ME)
    end
end

end"
3224,CORAlinprog.m,73.7,80,48.28,100,100.0,40.22,70-80,"function [x,fval,exitflag,output,lambda] = CORAlinprog(problem)



persistent isMosek
if isempty(isMosek)
    isMosek = isSolverInstalled('mosek');
end

if isMosek
    [f,a,blc,buc,blx,bux,param,cmd] = linprog2mosek(problem);

    res = msklpopt(f,a,blc,buc,blx,bux,param,cmd);

    if strcmp(res.sol.itr.prosta,'PRIMAL_AND_DUAL_FEASIBLE')
        exitflag = 1;

        x = [];
        if isfield(res,'sol')
            if isfield(res.sol,'itr')
                x = res.sol.itr.xx;
            else
                x = res.sol.bas.xx;
            end
        end
        fval = f'*x;

    else
        try % We are not certain that the simplex algorithm has indeed been
            prosta = res.sol.bas.prosta;
        catch ME
            prosta = '';
        end

        if strcmp(res.sol.bas.prosta,'PRIMAL_AND_DUAL_FEASIBLE')
            exitflag = 1;

            x = [];
            if isfield(res,'sol')
                if isfield(res.sol,'itr')
                    x = res.sol.itr.xx;
                else
                    x = res.sol.bas.xx;
                end
            end
            fval = f'*x;

        else

            x = [];
            fval = [];

            if strcmp(res.sol.itr.prosta,'PRIMAL_INFEASIBLE')
                exitflag = -2;
            elseif strcmp(res.sol.itr.prosta,'DUAL_INFEASIBLE')
                exitflag = -3;
            else
                throw(CORAerror('CORA:solverIssue'));
            end
        end
    end

    if nargout >= 4
        output = [];
    end
    if nargout >= 5
        lambda = [];
    end

else
    if isfield(problem,'options')
        options = {problem.options};
    else
        options = {};
        
        persistent optionsDualSimplexDefault
        if isempty(optionsDualSimplexDefault)
            optionsDualSimplexDefault = optimoptions('linprog','Algorithm','dual-simplex','display','off');
        end
        options = [options {optionsDualSimplexDefault}];

        if ~isMATLABReleaseOlderThan('R2024a')
            persistent optionsDualSimplexLegacy
            if isempty(optionsDualSimplexLegacy)
                w = warning; warning off; % don't show legacy warning
                optionsDualSimplexLegacy = optimoptions('linprog','Algorithm','dual-simplex-legacy','display','off');
                warning(w);
            end
            options = [options {optionsDualSimplexLegacy}];
        end
    end

    for i=1:numel(options)

        problem.options = options{i};
        algorithm = problem.options.Algorithm;
        problem.solver = 'linprog';
    
        [x,fval,exitflag,output,lambda] = aux_MATLABlinprog(problem,algorithm);
    
        if exitflag == -9 && startsWith(algorithm,'dual-simplex')
            algorithm = 'interior-point';
            [x,fval,exitflag,output,lambda] = aux_MATLABlinprog(problem,algorithm);
        end

        if exitflag > 0
            break;
        end
    end
end

end



function [x,fval,exitflag,output,lambda] = aux_MATLABlinprog(problem,algorithm)

w = warning; warning off; % don't show legacy warning
try
    problem.options.Algorithm = algorithm; % set the solver
    [x,fval,exitflag,output,lambda] = linprog(problem);

catch ME
    if strcmp(ME.identifier,'optim:linprog:NonDoubleInput')

       warning on;
       CORAwarning(""CORA:solver"",'Not all given fields for the linear program are of type double. Re-trying with converted values.')
       warning off;

       fields = {'f','Aineq','bineq','Aeq','beq','lb','ub','x0'};
       for i=1:numel(fields)
           field = fields{i};
           if isfield(problem,field) && isnumeric(problem.(field))
               problem.(field) = double(problem.(field));
           end
       end

       [x,fval,exitflag,output,lambda] = linprog(problem);
    else
        rethrow(ME)
    end
end
warning(w);

end"
3225,Coral_Geometry.m,73.068,80,55.34,60,100.0,70.0,70-80,"function Coral_Geometry()

L = 0.5;
Nx = 128;
Ny = 128;
ratio = 1024 / (2*Nx);

struct_name = 'coral'; % Name for .vertex, .spring, etc files.

[x1,y1,N] = please_Give_Single_Polyp_Geometry(ratio);
x1=x1-0.1; x2=x1+0.2;
y2=y1;
x = [x1;x2];
y = [y1;y2];

fprintf('\\n\\nNumber of Pts. in ONE tentacle: %d\\n\\n',N);

print_Lagrangian_Vertices(x,y,struct_name);

k_Target = 1e8;
print_Lagrangian_Target_Pts(x,k_Target,struct_name);


function print_Lagrangian_Vertices(xLag,yLag,struct_name)

    N = length(xLag);

    vertex_fid = fopen([struct_name '.vertex'], 'w');

    fprintf(vertex_fid, '%d\\n', N );

    for s = 1:N
        X_v = xLag(s);
        Y_v = yLag(s);
        fprintf(vertex_fid, '%1.16e %1.16e\\n', X_v, Y_v);
    end

    fclose(vertex_fid); 
    

function print_Lagrangian_Target_Pts(xLag,k_Target,struct_name)

    N = length(xLag);

    target_fid = fopen([struct_name '.target'], 'w');

    fprintf(target_fid, '%d\\n', N );

    for s = 1:N
        fprintf(target_fid, '%d %1.16e\\n', s, k_Target);
    end

    fclose(target_fid); 




function [x,y,N] = please_Give_Single_Polyp_Geometry(ratio)

xoffset = 0.3; % To put geometry into QUADRANT-1
yoffset = 0.5; % To put geometry into QUADRANT-1


struct_name1 = 'coral2d_left_1024';
[~,x1,y1] = read_Vertex_Points(struct_name1);

struct_name2 = 'coral2d_right_1024';
[~,x2,y2] = read_Vertex_Points(struct_name2);

xAux = [x1+xoffset; x2(end:-1:1)+xoffset];
yAux = [y1+yoffset; y2(end:-1:1)+yoffset];

x=xAux(1:ratio:end);
y=yAux(1:ratio:end);
N = length(x)/2;

plot(xAux,yAux,'*'); hold on;
plot(x,y,'ro'); hold on;




function [N,xLag,yLag] = read_Vertex_Points(struct_name)

filename = [struct_name '.vertex'];  %Name of file to read in
fileID = fopen(filename);

C = textscan(fileID,'%f %f','CollectOutput',1);


fclose(fileID);     %Close the data file.

vertices = C{1};    %Stores all read in data in vertices (N+1,2) array

N = vertices(1,1);  % # of Lagrangian Pts
xLag = zeros(N,1);  % Initialize storage for Lagrangian Pts.
yLag = xLag;        % Initialize storage for Lagrangian Pts.

for i=1:N
   xLag(i,1) = vertices(i+1,1); %Stores x-values of Lagrangian Mesh
   yLag(i,1) = vertices(i+1,2); %Stores y-values of Lagrangian Mesh
   
end"
3226,coranaEval.m,71.0,60,93.33,15,100.0,86.67,70-80,"function [val] = coranaEval(sol)


numv = size(sol,2);
x=sol(1:numv);
d0=[1 1000 10 100 1 10 100 1000 1 10];
d=d0(1:numv);
c=0.15;
s=.2*ones(1,numv);
t=0.05*ones(1,numv);
bk = s.*(round(x./s));
dev= (abs(bk-x)<t) & (bk~=0);
z=c*((bk+sign(bk).*t).^2).*d;
y=x.^2.*d;
val = sum((dev.*z) + ((~dev).*y));"
3227,CORAquadprog.m,79.344,100,57.38,100,100.0,39.34,70-80,"function [x,fval,exitflag,output,lambda] = CORAquadprog(problem)



persistent isMosek
if isempty(isMosek)
    isMosek = isSolverInstalled('mosek');
end

if isMosek
    [q,c,a,blc,buc,blx,bux,param,cmd] = quadprog2mosek(problem);

    res = mskqpopt(q,c,a,blc,buc,blx,bux,param,cmd);

    if strcmp(res.sol.itr.prosta,'PRIMAL_AND_DUAL_FEASIBLE')
        exitflag = 1;

        x = [];
        if isfield(res,'sol')
            if isfield(res.sol,'itr')
                x = res.sol.itr.xx;
            else
                x = res.sol.bas.xx;
            end
        end
        fval = 0.5*x'*q*x + c'*x;

    else
        x = [];
        fval = [];
        
        if strcmp(res.sol.itr.prosta,'PRIMAL_INFEASIBLE')
            exitflag = -2;
        elseif strcmp(res.sol.itr.prosta,'DUAL_INFEASIBLE')
            exitflag = -3;
        else
            throw(CORAerror('CORA:solverIssue'));
        end
    end

    if nargout >= 4
        output = [];
    end
    if nargout >= 5
        lambda = [];
    end

else
    if ~isfield(problem,'options')
        persistent options
        if isempty(options)
            options = optimoptions('quadprog','display','off');
        end
        problem.options = options;
    end

    problem.solver = 'quadprog';

    [x,fval,exitflag,output,lambda] = quadprog(problem);

end"
3228,CORAtable.m,77.612,80,58.68,100,100.0,49.38,70-80,"classdef CORAtable < ASCIItable




properties
    design
end

methods
    function table = CORAtable(design,hvalues,formats,varargin)
        [design,hvalues,formats,tableoptions] = aux_parseInput(design,hvalues,formats);

        table = table@ASCIItable(hvalues,formats,tableoptions{:},varargin{:});

        table.design = design;
    end
end

methods (Static)
    function printTable(matlabtable,varargin)
        
        inputArgsCheck({{matlabtable,'att','table'}});
        hvalues = matlabtable.Properties.VariableNames;
        [design,formats] = setDefaultValues({'single',aux_detectFormats(matlabtable)},varargin);

        colWidths = aux_determineColumnWidths(matlabtable,hvalues,formats);

        coratable = CORAtable(design,hvalues,formats,'ColumnWidths',colWidths);

       coratable.printHeader()
       for i=1:height(matlabtable)
           cvalues = arrayfun(@(j) matlabtable{i,j}, 1:numel(hvalues),'UniformOutput',false);    
           coratable.printContentRow(cvalues);
       end
       coratable.printFooter();

    end
end

methods (Access=protected)

    function [hvalues,colWidths] = formatHeaderAndComputeColWidths(table,varargin)
        t = table;
        switch t.design
            case 'latex'

                hvalues = cell(size(t.hvalues));
                for i=1:length(t.hvalues)
                    format = t.formats{i};
                    if startsWith(format,'sum')
                        hvalues{i} = sprintf(...
                            '\\\\multicolumn{2}{c}{\\\\text{%s}}',t.hvalues{i});
                    else
                        hvalues{i} = sprintf('\\\\text{%s}',t.hvalues{i});
                    end
                end

                colWidths = max(t.colWidths,cellfun(@strlength,hvalues));

                [hvalues,colWidths] = formatHeaderAndComputeColWidths@ASCIItable(t,hvalues,colWidths);
            otherwise
                [hvalues,colWidths] = formatHeaderAndComputeColWidths@ASCIItable(t);
        end 
    end

    function format = getFormatString(table,format,colWidth) 
        if startsWith(format,'sum')
            if ~strcmp(table.design,'latex')
                format = strrep(format,'&','±');
            end
        end
        format = getFormatString@ASCIItable(table,format,colWidth);
    end
end

end



function [design,hvalues,formats,tableoptions] = aux_parseInput(design,hvalues,formats)

    inputArgsCheck({ ...
        {design,'str',{'single', 'double', 'modern', 'minimalistic','ascii','latex','html','markdown'}};    ...
        {hvalues,'att','cell'};    ...
        {formats,'att','cell'};    ...
    })

    switch design
        case 'single'
            tableoptions = aux_getSingleTableOptions();
        case 'double'
            tableoptions = aux_getDoubleTableOptions();
        case 'modern'
            tableoptions = aux_getModernTableOptions();
        case 'minimalistic'
            tableoptions = aux_getMinimalisticTableOptions();
        case 'ascii'
            tableoptions = aux_getAsciiTableOptions();
        case 'latex'
            tableoptions = aux_getLatexTableOptions(formats);
        case 'html'
            tableoptions = aux_getHTMLTableOptions();
        case 'markdown'
            tableoptions = aux_getMarkdownTableOptions();
        otherwise
            throw(CORAerror('CORA:wrongValue','third','Unknown design.'))
    end
end

function tableoptions = aux_getSingleTableOptions()
    tableoptions = {
        'tbhline','-','tbhcorner','|','hbvline','|','hsep','|','csep','|'
    };
end

function tableoptions = aux_getDoubleTableOptions()
    tableoptions = {
        'tbhline','=','tbhcorner','‖','hbvline','‖','hsep','|'
    };
end

function tableoptions = aux_getModernTableOptions()
    tableoptions = {
        'tbhline','_','tbhcorner','','mbhline','-','mbhcorner','','bbhline','_','bbhcorner','', ...
        'hbvline','','hsep','|'
    };
end

function tableoptions = aux_getMinimalisticTableOptions()
    tableoptions = {
        'tbhline','-','tbhcorner','','hbvline','','hsep',' '
    };
end

function tableoptions = aux_getAsciiTableOptions()
    tableoptions = {
        'tbhline','-','tbhcorner','+','tbhsep','+','mbhsep','+','bbhsep','+','hbvline','|','hsep','|'
    };
end

function tableoptions = aux_getLatexTableOptions(formats)

    tpre = sprintf([ ...
        '%%%% Move to preamble.\\n' ...
        '%%%% \\\\\\\\usepackage{booktabs} %%%% requires ''booktabs'' package\\n' ...
        '%%%% \\\\\\\\usepackage{amstext} %%%% for \\\\\\\\text macro in headers\\n' ...
        '%%%% \\\\\\\\usepackage{array} %%%% for \\\\\\\\newcolumntype macro\\n' ...
        '%%%% \\\\\\\\newcolumntype{L}{>{$}l<{$}} %%%% math-mode version of ""l"" column type\\n'...
        '%%%% \\\\\\\\newcolumntype{R}{>{$}r<{$}} %%%% math-mode version of ""r"" column type\\n\\n'...
        '\\\\\\\\begin{table}\\n' ...
        '  \\\\\\\\centering\\n' ...
        '  \\\\\\\\caption{My caption}\\n' ...
        '  \\\\\\\\label{tab:my-label}\\n' ...
        '  \\\\\\\\begin{tabular}{%s}\\n' ...
    ], strjoin(cellfun(@aux_format2latex, formats,'UniformOutput',false),' '));
    tpost = [ ...
        '  \\\\end{tabular}\\n' ...
        '\\\\end{table}\\n' ...
    ];

    tableoptions = { ...
        'tbhline',' ','tbhcorner','','hbvline','','hsep','&', ...
        'tlpre','    \\toprule','mlpre','    \\midrule','blpre','    \\bottomrule','hlpost','\\\\' ...
        'hlpre', '   ', 'tpre', tpre, 'tpost', tpost, ...
    };
end

function tableoptions = aux_getHTMLTableOptions(formats)
    tpre = '<table>\\n';
    tpost = '</table>\\n';

    tableoptions = { ...
        'tbhline',' ','tbhcorner','','hbvline','', ...
        'hlpre', '', 'tpre', tpre, 'tpost', tpost, ...
        'tlpre','  <thead>','mlpre','  </thead><tbody>','blpre','  </tbody>', ...
        'hlpre','    <tr><th>','hsep','</th><th>','hlpost','</th></tr>', ...
        'clpre','    <tr><td>','csep','</td><td>','clpost','</td></tr>', ...
    };
end

function tableoptions = aux_getMarkdownTableOptions()
    tableoptions = { ...
        'tbhline','','tbhcorner','','hbvline','|', ...
        'mbhline','-','mbhcorner','|','mbhsep','|'
    };
end

function latexformat = aux_format2latex(format)
    if startsWith(format,'sum')
        latexformat = 'R@{$\\\\pm$}L';
    elseif contains(format,'s')
        latexformat = 'l'; 
    else
        latexformat = 'R';
    end
end

function formats = aux_detectFormats(matlabtable)
    if height(matlabtable) >= 1
        if isMATLABReleaseOlderThan('R2024b')
            types = arrayfun(@(i) class(matlabtable{1,i}),1:numel(matlabtable.Properties.VariableNames),'UniformOutput',false);
        else
            types = matlabtable.Properties.VariableTypes;
        end
    else
        types = arrayfun(@(i) 'string',1:numel(matlabtable.Properties.VariableNames),'UniformOutput',false);
    end
    
    formats = cell(1,numel(types));
    for i=1:numel(types)
        type = types(i);
        if ismember(type,{'double','logical'})
            formats{i} = 'd';
        else
            formats{i} = 's';
        end
    end
end

function colWidths = aux_determineColumnWidths(matlabtable,hvalues,formats)
    colWidths = cellfun(@(hvalue) strlength(hvalue),hvalues,'UniformOutput',true);

    for j=1:numel(formats)
        format = formats{j};
        if ~contains(format,'%')
            format = sprintf('%%%s',format);
        end

        widths = [ ...
            colWidths(j), ...
            arrayfun(@(i) aux_determineLengthEntry(matlabtable{i,j},format), 1:height(matlabtable)) ...
        ];

        colWidths(j) = max(widths);
    end
end

function len = aux_determineLengthEntry(entry,format)
    formattedEntry = sprintf(format,entry);
    [~,len] = centerString(formattedEntry,0);
end"
