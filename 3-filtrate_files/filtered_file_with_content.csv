rowy_index = reshape(G(2:Nr+1,2:Ntetta+1),mNz,1); % main diagonal y
iiy(1:3*mNz) = repmat(rowy_index,3,1);
jjx(1:3*mNr) = [reshape(G(1:Nr,2:Ntetta+1),mNr,1); reshape(G(2:Nr+1,2:Ntetta+1),mNr,1); reshape(G(3:Nr+2,2:Ntetta+1),mNr,1)];
jjy(1:3*mNz) = [reshape(G(2:Nr+1,1:Ntetta),mNz,1); reshape(G(2:Nr+1,2:Ntetta+1),mNz,1); reshape(G(2:Nr+1,3:Ntetta+2),mNz,1)];
sx(1:3*mNr) = [AW; APx; AE];
sy(1:3*mNz) = [AS; APy; AN];

div_x = -(1./(DRp.*rp)).*(re.*(ue_max.*psiX_p(2:Nr+1,:)+ue_min.*psiX_m(2:Nr+1,:))- ...
              rw.*(uw_max.*psiX_p(1:Nr,:)+uw_min.*psiX_m(1:Nr,:)));
div_y = -(1./(DTHETAp.*rp)).*((vn_max.*psiY_p(:,2:Ntetta+1)+vn_min.*psiY_m(:,2:Ntetta+1))- ...
              (vs_max.*psiY_p(:,1:Ntetta)+vs_min.*psiY_m(:,1:Ntetta)));
RHS = zeros((Nr+2)*(Ntetta+2),1);
RHSx = zeros((Nr+2)*(Ntetta+2),1);
RHSy = zeros((Nr+2)*(Ntetta+2),1);

RHS(rowx_index) = reshape(div_x+div_y,Nr*Ntetta,1);
RHSx(rowx_index) = reshape(div_x,Nr*Ntetta,1);
RHSy(rowy_index) = reshape(div_y,Nr*Ntetta,1);

kx = 3*mNr;
ky = 3*mNz;
Mx = sparse(iix(1:kx), jjx(1:kx), sx(1:kx), (Nr+2)*(Ntetta+2), (Nr+2)*(Ntetta+2));
My = sparse(iiy(1:ky), jjy(1:ky), sy(1:ky), (Nr+2)*(Ntetta+2), (Nr+2)*(Ntetta+2));
M = Mx + My;

end

function phi_out = fsign(phi_in)
    phi_out = (abs(phi_in)>=eps).*phi_in+eps*(phi_in==0)+eps*(abs(phi_in)<eps).*sign(phi_in);
end"
2924,convectionTvdTermSpherical1D.m,72.666,100,74.07,30,100.0,59.26,70-80,"function [M, RHS] = convectionTvdTermSpherical1D(u, phi, FL)


Nr = u.domain.dims(1);
G = 1:Nr+2;
dx = 0.5*(u.domain.cellsize.x(1:end-1)+u.domain.cellsize.x(2:end));
rf = u.domain.facecenters.x;
RHS = zeros(Nr+2, 1);
psi_p = zeros(Nr+1,1);
psi_m = zeros(Nr+1,1);

iix = zeros(3*(Nr+2),1);
jjx = zeros(3*(Nr+2),1);
sx = zeros(3*(Nr+2),1);

ux = u.xvalue;

dphi_p = (phi.value(2:Nr+2)-phi.value(1:Nr+1))./dx;
rp = dphi_p(1:end-1)./fsign(dphi_p(2:end));
psi_p(2:Nr+1) = 0.5*FL(rp).*(phi.value(3:Nr+2)-phi.value(2:Nr+1));
psi_p(1) = 0.0; % left boundary will be handled explicitly

rm = dphi_p(2:end)./fsign(dphi_p(1:end-1));
psi_m(1:Nr) = 0.5*FL(rm).*(phi.value(1:Nr)-phi.value(2:Nr+1));
psi_m(Nr+1) = 0.0; % right boundary will be handled explicitly

ue = ux(2:Nr+1);		uw = ux(1:Nr);
re = rf(2:Nr+1);     rw = rf(1:Nr);

ue_min = min(ue,0);	ue_max = max(ue,0);
uw_min = min(uw,0);	uw_max = max(uw,0);

RHS(2:Nr+1) = -(1./(1/3*(rf(2:Nr+1).^3-rf(1:Nr).^3))).*(re.^2.*(ue_max.*psi_p(2:Nr+1)+ue_min.*psi_m(2:Nr+1))- ...
              rw.^2.*(uw_max.*psi_p(1:Nr)+uw_min.*psi_m(1:Nr)));

AE = reshape(re.^2.*ue_min./(1/3*(rf(2:Nr+1).^3-rf(1:Nr).^3)),Nr,1);
AW = reshape(-rw.^2.*uw_max./(1/3*(rf(2:Nr+1).^3-rf(1:Nr).^3)),Nr,1);
APx = reshape((re.^2.*ue_max-rw.^2.*uw_min)./(1/3*(rf(2:Nr+1).^3-rf(1:Nr).^3)),Nr,1);

APx(1) = APx(1)-0.5*rw(1)^2*uw_max(1)/(1/3*(rf(2)^3-rf(1)^3));   AW(1) = AW(1)/2;
AE(end) = AE(end)/2;    APx(end) = APx(end)+0.5*re(end)^2*ue_min(end)/(1/3*(rf(Nr+1)^3-rf(Nr)^3));

rowx_index = reshape(G(2:Nr+1),Nr,1); % main diagonal x
iix(1:3*Nr) = repmat(rowx_index,3,1);
jjx(1:3*Nr) = [reshape(G(1:Nr),Nr,1); reshape(G(2:Nr+1),Nr,1); reshape(G(3:Nr+2),Nr,1)];
sx(1:3*Nr) = [AW; APx; AE];

kx = 3*Nr;
M = sparse(iix(1:kx), jjx(1:kx), sx(1:kx), Nr+2, Nr+2);
end

function phi_out = fsign(phi_in)
    phi_out = (abs(phi_in)>=eps).*phi_in+eps*(phi_in==0)+eps*(abs(phi_in)<eps).*sign(phi_in);
end"
2925,convectionUpwindTerm1D.m,79.5,100,80.0,60,100.0,57.5,70-80,"function M = convectionUpwindTerm1D(u, varargin)

Nx = u.domain.dims(1);
G = 1:Nx+2;
DXp = u.domain.cellsize.x(2:end-1);

if nargin>1
    u_upwind = varargin{1};
else
    u_upwind = u;
end

iix = zeros(3*(Nx+2),1);
jjx = zeros(3*(Nx+2),1);
sx = zeros(3*(Nx+2),1);

ue_min = u.xvalue(2:Nx+1);
ue_max = u.xvalue(2:Nx+1);
uw_min = u.xvalue(1:Nx);
uw_max = u.xvalue(1:Nx);

ue_min(u_upwind.xvalue(2:Nx+1)>0.0) = 0.0;
ue_max(u_upwind.xvalue(2:Nx+1)<0.0) = 0.0;
uw_min(u_upwind.xvalue(1:Nx)>0.0) = 0.0;
uw_max(u_upwind.xvalue(1:Nx)<0.0) = 0.0;

AE = reshape(ue_min./DXp,Nx,1);
AW = reshape(-uw_max./DXp,Nx,1);
APx = reshape((ue_max-uw_min)./DXp,Nx,1);

APx(1) = APx(1)-uw_max(1)/(2*DXp(1));   AW(1) = AW(1)/2;
AE(end) = AE(end)/2;    APx(end) = APx(end) + ue_min(end)/(2*DXp(end));

rowx_index = reshape(G(2:Nx+1),Nx,1); % main diagonal x
iix(1:3*Nx) = repmat(rowx_index,3,1);
jjx(1:3*Nx) = [reshape(G(1:Nx),Nx,1); reshape(G(2:Nx+1),Nx,1); reshape(G(3:Nx+2),Nx,1)];
sx(1:3*Nx) = [AW; APx; AE];

kx = 3*Nx;
M = sparse(iix(1:kx), jjx(1:kx), sx(1:kx), Nx+2, Nx+2);"
2926,convectionUpwindTerm2D.m,77.142,100,87.14,60,100.0,38.57,70-80,"function [M, Mx, My] = convectionUpwindTerm2D(u, varargin)

