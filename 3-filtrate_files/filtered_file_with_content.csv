1374,deleteoutliers.m,84.8,100,74.0,100,100.0,50.0,80-90,"function [b,idx,outliers] = deleteoutliers(a,alpha,rep)

if nargin == 1
	alpha = 0.05;
	rep = 0;
elseif nargin == 2
	rep = 0;
elseif nargin == 3
	if ~ismember(rep,[0 1])
		error('Please enter a 1 or a 0 for optional argument rep.')
	end
elseif nargin > 3
	error('Requires 1,2, or 3 input arguments.');
end

if isempty(alpha)
	alpha = 0.05;
end

b = a;
b(isinf(a)) = NaN;

outlier = 1;
while outlier
	tmp = b(~isnan(b));
	meanval = mean(tmp);
	maxval = tmp((abs(tmp-mean(tmp))==max(abs(tmp-mean(tmp)))));
	maxval = maxval(1);
	sdval = std(tmp);
	tn = abs((maxval-meanval)/sdval);
	critval = zcritical(alpha,length(tmp));
	outlier = tn > critval;
	if outlier
		b(a == maxval) = NaN;
	end
end
if nargout >= 2
	idx = find(isnan(b));
end
if nargout > 2
	outliers = a(idx);
end
if ~rep
	b=b(~isnan(b));
end
return

function zcrit = zcritical(alpha,n)
tcrit = tinv(alpha/(2*n),n-2);
zcrit = (n-1)/sqrt(n)*(sqrt(tcrit^2/(n-2+tcrit^2)));"
1375,deleteRedundantSets.m,82.808,100,66.67,100,100.0,47.37,80-90,"function R = deleteRedundantSets(R,Rold,options)



redMethod='pca';

try
    R.internalCount=Rold.internalCount+1;
catch
    R.internalCount=3;
end

if R.internalCount==options.reductionInterval
    R.internalCount=1;
    R.P=[];
    for i=1:length(R.tp)
        R.tp{i}.set=reduce(R.tp{i}.set,redMethod,1);
        R.P{i}=polytope(R.tp{i}.set);
    end    
elseif R.internalCount==2
    for iNewSet=1:length(R.tp)
        R.tp{iNewSet}.set=reduce(R.tp{iNewSet}.set,redMethod,1);
        Pnew{iNewSet}=polytope(R.tp{iNewSet}.set);
    end
    Pcut=Pnew;
    for iNewSet=1:length(Pcut)
        for iOldSet=1:length(Rold.P)           
            Pcut{iNewSet}=Pcut{iNewSet}\\Rold.P{iOldSet};
        end
    end
    
    iChecked=1;
    
    for iNewSet=1:length(Pcut)
        for iOtherSet=1:length(Pnew)  
            if iOtherSet~=iNewSet
                Pcut{iNewSet}=Pcut{iNewSet}\\Pnew{iOtherSet};
            end
        end
        if true % ~representsa_(Pcut{iNewSet},'emptySet',eps)
            Rnew{iChecked}.set = R.tp{iNewSet}.set;
            Rnew{iChecked}.error = 0*options.maxError;
            Rnew{iChecked}.prev = iNewSet;
            if isfield(R.tp{iNewSet},'parent')
               Rnew{iChecked}.parent = R.tp{iNewSet}.parent;
            end
            iChecked=iChecked+1;
        else
            disp('canceled!!');
        end    
    end
    
    R.tp=[];
    for i=1:length(Rnew)
        R.tp{i} = Rnew{i};
    end
end"
