B{3}(7,7)  = 1;
B{3}(9:end,8:end-1) = eye(9);
B{3}(end,end) = 1;

C{1}  = [repmat([-1;0;0;0;0],1,3),zeros(5,7)];
c     = 6;
C{2}  = [repmat([0;c;-c],1,3),zeros(3,7)];
C{3}  = zeros(size(A{3},1),10);
C{4}  = zeros(size(A{4},1),10);


D{1} = [1 0 0 0]';      % Location
