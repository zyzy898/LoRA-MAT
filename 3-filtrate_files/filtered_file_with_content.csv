        end
        
        for n = 1:num_image
            img = XxNorm(data_seg(:,:,(n-1)*n_perSIM+1:n*n_perSIM),0,100);
            img = uint16(img * 65535);
            img_sum = uint16(XxNorm(sum(img, 3), 0, 100) * 65535);
