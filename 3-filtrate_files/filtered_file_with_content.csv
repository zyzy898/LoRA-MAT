    imagesc(64 - E'), axis xy image off, drawnow
    dat = datestr(D(1).date(i),'dd-mmm-yy');
    title({str{j},dat},'FontSize',12)
    
    
    [y,k] = sort(DD{j}(end,:),'descend');
