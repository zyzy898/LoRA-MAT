            res = vl_simplenn(net, input,[],[],'conserveMemory',true,'mode','test');
            im = res(end).x;
            
            output = gather(input - im);
            
            [PSNR_Cur,SSIM_Cur] = Cal_PSNRSSIM(label,im2uint8(output),0,0);
