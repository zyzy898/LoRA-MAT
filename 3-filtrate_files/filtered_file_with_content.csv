6355,computeJGConstraints.m,65.0,60,70.0,45,100.0,50.0,61-70,"function g = computeJGConstraints (qR, qS, auxdata) 
  [K C f Rv Rf Sv Sf NS d] = deal(auxdata{:});
  
  nr = length(Rv);  % The number of large regions.
  ns = length(Sv);  % The number of small regions.

  qR = reshapemarginals(qR,Rv,K);
  qS = reshapemarginals(qS,Sv,K);

  gR = zeros(nr,1);
  for r = 1:nr
    gR(r) = sum(qR{r}(:));
  end
  
  gS = zeros(ns,1);
  for s = 1:ns
    gS(s) = sum(qS{s}(:));
  end
  
  cRS = cell(1,ns);
  for s = 1:ns
    is = Sv{s};  % The variable nodes in the small region.
    rs = NS{s};  % The set of neighbouring large regions.
    for i = 1:length(rs)
      r         = rs(i);
      cRS{s}{i} = margfactor(qR{r},Rv{r},is) - qS{s};
    end
  end
  
  g = [gR; gS; vectorize(cRS)];"
6356,curvelet_fuse.m,68.586,60,79.31,45,100.0,58.62,61-70,"function y1=curvelet_fuse(I1,I2,n)

I1=double(I1);
I2=double(I2);

is_real = 1;

finest = 1 ;
nbscales=n;
C1 = fdct_wrapping(I1, is_real, finest, nbscales);
C2 = fdct_wrapping(I2, is_real, finest, nbscales);
[M,N]=size(I1);

 C=C1;
for scalelevel=2:n
    for orientationlevel=1:length(C1{scalelevel})
        E1=C1{scalelevel}{orientationlevel};
        E2=C2{scalelevel}{orientationlevel};
    um=3;
    A1 = ordfilt2(abs(es2(E1,floor(um/2))), um*um, ones(um));
  	A2 = ordfilt2(abs(es2(E2,floor(um/2))), um*um, ones(um));
  	W = (conv2(double(A1 > A2), ones(um), 'valid')) > floor(um*um/2);
        C{scalelevel}{orientationlevel}=C1{scalelevel}{orientationlevel}.*W+C2{scalelevel}{orientationlevel}.*~W;
    end
end
C{1}{1}=(C1{1}{1}+C2{1}{1})/2;


y1 = ifdct_wrapping(C, is_real, M, N);"
6357,computeR1.m,63.112,30,77.78,30,100.0,77.78,61-70,"function R1f = computeR1(Param, R1obs)

kf  = Param.kf;
F  = Param.F;
R1r = Param.R1r;

R1f = R1obs - kf*(R1r - R1obs) / (R1r - R1obs + kf/F);

end"
6358,ComputeAdj.m,61.0,60,63.16,45,100.0,36.84,61-70,"function [ adj_n ] = ComputeAdj( adj )

    nseg = size(adj, 1);

    adj_i = adj; 
    adj_n = adj;

    for i=2:nseg
        adj_i = adj_i * adj;
        adj_n((adj_n == 0) & (adj_i > 0)) = i;
    end
    adj_n(adj_n == 0) = nseg + 1;
    
    for i=1:nseg
        adj_n(i, i) = 0;
    end


end"
