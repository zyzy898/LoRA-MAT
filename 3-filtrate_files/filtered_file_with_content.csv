3945,crosscorrdim.m,79.5,100,71.88,60,100.0,65.62,70-80,"function rs = crosscorrdim(s, s2, n, range, past, bins)


narginchk(5,6)

if nargin < 6
	bins  = 32;
end

points = data(s);
[N,dim] = size(points);

points2 = data(s2);
[N2,dim2] = size(points2);

ref = randref(1,N, n);

[c,d] = crosscorrsum(points, points2, ref, range, past, bins);	

d = log2(d);

a = achse(unit, d(1), mean(diff(d)));
a = setname(a, 'ln r');
rs = signal(core(log2(c(:))), s);
newdes = merge(s.description, s2.description);
rs.description = newdes;

rs = setaxis(rs, 1, a);
rs = addhistory(rs,  ['Computed cross correlation sum']);
rs = addcommandlines(rs, 's = crosscorrdim2(s,s2', n, range, past);
rs = setyname(rs, 'ln C(r)');
rs = setlabel(rs, 'Cross-correlation sum');"
3946,crossCorrelation.m,72.606,100,59.09,60,100.0,43.94,70-80,"function [psi,c] = crossCorrelation(ori,varargin)

for k = 1:15
  psi(k) = SO3DeLaValleePoussinKernel('halfwidth',40*degree/2^(k/4)); %#ok<AGROW>
end
psi = get_option(varargin,'kernel',psi);

sN = ceil(min(length(ori),get_option(varargin,'SamplingSize',1000)));
pN = get_option(varargin,'PartitionSize',ceil(1000000/length(ori)));
cN = ceil(sN / pN);

c = zeros(cN,length(psi));
iN = zeros(1,cN);
progress(0,cN,' estimate optimal kernel halfwidth: ');

for i = 1:cN
  
  iN(i) = min(length(ori),i*pN);
  ind = ((i-1) * pN + 1):iN(i);
 
  d =  dot_outer(ori(ind),ori);
  
  for k = 1:length(psi)
    
    f = evalCos(psi(k),d);
    
    f(sub2ind(size(f),1:size(f,1),ind)) = 0;
    
    c(i,k) = sum(log(sum(f,2)));
    
  end
  
  progress(i,cN,' estimate optimal kernel halfwidth: ');
  
  
end

c = cumsum(c,1) ./ repmat(iN.',1,length(psi));
[~,ci] = max(c(end,:));
psi = psi(ci);

return


cs = crystalSymmetry('orthorhombic'); %#ok<*UNRCH>
model_odf = 0.5*uniformODF(cs) + ...
  0.05*fibreODF(Miller(1,0,0,cs),xvector,'halfwidth',10*degree) + ...
  0.05*fibreODF(Miller(0,1,0,cs),yvector,'halfwidth',10*degree) + ...
  0.05*fibreODF(Miller(0,0,1,cs),zvector,'halfwidth',10*degree) + ...
  0.05*unimodalODF(axis2quat(xvector,45*degree),cs,'halfwidth',15*degree) + ...
  0.3*unimodalODF(axis2quat(yvector,65*degree),cs,'halfwidth',25*degree);

ori = discreteSample(model_odf,1000);

for k = 1:15
  psi(k) = SO3DeLaValleePoussinKernel('halfwidth',40*degree/2^(k/4));
end
psi

c = crossCorrelation(ori,psi,'PartitionSize',10,'SamplingSize',1000);

plot(c)

[cm,ci] = max(c,[],2);

2^(-1/7)*pi^(4/7) * textureindex(model_odf,'fourier','bandwidth',32,'weighted',(1+(0:32)).*(0:32)).^(6/7)"
3947,CrossCov.m,71.91,60,81.82,45,100.0,72.73,70-80,"function Pcc=CrossCov(x,mx,z,mz,w)
