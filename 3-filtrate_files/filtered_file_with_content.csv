        boxpoly(1).p3 = extend_to_imageedge(pt, vp{1}, 'up', imgwidth, imgheight);
        boxpoly(1).p4 = pt;
        boxpoly(1).orient = 2;
        
        pt = roomhyp(i).corner(3).pt;
        boxpoly(2).p1 = extend_to_imageedge(pt, vp{1}, 'up', imgwidth, imgheight);
