    alphatr = 0.5116;
    priors.alpha	   ={alphatr^2/(1+alphatr^2) , 0.0005, 1 };
    
    if sticky_price_model
        priors.phi_p_trans={1.5125, 0, 2};
    end
    priors.phi_k_trans={0.3426, 0, 2};
    
    priors.mu_ss_trans={0.0086, 0.0005, 2 };
    
