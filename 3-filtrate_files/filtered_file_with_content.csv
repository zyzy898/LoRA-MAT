function pushbutton1_Callback(hObject, eventdata, handles)
try
    allDataStreams = evalin('base','allDataStreams');
    
    latency = str2double(get(handles.edit1,'String'));
    if isempty(latency), error('Invalid latency');end
    if ~isnumeric(latency), error('Invalid latency');end
    if ~(latency >= 0 && latency <= allDataStreams.item{1}.timeStamp(end)), error('This latency is out of range');end
    
    label = get(handles.edit2,'String');
    if isempty(label), error('You must enter a label (EEG event type).');end
    
    names = get(handles.popupmenu1,'String');
    insertHere = names{get(handles.popupmenu1,'Value')};
    
    if strcmp(insertHere,'EEG')
        EEG = evalin('base','EEG');
        for it=1:length(allDataStreams.item)
            if ~isa(allDataStreams.item{it},'segmentList')
                if length(allDataStreams.item{it}.timeStamp) == EEG.pnts, break;end
            end
        end
        [~,latency] = min(abs(allDataStreams.item{it}.timeStamp-latency));
        EEG = eeg_addnewevents(EEG, {latency}, {label});
        assignin('base','EEG',EEG);
        evalin('base','eeglab(''redraw'')');
    else
        itemIndex = get(handles.popupmenu1,'Value')+1;%allDataStreams.findItem(insertHere);
        [~,latency] = min(abs(allDataStreams.item{itemIndex}.timeStamp-latency));
        allDataStreams.item{itemIndex}.event = allDataStreams.item{itemIndex}.event.addEvent(latency,label);  
    end
catch ME
    sendEmailReport(ME);
end




function pushbutton2_Callback(hObject, eventdata, handles)
close(handles.figure1);


function pushbutton3_Callback(hObject, eventdata, handles)
EventsEditor2;"
3631,createExpandedStructure2D.m,79.49,100,65.31,75,100.0,57.14,70-80,"function planC = createExpandedStructure2D(structNum, margin, planC)

if ~exist('planC','var')
    global planC
end

global stateS

indexS = planC{end};

scanNum = getStructureAssociatedScan(structNum,planC);

newStructNum = length(planC{indexS.structures}) + 1;


rasterSegs = getRasterSegments(structNum, planC);

if margin>0
halo = structMargin(rasterSegs, margin, scanNum, planC);
rasterSegsExpanded = structUnion(halo, rasterSegs, scanNum, planC); % Expand rastersegments by margin
else
halo = structMargin(rasterSegs, -margin, scanNum, planC);
rasterSegsExpanded = structDiff(rasterSegs, halo, scanNum, planC); % Shrink rastersegments by margin
end

contourS = rasterToPoly(rasterSegsExpanded, scanNum, planC);

strName = planC{indexS.structures}(structNum).structureName;
strName = [strName,' + 2D_',num2str(margin)];

newstr = newCERRStructure(scanNum, planC, newStructNum);
newstr.contour = contourS;
newstr.structureName = strName;
newstr.associatedScan = scanNum;
newstr.assocScanUID = planC{indexS.scan}(scanNum).scanUID;
numStructs = length(planC{indexS.structures});

if ~isempty(planC{indexS.structures})
    planC{indexS.structures} = dissimilarInsert(planC{indexS.structures}, newstr, numStructs+1, []);
else
    planC{indexS.structures} = newstr;
end

planC = updateStructureMatrices(planC, numStructs+1);

if ~isempty(stateS) && isfield(stateS,'handle') && isfield(stateS.handle,'CERRSliceViewer') && isnumeric(stateS.handle.CERRSliceViewer)
    stateS.structsChanged = 1;
    CERRRefresh
end"
3632,CreateExternSystem.m,78.75,100,68.75,75,100.0,50.0,70-80,"function Sys = CreateExternSystem(name, vars, params, p0, simfn)
  
  Sys.name = name;

  if nargin==3
      if isscalar(vars)
          nvars = vars;
          vars = {};
          for i=1:nvars
              vars = {vars{:} ['x' num2str(i)]};
          end
      end
      
      if isscalar(params)
          nparams = params;
          params = {};
          
          for i=1:nparams
              params = {params{:} ['x' num2str(i)]};
         end          
      end
  end
  
  Sys.DimX = numel(vars);
  Sys.DimU =0; 
  Sys.DimP = numel(vars)+numel(params); 
  Sys.ParamList = {vars{:} params{:}};
  Sys.x0 = zeros(1,numel(vars));  
  
  if (~exist('p0'))
      Sys.p = zeros(1, Sys.DimP);
  else
    p0 = reshape(p0, numel(p0),1);
    if (numel(p0)== Sys.DimP)
      Sys.p = p0;
    else
      Sys.p = [Sys.x0'; p0];
    end
  end
  
  if exist('simfn','var')
      Sys.type = 'Extern';
      Sys.sim = simfn;
  else
      Sys.type = 'traces';
  end
  Sys.tspan= 0:.1:1;
  Sys.Dir = pwd;"
