5173,democc_markmax.m,74.286,60,67.86,90,100.0,53.57,70-80,"function k=democc_markmax(proc,tp,k,diff)

  
  
ms = 20; % markersize

n=length(tp);
if k<1
  k=1;
elseif k>n
  k=n;
end

if k~=n
  if tp(k+1,2)>tp(k,2)
    k=k+1;
  end
else
  if tp(k-1,2)>tp(k)
    k=k-1;
  end
end
  
plot(proc(:,1),proc(:,2)), hold on
plot(tp(k,1),tp(k,2),'k.','markersize',ms)
hold off

axis([min(proc(:,1)) max(proc(:,1)) 1.1*min(proc(:,2)) 1.1*max(proc(:,2))])"
