    for i = 1 : length(dirListC)
        
        dirSt = dirListC{i};
        archiveDir = [dirRoot, dirSt, '\\'];
        saveFile = [storeHere, dirSt, '.mat'];
        
        test = fopen(saveFile);
        
        if test == -1
            
            try
