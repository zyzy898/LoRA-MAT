2123,computeEulerAngle.m,70.308,60,84.62,30,100.0,76.92,70-80,"function rpy = computeEulerAngle(obj)
    
    gst = obj.computeForwardKinematics();
    
    Rot = CoordinateFrame.RigidOrientation(gst);
    Rot0 = CoordinateFrame.RigidOrientation(obj.gst0);
    RotW = Rot * transpose(Rot0);
    yaw = atan2(RotW(2,1),RotW(1,1));
    roll = atan2(RotW(3,2),RotW(3,3));
    pitch = atan2(-RotW(3,1) .* cos(roll),RotW(3,3));
    
    rpy = [roll; pitch; yaw];
end"
2124,ComputeExactMarginalsHMM.m,72.6,60,68.0,75,100.0,60.0,70-80,"function [M, PCalibrated] = ComputeExactMarginalsHMM(F)



compressedCliqueTree = CreateCliqueTreeHMM(F);
PCalibrated = CliqueTreeCalibrate(compressedCliqueTree);
varsList = sort(unique([F(:).var]));
M = repmat(struct('var', 0, 'card', 0, 'val', []), length(varsList), 1);
for i = 1:length(varsList)
    assert (varsList(i) == i);
    if (i == 1)
        clique = PCalibrated.cliqueList(i);
        M(i) = FactorMarginalization(clique, 2);
    else
        clique = PCalibrated.cliqueList(i-1);
        M(i) = FactorMarginalization(clique, i-1);
    end
    
    if any(M(i).val ~= 0)
        M(i).val = M(i).val - logsumexp(M(i).val);
    end

end

end"
