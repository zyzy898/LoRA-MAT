3746,createReadmeAppendNotes.m,73.332,100,47.22,75,100.0,44.44,70-80,"function createReadmeAppendNotes

for i=1:5
    
    pathStr = getPathStrDialog(pwd,'Select notes to append to Readme.txt','*.*');
    if isempty(pathStr)
        return
    end
    
    [fid, message] = fopen(pathStr,'r');
    if fid == -1
        warndlg(messsage);
        return
    end
    [A,rcount] = fread(fid,inf);
    status = fclose(fid);
    if status == -1
        warndlg(messsage);
        return
    end
    
    [fid, message] = fopen('Readme.txt','a');
    if fid == -1
        warndlg(messsage);
        return
    end
    wcount = fwrite(fid,A);
    if wcount ~= rcount
        warning(['createReadmeAppendNotes failed to append entire notes file, ',pathStr]);
    end
    status = fclose(fid);
    if status == -1
        warndlg(messsage);
        return
    end
end"
3747,createReadmeSession.m,77.34,80,63.64,100,100.0,43.06,70-80,"function createReadmeSession(info)
global mrSESSION dataTYPES

if notDefined('info')
    defaults = {...
            mrSESSION.sessionCode, mrSESSION.description,...
            mrSESSION.subject,'','','','',...
            num2str(mrSESSION.examNum),'',''...
