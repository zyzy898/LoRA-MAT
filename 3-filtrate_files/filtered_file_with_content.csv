                for x2=1:XNBP
                    for nbo2=1:NBO
                        D(i,j)= (sqrt((y1-y2)^2 + (x1-x2)^2) + ...
                                 min( [abs(nbo1-nbo2) NBO-abs(nbo1-nbo2)] ));
                        
                        j=j+1;
                    end
                end
            end
            i= i+1;
            
        end
    end
end
maxDist= max(D(:));
D= min(D,thresh);
    
