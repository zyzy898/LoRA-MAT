edges = zeros(0, 4);


while true    
    modif = 0;
    
	for i=1:NL
        
        edges(i, 1:2) = lines(i, 1:2);
        
        pi = intersectLines(lines(i,:), lines);
        
        pos = linePosition(pi, lines(i,:));
        
                
        indr = find(pos>1e-12 & pos~=Inf);
        [posr, indr2] = sort(pos(indr));
        
        
        for i2=1:length(indr2)
            
            il = indr(indr2(i2));

            pos2 = linePosition(pi(il, :), lines(il, :));
            
            if pos2>0
                if pos2<abs(posr(i2)) && pos2<lines(il, 5)
                    if lines(i, 5) ~= posr(i2)
                        edges(i, 3:4) = pi(il,:);
                        lines(i, 5) = posr(i2); 
                        modif = 1;
                    end                                                           
                    break;
                end
            end
        end   % end processing of right points of the line
              
        
	end % end processing of all lines
    
    if ~modif
        break;
    end
end

edges = [edges ; box(1,:) box(2,:) ; box(2,:) box(3,:); ...
                 box(3,:) box(4,:) ; box(4,:) box(1,:)  ];"
3531,Cramer.m,76.5,60,81.25,60,100.0,81.25,70-80,"function x = cramer(A, b)


[m, n] = size(A);
if m ~= n
  error('Matrix is not square.') 
end
if det(A) == 0
  error('Matrix is singular.')
end
for j = 1:n
  B = A;
  B(:, j) = b;
  x(j) = det(B) / det(A);
end
x = x';"
3532,crameri.m,78.57,100,57.14,100,100.0,35.71,70-80,"function cmap = crameri(ColormapName,varargin) 


if nargin==0
   figure('menubar','none','numbertitle','off','Name','crameri options:')
   
   if license('test','image_toolbox')
      imshow(imread('crameri7.0.png')); 
   else
      axes('pos',[0 0 1 1])
      image(imread('crameri7.0.png')); 
      axis image off
   end
   
   return
end


assert(isnumeric(ColormapName)==0,'Input error: ColormapName must be a string.') 


NLevels = 256; 
autopivot = false; 
PivotValue = 0; 
InvertedColormap = false; 


dash = strncmp(ColormapName,'-',1); 
if any(dash) 
   InvertedColormap = true; 
   ColormapName(dash) = []; 
end


if ismember(ColormapName,{'dem','topo'})
   ColormapName = 'oleron'; 
end

tmp = strncmpi(varargin,'pivot',3); 
if any(tmp) 
   autopivot = true; 
   try
      if isscalar(varargin{find(tmp)+1})
         PivotValue = varargin{find(tmp)+1}; 
         tmp(find(tmp)+1) = 1; 
      end
   end
   varargin = varargin(~tmp); 
end

tmp = isscalar(varargin); 
if any(tmp) 
   NLevels = varargin{tmp}; 
end


try
   S = load('CrameriColourMaps7.0.mat',ColormapName); 
   cmap = S.(ColormapName); 
catch
   error(['Unknown colormap name ''',ColormapName,'''. Try typing crameri with no inputs to check the options and try again.'])
end

if NLevels~=size(cmap,1) 
   cmap = interp1(1:size(cmap,1), cmap, linspace(1,size(cmap,1),NLevels),'linear');
end


if InvertedColormap
   cmap = flipud(cmap); 
end


if autopivot
   clim = caxis; 
   maxval = max(abs(clim-PivotValue)); 
   cmap = interp1(linspace(-maxval,maxval,size(cmap,1))+PivotValue, cmap, linspace(clim(1),clim(2),size(cmap,1)),'linear');
end


if nargout==0
   colormap(gca,cmap) 
   clear cmap  
end"
3533,CRandomWalk.m,77.926,100,68.29,75,100.0,46.34,70-80,"function [RWs]=CRandomWalk(Dim,max_iter,lb, ub,antlion,current_iter,I)
if size(lb,1) ==1 && size(lb,2)==1 %Check if the bounds are scalar
    lb=ones(1,Dim)*lb;
    ub=ones(1,Dim)*ub;
end

if size(lb,1) > size(lb,2) %Check if boundary vectors are horizontal or vertical
    lb=lb';
    ub=ub';
end


if current_iter<(max_iter*0.1)
    I=1;

end

lb=I*lb; % Equation (2.10) in the paper
ub=I*ub; % Equation (2.11) in the paper

if rand<0.5
    lb=lb+antlion; % Equation (2.8) in the paper
else
    lb=-lb+antlion;
end

if rand>=0.5
    ub=ub+antlion; % Equation (2.9) in the paper
else
    ub=-ub+antlion;
end

for i=1:Dim
    X = [0 cumsum(2*(rand(max_iter,1)>0.5)-1)']; % Equation (2.1) in the paper
    a=min(X);
    b=max(X);
    c=lb(i);
    d=ub(i);      
    X_norm=((X-a).*(d-c))./(b-a)+c; % Equation (2.7) in the paper
    RWs(:,i)=X_norm;
end"
3534,Crane_varyparam.m,72.334,100,73.96,45,100.0,42.71,70-80,"clear all
close all
clc


g = 9.81;   %[m/s/s]
z = 1e-3;   %[-] damping of the pendulum

Lbound = [0.2,0.8]; Lrate = [-0.1,0.1];

l = SchedulingParameter('L',Lbound,Lrate);    %[m]
lg = linspace(Lbound(1),Lbound(2),100);

degree = 1; knots = 2;
opti = splines.OptiSpline();
b = splines.BSplineBasis(Lbound,degree,2+knots);
t = splines.TensorBasis(b,'L');
linv = opti.Function(t,[1,1],'full');

grid = linspace(Lbound(1),Lbound(2),100)';
var = linv.list_eval(grid);
ref = 1./grid;

opti.minimize(norm(ref-var,2));
opti.subject_to({var-ref >= 0});
opti.solver('ipopt');
sol = opti.solve();
linv = sol.value(linv); %inverse mapping of l
figure, plot(grid,linv.list_eval(grid),grid,ref);

A = [0 1 0;0 0 1;0 -g*linv -z*linv];
B = [0;0;1];
C = [g*linv,z*linv,2];
D = [0];

Gm = SSmod(A,B,C,D,l);
G = IOSystem(Gm)

WS = Weight.LF(0.10,1,-20);
MS = Weight.DC(6);
WU = Weight.HF(0.1,1,-40);

K = IOSystem(1,1);

r = Signal();

u = G.in;
x = G.out;

e = r - x;

c1 = (K.in == e);               % Assign the error to the controller input
c2 = (K.out == u);              % Assign the plant input to the controller output

P = IOSystem(G,K,[c1;c2]);

S = Channel(e/r,'Sensitivity');
U = Channel(u/r,'Input Sensitivity');
T = Channel(x/r,'Complementary Sensitivity');

options.controller_name = 'Varying parameter controller';
obj = []; %[WS*S;WU*U];
constr = [WS*S];
[P,C,info] = P.solve(obj,constr,K,options);
figure, bodemag(info);

simulation_on = true;
if simulation_on
    P = extract(T);

    t = [0,150];
    x0 = zeros(P.nx,1);
    
    A = 0.1;
    f = 1/(2*pi);
    p = @(t) (0.5+A*sin(f*2*pi*t)); %fixed parameter
    dp = @(t) (A*cos(f*2*pi*t)*2*pi*f);
    tp = linspace(0,150,1500);
    
    figure, 
    x = [Lbound(1),Lbound(1),Lbound(2),Lbound(2)];
    y = [Lrate(1),Lrate(2),Lrate(2),Lrate(1)];
    patch(x,y,'blue','FaceAlpha',.3), hold on
    plot(p(tp),dp(tp),'k','LineWidth',2), hold off
    axis([Lbound(1)-0.05,Lbound(2)+0.05,Lrate(1)-0.025,Lrate(2)+0.025])
    xlabel('$L$','interpreter','latex')
    ylabel('$\\dot{L}$','interpreter','latex')

    u = @(t) (0.5*sin(0.05*2*pi*t)); %step input
    [y,t,x] = sim(P(x,r),u,p,t);
    
    
    figure, plot(t,x)
    figure, plot(t,y,'b',t,u(t),'k')

end"
3535,Crank_Nicolson.m,74.0,100,70.0,45,100.0,55.0,70-80,"clc
clear 

ti=0;    % Initial Time
tf=150;   % Final Time

 h = 2.5;

i=1;
t(1)=ti;
while t(i)<tf  
        i=i+1;
        t(i)=t(i-1)+h;
end
t(i)=tf; clear i;
n=length(t);


v = zeros(n,1);
alpha = zeros(n,1);
beta  = zeros(n,1);

for i=1:n-1
    alpha(i) = 3*t(i)/(1+t(i));
    beta(i)  = 2*(1+t(i))^3*exp(-t(i));
end

v(1)=1; 

for i=1:n-1
    v(i+1) = ((1-h/2*alpha(i))*v(i)+h/2*(beta(i+1)+beta(i)))/(1+h/2*alpha(i+1));
end

v2 = zeros(n,1);
for i=1:n
     v2(i) = exp(-t(i))*(1+t(i))^3;
end
error=v2-v;
figure
plot(t,v,'.',t,v2,'-')"
3536,crashCheck.m,72.416,100,56.25,60,100.0,45.83,70-80,"function [crash] = crashCheck(carFstate,carLstate,carFinput,carLinput,T)



x0=[carFstate(1); carLstate(1); carFstate(2); carLstate(2);];
u=[carFinput;carLinput];

eventOptions = odeset('Events',aux_eventFcn());
stepsizeOptions = odeset('MaxStep',0.2*T);
options = odeset(eventOptions,stepsizeOptions);

[t,x,te,xe,index] = ode45(aux_getfcn(u),[0, T],x0,options);

if isempty(index)
    x0=x(end,:);
    u=[-1;-1];
    [t,x,te,xe,index] = ode45(aux_getfcn(u),[0, 100*T],x0,options);
end

if index==1
    crash=1;
else
    crash=0;
end
    
end



function [handle] = aux_getfcn(u)
    function dxdt = f(t,x)
        dxdt = twoVehEid(t,x,u);
    end
    handle = @f;
end


function [handle] = aux_eventFcn()
    function [value,isterminal,direction] = f(t,x)
        value(1)=x(2)-x(1);
        value(2)=x(3);
        isterminal = [1 1];   
        direction = [0 0];  
    end

    handle = @f;

end"
