grid on

lighting phong
material dull

if ~isfield(Handles,'Hl'),
  Handles.Hl = camlight;
elseif isempty(Handles.Hl),
  Handles.Hl = camlight;
end

xlabel('x (cm)')
ylabel('y (cm)')
zlabel('z (cm)')

rotate3d on

return"
948,ctf_channel_select.m,82.988,100,80.46,100,100.0,34.48,80-90,"function [CHAN,type] = ctf_channel_select(ctf,CHAN)







