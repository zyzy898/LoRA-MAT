6385,comp_irdgt.m,63.714,60,71.43,30,100.0,57.14,61-70,"function cout=comp_irdgt(cin,a,M)

N=size(cin,1)/M;
W=size(cin,2);
L=N*a;

cin=reshape(cin,M,N,W);

Mhalf=ceil(M/2);
Mend=Mhalf*2-1;

cout=zeros(M,N,W,assert_classname(cin));

