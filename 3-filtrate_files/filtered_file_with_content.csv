    stateS.handle.CERRAxisScreenLeftLabel(i)  = text('parent', stateS.handle.CERRAxis(i), 'string', 'L', 'position', [0.02 0.1 2], 'color', 'y', 'units', 'data', 'visible', 'off', 'hittest', 'off','fontSize',8);
    stateS.handle.CERRAxisScreenRightLabel(i)  = text('parent', stateS.handle.CERRAxis(i), 'string', 'R', 'position', [0.1 0.02 2], 'color', 'y', 'units', 'data', 'visible', 'off', 'hittest', 'off','fontSize',8);
    stateS.handle.CERRAxisScreenTopLabel(i)  = text('parent', stateS.handle.CERRAxis(i), 'string', 'A', 'position', [0.1 0.02 2], 'color', 'y', 'units', 'data', 'visible', 'off', 'hittest', 'off','fontSize',8);
