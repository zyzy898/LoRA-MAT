4197,ctransform.m,74.942,100,64.71,60,100.0,50.0,70-80,"function [v,g] = ctransform(x, u, y, p, epsilon)


if nargin<5
    epsilon = 0;
end

n = size(x,2);
m = size(y,2);

c = distmat(x,y).^p; % cost
S = c -  repmat(u(:), [1 m]);
[v,I] = min(S);
if epsilon>0
    if 1
        S = S - repmat(v, [size(S,1) 1]);
        v = - epsilon * log( sum(  exp( -S/epsilon ) ) ) + v;
    else
        v = - epsilon * log( sum(  exp( -S/epsilon ) ) );    
    end
end
v = v(:);

if nargout>1
    if epsilon==0
        g = sparse( I, 1:m, ones(m,1),n, m );
    else
        g = exp( -S/epsilon );
        g = g ./ repmat( sum(g), [n 1] );
    end
    
end

end"
