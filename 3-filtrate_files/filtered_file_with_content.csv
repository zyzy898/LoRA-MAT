3211,copy_fields.m,73.38,60,58.62,100,100.0,48.28,70-80,"function to_out = copy_fields ( from, to, kwargs )

    arguments
        from                        (1,1)   struct
        to                          (1,1)   struct
        kwargs.error_on_overwrite   (1,1)   logical = false
    end

    fns = string ( fieldnames ( from ) ) ;

    for fi = 1 : numel ( fns )

        fn = fns ( fi ) ;

        if kwargs.error_on_overwrite && isfield ( to, fn )

            to_out.copy_fields_error__ = ""The given struct already contains a field called '"" + fn + ""'."" ;

            return

        end

        to.(fn) = from.(fn) ;

    end % for

    to_out = to ;

end % function"
