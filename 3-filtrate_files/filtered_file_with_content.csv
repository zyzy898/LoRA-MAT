6461,compute_primal.m,67.0,30,80.0,45,100.0,80.0,61-70,"function [ primal_obj ] = compute_primal(X, Y, W, Omega, lambda)

total_loss = 0;
for t=1:length(X)
    preds = Y{t}.*(X{t}*W(:, t));
    total_loss = total_loss + mean(max(0.0, 1.0 - preds));
end
primal_obj = total_loss + lambda / 2 * trace(W * Omega * W');

end"
