6817,DEM_demo_DFP.m,59.538,60,57.69,30,100.0,50.0,51-60,"function DEM_demo_DFP
 
spm_figure('GetWin','DEM');

M        = spm_DEM_M('convolution model');
M(1).V   = exp(8);
M(1).W   = exp(16);
M(1).E.N = 32;

 
N     = 32;                                        % length of data sequence
U     = exp(-((1:N) - N/4).^2/(2*(N/32)^2));       % Gaussian cause
DEM   = spm_DEM_generate(M,U,{},{32 16});
 
spm_DEM_qU(DEM.pU)
 
 
DEM  = spm_DFP(DEM);
 
spm_figure('GetWin','Figure 1');
spm_DEM_qU(DEM.qU,DEM.pU)


DEM  = spm_DEM(DEM);
 
spm_DEM_qU(DEM.qU,DEM.pU)"
6818,computeSR_IBexact.m,60.0,30,70.0,30,100.0,70.0,61-70,"function [SR,SR_cumul,SR_vect] = computeSR_IBexact(d_vec)
nn = length(d_vec);

SR_vect = erf( 1./sqrt(8*d_vec) );

