ccell = mat2cell(c,Lc);"
2513,comp_gabdual_long.m,70.818,100,66.67,45,100.0,42.42,70-80,"function gd=comp_gabdual_long(g,a,M);
  
L=length(g);
R=size(g,2);

gf=comp_wfac(g,a,M);

b=L/M;
N=L/a;

c=gcd(a,M);
d=gcd(b,N);
  
p=b/d;
q=N/d;

gdf=zeros(p*q*R,c*d,assert_classname(g));

G=zeros(p,q*R,assert_classname(g));
