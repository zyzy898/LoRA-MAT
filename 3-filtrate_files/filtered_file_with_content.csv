            t = find(ismember(Y(i,s).date,dates(d)),1);
            y = [y Y(i,s).Y(t)];
        end
        s = ~(isnan(y) | y == 0);
        if any(s)
            A(i).Y(d,1) = mean(y(s));
        end
    end
end

for i = 5
