    elseif thApproach == 2
        inactiveGenes = findGenesBelowThresholdLocal1(lowerTh,trDataPath,sheetIndex);
    else
        inactiveGenes = findGenesBelowThresholdLocal2(lowerTh, upperTh, trDataPath,sheetIndex);
    end

    genes_to_delete = {};
    counter = 1;
    for j=1:1:length(inactiveGenes)
