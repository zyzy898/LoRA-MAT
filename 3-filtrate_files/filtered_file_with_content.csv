4326,CurvedDGJump2D.m,72.42,60,73.68,60,100.0,68.42,70-80,"function [jumpU] = CurvedDGJump2D(gU, gmapD, bcU)


Globals2D;

gUM = gU(gauss.mapM); gUP = gU(gauss.mapP); gUP(gmapD) = bcU(gmapD);

fx = gUM - gUP;
jumpU = -gauss.interp'*(gauss.W.*fx);

jumpU(:,straight) = V*V'*(jumpU(:,straight)./J(:,straight));

Ncurved = length(curved);
for m=1:Ncurved
  k = curved(m);
  mmCHOL = cub.mmCHOL(:,:,k);
  jumpU(:,k) = mmCHOL\\(mmCHOL'\\jumpU(:,k));
end
return"
4327,CurvedDGPenalty2D.m,72.8,60,76.0,60,100.0,68.0,70-80,"function [penaltyU] = CurvedDGPenalty2D(gU, gmapD, bcU)


Globals2D;

gUM = gU(gauss.mapM); gUP = gU(gauss.mapP); gUP(gmapD) = bcU(gmapD);

hinv = 2*gauss.sJ./gauss.J; hinv = max(hinv(gauss.mapP), hinv(gauss.mapM));
NG = gauss.NGauss;
ids = (1:NG)';        ghinv(ids,:) = ones(NG, 1)*max(hinv(ids,:), [], 1);
ids = (NG+1:2*NG)';   ghinv(ids,:) = ones(NG, 1)*max(hinv(ids,:), [], 1);
ids = (2*NG+1:3*NG)'; ghinv(ids,:) = ones(NG, 1)*max(hinv(ids,:), [], 1);

fx = 0.5*( gUM - gUP).*ghinv*(N+1)^2;
penaltyU = -gauss.interp'*(gauss.W.*fx);

penaltyU(:,straight) = V*V'*(penaltyU(:,straight)./J(:,straight));

Ncurved = length(curved);
for m=1:Ncurved
  k = curved(m);
  mmCHOL = cub.mmCHOL(:,:,k);
  penaltyU(:,k) = mmCHOL\\(mmCHOL'\\penaltyU(:,k));
end
return"
4328,CurvedEuler2D.m,75.472,100,67.65,45,100.0,64.71,70-80,"function Q = CurvedEuler2D(Q, FinalTime, ExactSolution, ExactSolutionBC, fluxtype)


Globals2D;

CubatureOrder = floor(2*(N+1)*3/2); cub = CubatureVolumeMesh2D(CubatureOrder);

NGauss = floor((N+1)*2); gauss = GaussFaceMesh2D(NGauss);

gamma = 1.4;
dt = EulerDT2D(Q, gamma); tstep = 1; time = 0;
rhsQ = 0*Q; resQ = 0*Q;

while (time<FinalTime)
  
  if(time+dt>FinalTime)
    dt = FinalTime-time;
  end
  
  rhsQ  = CurvedEulerRHS2D(Q, time, ExactSolutionBC, fluxtype);
  Q1 = Q + dt*rhsQ;
  
  rhsQ  = CurvedEulerRHS2D(Q1, time, ExactSolutionBC, fluxtype);
  Q2 = (3*Q + Q1 + dt*rhsQ)/4;
  
  rhsQ  = CurvedEulerRHS2D(Q2, time, ExactSolutionBC, fluxtype);
  Q = (Q + 2*Q2 + 2*dt*rhsQ)/3;

  time = time+dt;
  dt = EulerDT2D(Q, gamma);
  
  tstep = tstep+1;
end;
return;"
