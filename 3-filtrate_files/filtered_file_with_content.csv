L    = @(x,P) P.P(1)*x(1,:).^2 + P.P(2)*x(2,:).^2;
dLdx = @(x,P) [2*P.P(1)*x(1,:);
               2*P.P(2)*x(2,:)];
           
M.IS = @(P,M,U)([0 P.Q;-P.Q 0]*dLdx(U,P));
