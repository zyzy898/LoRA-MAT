inter2 = intersectLinePlane(perpLine, plane);
pointProps.Marker='^';
pointProps.MarkerFaceColor='c';
pointProps.MarkerEdgeColor='k';
drawPoint3d(inter2,pointProps);

circles = [50 50 50 10 10 20 30; 60 60 60 15 15 25 35];
drawCircle3d(circles)"
