        elseif strcmpi(ccMode, 'thresh')
            saveDrawSlice(hAxis);
            stateS.contouringMetaDataS.ccSlice = sliceNum;
            loadDrawSlice(hAxis);
            drawContour('threshMode', hAxis);
        elseif strcmpi(ccMode, 'threshold')
            ud = stateS.handle.controlFrameUd ;
