3409,Covariance.m,77.678,100,86.79,45,100.0,56.6,70-80,"function Covariance(N)


T = 5; % time between measurements
sigma = 30; % position measurement standard deviation
R = sigma^2;
P0 = [100 0 0; 0 10 0; 0 0 1]; % initial state estimate uncertainty
F = [0 1 0; 0 0 1; 0 0 0];
H = [1 0 0];
phi = [1 T T*T/2; 0 1 T; 0 0 1]; % state transition matrix
x = [1; 1; 1]; % initial state
xhat = x; % initial state estimate

posArray = [];
xhatArray = [];
zArray = [];
Pplus = P0;
Varminus = [];
Varplus = [P0(1,1)];

for k = 1 : N
    x = phi * x;
    z = H * x + sigma * randn;
    Pminus = phi * Pplus * phi';
    K = Pminus * H' * inv(H * Pminus * H' + R);
    xhat = phi * xhat;
    xhat = xhat + K * (z - H * xhat);
    Pplus = (eye(3) - K * H) * Pminus * (eye(3) - K * H)' + K * R * K';
    Pplus = (Pplus + Pplus') / 2;
    posArray = [posArray x(1)];
    xhatArray = [xhatArray xhat];
    zArray = [zArray z];
    Varminus = [Varminus Pminus(1,1)];
    Varplus = [Varplus Pplus(1,1)];
end

close all;
k = 1 : N;
plot(k, zArray-posArray, 'r:');
hold;
plot(k, xhatArray(1,:)-posArray, 'b-');
set(gca,'FontSize',12); set(gcf,'Color','White');
xlabel('time step'); ylabel('position');
legend('measurement error', 'estimation error');

figure; hold;
for k = 1 : N-1
    plot([k-1 k], [Varplus(k) Varminus(k+1)]);
    plot([k k], [Varminus(k+1) Varplus(k+1)]);
end
set(gca,'FontSize',12); set(gcf,'Color','White');
xlabel('time step');
ylabel('position estimation error variance');"
3410,covarianceIntersect.m,74.314,80,55.32,100,100.0,36.25,70-80,"function [CMerged,omega,xMerged]=covarianceIntersect(C1,C2,optCrit,x1,x2)

if(nargin<3||isempty(optCrit))
    optCrit='det';
end

n=length(C1);

A=twoMatDiag(C1,C2);

d=diag(A*C2*A');
dBar=1./d;
dTilde=dBar./(1-dBar);

I = eye(size(C1));
invC1=C1\\I;
invC2=C2\\I;

switch(optCrit)
    case 'det'%Determinant minimization
        if(n==1)
            if(C1<C2)
                omega=1;
            else
                omega=0;
            end
        elseif(n==2)
            omega=-(1/2)*(dTilde(1)+dTilde(2));
        elseif(n==3)
            sqrtTerm=sqrt(sum(dTilde.^2)-dTilde(1)*dTilde(2)-dTilde(1)*dTilde(3)-dTilde(2)*dTilde(3));
            omega(1,1)=-(1/3)*(sum(dTilde)+sqrtTerm);
            omega(2,1)=-(1/3)*(sum(dTilde)-sqrtTerm);
        elseif(n==4)
            b=(3/4)*sum(dTilde);

            c=0;
            for i=1:n
               for j=(i+1):n
                   c=c+dTilde(i)*dTilde(j);
               end
            end
            c=(1/2)*c;

            d=0;
            for i=1:n
                for j=(i+1):n
                    for k=(j+1):n
                        d=d+dTilde(i)*dTilde(j)*dTilde(k);
                    end
                end
            end
            d=(1/4)*d;

            Q=sqrt((2*b^3-9*b*c+27*d)^2-4*(b^2-3*c)^3);
            C=((1/2)*(Q+2*b^3-9*b*c+27*d))^(1/3);

            omega(1,1)=-(b/3)-C/3-(b^2-3*c)/(3*C);
            omega(2,1)=-(b/3)+C*(1+1j*sqrt(3))/6+(1-1j*sqrt(3))*(b^2-3*c)/(6*C);
            omega(3,1)=-(b/3)+C*(1-1j*sqrt(3))/6+(1+1j*sqrt(3))*(b^2-3*c)/(6*C);
        else%For n>4
            piVals=zeros(1,n-1);
            for curPi=1:(n-1)
                piIdx=1:curPi;
                while(1)
                    piVals(curPi)=piVals(curPi)+prod(dTilde(piIdx));
                    
                    curLevel=curPi;
                    allDone=false;
                    while(piIdx(curLevel)+1>(n-curPi+curLevel))
                        curLevel=curLevel-1;
                        if(curLevel<1)
                            allDone=true;
                            break;
                        end
                    end
                    if(allDone)
                        break;
                    end
                    piIdx(curLevel)=piIdx(curLevel)+1;
                    
                    for k=(curLevel+1):curPi
                        piIdx(k)=piIdx(k-1)+1;
                    end
                end
            end
            
            poly2Solve=(n:-1:1).*[1,piVals];
            
            omega=roots(poly2Solve);
        end
        
        if(n>1)
            omega=[real(omega);1/2;0;1];
            numHyp=length(omega);

            minCost=Inf;
            minOmega=[];
            for curHyp=1:numHyp
                if(omega(curHyp)>=0&&omega(curHyp)<=1)
                    cost=1/det(omega(curHyp)*invC1+(1-omega(curHyp))*invC2);

                    if(cost<minCost)
                       minCost=cost;
                       minOmega=omega(curHyp);
                    end
                end
            end

            omega=minOmega;
        end
    case 'trace'
        if(n==1)
            if(C1<C2)
                omega=1;
            else
                omega=0;
            end
        elseif(n==2)
            invA=A\\I;
            a=diag(invA'*invA);
            
            denom=a(1)*(1+dTilde(1))+a(2)*(1+dTilde(2));
            p=(a(1)*dTilde(2)*(1+dTilde(1))+a(2)*dTilde(1)*(1+dTilde(2)))/denom;
            q=(a(1)*dTilde(2)^2*(1+dTilde(1))+a(2)*dTilde(1)^2*(1+dTilde(2)))/denom;
            
            omega(1,1)=-p+sqrt(p^2-q);
            omega(2,1)=-p-sqrt(p^2-q);
        else%for n>=3
            invA=A\\I;
            a=diag(invA'*invA);
            
            numPolyEls=2*(n-1)+1;
            poly2Solve=zeros(numPolyEls,1);
            for i=1:n
                coeff=a(i)*(1+dTilde(i));
                
                jPoly=zeros(numPolyEls,1);
                jPoly(end)=1;
                for j=1:n
                    if(j==i)
                        continue;
                    end
                    
                    jPoly=conv(jPoly,[1;2*dTilde(j);dTilde(j)^2]);
                    jPoly=jPoly((end-numPolyEls+1):end);
                end
                poly2Solve=poly2Solve+coeff*jPoly;
            end
            
            omega=roots(poly2Solve);
        end
        
        if(n>1)
            omega=[real(omega);1/2;0;1];
            numHyp=length(omega);

            minCost=Inf;
            minOmega=[];
            for curHyp=1:numHyp
                if(omega(curHyp)>=0&&omega(curHyp)<=1)
                    cost=trace((omega(curHyp)*invC1+(1-omega(curHyp))*invC2)\\I);

                    if(cost<minCost)
                       minCost=cost;
                       minOmega=omega(curHyp);
                    end
                end
            end

            omega=minOmega;
        end
    otherwise
        error('Invalid optimality criterion chosen.')
end

CMergedInv=omega*invC1+(1-omega)*invC2;
CMerged=CMergedInv\\I;

if(nargout>2)
    if omega==0 && strcmp(optCrit,'det') && isinf(dTilde(1))
        xMerged=CMerged*(invC1*x1);
    elseif strcmp(optCrit,'trace') && any(isinf(dTilde))
        xMerged=CMerged*(0.5*invC1*x1+0.5*invC2*x2);
    else
        xMerged=CMerged*(omega*invC1*x1+(1-omega)*invC2*x2);
    end     
end
end"
3411,covarianceIntersectSCI.m,74.756,100,58.54,75,100.0,40.24,70-80,"function [PSCI,xSCI]=covarianceIntersectSCI(CovHyp,covType,xHyp,u,numSamp)

numDim=size(CovHyp,1);
numHyp=size(CovHyp,3);

if(nargin<5||isempty(numSamp))
    numSamp=max(100*(numHyp-1),1);
end

if(nargin<4||isempty(u))
    u=0.5;
end

if(nargin<2||isempty(covType))
   covType=0; 
end

if(covType==0)%If covariance matrices are passed.
    PInvHyp=zeros(numDim,numDim,numHyp);

    for curHyp=1:numHyp
        PInvHyp(:,:,curHyp)=inv(CovHyp(:,:,curHyp));
    end
else%If inverse covariance matrices are passed.
    PInvHyp=CovHyp;
end

if(numHyp>0)
    P0=zeros(numDim,numDim);
    for curHyp=1:numHyp
        P0=P0+PInvHyp(:,:,curHyp);
    end
    P0Inv=P0;
    P0=P0\\size(P0);

    S0=chol(P0,'lower');

    x=S0*randn(numDim,numSamp);

    maxVals=zeros(numSamp,1);
    for curSamp=1:numSamp
        xCur=x(:,curSamp);

        maxVal=-1;
        for curHyp=1:numHyp
            val=xCur'*PInvHyp(:,:,curHyp)*xCur;
            maxVal=max(val,maxVal);
        end
        maxVals(curSamp)=maxVal;
    end

    rMax=-1;
    rMin=Inf;
    for curSamp=1:numSamp
        xCur=x(:,curSamp);
        curRat=xCur'*P0Inv*xCur/maxVals(curSamp);
        rMax=max(curRat,rMax);
        rMin=min(curRat,rMin);
    end

    PSCI=P0./(u*rMin+(1-u)*rMax);
else%Given 1 or 0, don't change it.
    if(numHyp==0)
        xSCI=[];
        PSCI=[];
        return;
    end
    return
end

if(nargin>2&&~isempty(xHyp))
    xSCI=zeros(numDim,1);
    
    for curHyp=1:numHyp
        xSCI=xSCI+PInvHyp(:,:,curHyp)*xHyp(:,curHyp);
    end
    xSCI=P0*xSCI;
else
    xSCI=[];
end

end"
3412,covariances_p300.m,78.42,60,73.68,90,100.0,68.42,70-80,"function [COV P1] = covariances_p300(X,Y,method_cov,arg_cov)

