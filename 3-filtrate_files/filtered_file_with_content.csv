    plot(agents{i}.learnHistory.reward,'Color',cmap(i,:),'LineStyle','-','DisplayName',[labels{i},': $\\sum r_i$'])
    plot(agents{i}.learnHistory.Q0,'Color',cmap(i,:),'LineStyle','--','DisplayName',[labels{i},': $Q_0$'])
