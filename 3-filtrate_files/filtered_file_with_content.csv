1747,colorspace_test.m,71.044,60,86.96,30,100.0,78.26,70-80,"fprintf(['\\nTransform accuracy test\\n\\n',...
      'To verify the invertibility of the color transfomations, this test\\n',...
      'transforms sRGB data to a space, inverts, and compares with the\\n',...
      'original data.\\n']);
N = 1e5;            % Number of points to test
A = rand(N,3);      % Generate points uniformly in the sRGB colorspace

A(1,:) = 0;
A(2,:) = 1;

Space = {'YPbPr', 'YCbCr', 'JPEG-YCbCr', 'YDbDr', 'YIQ','YUV', 'HSV', ...
      'HSL', 'HSI', 'XYZ', 'Lab', 'Luv', 'LCH', 'CAT02 LMS'};
fprintf('\\n Transform          RMSE Error   Max Error\\n\\n');

for k = 1:length(Space)
   B = colorspace([Space{k},'<-RGB'],A);  % Convert to Space{k}
   R = colorspace(['RGB<-',Space{k}],B);  % Convert back to sRGB
   RMSE = sqrt(mean((A(:) - R(:)).^2));
   MaxError = max(abs(A(:) - R(:)));
   fprintf(' RGB<->%-10s   %9.2e    %9.2e\\n', Space{k}, RMSE, MaxError);
end

fprintf('\\n\\n');"
1748,colorSubsystemCD.m,77.162,100,62.16,75,100.0,48.65,70-80,"function [newMap] = colorSubsystemCD(map, model, subsystem, color, areaWidth)

    if nargin < 5
        areaWidth = 8;
    end
    if nargin < 4
        color = 'RED';
    end

    newMap = map;
    rxnList = model.rxns(ismember([model.subSystems{:}]', subsystem));
    colors = createColorsMap;

    index = find(ismember(newMap.rxnName, rxnList));
    for j = index'
        newMap.rxnColor{j, 1} = colors(color);
        newMap.rxnWidth{j, 1} = areaWidth;
    end

    if any(strcmp('rxnReactantLineColor', fieldnames(newMap))) == 1
        for j = index'
            if ~isempty(newMap.rxnReactantLineColor{j})
                for k = 1:length(newMap.rxnReactantLineColor{j})
                    newMap.rxnReactantLineColor{j, 1}{k, 1} = colors(color);
                    newMap.rxnReactantLineWidth{j, 1}{k, 1} = areaWidth;
                end
            end
            if ~isempty(newMap.rxnProductLineColor{j})
                for m = 1:1:length(newMap.rxnProductLineColor{j})
                    newMap.rxnProductLineColor{j, 1}{m, 1} = colors(color);
                    newMap.rxnProductLineWidth{j, 1}{m, 1} = areaWidth;
                end
            end
        end
    end

end"
1749,colorToLabel.m,72.74,80,59.12,75,100.0,49.58,70-80,"function [imAllLabel,imHoriLabel, imVertLabel] = colorToLabel(imColorGrid, imNode, imHoriEdge, imVertEdge, verbose)







if(nargin < 5)
    verbose = false;
end


imHoriRGB = maskColorGrid(imColorGrid, imNode, imHoriEdge);
imVertRGB = maskColorGrid(imColorGrid, imNode, imVertEdge);

[imHoriLabel, imHoriRecv] = clusterColors(imHoriRGB, 1);
[imVertLabel, imVertRecv] = clusterColors(imVertRGB, 0);

if(verbose)
    figure('Name', 'colorToLabel', 'units','normalized','outerposition',[0 0  1  1]);
    subplot(2,1,1);
    imshowpair(imHoriRGB, imHoriRecv, 'Montage');
    title('[horizontal] Original color grid and detected labels in pseudocolor');
    drawnow
    
    subplot(2,1,2);
    imshowpair(imVertRGB, imVertRecv, 'Montage');
    title('[vertical] Original color grid and detected labels in pseudocolor');
    drawnow
end

imAllLabel = imHoriLabel + imVertLabel;

end

function imMaskedRGB = maskColorGrid(imEnhance, imNode, imEdgeMask)

imNodeWide = imdilate(imNode, strel('disk',1));

imEdgeMaskWide = imdilate(imEdgeMask, strel('disk',1));
