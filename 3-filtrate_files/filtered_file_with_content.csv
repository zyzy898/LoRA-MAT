2899,convdemo.m,76.71,100,54.84,90,100.0,38.71,70-80,"function out = convdemo(input, K, varargin)
    
    opt.delay = 0.5;
    opt.movie = [];
    opt = tb_optparse(opt, varargin);
        
    clf
  
    kcolor = [1 0 0] * 0.5;
    
    result = ones(size(input)) * NaN;
    
    subplot(121);
    
    h1 = showpixels(input, 'nolabel', 'fmt', '%.02f', 'color', 'y',  'here');
    title('Input image','FontSize', 18)
    subplot(122);
    
    showpixels(result, 'nolabel', 'fmt', '%.02f', 'color', 'y',   'here');
    title('Output image','FontSize', 18)
    
    if ~isempty(opt.movie)
        anim = Animate(opt.movie);
        anim.add();
    end
    
                
    nr_k = (numrows(K)-1)/2;
    nc_k = (numcols(K)-1)/2;
    
    for r=nr_k+1:numrows(input)-nr_k
        for c=nc_k+1:numcols(input)-nc_k
            
            im = icolor(input);
            
            win = input(r-nr_k:r+nr_k, c-nc_k:c+nc_k);
            
            result(r,c) = sum(sum( win .* K ));
           
            
            for i=-nr_k:nr_k
                for j=-nc_k:nc_k
                        im(r+i,c+j,:) = min(1, im(r+i,c+j,:) + reshape(kcolor, [1 1 3]));
                end
            end
            
            set(h1, 'CData', im);
    showpixels(result, 'nolabel', 'fmt', '%.02f', 'color', 'y',   'here');
            title('Output image','FontSize', 18)

            
            if isempty(opt.movie)
                pause(opt.delay);
            else
                anim.add();
            end
        end
    end
    
    if nargout > 0
        out = result;
    end"
2900,convectioncoupledExample.m,76.588,100,100.0,30,100.0,52.94,70-80,"clc
W = 1;
Nx = 300;
mesh1 = createMesh1D(Nx, W);
x = mesh1.cellcenters.x;
BC = createBC(mesh1); % all Neumann
BC.left.a(:)=0; BC.left.b(:)=1; BC.left.c(:)=1;
BC.right.a(:) =0; BC.right.b(:) =1; BC.right.c(:) =0;
phi1_old = createCellVariable(mesh1, 0.0, BC);
phi2_old = createCellVariable(mesh1, 0.0, BC);
phi3_old = createCellVariable(mesh1, 0.0, BC);
phi1 = phi1_old;
phi2 = phi2_old;
phi3 = phi3_old;
V= [6.9444; 3.4722; 2.3148];
uf1 = createFaceVariable(mesh1, V(1));
uf2 = createFaceVariable(mesh1, V(2));
uf3 = createFaceVariable(mesh1, V(3));
D = 1e-2;
Df = createFaceVariable(mesh1, D);
alfa = createCellVariable(mesh1,1.0);
Mconv1 = convectionUpwindTerm(uf1);
Mconv2 = convectionUpwindTerm(uf2);
Mconv3 = convectionUpwindTerm(uf3);
[Mbc, RHSbc] = boundaryCondition(BC);
FL = fluxLimiter('Superbee');
M=[-0.1200, 0.1200, 0; 0.0579, -0.1779, 0.1200; 0, 0.0772, -0.0772];
Ms=linearSourceTerm(alfa);
dt = 0.0005; % time step
final_t = W/max(V);
t = 0;
while t<final_t
    t = t+dt;
    [Mt1, RHSt1] = transientTerm(phi1_old, dt, alfa);
    [Mt2, RHSt2] = transientTerm(phi2_old, dt, alfa);
    [Mt3, RHSt3] = transientTerm(phi3_old, dt, alfa);
    Muw=[Mt1+Mconv1-M(1,1)*Ms+Mbc -M(1,2)*Ms -M(1,3)*Ms
         -M(2,1)*Ms Mt2+Mconv2-M(2,2)*Ms+Mbc  -M(2,3)*Ms
         -M(3,1)*Ms -M(3,2)*Ms Mt2+Mconv3-M(3,3)*Ms+Mbc];
    RHS=[RHSt1+RHSbc; RHSt2+RHSbc; RHSt3+RHSbc];
    X=Muw\\RHS;
    phi1.value=X(1:Nx+2);
    phi2.value=X((Nx+2+1):(2*(Nx+2)));
    phi3.value=X((2*(Nx+2)+1):end);
    phi1_old = phi1;
    phi2_old = phi2;
    phi3_old = phi3;
    figure(1);plot(x, phi1.value(2:Nx+1), x, phi2.value(2:Nx+1), '-o', x, ...
        phi3.value(2:Nx+1)); drawnow;

end"
2901,convectiondiffusiontutorial.m,77.0,60,100.0,45,100.0,80.0,70-80,"clc
L = 1;  % domain length
Nx = 25; % number of cells
meshstruct = createMesh1D(Nx, L);
BC = createBC(meshstruct); % all Neumann boundary condition structure
BC.left.a = 0; BC.left.b=1; BC.left.c=0; % left boundary
BC.right.a = 0; BC.right.b=1; BC.right.c=1; % right boundary
x = meshstruct.cellcenters.x;
D_val = -1;
D = createCellVariable(meshstruct, D_val);
Dave = harmonicMean(D); % convert a cell variable to face variable
alfa = createCellVariable(meshstruct, 1);
u = -10;
u_face = createFaceVariable(meshstruct, u);
Mconv =  convectionTerm(u_face);
Mconvupwind =  convectionUpwindTerm(u_face);
Mdiff = diffusionTerm(Dave);
[Mbc, RHSbc] = boundaryCondition(BC);
M = Mconv-Mdiff-Mbc;
Mupwind = Mconvupwind-Mdiff-Mbc;
RHS = -RHSbc;
c = solvePDE(meshstruct, M, RHS);
c_upwind = solvePDE(meshstruct, Mupwind, RHS);
c_analytical = (1-exp(u*x/D_val))/(1-exp(u*L/D_val));
figure(1)
hold all
plot(x, c.value(2:Nx+1), 'linewidth', 2);
plot(x, c_upwind.value(2:Nx+1), '-r', 'linewidth', 2);
plot(x, c_analytical, '^', 'linewidth', 2);
legend('central', 'upwind', 'analytical');"
2902,convectionODEexample.m,71.572,60,100.0,30,100.0,67.86,70-80,"clc
H = 1;
W = 1;
Nx = 100;
Ny = 100;
mesh1 = createMesh2D(Nx, Ny, W, H);
u = createCellVariable(mesh1, 0.001*ones(Nx,Ny));
uf = arithmeticMean(u);
D = 1e-2*createCellVariable(mesh1, 1e-2);
Df = arithmeticMean(D);
alfa = createCellVariable(mesh1, 1);
BC = createBC(mesh1); % all Neumann
BC.bottom.a(:) = 0; BC.bottom.b(:) = 1; BC.bottom.c(:) = 0;
BC.left.a(:) = 0; BC.left.b(:) = 1; BC.left.c(:) = 0;
phi_old = createCellVariable(mesh1, 0, BC);
phi_old.value(5:10, 5:10) = 1;
Mconv = convectionUpwindTerm(uf);
Mdif = diffusionTerm(Df);
[Mbc, RHSbc] = boundaryCondition(BC);
final_t = 500;
[M, RHS] = combineBC2D(BC, Mconv, ...
    zeros((Nx+2)*(Ny+2),1));
dcdt = @(t,c)(-M*c-RHS);
[t_temp, c_temp] = ode45(dcdt, [0 final_t], internalCells(phi_old));
for i =1:length(t_temp)
    phi.value = reshape(c_temp(i,:), Nx, Ny);
    figure(1);pcolor(phi.value');title([""t = "", num2str(t_temp(i))]); colorbar;drawnow;
end"
2903,convectionTerm.m,77.334,60,100.0,60,100.0,66.67,70-80,"function [M, Mx, My, Mz] = convectionTerm(u)

d = u.domain.dimension;
switch d
    case 1
    	M = convectionTerm1D(u);
    case 1.5
        M = convectionTermCylindrical1D(u);
    case 1.8
        M = convectionTermSpherical1D(u);
    case 2
        [M, Mx, My] = convectionTerm2D(u);
    case 2.5
        [M, Mx, My] = convectionTermCylindrical2D(u);
    case 2.8
        [M, Mx, My] = convectionTermRadial2D(u);
    case 3
        [M, Mx, My, Mz] = convectionTerm3D(u);
    case 3.2
        [M, Mx, My, Mz] = convectionTermCylindrical3D(u);
end"
2904,convectionTerm2D.m,70.272,100,86.36,15,100.0,50.0,70-80,"function [M, Mx, My] = convectionTerm2D(u)

Nx = u.domain.dims(1);
Ny = u.domain.dims(2);
G=reshape(1:(Nx+2)*(Ny+2), Nx+2, Ny+2);
DXe = repmat(u.domain.cellsize.x(3:end), 1, Ny);
DXw = repmat(u.domain.cellsize.x(1:end-2), 1, Ny);
DXp = repmat(u.domain.cellsize.x(2:end-1), 1, Ny);
DYn = repmat(u.domain.cellsize.y(3:end)', Nx, 1);
DYs = repmat(u.domain.cellsize.y(1:end-2)', Nx, 1);
DYp = repmat(u.domain.cellsize.y(2:end-1)', Nx, 1);

iix = zeros(3*(Nx+2)*(Ny+2),1);	iiy = zeros(3*(Nx+2)*(Ny+2),1);
jjx = zeros(3*(Nx+2)*(Ny+2),1);	jjy = zeros(3*(Nx+2)*(Ny+2),1);
sx = zeros(3*(Nx+2)*(Ny+2),1);	sy = zeros(3*(Nx+2)*(Ny+2),1);
mnx = Nx*Ny;	mny = Nx*Ny;

ux = u.xvalue;
uy = u.yvalue;

ue = ux(2:Nx+1,:)./(DXp+DXe);		uw = ux(1:Nx,:)./(DXp+DXw);
vn = uy(:,2:Ny+1)./(DYp+DYn);       vs = uy(:,1:Ny)./(DYp+DYs);

AE = reshape(ue,mnx,1);
AW = reshape(-uw,mnx,1);
AN = reshape(vn,mny,1);
AS = reshape(-vs,mny,1);
APx = reshape((ue.*DXe-uw.*DXw)./DXp,mnx,1);
APy = reshape((vn.*DYn-vs.*DYs)./DYp,mny,1);

rowx_index = reshape(G(2:Nx+1,2:Ny+1),mnx,1); % main diagonal x
iix(1:3*mnx) = repmat(rowx_index,3,1);
rowy_index = reshape(G(2:Nx+1,2:Ny+1),mny,1); % main diagonal y
iiy(1:3*mny) = repmat(rowy_index,3,1);
jjx(1:3*mnx) = [reshape(G(1:Nx,2:Ny+1),mnx,1); reshape(G(2:Nx+1,2:Ny+1),mnx,1); reshape(G(3:Nx+2,2:Ny+1),mnx,1)];
jjy(1:3*mny) = [reshape(G(2:Nx+1,1:Ny),mny,1); reshape(G(2:Nx+1,2:Ny+1),mny,1); reshape(G(2:Nx+1,3:Ny+2),mny,1)];
sx(1:3*mnx) = [AW; APx; AE];
sy(1:3*mny) = [AS; APy; AN];

kx = 3*mnx;
ky = 3*mny;
Mx = sparse(iix(1:kx), jjx(1:kx), sx(1:kx), (Nx+2)*(Ny+2), (Nx+2)*(Ny+2));
My = sparse(iiy(1:ky), jjy(1:ky), sy(1:ky), (Nx+2)*(Ny+2), (Nx+2)*(Ny+2));
M = Mx + My;"
2905,convectionTermCylindrical2D.m,70.826,100,86.96,15,100.0,52.17,70-80,"function [M, Mx, My] = convectionTermCylindrical2D(u)


Nr = u.domain.dims(1);
Nz = u.domain.dims(2);
G=reshape(1:(Nr+2)*(Nz+2), Nr+2, Nz+2);
DXe = repmat(u.domain.cellsize.x(3:end), 1, Nz);
DXw = repmat(u.domain.cellsize.x(1:end-2), 1, Nz);
DXp = repmat(u.domain.cellsize.x(2:end-1), 1, Nz);
DYn = repmat(u.domain.cellsize.y(3:end)', Nr, 1);
DYs = repmat(u.domain.cellsize.y(1:end-2)', Nr, 1);
DYp = repmat(u.domain.cellsize.y(2:end-1)', Nr, 1);
rp = repmat(u.domain.cellcenters.x, 1, Nz);
rf = repmat(u.domain.facecenters.x, 1, Nz);

iix = zeros(3*(Nr+2)*(Nz+2),1);	iiy = zeros(3*(Nr+2)*(Nz+2),1);
jjx = zeros(3*(Nr+2)*(Nz+2),1);	jjy = zeros(3*(Nr+2)*(Nz+2),1);
sx = zeros(3*(Nr+2)*(Nz+2),1);	sy = zeros(3*(Nr+2)*(Nz+2),1);
mnx = Nr*Nz;	mny = Nr*Nz;

ue = rf(2:Nr+1,:).*u.xvalue(2:Nr+1,:)./(rp.*(DXp+DXe));
uw = rf(1:Nr,:).*u.xvalue(1:Nr,:)./(rp.*(DXp+DXw));
vn = u.yvalue(:,2:Nz+1)./(DYp+DYn);
vs = u.yvalue(:,1:Nz)./(DYp+DYs);

AE = reshape(ue,mnx,1);
AW = reshape(-uw,mnx,1);
AN = reshape(vn,mny,1);
AS = reshape(-vs,mny,1);
APx = reshape((ue.*DXe-uw.*DXw)./DXp,mnx,1);
APy = reshape((vn.*DYn-vs.*DYs)./DYp,mny,1);

rowx_index = reshape(G(2:Nr+1,2:Nz+1),mnx,1); % main diagonal x
iix(1:3*mnx) = repmat(rowx_index,3,1);
rowy_index = reshape(G(2:Nr+1,2:Nz+1),mny,1); % main diagonal y
iiy(1:3*mny) = repmat(rowy_index,3,1);
jjx(1:3*mnx) = [reshape(G(1:Nr,2:Nz+1),mnx,1); reshape(G(2:Nr+1,2:Nz+1),mnx,1); reshape(G(3:Nr+2,2:Nz+1),mnx,1)];
jjy(1:3*mny) = [reshape(G(2:Nr+1,1:Nz),mny,1); reshape(G(2:Nr+1,2:Nz+1),mny,1); reshape(G(2:Nr+1,3:Nz+2),mny,1)];
sx(1:3*mnx) = [AW; APx; AE];
sy(1:3*mny) = [AS; APy; AN];

kx = 3*mnx;
ky = 3*mny;
Mx = sparse(iix(1:kx), jjx(1:kx), sx(1:kx), (Nr+2)*(Nz+2), (Nr+2)*(Nz+2));
My = sparse(iiy(1:ky), jjy(1:ky), sy(1:ky), (Nr+2)*(Nz+2), (Nr+2)*(Nz+2));
M = Mx + My;"
2906,convectionTermCylindrical3D.m,70.06,100,92.65,15,100.0,42.65,70-80,"function [M, Mx, My, Mz] = convectionTermCylindrical3D(u)

Nr = u.domain.dims(1);
Ntetta = u.domain.dims(2);
Nz = u.domain.dims(3);
G=reshape((1:(Nr+2)*(Ntetta+2)*(Nz+2)), Nr+2, Ntetta+2, Nz+2);
DRe = repmat(u.domain.cellsize.x(3:end), 1, Ntetta, Nz);
DRw = repmat(u.domain.cellsize.x(1:end-2), 1, Ntetta, Nz);
DRp = repmat(u.domain.cellsize.x(2:end-1), 1, Ntetta, Nz);
DTHETAn = repmat(u.domain.cellsize.y(3:end)', Nr, 1, Nz);
DTHETAs = repmat(u.domain.cellsize.y(1:end-2)', Nr, 1, Nz);
DTHETAp = repmat(u.domain.cellsize.y(2:end-1)', Nr, 1, Nz);
DZ = zeros(1,1,Nz+2);
DZ(1,1,:) = u.domain.cellsize.z;
DZf=repmat(DZ(1,1,3:end), Nr, Ntetta, 1);
DZb=repmat(DZ(1,1,1:end-2), Nr, Ntetta, 1);
DZp=repmat(DZ(1,1,2:end-1), Nr, Ntetta, 1);
rp = repmat(u.domain.cellcenters.x, 1, Ntetta, Nz);
rf = repmat(u.domain.facecenters.x, 1, Ntetta, Nz);

iix = zeros(3*(Nr+2)*(Ntetta+2)*(Nz+2),1);
jjx = zeros(3*(Nr+2)*(Ntetta+2)*(Nz+2),1);
sx = zeros(3*(Nr+2)*(Ntetta+2)*(Nz+2),1);
iiy = zeros(3*(Nr+2)*(Ntetta+2)*(Nz+2),1);
jjy = zeros(3*(Nr+2)*(Ntetta+2)*(Nz+2),1);
sy = zeros(3*(Nr+2)*(Ntetta+2)*(Nz+2),1);
iiz = zeros(3*(Nr+2)*(Ntetta+2)*(Nz+2),1);
jjz = zeros(3*(Nr+2)*(Ntetta+2)*(Nz+2),1);
sz = zeros(3*(Nr+2)*(Ntetta+2)*(Nz+2),1);
mnx = Nr*Ntetta*Nz;	mny = Nr*Ntetta*Nz;   mnz = Nr*Ntetta*Nz;

ue = rf(2:Nr+1,:,:).*u.xvalue(2:Nr+1,:,:)./(rp.*(DRp+DRe));
uw = rf(1:Nr,:,:).*u.xvalue(1:Nr,:,:)./(rp.*(DRp+DRw));
vn = u.yvalue(:,2:Ntetta+1,:)./(rp.*(DTHETAp+DTHETAn));
vs = u.yvalue(:,1:Ntetta,:)./(rp.*(DTHETAp+DTHETAs));
wf = u.zvalue(:,:,2:Nz+1)./(DZp+DZf);
wb = u.zvalue(:,:,1:Nz)./(DZp+DZb);

AE = reshape(ue,mnx,1);
AW = reshape(-uw,mnx,1);
AN = reshape(vn,mny,1);
AS = reshape(-vs,mny,1);
AF = reshape(wf,mnz,1);
AB = reshape(-wb,mnz,1);
APx = reshape((DRe.*ue-DRw.*uw)./DRp,mnx,1);
APy = reshape((DTHETAn.*vn-DTHETAs.*vs)./DTHETAp,mny,1);
APz = reshape((DZf.*wf-DZb.*wb)./DZp,mnz,1);

rowx_index = reshape(G(2:Nr+1,2:Ntetta+1,2:Nz+1),mnx,1); % main diagonal x
iix(1:3*mnx) = repmat(rowx_index,3,1);
rowy_index = reshape(G(2:Nr+1,2:Ntetta+1,2:Nz+1),mny,1); % main diagonal y
iiy(1:3*mny) = repmat(rowy_index,3,1);
rowz_index = reshape(G(2:Nr+1,2:Ntetta+1,2:Nz+1),mnz,1); % main diagonal z
iiz(1:3*mnz) = repmat(rowz_index,3,1);
jjx(1:3*mnx) = [reshape(G(1:Nr,2:Ntetta+1,2:Nz+1),mnx,1); reshape(G(2:Nr+1,2:Ntetta+1,2:Nz+1),mnx,1); reshape(G(3:Nr+2,2:Ntetta+1,2:Nz+1),mnx,1)];
jjy(1:3*mny) = [reshape(G(2:Nr+1,1:Ntetta,2:Nz+1),mny,1); reshape(G(2:Nr+1,2:Ntetta+1,2:Nz+1),mny,1); reshape(G(2:Nr+1,3:Ntetta+2,2:Nz+1),mny,1)];
jjz(1:3*mnz) = [reshape(G(2:Nr+1,2:Ntetta+1,1:Nz),mnz,1); reshape(G(2:Nr+1,2:Ntetta+1,2:Nz+1),mnz,1); reshape(G(2:Nr+1,2:Ntetta+1,3:Nz+2),mnz,1)];
sx(1:3*mnx) = [AW; APx; AE];
sy(1:3*mny) = [AS; APy; AN];
sz(1:3*mnz) = [AB; APz; AF];

kx = 3*mnx;
ky = 3*mny;
kz = 3*mnz;
Mx = sparse(iix(1:kx), jjx(1:kx), sx(1:kx), (Nr+2)*(Ntetta+2)*(Nz+2), (Nr+2)*(Ntetta+2)*(Nz+2));
My = sparse(iiy(1:ky), jjy(1:ky), sy(1:ky), (Nr+2)*(Ntetta+2)*(Nz+2), (Nr+2)*(Ntetta+2)*(Nz+2));
Mz = sparse(iiz(1:kz), jjz(1:kz), sz(1:kz), (Nr+2)*(Ntetta+2)*(Nz+2), (Nr+2)*(Ntetta+2)*(Nz+2));
M = Mx + My + Mz;"
2907,convectionTermRadial2D.m,72.13,100,89.13,15,100.0,56.52,70-80,"function [M, Mx, My] = convectionTermRadial2D(u)

Nr = u.domain.dims(1);
Ntetta = u.domain.dims(2);
G=reshape(1:(Nr+2)*(Ntetta+2), Nr+2, Ntetta+2);
DRe = repmat(u.domain.cellsize.x(3:end), 1, Ntetta);
DRw = repmat(u.domain.cellsize.x(1:end-2), 1, Ntetta);
DRp = repmat(u.domain.cellsize.x(2:end-1), 1, Ntetta);
DTHETAn = repmat(u.domain.cellsize.y(3:end)', Nr, 1);
DTHETAs = repmat(u.domain.cellsize.y(1:end-2)', Nr, 1);
DTHETAp = repmat(u.domain.cellsize.y(2:end-1)', Nr, 1);
rp = repmat(u.domain.cellcenters.x, 1, Ntetta);
rf = repmat(u.domain.facecenters.x, 1, Ntetta);
re = rf(2:Nr+1,:);         rw = rf(1:Nr,:);

iix = zeros(3*(Nr+2)*(Ntetta+2),1);	iiy = zeros(3*(Nr+2)*(Ntetta+2),1);
jjx = zeros(3*(Nr+2)*(Ntetta+2),1);	jjy = zeros(3*(Nr+2)*(Ntetta+2),1);
sx = zeros(3*(Nr+2)*(Ntetta+2),1);	sy = zeros(3*(Nr+2)*(Ntetta+2),1);
mnx = Nr*Ntetta;	mny = Nr*Ntetta;

ue = re.*u.xvalue(2:Nr+1,:)./(rp.*(DRp+DRe));
uw = rw.*u.xvalue(1:Nr,:)./(rp.*(DRp+DRw));
vn = u.yvalue(:,2:Ntetta+1)./(rp.*(DTHETAp+DTHETAn));
vs = u.yvalue(:,1:Ntetta)./(rp.*(DTHETAp+DTHETAs));

AE = reshape(ue,mnx,1);
AW = reshape(-uw,mnx,1);
AN = reshape(vn,mny,1);
AS = reshape(-vs,mny,1);
APx = reshape((ue.*DRe-uw.*DRw)./DRp,mnx,1);
APy = reshape((vn.*DTHETAn-vs.*DTHETAs)./DTHETAp,mny,1);

rowx_index = reshape(G(2:Nr+1,2:Ntetta+1),mnx,1); % main diagonal x
iix(1:3*mnx) = repmat(rowx_index,3,1);
rowy_index = reshape(G(2:Nr+1,2:Ntetta+1),mny,1); % main diagonal y
iiy(1:3*mny) = repmat(rowy_index,3,1);
jjx(1:3*mnx) = [reshape(G(1:Nr,2:Ntetta+1),mnx,1); reshape(G(2:Nr+1,2:Ntetta+1),mnx,1); reshape(G(3:Nr+2,2:Ntetta+1),mnx,1)];
jjy(1:3*mny) = [reshape(G(2:Nr+1,1:Ntetta),mny,1); reshape(G(2:Nr+1,2:Ntetta+1),mny,1); reshape(G(2:Nr+1,3:Ntetta+2),mny,1)];
sx(1:3*mnx) = [AW; APx; AE];
sy(1:3*mny) = [AS; APy; AN];

kx = 3*mnx;
ky = 3*mny;
Mx = sparse(iix(1:kx), jjx(1:kx), sx(1:kx), (Nr+2)*(Ntetta+2), (Nr+2)*(Ntetta+2));
My = sparse(iiy(1:ky), jjy(1:ky), sy(1:ky), (Nr+2)*(Ntetta+2), (Nr+2)*(Ntetta+2));
M = Mx + My;"
2908,convectionTVDburger.m,76.614,100,89.8,30,100.0,63.27,70-80,"clc;
W = 1;
Nx = 600;
mesh1 = createMesh1D(Nx, W);
x = mesh1.cellcenters.x;
BC = createBC(mesh1); % all Neumann
BC.left.periodic=1;
BC.right.periodic =1;
phi_old = createCellVariable(mesh1, 0, BC);
phi_old.value(2:floor(end/2)) = sin(x(1:floor(end/2))*2*pi());
phi = phi_old;
phiuw = phi;
phiinit=phi_old;
phiuw_old=phi;
u = 1;
uf = createFaceVariable(mesh1, u);
alfa = createCellVariable(mesh1,1);
Mconvuw = convectionUpwindTerm1D(uf);
[Mbc, RHSbc] = boundaryCondition(BC);
FL = fluxLimiter('Superbee');
phi_face = linearMean(phi);
dt = 0.001;
t = 0;
for i = 1:1000
    t = t+dt;
    [Mt, RHSt] = transientTerm(phi_old, dt, alfa);
    for j = 1:10
        phi_face = tvdMean(phi, uf, FL);
        uf = phi_face;
        [Mconv, RHSconv] = convectionTvdTerm(uf, phi, FL);
        RHSdiv = divergenceTerm(0.5*phi_face.*phi_face);
        M = Mconv+Mt+Mbc;
        RHS = RHSt+RHSbc+RHSconv+RHSdiv;
        phi = solvePDE(mesh1, M, RHS);
    end
    [Mtuw, RHStuw] = transientTerm(phiuw_old, dt, alfa);
    for j = 1:5
        phi_face = upwindMean(phiuw, uf);
        uf = phi_face;
        Mconvuw = convectionUpwindTerm1D(uf);
        RHSdiv = divergenceTerm(0.5*phi_face.*phi_face);
        Muw = Mconvuw+Mtuw+Mbc;
        RHSuw = RHStuw+RHSbc+RHSdiv;
        phiuw = solvePDE(mesh1, Muw, RHSuw);
    end
    phiuw_old = phiuw;
    phi_old = phi;
    figure(1);plot(x, phiinit.value(2:Nx+1), x, phi.value(2:Nx+1), '-o', x, phiuw.value(2:Nx+1)); drawnow;
end"
2909,convectionTvdRHS.m,76.174,60,100.0,60,100.0,60.87,70-80,"function [RHS, RHSx, RHSy, RHSz] = convectionTvdRHS(u, phi, FL)

d = u.domain.dimension;
switch d
    case 1
        RHS = convectionTvdRHS1D(u, phi, FL);
    case 1.5
        RHS = convectionTvdRHSCylindrical1D(u, phi, FL);
    case 1.8
        RHS = convectionTvdRHSSpherical1D(u, phi, FL);
    case 2
        [RHS, RHSx, RHSy] = convectionTvdRHS2D(u, phi, FL);
    case 2.5
        [RHS, RHSx, RHSy] = convectionTvdRHSCylindrical2D(u, phi, FL);
    case 2.8
        [RHS, RHSx, RHSy] = ...
            convectionTvdRHSRadial2D(u, phi, FL);
    case 3
        [RHS, RHSx, RHSy, RHSz] = convectionTvdRHS3D(u, phi, FL);
    case 3.2
        [RHS, RHSx, RHSy, RHSz] = ...
            convectionTvdRHSCylindrical3D(u, phi, FL);
end"
2910,convectionTvdRHS1D.m,72.25,100,75.0,30,100.0,56.25,70-80,"function RHS = convectionTvdRHS1D(u, phi, FL)

Nx = u.domain.dims(1);
DXp = u.domain.cellsize.x(2:end-1);
dx = 0.5*(u.domain.cellsize.x(1:end-1)+u.domain.cellsize.x(2:end));
RHS = zeros(Nx+2, 1);
psi_p = zeros(Nx+1,1);
psi_m = zeros(Nx+1,1);

ux = u.xvalue;

dphi_p = (phi.value(2:Nx+2)-phi.value(1:Nx+1))./dx;
rp = dphi_p(1:end-1)./fsign(dphi_p(2:end));
psi_p(2:Nx+1) = 0.5*FL(rp).*(phi.value(3:Nx+2)-phi.value(2:Nx+1));
psi_p(1) = 0; % left boundary will be handled explicitly

rm = dphi_p(2:end)./fsign(dphi_p(1:end-1));
psi_m(1:Nx) = 0.5*FL(rm).*(phi.value(1:Nx)-phi.value(2:Nx+1));
psi_m(Nx+1) = 0; % right boundary will be handled explicitly

ue = ux(2:Nx+1);		uw = ux(1:Nx);

ue_min = min(ue,0);	ue_max = max(ue,0);
uw_min = min(uw,0);	uw_max = max(uw,0);

RHS(2:Nx+1) = -(1./DXp).*((ue_max.*psi_p(2:Nx+1)+ue_min.*psi_m(2:Nx+1))- ...
              (uw_max.*psi_p(1:Nx)+uw_min.*psi_m(1:Nx)));
end

function phi_out = fsign(phi_in)
    phi_out = (abs(phi_in)>=eps).*phi_in+eps*(phi_in==0)+eps*(abs(phi_in)<eps).*sign(phi_in);
end"
2911,convectionTvdRHS2D.m,70.688,100,81.25,30,100.0,42.19,70-80,"function [RHS, RHSx, RHSy] = ...
    convectionTvdRHS2D(u, phi, FL)

Nx = u.domain.dims(1);
Ny = u.domain.dims(2);
G=reshape(1:(Nx+2)*(Ny+2), Nx+2, Ny+2);
DXp = repmat(u.domain.cellsize.x(2:end-1), 1, Ny);
DYp = repmat(u.domain.cellsize.y(2:end-1)', Nx, 1);
dx=repmat(0.5*(u.domain.cellsize.x(1:end-1)+u.domain.cellsize.x(2:end)), 1, Ny);
dy=repmat(0.5*(u.domain.cellsize.y(1:end-1)+u.domain.cellsize.y(2:end))', Nx, 1);
psiX_p = zeros(Nx+1,Ny);
psiX_m = zeros(Nx+1,Ny);
psiY_p = zeros(Nx,Ny+1);
psiY_m = zeros(Nx,Ny+1);

mnx = Nx*Ny;	mny = Nx*Ny;

ux = u.xvalue;
uy = u.yvalue;

dphiX_p = (phi.value(2:Nx+2, 2:Ny+1)-phi.value(1:Nx+1, 2:Ny+1))./dx;
rX_p = dphiX_p(1:end-1,:)./fsign(dphiX_p(2:end,:));
psiX_p(2:Nx+1,:) = 0.5*FL(rX_p).*(phi.value(3:Nx+2,2:Ny+1)-phi.value(2:Nx+1, 2:Ny+1));
psiX_p(1, :) = 0; % left boundary will be handled in the main matrix
dphiY_p = (phi.value(2:Nx+1, 2:Ny+2)-phi.value(2:Nx+1, 1:Ny+1))./dy;
rY_p = dphiY_p(:,1:end-1)./fsign(dphiY_p(:,2:end));
psiY_p(:,2:Ny+1) = 0.5*FL(rY_p).*(phi.value(2:Nx+1,3:Ny+2)-phi.value(2:Nx+1, 2:Ny+1));
psiY_p(:,1) = 0; % Bottom boundary will be handled in the main matrix

rX_m = dphiX_p(2:end,:)./fsign(dphiX_p(1:end-1,:));
psiX_m(1:Nx,:) = 0.5*FL(rX_m).*(phi.value(1:Nx, 2:Ny+1)-phi.value(2:Nx+1, 2:Ny+1));
psiX_m(Nx+1,:) = 0; % right boundary
rY_m = dphiY_p(:,2:end)./fsign(dphiY_p(:,1:end-1));
psiY_m(:,1:Ny) = 0.5*FL(rY_m).*(phi.value(2:Nx+1, 1:Ny)-phi.value(2:Nx+1, 2:Ny+1));
psiY_m(:, Ny+1) = 0; % top boundary will be handled in the main matrix

ue = ux(2:Nx+1,:);		uw = ux(1:Nx,:);
vn = uy(:,2:Ny+1);       vs = uy(:,1:Ny);

ue_min = min(ue,0);	ue_max = max(ue,0);
uw_min = min(uw,0);	uw_max = max(uw,0);
vn_min = min(vn,0);	vn_max = max(vn,0);
vs_min = min(vs,0);	vs_max = max(vs,0);

rowx_index = reshape(G(2:Nx+1,2:Ny+1),mnx,1); % main diagonal x
rowy_index = reshape(G(2:Nx+1,2:Ny+1),mny,1); % main diagonal y

div_x = -(1./DXp).*((ue_max.*psiX_p(2:Nx+1,:)+ue_min.*psiX_m(2:Nx+1,:))- ...
              (uw_max.*psiX_p(1:Nx,:)+uw_min.*psiX_m(1:Nx,:)));
div_y = -(1./DYp).*((vn_max.*psiY_p(:,2:Ny+1)+vn_min.*psiY_m(:,2:Ny+1))- ...
              (vs_max.*psiY_p(:,1:Ny)+vs_min.*psiY_m(:,1:Ny)));
RHS = zeros((Nx+2)*(Ny+2),1);
RHSx = zeros((Nx+2)*(Ny+2),1);
RHSy = zeros((Nx+2)*(Ny+2),1);

RHS(rowx_index) = reshape(div_x+div_y,Nx*Ny,1);
RHSx(rowx_index) = reshape(div_x,Nx*Ny,1);
RHSy(rowy_index) = reshape(div_y,Nx*Ny,1);

end

function phi_out = fsign(phi_in)
    phi_out = (abs(phi_in)>=eps).*phi_in+eps*(phi_in==0)+eps*(abs(phi_in)<eps).*sign(phi_in);
end"
2912,convectionTvdRHS3D.m,70.166,100,87.5,30,100.0,33.33,70-80,"function [RHS, RHSx, RHSy, RHSz] = ...
    convectionTvdRHS3D(u, phi, FL)

Nx = u.domain.dims(1);
Ny = u.domain.dims(2);
Nz = u.domain.dims(3);
G=reshape((1:(Nx+2)*(Ny+2)*(Nz+2)), Nx+2, Ny+2, Nz+2);
DXp = repmat(u.domain.cellsize.x(2:end-1), 1, Ny, Nz);
DYp = repmat(u.domain.cellsize.y(2:end-1)', Nx, 1, Nz);
DZ = zeros(1,1,Nz+2);
DZ(1,1,:) = u.domain.cellsize.z;
DZp=repmat(DZ(1,1,2:end-1), Nx, Ny, 1);
dx=repmat(0.5*(u.domain.cellsize.x(1:end-1)+u.domain.cellsize.x(2:end)), 1, Ny, Nz);
dy=repmat(0.5*(u.domain.cellsize.y(1:end-1)+u.domain.cellsize.y(2:end))', Nx, 1, Nz);
dz=zeros(1, 1, Nz+1);
dz(1,1,:)=0.5*(u.domain.cellsize.z(1:end-1)+u.domain.cellsize.z(2:end));
dz=repmat(dz, Nx, Ny, 1);
psiX_p = zeros(Nx+1,Ny,Nz);
psiX_m = zeros(Nx+1,Ny,Nz);
psiY_p = zeros(Nx,Ny+1,Nz);
psiY_m = zeros(Nx,Ny+1,Nz);
psiZ_p = zeros(Nx,Ny,Nz+1);
psiZ_m = zeros(Nx,Ny,Nz+1);

mnx = Nx*Ny*Nz;	mny = Nx*Ny*Nz;   mnz = Nx*Ny*Nz;

ux = u.xvalue;
uy = u.yvalue;
uz = u.zvalue;

dphiX_p = (phi.value(2:Nx+2, 2:Ny+1, 2:Nz+1)-phi.value(1:Nx+1, 2:Ny+1, 2:Nz+1))./dx;
rX_p = dphiX_p(1:end-1,:,:)./fsign(dphiX_p(2:end,:,:));
psiX_p(2:Nx+1,:,:) = 0.5*FL(rX_p).* ...
    (phi.value(3:Nx+2,2:Ny+1,2:Nz+1)-phi.value(2:Nx+1,2:Ny+1,2:Nz+1));
psiX_p(1,:,:) = 0; % left boundary
dphiY_p = (phi.value(2:Nx+1, 2:Ny+2, 2:Nz+1)-phi.value(2:Nx+1, 1:Ny+1, 2:Nz+1))./dy;
rY_p = dphiY_p(:,1:end-1,:)./fsign(dphiY_p(:,2:end,:));
psiY_p(:,2:Ny+1,:) = 0.5*FL(rY_p).* ...
    (phi.value(2:Nx+1,3:Ny+2,2:Nz+1)-phi.value(2:Nx+1, 2:Ny+1,2:Nz+1));
psiY_p(:,1,:) = 0; % Bottom boundary
dphiZ_p = (phi.value(2:Nx+1, 2:Ny+1, 2:Nz+2)-phi.value(2:Nx+1, 2:Ny+1, 1:Nz+1))./dz;
rZ_p = dphiZ_p(:,:,1:end-1)./fsign(dphiZ_p(:,:,2:end));
psiZ_p(:,:,2:Nz+1) = 0.5*FL(rZ_p).* ...
    (phi.value(2:Nx+1,2:Ny+1,3:Nz+2)-phi.value(2:Nx+1,2:Ny+1,2:Nz+1));
psiZ_p(:,:,1) = 0; % Back boundary

rX_m = dphiX_p(2:end,:,:)./fsign(dphiX_p(1:end-1,:,:));
psiX_m(1:Nx,:,:) = 0.5*FL(rX_m).* ...
    (phi.value(1:Nx, 2:Ny+1, 2:Nz+1)-phi.value(2:Nx+1, 2:Ny+1, 2:Nz+1));
psiX_m(Nx+1,:,:) = 0; % right boundary
rY_m = dphiY_p(:,2:end,:)./fsign(dphiY_p(:,1:end-1,:));
psiY_m(:,1:Ny,:) = 0.5*FL(rY_m).* ...
    (phi.value(2:Nx+1,1:Ny,2:Nz+1)-phi.value(2:Nx+1,2:Ny+1,2:Nz+1));
psiY_m(:,Ny+1,:) = 0; % top boundary
rZ_m = dphiZ_p(:,:,2:end)./fsign(dphiZ_p(:,:,1:end-1));
psiZ_m(:,:,1:Nz) = 0.5*FL(rZ_m).* ...
    (phi.value(2:Nx+1,2:Ny+1,1:Nz)-phi.value(2:Nx+1,2:Ny+1,2:Nz+1));
psiZ_m(:,:,Nz+1) = 0; % front boundary
ue = ux(2:Nx+1,:,:);		uw = ux(1:Nx,:,:);
vn = uy(:,2:Ny+1,:);     vs = uy(:,1:Ny,:);
wf = uz(:,:,2:Nz+1);     wb = uz(:,:,1:Nz);

ue_min = min(ue,0);	ue_max = max(ue,0);
uw_min = min(uw,0);	uw_max = max(uw,0);
vn_min = min(vn,0);	vn_max = max(vn,0);
vs_min = min(vs,0);	vs_max = max(vs,0);
wf_min = min(wf,0);	wf_max = max(wf,0);
wb_min = min(wb,0);	wb_max = max(wb,0);

rowx_index = reshape(G(2:Nx+1,2:Ny+1,2:Nz+1),mnx,1); % main diagonal x
rowy_index = reshape(G(2:Nx+1,2:Ny+1,2:Nz+1),mny,1); % main diagonal y
rowz_index = reshape(G(2:Nx+1,2:Ny+1,2:Nz+1),mnz,1); % main diagonal z

div_x = -(1./DXp).*((ue_max.*psiX_p(2:Nx+1,:,:)+ue_min.*psiX_m(2:Nx+1,:,:))- ...
              (uw_max.*psiX_p(1:Nx,:,:)+uw_min.*psiX_m(1:Nx,:,:)));
div_y = -(1./DYp).*((vn_max.*psiY_p(:,2:Ny+1,:)+vn_min.*psiY_m(:,2:Ny+1,:))- ...
              (vs_max.*psiY_p(:,1:Ny,:)+vs_min.*psiY_m(:,1:Ny,:)));
div_z = -(1./DZp).*((wf_max.*psiZ_p(:,:,2:Nz+1)+wf_min.*psiZ_m(:,:,2:Nz+1))- ...
              (wb_max.*psiZ_p(:,:,1:Nz)+wb_min.*psiZ_m(:,:,1:Nz)));

RHS = zeros((Nx+2)*(Ny+2)*(Nz+2),1);
RHSx = zeros((Nx+2)*(Ny+2)*(Nz+2),1);
RHSy = zeros((Nx+2)*(Ny+2)*(Nz+2),1);
RHSz = zeros((Nx+2)*(Ny+2)*(Nz+2),1);

row_index = rowx_index;
RHS(row_index) = reshape(div_x+div_y+div_z,Nx*Ny*Nz,1);
RHSx(rowx_index) = reshape(div_x,Nx*Ny*Nz,1);
RHSy(rowy_index) = reshape(div_y,Nx*Ny*Nz,1);
RHSz(rowz_index) = reshape(div_z,Nx*Ny*Nz,1);

end

function phi_out = fsign(phi_in)
    phi_out = (abs(phi_in)>=eps).*phi_in+eps*(phi_in==0)+eps*(abs(phi_in)<eps).*sign(phi_in);
end"
2913,convectionTvdRHSCylindrical1D.m,72.112,100,75.0,30,100.0,55.56,70-80,"function RHS = convectionTvdRHSCylindrical1D(u, phi, FL)

Nr = u.domain.dims(1);
DXp = u.domain.cellsize.x(2:end-1);
dx = 0.5*(u.domain.cellsize.x(1:end-1)+u.domain.cellsize.x(2:end));
r = u.domain.cellcenters.x;
rf = u.domain.facecenters.x;
RHS = zeros(Nr+2, 1);
psi_p = zeros(Nr+1,1);
psi_m = zeros(Nr+1,1);

ux = u.xvalue;

dphi_p = (phi.value(2:Nr+2)-phi.value(1:Nr+1))./dx;
rp = dphi_p(1:end-1)./fsign(dphi_p(2:end));
psi_p(2:Nr+1) = 0.5*FL(rp).*(phi.value(3:Nr+2)-phi.value(2:Nr+1));
psi_p(1) = 0.0; % left boundary will be handled explicitly

rm = dphi_p(2:end)./fsign(dphi_p(1:end-1));
psi_m(1:Nr) = 0.5*FL(rm).*(phi.value(1:Nr)-phi.value(2:Nr+1));
psi_m(Nr+1) = 0.0; % right boundary will be handled explicitly

ue = ux(2:Nr+1);		uw = ux(1:Nr);
re = rf(2:Nr+1);     rw = rf(1:Nr);

ue_min = min(ue,0);	ue_max = max(ue,0);
uw_min = min(uw,0);	uw_max = max(uw,0);

RHS(2:Nr+1) = -(1./(DXp.*r)).*(re.*(ue_max.*psi_p(2:Nr+1)+ue_min.*psi_m(2:Nr+1))- ...
              rw.*(uw_max.*psi_p(1:Nr)+uw_min.*psi_m(1:Nr)));

end

function phi_out = fsign(phi_in)
    phi_out = (abs(phi_in)>=eps).*phi_in+eps*(phi_in==0)+eps*(abs(phi_in)<eps).*sign(phi_in);
end"
2914,convectionTvdRHSCylindrical2D.m,71.074,100,82.09,30,100.0,43.28,70-80,"function [RHS, RHSx, RHSy] = ...
    convectionTvdRHSCylindrical2D(u, phi, FL)

Nr = u.domain.dims(1);
Nz = u.domain.dims(2);
G=reshape(1:(Nr+2)*(Nz+2), Nr+2, Nz+2);
DRp = repmat(u.domain.cellsize.x(2:end-1), 1, Nz);
DZp = repmat(u.domain.cellsize.y(2:end-1)', Nr, 1);
rp = repmat(u.domain.cellcenters.x, 1, Nz);
rf = repmat(u.domain.facecenters.x, 1, Nz);
dr=repmat(0.5*(u.domain.cellsize.x(1:end-1)+u.domain.cellsize.x(2:end)), 1, Nz);
dz=repmat(0.5*(u.domain.cellsize.y(1:end-1)+u.domain.cellsize.y(2:end))', Nr, 1);
psiX_p = zeros(Nr+1,Nz);
psiX_m = zeros(Nr+1,Nz);
psiY_p = zeros(Nr,Nz+1);
psiY_m = zeros(Nr,Nz+1);

mNr = Nr*Nz;	mNz = Nr*Nz;

ux = u.xvalue;
uy = u.yvalue;

dphiX_p = (phi.value(2:Nr+2, 2:Nz+1)-phi.value(1:Nr+1, 2:Nz+1))./dr;
rX_p = dphiX_p(1:end-1,:)./fsign(dphiX_p(2:end,:));
psiX_p(2:Nr+1,:) = 0.5*FL(rX_p).*(phi.value(3:Nr+2,2:Nz+1)-phi.value(2:Nr+1, 2:Nz+1));
psiX_p(1, :) = 0; % left boundary will be handled in the main matrix
dphiY_p = (phi.value(2:Nr+1, 2:Nz+2)-phi.value(2:Nr+1, 1:Nz+1))./dz;
rY_p = dphiY_p(:,1:end-1)./fsign(dphiY_p(:,2:end));
psiY_p(:,2:Nz+1) = 0.5*FL(rY_p).*(phi.value(2:Nr+1,3:Nz+2)-phi.value(2:Nr+1, 2:Nz+1));
psiY_p(:,1) = 0; % Bottom boundary will be handled in the main matrix

rX_m = dphiX_p(2:end,:)./fsign(dphiX_p(1:end-1,:));
psiX_m(1:Nr,:) = 0.5*FL(rX_m).*(phi.value(1:Nr, 2:Nz+1)-phi.value(2:Nr+1, 2:Nz+1));
psiX_m(Nr+1,:) = 0; % right boundary
rY_m = dphiY_p(:,2:end)./fsign(dphiY_p(:,1:end-1));
psiY_m(:,1:Nz) = 0.5*FL(rY_m).*(phi.value(2:Nr+1, 1:Nz)-phi.value(2:Nr+1, 2:Nz+1));
psiY_m(:, Nz+1) = 0; % top boundary will be handled in the main matrix

ue = ux(2:Nr+1,:);		uw = ux(1:Nr,:);
vn = uy(:,2:Nz+1);       vs = uy(:,1:Nz);
re = rf(2:Nr+1,:);         rw = rf(1:Nr,:);

ue_min = min(ue,0);	ue_max = max(ue,0);
uw_min = min(uw,0);	uw_max = max(uw,0);
vn_min = min(vn,0);	vn_max = max(vn,0);
vs_min = min(vs,0);	vs_max = max(vs,0);

rowx_index = reshape(G(2:Nr+1,2:Nz+1),mNr,1); % main diagonal x
rowy_index = reshape(G(2:Nr+1,2:Nz+1),mNz,1); % main diagonal y

div_x = -(1./(DRp.*rp)).*(re.*(ue_max.*psiX_p(2:Nr+1,:)+ue_min.*psiX_m(2:Nr+1,:))- ...
              rw.*(uw_max.*psiX_p(1:Nr,:)+uw_min.*psiX_m(1:Nr,:)));
div_y = -(1./DZp).*((vn_max.*psiY_p(:,2:Nz+1)+vn_min.*psiY_m(:,2:Nz+1))- ...
              (vs_max.*psiY_p(:,1:Nz)+vs_min.*psiY_m(:,1:Nz)));
RHS = zeros((Nr+2)*(Nz+2),1);
RHSx = zeros((Nr+2)*(Nz+2),1);
RHSy = zeros((Nr+2)*(Nz+2),1);

RHS(rowx_index) = reshape(div_x+div_y,Nr*Nz,1);
RHSx(rowx_index) = reshape(div_x,Nr*Nz,1);
RHSy(rowy_index) = reshape(div_y,Nr*Nz,1);

end

function phi_out = fsign(phi_in)
    phi_out = (abs(phi_in)>=eps).*phi_in+eps*(phi_in==0)+eps*(abs(phi_in)<eps).*sign(phi_in);
end"
2915,convectionTvdRHSCylindrical3D.m,71.454,100,87.88,30,100.0,39.39,70-80,"function [RHS, RHSx, RHSy, RHSz] = ...
    convectionTvdRHSCylindrical3D(u, phi, FL)

Nr = u.domain.dims(1);
Ntetta = u.domain.dims(2);
Nz = u.domain.dims(3);
G=reshape((1:(Nr+2)*(Ntetta+2)*(Nz+2)), Nr+2, Ntetta+2, Nz+2);
DRp = repmat(u.domain.cellsize.x(2:end-1), 1, Ntetta, Nz);
DTHETAp = repmat(u.domain.cellsize.y(2:end-1)', Nr, 1, Nz);
DZ = zeros(1,1,Nz+2);
DZ(1,1,:) = u.domain.cellsize.z;
DZp=repmat(DZ(1,1,2:end-1), Nr, Ntetta, 1);
rp = repmat(u.domain.cellcenters.x, 1, Ntetta, Nz);
rf = repmat(u.domain.facecenters.x, 1, Ntetta, Nz);
dx=repmat(0.5*(u.domain.cellsize.x(1:end-1)+u.domain.cellsize.x(2:end)), 1, Ntetta, Nz);
dy=repmat(0.5*(u.domain.cellsize.y(1:end-1)+u.domain.cellsize.y(2:end))', Nr, 1, Nz);
dz=zeros(1, 1, Nz+1);
dz(1,1,:)=0.5*(u.domain.cellsize.z(1:end-1)+u.domain.cellsize.z(2:end));
dz=repmat(dz, Nr, Ntetta, 1);
psiX_p = zeros(Nr+1,Ntetta,Nz);
psiX_m = zeros(Nr+1,Ntetta,Nz);
psiY_p = zeros(Nr,Ntetta+1,Nz);
psiY_m = zeros(Nr,Ntetta+1,Nz);
psiZ_p = zeros(Nr,Ntetta,Nz+1);
psiZ_m = zeros(Nr,Ntetta,Nz+1);

mnx = Nr*Ntetta*Nz;	mny = Nr*Ntetta*Nz;   mnz = Nr*Ntetta*Nz;

ux = u.xvalue;
uy = u.yvalue;
uz = u.zvalue;

dphiX_p = (phi.value(2:Nr+2, 2:Ntetta+1, 2:Nz+1)-phi.value(1:Nr+1, 2:Ntetta+1, 2:Nz+1))./dx;
rX_p = dphiX_p(1:end-1,:,:)./fsign(dphiX_p(2:end,:,:));
psiX_p(2:Nr+1,:,:) = 0.5*FL(rX_p).* ...
    (phi.value(3:Nr+2,2:Ntetta+1,2:Nz+1)-phi.value(2:Nr+1,2:Ntetta+1,2:Nz+1));
psiX_p(1,:,:) = 0; % left boundary
dphiY_p = (phi.value(2:Nr+1, 2:Ntetta+2, 2:Nz+1)-phi.value(2:Nr+1, 1:Ntetta+1, 2:Nz+1))./dy;
rY_p = dphiY_p(:,1:end-1,:)./fsign(dphiY_p(:,2:end,:));
psiY_p(:,2:Ntetta+1,:) = 0.5*FL(rY_p).* ...
    (phi.value(2:Nr+1,3:Ntetta+2,2:Nz+1)-phi.value(2:Nr+1, 2:Ntetta+1,2:Nz+1));
psiY_p(:,1,:) = 0; % Bottom boundary
dphiZ_p = (phi.value(2:Nr+1, 2:Ntetta+1, 2:Nz+2)-phi.value(2:Nr+1, 2:Ntetta+1, 1:Nz+1))./dz;
rZ_p = dphiZ_p(:,:,1:end-1)./fsign(dphiZ_p(:,:,2:end));
psiZ_p(:,:,2:Nz+1) = 0.5*FL(rZ_p).* ...
    (phi.value(2:Nr+1,2:Ntetta+1,3:Nz+2)-phi.value(2:Nr+1,2:Ntetta+1,2:Nz+1));
psiZ_p(:,:,1) = 0; % Back boundary

rX_m = dphiX_p(2:end,:,:)./fsign(dphiX_p(1:end-1,:,:));
psiX_m(1:Nr,:,:) = 0.5*FL(rX_m).* ...
    (phi.value(1:Nr, 2:Ntetta+1, 2:Nz+1)-phi.value(2:Nr+1, 2:Ntetta+1, 2:Nz+1));
psiX_m(Nr+1,:,:) = 0; % right boundary
rY_m = dphiY_p(:,2:end,:)./fsign(dphiY_p(:,1:end-1,:));
psiY_m(:,1:Ntetta,:) = 0.5*FL(rY_m).* ...
    (phi.value(2:Nr+1,1:Ntetta,2:Nz+1)-phi.value(2:Nr+1,2:Ntetta+1,2:Nz+1));
psiY_m(:,Ntetta+1,:) = 0; % top boundary
rZ_m = dphiZ_p(:,:,2:end)./fsign(dphiZ_p(:,:,1:end-1));
psiZ_m(:,:,1:Nz) = 0.5*FL(rZ_m).* ...
    (phi.value(2:Nr+1,2:Ntetta+1,1:Nz)-phi.value(2:Nr+1,2:Ntetta+1,2:Nz+1));
psiZ_m(:,:,Nz+1) = 0; % front boundary
ue = ux(2:Nr+1,:,:);		uw = ux(1:Nr,:,:);
vn = uy(:,2:Ntetta+1,:);     vs = uy(:,1:Ntetta,:);
wf = uz(:,:,2:Nz+1);     wb = uz(:,:,1:Nz);
re = rf(2:Nr+1,:,:);         rw = rf(1:Nr,:,:);

ue_min = min(ue,0);	ue_max = max(ue,0);
uw_min = min(uw,0);	uw_max = max(uw,0);
vn_min = min(vn,0);	vn_max = max(vn,0);
vs_min = min(vs,0);	vs_max = max(vs,0);
wf_min = min(wf,0);	wf_max = max(wf,0);
wb_min = min(wb,0);	wb_max = max(wb,0);

rowx_index = reshape(G(2:Nr+1,2:Ntetta+1,2:Nz+1),mnx,1); % main diagonal x
rowy_index = reshape(G(2:Nr+1,2:Ntetta+1,2:Nz+1),mny,1); % main diagonal y
rowz_index = reshape(G(2:Nr+1,2:Ntetta+1,2:Nz+1),mnz,1); % main diagonal z

div_x = -(1./(DRp.*rp)).*(re.*(ue_max.*psiX_p(2:Nr+1,:,:)+ue_min.*psiX_m(2:Nr+1,:,:))- ...
              rw.*(uw_max.*psiX_p(1:Nr,:,:)+uw_min.*psiX_m(1:Nr,:,:)));
div_y = -(1./(DTHETAp.*rp)).*((vn_max.*psiY_p(:,2:Ntetta+1,:)+vn_min.*psiY_m(:,2:Ntetta+1,:))- ...
              (vs_max.*psiY_p(:,1:Ntetta,:)+vs_min.*psiY_m(:,1:Ntetta,:)));
div_z = -(1./DZp).*((wf_max.*psiZ_p(:,:,2:Nz+1)+wf_min.*psiZ_m(:,:,2:Nz+1))- ...
              (wb_max.*psiZ_p(:,:,1:Nz)+wb_min.*psiZ_m(:,:,1:Nz)));

RHS = zeros((Nr+2)*(Ntetta+2)*(Nz+2),1);
RHSx = zeros((Nr+2)*(Ntetta+2)*(Nz+2),1);
RHSy = zeros((Nr+2)*(Ntetta+2)*(Nz+2),1);
RHSz = zeros((Nr+2)*(Ntetta+2)*(Nz+2),1);

row_index = rowx_index;
RHS(row_index) = reshape(div_x+div_y+div_z,Nr*Ntetta*Nz,1);
RHSx(rowx_index) = reshape(div_x,Nr*Ntetta*Nz,1);
RHSy(rowy_index) = reshape(div_y,Nr*Ntetta*Nz,1);
RHSz(rowz_index) = reshape(div_z,Nr*Ntetta*Nz,1);

end

function phi_out = fsign(phi_in)
    phi_out = (abs(phi_in)>=eps).*phi_in+eps*(phi_in==0)+eps*(abs(phi_in)<eps).*sign(phi_in);
end"
2916,convectionTvdRHSRadial2D.m,72.268,100,82.09,30,100.0,49.25,70-80,"function [RHS, RHSx, RHSy] = ...
    convectionTvdRHSRadial2D(u, phi, FL)

