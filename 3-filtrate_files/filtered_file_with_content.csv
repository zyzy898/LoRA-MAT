        if A(2)<B(2)            %A2<B4
            if A(4)<B(4)
                row = 3;
            elseif A(4)>B(4)
                row = 8;
            elseif A(4)==B(4)
                row = 9;
            end
        elseif A(2)==B(2)       %A2<B4
            if A(4)<B(4)
                row = 4;
            elseif A(4)>B(4)
                row = 7;
            elseif A(4)==B(4)
                row = 13;
            end
