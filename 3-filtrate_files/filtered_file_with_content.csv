            end
            if ~iscell(varargin)
                varargin = {varargin};
            end
            ph = plot(xe, ye, varargin{:});
        end

        function ph = patchEllipse(x, y, major, minor, az, color, varargin)
            [xe, ye] = Core_Utils.ellipse(x, y, major, minor, az);
            if nargin < 7
                varargin = {};
            end
            if ~iscell(varargin)
                varargin = {varargin};
            end
            ph = patch(xe, ye, color, varargin{:});
        end

