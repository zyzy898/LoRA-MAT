ihuman.metRecon3DID{find(strcmp('m02487m',ihuman.mets))}{1}='trdrd';

save('ihumanMets2MNX_v2.mat','ihuman');  % 2018-09-20"
4306,curateMetFormula4PAPS.m,74.858,100,62.34,60,100.0,51.95,70-80,"if ~exist('ihuman','var')
    load('humanGEM.mat');  % version 0.8.1
