3314,CorrPlotWeighted.m,76.248,100,65.62,75,100.0,40.62,70-80,"function cmap = CorrPlotWeighted(coeffs,gIX)%,isPlotText,ylabels)

coeffs(isnan(coeffs)) = 0;

[gIX, numK] = SqueezeGroupIX(gIX);
U = unique(gIX);
sizes = zeros(1,numK);
for i = 1:numK
    IX = find(gIX==U(i));
    sizes(i) = length(IX);
end

nCells = length(gIX);

if nCells<500
    im = zeros(nCells,nCells);
    for i = 1:numK
        for j = 1:numK
            IX1 = find(gIX==U(i));
            IX2 = find(gIX==U(j));
            [X,Y] = ndgrid(IX1,IX2);
            im(X,Y) = coeffs(i,j);
        end
    end
else % downsample
    skip = floor(nCells/500);
    gIX_ds = gIX(1:skip:end);
    nCells_ds = length(gIX_ds);
    im = zeros(nCells_ds,nCells_ds);
    
    for i = 1:numK
        for j = 1:numK
            IX1 = find(gIX_ds==U(i));
            IX2 = find(gIX_ds==U(j));
            [X,Y] = ndgrid(IX1,IX2);
            im(X,Y) = coeffs(i,j);
        end
    end
end
       
cmap = zeros(64,3);
cmap(:,1) = [linspace(0,1,32), linspace(1,1,32)];
cmap(:,2) = [linspace(0,1,32), linspace(1,0,32)];
cmap(:,3) = [linspace(1,1,32), linspace(1,0,32)];
minlim = -1; %min(min(im));
maxlim = 1; %max(max(im));

RGB = ImageToRGB(im,cmap,minlim,maxlim); % map image matrix to range of colormap

image(RGB); axis equal; axis tight;
if length(im)<50
    set(gca,'XTick',1:length(im),'YTick',1:length(im));
else
    set(gca,'XTick',[],'YTick',[]);
end
set(gca,'TickLength',[0,0]);

end

function RGB = ImageToRGB(im,cmap,minlim,maxlim)
L = size(cmap,1);
ix = round(interp1(linspace(minlim,maxlim,L),1:L,im,'linear','extrap'));
RGB = reshape(cmap(ix,:),[size(ix) 3]); % Make RGB image from scaled.
end"
3315,corrPoints.m,71.362,80,44.64,100,100.0,32.17,70-80,"classdef corrPoints < handle

    properties
        A1
        
        A2
        
        A
        
        label
    end
    
    properties (SetAccess = private)
        pc1id
        
        pc2id
        
        X1
        
        X2
        
        idxPC1
        
        idxPC2
        
        dAlpha
        
        ds
        
        dp
        
        noCP
    end

    
    methods
        
        function obj = corrPoints(pc1id, pc2id, varargin)
        

        p = inputParser;
        p.addRequired( 'pc1id', @isnumeric);
        p.addRequired( 'pc2id', @isnumeric);
        p.addParameter('Label', '', @ischar);
        p.parse(pc1id, pc2id, varargin{:});
        p = p.Results;
        clear pc1id pc2id

        
        procHierarchy = {'CORRPOINTS' 'CREATE'};
        msg('S', procHierarchy);
        
        
        obj.pc1id = p.pc1id;
        obj.pc2id = p.pc2id;
        
        
        if isempty(p.Label)
            obj.label = sprintf('CP between PC [%d] and PC [%d]', p.pc1id, p.pc2id);
        else
            obj.label = p.Label;
        end
        
        
        msg('I', procHierarchy, sprintf('Corr. points label = ''%s''', obj.label));
        msg('E', procHierarchy);
            
        end
        

        function dAlpha = get.dAlpha(obj)

        n1 = [obj.A1.nx obj.A1.ny obj.A1.nz];
        n2 = [obj.A2.nx obj.A2.ny obj.A2.nz];
        dAlpha = angVector(n1, n2);
   
        end
        

        function ds = get.ds(obj)

        ds = dist(obj.X1, obj.X2);
            
        end
        

        function dp = get.dp(obj)

        if size(obj.X1,1) > 0 && isfield(obj.A1, 'nx') % only if correspondences and normals are present

            n1 = [obj.A1.nx obj.A1.ny obj.A1.nz];

            dp = dot(obj.X1-obj.X2, n1, 2);

        else

            dp = NaN;

        end
            
        end
        

        function noCP = get.noCP(obj)
            
        noCP = size(obj.X1,1);
            
        end
        
    end
    
end"
3316,corrsparsity.m,79.166,100,70.83,75,100.0,50.0,70-80,"function [C,D] = corrsparsity(exponent_p_monoms,options);

if options.sos.csp
    n = size(exponent_p_monoms,2);
    C = zeros(n,n);
    for i = 1:size(exponent_p_monoms,1)
        [col,row] = find(exponent_p_monoms(i,:));
        for j = 1:length(row)
            C(row(j),row(j)) = 1;
            for k = 2:length(row)
                C(row(j),row(k)) = 1;
                C(row(k),row(j)) = 1;
            end
        end
    end

    R = chol(C+100*eye(n));
    for i = 1:size(R,1)
        [row,col] = find(R(i,:));
        if i>1
            is_in = 0;
            for j = 1:length(D)
                if all(ismember(col,D{j}))
                    is_in = 1;
                end
            end
            if ~is_in
                D{end+1} = col;
            end
        else
            D{1} = col;
        end
    end
    if length(D)>1 &  options.verbose>0
        the_text = 'Detecting correlative sparsity..';

        [uu,ii,oo] = unique(cellfun('prodofsize',D));
        for i = 1:length(uu)
            n_this = length(find(oo==i));

            the_text = [the_text num2str(uu(i)) '(' num2str(n_this) ')' ' '];
        end       
        disp(the_text);
    end
else
    C = ones(size(exponent_p_monoms,2));
    D{1} = 1:size(exponent_p_monoms,2);
end"
3317,corrStaticFC.m,76.3,80,60.0,100,100.0,41.5,70-80,"function [C,A,e,Av] = corrStaticFC (data,T,options,use_pca)

if nargin<3, options = struct(); end
if nargin<4, use_pca = 0; end

if xor(iscell(data),iscell(T)), error('X and T must be cells, either both or none of them.'); end

if iscell(T)
    if size(T,1)==1, T = T'; end
    for i = 1:length(T)
        if size(T{i},1)==1, T{i} = T{i}'; end
    end
    if size(data,1)==1, data = data'; end
end
N = length(T);
Av = [];

options.K = 2; options.order = 0; 
options.BIGNbatch = 2; % to avoid checkoptions complaining
options = checkspelling(options);
options = checkoptions(options,data,T,0);
do_varimax = options.varimax;

if length(options.pca) > 1 || (options.pca > 0 && options.pca ~= 1)
    warning('options.pca will be ignored; use use_pca instead')
end

if use_pca
    [A,~,e] = highdim_pca(data,T,[],...
        options.embeddedlags,options.standardise,...
        options.onpower,0,options.detrend,...
        options.filter,options.leakagecorr,options.Fs);
    npca = find(e>0.95,1);
    if do_varimax
        Av = zeros(size(A,1),npca,npca);
        Av(:,1,1) = A(:,1); 
        for d = 2:npca
            try
                Av(:,1:d,d) = rotatefactors(A(:,1:d));
            catch
                disp(['Varimax cannot deal with more components; npca set to ' num2str(d)])
                npca = d-1;
                break;
            end
        end
        
    end
    if isfield(options,'A'), warning('options.A will be ignored; use use_pca instead'); end
else
    A = []; e = []; 
end

if use_pca
    FC = cell(npca,1); 
end

for j = 1:N
    if iscell(data)
        if ischar(data{j})
            dat = load(data{j});
            if isfield(dat,'X')
                X = dat.X;
            else
                X = getfield(dat,char(fieldnames(dat)));
            end
        else
            X = data{j};
        end
        Tj = T{j};
    else
        ind = (1:T(j)) + sum(T(1:j-1));
        if isstruct(data)
            X = data.X(ind,:);
        else
            X = data(ind,:);
        end
        Tj = T(j);
    end
    X = standardisedata(X,Tj,options.standardise);  
    if ~isempty(options.filter)
       X = filterdata(X,Tj,options.Fs,options.filter);
    end
    if options.detrend
       X = detrenddata(X,Tj); 
    end   
    if options.leakagecorr ~= 0 
        X = leakcorr(X,Tj,options.leakagecorr);
    end
    if options.onpower
       X = rawsignal2power(X,Tj); 
    end
    if length(options.embeddedlags) > 1  
        [X,Tj] = embeddata(X,Tj,options.embeddedlags);
    end
    if use_pca
        X_nopca = X;
        ndim = size(X,2); 
        for d = 2:npca
            if j==1, FC{d} =  zeros(d*(d-1)/2,N); end
            if do_varimax
                Ad = Av(:,1:d,d);
            else
                Ad = A(:,1:d);
            end
            X = X_nopca * Ad; % * Ad';
            X = X + 1e-8 * randn(size(X)); % add some noise to avoid ill-conditioning
            if options.downsample > 0
                X = downsampledata(X,Tj,options.downsample,options.Fs);
            end
            c = corr(X);
            FC{d}(:,j) = c(triu(true(size(X,2)),1))';
        end
        X = X_nopca; 
        if options.downsample > 0
            X = downsampledata(X,Tj,options.downsample,options.Fs);
        end
        c = corr(X);
    else
        if isfield(options,'A') && ~isempty(options.A)
            if do_varimax
                A = rotatefactors(A);
            end
            X = X * A;
        end
        if options.downsample > 0
            X = downsampledata(X,Tj,options.downsample,options.Fs);
        end
        c = corr(X);
        if j==1
            ndim = size(X,2);
            FC = zeros(ndim*(ndim-1)/2,N);
        end
        FC(:,j) =  c(triu(true(ndim),1))';
    end
end

if use_pca
    C = NaN(N,N,npca);
    for d = 3:npca
        c = corr(FC{d});
        c(eye(N)==1) = Inf;
        C(:,:,d) = c; 
    end
else
    C = corr(FC);
    C(eye(N)==1) = Inf;
end


end"
3318,CorrTableUnbalanced.m,78.044,100,65.22,75,100.0,50.0,70-80,"function [CORR, TABLE] = CorrTableUnbalanced(x,vnames)


if size(vnames,1)>1
    vnames = vnames';
end

[row , col] = size(x);
CORR = nan(col,col);
for ii=1:col
    x1 = x(:,ii);
    for jj=1:col
        x2 = x(:,jj);
        y = CommonSample([x1 x2]);
        if isempty(y) == 1
            CORR(ii,jj) = NaN;
        else
            aux = corr(y(:,1),y(:,2));
            if isnan(aux)==1
                if ii==jj
                    CORR(ii,jj) = 1;
                end
            else
                CORR(ii,jj) = corr(y(:,1),y(:,2));
            end
        end
    end
end

CORR(find(triu(CORR))) = NaN;
jj = 1;
for ii=1:col
    CORR(ii,jj) = 1;
    jj = jj +1;
end

table = num2cell(CORR);

table = [vnames ; table];

aux = [{''} vnames]';
TABLE = [aux table];

info.cvnames = char(vnames);
info.rvnames = char([{' '} vnames]);
mprint(CORR,info);"
3319,CorrUnbalanced.m,76.026,100,64.1,75,100.0,41.03,70-80,"function [CORR, OUT] = CorrUnbalanced(DATA,labels)



[nobs, nvar] = size(DATA);

