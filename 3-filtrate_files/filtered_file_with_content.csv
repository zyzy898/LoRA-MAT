        if y(i) > 32
            Atsr = sprintf('%s (%.0f)',D(k(i)).name{1},y(i));
        else
            Atsr = sprintf('%s (%.2f)',D(k(i)).name{1},y(i));
        end
        text(8 + D(k(i)).X,D(k(i)).Y,Atsr,...
            'HorizontalAlignment','Left',...
            'FontWeight','bold','FontSize',10);
    end
    
end


