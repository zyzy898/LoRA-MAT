            ori(~oP.oR.checkInside) = NaN;
        end
      end
      
      q = quaternion(ori);      
      [x,y,z] = double(2 * q.axis .* tan(q.angle./4));
            
    end
    
    function ori = iproject(oP,x,y,z,varargin)
      ori = orientation.id;
    end
    
    function ori = makeGrid(oP,varargin)
      
      [ori,S2G,omega] = makeGrid@axisAnglePlot(oP,varargin{:});
      
      [oP.plotGrid.x,oP.plotGrid.y,oP.plotGrid.z] = ...
        double( 2 * S2G .* tan(omega./4));
      
    end
    
  end
end"
401,ConfusionMatrix.m,86.842,100,68.42,100,100.0,65.79,80-90,"classdef ConfusionMatrix < handle
    properties (GetAccess = public)
        confusionMatrixData;
        nClasses;
        classNames;
        containsNullClass;
    end
    
    methods (Access = public)
        function obj = ConfusionMatrix(truthClasses,predictedClasses,classes,classNames)
            if nargin > 1
                if nargin == 3
                    classNames = [];
                end
                
                if(any(predictedClasses == Labeling.kNullClass))
                    obj.confusionMatrixData = confusionmat(truthClasses,predictedClasses,'Order',[classes 0]);
                    obj.classNames = [classNames, Labeling.kNullClassStr];
                    obj.containsNullClass = true;
                else
                    obj.confusionMatrixData = confusionmat(truthClasses,predictedClasses,'Order',classes);
                    obj.classNames = classNames;
                    obj.containsNullClass = false;
                end
                
                obj.nClasses = size(obj.confusionMatrixData,1);
            end
        end
    end
    
    methods (Access = public, Static)
        function confusionMatrix = CreateConfusionMatrixWithData(confusionMatrixData)
            confusionMatrix = ConfusionMatrix();
            confusionMatrix.confusionMatrixData = confusionMatrixData;
        end
    end
    
end"
402,congruenceblocks.m,81.348,100,66.29,100,100.0,40.45,80-90,"function N = congruenceblocks(exponent_m,exponent_p,options,csclasses)

sdpvarout = 0;
if isa(exponent_m,'sdpvar')
    z = depends(exponent_p);
    z = recover(unique([depends(exponent_p) depends(exponent_m)]));
    [exponent_p,p_base] = getexponentbase(exponent_p,z);
    [m,m_base] = getexponentbase(exponent_m,z);
    exponent_m = cell(1);exponent_m{1} = m;
    sdpvarout = 1;
end

if nargin < 3
    options.verbose = 0;
    options.sos.congruence = 2;    
end

if nargin < 4
    csclasses = 1;
end

if ~isempty(exponent_m{1}) & options.sos.congruence>0 & ((size(exponent_p,2)<=16)  | options.sos.congruence==1)

    if options.verbose>0;fprintf('Finding symmetries..............');end;
    n = size(exponent_p,2);
    t = cputime;
    switch options.sos.congruence
        case 1
            Htemp = eye(n);                 % CHEAP VERSION; ONLY CHECK IF IT IS EVEN WRT x_i
        case 2
            Htemp = dec2decbin(1:2^n-1,n)'; % ALL POSSIBLE COMBINATIONS
        otherwise
            error('sos.congruence should be 0, 1 or 2')
    end
        H = Htemp(:,find(~any(rem(exponent_p*Htemp,2),1))); % Find ""even"" rows
    if isempty(H)
        N = exponent_m;
        if options.verbose>0;disp(['Found no symmetries (' num2str(cputime-t) 'sec)']);end
        return
    end

    t = cputime-t;
    if size(H,2)>=1
        if options.verbose>0
            if size(H,2)>1
                disp(['Found ' num2str(size(H,2)) ' symmetries  (' num2str(t) 'sec)']);
            else
                disp(['Found ' num2str(size(H,2)) ' symmetry  (' num2str(t) 'sec)']);
            end
        end
    else
        if options.verbose>0;disp(['Found no symmetries  (' num2str(t) 'sec)']);end;
    end

    if size(H,2)>=1
        the_text = 'Partitioning using symmetry.....';
    end
    N = cell(0,1);
    for cs = 1:length(csclasses)
        [ur,j,k]=uniquesafe(mod(exponent_m{cs}*H,2),'rows');
        Ntemp = cell(size(ur,1),1);
        temp = [];
        for i = 1:length(k)
            Ntemp{k(i),1} = [Ntemp{k(i)};exponent_m{cs}(i,:)];
            temp = [temp;size(exponent_m{cs}(i,:),1)];
        end

        for i = 1:length(Ntemp)
            N{end+1,1} = Ntemp{i};
        end
    end
    if size(H,2)>=1
        [uu,ii,oo] = uniquesafe(cellfun('prodofsize',N)/size(N{1},2));
        for i = 1:length(uu)
            n_this = length(find(oo==i));

            the_text = [the_text num2str(uu(i)) 'x' num2str(uu(i)) '(' num2str(n_this) ')' ' '];
        end
    end
    if options.verbose>0;;disp(the_text);end;
else
    N = exponent_m;
end

if sdpvarout
    for i = 1:length(N)
        N{i} = recovermonoms(N{i},z);
    end
end"
403,conic2ellipse.m,82.0,100,71.11,90,100.0,48.89,80-90,"function e = conic2ellipse(Aq)

    A = Aq(1, 1);
    B = 2*Aq(1, 2);
    C = Aq(2, 2);
    D = 2*Aq(1, 3);
    E = 2*Aq(2, 3);
    F = Aq(3, 3);

    if any(~isfinite(Aq(:))) || abs(B^2-4*A*C) < eps('single') || B^2-4*A*C > 0
        e = nan(5, 1);
        return
    end


    q = 64*(F*(4*A*C-B^2)-A*E^2+B*D*E-C*D^2)/(4*A*C-B^2)^2;

    s = 1/4*sqrt(abs(q)*sqrt(B^2+(A-C)^2));

    a = 1/8*sqrt(2*abs(q)*sqrt(B^2+(A-C)^2)-2*q*(A+C));

    b = sqrt(a^2-s^2);

    h = (B*E-2*C*D)/(4*A*C-B^2);
    k = (B*D-2*A*E)/(4*A*C-B^2);

    if abs(q*A-q*C) < eps('single') && abs(q*B) < eps('single')
        alpha = 0;
    elseif abs(q*A-q*C) < eps('single') && q*B > 0
        alpha = 1/4*pi;
    elseif abs(q*A-q*C) < eps('single') && q*B < 0
        alpha = 3/4*pi;
    elseif q*A-q*C > 0 && (abs(q*B) < eps('single') || q*B > 0)
        alpha = 1/2*atan(B/(A-C));
    elseif q*A-q*C > 0 && q*B < 0
        alpha = 1/2*atan(B/(A-C)) + pi;
    elseif q*A-q*C < 0
        alpha = 1/2*atan(B/(A-C)) + 1/2*pi;
    else
        e = nan(5, 1);
        return
    end

    e = [h k a b alpha]';
end"
404,conjg.m,85.0,100,91.67,75,100.0,58.33,80-90,"function [xmin,fxmin]=conjg(func,grad,x0,tol)
global FUN;
global X;
global P;
n=size(x0,1);
x=x0;
fx=feval(func,x);
oldfx=fx;
gnew=feval(grad,x);
iter=0;
while (((iter == 0) || (abs(fx-oldfx) > tol*(1+abs(fx)))) && (iter < 500))
  k=0;
  beta=0;
  p=zeros(n,1);
  while (((iter == 0) || (abs(fx-oldfx) > tol*(1+abs(fx)))) && (k < n))
    p=-gnew+beta*p;
    if (gnew'*p >= 0), break; end
    X=x;
    P=p;
    FUN=func;
    [a,u,b]=bracket(@subfun);
    [alphamin,falphamin,newa,newb]=bsearch(@subfun,a,u,b,1.0e-3);
    oldx=x;
    oldfx=fx;
    x=X+alphamin*P;
    fx=falphamin;
    gold=gnew;
    gnew=feval(grad,x);
    beta=(gnew'*gnew)/(gold'*gold);
    k=k+1;
    iter=iter+1;
  end
end
xmin=x;
fxmin=fx;
fprintf('Done with Conjugate Gradient Method, Iters=%d\\n',iter);"
405,conKnl.m,80.74,100,61.11,100,100.0,42.59,80-90,"function [K, sigma] = conKnl(D, varargin)

global DG KG;
isDG = isempty(D);
isKG = nargout == 0;

knl = ps(varargin, 'knl', 'g');
nei = ps(varargin, 'nei', .1);

if strcmp(knl, 'g')
    sigma = bandG(D, nei);
    if isDG && isKG
        KG = exp(- DG ./ (2 * sigma ^ 2 + eps));
    elseif isDG && ~isKG
        K = exp(- DG ./ (2 * sigma ^ 2 + eps));
    elseif ~isDG && isKG
        KG = exp(- D ./ (2 * sigma ^ 2 + eps));
    else
        K = exp(- D ./ (2 * sigma ^ 2 + eps));
    end
    
elseif strcmp(knl, 'man')
    sigma = nei;
    if isDG && isKG
        KG = exp(- DG ./ (2 * sigma ^ 2 + eps));
    elseif isDG && ~isKG
        K = exp(- DG ./ (2 * sigma ^ 2 + eps));
    elseif ~isDG && isKG
        KG = exp(- D ./ (2 * sigma ^ 2 + eps));
    else
        K = exp(- D ./ (2 * sigma ^ 2 + eps));
    end

elseif strcmp(knl, 'st')
    Dsorted = sort(D);

    D2 = Dsorted(1 : m, :);
    sigma = sum(D2, 1) / m;

    K = exp(- D ./ (sigma' * sigma * 2 + eps));

elseif strcmp(knl, 'bi')
    lb = m;
    ub = m;
    mask = ones(n, n);
    P = bdmatchwrapper(-D, mask, lb, ub);

    D2 = D .* P;
    sigma = sum(D2, 1) / m;
    K = exp(- (D .^ 2) ./ (sigma' * sigma * 2 + eps));

else
    error('unknown kernel type: %s', knl);
end"
406,conKnlGphMy.m,81.856,100,77.14,75,100.0,57.14,80-90,"function [Ks, lambs] = conKnlGphMy(KP, KQ, Gs, Hs, egy, parKnl)

isDiag = psY(parKnl, 'diag', 'n');

prIn('conKnlGphMy');

G1 = Gs{1};
G2 = Gs{2};
H1 = Hs{1};
H2 = Hs{2};
if isDiag
    L = [KQ, -KQ * G2'; -G1 * KQ, G1 * KQ * G2' + KP];
else
    L = [KQ, -KQ * G2'; -G1 * KQ, G1 * KQ * G2'];    
end


[U, S, V] = svd(L);
s = diag(S);
k = thEgy(s, egy);
pr('ratio: %d/%d %.3f', k, length(s), sum(s(1 : k)) / sum(s));
U = U(:, 1 : k);
V = V(:, 1 : k);
s = s(1 : k);
lambs = s;

Ks = cell(1, k);
for c = 1 : k
    HH2 = sparse(H2 * diag(V(:, c)) * H2');
    HH1 = sparse(H1 * diag(U(:, c)) * H1');
    Ks{c} = kron(HH2, HH1);

end

prOut;"
407,conKnlGphPQU.m,80.0,100,72.73,75,100.0,52.27,80-90,"function [KP, KQ] = conKnlGphPQU(gphs, parKnl)

alg = ps(parKnl, 'alg', 'toy');

gph1 = gphs{1};
gph2 = gphs{2};
[n1, m1] = size(gph1.G);
[n2, m2] = size(gph2.G);
m1 = m1 * 2;
m2 = m2 * 2;
prIn('conKnlGphPQU', 'alg %s, n1 %d, n2 %d, m1 %d, m2 %d', alg, n1, n2, m1, m2);

if strcmp(alg, 'toy')
    KP = zeros(n1, n2);
    DQ = conDst(gph1.XQ, gph2.XQ);
    KQ = exp(-DQ / .15);

elseif strcmp(alg, 'cmum')
    KP = zeros(n1, n2);
    DQ = conDst(gph1.dsts, gph2.dsts);    
    KQ = exp(-DQ / 2500);

elseif strcmp(alg, 'pas')
    DP = conDst(gphs{1}.XP, gphs{2}.XP);
    KP = exp(-real(sqrt(DP)));

    Dst1 = repmat(gph1.dsts', 1, m2);
    Dst2 = repmat(gph2.dsts, m1, 1);
    Dst = abs(Dst1 - Dst2) ./ (min(Dst1, Dst2) + eps);

    Ang1 = repmat(gph1.angs', 1, m2);
    Ang2 = repmat(gph2.angs, m1, 1);
    Ang = abs(Ang1 - Ang2);

    KQ = exp(-(Dst + Ang) / 2);
    
else
    error('unknown algorithm: %s', alg);
end


KQ = KQ(1 : round(m1 / 2), 1 : round(m2 / 2));

prOut;"
408,conndef.m,83.396,100,69.81,100,100.0,47.17,80-90,"function conn = conndef(num_dims,type)



error(nargchk(2,2,nargin,'struct'))

if ~ischar(type)
    eid = 'Images:conndef:expectedString';
    error(eid, '%s', 'TYPE must be a string.');
end

if ~isnumeric(num_dims) || (numel(num_dims) ~= 1)
    eid = 'Images:conndef:invalidNumDims';
    error(eid, '%s', 'NUM_DIMS must be a scalar integer >= 2.');
end
num_dims = double(num_dims);
if (num_dims ~= round(num_dims)) || (num_dims < 2)
    eid = 'Images:conndef:invalidNumDims';
    error(eid, '%s', 'NUM_DIMS must be a scalar integer >= 2.');
end

allowed_strings = {'minimal','maximal'};
idx = strmatch(lower(type),allowed_strings);
if isempty(idx)
    eid = 'Images:conndef:unrecognizedType';
    error(eid, 'Unrecognized TYPE string: %s', type);
elseif length(idx) > 1
    eid = 'Images:conndef:ambiguousType';
    error(eid, 'Ambiguous TYPE string: %s', type);
else
    type = allowed_strings{idx};
end

switch type
  case 'minimal'
    conn = zeros(repmat(3,1,num_dims));
    conn((end+1)/2) = 1;
    idx = repmat({2},1,num_dims);
    for k = 1:num_dims
        idx{k} = 1;
        conn(idx{:}) = 1;
        idx{k} = 3;
        conn(idx{:}) = 1;
        idx{k} = 2;
    end
    
  case 'maximal'
    conn = ones(repmat(3,1,num_dims));
    
  otherwise
    eid = 'Images:conndef:unexpectedType';
    error(eid, '%s', 'Internal error: unexpected TYPE string.');
end"
409,connectedComponent.m,80.0,100,67.5,90,100.0,42.5,80-90,"function [C] = connectedComponent(TT,TAG)

TOVISIT = 1;
VISITED = 2;

TAG(TAG ~= 0) = TOVISIT; % mark as to visit
C = cell(1,1);
Crow = 1;

I = find(TAG);

for i = I'
    if (TAG(i) == 1) % must be visited
        CElem = [i];
        toVisit = [i];
        TAG(i) = VISITED;

        while size(toVisit) ~= 0
            current = toVisit(1);
            toVisit = toVisit(2:end);
            for j=1:3
                neigh = TT(current,j);
                if (neigh == -1)
                    continue %% border
                end

                if (TAG(neigh) == TOVISIT)
                    TAG(neigh) = VISITED;
                    CElem = [CElem neigh];
                    toVisit = [toVisit neigh];
                end
            end
        end

        C{Crow} = CElem;
        Crow = Crow + 1;
    end
end

end"
410,connectedFR.m,85.0,100,85.29,75,100.0,64.71,80-90,"function [connectedRowsFRBool, connectedColsFRVBool] = connectedFR(F, R)

if ~exist('largest_component','file')
    error('Install gamic and add it to your path. (http://www.mathworks.com/matlabcentral/fileexchange/24134-gaimc-graph-algorithms-in-matlab-code)')
else
    [m,n]=size(F);
    F2=sparse(m,n);
    R2=sparse(m,n);
    F2(F~=0)=1;
    R2(R~=0)=1;
    FR = [F2,R2];
    FRV = [F2;R2];

    A=convertHypergraphToBipartiteGraph(FR);

    [Asci,Asizes] = scomponents(A);
    connectedRowsFRBool=false(size(A,1),length(Asizes));
    for i=1:length(Asizes)
        connectedRowsFRBool(:,i)=Asci==i;
    end
    connectedRowsFRBool=connectedRowsFRBool(1:m,:);
    sumComponent=sum(connectedRowsFRBool,1);
    connectedRowsFRBool=connectedRowsFRBool(:,sumComponent~=0);

    B=convertHypergraphToBipartiteGraph(FRV);
    [Bsci,Bsizes] = scomponents(B);
    connectedColsFRVBool=false(size(B,1),length(Bsizes));
    for j=1:length(Bsizes)
        connectedColsFRVBool(:,j)=Bsci==j;
    end
    connectedColsFRVBool=connectedColsFRVBool(1:n,:);
    sumComponent=sum(connectedColsFRVBool,1);
    connectedColsFRVBool=connectedColsFRVBool(:,sumComponent~=0);
end"
411,connectedness.m,80.418,100,72.92,75,100.0,54.17,80-90,"function [C] = connectedness(Phi,Sigma,p,Omega)


Pesaran_Shin = 0;
[m, ny] = size(Phi);    
if rem(m, ny)==0
    lags = m/ny;
else
    lags = floor((m-1)/ny);
end
if nargin<4
    Pesaran_Shin  = 1; 
    Omega = Sigma;        
end

theta = zeros(ny);
Phi0 = Phi(1:lags*ny,:);
Psi = var2ma(Phi0,p);
DD = 0;
for hh = 0 : p-1
    DD = DD + Psi(:,:,hh+1) * Sigma * Psi(:,:,hh+1)';
end
for ss = 1 : ny
    for j= 1 : ny
        NN = 0;
        for hh = 0 : p-1
            AA = Psi(:,:,hh+1) * Omega;
            NN = NN + AA(ss,j)^2;
        end
        theta(ss,j) = NN / DD(ss,ss);
        if Pesaran_Shin  == 1 
            theta(ss,j) = Sigma(j,j)^(-1/2) * theta(ss,j);            
        end
    end
end

Theta = theta ./ repmat(sum(theta,2),1,ny);

if max(max(abs(sum(Theta,2) - ones(ny,1))))>1e-8
    error('something went wrong')
end

Theta0          = Theta - diag(diag((Theta)));
C.Index         = sum(sum(Theta0)) / ny * 100; % overall index of connectedness
C.FromAllToUnit = sum(Theta0,2) / (ny-1) * 100;    % connectedness from all to unit i 
C.FromUnitToAll = sum(Theta0,1)' / (ny-1) * 100;   % connectedness from unit i to all 
C.Net           = C.FromUnitToAll - C.FromAllToUnit;   % connectedness from unit i to all 
C.theta         = theta;"
412,connectedRxnsByEFM.m,86.364,100,72.73,100,100.0,59.09,80-90,"function rxnLink = connectedRxnsByEFM(model, conComp, rxnInLoops, printLevel)

if nargin < 4
    printLevel = 0;
end
efmToolpath = which('CalculateFluxModes.m');
if isempty(efmToolpath)
    rxnLink = [];
    if printLevel
        fprintf('EFMtool not in Matlab path. Unable to calculate EFMs.\\n')
    end
    return
end
efmToolpath = strsplit(efmToolpath, filesep);
efmToolpath = strjoin(efmToolpath(1: end - 1), filesep);
p = pwd;
cd(efmToolpath)
options = CreateFluxModeOpts('sign-only', true, 'level', 'WARNING');

rxnLink = sparse(size(model.S, 2), size(model.S, 2));
for jC = 1:max(conComp)
    try
        S = model.S(:, conComp == jC);
        S = S(any(S, 2), :);
        S(:, rxnInLoops(conComp == jC, 1) & ~rxnInLoops(conComp == jC, 2)) = -S(:, rxnInLoops(conComp == jC, 1) & ~rxnInLoops(conComp == jC, 2));
        rev = all(rxnInLoops(conComp == jC, :), 2);
        efms = CalculateFluxModes(full(S), double(rev), options);
        pause(1e-4)
        efms = efms.efms;
        rxnJC = find(conComp == jC);
        for j = 1:numel(rxnJC)
            rxnLink(rxnJC(j), rxnJC) = any(efms(:, efms(j, :) ~= 0), 2)';
        end
    catch msg
        if printLevel
            fprintf('Error encountered during calculation of EFMs:\\n%s', getReport(msg))
        end
        rxnLink = [];
        return
    end
end
cd(p)

end"
413,connected_components.m,84.074,100,68.52,100,100.0,51.85,80-90,"function [groups, unvisited] = connected_components(C, groups, unvisited)



nn = size(C, 2);        %% number of nodes
Ct = C';
visited = zeros(1, nn); %% start with nothing visited
if nargin < 2
    groups = {};
    unvisited = 1:nn;
    isolated = find(sum(abs(C), 1) == 0);   %% find isolated nodes
    unvisited(isolated) = [];   %% remove isolated nodes from unvisited
end

cn = unvisited(1);      %% set current node to first unvisited node
visited(cn) = 1;        %% mark current node as visited
qs = zeros(1, nn);      %% initialize queue/stack
f = 1; N = 0;           %% queue starts at position f, has N elements

qs(mod(f+N-1, nn)+1) = cn; N = N + 1;       %% FIFO / BFS

while N                 %% FIFO / BFS
    cn = qs(f); N = N - 1; f = mod(f, nn) + 1;  %% FIFO / BFS

    [jj, junk] = find(Ct(:, C(:, cn) ~= 0));    %% non-zeros in rows connected to cn
    cnn = jj(visited(jj) == 0); %% indices of non-visited cols (may contain dups)

    for k = 1:length(cnn)
        if visited(cnn(k)) == 0         %% if not yet visited
            visited(cnn(k)) = 1;        %% mark as visited
            N = N + 1; qs(mod(f+N-2, nn)+1) = cnn(k);   %% FIFO / BFS
        end
    end
end

group = find(visited);
groups{end+1} = group;

v = ones(nn, 1);
v(unvisited) = 0;
v(group)     = 1;
unvisited    = find(v == 0);

if isempty(unvisited)       %% sort groups by cardinality
    l = cellfun('length', groups);
    [junk, i] = sort(l, 2, 'descend');
    groups = groups(i);
else                        %% recurse
    [groups, unvisited] = connected_components(C, groups, unvisited);
end

if nargin < 2
    unvisited = isolated;
end"
414,connected_components_demo_gui.m,82.922,100,68.54,100,100.0,46.07,80-90,"function varargout = connected_components_demo_gui(im)
