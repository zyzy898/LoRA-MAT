2164,computeKCcorrection.m,70.876,100,59.38,45,100.0,50.0,70-80,"function [ KCcorrection, phi_ssa ] = computeKCcorrection( PSD )


PSD  = PSD(:);
PSD = PSD(PSD ~= 0);
nPSD = length(PSD);

for iPSD = 2:nPSD
    r1 = PSD(iPSD-1);
    r2 = PSD(iPSD);
    saSlice(iPSD-1) = pi.*(r2 + r1).*sqrt((r2-r1).^2 + 1^2);
end

pv = pi.*sum(PSD.^2);       % Pore volume
sa = sum(saSlice);          % Surface Area

phi_ssa = pv/sa;            % Pore volume/Surface area ratio

rH = 2.*pv./sa;

rC = sqrt(sum(PSD.^2)/nPSD);

rA = sqrt(rH.*rC);


permTheo = nPSD./(sum(1./PSD.^4));
permKC = (rA).^4;

KCcorrection = permTheo./permKC;


end"
2165,ComputeKernel.m,74.938,100,43.04,100,100.0,31.65,70-80,"function [kx, rbfPart, linearPart, n2] = computeKernel(x, lntheta, type, x2)




lntheta=log(thetaConstrain(exp(lntheta)));
theta = exp(lntheta);

if nargin < 3
  type = 'regular';
end

if nargin < 4
  
  switch type
   case 'linear'
    rbfPart = [];
    n2 = [];
    linearPart = x*x'*theta(1);
    kx = linearPart + theta(3)*eye(size(x, 1)) + theta(2);
    
   case 'rbf'
    n2 = dist2(x, x);
    wi2 = (.5 .* theta(1));
    rbfPart = theta(2)*exp(-n2*wi2);
    kx = rbfPart + theta(3)*eye(size(x, 1)) + theta(4);
    linearPart = [];
    
   case 'regular'
    n2 = dist2(x, x);
    wi2 = (.5 .* theta(1));
    rbfPart = theta(2)*exp(-n2*wi2);
    linearPart = x*x'*theta(5);
    kx = rbfPart + theta(3)*eye(size(x, 1)) + theta(4) + linearPart;
    
   case 'ARD'
    scales = diag(sqrt(theta(6:(5+size(x, 2)))));
    x = x*scales;
    n2 = dist2(x, x);
    wi2 = (.5 .* theta(1));
    rbfPart = theta(2)*exp(-n2*wi2);
    linearPart = x*x'*theta(5);
    kx = rbfPart + theta(3)*eye(size(x, 1)) + theta(4) + linearPart;
  end
  
else
  switch type
   case 'linear'
    rbfPart = [];
    n2 = [];
    linearPart = x*x2'*theta(1);
    kx = theta(2) + linearPart;
    
    
   case 'rbf'
    n2 = dist2(x, x2);
    wi2 = (.5 .* theta(1));
    rbfPart = theta(2)*exp(-n2*wi2);
    linearPart = [];
    kx = rbfPart + theta(4);
   
   case 'regular'
    n2 = dist2(x, x2);
    wi2 = (.5 .* theta(1));
    rbfPart = theta(2)*exp(-n2*wi2);
    linearPart = x*x2'*theta(5);
    kx = rbfPart + theta(4) + linearPart;
    
   case 'ARD'
    scales = diag(sqrt(theta(6:(5+size(x, 2)))));
    x = x*scales;
    x2 = x2*scales;
    n2 = dist2(x, x2);
    wi2 = (.5 .* theta(1));
    rbfPart = theta(2)*exp(-n2*wi2);
    linearPart = x*x2'*theta(5);
    kx = rbfPart + theta(4) + linearPart;
  end
end"
2166,ComputeKernelTest.m,77.538,100,50.77,100,100.0,36.92,70-80,"function [K_test] = ComputeKernelTest(train, test, kernel, gamma, mu, sq_dist)

if (size(train,2))>2e4 && (strcmp(kernel, 'chi2')|| strcmp(kernel, 'chi2-rbf'))% )
    
    switch kernel
        case {'linear'}
            K_test = train * test';
        case {'chi2'}
         parpool
            parfor i =1:size(test,1)
                dotp = bsxfun(@times, test(i,:), train);
                sump = bsxfun(@plus, test(i,:), train);
                K_test(:,i) = 2* sum(dotp./(sump+1e-10),2);
            end
        delete(gcp);    
          clear subp sump;
          K_test=double(K_test);
        case {'Gaussian'}% Gaussian kernel
          sq_dist = EuclidDist(train, train);
          mu=mean(mean(sq_dist));
          clear sq_dist
          
          sq_dist = EuclidDist(train, test);
          K_test = exp(-sq_dist/(2*mu)); 

        case {'chi2-rbf'}
            sigma = 1;
           parpool
            parfor i =1:size(test,1)
                subp = bsxfun(@minus, test(i,:), train);
                subp = subp.^2;
                sump = bsxfun(@plus, test(i,:), train);
                K_test(:,i) =  sum(subp./(sump+1e-10),2);
            end
            K_test =exp(-K_test./sigma);  K_test=double(K_test);
            delete(gcp);   
    end
else
    switch kernel
        case {'linear'}
            K_test =(train * test');
        case {'chi2'}
            for i =1:size(test,1)
                dotp = bsxfun(@times, test(i,:), train);
                sump = bsxfun(@plus, test(i,:), train);
                K_test(:,i) = 2* sum(dotp./(sump+1e-10),2);
            end
              K_test=double(K_test);
         case {'Gaussian'}% Gaussian kernel

          K_test = exp(-sq_dist/(gamma*mu)); 
        case {'chi2-rbf'}
            sigma = 1;

            for i =1:size(test,1)
                subp = bsxfun(@minus, test(i,:), train);
                subp = subp.^2;
                sump = bsxfun(@plus, test(i,:), train);
                K_test(:,i) =  sum(subp./(sump+1e-10),2);
            end
            K_test =exp(-K_test./sigma);  K_test=double(K_test);
     
    end
 end
return;"
2167,computeKFirstEigenvectors.m,79.374,100,65.62,75,100.0,56.25,70-80,"function [X, lambda, timing, D] = computeKFirstEigenvectors(W, nbEigenvectors, isncut, D)

if nargin < 3
    isncut = 1;
end

n = size(W, 1);
[options, nbEigenvectors] = getDefaultOptionsEigs(n, nbEigenvectors);

if isncut
    if nargin >= 4
        D = D(:);
        Dinvsqrt = 1 ./ sqrt(D + eps);
        W = normalizeW_D(W, Dinvsqrt);
    else
        [W, Dinvsqrt, D] = normalizeW_D(W, [], 0);
    end
end

if issparse(W) && mex_istril(W)    
    [result, timing] = eigs_optimized(@mex_w_times_x_symmetric_tril, [], nbEigenvectors, options, W);
else
    [result, timing] = eigs_optimized(W, [], nbEigenvectors, options);
end
X = result.X;

if isncut
    X = spdiag(Dinvsqrt) * X;
end

lambda = result.lambda;
mex_normalizeColumns(X);"
2168,ComputeL.m,75.182,60,72.73,75,100.0,68.18,70-80,"function [ L ] = computeL( options, GT, kappa)
    
    L = cell(options.M, 1);

    for comp = 1 : options.M
        siz = [options.S(4, comp) - options.S(2, comp) + 1; options.S(3, comp) - options.S(1, comp) + 1];
        offset = options.S(1:2, comp);
        
        cor_sqr = zeros(2, siz(2)*siz(1));
        
        for i = 1 : siz(2)
            cor_sqr(1, (i-1)*siz(1)+1:(i*siz(1))) = (i-1+offset(1) - GT(1, comp)).^2;
            cor_sqr(2, (i-1)*siz(1)+1:(i*siz(1))) = (offset(2) - GT(2, comp):offset(2)+siz(1)-1 - GT(2, comp)).^2;
        end;
        if (nargin < 3)
            L{comp} = 1/options.M .* sqrt( cor_sqr(1,:) + cor_sqr(2,:) );
        else 
            L{comp} = 100 * kappa * 1/options.M .* sqrt( cor_sqr(1,:) + cor_sqr(2,:) );
        end;
    end;

end"
2169,computeLabelWeights.m,72.852,60,88.89,45,100.0,70.37,70-80,"function weights = computeLabelWeights(config_file)

eval(config_file);

fid = fopen(PATH.trainingNames, 'r');
imageNames = textscan(fid, '%s');
labelNames = strcat([DIR.groundTruth, '/'], regexprep(imageNames{1}, '\\.(bmp|jpg)$', '_GT.bmp'));
numTrain = numel(labelNames);
