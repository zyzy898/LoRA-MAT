function p = ph1(x,v,h,M)
n     = numel(v);
x     = 1:128;
c     = linspace(48,80,n);
p     = x - x;
for i = 1:n
    b = exp(-((x - c(i)).^2)/128);
    p = p + (b - mean(b))*v(i);
end

p  = 8 - p(:);

return


function p = ph2(x,v,h,M)
n       = sqrt(numel(v));
v       = reshape(v,n,n);
x       = 1:32;
[x1,x2] = ndgrid(x);
c       = linspace(8,24,n);
p       = x1 - x1;

for i = 1:size(v,1)
    for j = 1:size(v,1)
        b = exp(-((x1 - c(i)).^2 + (x2 - c(j)).^2)/32);
        p = p + (b - mean(mean(b)))*v(i,j);
    end
end

p  = 8 - p(:);"
