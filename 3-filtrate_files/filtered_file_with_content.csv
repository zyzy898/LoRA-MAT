                        if ~isempty(regexp(tok{t}, ['^(' this.PAR_S_ORBOK.par ')*$'], 'once'))
                            fh_list = [fh_list; Core.getCoreSky.showOrbitsAvailability(Core.getState.getSessionLimits.first, Core.getState.getSessionLimits.last)]; %#ok<AGROW>
