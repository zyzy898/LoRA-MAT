                r_sett.Arvec = [x1r; x2r];
        end
        r_sett.biasvec = biasvec;
        r_sett.nderivvec = nderivvec;
        r_sett.dorefvec = ones(2,1);
        r_sett.cos1_sin0 = cos1_sin0;
        r_sett.Amat = Amat;
        r_sett.Tmat = Tmat;           
