3380,countUnique.m,75.582,80,50.91,100,100.0,47.0,70-80,"function [uniques,numUnique] = countUnique(x,option)


if isempty(x)
    uniques = x;
    numUnique = x;
    return;
elseif isscalar(x)
    uniques = x;
    numUnique = 1;
    return;
end

testFloat = false;
if nargin == 2 && strcmpi(option,'float')
    testFloat = true;
end

nOut = nargout;
if testFloat
    if nOut < 2
        [uniques] = float_cell_unique(x,nOut);
    else
        [uniques,numUnique] = float_cell_unique(x,nOut);
    end
else
    try %this will fail if the array is float or cell
        if nOut < 2
            [uniques] = int_log_unique(x,nOut);
        else
            [uniques,numUnique] = int_log_unique(x,nOut);
        end
    catch %default to standard approach
        if nOut < 2
            [uniques] = float_cell_unique(x,nOut);
        else
            [uniques,numUnique] = float_cell_unique(x,nOut);
        end
    end
end

end

function [uniques,numUnique] = int_log_unique(x,nOut)
maxVal = max(x(:));
if maxVal / numel(x) > 1000
    throw(MException('countUnique','Accumarray is inefficient for arrays when ind values are >> than the number of elements'))
end
minVal = min(x(:));
if minVal < 1
    index = x(:) - minVal + 1;

    numUnique = accumarray(index,1);

    sumDups = accumarray(index,x(:));
else
    numUnique = accumarray(x(:),1);

    sumDups = accumarray(x(:),x(:));
end

test = (numUnique > 0);

uniques = sumDups(test) ./ (numUnique(test));

if nOut == 2
    numUnique = numUnique(test);
end
end

function [uniques,numUnique] = float_cell_unique(x,nOut)

if ~iscell(x)
    x = sort(x(:));
    numelX = numel(x);

    currClass = class(x);
    isdouble = strcmp(currClass,'double');

    if ~isdouble
        x = double(x);
    end

    if isnan(x(1)) || isinf(x(1)) || isnan(x(numelX)) || isinf(x(numelX))
        xnan = isnan(x);
        xinf = isinf(x);
        testRep = xnan | xinf;

        x = x(~testRep);
    end

    uniqueLocs = [true;diff(x) ~= 0];
else
    isdouble = true; %just to avoid conversion on finish

    x = sort(x(:));

    uniqueLocs = [true;~strcmp(x(1:end-1),x(2:end)) ~= 0] ;
end

uniques = x(uniqueLocs);

if ~isdouble
    x = feval(currClass,x);
end

if nOut == 2
    numUnique = diff([find(uniqueLocs);length(x)+1]);
end
end"
3381,count_6_cycles.m,72.488,100,68.29,60,100.0,34.15,70-80,"function num_6_cycles = count_6_cycles(H, cn)
disp('We are now counting the number of length-6-cycles in the target H.');
M = size(H, 1);
num_6_cycles = 0;
for m1 = 1 : M - 2
    for i1 = 1 : cn(m1)
        index_1 = H(m1, i1);
        for m2 = m1 + 1 : M - 1
            for i2 = 1 : cn(m2)
                index_2 = H(m2, i2);
                if index_2 == index_1
                    for j1 = 1 : cn(m2)
                        index_3 = H(m2, j1);
                        if index_3 ~= index_2
                            for m3 = m2 + 1 : M
                                for i3 = 1 : cn(m3)
                                    index_4 = H(m3, i3);
                                    if index_4 == index_3
                                        for j2 = 1 : cn(m3)
                                            index_5 = H(m3, j2);
                                            if index_5 ~= index_2 && index_5 ~= index_4
                                                for j3 = 1 : cn(m1)
                                                    index_6 = H(m1, j3);
                                                    if index_6 == index_5
                                                        num_6_cycles = num_6_cycles + 1;
                                                    end
                                                end
                                            end
                                        end
                                    end
                                end
                            end
                        end
                    end
                end
            end
        end
    end
end
disp(' ');
disp(['The number of 6-cycles in the target H is ' num2str(num_6_cycles) '.'])"
