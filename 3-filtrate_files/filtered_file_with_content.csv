      prior.dof   = d + 1; 
end
if isvector(Sigma)
   Sigma = permute(rowvec(Sigma), [1 3 2]);  
end
nstates = size(Sigma, 3); 
if size(mu, 2) ~= nstates && size(mu, 1) == nstates
    mu = mu';
end
CPD = structure(mu, Sigma, nstates, d, prior); 
CPD.cpdType    = 'condGauss'; 
CPD.fitFn      = @condGaussCpdFit; 
CPD.fitFnEss   = @condGaussCpdFitEss;
CPD.essFn      = @condGaussCpdComputeEss;
CPD.logPriorFn = @logPriorFn;
CPD.rndInitFn  = @rndInit;
end

function cpd = rndInit(cpd)
d = cpd.d;
nstates = cpd.nstates;
cpd.mu = randn(d, nstates);
Sigma = zeros(d, d, nstates);
for i=1:nstates
    Sigma(:, :, i) = randpd(d) + 2*eye(d); 
end
cpd.Sigma = Sigma; 
end

function logp = logPriorFn(cpd)
logp = 0;
prior = cpd.prior; 
if ~isempty(prior) && isstruct(prior)
nstates = cpd.nstates; 
mu = cpd.mu;
Sigma = cpd.Sigma; 
for k = 1:nstates
    logp = logp + gaussInvWishartLogprob(prior, mu(:, k), Sigma(:, :, k));
end
end
end

function ess = condGaussCpdComputeEss(cpd, data, weights, B)
d       = cpd.d; 
nstates = cpd.nstates; 
wsum    = sum(weights, 1);
xbar    = bsxfun(@rdivide, data'*weights, wsum); %d-by-nstates
XX      = zeros(d, d, nstates);
for j=1:nstates
    Xc          = bsxfun(@minus, data, xbar(:, j)');
    XX(:, :, j) = bsxfun(@times, Xc, weights(:, j))'*Xc;
end
ess = structure(xbar, XX, wsum); 
end

function cpd = condGaussCpdFitEss(cpd, ess)
wsum    = ess.wsum;
XX      = ess.XX;
xbar    = ess.xbar;
d       = cpd.d;
nstates = cpd.nstates;
prior   = cpd.prior;
if ~isstruct(prior) || isempty(prior) % do mle
    cpd.mu    = reshape(xbar, d, nstates);
    cpd.Sigma = bsxfun(@rdivide, XX, reshape(wsum, [1 1 nstates]));
else % do map
    kappa0 = prior.k;
    m0     = prior.mu(:);
    nu0    = prior.dof;
    S0     = prior.Sigma;
    mu     = zeros(d, nstates);
    Sigma  = zeros(d, d, nstates);
    for k = 1:nstates
        xbark          = xbar(:, k);
        XXk            = XX(:, :, k);
        wk             = wsum(k);
        mn             = (wk*xbark + kappa0*m0)./(wk + kappa0);
        a              = (kappa0*wk)./(kappa0 + wk);
        b              = nu0 + wk + d + 2;
        Sprior         = (xbark-m0)*(xbark-m0)';
        Sigma(:, :, k) = (S0 + XXk + a*Sprior)./b;
        mu(:, k)       = mn;
    end
    cpd.mu    = mu;
    cpd.Sigma = Sigma;
end
end

function cpd = condGaussCpdFit(cpd, Z, Y)
d = cpd.d; 
Z = colvec(Z); 
prior = cpd.prior; 
nstates = cpd.nstates; 
if ~isstruct(prior) || isempty(prior) % do mle
    cpd.mu    = partitionedMean(Y, Z, nstates)';
    cpd.Sigma = partitionedCov(Y, Z,  nstates); 
else  % map
    mu = zeros(d, nstates);
    Sigma = zeros(d, d, nstates);
    for s = 1:nstates
        m              = gaussFit(Y(Z == s, :), prior);
        mu(:, s)       = m.mu(:);
        Sigma(:, :, s) = m.Sigma;
    end
    cpd.mu = mu;
    cpd.Sigma = Sigma; 
end
end"
2582,condGaussCpdMultiFit.m,72.668,60,76.67,60,100.0,66.67,70-80,"function [localCPDs, localCPDpointers, localMu, localSigma] = ...
  condGaussCpdMultiFit(X, obs, Nstates)

[Ncases Nnodes Ndims] = size(obs); %#ok
localCPDs = cell(1, Nnodes);
localCPDpointers = 1:Nnodes; % each node has its own CPD

localMu = zeros(Ndims,  Nstates, Nnodes);
localSigma = zeros(Ndims, Ndims, Nstates, Nnodes);

for t=1:Nnodes
  Y = squeeze(obs(:,t,:)); % Y(case,dim)
  Z = canonizeLabels(X(:,t)); %
  if nunique(Z) < Nstates
    sprintf('node %d only has %d states\\n', t, nunique(Z));
  end
  Sigma = zeros(Ndims, Ndims, Nstates);
  mu = zeros(Ndims, Nstates);
  for c=1:Nstates
    ndx = (Z==c);
    mu(:,c) = mean(Y(ndx,:))';
    Sigma(:,:,c) = shrinkcov(Y(ndx,:));
  end
  localCPDs{t} = condGaussCpdCreate(mu,  Sigma);
 
  localMu(:,:,t) = mu;
  localSigma(:,:,:,t) = Sigma;
end

end"
2583,condgaussTrainObserved.m,76.0,60,100.0,45,100.0,75.0,70-80,"function [mu, Sigma] = mixgaussTrainObserved(obsData, hiddenData, nstates, varargin);

[D numex] = size(obsData);
Y = zeros(D, nstates);
YY = zeros(D,D,nstates);
YTY = zeros(nstates,1);
w = zeros(nstates, 1);
for q=1:nstates
  ndx = find(hiddenData==q);
  w(q) = length(ndx); % each data point has probability 1 of being in this cluster
  data = obsData(:,ndx);
  Y(:,q) = sum(data,2);
  YY(:,:,q) = data*data';
  YTY(q) = sum(diag(data'*data));
end
[mu, Sigma] = mixgauss_Mstep(w, Y, YY, YTY, varargin{:});"
