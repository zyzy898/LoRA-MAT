            options.priors.SigmaPhi = eye(3);
            options.priors.SigmaPhi(1,1) = 0;
            options.priors.SigmaPhi(3,3) = 0;
            options.verbose = 0;
            options.DisplayWin = 0;
            dim.n_theta         = 0;
            dim.n_phi           = 3;
            dim.n               = 0;
            [posterior,out] = VBA_NLStateSpaceModel(y(1,:)',[],[],g_fname,dim,options);
            phi(l,k) = posterior.muPhi(2);

        end
    end

end

