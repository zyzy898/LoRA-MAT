283,compute_gradient_tensor.m,80.588,60,82.35,90,100.0,70.59,80-90,"function T = compute_gradient_tensor(M,h,options)


options.null = 0;
if iscell(M)
    for i=1:length(M)
        T{i} = compute_gradient_tensor(M{i},h,options);
    end
    return
end
if size(M,3)>1
    u = M;
else
    u = grad(M, options);
end
