else
    [ StreamlinesXYZ, StreamlinesAbsFlux, totalDistance, totalTime, ...
        totalFlux, tortuosity, tortuosityMin, tortuosityMean, tortuosityMax, ...
        tortuosityFluxWeighted, tortuosityStd ] ...
