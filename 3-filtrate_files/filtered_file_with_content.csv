2480,compute_w1rp.m,71.62,60,71.43,60,100.0,66.67,70-80,"function [w1rp, Tau] = compute_w1rp(Pulse)
      
Trf = Pulse.Trf;
omega2 = Pulse.omega2;
if moxunit_util_platform_is_octave
    int = quad(omega2, 0, Trf);
else
    int = integral(omega2, 0, Trf);
end

