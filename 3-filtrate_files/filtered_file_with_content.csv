5912,det2keypointsImgMulticut_old.m,78.832,80,65.31,100,100.0,48.85,70-80,"function [keypointsAll, imgidxs_missing] = det2keypointsImgMulticut(expidx,parts,annolist_gt,bAllPartsOn)

fprintf('det2keypointsImgMulticut()\\n');

if (nargin < 4)
    bAllPartsOn = false;
end

p = rcnn_exp_params(expidx);

predDir = p.multicutDir;
if (isfield(p,'predDir'))
