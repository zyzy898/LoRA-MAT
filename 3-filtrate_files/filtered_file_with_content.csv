5032,DefSynth.m,74.334,60,86.67,45,100.0,80.0,70-80,"function [Radial,Transverse]=DefSynth(dt,alpha,sigma,Time)
alpha=deg2rad(alpha);
Time=Time-Time(length(Time))/2;
w0=-2*(Time+dt/2).*exp(-((Time+dt/2)/sigma).^2)/(sigma*sigma);
w1=-2*(Time-dt/2).*exp(-((Time-dt/2)/sigma).^2)/(sigma*sigma);

for k=1:1:length(alpha)
    Radial(k,:)=w0*cos(alpha(k))^2+w1*sin(alpha(k))^2;
    Transverse(k,:)=0.5*(w1-w0)*sin(2*alpha(k));
end
for k=1:1:length(alpha)
    MAX=max(abs(Radial(k,:)));
    Radial(k,:)=Radial(k,:)/MAX;
    Transverse(k,:)=Transverse(k,:)/MAX;
end"
5033,def_filename.m,73.31,100,53.52,75,100.0,38.03,70-80,"function fileName = def_filename(obj)


import mperl.file.spec.*;
import goo.pkgisa;
import datahash.DataHash;

HASH_LENGTH = 4;
MAX_LENGTH = 15;

if ~isempty(get_rootpath(obj))
    path = get_rootpath(obj);
elseif ~isempty(obj.Parent),
    path = fileparts(obj.Parent);
else
    path = pset.session.instance.Folder;
end

if ~isempty(get_title(obj)),
    
    title = regexprep(lower(get_title(obj)), '[^\\w]+', '-');
    fileName = strrep(title, '.', '-');
    
else
    
    rDir = get_rootpath(obj);
    if ~isempty(rDir),
        dirs = splitdir(rDir);
        fileName = dirs{end};
    else
        fileName = '';
    end    
    
end

if numel(fileName) > MAX_LENGTH,
    fileName = DataHash(rand(1,100));
    fileName = fileName(1:HASH_LENGTH);
end

objArray = obj.Objects;
if all(cellfun(@(x) pkgisa(x, 'hashable') || pkgisa(x, 'hashable_handle'), ...
        objArray)),
   
    hashCode = cellfun(@(x) get_hash_code(x), objArray, ...
        'UniformOutput', false);
    hashCode = DataHash(hashCode);
    
    if isempty(fileName),
        fileName = hashCode;
    else
        fileName = [fileName '_' hashCode(end-HASH_LENGTH:end)];
    end
    
end

if isempty(fileName),
    
    randHash = DataHash(randn(1,1000));
    fileName = randHash(end-HASH_LENGTH:end);
    
end

fileName = catfile(path, [fileName '.txt']);

fileName = rel2abs(fileName);




end"
