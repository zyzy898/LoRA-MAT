3325,cos4correct.m,76.736,100,68.42,60,100.0,55.26,70-80,"function [imc, cf] = cos4correct(im, mask)



	if nargin > 1,
		fprintf('Morphological maximum filter');
		im = imorph(im, ones(mask), 'max');
		idisp(im)
		pause
	end

	[h,w] = size(im);
	[X,Y] = meshgrid(1:w,1:h);

	func = inline(...
	  'var(im./cos(sqrt( ((y-P(2)).^2)*P(4)+((x-P(1)).^2)*P(3) )).^4)', ...
		'P', 'x', 'y', 'im');

	P0 = [w/2 h/2 pi/4/w/64 pi/4/h/64];
	Pmin = [w/4 h/4 P0(3:4)/8];
	Pmax = [3*w/4 3*h/4 P0(3:4)*8];


	fprintf('\\rOptimizing                  ');
	opt = optimset('fmincon');
	opt = optimset(opt, 'Display', 'iter');
	P = fmincon(func, P0, [], [], [], [], Pmin, Pmax, [], opt, ...
		X(:), Y(:), im(:));

	cf = cos(sqrt( (Y(:)-P(2)).^2*P(4)+(X(:)-P(1)).^2*P(3) )).^4;

	cf = reshape(cf, size(im));
	idisp(cf);

	imc = im ./ cf;

	pause
	idisp(imc)"
3326,cosamp.m,72.2,60,84.0,45,100.0,72.0,70-80,"function Sest = cosamp(Phi,u,K,tol,maxiterations)
 
 
 
 
Sest = zeros(size(Phi,2),1);
v = u;
t = 1; 
numericalprecision = 1e-12;
T = [];
while (t <= maxiterations) && (norm(v)/norm(u) > tol)
  y = abs(Phi'*v);
  [vals,z] = sort(y,'descend');
  Omega = find(y >= vals(2*K) & y > numericalprecision);
  T = union(Omega,T);
  b = pinv(Phi(:,T))*u;
  [vals,z] = sort(abs(b),'descend');
  Kgoodindices = (abs(b) >= vals(K) & abs(b) > numericalprecision);
  T = T(Kgoodindices);
  Sest = zeros(size(Phi,2),1);
  b = b(Kgoodindices);
  Sest(T) = b;
  v = u - Phi(:,T)*b;
  t = t+1;
end"
3327,cosar_valid_data.m,78.53,100,77.55,60,100.0,55.1,70-80,"function [ valid_data ] = cosar_valid_data( filename, az_symmetry )

if ~exist('az_symmetry','var')
    az_symmetry = false; % Most TSX data is right-looking
end

fid=fopen(filename,'r','b');
fseek(fid,8,'bof');
rs=fread(fid,1,'int32'); % Range samples
az=fread(fid,1,'int32'); % Azimuth samples

fseek(fid,(rs+2)*4,'bof'); % Skip burst annotation
az_annotation=fread(fid,[(rs+2) 3],'int32'); % Valid data extents
az_min=az_annotation(3:end,2).'; % Trim off filler values
az_max=az_annotation(3:end,3).'; % Trim off filler values

fseek(fid,((rs+2)*4*4),'bof'); % Skip burst annotation
rg_annotation=fread(fid,[2 az],'2*int32', rs*4); % Valid data extents
rg_min = rg_annotation(1,:);
rg_max = rg_annotation(2,:);

fclose(fid);

rows = 1:rs;
azmin_valid = rows>=rg_min(az_min(rows)) & rows<=rg_max(az_min(rows));
azmax_valid = rows>=rg_min(az_max(rows)) & rows<=rg_max(az_max(rows));
cols = 1:az;
rgmin_valid = cols>=az_min(rg_min(cols)) & cols<=az_max(rg_min(cols));
rgmax_valid = cols>=az_min(rg_max(cols)) & cols<=az_max(rg_max(cols));
boundary_col = [az_min(azmin_valid) cols(rgmin_valid) az_max(azmax_valid) cols(rgmax_valid)];
if az_symmetry
    boundary_col = az - boundary_col + 1;
end
boundary_row = [rows(azmin_valid) rg_min(rgmin_valid) rows(azmax_valid) rg_max(rgmax_valid)];
K = convhull(boundary_col,boundary_row,'simplify',true);

K = K(1:(end-1)); % Last output from convhull is repeat of first
minrow = min(boundary_row(K));
indr = find(boundary_row(K)==minrow); % Might be more than one
[mincol, indc] = min(boundary_col(K(indr)));
first_vertex = indr(indc);
K = circshift(K, 1 - first_vertex);

for i = 1:numel(K)
    valid_data.Vertex(i).Row = boundary_row(K(i)) - 1; % SICD indices are zero-based, not one-based like MATLAB
    valid_data.Vertex(i).Col = boundary_col(K(i)) - 1;
end

end"
3328,CoSpace.m,75.75,100,62.5,60,100.0,56.25,70-80,"function [theta,P,res]=CoSpace(Y,X,Z,alfa,beta,L,maxiter)

epsilon = 1e-4; % Tolerance error
iter=1; 
stop = false;
res=zeros(1,maxiter); % Residuals

while ~stop && iter < maxiter+1
    
        P=(Y*Z')/(Z*Z'+alfa*eye(size(Z*Z'))); 
        
        theta=Solving_Theta(Y,P,Z,X,beta,maxiter,L);
        Z=theta*X;
    
     res(1,iter) = 0.5*norm(Y-P*theta*X,'fro')^2 + 0.5*alfa*norm(P,'fro')^2 + 0.5*beta*trace(theta*X*L*X'*theta');
   
    if iter>1
       r_Obj=abs(res(1,iter)-res(1,iter-1))/abs(res(1,iter-1));
       if r_Obj<epsilon
            stop = true;
            fprintf(' i = %f,res_Obj= %f\\n',iter,r_Obj);
            break;
       end

       if mod(iter,10) == 1
           fprintf(' i = %f,res_Obj= %f\\n',iter,r_Obj);
       end
    end

    iter=iter+1;
end
end"
3329,CoSpace_l1.m,75.872,100,64.52,60,100.0,54.84,70-80,"function [theta,P,res]=CoSpace_l1(Y,X,Z,alfa,beta,L,maxiter)

epsilon = 1e-4; % Tolerance error
iter=1; 
stop = false;
res=zeros(1,maxiter); % Residuals

while ~stop && iter < maxiter+1
    
        P=Solving_P1(Y,Z,alfa,maxiter); 
        theta=Solving_Theta(Y,P,Z,X,beta,maxiter,L);
        Z=theta*X;
    
     res(1,iter) = 0.5*norm(Y-P*theta*X,'fro')^2 + alfa*sum(sum(abs(P))) + 0.5*beta*trace(theta*X*L*X'*theta');
   
    if iter>1
       r_Obj=abs(res(1,iter)-res(1,iter-1))/abs(res(1,iter-1));
       if r_Obj<epsilon
            stop = true;
            fprintf(' i = %f,res_Obj= %f\\n',iter,r_Obj);
            break;
       end

       if mod(iter,10) == 1
           fprintf(' i = %f,res_Obj= %f\\n',iter,r_Obj);
       end
    end

    iter=iter+1;
end
end"
