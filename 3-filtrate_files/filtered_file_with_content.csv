2405,compute_norm_sign_scaling_factor.m,76.0,100,65.71,60,100.0,54.29,70-80,"function [Cc,Xc,sc]=compute_norm_sign_scaling_factor(X1,Cw,Alph,Xw)
 


n=size(Xw,1); %number of data points


Cc_=zeros(4,3);
for i=1:4
    Cc_(i,:)=X1(3*i-2:3*i);
end

Xc_=Alph*Cc_;

centr_w=mean(Xw);
centroid_w=repmat(centr_w,[n,1]);
tmp1=Xw-centroid_w;
dist_w=sqrt(sum(tmp1.^2,2));

centr_c=mean(Xc_);
centroid_c=repmat(centr_c,[n,1]);
tmp2=Xc_-centroid_c;
dist_c=sqrt(sum(tmp2.^2,2));
 
sc=1/(inv(dist_c'*dist_c)*dist_c'*dist_w);

Cc=Cc_/sc;

Xc=Alph*Cc;

neg_z=find(Xc(:,3)<0);
if size(neg_z,1)>=1
    sc=-sc;
    Xc=Xc*(-1);
end"
2406,compute_orthoproj_triangulation.m,77.16,100,74.19,60,100.0,51.61,70-80,"function v = compute_orthoproj_triangulation(vertex, face, M, options)


options.null = 0;
verb = getoptions(options, 'verb', 1);
interpolate = getoptions(options, 'interpolate', 0);

if interpolate
    v = interp2(M, vertex(2,:), vertex(1,:));
    return;
end

nface = size(face,2);
nvert = size(vertex,2);
n = size(M,1);

U = spalloc(nvert,nvert,15*nvert);
y = zeros(nvert,1);
tag = zeros(nvert,1);
for i=1:nface
    
    if verb
        progressbar(i,nface);
    end

    T = face(:,i);          % current triangles
    P = vertex(:,T);        % current points

    selx = min(floor(P(1,:))):max(ceil(P(1,:)));
    sely = min(floor(P(2,:))):max(ceil(P(2,:)));
    [Y,X] = meshgrid(sely,selx);
    pos = [X(:)'; Y(:)'];
    p = size(pos,2);    % number of poitns
    warning off;
    c = [1 1 1; P]\\[ones(1,p);pos];
    warning on;
    I = find( c(1,:)>=-10*eps & c(2,:)>=-10*eps & c(3,:)>=-10*eps );
    pos = pos(:,I);
    c = c(:,I);
    I = find( pos(1,:)<=n & pos(1,:)>0 & pos(2,:)<=n & pos(2,:)>0 );
    pos = pos(:,I);
    c = c(:,I);    
    J = sub2ind(size(M), pos(1,:),pos(2,:) ); 
    for j=1:3        
        j1 = mod(j,3)+1;
        ip = sum( c(j,:).^2);
        U(T(j),T(j)) = U(T(j),T(j)) + ip;
        ip = sum( c(j,:).*c(j1,:));
        U(T(j),T(j1)) = U(T(j),T(j1)) + ip;
        U(T(j1),T(j)) = U(T(j1),T(j)) + ip;        
        ipM = sum( M(J).*c(j,:) );
        y(T(j)) = y(T(j)) + ipM;
        tag(T(j)) = 1;
    end
end
warning off;
v = U \\ y;
warning on;

if sum(isnan(v))>0
    v(isnan(v)) = interp2(M, vertex(2,isnan(v)), vertex(1,isnan(v)));
end"
2407,compute_overlap.m,76.138,100,65.52,60,100.0,55.17,70-80,"clear;

