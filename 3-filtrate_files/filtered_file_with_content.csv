    DCM(i).Ep = Ep;
    DCM(i).Cp = Cp;
    DCM(i).M.pE = pE;
    DCM(i).M.pC = pC;
end

for i = 1:numel(Y)
    for j = 1:numel(Y)
        L(i,j) = spm_log_evidence(DCM(j).Ep,DCM(j).Cp,pE,pC,P{i},spm_unvec(spm_vec(pC)/16,pC));
    end
end

p = spm_softmax(L);

spm_figure('GetWin','Confusion matrix'); clf
imagesc(p), axis square
ylabel('Model')
xlabel('Synthetic dataset')

clear DCM

X = [ones(32,1),rand(32,1)>0.5];

B = [pE.TCP 2];

for i = 1:size(X,1)
    R = pE;
    R.TCP = X(i,:)*B' + randn/16;
    y{i} = spm_immune_gen(R);
    y{i} = (sqrt(y{i}(U,:)) + randn(size(y{i}(U,:)))/8).^2;
    [F,Ep,Cp,pE,pC] = spm_immune(y{i},U,pE,pC);
    DCM{i,1}.F  = F;
    DCM{i,1}.Ep = Ep;
    DCM{i,1}.Cp = Cp;
    DCM{i,1}.M.pE = pE;
    DCM{i,1}.M.pC = pC;
end

GLM.X  = X;
GLM.Xn = {'const.','BCG'};
[PEB,DCM] = spm_dcm_peb(DCM,GLM,{'TCP'});

[BMA,BMR] = spm_dcm_bmr_all(PEB,{'TCP'});"
5754,DEM_MDP_decision.m,77.508,80,65.81,100,100.0,41.73,70-80,"function MDP = DEM_MDP_decision



D{1} = [1 1]';        % rule:   {'left','right'}
D{2} = [0 0 1]';      % report: {'left','right','undecided'}

Nf    = numel(D);
Ns    = zeros(1,Nf);
for f = 1:Nf
    Ns(f) = numel(D{f});
end
a      = exp(1/4);              % odds ratio (ambiguity)
for f1 = 1:Ns(1)                % rule
    for f2 = 1:Ns(2)            % report
        
        A{1}(1:2,f1,f2) = 1;
        A{1}(f1, f1,f2) = a;
        
        if f2 == 3,
            A{2}(1,f1,f2) = 1; % undecided
        elseif f1 == f2
            A{2}(2,f1,f2) = 1; % right
        else
            A{2}(3,f1,f2) = 1; % wrong
        end
        
    end
end
Ng    = numel(A);
for g = 1:Ng
    No(g) = size(A{g},1);
    A{g}  = double(A{g});
end

for f = 1:Nf
    B{f} = eye(Ns(f));
end

B{2}(:,:,1) = [1 0 1;
               0 1 0;
               0 0 0];
B{2}(:,:,2) = [1 0 0;
               0 1 1;
               0 0 0];
B{2}(:,:,3) = [1 0 0;
               0 1 0;
               0 0 1];

U(1,1,:)  = [1 1]';         % choose left
U(1,2,:)  = [1 2]';         % choose right
U(1,3,:)  = [1 3]';         % keep watching

for g = 1:Ng
    C{g}  = zeros(No(g),1);
end
T    = 6;
C{2}(1,1:T) = 0;                % null
C{2}(2,1:T) = 3;                % correct
C{2}(3,1:T) = -6;               % wrong


mdp.T = T;                      % number of moves
mdp.U = U;                      % allowable policies
mdp.A = A;                      % observation model
mdp.B = B;                      % transition probabilities
mdp.C = C;                      % preferred outcomes
mdp.D = D;                      % prior over initial states
mdp.s = [1 3]'*ones(1,T);
mdp.o = [1 1]'*ones(1,T);
mdp.u = [1 3]'*ones(1,T);

mdp.Aname = {'cue', 'feedback'};
mdp.Bname = {'rule','decision'};
mdp.alpha = 2;
mdp.tau   = 2;

mdp  = spm_MDP_check(mdp);


MDP  = spm_MDP_VB_X(mdp);

spm_figure('GetWin','Figure 1'); clf
spm_MDP_VB_trial(MDP);

spm_figure('GetWin','Figure 2'); clf
spm_MDP_VB_LFP(MDP,[],1);


spm_figure('GetWin','Figure 1');

P  = squeeze(MDP.P);
P  = (1 - cumprod([1 P(3,1:end - 1)])).*P(1,:);
subplot(3,2,3), bar(P,'c')
xlabel('epoch'),ylabel('P(correct choice)')
title('Expected behaviour','FontSize',16)


a = (0:16)/128;                     % range of perceptual ambiguity
c = [1 2];                          % levels of reward
t = (2:T)/4;                        % time (250 ms bins)
for i = 1:numel(a)
    for j = 1:numel(c)
        
        for f1 = 1:Ns(1)                       % rule
            for f2 = 1:Ns(2)                   % report
                MDP.A{1}(1:2,f1,f2) = 1;
                MDP.A{1}(f1, f1,f2) = exp(a(i));
            end
        end
        
        MDP.C{2}(1,:) = C{2}(1,:)*c(j);       % wait
        MDP.C{2}(2,:) = C{2}(2,:)*c(j);       % right
