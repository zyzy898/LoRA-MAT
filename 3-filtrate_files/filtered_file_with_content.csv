        param = [param0(4) param0(2) 0  0 0];
    case 2
        param = [param0(4) param0(3) param0(2) 0 0];
    otherwise
        param = [param0(4) 0 0 param0(2) param0(3)];
    end
    param = [param param0(5:end)];
    [varargout{1:nargout}] = spm_diffeo('dartel',varargin{1},varargin{2:3},param);
