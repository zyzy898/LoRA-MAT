6364,demo_ssc_mc_omp.m,68.0,60,100.0,0,100.0,80.0,61-70,"close all; clear all; clc;

rng default;
rho = 1880/6;
M = 9;
K = 5;
D = 6;
Ds = D * ones(1, K);
bases = spx.data.synthetic.subspaces.random_subspaces(M, K, Ds);
Sk = rho * D;
cluster_sizes = Sk * ones(1, K);
S = sum(cluster_sizes);
