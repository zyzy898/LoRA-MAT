		fprintf(fid,'      </tr>\\n');
		fprintf(fid,'      <tr>\\n');
		fprintf(fid,'       <td class=""left"">\\n');
		fprintf(fid,'        Name\\n');
		fprintf(fid,'       </td>\\n');
		fprintf(fid,'       <td class=""right"">\\n');
		fprintf(fid,'        <div>%s</div>\\n',f.name{i});
		fprintf(fid,'       </td>\\n');
		fprintf(fid,'      </tr>\\n');
		if showInfo,
			fprintf(fid,'      <tr>\\n');
			fprintf(fid,'       <td class=""left"">\\n');
			fprintf(fid,'        Comments\\n');
