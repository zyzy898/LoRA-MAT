1373,deleteInactiveGenes.m,83.406,100,67.57,90,100.0,59.46,80-90,"function model = deleteInactiveGenes(model, trData, trDataPath, thApproach, lowerTh, upperTh, sheetIndex, growthNotAffectingGeneDel, percentile)      

    if percentile == 1        
