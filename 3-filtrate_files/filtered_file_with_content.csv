3152,conwaylaws.m,75.42,60,73.68,75,100.0,68.42,70-80,"function out = conwaylaws(nhood)


num_neighbors = sum(nhood(:)) - nhood(2, 2);
if nhood(2, 2) == 1
   if num_neighbors <= 1
      out = 0; % Pixel dies from isolation.
   elseif num_neighbors >= 4
      out = 0; % Pixel dies from overpopulation.
   else
      out = 1; % Pixel survives.
   end
else
   if num_neighbors == 3
      out = 1; % Birth pixel.
   else
      out = 0; % Pixel remains empty.
   end
end"
3153,cooccurToScalarFeatures.m,71.626,80,63.08,75,100.0,40.05,70-80,"function featureS = cooccurToScalarFeatures(cooccurM, flagS)

nL = size(cooccurM,1).^0.5;

levRowV = repmat(1:nL,[1 nL]);
levColV = repmat(1:nL,[nL 1]);
levColV = levColV(:)';

for n=0:nL-1
    indCtrst1V = 1:nL-n;
    indCtrst2V = 1+n:nL;
    indCtrstTmpV = indCtrst1V + (indCtrst2V-1)*nL;
    indCtrstTmpV = [indCtrstTmpV indCtrst2V + (indCtrst1V-1)*nL];
    indCtrstC{n+1} = unique(indCtrstTmpV); %apa new
       
    indPxC{n+1} = nL*n+1:nL*(n+1); %apa new
        
end
for n=1:2*nL
    indPxPlusYc{n} = find(levRowV + levColV == n); %apa new
end

if flagS.energy
    featureS.energy = sum(cooccurM.^2);
end
if flagS.jointEntropy
    featureS.jointEntropy = -sum(cooccurM.*log2(cooccurM+eps));
end
if flagS.jointMax
    featureS.jointMax = max(cooccurM,[],1);
end
if flagS.jointAvg
    featureS.jointAvg = sum(bsxfun(@times,cooccurM',levRowV),2)';
end
if flagS.jointVar
    xMinumMu = bsxfun(@minus,levRowV',featureS.jointAvg).^2;
    featureS.jointVar = sum(xMinumMu .* cooccurM,1);
end

numCooccurs = size(cooccurM,2);

featureS.contrast = zeros(1,numCooccurs);
featureS.invDiffMom = zeros(1,numCooccurs);
featureS.invDiffMomNorm = zeros(1,numCooccurs);
featureS.invDiff = zeros(1,numCooccurs);
featureS.invDiffNorm = zeros(1,numCooccurs);
featureS.invVar = zeros(1,numCooccurs);
featureS.dissimilarity = zeros(1,numCooccurs);
featureS.diffEntropy = zeros(1,numCooccurs);
featureS.diffVar = zeros(1,numCooccurs);
featureS.diffAvg = zeros(1,numCooccurs);
for n=0:nL-1
    px(n+1,:) = sum(cooccurM(indPxC{n+1},:),1);
    pXminusY(n+1,:) = sum(cooccurM(indCtrstC{n+1},:),1);
    if any(indCtrstC{n+1})
        pXminusYlogPXminusY(n+1,:) = ...
            pXminusY(n+1,:) .* log2(eps + pXminusY(n+1,:));
    else
        pXminusYlogPXminusY(n+1,:) = 0;
    end
    if flagS.diffAvg
        featureS.diffAvg = featureS.diffAvg + n*pXminusY(n+1,:);
    end   
    
    if flagS.contrast
        featureS.contrast = featureS.contrast + ...
            sum(n^2*cooccurM(indCtrstC{n+1},:));
    end
    if flagS.dissimilarity || flagS.diffVar
        featureS.dissimilarity = featureS.dissimilarity + ...
            sum(n*cooccurM(indCtrstC{n+1},:));
    end    
    if flagS.invDiffMoment
        featureS.invDiffMom = featureS.invDiffMom + ...
            sum((1/(1+n^2))*cooccurM(indCtrstC{n+1},:));
    end
    if flagS.invDiffMomNorm
        featureS.invDiffMomNorm = featureS.invDiffMomNorm + ...
            sum((1/(1+(n/nL)^2))*cooccurM(indCtrstC{n+1},:));      
    end
    if flagS.invDiff
        featureS.invDiff = featureS.invDiff + ...
            sum((1/(1+n))*cooccurM(indCtrstC{n+1},:));      
    end    
    if flagS.invDiffNorm
        featureS.invDiffNorm = featureS.invDiffNorm + ...
            sum((1/(1+n/nL))*cooccurM(indCtrstC{n+1},:));        
    end    
    if flagS.invVar && n > 0
        featureS.invVar = featureS.invVar + ...
            sum((1/n^2)*cooccurM(indCtrstC{n+1},:));
    end    
    if flagS.diffEntropy
        featureS.diffEntropy = featureS.diffEntropy - pXminusYlogPXminusY(n+1,:);
    end
    
end

for n=0:nL-1
    if flagS.diffVar
        featureS.diffVar = featureS.diffVar + (n - featureS.dissimilarity).^2 .* pXminusY(n+1,:) ;
    end    
end


featureS.sumAvg = zeros(1,numCooccurs);
featureS.sumVar = zeros(1,numCooccurs);
featureS.sumEntropy = zeros(1,numCooccurs);
for n=1:2*nL
    pXplusY(n,:) = sum(cooccurM(indPxPlusYc{n},:),1);
    if any(indPxPlusYc{n})
        pXplusYlogPXplusY(n,:) = ...
            pXplusY(n,:) .* log2(eps+pXplusY(n,:));
    else
        pXplusYlogPXplusY(n,:) = zeros(1,numCooccurs);
    end
    if flagS.sumAvg
        featureS.sumAvg = featureS.sumAvg + n*pXplusY(n,:);
    end
    if flagS.sumEntropy
        featureS.sumEntropy = featureS.sumEntropy - pXplusYlogPXplusY(n,:);
    end
end
for n=1:2*nL
    if flagS.sumVar
        featureS.sumVar = featureS.sumVar + (n-featureS.sumAvg).^2 .* pXplusY(n,:);
    end    
end

mu = (1:nL) * px;
sig = bsxfun(@minus,(1:nL)',mu);
sig = sum(sig .*sig .* px, 1);

if flagS.corr
    levIMinusMu = bsxfun(@minus,levRowV',mu);
    levJMinusMu = bsxfun(@minus,levColV',mu);
    featureS.corr = sum(levIMinusMu .* levJMinusMu  .* cooccurM, 1) ...
        ./ (sig + eps); % sig.^2 to match ITK results (ITK bug)
end

if flagS.clustTendency
    levIMinusMu = bsxfun(@minus,levRowV',mu);
    levJMinusMu = bsxfun(@minus,levColV',mu);
    clstrV = levIMinusMu + levJMinusMu;
    featureS.clustTendency = sum(clstrV.*clstrV .* cooccurM, 1);
else
    featureS.clustTendency = NaN;
end

if flagS.clustShade
    levIMinusMu = bsxfun(@minus,levRowV',mu);
    levJMinusMu = bsxfun(@minus,levColV',mu);
    clstrV = levIMinusMu + levJMinusMu;
    featureS.clustShade = sum(clstrV.*clstrV.*clstrV .* cooccurM, 1);
end
if flagS.clustProm
    levIMinusMu = bsxfun(@minus,levRowV',mu);
    levJMinusMu = bsxfun(@minus,levColV',mu);
    clstrV = levIMinusMu + levJMinusMu;
    featureS.clustPromin = sum(clstrV.*clstrV.*clstrV.*clstrV .* cooccurM, 1);
end

if flagS.haralickCorr
    muX = 1/nL;
    sigX = px - muX;
    sigX = sum(sigX .*sigX, 1)/(nL);
    
    
    featureS.haralickCorr = (levRowV .* levColV * cooccurM - ...
        muX .* muX) ./ (sigX + eps);   % (levRowV-1) .* (levColV-1) to match ITK? Bug?
    
end

if flagS.autoCorr
    featureS.autoCorr = sum(bsxfun(@times,cooccurM,levRowV' .* levColV'),1);    
else
    featureS.autoCorr = NaN;
end


if flagS.firstInfCorr
    HXY1 = -sum(cooccurM.*log2((px(levRowV,:)+eps)...
        .*(px(levColV,:)+eps)));
    HX = -sum(px.*log2(px+eps));
    featureS.firstInfCorr = (featureS.jointEntropy - HXY1) ./ HX;
end

if flagS.secondInfCorr
    HXY2 = -sum(px(levRowV,:).*px(levColV,:)...
        .*log2((px(levRowV,:)+eps).*(px(levColV,:)+eps)));
    featureS.secondInfCorr = 1 - exp(-2*(HXY2 - featureS.jointEntropy));
    indZerosV = featureS.secondInfCorr <= 0;
    featureS.secondInfCorr(indZerosV) = 0;
    featureS.secondInfCorr = sqrt(featureS.secondInfCorr);
end"
3154,coocurrance_alldir_mod.m,76.936,100,66.13,75,100.0,43.55,70-80,"function Ph=coocurrance_alldir(q)
dim=size(q);
if ndims(q) == 2
	dim(3) = 1;
end

q2 = reshape(q,1,prod(dim));
qs = unique(q2);
q3 = q2*0;

for k = 1:length(qs)
	q3(q2==qs(k)) = k;
end

q3 = reshape(q3,dim);

lqs=length(qs);
Ph=zeros(lqs);

maxq3 = max(q3(:));

similarity = nan(size(q3));

for i = 1:dim(1)
	for j = 1:dim(2)
		for k = 1:dim(3)
			val_q3 = q3(i,j,k);
			i_min = max(1,i-1);
			i_max = min(i+1,dim(1));
			j_min = max(1,j-1);
			j_max = min(j+1,dim(2));
			k_min = max(1,k-1);
			k_max = min(k+1,dim(3));
			
            V = (i_max-i_min+1)*(j_max-j_min+1)*(k_max-k_min+1);
			
			neighbor = q3(i_min:i_max,j_min:j_max,k_min:k_max);
			good_neighbor = neighbor(neighbor~=maxq3);
			
			if length(good_neighbor) > 0 && val_q3 ~= maxq3
				meanneighbor = mean(good_neighbor);
				similarity(i,j,k) = abs(meanneighbor-val_q3);
			end

			for I2 = i_min:i_max
				for J2 = j_min:j_max
					for K2 = k_min:k_max
						if I2 == i && J2 == j && K2 == k
							continue;
						else
							val_neighbor = q3(I2,J2,K2);
							Ph(val_q3,val_neighbor) = Ph(val_q3,val_neighbor) + 1;
						end
					end
				end
			end
		end
	end
end


mean(similarity(~isnan(similarity)));"
3155,cookie_cutter.m,75.666,100,80.95,45,100.0,52.38,70-80,"function [V,F] = cookie_cutter(P,E)
  function [V,O] = robust_overlap(S,E)
    sqr_len = mean(sum((S(E(:,1),:)-S(E(:,2),:)).^2,2));
    max_area = sqr_len/9;
    [V,F] = cdt(S,E,'TriangleFlags',sprintf('-qYY -a%g',max_area),'Quiet',true);
    w = winding_number(S,E,barycenter(V,F));
    F = F(w>0.5,:);
    [V,I] = remove_unreferenced(V,F);
    F = I(F);
    O = outline(F);
    [V,I] = remove_unreferenced(V,O);
    O = I(O);
    [V,~,I] = remove_duplicate_vertices(V,1e-3);
    O = I(O);
    O = O(O(:,1) ~= O(:,2),:);
    [~,I] = unique(sort(O,2),'rows');
    O = O(I,:);
    assert(size(unique(sort(O,2),'rows'),1) == size(O,1));
    [V,F] = triangle(V,O,[],'Flags','-YY','Quiet');
    w = abs(winding_number(V,O,barycenter(V,F)));
    F = F(w>0.5,:);
    O = outline(F);
    [V,I] = remove_unreferenced(V,O);
    O = I(O);
    assert(size(unique(sort(O,2),'rows'),1) == size(O,1));

  end

  offset = 0.5;
  [SI,SO,EI,EO] = offset_curve(P,offset);
  S = [SI;SO];
  E = [EI;size(SI,1)+EO];
  [S,E] = robust_overlap(S,E);

  k_offset = 2;
  [KI,KO,KEI,KEO] = offset_curve(P,k_offset);
  K = [KI;KO];
  KE = [KEI;size(KI,1)+KEO];
  [K,KE] = robust_overlap(K,KE);

  h = 15;
  th = 3;
  sth = 5;
  [CV,CF] = wedding_cake({K,S},{KE,E},[th,h]);

  tol = 0.8;
  [sP,~,sE,~] = offset_curve(P,offset+tol);
  sE = fliplr(sE);
  [sP,sE] = robust_overlap(sP,sE);
  c = mean(sP);
  assert(abs(winding_number(sP,sE,c))>0.5,'Uhoh, center for post fell outside curve. Too non-convex');
  r = min(pdist2(K,c));
  r = 0.9*r;
  r = min(r,4);
  theta = linspace(0,2*pi,100)';
  theta = theta(1:end-1);
  hP = bsxfun(@plus,c,r*[cos(theta) sin(theta)]);
  hE = [1:size(hP,1);2:size(hP,1) 1]';
  [SV,SF] = wedding_cake({sP,hP},{sE,hE},[sth,2*h]);

  F = [CF;size(CV,1)+SF];
  V = [bsxfun(@times,[-1 1 1],CV);bsxfun(@plus,[abs(max(CV(:,1))-min(CV(:,1)))*1.1 0 0],SV)];
end"
3156,cook_abhinav_transfers.m,71.548,80,66.92,60,100.0,50.82,70-80,"function [results] = cook_abhinav_transfers(models,grid,target_directory)

VOCinit;
VOCopts.testset = target_directory;

[cur_set, gt] = textread(sprintf(VOCopts.clsimgsetpath,...
                                 models{1}.cls,...
                                 target_directory),['%s' ...
                    ' %d']);
cur_set = cur_set(gt==1);

gridids = cellfun2(@(x)x.curid,grid);
goods = ismember(gridids,cur_set);
grid = grid(goods);

REMOVE_SELF = 1;

cls = models{1}.cls;

for i = 1:length(models)
  if ~isfield(models{i},'curid')
    models{i}.curid = '-1';
  end
end

for i = 25%1:length(grid)
  boxes = grid{i}.bboxes;
  
  boxes(:,5) = 1:size(boxes,1);
  
  [aa,bb] = sort(boxes(:,end),'descend');
  boxes = boxes(bb,:);
  boxes = nms_within_exemplars(boxes,.5);
  
  boxes = boxes(1:min(size(boxes,1),5),:);
  cboxes = grid{i}.coarse_boxes(boxes(:,5),:);

  
  Itest = im2double(imread(sprintf(VOCopts.imgpath, ...
                                   grid{i}.curid)));
  
  for j = 1:size(boxes,1)
    Itrain = im2double(imread(sprintf(VOCopts.imgpath, ...
                                      models{boxes(j,6)}.curid)));
    d = cboxes(j,1:4);
    c = models{boxes(j,6)}.model.coarse_box;
    g2 = boxes(j,1:4);
    g = models{boxes(j,6)}.gt_box;
    filer = sprintf('/nfs/baikal/tmalisie/trainxfers/transfers.%05d.%05d.mat',...
                    i,j);
    save(filer,'Itest','Itrain','d','c','g','g2');    
  end
  
end

keyboard

excurids = cellfun2(@(x)x.curid,models);
bboxes = cell(1,length(grid));
maxos = cell(1,length(grid));

if REMOVE_SELF == 0
  fprintf(1,'Warning: Not removing self-hits\\n');
end

fprintf(1,'Loading bboxes\\n');
for i = 1:length(grid)
  
  curid = grid{i}.curid;
  bboxes{i} = grid{i}.bboxes;
  
  if length(grid{i}.extras)>0
    grid{i}.extras.os(:,end+1) = 0;
    grid{i}.extras.cats{end+1} = models{1}.cls;
    curhits = find(ismember(grid{i}.extras.cats,{models{1}.cls}));
    maxos{i} = max(grid{i}.extras.os(:,curhits),[],2)';
  end

  if REMOVE_SELF == 1
    badex = find(ismember(excurids,curid));
    badones = ismember(bboxes{i}(:,6),badex);
    bboxes{i}(badones,:) = [];
    
    if length(maxos{i})>0
      maxos{i}(badones) = [];
    end
    
  end
end

fprintf(1,'Applying betas\\n');
if exist('betas','var')
  bboxes = cellfun2(@(x)calibrate_boxes(x,betas),bboxes);
end

keyboard
[bboxes] = mmht_scores(bboxes, maxos, models);
fprintf(1,'Applying NMS\\n');
bboxes = cellfun2(@(x)nms(x,.5),bboxes);

filer=sprintf(VOCopts.detrespath,'comp3',cls);
fprintf(1,'Writing File %s\\n',filer);
fid = fopen(filer,'w');
for i = 1:length(bboxes)
  curid = grid{i}.curid;
  for q = 1:size(bboxes{i},1)
    fprintf(fid,'%s %f %f %f %f %f\\n',curid,...
            bboxes{i}(q,end), bboxes{i}(q,1:4));
  end
end
fclose(fid);


figure(2)
clf
[recall,prec,ap,apold] = VOCevaldet(VOCopts,'comp3',cls,true);
axis([0 1 0 1]);
extra = '';
if ismember(models{1}.models_name,{'dalal'})
  extra='-dalal';
end

results.recall = recall;
results.prec = prec;
results.ap = ap;
results.apold = apold;
results.cls = models{1}.cls;

resfile = sprintf('%s/%s_%s_results.mat',VOCopts.resdir,...
                  models{1}.cls,target_directory');

fprintf(1,'Saving results to %s\\n',resfile);
save(resfile,'results');"
