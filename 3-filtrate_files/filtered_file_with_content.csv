6473,cstSlackPower.m,68.286,60,64.29,60,100.0,57.14,61-70,"function [c, ceq, cGrad, ceqGrad] = cstSlackPower(x,u)

dq = x(2,:);   %Velocity
f = u(1,:);  %Force
power = dq.*f;  % power = speed * force

s1 = u(2,:);
s2 = u(3,:);

c = [];
ceq = power - (s1-s2);

if nargout > 2   %Analytic gradients
    
    nTime = length(f);
    
    cGrad = [];
    
    ceqGrad = zeros(1,6,nTime); %6 = [time + angle + rate + torque + slack1 + slack 2];
    
    ceqGrad(1,3,:) = f; % derivative wrt rate
    ceqGrad(1,4,:) = dq; % derivative wrt force
    ceqGrad(1,5,:) = -1; % derivative wrt s1
    ceqGrad(1,6,:) = 1; % derivative wrt s2
    
end

end"
6474,comp_iwfac.m,67.788,100,60.61,45,100.0,33.33,61-70,"function [g]=comp_iwfac(gf,L,a,M)


R=prod(size(gf))/L;

N=L/a;
b=L/M;

c=gcd(a,M);
p=a/c;
q=M/c;
d=N/q;

gf=reshape(gf,p,q*R,c,d);

gf=gf/sqrt(M);


if d>1
  gf=ifft(gf,[],4);
end;

g=zeros(L,R,assert_classname(gf));

for w=0:R-1
  for s=0:d-1
    for l=0:q-1
      for k=0:p-1
	g((1:c)+mod(k*M-l*a+s*p*M,L),w+1)=reshape(gf(k+1,l+1+q*w,:,s+1),c,1);
      end;
    end;
  end;
end;"
