4864,dec2bin_logical.m,70.23,60,76.92,45,100.0,69.23,70-80,"function bin = dec2bin_logical(D,numBits)

  D = reshape(D,[],1);
  assert(all(D<2^numBits),'numBits not large enough');

  bin = false(numel(D),numBits);
  for i = numBits:-1:1
    m = 2^(i-1);
    bin(:,numBits-i+1) = D>=m;
    D = D-bin(:,numBits-i+1)*m;
  end

end"
4865,dec2flag.m,73.166,60,75.0,60,100.0,70.83,70-80,"function [arflag usflag] = dec2flag(value)
arflag = [];
usflag = [];
if nargin<1
        help dec2flag
        return
end
if isempty(value)
        error('value must be an integer number between 0 and 65535')
end
if ~isnumeric(value)
        error('value must be numeric')
end
if value<0
        error('value must be an integer number between 0 and 65535')
end
if value>65535
        error('value must be an integer number between 0 and 65535')
end
value = round(value);
binaryflag = fliplr(dec2bin(value, 16));
bitnum = strfind(binaryflag,'1');
arflag = bitnum(bitnum<9);
usflag = bitnum(bitnum>8)-8;"
