4494,cwt_fw.m,77.334,100,66.67,75,100.0,45.0,70-80,"function [Wx,as,dWx] = cwt_fw(x, type, nv, dt, opt)
    if nargin<5, opt = struct(); end
    if nargin<4, dt = 1; end

    if nargout>2,
        dout = 1;
    else
        dout = 0;
    end

    if ~isfield(opt, 'padtype'), opt.padtype = 'symmetric'; end
    if ~isfield(opt, 'rpadded'), opt.rpadded = 0; end

    x = x(:); % Turn into column vector
    n = length(x);

    [x,N,n1,n2] = padsignal(x, opt.padtype);

    noct = log2(N)-1;
    assert(noct > 0 && mod(noct,1) == 0);
    assert(nv>0 && mod(nv,1)==0); % integer
    assert(dt>0);
    assert(~any(isnan(x)));
    
    na = noct*nv;
    as = 2^(1/nv) .^ (1:1:na);
    
    Wx = zeros(na, N);
    
    if dout,
        dWx = Wx;
        opt.dt = dt;
    end
    
    x = x(:).';
    xh = fft(x);
    
    for ai = 1:na
        a = as(ai);
        
        if dout,
            [psih, dpsih] = wfilth(type, N, a, opt);
            dxcpsi = ifftshift(ifft(dpsih .* xh));
            dWx(ai, :) = dxcpsi;
        else
            psih = wfilth(type, N, a, opt);
        end
        xcpsi = ifftshift(ifft(psih .* xh));
        Wx(ai, :) = xcpsi;
    end

    if (~opt.rpadded)
        Wx = Wx(:, n1+1:n1+n);
        if dout,
            dWx = dWx(:, n1+1:n1+n);
        end
    end

    as = as * dt;
end % cwt_fw"
4495,cwt_iw.m,75.076,100,69.23,60,100.0,46.15,70-80,"function x = cwt_iw(Wx, type, opt)
    if nargin<3, opt = struct(); end

    [na, n] = size(Wx);

    [N,n1,n2] = p2up(n);
    Wxp = zeros(na, N);

    Wxp(:, n1+1:n1+n) = Wx;
    Wx = Wxp; clear Wxp;

    noct = log2(N)-1;
    nv = na/noct;
    as = 2^(1/nv) .^ (1:1:na);
    
    assert(mod(noct,1) == 0);
    assert(nv>0 && mod(nv,1)==0); % integer

    Cpsi = cwt_adm(type, opt);

    x = zeros(1, N);
    for ai=1:na
        a = as(ai);
        Wxa = Wx(ai, :);

        psih = wfilth(type, N, a, opt);

        Wxah = fft(Wxa);
        xah = Wxah .* psih;
        xa = ifftshift(ifft(xah));
        
        x = x + xa/a;
    end

     x = log(2^(1/nv))/Cpsi * real(x);

     x = x(n1+1: n1+n);

end % cwt_iw"
