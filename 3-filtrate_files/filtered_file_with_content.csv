5870,derotated_dtcwt.m,75.666,60,93.33,45,100.0,80.0,70-80,"function  h11=derotated_dtcwt(n,Yh)

h11{n}=Yh{n};
for k=n:-1:2
    for m=1:6
        xp=imresize(Yh{k}(:,:,m),2);%
        argxp=angle(xp);
        argx=angle(Yh{k-1}(:,:,m));
        argx=argx-2.*argxp;
        absx=abs(Yh{k-1}(:,:,m));
        xa=absx.*cos(argx);
        xb=absx.*sin(argx);
        h11{k-1}(:,:,m)=complex(xa,xb);
    end
end"
