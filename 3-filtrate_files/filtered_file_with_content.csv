Astar = cell(size(KA));
psistar = cell(size(KA));
stabtype = cell(size(KA));
rmax = 0; Amax = 0;
for n = 1:length(KA)
  [rstar{n},Astar{n},psistar{n},~,stabtype{n}] = ...
    rStarCoupled11Learn(a,b1,l,m1,KA(n),W,1);
  stabtype{n} = ceil(stabtype{n});
