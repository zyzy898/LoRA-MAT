4359,cutBlocks.m,77.44,100,60.98,75,100.0,51.22,70-80,"function decision = cutBlocks(structIn,cnst,currImName)
    blockIn = structIn.data;

    currSize = size(blockIn);
    if (currSize(1) == currSize(2)) % discard non-square blocks 
    
    bwIm = mean(blockIn,3); % black and white image
    if sum(sum(bwIm>=220))<(0.5*numel(bwIm))
             
    blockIn = imresize(blockIn,[cnst.finalBlockSize,cnst.finalBlockSize]);
    
    if cnst.verbose
    imshow(blockIn);
    drawnow
    end
    
    currDot = strfind(currImName,'.');
    currImName = currImName(1:(currDot(1)-1));
    
    if sum(sum(bwIm<=1))<(numel(bwIm))
        imwrite(blockIn,[cnst.outDir,currImName,'-blk-',randseq(12,'alphabet','amino'),'.png']);
        decision = 4; % code for success
    else
        warning('moving block to failures');
        imwrite(blockIn,[cnst.failDir,currImName,'-blk-',randseq(12,'alphabet','amino'),'.png']);
        decision = 1; % code for fail
    end
    else
        if cnst.verbose
        disp('discarding background block');
        end
        decision = 2; % code for background
    end
    else
        if cnst.verbose
        disp('discarding edge');
        end
        decision = 3; % code for edge
    end
    
end"
4360,cutBlocksNeural.m,78.93,100,67.86,75,100.0,51.79,70-80,"function decision = cutBlocksNeural(structIn,cnst,currImName,myNet,ref_image)
    blockIn = structIn.data;

    currSize = size(blockIn);
    if (currSize(1) == currSize(2)) % discard non-square blocks 

    bwIm = mean(blockIn,3); % black and white image
    if sum(sum(bwIm>=220))<(0.5*numel(bwIm))
             
    blockIn = imresize(blockIn,[cnst.finalBlockSize,cnst.finalBlockSize]);
    
    if cnst.verbose
    imshow(blockIn);
    drawnow
    end
    
    currDot = strfind(currImName,'.');
    currImName = currImName(1:(currDot(1)-1));
    
    if sum(sum(bwIm<=1))<(numel(bwIm)) % THIS IS A NON-BACKGROUND, NON-FAILED, NON-EDGE image       
        resizedIm = imresize(blockIn,[cnst.NeuralInputSize,cnst.NeuralInputSize]);
        [predLabel,predScore] = classify(myNet, resizedIm, ...
            'ExecutionEnvironment',cnst.ExecutionEnvironment);    
        [mm,mi] = max(predScore);
        disp(['tile predicted as ',char(predLabel), ' with confidence ',num2str(round(mm,2))]);
        if cnst.NormalizeOnTheFly
        blockIn = Norm(blockIn, ref_image, 'Macenko', 255, 0.15, 1, cnst.verbose);
        disp('normalization done');
        end
        
        if strcmp(char(predLabel),'TUMSTU') % this is a tumor tile
            imwrite(blockIn,[cnst.outDir,'blk-',randseq(12,'alphabet','amino'),'-',currImName,'.png']);
        else % this is a non-tumor tile
            imwrite(blockIn,[cnst.nonTuDir,'blk-',randseq(12,'alphabet','amino'),'-',currImName,'.png']);
        end
        decision = 4+mi; % code for success + tissue class
    else % this is a black (failed) image
        warning('moving block to failures');
        imwrite(blockIn,[cnst.failDir,currImName,'-blk-',randseq(12,'alphabet','amino'),'.png']);
        decision = 1; % code for fail 
        error('failed');
    end
    else
        if cnst.verbose
        disp('discarding background block');
        end
        decision = 2; % code for background
    end
    else
        if cnst.verbose
        disp('discarding edge');
        end
        decision = 3; % code for edge
    end
    
end"
4361,cutBlocksNeuralCascade.m,79.746,100,67.8,75,100.0,55.93,70-80,"function decision = cutBlocksNeuralCascade(structIn,cnst,currImName,myNet_level1,myNet_level2,ref_image)
    blockIn = structIn.data;

    currSize = size(blockIn);
    if (currSize(1) == currSize(2)) % discard non-square blocks 

    bwIm = mean(blockIn,3); % black and white image
    if sum(sum(bwIm>=220))<(0.5*numel(bwIm))
             
    blockIn = imresize(blockIn,[cnst.finalBlockSize,cnst.finalBlockSize]);
    
    if cnst.verbose
    imshow(blockIn);
    drawnow
    end
    
    currDot = strfind(currImName,'.');
    currImName = currImName(1:(currDot(1)-1));
    
    if sum(sum(bwIm<=1))<(numel(bwIm)) % THIS IS A NON-BACKGROUND, NON-FAILED, NON-EDGE image       
        resizedIm = imresize(blockIn,[cnst.NeuralInputSize,cnst.NeuralInputSize]);
        [predLabel,predScore] = classify(myNet_level1, resizedIm, ...
            'ExecutionEnvironment',cnst.ExecutionEnvironment);    
        [mm,mi] = max(predScore);
        disp(['tile predicted as ',char(predLabel), ' with confidence ',num2str(round(mm,2))]);

        
        if strcmp(char(predLabel),'TUMSTU') % this is a tumor tile
            disp('> starting level 2 classification');
              resizedIm = Norm(resizedIm, ref_image, 'Macenko', 255, 0.15, 1, 0);
            disp('> > normalization done');
             [predLabel2,predScore2] = classify(myNet_level2, resizedIm, ...
              'ExecutionEnvironment',cnst.ExecutionEnvironment);  
              [mm2,mi2] = max(predScore2);
              disp(['> > > level 2 predicted as ',char(predLabel2), ' with confidence ',num2str(round(mm2,2))]);
              decision = 100*predScore2(1);%
        else % this is a non-tumor tile
            disp('> non-tumor tile');
            decision = -mi;%
        end
    else % this is a black (failed) image
        warning('> failed tile!');
        decision = -100; % code for fail 
        error('failed');
    end
    else
        if cnst.verbose
        disp('discarding background block');
        end
        decision = 2; % code for background
    end
    else
        if cnst.verbose
        disp('discarding edge');
        end
        decision = 3; % code for edge
    end
    
end"
4362,CutDatFragment.m,73.358,80,61.29,75,100.0,50.5,70-80,"function CutDatFragment(fname,timeperiod,RenameOriginalsAsOrig)

if ~exist('RenameOriginalsAsOrig','var')
    RenameOriginalsAsOrig = 0;
end

if strcmp(fname(end-3:end),'.dat')
