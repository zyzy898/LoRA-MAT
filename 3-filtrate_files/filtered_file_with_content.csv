5264,DEMO_7_Order_vs_Accuracy_ODE_solve.m,72.72,100,80.23,45,100.0,38.37,70-80,"clear; clc;

orderRange = [2,200];
orderNum = 25;
orderList = unique(round(logspace(...
    log10(orderRange(1)),...
    log10(orderRange(2)),...
    orderNum)));  

tspan = [0,1];

N = length(orderList);
cpuTime = zeros(N,1);
maxError = zeros(N,2);
meanError = zeros(N,2);

Input.order = [];   %Fill in later
Input.tspan = tspan;
z0 = [0.25;0];
Input.z0 = z0;

P.m = 0.1;
P.c = 0.3;
P.k = 100;
userFunc = @(t,z)simpleHarmonicOscillator(z,P);
Input.userFunc = userFunc;


Options = odeset(...
    'RelTol',2.5e-14,...   %ode45 complains if reltol is much smaller
    'AbsTol',2.5e-14);
tic
sol = ode45(userFunc,tspan,z0,Options);
ode45_runTime = toc;

for i=1:N
    
    disp(['Order: ' num2str(orderList(i))])
    tic;
        Input.order = orderList(i);
        zSoln = chebyshevODEsolve(Input);
        f = zSoln(1,:);
        Df = zSoln(2,:);
    cpuTime(i) = toc;

    time = chebyshevPoints(orderList(i)+1,tspan);
    zOde45 = deval(sol,time);
    g = zOde45(1,:);
    Dg = zOde45(2,:);
    
    e = abs(g-f);
    De = abs(Dg-Df);
    maxError(i,:) = [max(e),max(De)];
    meanError(i,:) = [mean(e),mean(De)];
end

disp(['ODE45 run time: ' num2str(ode45_runTime)])


figure(406); clf;
subplot(3,2,1)
