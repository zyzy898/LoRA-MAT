tuwb_z = zeros(rowR,1);  % We don't have Z value in 2D

uwb_xyzPoints = [tuwb_x tuwb_y tuwb_z];
vicon_Points = [vX vY vZ];

ptCloud_uwb = pointCloud(uwb_xyzPoints);     
