1393,demo2chebgui.m,82.4,100,60.0,100,100.0,52.0,80-90,"function cg = demo2chebgui(demoPath)


fid = fopen(demoPath);

if ( fid == -1 )
    error('CHEBFUN:CHEBGUI:demo2chebgui:noload', ...
        'Unable to open demo file: %s.', demoPath)
end

inputEnded = 0;
while ( ~inputEnded )
    tline = fgetl(fid);

    if ( isempty(tline) || isempty(strfind(tline, '=')) || tline(1) == '#' )
        continue
    end

    if ( ~ischar(tline) )
        break
    end

    eval(tline);
    inputEnded = feof(fid);
end

fclose(fid);

if ( exist('t', 'var') )
    timedomain = t; %#ok<NASGU>
    clear t
end

clear inputEnded fid tline ans

vars = who;
cg = chebgui('type', 'bvp');
for k = 1:numel(vars)
    if ( strcmp(vars{k}, 'demoPath') )
        continue
    end
    try
        cg = set(cg, vars{k}, eval(vars{k}));
    catch ME %#ok<NASGU>
        warning('CHEBFUN:CHEBGUI:loaddemos:unknown',...
            [vars{k} ' is an unknown CHEBGUI property. Ignoring.']);
    end
end

end"
1394,DemoAnnotatedData.m,81.714,100,67.14,90,100.0,51.43,80-90,"clear; clc; close all;

