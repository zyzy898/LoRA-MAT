1362,del2map.m,83.278,100,67.21,100,100.0,49.18,80-90,"function [ laplac, sumLaplac2D ] = del2map( map, filename, draw )

if nargin < 2
	help del2map;
	return;
end

if size(map,2) > 1
    if size(map,1) > 1
        for index = 1:size(map,2)
            laplac(:,index) = del2map( map(:,index), filename);
        end
        return;
    else
        map = map';
    end
end

MAXCHANS = size(map,1);
GRID_SCALE = 2*MAXCHANS+5;

if ischar( filename ) || isstruct( filename )
    [tmp lb Th Rd] = readlocs(filename);
	Th = pi/180*Th;                               % convert degrees to rads
	[x,y] = pol2cart(Th,Rd);
else
	x = real(filename);
	y = imag(filename);		
    if exist('draw') == 1 && draw ~= 0
        line( [(x-0.01)' (x+0.01)']', [(y-0.01)' (y+0.01)']');
        line( [(x+0.01)' (x-0.01)']', [(y-0.01)' (y+0.01)']');
    end
end;	

xi = linspace(-0.5,0.5,GRID_SCALE);   % x-axis description (row vector)
yi = linspace(-0.5,0.5,GRID_SCALE);   % y-axis description (row vector)
for i=1:MAXCHANS
   [useless_var horizidx(i)] = min(abs(x(i) - xi));    % find pointers to electrode
   [useless_var vertidx(i)] = min(abs(y(i) - yi));     % positions in Zi
end
   
sumLaplac2D = zeros(GRID_SCALE, GRID_SCALE);
for i=1:size(map,2) 
   	[Xi,Yi,Zi] = griddata(y,x,map(:,i),yi',xi, 'v4');   % interpolate data
   	laplac2D = del2(Zi);
	positions = horizidx + (vertidx-1)*GRID_SCALE;

	laplac(:,i) = laplac2D(positions(:));
	sumLaplac2D = sumLaplac2D + laplac2D;

	if exist('draw') == 1 && draw ~= 0
		if size(map,2) > 1
			subplot(ceil(sqrt(size(map,2))), ceil(sqrt(size(map,2))), i);
		end
		plot(y, x, 'x', 'Color', 'black', 'markersize', 5); hold on
		contour(Xi, Yi, laplac2D); hold off;
		title( int2str(i) );
	end
end;                                                             %

return;"
1363,delaunayize.m,84.47,100,78.82,100,100.0,43.53,80-90,"function [V,F] = delaunayize(V,F,varargin)

  tol= 1e-7;
  vis = false;
  keep_E = zeros(0,2);
  split_edges_flag = false;
  max_dihedral_angle = inf;
  params_to_variables = containers.Map( ...
    {'Tol','Visualize','Keep','SplitEdges','MaxDihedralAngle'}, ...
    {'tol','vis','keep_E','split_edges_flag','max_dihedral_angle'});
  v = 1;
  while v <= numel(varargin)
    param_name = varargin{v};
    if isKey(params_to_variables,param_name)
      assert(v+1<=numel(varargin));
      v = v+1;
      feval(@()assignin('caller',params_to_variables(param_name),varargin{v}));
    else
      error('Unsupported parameter: %s',varargin{v});
    end
    v=v+1;
  end

  while true
    if vis
      tsurf(F,V);
      drawnow;
    end
    switch size(V,2)
    case 3
      [D,allE]= is_intrinsic_delaunay(V,F,'Tol',eps,'BoundaryDefault',false);
    case 2
      D = is_extrinsic_delaunay(V,F,'Tol',eps);
      allE = [F(:,[2 3]);F(:,[3 1]);F(:,[1 2])];
    end
    [~,B] = on_boundary(F);
    K = reshape(ismember(sort(allE,2),keep_E,'rows'),[],3);
    if isinf(max_dihedral_angle)
      C = false(size(D));
    else
      [A,G] = adjacency_dihedral_angle_matrix(V,F);
      [AI,AJ,AV] = find(A);
      [GI,GJ,GV] = find(G);
      assert(isequal(AI,GI));
      assert(isequal(AJ,GJ));
      C = full(sparse(GI,GV,abs(AV-pi),size(F,1),size(F,2)))>max_dihedral_angle;
    end
    D = D | K;
    D = D | B;
    D = D | C;
    NDE = allE(~D,:);
    NDuE = unique(sort(NDE,2),'rows');
    NDuKB = [];
    if split_edges_flag
      DKB = D & (K | B);
      NDKB = allE(~DKB,:);
      NDuKB = unique(sort(NDKB,2),'rows');
      if vis
        hold on;
        plot_edges(V,NDuKB,'LineWidth',4);
        hold off;
        input('');
      end
      [V,F] = split_edges(V,F,NDuKB);
    end
    if ~isempty(NDuE)
      Vvis = [];
      if vis
        Vvis = V;
      end
      Fprev = F;
      F = flip_edges(Fprev,NDuE,'AllowNonManifold',false,'V',Vvis);
      degen = sum(F(:,1)==F(:,2) | F(:,2)==F(:,3) | F(:,3)==F(:,1));
      if degen>0
        warning('flip_edges.m created degenerate %d facets. Reverting...',degen);
        Fprev = F;
      end
      if all(F(:) == Fprev(:))
        break;
      end
    elseif isempty(NDuKB)
      break;
    end
  end
end"
1364,DelaunaySO3.m,81.214,100,54.55,100,100.0,51.52,80-90,"classdef (InferiorClasses = {?rotation,?quaternion}) DelaunaySO3 < orientation
  properties
        
    tetra          % list of vertices of the tetrahegons
    tetraNeighbour % neigbouring tetraeders orderd as faces
    lookup         % lookup table orientation -> tetrahedrons
                       
  end
    
  methods
    
    function DSO3 = DelaunaySO3(varargin)
      
      DSO3 = DSO3@orientation(varargin{:});
    
      if nargin == 0, return; end
      
      [DSO3.a,DSO3.b,DSO3.c,DSO3.d] = double(perturbe(DSO3,0.05*degree));
      
      DSO3.tetra = calcDelaunay2(DSO3);
     
      DSO3.tetraNeighbour = calcNeighbour(DSO3.tetra);
      
      res = 40*degree;
      for i = 1:4
        res = res / 2;
        DSO3.lookup = calcLookUp(DSO3,res);
      end
    end
          
end

end"
1365,DelayDMDc_MV.m,85.0,100,80.0,90,100.0,55.0,80-90,"function [sysmodel_DMDc,U,Up] = DelayDMDc_MV(Hx,Hu,r1,r2,dt,numOutputs,numInputs,numVar,X,Xp)
stackmax = size(Hx,1);
stackmax = stackmax/numVar;

if nargin < 10
    X = Hx(:,1:end-1);
    Xp = Hx(:,2:end);
end
Nt = size(X,2);
Gamma = Hu(:,1:Nt);
Omega = [X; Gamma];
[U,S,V] = svd(Omega,'econ'); 
idx = find(diag(S)<1e-10,1,'first'); 
if isempty(idx)==1
    r1 = size(S,1);
else 
    r1 = idx-1;
end
U = U(:,1:r1);S = S(1:r1,1:r1);V = V(:,1:r1);
G = Xp*V*S^(-1)*U';
[Up,Sp,Vp] = svd(Xp,'econ'); 
idx = find(diag(Sp)<1e-10,1,'first'); 
if isempty(idx)==1
    r2 = size(Sp,1);
else 
    r2 = idx-1;
end
Up = Up(:,1:r2);
Ar = G(:,1:stackmax*numVar);
Br = G(:,stackmax*numVar+1:end);
Cr = zeros(numVar,stackmax*numVar); 
if numVar*stackmax == numOutputs
    Cr = eye(numVar*stackmax);
else
    for i = 1:numVar
        Cr(i,i*stackmax) = 1; % 2017-02-21
    end
end

sysmodel_DMDc = ss(Ar,Br,Cr,zeros(numOutputs,numInputs),dt);"
1366,DelaySum_Beamformer_fast.m,82.324,100,80.65,60,100.0,70.97,80-90,"function [xout] = DelaySum_Beamformer_fast(sig,tde_est)
nChs = size(sig,2);

lfft = 1024; %32ms window size for beamforming
ShiftP = 0.25;
Wsz = lfft;
INC = Wsz*ShiftP;
W = hann(Wsz);
pre_emph=0.925;
sig=filter([1 -pre_emph],1,sig);
for ich = 1:nChs
    Seg_ch(:,ich,:) = enframe(sig(:,ich),W, INC).';
end
fft_Seg_ch = fft(Seg_ch,lfft);
mi = 1:lfft;


mi = mi(:);
for ich = 1:nChs
    EV(:,ich) = exp(-1i*2*pi*mi./lfft*tde_est(ich));
end
mat_EV = repmat(EV,[1 1 size(fft_Seg_ch,3)]);
mat_Y = conj(mat_EV).*fft_Seg_ch;

outY = reshape(sum(mat_Y,2),size(fft_Seg_ch,1), size(fft_Seg_ch,3));

xoutnow = ifft(outY);
xoutnow = xoutnow.';
xout = overlapadd(xoutnow,W,INC);
xout = real(xout);
xout=filter(1,[1 -pre_emph],xout);"
1367,delaytime.m,83.652,100,71.74,90,100.0,56.52,80-90,"function rs = delaytime(s, maxdelay, past)


narginchk(3,3);

if ndim(s) ~= 1
	help(mfilename)
	return
end


ITERATIONS = 64;


len = dlens(s, 1)-maxdelay;
x = data(s);
[y, index] = sort(x(1:len));

err = zeros(maxdelay+1, 1);

for i=1:ITERATIONS
	while(1)
		ref = ceil(rand(1,1)*len);
		actual = index(ref);
    	pre = index(find(abs(index(1:ref-1)-actual) > past));
		post = index(find(abs(index(ref+1:end)-actual) > past));
		if ~isempty(pre) & ~isempty(post)
			pre = pre(end);
			post = post(end);		
			break
		end
	end

	errpre = abs(x(pre:pre+maxdelay)-x(actual:actual+maxdelay));
	errpost = abs(x(post:post+maxdelay)-x(actual:actual+maxdelay));
	err = err + errpre  + errpost;
end
 
rs = signal(core(err/ITERATIONS), s);	% special constructor calling syntax for working routines
a = getaxis(s, 1); 
dl = delta(a);
a = setfirst(a, 0);
rs = setaxis(rs, 1, a);
rs = setyunit(rs, unit);		% acf values are scalars without unit
rs = addhistory(rs, 'Delaytime plot');
rs = addcommandlines(rs, 's = delaytime(s', maxdelay, past);"
1368,delay_detect.m,80.306,100,71.43,75,100.0,55.1,80-90,"function L = delay_detect(sig,delay_N,th)
if nargin<=2
    th = 0;
end
sig = abs(sig);                                                             %幅度信号
for jdx = 1:size(sig,2)

    abs_sig = abs(sig(:,jdx));
    
    delay1 = [zeros(delay_N*1,1);abs_sig;zeros(delay_N*3,1)];
    delay2 = [zeros(delay_N*2,1);abs_sig;zeros(delay_N*2,1)];
    delay3 = [zeros(delay_N*3,1);abs_sig;zeros(delay_N*1,1)];
    
    delta = 1/3;
    th3 = [delay1 delay2 delay3].*delta;
    th2 = max(th3,[],2);
    L1 = (abs_sig > th2(delay_N*2+1:end - delay_N*2)) & (abs_sig > th);
    
    cnt = 0;
    for idx = 1:length(L1)
        if L1(idx,:) == 1
            cnt = cnt + 1 ;
        else
            cnt = 0;
        end
        if cnt > 50
            L2(idx,:) = 1;
        else
            L2(idx,:) = 0;
        end
    end
    index = findhead(L2,[0 1]);
    for ndx = 1:length(index)
        L2(index(ndx)-49:index(ndx),:) = 1;
    end
    L(:,jdx) = L2(:);
end
end

function index = findhead(data,target)
data = data(:);
target = target(:);
N = length(target);
for idx = 1:N
    L(:,idx) = circshift(data == target(idx),1-idx);
end
L = sum(L,2);
index = find(L == N);
end"
1369,delay_embed.m,81.334,100,66.67,90,100.0,50.0,80-90,"function [z ,t] = delay_embed(x,tau,D,T)

[N ,Tall, Ntrial] = size(x);

if D < 2, 
	z = x;
	t = (1:Tall);
	return
end;

Tdelay = tau*(D-1);

if ~exist('T','var')
	T = Tall - Tdelay;
elseif Tall < (T + Tdelay),
	T = Tall - Tdelay;
	fprintf('Number of data is smaller than %d\\n', (T + Tdelay))
end


indxT = (1:T) + Tdelay;
indxD = 0:tau:Tdelay;
indx  = repmat( -indxD(:),[1 T]) + repmat(indxT,[D 1]);
indx  = indx(:);

z = x(:, indx, :);
z = reshape( z, [N*D T Ntrial]);
t = indxT;

return


ix = 1:N;
t  = 1:T;

z  = zeros(N*D,T);

for n=1:D,
  z(ix, :) = x(:,t);
  ix = ix + N;
  t  = t  + tau;
end;"
1370,delay_guess.m,81.034,100,80.65,60,100.0,64.52,80-90,"function delay = delay_guess(y, a, nb_lags, varargin)

import misc.globals;
import misc.process_varargin;

THIS_OPTIONS = {'verbose', 'maxnbchans'};
maxnbchans =  min(ceil((globals.evaluate.NbChans4DelayCorr/100)*size(y,1)),...
    ceil((globals.evaluate.NbChans4DelayCorr/100)*size(a,1)));
verbose = globals.evaluate.Verbose;
eval(process_varargin(THIS_OPTIONS, varargin));

nb_idx = min([size(y,1), max(1,maxnbchans), size(a,1)]);
idx = randperm(min(size(y,1),size(a,1)));
idx = idx(1:nb_idx);

c = zeros(1, 2*nb_lags+1);
for i = 1:nb_idx
    
    w1 = zeros(1, size(y,1));
    w2 = zeros(1, size(a,1));
    w1(idx(i)) = 1;
    w2(idx(i)) = 1;
    [this_c, lags] = xcorr(w1*y, w2*a, nb_lags);
    c = c + this_c;
    if verbose,
        fprintf('.');
    end
    
end
[~, max_lag] = max(abs(c));
delay = lags(max_lag);"
