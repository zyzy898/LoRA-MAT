3175,coordinateTransformation.m,75.0,100,61.54,75,100.0,38.46,70-80,"function y = CoordinateTransformation(u,c,x)

if ~isvector(u) || numel(u)~=3
    error('First input argument must be a vector of dimension 3.');
end

if numel(x)~=numel(c)
    error('Dimensions of rotation angle vector and rotation coordinate vector mismatch');
end
if any(c<0)||any(c>3)
    error('Error in axis definition for transformation direction.');
end

if isrow(u)
    u=u';
    changedimension=1;
else
    changedimension=0;
end

for i=1:numel(c)
    if c(i)==1
        u = [1 0 0;0 cos(x(i)) sin(x(i));0 -sin(x(i)) cos(x(i))]*u;
    end
    if c(i)==2
        u = [cos(x(i)) 0 -sin(x(i));0 1 0;sin(x(i)) 0 cos(x(i))]*u;
    end
    if c(i)==3
        u = [cos(x(i)) sin(x(i)) 0;-sin(x(i)) cos(x(i)) 0;0 0 1]*u;
    end
end

if changedimension==1
    y=u';
else
    y=u;
end

end"
3176,coordinate_constraint.m,71.332,60,93.33,30,100.0,73.33,70-80,"function [Alp,blp] = coordinate_constraint(V,C)

  n = size(V,1);
  d = size(C,2);
  assert(d == size(V,2));
  c = size(C,1);
  AlpI = reshape(repmat(1:n,c,1),n*c,1);
  AlpJ = reshape(bsxfun(@plus,repmat((1:c)-1,n,1)*n,(1:n)')',n*c,1);
  AlpI = reshape(bsxfun(@plus,AlpI,((1:d)-1)*n),n*c*d,1);
  AlpJ = repmat(AlpJ(:),d,1);
  AlpV = reshape(repmat(C,n,1),n*c*d,1);
  Alp = sparse(AlpI(:),AlpJ(:),AlpV(:),n*d,c*n);
  blp = V(:);

end"
