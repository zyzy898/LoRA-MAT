3636,createFactors.m,76.88,100,84.85,45,100.0,54.55,70-80,"function Fac = createFactors(Opt)



numFactors = Opt.map.numFrames*(2 + Opt.correct.nUpdates + Opt.init.nbrInits(2)) + Opt.init.nbrInits(1);

