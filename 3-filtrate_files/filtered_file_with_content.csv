for j = 1:length(lambda_list)
    for jj = 1:length(recon_files)
        if strfind(recon_files(jj).name, ['t_', lambda_list{j}])
            image = h5read(fullfile(recon_files(jj).folder, recon_files(jj).name),'/recon');
            image_array(:,:,:,j) = image./max(image(:));
