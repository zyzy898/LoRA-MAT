                lb = [u0_ref(1,k)*0.95];
            end
        elseif u0_ref(1,k)<0 && u0_ref(1,k+1)<0
            if u0_ref(1,k)>u0_ref(1,k+1)
                ub = [u0_ref(1,k)*0.95];
                lb = [u0_ref(1,k+1)*1.05];
            else
                ub = [u0_ref(1,k+1)*0.95];
                lb = [u0_ref(1,k)*1.05];
            end
        end
    else
        if u0_ref(1,k) >=0
            ub = [u0_ref(1,k)*1.05];
            lb = [u0_ref(1,k)*0.95];
        else
            ub = [u0_ref(1,k)*0.95];
            lb = [u0_ref(1,k)*1.05];
        end
        
    end

    if u0_ref(2,k)>0 %
        ub  = [ub, u0_ref(2,k)*1.1,  10]; 
        lb  = [lb, 0, -10];         
    else
        ub  = [ub, 0,  10]; 
        lb  = [lb, u0_ref(2,k)*1.1, -10];
    end


end"
