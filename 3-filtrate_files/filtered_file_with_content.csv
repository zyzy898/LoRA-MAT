legend(hl,{'BC x support','BC y support','BC z support','BC z prescribe'});

axisGeom(gca,fontSize);
camlight headlight; 
drawnow; 


R=euler2DCM([0,-alphaFib,0]);
e1=(R*[1 0 0]')';
e1_dir=e1(ones(size(E,1),1),:);
[e2_dir,e3_dir]=vectorOrthogonalPair(e1_dir);

[VE]=patchCentre(E,V);


hf=cFigure;
