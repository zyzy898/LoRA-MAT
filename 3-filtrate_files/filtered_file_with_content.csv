5857,DeriveVexityFromInflection.m,75.186,60,66.67,90,100.0,59.26,70-80,"function vexity = DeriveVexityFromInflection(properties,xL,xU)

if isa(properties.inflection,'function_handle')
    data = properties.inflection(xL,xU);
    if isempty(data)
        vexity = 'none';
        return
    end
    data = [data inf];	
else
    data = properties.inflection;
    data = [data inf];    
end
convex = [data(2:2:end-1)];
points = data(1:2:end);
vexity = 'none';
for k = 1:length(points)-1
    if xL >= points(k) && xU <= points(k+1)        
        if convex(k) == 1
            vexity = 'convex';
            return
        else
            vexity = 'concave';
            return
        end
    end
end"
5858,Derive_pwPoly5.m,72.666,100,80.0,30,100.0,53.33,70-80,"clc; clear;

n = 5;  %order of bezier curve
p = sym('p',[n+1,1]); assume(p,'real');

syms t 'real'

x = sym(0);
for i=0:n
    tt = (t.^i).*(1-t).^(n-i);
    binom = nchoosek(n,i);
    x = x + binom*p(i+1)*tt;
end

dx = diff(x,t);
ddx = diff(dx,t);

X0 = simplify(subs(x,t,0));
dX0 = simplify(subs(dx,t,0));
ddX0 = simplify(subs(ddx,t,0));
X1 = simplify(subs(x,t,1));
dX1 = simplify(subs(dx,t,1));
ddX1 = simplify(subs(ddx,t,1));

syms x0 dx0 ddx0 x1 dx1 ddx1 'real'

eqns = [...
    X0-x0;
    dX0-dx0;
    ddX0-ddx0;
    X1-x1;
    dX1-dx1;
    ddX1-ddx1];
    
[A,b] = equationsToMatrix(eqns,p);
pSoln = A\\b;

xSoln = simplify(subs(x,p,pSoln));
dxSoln = simplify(subs(dx,p,pSoln));
ddxSoln = simplify(subs(ddx,p,pSoln));

matlabFunction(xSoln, dxSoln, ddxSoln,...
    'file','autoGen_pwPoly5.m',...
    'vars',{t,x0 dx0 ddx0 x1 dx1 ddx1},...
    'outputs',{'x','dx','ddx'});"
