1230,db_combine_channel.m,82.0,100,68.75,90,100.0,51.25,80-90,"function [isNewFile, Message] = db_combine_channel( iSrcStudies, iDestStudy, UserConfirm, NoWarning )



isNewFile = 0;
Message = [];
if (nargin < 4) || isempty(NoWarning)
    NoWarning = 0;
end
if (nargin < 3) || isempty(UserConfirm)
    UserConfirm = 1;
end
if (length(iDestStudy) > 1)
    error('Destination study must be unique.');    
end
if isempty(iDestStudy) || isequal(iSrcStudies, iDestStudy)
    return
end
ProtocolInfo = bst_get('ProtocolInfo');
ChannelMats = {};

for i = 1:length(iSrcStudies)
    iStudy = iSrcStudies(i);
    sStudy = bst_get('Study', iStudy);
    if isempty(sStudy.Channel) % || strcmpi(sStudy.Name, bst_get('DirAnalysisIntra'))
        continue;
    end
    ChannelFile = bst_fullfile(ProtocolInfo.STUDIES, sStudy.Channel.FileName);
    ChannelMats{end + 1} = in_bst_channel(ChannelFile);
end

if isempty(ChannelMats)
    return
end
    
[MeanChannelMat, Message] = channel_average(ChannelMats);
if isempty(MeanChannelMat) 
    if ~NoWarning
        bst_error(Message, 'Combine channel files', 0);
    end
    return;
end


sDestStudy = bst_get('Study', iDestStudy);
if ~isempty(sDestStudy.Channel)
    oldChannelMat = in_bst_channel(sDestStudy.Channel.FileName);
    allLocOld  = [oldChannelMat.Channel.Loc];
    allLocMean = [MeanChannelMat.Channel.Loc];
    allOrientOld  = [oldChannelMat.Channel.Orient];
    allOrientMean = [MeanChannelMat.Channel.Orient];
    if isempty(allLocOld)
        allLocOld = [0;0;0];
    end
    if isempty(allLocMean)
        allLocMean = [0;0;0];
    end
    if isempty(allOrientOld)
        allOrientOld = [0;0;0];
    end
    if isempty(allOrientMean)
        allOrientMean = [0;0;0];
    end
    if isequal({oldChannelMat.Channel.Type}, {MeanChannelMat.Channel.Type}) && ...
       isequal({oldChannelMat.Channel.Name}, {MeanChannelMat.Channel.Name}) && ...
       (numel(allLocOld) == numel(allLocMean)) && (max(abs(allLocOld(:) - allLocMean(:))) < .001) && ...
       (numel(allOrientOld) == numel(allOrientMean)) && (max(abs(allOrientOld(:) - allOrientMean(:))) < .001) && ...
       isequal(oldChannelMat.Projector, MeanChannelMat.Projector)
        return
    end
end

if UserConfirm
    ChannelReplace = 1;  % Ask user confirmation
else
    ChannelReplace = 2;  % Do not ask user confirmation
end
ChannelAlign = 0;
ChannelFile = db_set_channel(iDestStudy, MeanChannelMat, ChannelReplace, ChannelAlign);
isNewFile = ~isempty(ChannelFile);"
1231,db_delete_protocol.m,85.714,100,72.86,100,100.0,55.71,80-90,"function isRemoved = db_delete_protocol(isUserConfirm, isRemoveFiles)


global GlobalData;


if (nargin < 2)
    error('Invalid call to db_delete_protocol().');
end
sProtocolsListInfo     = GlobalData.DataBase.ProtocolInfo;
sProtocolsListSubjects = GlobalData.DataBase.ProtocolSubjects;
sProtocolsListStudies  = GlobalData.DataBase.ProtocolStudies;
iProtocol              = GlobalData.DataBase.iProtocol;
if isempty(sProtocolsListInfo) || isempty(iProtocol)
    disp('BST> No protocol selected, nothing to delete.');
    return;
end


if isUserConfirm
    if ~isRemoveFiles
        strWarn = '(Subjects and datasets directories will not be deleted)';
    else
        strWarn = ['<BR><FONT color=""#CC0000""><U>WARNING</U>: All the files will be permanently deleted from your hard drive.<BR>' ...
                   bst_fileparts(sProtocolsListInfo(iProtocol).STUDIES) '</FONT>'];
    end
    isConfirmed = java_dialog('confirm', ['<HTML>Remove protocol ''' sProtocolsListInfo(iProtocol).Comment ''' from Brainstorm database ? <BR>' ...
                                          strWarn '<BR><BR>'], sprintf('Remove protocol #%d', iProtocol));
    if ~isConfirmed
        isRemoved = 0;
        return
    end
end

if isRemoveFiles
    bst_progress('start', 'Delete Protocol', 'Removing all files...');
    file_delete( {sProtocolsListInfo(iProtocol).STUDIES, sProtocolsListInfo(iProtocol).SUBJECTS}, 1, 2);
    ProtocolDir = bst_fileparts(sProtocolsListInfo(iProtocol).STUDIES);
    listFiles = dir(fullfile(ProtocolDir, '*'));
    listFiles = setdiff({listFiles.name}, {'..','.'});
    if isempty(listFiles)
        rmdir(ProtocolDir);
    else
        warning(['Protocol folder is not empty, cannot be deleted:' ProtocolDir]);
    end
end
    
bst_progress('start', 'Delete Protocol', 'Removing protocol...');
sProtocolsListInfo(iProtocol)     = [];
sProtocolsListSubjects(iProtocol) = [];
sProtocolsListStudies(iProtocol)  = [];
GlobalData.DataBase.ProtocolInfo      = sProtocolsListInfo;
GlobalData.DataBase.ProtocolSubjects  = sProtocolsListSubjects;
GlobalData.DataBase.ProtocolStudies   = sProtocolsListStudies;
GlobalData.DataBase.isProtocolLoaded(iProtocol)   = [];
GlobalData.DataBase.isProtocolModified(iProtocol) = [];
gui_brainstorm('UpdateProtocolsList');

if isempty(sProtocolsListInfo)
    iProtocol = 0;
elseif (iProtocol == 1)
    iProtocol = 1;
else
    iProtocol = iProtocol - 1;
end
gui_brainstorm('SetCurrentProtocol', iProtocol);

isRemoved = 1;

bst_progress('stop');"
1232,db_group_conditions.m,82.978,80,70.97,100,100.0,63.92,80-90,"function db_group_conditions( ConditionsPaths, newConditionName )


ProtocolInfo = bst_get('ProtocolInfo');
oldConditionName = '';
if (nargin < 2) || isempty(newConditionName)
    newConditionName = java_dialog('input', 'New condition name', 'Group condition', [], oldConditionName);
    if isempty(newConditionName) || strcmpi(newConditionName, oldConditionName)
        return;
    end
end

sStudies = [];
iStudies = [];
for i = 1:length(ConditionsPaths)
    [sStudiesTmp, iStudiesTmp] = bst_get('StudyWithCondition', ConditionsPaths{i});
    sStudies = [sStudies, sStudiesTmp];
    iStudies = [iStudies, iStudiesTmp];
    if any(~cellfun(@isempty, {sStudiesTmp.Result.DataFile})) || any(~cellfun(@isempty, {sStudiesTmp.Timefreq.DataFile})) 
        bst_error('Cannot group conditions that contain links or nested files.', 'Group conditions', 0);
        return;
    end
end
if isempty(sStudies)
    return
end
uniqueSubjectFiles = unique({sStudies.BrainStormSubject});

sAllDestStudies     = [];
iStudiesNotToDelete = [];
iStudiesToDelete    = [];
bst_progress('start', 'Moving files...', 'Group conditions', 0, length(iStudies));
for iSubj = 1:length(uniqueSubjectFiles)
    iCondStudies = find(file_compare({sStudies.BrainStormSubject}, uniqueSubjectFiles{iSubj}));
    if (length(iCondStudies) <= 1)
        warning('Only one condition for this subject... cannot group.');
        continue
    end   
    
    sSubject = bst_get('Subject', uniqueSubjectFiles{iSubj}, 1);
    iDestStudy = db_add_condition(sSubject.Name, newConditionName, 0);
    if isempty(iDestStudy)
        bst_progress('stop');
        return
    end
    sDestStudy = bst_get('Study', iDestStudy);
    sAllDestStudies     = [sAllDestStudies, sDestStudy]; 
    iStudiesNotToDelete = [iStudiesNotToDelete, iDestStudy];
    iStudiesToDelete    = [iStudiesToDelete, iStudies(iCondStudies)];
    
    if (sSubject.UseDefaultChannel == 0)
        disp('BST> Group conditions: Applying process_megreg to the data before proceeding, this will most likely alter the recordings.');
        allDataFiles = {};
        for iStud = 1:length(iCondStudies)
            allDataFiles = cat(2, allDataFiles, {sStudies(iCondStudies(iStud)).Data.FileName});
        end
        bst_process('CallProcess', 'process_megreg', allDataFiles, [], 'targetchan', 1, 'sharechan', 2, 'progressbar', 0);
    end

    isChanCopied = 0;
    oldCondPath = {};
    badDataFiles = {};
    for iStud = 1:length(iCondStudies)
        bst_progress('inc', 1);
        sStudy = sStudies(iCondStudies(iStud));
        oldCondPath{iStud} = [sSubject.Name '/' sStudy.Condition{1}];
        if ~isempty(sDestStudy.Channel) && ~isempty(sDestStudy.Channel.FileName)
            isChanCopied = 1;
        end
        db_rename_condition( oldCondPath{iStud}, [sSubject.Name '/' newConditionName], 0, 0 );
        dirStudy = bst_fullfile(ProtocolInfo.STUDIES, bst_fileparts(sStudy.FileName));
        studyFiles = dir(dirStudy);
        iNonTrial = 1;
        badDataFiles = [badDataFiles, {sStudy.Data(find([sStudy.Data.BadTrial])).FileName}];
        for iFile = 1:length(studyFiles)
            if studyFiles(iFile).isdir
                continue;
            end
            fileType = file_gettype(studyFiles(iFile).name);
            if strcmpi(fileType, 'channel')
                if ~isChanCopied
                    isChanCopied = 1;
                else
                    continue;
                end
            end
            if any(strcmpi(fileType, {'brainstormstudy', 'link'}))
                continue;
            end
            switch (fileType)
                case 'data'
                    destFilename = sprintf('data_%s_%03d.mat', sStudy.Condition{1}, iNonTrial);
                    iNonTrial = iNonTrial + 1;
                otherwise
                    destFilename = strrep(studyFiles(iFile).name, '_trial', '_');
            end
            destFilename = file_unique(bst_fullfile(ProtocolInfo.STUDIES, bst_fileparts(sDestStudy.FileName), destFilename));
            srcFilename = bst_fullfile(dirStudy, studyFiles(iFile).name);
            file_move(srcFilename, destFilename);
            iBadDataFile = find(ismember(badDataFiles, file_short(srcFilename)));
            if ~isempty(iBadDataFile)
                badDataFiles{iBadDataFile} = file_short(destFilename);
            end
        end
    end
end

iStudiesToDelete = setdiff(iStudiesToDelete, iStudiesNotToDelete);
db_delete_studies(iStudiesToDelete);
bst_progress('stop');

panel_protocols('UpdateTree');
iAllDestStudies = [];
for i = 1:length(sAllDestStudies)
    [tmp__, iStudy] = bst_get('Study', sAllDestStudies(i).FileName);
    iAllDestStudies = [iAllDestStudies, iStudy];
end
if isempty(iAllDestStudies)
    return
end
db_reload_studies(iAllDestStudies);
process_detectbad('SetTrialStatus', badDataFiles, 1);
panel_protocols('UpdateNode', 'Study', iAllDestStudies);
db_save();"
