2343,compute_fuchs_criterion.m,75.428,60,85.71,60,100.0,71.43,70-80,"function [f,i,si] = compute_fuchs_criterion(D,x)


if size(x,2)>1 && size(x,1)>1    
    for k=1:size(x,2)
        [f(k),i(k),si(k)] = compute_fuchs_criterion(D,x(:,k));
    end
    return;
end

x = double( sign(x(:)) );
S1=find(abs(x)>0);
S2=find(x==0);
D1 = D(:,S1);
warning off;
D1 = (D1'*D1)^(-1) * D1';
warning on;
d0 = D(:,S2)' * D1' * x(S1);
[f,i] = max( abs( d0 ) );
si = sign(d0(i));
i = S2(i);"
