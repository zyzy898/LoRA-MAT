title('sum of squared error (hidden states)','FontSize',16)
axis square"
5715,DEM_demo_fMRI_HMM.m,72.768,80,67.98,75,100.0,40.86,70-80,"function DEM_demo_fMRI_HMM




rng('default')

P  = 2;                               % number of sessions (e.g., subjects)
S  = 3;                               % number of latent (hidden) states
N  = 9;                               % number of epochs or windows
T  = 128;                             % number of observations (per epoch)
TR = 2;                               % repetition time or timing
t  = (1:(T*N))*TR;                    % observation times (seconds)
n  = 3;                               % number of regions or nodes

options.nonlinear  = 0;
options.two_state  = 0;
options.stochastic = 0;
options.induced    = 1;

a   = ones(n,n);
b   = zeros(n,n,0);
c   = zeros(n,n);
d   = zeros(n,n,0);
pP  = spm_dcm_fmri_priors(a,b,c,d,options);

pP.A = [  0  -.3    0;
         .4    0  -.1;
          0   .3    0];
pP.C = eye(n,n);
pP.transit = randn(n,1)/64;

[Gu,Gn,Hz,dt] = spm_csd_fmri_gu(pP,TR);
Gu    = Gu(:,1,1)*ones(1,n);
Gn    = Gn(:,1,1)*ones(1,n);



B        = zeros(n,n,S);
B(1,1,1) = 1/2;
B(2,2,2) = 1/2;
B(3,3,3) = 1/2;
pP.B     = any(B,3);                     % state-dependent connections

bb    = spm_speye(S,S,-1); bb(1,S) = 1;
o     = kron(ones(1,N),1:S);
o     = o(1:N);

for i = 1:N
    tB(:,:,i) = B(:,:,o(i));
end
for i = 1:S
    for j = 1:S
        tB(i,j,:) = tB(i,j,:) - mean(tB(i,j,:));
    end
end

M.x   = sparse(n,5);
M.f   = 'spm_fx_fmri';
X     = cell(N,1);
Y     = cell(N,1);
E     = cell(N,1);
u     = cell(N,1);
for p = 1:P
    
    gu    = spm_rand_power_law(Gu,Hz,dt,N*T);
    ge    = spm_rand_power_law(Gn,Hz,dt,N*T);
    for s = 1:N
        
        tP   = pP;
        tP.A = tP.A + tB(:,:,s);
        tP.A = tP.A.*(1 + randn(n,n)/64);
        tP.C = eye(n,n);
        
        j    = (1:T) + (s - 1)*T;
        M.f  = 'spm_fx_fmri';
        U.u  = gu(j,:);
        U.dt = TR;
        x    = spm_int_J(tP,M,U);
        M.x  = spm_unvec(x(end,:),M.x);
        
        for i = 1:T
            y(i,:) = spm_gx_fmri(spm_unvec(x(i,:),M.x),[],tP)';
        end
        
        e       = ge(j,:);
        X{s}    = x;
        Y{s}    = y + e;
        E{s}    = e;
        u{s}    = U.u;
        TP(s,p) = tP;
        
    end
    
    
    xY.dt = TR;
    xY.y  = spm_cat(Y);
    xY.u  = spm_cat(u);
    xY.X  = spm_cat(X);
    xY.E  = spm_cat(E);
    
    DCM{1,p}.options = options;
    DCM{1,p}.a = logical(pP.A);
    DCM{1,p}.b = logical(pP.B);
    DCM{1,p}.c = zeros(n,0);
    DCM{1,p}.d = zeros(n,n,0);
    DCM{1,p}.Y = xY;
    
end

spm_figure('Getwin','Figure 1'); clf

subplot(3,2,1), plot(t,xY.u)
title('Endogenous fluctuations','FontSize',16)
xlabel('Time (seconds)'), ylabel('Amplitude'), axis square, spm_axis tight

subplot(3,2,2), hold off
plot(t,xY.X(:,(n + 1):end),'c'), hold on
plot(t,xY.X(:,1:n)),             hold off
title('Hidden states','FontSize',16)
xlabel('Time (seconds)'), ylabel('Amplitude'), axis square, spm_axis tight

subplot(3,2,3)
plot(t,xY.y,t,xY.E,':')
title('Hemodynamic response and noise','FontSize',16)
xlabel('Time (seconds)'), ylabel('Amplitude'), axis square, spm_axis tight




for i = 1:4
    b{i} = ones(i,i)/16;
end

[HMM,CSD] = spm_dcm_HMM(DCM,N,b);




spm_figure('Getwin','Figure 1');

subplot(3,2,3), hold on
for i = 1:N, plot(t,CSD{i,end}.W - 1), end, hold off

subplot(3,2,4)
spm_plot_ci(CSD{end}.Ep,CSD{end}.Cp), hold on
bar(TP(end).A(:),1/4), hold off, axis square
title('True and MAP connections (Deterministic)','FontSize',16)

for i = 1:numel(CSD)
    tp(i,:) = spm_vec(TP(i).A);
    qp(i,:) = spm_vec(CSD{i}.Ep.A);
    pp(i,:) = spm_vec(HMM(S).Ep{i}.A);
end
subplot(3,3,7); imagesc(tp)
title('True connections','FontSize',16), axis square
subplot(3,3,8); imagesc(qp)
title('MAP estimates',   'FontSize',16), axis square
subplot(3,3,9); imagesc(pp)
title('PEB estimates',   'FontSize',16), axis square

spm_dcm_HMM_plot(HMM,S)


x     = sparse(o,1:N,1,S,N);
x     = kron(ones(1,P),x);
N     = size(x,2);

r     = x*HMM(S).X';
j     = zeros(S,1);
for i = 1:S
    [d,m]  = max(r(:,i));
    j(i)   = m;
    r(m,:) = 0;
end
[o,i] = find(x(j,:));
B     = B(:,:,j);
bb    = bb(j,j);

spm_figure('Getwin','HMM')

subplot(4,1,1), hold on
for i = 1:N, plot(i,o(i),'.c','MarkerSize',32), end, hold off

subplot(4,1,2), hold on
for i = 1:N
    [j,k] = max(spm_vec(TP(i).A - pP.A));
    plot(i,k,'.c','MarkerSize',32)
end, hold off

subplot(4,1,3), hold on
for i = 1:N, pA(:,i) = spm_vec(TP(i).A); end
plot(1:N,pA(HMM(S).iP,:),'-.'), hold off, spm_axis tight

subplot(4,2,7), hold on
for i = 1:S
    c     = spm_vec(B(:,:,i));
    [j,k] = max(c(HMM(S).iP));
    plot(i,k,'.c','MarkerSize',32)
end, hold off

subplot(4,2,8), hold on
for i = 1:S, [j,k] = max(bb(:,i)); plot(i,k,'.c','MarkerSize',32), end
hold off


hmm0 = HMM(S);

hmm1 = spm_dcm_HMM(CSD(:,1),b(S));
hmm2 = spm_dcm_HMM(CSD(:,2),b(S));

F    = [hmm0.F; hmm1.F + hmm2.F];
F    = F - min(F);

spm_figure('Getwin','HMM-F')
subplot(2,2,3)
bar(F,'c'),  title('Group difference','FontSize',16)
xlabel('Effect'), ylabel('Log evidence'), axis square
set(gca,'XTickLabel',{'None','Effect'})

subplot(4,2,6)
bar(hmm1.qP),  title('Group 1','FontSize',16)
xlabel('Parameter'), ylabel('Connectivity (log)'), axis square
subplot(4,2,8)
bar(hmm2.qP),  title('Group 2','FontSize',16)
xlabel('Parameter'), ylabel('Connectivity (log)'), axis square

return"
5716,DEM_demo_fMRI_PEB.m,74.406,80,66.67,75,100.0,50.36,70-80,"function DEM_demo_fMRI_PEB
 
 
 
 
rng('default')
 
T  = 256*8;                           % number of observations (scans)
TR = 2;                               % repetition time or timing
t  = (1:T)*TR;                        % observation times
n  = 3;                               % number of regions or nodes
 
options.nonlinear  = 0;
options.two_state  = 0;
options.stochastic = 0;
options.centre     = 1;
options.induced    = 1;
 
A   = ones(n,n);
B   = zeros(n,n,0);
C   = zeros(n,n);
D   = zeros(n,n,0);
pP  = spm_dcm_fmri_priors(A,B,C,D,options);
 
 
pP.A = [  0  -.2    0;
         .2    0  -.1
          0   .3    0];
pP.C = eye(n,n);
pP.transit = randn(n,1)/16;
 
[Gu,Gn,Hz,dt] = spm_csd_fmri_gu(pP,TR);
Gu            = Gu(:,1,1)*ones(1,n);
Gn            = Gn(:,1,1)*ones(1,n);
 
 
X    = exp(-(0:2))';                    % between session decay
B    = [  1    0    0;                  % of intrinsic connections
          0    1    0
          0    0   -1];
X    = X - mean(X);                     % detrended session-effects
 
 
for s = 1:numel(X)
    
    P    = pP;
    P.A  = P.A + B*X(s);
    
    M.f  = 'spm_fx_fmri';
    M.x  = sparse(n,5);
    U.u  = spm_rand_power_law(Gu,Hz,dt,T);
    U.dt = TR;
    x    = spm_int_J(P,M,U);
    
    for i = 1:T
        y(i,:) = spm_gx_fmri(spm_unvec(x(i,:),M.x),[],P)';
    end
    
    e       = spm_rand_power_law(Gn,Hz,dt,T);
    Y(s).y  = y + e;
    Y(s).dt = TR;
    PP(s)   = P;
    
end
 
 
i = 1:128;
spm_figure('Getwin','Figure 1'); clf
subplot(2,2,1)
plot(t(i),U.u(i,:))
title('Endogenous fluctuations','FontSize',16)
xlabel('Time (seconds)')
ylabel('Amplitude')
axis square
 
subplot(2,2,2), hold off
plot(t(i),x(i,n + 1:end),'c'), hold on
plot(t(i),x(i,1:n)), hold off
title('Hidden states','FontSize',16)
xlabel('Time (seconds)')
ylabel('Amplitude')
axis square
 
subplot(2,2,3)
plot(t(i),y(i,:),t(i),e(i,:),':')
title('Hemodynamic response and noise','FontSize',16)
xlabel('Time (seconds)')
ylabel('Amplitude')
axis square
 
 
dcm.options = options;
 
dcm.a    = logical(pP.A);
dcm.b    = zeros(n,n,1);
dcm.c    = zeros(n,1);
dcm.d    = zeros(n,n,0);
 
for s = 1:numel(X)
    DCM{s,1}   = dcm;
    DCM{s,1}.Y = Y(s);
end
 
CSD = spm_dcm_peb_fit(DCM);
 
spm_figure('Getwin','Figure 1');
 
j  = 1:n^2;
d  = 3;
subplot(2,2,4); hold off
spm_plot_ci(CSD{d}.Ep.A(:),CSD{d}.Cp(j,j)), hold on
bar(PP(d).A(:),1/4), hold off
title('True and MAP connections (Deterministic)','FontSize',16)
axis square
 
 
clear M;
beta  = 32;
 
M.X   = [X.^0 X];                  % between session explanatory variables
M.hE  = 0;                         % prior expectation of log precision
M.hC  = 1/16;                      % prior covariance of precision
M.bE  = CSD{1}.M.pE;               % prior expectations over sessions
M.bC  = CSD{1}.M.pC;               % prior covariance over sessions
M.pC  = CSD{1}.M.pC/beta;          % prior covariance between sessions
 
field = {'A','a'};                 % parameters of interest
PEB   = spm_dcm_peb(CSD,M,field);  % empirical Bayesian inversion
BMA   = spm_dcm_peb_bmc(PEB);      % Bayesian model reduction and averaging
 
j     = spm_find_pC(CSD{1},'A');
p     = spm_vec(B); p = p(j);
subplot(3,2,4), hold on, bar(p,1/4), hold off
 
return"
5717,DEM_demo_GF_and_KF.m,74.026,80,54.86,90,100.0,45.27,70-80,"function DEM_demo_GF_and_KF
 
 
 
 
n       = 8;                  % number of hidden states
m       = 4;                  % number of observations
P.f     = full(toeplitz(sparse([1 2],1,[-2 1],n,1)));
P.g     = spm_dctmtx(m,n);    % Jacobian and observer matrices
 
              
N        = 128;               % length of sequence
t        = 1:N;               % time
M(1).E.s = 1;                 % smoothness of fluctuations
M(1).E.n = 4;                 % order of generalised coordinates
M(1).E.K = exp(-1);           % rate of generalized gradient descent
M(1).E.linear = 1; 
 
M(1).f   = inline('P.f*x','x','v','P');
M(1).g   = inline('P.g*x','x','v','P');
M(1).x   = zeros(n,1);
M(1).pE  = P;
M(1).V   = exp(4);            % precision of observation noise
M(1).W   = exp(2);            % precision of fluctuations on hidden states
 
   
DEM      = spm_DEM_generate(M,N);
 
 
DEM     = spm_DEM(DEM);
[EKF S] = spm_ekf(DEM.M,DEM.Y);
  
 
spm_figure('Getwin','Figure 1');
 
MSE(1,:) = mean((DEM.pU.x{1} - DEM.qU.x{1}).^2);
MSE(2,:) = mean((DEM.pU.x{1} - EKF).^2);
 
for i = 1:N
    E         = DEM.pU.x{1}(:,i) - DEM.qU.x{1}(:,i);
    NEES(1,i) = E'*spm_inv(DEM.qU.S{i})*E;
    E         = DEM.pU.x{1}(:,i) - EKF(:,i);
    NEES(2,i) = E'*spm_inv(S{i})*E;
end
 

subplot(2,2,1)
plot(t,MSE)
title('MSE','Fontsize',16)
xlabel('time','Fontsize',12)
ylabel('mean square error','Fontsize',12)
axis square
legend('DEM','EKF')
 
subplot(2,2,2)
plot(t,NEES)
title('NEES','Fontsize',16)
xlabel('time','Fontsize',12)
ylabel('normalised error','Fontsize',12)
axis square
legend('DEM','EKF')
drawnow
 
spm_figure('Getwin','Figure 2');
subplot(2,1,1)
plot(t,DEM.pU.x{1}(1,:),t,DEM.qU.x{1}(1,:),t,EKF(1,:))
title('First hidden state','Fontsize',16)
xlabel('time','Fontsize',12)
axis square
legend('true','DEM','EKF')
drawnow
 
 
N     = 64;                         % length of sequence
for i = 1:4
    
    M(1).E.linear = 1;
    M(1).g  = inline('P.g*x','x','v','P');
    DEM     = spm_DEM_generate(M,N);
    DEM     = spm_DEM(DEM);
    EKF     = spm_ekf(DEM.M,DEM.Y);
    
    mse(i,1) = mean(mean((DEM.pU.x{1} - DEM.qU.x{1}).^2));
    mse(i,2) = mean(mean((DEM.pU.x{1} - EKF).^2));
    
    M(1).E.linear = 0;
    M(1).g  = inline('tanh(P.g*x)','x','v','P');
    DEM     = spm_DEM_generate(M,N);
    DEM     = spm_DEM(DEM);
    EKF     = spm_ekf(DEM.M,DEM.Y);
    
    mse(i,3) = mean(mean((DEM.pU.x{1} - DEM.qU.x{1}).^2));
    mse(i,4) = mean(mean((DEM.pU.x{1} - EKF).^2));
        
end
 

spm_figure('Getwin','DEM');
spm_DEM_qU(DEM.qU,DEM.pU)


spm_figure('Getwin','Figure 1');
 
subplot(2,2,3)
plot(1:N,DEM.pU.x{1}(1,:),1:N,DEM.qU.x{1}(1,:),1:N,EKF(1,:))
title('First hidden state','Fontsize',16)
xlabel('time','Fontsize',12)
axis square
legend('true','DEM','EKF')
 
 
subplot(2,2,4)
plot([1 2],mse(:,[1 2]),'k.:','MarkerSize',16), hold on
plot([3 4],mse(:,[3 4]),'r.:','MarkerSize',16), hold off
title('linear (black) and nonlinear (red)','Fontsize',16)
set(gca,'XTick',[1 2 3 4],'Xlim',[0 5],'XTickLabel',{'DEM','EKF','DEMn','EKFn'})
ylabel('mean square error','Fontsize',12)
axis square


return

M(1).E.linear = 1;
M(1).g        = inline('P.g*x','x','v','P');
DEM           = spm_DEM_generate(M,N);

K     = -8:1/2:4;
for i = 1:length(K)
    
    DEM.M(1).E.K = exp(K(i));
    DEM          = spm_DEM(DEM);
    
    kse(i,1) = mean(mean((DEM.pU.x{1} - DEM.qU.x{1}).^2));
    
end

spm_DEM_qU(DEM.qU,DEM.pU)
 
spm_figure('Getwin','Figure 2');
subplot(2,1,2)
plot(K,log(kse))
title('log(MSE)','Fontsize',16)
xlabel('log(K)','Fontsize',12)
axis square"
5718,DEM_demo_hdm.m,79.856,100,75.71,75,100.0,48.57,70-80,"function DEM_demo_hdm

load HDM
global dt

G(1).E.linear = 1;
dt            = Y.dt;
T             = 1:128;

[pE pC] = spm_hdm_priors(3,1);
G(1).x  = [0 0 0 0]';
G(1).g  = 'spm_gx_hdm';
G(1).f  = 'spm_fx_hdm';
