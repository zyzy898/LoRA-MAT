        thissite = 'manly';
    elseif ~isempty(strfind(lower(user),'Jady Swinkels'))
        thissite = 'blacksmiths';
          elseif ~isempty(strfind(lower(user),'Jake Cosgrove'))
        thissite = 'stockton2';
    end
    
    
    startcell = ['A' num2str(lastrow)];
    imtype = 'Snap'; %Assume it is a snap
    filename = files(i).name;
