        end
    end
    
    if ~secondDeriv
        p = [0.037659  0.249153  0.426375  0.249153  0.037659];
        d1 =[0.109604  0.276691  0.000000 -0.276691 -0.109604];
    else         
        p  = [0.030320  0.249724  0.439911  0.249724  0.030320];
