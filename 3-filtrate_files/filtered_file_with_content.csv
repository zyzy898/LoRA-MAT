    end
    
	roomhyp(i).box = boxpoly;
end

function ptedge = extend_to_imageedge(pt, vp, whichside, imgwidth, imgheight)
pt = pt(:)';
vp = vp(:)';

dir = pt - vp;
if     strcmp(whichside, 'up'),    if sign(dir(2))==1,  dir = -dir; end
elseif strcmp(whichside, 'down'),  if sign(dir(2))==-1, dir = -dir; end
elseif strcmp(whichside, 'left'),  if sign(dir(1))==1,  dir = -dir; end
elseif strcmp(whichside, 'right'), if sign(dir(1))==-1, dir = -dir; end
end

alpha(1) = (1 - pt(2)) / dir(2);
intp{1} = pt + alpha(1)*dir;
intp{1}(2) = 1; % numerical precision issues....

alpha(2) = (imgheight - pt(2)) / dir(2);
intp{2} = pt + alpha(2)*dir;
intp{2}(2) = imgheight; % numerical precision issues....

alpha(3) = (1 - pt(1)) / dir(1);
intp{3} = pt + alpha(3)*dir;
intp{3}(1) = 1; % numerical precision issues....

alpha(4) = (imgwidth - pt(1)) / dir(1);
intp{4} = pt + alpha(4)*dir;
intp{4}(1) = imgwidth; % numerical precision issues....

b(1) = alpha(1)>0 && is_in_image(intp{1}, imgwidth, imgheight);
b(2) = alpha(2)>0 && is_in_image(intp{2}, imgwidth, imgheight);
b(3) = alpha(3)>0 && is_in_image(intp{3}, imgwidth, imgheight);
b(4) = alpha(4)>0 && is_in_image(intp{4}, imgwidth, imgheight);

b = find(b);
if length(b)==0
    ptedge = [];
elseif length(b)==1
    ptedge = intp{b};
else
    error('aosjfoiajeoijfoeaijfoewjfe');
end"
2291,compute_butterfly_neighbors.m,75.666,60,80.0,75,100.0,63.33,70-80,"function [e,v,g] = compute_butterfly_neighbors(k, nj)


global vring e2f fring facej;

vr = vring{k};
I = find(vr<=nj); 
e = vr(I);
f = [e2f(e(1),e(2)) e2f(e(2),e(1))];
f(f==-1) = f(3 - find(f==-1));

if nargout>1
    F1 = mysetdiff(fring{f(1)}, f(2));
    F2 = mysetdiff(fring{f(2)}, f(1));
    F1 = [F1 repmat(f(1), 1, 3-length(F1))];
    F2 = [F2 repmat(f(2), 1, 3-length(F2))];
    v = [ mysetdiff( facej(:,f(1)), e )   mysetdiff( facej(:,f(2)), e ) ];
    if nargout>2
        d = [v, e];
        g = [setdiff( facej(:,F1(1)),d ), ...
            mysetdiff( facej(:,F1(2)),d ), ...
            mysetdiff( facej(:,F2(1)),d ), ...
            mysetdiff( facej(:,F2(2)),d ) ];
    end
end

function a = mysetdiff(a,b)
for s=b
    a(a==s) = [];
end"
2292,compute_B_primary.m,72.334,60,70.0,75,100.0,56.67,70-80,"function [Bp] = compute_B_primary(coils, dipoles, projections)

if size(coils,2)~=3
  error('Column size of coils must be 3.')
end

if size(dipoles,2)~=6
  error('Column size of dipoles must be 6.')
end

if size(projections,2)~=3
  error('Column size of projections must be 3.')
end


dip_pos = dipoles(:,1:3);
dip_mom = dipoles(:,4:6);
Bp = zeros(size(coils,1), size(dipoles,1));
for i = 1:size(coils,1)
  for j = 1 : size(dip_pos,1)
    R = coils(i,:);
    R_0 = dip_pos(j,:);
    A = R - R_0;
    a = norm(A);
    aa = A./(a^3);
    
    BpHelp = cross(dip_mom(j,:),aa);
    Bp(i,j) = BpHelp * projections(i, :)'; % projection of the primary B-field along the coil orientations
  end
end"
