4265,cubic_flat_eval.m,79.0,60,91.67,60,100.0,83.33,70-80,"function [P,T] = cubic_flat_eval(C,tol)
  if cubic_is_flat(C,tol)
    P = C([1 4],:);
    T = [0;1];
  else
    [C1,C2] = cubic_split(C,0.5);
    [P1,T1] = cubic_flat_eval(C1,tol);
    [P2,T2] = cubic_flat_eval(C2,tol);
