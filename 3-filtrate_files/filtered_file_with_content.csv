2753,constrainedLSEq.m,79.642,100,73.21,75,100.0,50.0,70-80,"function [x,z]=constrainedLSEq(A,b,B,d,algorithm)

if(nargin<5||isempty(algorithm))
    algorithm=0;
end

switch(algorithm)
    case 0%Algorithm 6.2.2 in Chapter 6.2.3 of [1].
        [~,n1]=size(A);
        [m2,~]=size(B);

        [Q,R]=qr(B');
        opts.UT=false;
        opts.LT=true;
        opts.RECT=false;
        y=linsolve(R(1:m2,1:m2)',d,opts);

        A=A*Q;
        z=linearLeastSquares(A(:,(m2+1):n1),b-A(:,1:m2)*y);
        x=Q(:,1:m2)*y+Q(:,(m2+1):n1)*z;
    case 1%From Chapter 14 of [2].
        m=size(A,2);
        p=size(B,1);
        H=A'*A;
        c=A'*b;
        xz=[H,B';
            B,zeros(p,p)]\\[c;d];

        x=xz(1:m);
        z=xz((m+1):end); %The Lagrangian multipliers.
    case 2%The GSVD approach of Chapter 6.2.5 of [1].
        [~,n1]=size(A);
        [m2,~]=size(B);

        [U1,U2,X,DA,DB]=gsvd(A,B);
        bTilde=U1'*b;
        dTilde=U2'*d;

        X=inv(X');

        alphaVals=diag(DA);
        betaVals=diag(DB);

        x=zeros(n1,1);
        for i=1:m2
            x=x+(dTilde(i)/betaVals(i))*X(:,i);
        end

        for i=(m2+1):n1
            x=x+(bTilde(i)/alphaVals(i))*X(:,i);
        end
        z=[];
    otherwise
        error('Unknown algorithm specified.')
end
end"
2754,constrainedLSLineSpher.m,74.964,100,68.52,60,100.0,46.3,70-80,"function [x,t,intersects]=constrainedLSLineSpher(a,b,alphaVal)

if(nargin<3||isempty(alphaVal))
    alphaVal=1; 
end

if(all(b==0))
    normA=norm(a);
    intersects=normA==1;
    
    x=sqrt(alphaVal)*(a/normA);
    t=0;%t does not matter.
    return; 
end

xDim=size(a,1);

aMag2=dot(a,a);
bMag2=dot(b,b);
ab=dot(a,b);
t=roots([bMag2,2*ab,aMag2-alphaVal]).';
if(~isempty(t)&&isreal(t))
    numSol=length(t);
    x=zeros(xDim,numSol);
    
    for curSol=1:numSol
       x(:,curSol)=a+b*t(curSol);
       x(:,curSol)=sqrt(alphaVal)*(x(:,curSol)/norm(x(:,curSol)));
    end
    intersects=true;
    return;
end

intersects=false;
t=-ab/bMag2;

magVal=norm(a-b*(ab/bMag2))/sqrt(alphaVal);
lambda=zeros(2,1);
lambda(1)=-1+magVal;
lambda(2)=-1-magVal;

x=zeros(xDim,2);
for k=1:2
    x(:,k)=(1/(1+lambda(k)))*a-(1/(bMag2*(1+lambda(k))))*ab*b;
end

linePt=a+b*t;

if(norm(linePt-x(:,1))<norm(linePt-x(:,2)))
    x=x(:,1); 
else
    x=x(:,2);
end
end"
2755,constrainedLSSpher.m,73.866,100,67.57,45,100.0,56.76,70-80,"function [x,lambda,exitFlag]=constrainedLSSpher(A,b,alpha,varargin)

if(nargin<4)
    varargin{1}=[];
end

if(nargin<3||isempty(alpha))
    alpha=1;
end

r=rank(A);

[U,Sigma,V]=svd(A,0);
sigma=diag(Sigma);

U=U(:,1:r);
V=V(:,1:r);
sigma=sigma(1:r);

bTilde=U'*b;
x=V*(bTilde./sigma);

if(norm(x)>alpha)
    upperBound=2*max((abs(bTilde.*sigma)*sqrt(r)-alpha*sigma.^2)./alpha);
    f=@(lambda)objFun(lambda,alpha,bTilde,sigma);
    [lambda,~,exitFlag]=fzero(f,[0,upperBound],varargin{:});
    x=V*((sigma.*bTilde)./(sigma.^2+lambda));
else
    lambda=0;
    exitFlag=0;
end
end

function val=objFun(lambda,alpha,bTilde,sigma)

    val=sum(((sigma.*bTilde)./(sigma.^2+lambda)).^2)-alpha^2;
end"
2756,constrained_foopsi_cvx.m,77.486,100,75.76,45,100.0,66.67,70-80,"function [c, s] = constrained_foopsi_cvx(y, g, sn, solver)





evalin('base', 'install_cvx=true; oasis_setup;');  

y = reshape(y, [], 1);
T = length(y);
if ~exist('g', 'var') || isempty(g);   g = estimate_time_constant(y, 1); end
if ~exist('sn', 'var') || isempty(sn);   sn = GetSn(y); end
if ~exist('solver', 'var') || isempty(solver);   solver = 'SDPT3'; end

len_g = length(g);
g = reshape(g, 1, []);
indc = bsxfun(@minus, (1:T)', 0:len_g);
indr = repmat((1:T)', [1, len_g+1]);
v = ones(T,1)*[1,-g];
ind = (indc>0);
G = sparse(indr(ind), indc(ind), v(ind), T, T);

cvx_begin quiet
    variable c(T)
    minimize(norm(c,1))
    subject to
        G*c >=0;
        norm(y-c,2) <= sn*sqrt(T); 
cvx_end

s = reshape(G*c, 1, []);
s(1) = 0;
c = reshape(c,1, []);"
2757,constrained_oasisAR1.m,71.434,80,62.89,75,100.0,39.28,70-80,"function [c, s, b, g, lam, active_set] = constrained_oasisAR1(y, g, sn, optimize_b,...
    optimize_g, decimate, maxIter, tau_range)






y = reshape(y, [], 1);
T = length(y);

if ~exist('g', 'var') || isempty(g)
    g = estimate_time_constant(y, 1);
end
if ~exist('sn', 'var') || isempty(sn)
    sn = GetSn(y);
end
if ~exist('lam', 'var') || isempty(lam);   lam = 0; end
if ~exist('optimize_b', 'var') || isempty(optimize_b)
    optimize_b = false;
end
if ~exist('optimize_g', 'var') || isempty(optimize_g)
    optimize_g = 0;
end
if ~exist('decimate', 'var') || isempty(decimate)
    decimate = 1;
else
    decimate = max(1, round(decimate));
end
if ~exist('maxIter', 'var') || isempty(maxIter)
    maxIter = 10;
end
if ~exist('tau_range', 'var') || isempty(tau_range)
   g_range = [0, 1];
else
   g_range = exp(-1./tau_range); 
   g = min(max(g, g_range(1)), g_range(2)); 
end
thresh = sn * sn * T;
lam = 0;

if decimate>1
    decimate = 1;  %#ok<NASGU>
    disp('to be done');
end
g_converged = false;

tol = 1e-4;
dphi = 0; 

if ~optimize_b   %% don't optimize the baseline b
    b = 0;
    [solution, spks, active_set] = oasisAR1(y, g, lam);
    
    for miter=1:maxIter
        if and(optimize_g, ~g_converged)
            g0 = g;
            [solution, active_set, g, spks] = update_g(y, active_set,lam, g_range);
            if abs(g-g0)/g0 < 1e-3  % g is converged
                g_converged = true;
            end
        end
        res = y - solution;
        RSS = res' * res;
        len_active_set = size(active_set, 1);
        if RSS>thresh  % constrained form has been found, stop
            break;
        else
            update_phi;
            lam = lam + dphi;
        end
    end
else
    b = quantile(y, 0.15);
    [solution, spks, active_set] = oasisAR1(y-b, g, lam);
    update_lam_b;
    
    g_converged = false;
    for miter=1:maxIter
        res = y - solution - b;
        RSS = res' * res;
        len_active_set = size(active_set,1);
        
        if or(abs(RSS-thresh) < tol, sum(solution)<1e-9)
            break;
        else
            update_phi();
            update_lam_b();
            if and(optimize_g, ~g_converged)
                g0 = g;
                [solution, active_set, g, spks] = update_g(y-b, active_set,lam, g_range);
                if abs(g-g0)/g0 < 1e-4
                    g_converged = true;
                end
            end
            
        end
    end
    
end
c = solution;
s = spks;

    function update_phi()  % estimate dphi to match the thresholded RSS
        zeta = zeros(size(solution));
        maxl = max(active_set(:, 4));
        h = g.^(0:maxl);
        for ii=1:len_active_set
            ti = active_set(ii, 3);
            li = active_set(ii, 4);
            idx = 0:(li-1);
            if ii<len_active_set
                zeta(ti+idx) = (1-g^li)/ active_set(ii,2) * h(1:li);
            else
                zeta(ti+idx) = 1/active_set(ii,2) * h(1:li);
            end
        end
        
        if optimize_b
            zeta = zeta - mean(zeta);
            tmp_res = res - mean(res);
            aa = zeta' * zeta;
            bb = tmp_res' * zeta;
            cc = tmp_res'*tmp_res - thresh;
            dphi = (-bb + sqrt(bb^2-aa*cc)) / aa;
        else
            aa = zeta'*zeta;
            bb = res'*zeta;
            cc = RSS-thresh;
            dphi = (-bb + sqrt(bb^2-aa*cc)) / aa;
        end
        if imag(dphi)>1e-9
            flag_phi = false;
            return;
        else
            flag_phi = true;
        end
        active_set(:,1) = active_set(:,1) - dphi*(1-g.^active_set(:,4));
        [solution, spks, active_set] = oasisAR1([], g, lam, [], active_set);
    end

    function update_lam_b() % estimate lambda  & b
        db = mean(y-solution) - b;
        b = b + db;
        dlam = -db/(1-g);
        
        lam = max(0, lam + dlam);
        active_set(end,1) = active_set(end,1) - lam*g^(active_set(end,4));
        ti = active_set(end,3); li = active_set(end,4); idx = 0:(li-1);
        solution(ti+idx) = max(0, active_set(end,1)/active_set(end,2)) * (g.^idx);
    end

end
function [c, active_set, g, s] = update_g(y, active_set, lam, g_range)




len_active_set = size(active_set, 1);  %number of active sets
y = reshape(y,[],1);    % fluorescence data
maxl = max(active_set(:, 4));   % maximum ISI
c = zeros(size(y));     % the optimal denoised trace
if ~exist('g_range', 'var') || isempty(g_range)
   g_range = [0, 1];  
end
h = []; 
g = fminbnd(@rss_g, g_range(1), g_range(2));
yp = y - lam*(1-g);
for m=1:len_active_set
    tmp_h = exp(log(g)*(0:maxl)');   % response kernel
    tmp_hh = cumsum(h.*h);        % hh(k) = h(1:k)'*h(1:k)
    li = active_set(m, 4);
    ti = active_set(m, 3);
    idx = ti:(ti+li-1);
    active_set(m,1) = (yp(idx))'*tmp_h(1:li);
    active_set(m,2) = tmp_hh(li);
end
[c,s,active_set] = oasisAR1(y, g, lam, [], active_set);

    function rss = rss_g(g)
        h = exp(log(g)*(0:maxl)');   % response kernel
        hh = cumsum(h.*h);        % hh(k) = h(1:k)'*h(1:k)
        yp = y - lam*(1-g);     % include the penalty term
        for ii=1:len_active_set
            li = active_set(ii, 4);
            ti = active_set(ii, 3);
            idx = ti:(ti+li-1);
            tmp_v = max(yp(idx)' * h(1:li) / hh(li), 0);
            c(idx) = tmp_v*h(1:li);
        end
        res = y-c;
        rss = res'*res;     % residual sum of squares
    end
end"
