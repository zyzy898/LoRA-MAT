6665,compo_delete_act.m,68.476,60,80.95,30,100.0,71.43,61-70,"function  [A,W,SW,S,Q,ix_act] = ...
			compo_delete_act(XX,A,W,SW,S,Q,SY,i_del,jx,ix_act)

A(i_del) = 0;

M  = length(ix_act);
jj = [1:(jx-1), (jx+1):M];

ix_act = ix_act(jj);

ss = 1./SW(jx,jx);
SX = SW(jx,jj);
SW = SW(jj,jj) - ss * (SX' * SX);
SW = 0.5 * (SW + SW');	% guarantee symmetric matrix
Wj = W(:,jx) * ss;
W  = W(:,jj) - Wj * SX;

P  = SX * XX(jj,:);
S  = abs(S + ss * P.^2);
Q  = Q + Wj * P;
return"
