function file_path = download_mmn_dataset(download_path)

if nargin == 0, download_path = 'data'; end

url = ""https://www.fil.ion.ucl.ac.uk/spm/download/data/eeg_mmn/subject1.bdf""; 
file_path = fullfile(download_path, 'subject1.bdf');

websave(file_path, url);
end


function D = preprocess_mmn_dataset(wdir, file_path)

spm('defaults', 'eeg');

cwd = pwd;
cd(wdir); 

S = [];
S.dataset = file_path;
S.mode = 'continuous';
S.channels = {'all'};
S.eventpadding = 0;
S.blocksize = 3276800;
S.checkboundary = 1;
S.saveorigheader = 0;
S.outfile = 'spmeeg_subject1';
S.timewin = [];
S.conditionlabels = {'Undefined'};
S.inputformat = [];
D = spm_eeg_convert(S);

montage.labelorg = D.chanlabels;
montage.labelnew = [montage.labelorg(1:128), 'HEOG', 'VEOG']';

tra = eye(D.nchannels);
tra(129:end, :) = [];

tra = detrend(tra, 'constant');

tra(129, 129) = 0;
tra(129, [131 130]) = [1 -1];

tra(130, 130) = 0;
tra(130, [130 129]) = [1 -1];

montage.tra = tra;

S = [];
S.D = D.fullfile();
S.mode = 'write';
S.blocksize = 655360;
S.prefix = 'M';
S.montage = montage;
S.keepothers = 0;
S.keepsensors = 1;
S.updatehistory = 1;
D = spm_eeg_montage(S);

S = [];
S.D = D.fullfile();
S.type = 'butterworth';
S.band = 'high';
S.freq = 0.1;
S.dir = 'twopass';
S.order = 5;
S.prefix = 'f';
D = spm_eeg_ffilter(S);

S = [];
S.D = D.fullfile();
S.fsample_new = 200;
S.prefix = 'd';
D = spm_eeg_downsample(S);

S = [];
S.D = D.fullfile();
S.type = 'butterworth';
S.band = 'low';
S.freq = 30;
S.dir = 'twopass';
S.order = 5;
S.prefix = 'f';
D = spm_eeg_ffilter(S);

S = [];
S.D = D.fullfile();
S.timewin = [-100 400];
S.trialdef(1).conditionlabel = 'std';
S.trialdef(1).eventtype = 'STATUS';
S.trialdef(1).eventvalue = 1;
S.trialdef(1).trlshift = 0;
S.trialdef(2).conditionlabel = 'odd';
S.trialdef(2).eventtype = 'STATUS';
S.trialdef(2).eventvalue = 3;
S.trialdef(2).trlshift = 0;
S.bc = 1;
S.prefix = 'e';
S.eventpadding = 0;
D = spm_eeg_epochs(S);

S = [];
S.D = D.fullfile();
S.mode = 'reject';
S.badchanthresh = 0.2;
S.methods.channels = {'EEG'};
S.methods.fun = 'threshchan';
S.methods.settings.threshold = 80;
S.methods.settings.excwin = 1000;
S.append = true;
S.prefix = 'a';
D = spm_eeg_artefact(S);

cd(cwd);
end

function D = inverse_mmn_dataset(file_path)


S = [];
S.D = file_path;
S.robust.ks = 3;
S.robust.bycondition = false;
S.robust.savew = false;
S.robust.removebad = true;
S.circularise = false;
S.prefix = 'm';
D = spm_eeg_average(S);

matlabbatch{1}.spm.meeg.source.headmodel.D = {D.fullfile()};
matlabbatch{1}.spm.meeg.source.headmodel.val = 1;
matlabbatch{1}.spm.meeg.source.headmodel.comment = '';
matlabbatch{1}.spm.meeg.source.headmodel.meshing.meshes.template = 1;
matlabbatch{1}.spm.meeg.source.headmodel.meshing.meshres = 2;
matlabbatch{1}.spm.meeg.source.headmodel.coregistration.coregspecify.fiducial(1).fidname = 'spmnas';
matlabbatch{1}.spm.meeg.source.headmodel.coregistration.coregspecify.fiducial(1).specification.select = 'nas';
matlabbatch{1}.spm.meeg.source.headmodel.coregistration.coregspecify.fiducial(2).fidname = 'spmlpa';
matlabbatch{1}.spm.meeg.source.headmodel.coregistration.coregspecify.fiducial(2).specification.select = 'lpa';
matlabbatch{1}.spm.meeg.source.headmodel.coregistration.coregspecify.fiducial(3).fidname = 'spmrpa';
matlabbatch{1}.spm.meeg.source.headmodel.coregistration.coregspecify.fiducial(3).specification.select = 'rpa';
matlabbatch{1}.spm.meeg.source.headmodel.coregistration.coregspecify.useheadshape = 0;
matlabbatch{1}.spm.meeg.source.headmodel.forward.eeg = 'EEG BEM';
matlabbatch{1}.spm.meeg.source.headmodel.forward.meg = 'Single Shell';

matlabbatch{2}.spm.meeg.source.invert.D(1) = cfg_dep('Head model specification: M/EEG dataset(s) with a forward model', substruct('.','val', '{}',{1}, '.','val', '{}',{1}, '.','val', '{}',{1}, '.','val', '{}',{1}), substruct('.','D'));
matlabbatch{2}.spm.meeg.source.invert.val = 1;
matlabbatch{2}.spm.meeg.source.invert.whatconditions.all = 1;
matlabbatch{2}.spm.meeg.source.invert.isstandard.standard = 1;
matlabbatch{2}.spm.meeg.source.invert.modality = {'All'};

spm_jobman('run', matlabbatch)

Dm = spm_eeg_load(D.fullfile());
D  = spm_eeg_load(file_path); 

D.inv = Dm.inv; 

D.inv{1}.inverse.J = {}; 
D.inv{1}.inverse.trials = {'Undefined'}; 
D.inv{1}.inverse.pst = D.time; 
D.inv{1}.inverse.It  = 1:length(D.time);

save(D)

end"
5616,DEMO_tvec_erp_sim.m,75.614,70,63.61,100,100.0,44.46,70-80,"function DEMO_tvec_erp_sim
 



c = {'4BE1EC', 'CB5EEE'};
colorgrad = @(N) interp1([1; N], [html2rgb(c{1}); html2rgb(c{2})], 1:N);



Sname = {'Region 1', 'Region 2'}; % Region names
nr = numel(Sname);               % Number of regions
nsim = 256;                      % Number of simulations

A = [];
A{1} = zeros(nr, nr);    % Intrinsic connectivity
A{1}(2, 1) = 1;          % Forward connection (Region 1 -> Region 2)
A{2} = 0.5 * A{1}';      % Backward connection (Region 2 -> Region 1)
A{3} = 0 .* A{1};        % No lateral connections

C = zeros(2, 1);
C(1, 1) = 1;


nconditions = 16;        % Number of conditions
bf = [];
bf.order = 6;           % Number of basis functions
bf.name = ""Cosine set"";  % Basis set type
bf.dt = 0.5;             % Time step (seconds)
bf.length = nconditions * bf.dt - bf.dt / 2; % Duration
bf = spm_get_bf(bf);     % Generate basis set
bf.t = (0:bf.dt:bf.length)'; % Time vector

X = bf.bf(:, 2:end); 
X = X - mean(X, 1);
X = X(:, any(X, 1)); % Remove empty columns


fii = @(t) -4 * t .* exp(-0.7 * t) / gamma(2); % Self-inhibition
fij = @(t) exp(-(t - 3).^2 / 4) / gamma(2) / 2; % Forward connectivity

uii = fii(bf.t); % Self-inhibition modulation
uii = uii - flip(uii);
uii = (uii - mean(uii)) * 1;

uij = fij(bf.t); % Forward connectivity modulation
uij = (uij - mean(uij)) * 4;

Bii = X \\ uii; % Self-inhibition coefficients
Bij = X \\ uij; % Forward connectivity coefficients


Btrue = cell(1, nconditions);
[Btrue{:}] = deal(zeros(nr, nr));
for i = 1:nconditions
    Btrue{i}(1, 1) = uii(i); % Self-inhibition
    Btrue{i}(2, 1) = uij(i); % Forward connectivity
end

Bvar = exp(-1 + cos(2 * 0.1 * pi * bf.t)) * 2; % Variance
Bnois = Btrue;
for i = 1:nconditions
    Bnois{i}(1, 1) = uii(i) + normrnd(0, Bvar(i)) / sqrt(nsim);
    Bnois{i}(2, 1) = uij(i) + normrnd(0, Bvar(1)) / sqrt(nsim);
end

Bval = cell(1, size(X, 2)); 
[Bval{:}] = deal(zeros(nr, nr));
for i = 1:size(X, 2)
    Bval{i}(1, 1) = Bii(i);
    Bval{i}(2, 1) = Bij(i); 
end

Btemplate = [1 0; 1 0]; 


rng('default')

 
Nc    = 2;  % number of channels
Ns    = 2;  % number of sources
options.spatial  = 'LFP'; % model source-level data
options.model    = 'CMC'; % use canonical microcircuit
options.analysis = 'ERP'; % ERP analysis

M = [];
M.dipfit.model   = options.model;
M.dipfit.type    = options.spatial;
M.dipfit.Nc      = Nc;
M.dipfit.Ns      = Ns;

B = repelem({Btemplate}, nconditions);

[pE,pC] = spm_dcm_neural_priors(A,B,C,options.model);   % neuronal priors
[gE,gC] = spm_L_priors(M.dipfit);                       % spatial  priors
[x,f,h] = spm_dcm_x_neural(pE,options.model);

hE      = 6;
hC      = 1/64;

M.IS   = 'spm_gen_erp';
M.G    = 'spm_lx_erp';
M.FS   = 'spm_fy_erp'; 
M.f    = f;
M.x    = x;
M.h    = h; 
M.pE   = pE;
M.pC   = pC;
M.gE   = gE;
M.gC   = gC;
M.hE   = hE;
M.hC   = hC;
M.m    = size(C, 2);
M.n    = length(spm_vec(M.x));
M.l    = Nc;
M.ns   = 128;

dt     = 2/1000;
pst    = (1:M.ns)*dt;
M.ons  = 64;
M.dur  = 16;
U.dt   = dt;
U.X    = eye(nconditions);

P      = pE;
G      = gE;
P.B    = Btrue; 


x     = spm_gen_erp(P,M,U);                 % neuronal response
L     = spm_lx_erp(G,M.dipfit);             % lead field

s = {}; y = {}; 
V     = spm_sqrtm(spm_inv(spm_Q(1/2,M.ns))); % square root of noise covariance
snr = [];
for i = 1:length(x)
    n    = exp(-hE/2)*V*randn(M.ns,Nc);     % noise
    s{i} = spm_fy_erp(x{i}*L');             % signal
    y{i} = s{i} + n;                        % data (signal plus noise)
    snr = [snr; mean(s{i}.^2, 'all') / mean(n.^2, 'all')];
end

fprintf('SNR: %.2fdB\\n', 10*log10(mean(snr)));

spm_figure('GetWin', 'Simulated and recovered ERPs');
clf; 
subplot(3,1,1)
plot_erps(pst, s, [-0.2, 0.4]); 
