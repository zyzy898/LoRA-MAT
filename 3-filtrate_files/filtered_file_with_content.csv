6083,createHypotrochoid.m,63.856,60,61.9,45,100.0,52.38,61-70,"function [image3D] = createHypotrochoid(nx,ny,nz,r,k,ct)



[x y z] = meshgrid(1:nx, 1:ny, 1:nz);
theta = linspace(0,2*pi,200);

a = sqrt(1/2).*r; % valid for k =3;
for t=1:ny
    xv(t) = (k-1)*a*cos(theta(t)) + a*cos((k-1)*theta(t)) + ct;
    zv(t) = (k-1)*a*sin(theta(t)) - a*sin((k-1)*theta(t)) + ct;
end

for j = 1:ny
    temp(:,j,:) = inpolygon(x(:,j,:),z(:,j,:),xv,zv);
end
temp = qCBinary(temp);

image3D = abs(1-temp);

end"
6084,comp_gabmixdual_fac.m,61.572,60,71.43,30,100.0,46.43,61-70,"function gammaf=comp_gabmixdual_fac(gf1,gf2,L,a,M)


LR=prod(size(gf1));
R=LR/L;

b=L/M;
N=L/a;

c=gcd(a,M);
d=gcd(b,N);
  
p=b/d;
q=N/d;

gammaf=zeros(p*q*R,c*d,assert_classname(gf1,gf2));

G1=zeros(p,q*R,assert_classname(gf1,gf2));
G2=zeros(p,q*R,assert_classname(gf1,gf2));
for ii=1:c*d

  G1(:)=gf1(:,ii);
  G2(:)=gf2(:,ii);
  S=G2*G1';
  Gpinv=M*S\\G2;

  gammaf(:,ii)=Gpinv(:);
end;"
