2675,coning_minor_v000.m,77.688,80,49.11,100,100.0,59.33,70-80,"function [inc corr]=coning_minor(data, alg)
inlen=size(data,2);
switch (alg)
    case(0)
        inc=data;
        corr=zeros(size(data));
    case(1)
        outlen=floor((inlen-3)/3)+1;
        inc=zeros(3,outlen);
        corr=zeros(3,outlen);
        
        ind=1;
        for i=3:3:inlen
            inc(:,ind)=sum(data(:,i-2:i),2);
            corr(:,ind)=(33/80)*cross(data(:,i-2), data(:,i))+(57/80)*cross(data(:,i-1),data(:,i)-data(:,i-2));
            ind=ind+1;
        end
    case(2)
        outlen=floor((inlen-3)/3)+1;
        inc=zeros(3,outlen);
        corr=zeros(3,outlen);
        
        ind=1;
        for i=3:3:inlen
            inc(:,ind)=sum(data(:,i-2:i),2);
            corr(:,ind)=(9/20)*cross(data(:,i-2), data(:,i))+(27/40)*cross(data(:,i-1),data(:,i)-data(:,i-2));
            ind=ind+1;
        end
    case(3)
        outlen=floor((inlen-4)/2)+1;
        inc=zeros(3,outlen);
        corr=zeros(3,outlen);
        
        ind=1;
        for i=4:2:inlen
            vr_a=sum(data(:,i-1:i),2);
            vr_b=sum(data(:,i-3:i-2),2);
            inc(:,ind)=var_a;
            corr(:,ind)=(32/45)*cross(data(:,i-1), data(:,i))+(-1/180)*cross(vr_b,vr_a);
            ind=ind+1;
        end
    case(4)
        outlen=floor((inlen-3)/2)+1;
        inc=zeros(3,outlen);
        corr=zeros(3,outlen);

        ind=1;
        for i=3:2:inlen
            inc(:,ind)=sum(data(:,i-1:i),2);
            corr(:,ind)=cross(((-1/30)*data(:,i-2)+(11/15)*data(:,i-1)), data(:,i));
            ind=ind+1;
        end
    case (5)
        outlen=floor((inlen-3)/3)+1;
        inc=zeros(3,outlen);
        corr=zeros(3,outlen);

        ind=1;
        for i=3:3:inlen
            inc(:,ind)=sum(data(:,i-2:i),2);
            corr(:,ind)=cross(((9/20)*data(:,i-2)+(27/20)*data(:,i-1)), data(:,i));
            ind=ind+1;
        end
    case (6)
        outlen=floor((inlen-6)/3)+1;
        inc=zeros(3,outlen);
        corr=zeros(3,outlen);

        ind=1;
        for i=6:3:inlen
            vr_a=sum(data(:,i-2:i),2);
            vr_b=sum(data(:,i-5:i-3),2);
            inc(:,ind)=vr_a;
            corr(:,ind)=cross(((243/560)*data(:,i-2)+(1539/1120)*data(:,i-1)), data(:,i))+(1/3360)*cross(vr_b,vr_a);
            ind=ind+1;
        end
    case (7)
        outlen=floor((inlen-4)/3)+1;
        inc=zeros(3,outlen);
        corr=zeros(3,outlen);

        ind=1;
        for i=4:3:inlen
            inc(:,ind)=sum(data(:,i-2:i),2);
            corr(:,ind)=cross(((3/280)*data(:,i-3)+(57/140)*data(:,i-2)+(393/280)*data(:,i-1)), data(:,i));
            ind=ind+1;
        end
    case (8)
        outlen=floor((inlen-5)/3)+1;
        inc=zeros(3,outlen);
        corr=zeros(3,outlen);

        ind=1;
        for i=5:3:inlen
            inc(:,ind)=sum(data(:,i-2:i),2);
            corr(:,ind)=cross(((-1/420)*data(:,i-4)+(1/40)*data(:,i-3)+(157/420)*data(:,i-2)+(1207/840)*data(:,i-1)), data(:,i));
            ind=ind+1;
        end   
    case (9)
        outlen=floor((inlen-4)/4)+1;
        inc=zeros(3,outlen);
        corr=zeros(3,outlen);

        ind=1;
        for i=4:4:inlen
            inc(:,ind)=sum(data(:,i-3:i),2);
            corr(:,ind)=cross(((54/105)*data(:,i-3)+(92/105)*data(:,i-2)+(214/105)*data(:,i-1)), data(:,i));
            ind=ind+1;
        end
    otherwise
        disp('Undefined Algorithm (Perhaps, someone else adds it later)');
end"
2676,coning_v000.m,73.38,60,85.71,45,100.0,76.19,70-80,"function [inc, corr]=coning(data, mint, alg)

[minc mcorr]=coning_minor_v000(data, alg);

len=size(minc,2);
outlen=floor(len/mint);
inc=zeros(3,outlen);
corr=zeros(3,outlen);

ind=1;
for i=mint:mint:len
    tinc=minc(:,i-mint+1);
    tcorr=mcorr(:,i-mint+1);
    for k=i-mint+2:i
        tcorr=tcorr+mcorr(:,k)+0.5*cross(tinc, minc(:,k));
        tinc=tinc+minc(:,k);
    end
    inc(:,ind)=tinc;
    corr(:,ind)=tcorr;
    ind=ind+1;
end"
2677,conjgrad.m,77.028,100,56.76,100,100.0,28.38,70-80,"function [x,k,res,negCurv] = conjGrad(A,b,optTol,maxIter,verbose,precFunc,precArgs,matrixVectFunc,matrixVectArgs)

if nargin <= 4
    verbose = 0;
end

x = zeros(size(b));
r = -b;

if nargin >= 7 && ~isempty(precFunc)
    y = precFunc(r,precArgs{:});
else
    y = r;
end

ry = r'*y;
p = -y;
k = 0;

res = norm(r);
done = 0;
negCurv = [];
while res > optTol & k < maxIter & ~done
    if nargin >= 9
        Ap = matrixVectFunc(p,matrixVectArgs{:});
    else
        Ap = A*p;
    end
    pAp = p'*Ap;

    if pAp <= 1e-16
        if verbose
            fprintf('Negative Curvature Detected!\\n');
        end
        
        if nargout == 4
           if pAp < 0
              negCurv = p;
              return
           end
        end
        
        if k == 0
            if verbose
                fprintf('First-Iter, Proceeding...\\n');
            end
            done = 1;
        else
            if verbose
                fprintf('Stopping\\n');
            end
            break;
        end
    end

    alpha = ry/(pAp);
    x = x + alpha*p;
    r = r + alpha*Ap;
    
    if nargin >= 7 && ~isempty(precFunc)
        y = precFunc(r,precArgs{:});
    else
        y = r;
    end
    
    ry_new = r'*y;
    beta = ry_new/ry;
    p = -y + beta*p;
    k = k + 1;

    ry = ry_new;
    res = norm(r);
end
end"
2678,ConjGradSolver.m,78.0,100,54.69,90,100.0,45.31,70-80,"classdef ConjGradSolver < handle

    properties (SetAccess = private)
        id
    end

    properties (Dependent)
        ObjectiveFunction
        TermCriteria
    end

    methods
        function this = ConjGradSolver(varargin)
            this.id = ConjGradSolver_(0, 'new', varargin{:});
        end

        function delete(this)
            if isempty(this.id), return; end
            ConjGradSolver_(this.id, 'delete');
        end

        function [x,fx] = minimize(this, x0)
            [x,fx] = ConjGradSolver_(this.id, 'minimize', x0);
        end
    end

    methods (Hidden)
        function clear(this)
            ConjGradSolver_(this.id, 'clear');
        end

        function b = empty(this)
            b = ConjGradSolver_(this.id, 'empty');
        end

        function name = getDefaultName(this)
            name = ConjGradSolver_(this.id, 'getDefaultName');
        end

        function save(this, filename)
            ConjGradSolver_(this.id, 'save', filename);
        end

        function load(this, fname_or_str)
            ConjGradSolver_(this.id, 'load', fname_or_str);
        end
    end

    methods
        function value = get.ObjectiveFunction(this)
            value = ConjGradSolver_(this.id, 'get', 'Function');
        end
        function set.ObjectiveFunction(this, value)
            ConjGradSolver_(this.id, 'set', 'Function', value);
        end

        function value = get.TermCriteria(this)
            value = ConjGradSolver_(this.id, 'get', 'TermCriteria');
        end
        function set.TermCriteria(this, value)
            ConjGradSolver_(this.id, 'set', 'TermCriteria', value);
        end
    end
end"
2679,conjugate.m,76.962,100,62.75,75,100.0,47.06,70-80,"function S = conjugate(X,A,S,maxiter,U,meanData,tao)

maxiter = 1;
AtA = A'*A;
AtX = A'*X;
[L,N] = size(X); [c,N] = size(S);

cons = 0;
if L>N
    cons = 1;
    meanData = meanData'*ones(1,c);
    C = [ones(1,c); zeros(c-1,c)];
    B = [zeros(1,c-1); eye(c-1)];
    Z = C+B*U'*(S'-meanData);
    ZD = pinv(Z)*B*U';
    detz2 = det(Z)^2;
end

if cons == 1
    gradp = AtA*S - AtX + tao*detz2*ZD;
else
    gradp = AtA*S - AtX;
end
        
conjp = gradp;
S = S - 0.001*gradp;

for iter = 1:maxiter
    
    if cons == 1
        Z = C+B*U'*(S'-meanData);
        ZD = pinv(Z)*B*U';
        detz2 = det(Z)^2;
        grad = AtA*S - AtX + tao*detz2*ZD;
    else
        grad = AtA*S - AtX;
    end
    
    beta = sum(grad.*(grad-gradp),1)./(sum(gradp.^2,1));
    
    conj = -grad+ones(c,1)*beta.*conjp;
    
    AAd = AtA*conj;
    alpha = sum(conj.*(-grad),1)./max(sum(conj.*AAd,1),eps);
       
    S = S + conj.*repmat(alpha,size(AtA,2),1);   
    
    gradp = grad;
    conjp = conj;
    
end"
