x=linspace(1,-1,n)';
xx=nan(size(x));
f=4;
if f==0
    xx=x;
else
    xx(x>=0) =(exp(-f*abs(x(x>0)))-1)./(exp(-f)-1);
    xx(x<0)  =-(exp(-f*abs(x(x<0)))-1)./(exp(-f)-1);
end
xx=w/2.*xx;
xx=-xx+w/2;

x=x.*w;
x=x+(min(V1(:,1)))+(-w);

V2=[x zeros(size(x)) xx];
V2=evenlySampleCurve(V2,n,'linear',0);

