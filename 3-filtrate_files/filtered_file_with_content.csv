centroid = polylineCentroid(curve);

px  = curve(:,1)-centroid(1);
py  = curve(:,2)-centroid(2);

cx  = (px(1:end-1)+px(2:end))/2;
cy  = (py(1:end-1)+py(2:end))/2;

dl  = hypot(px(2:end)-px(1:end-1), py(2:end)-py(1:end-1));

