2663,conformMapQuadPts1D.m,78.62,100,63.92,90,100.0,39.18,70-80,"function [xi,w]=conformMapQuadPts1D(n,mapping,pointType,param)

if(nargin<3||isempty(pointType))
    pointType=0; 
end

if(nargin<2||isempty(mapping))
    if(pointType==0)
        mapping=2;
    else
        mapping=0;
    end 
end

if(nargin<4||isempty(param))
    if(mapping==0)
        param=9;
    else
        param=1.4;
    end
end

rho=param;

switch(pointType)
    case 0
        [xi,w]=GaussLegendrePoints1D(n);
    case 1
        [xi,w]=ClenshawCurtisPoints1D(n);
    otherwise
        error('Unknown Points specified.')
end

switch(mapping)
    case 0%Degree d asin expansion.
        d=rho;
        coeffs=zeros(1,d+1);
        coeffs(d:-2:1)=(1./(1:2:d)).*[1, cumprod(1:2:d-2)./cumprod(2:2:d-1)];
        coeffs=coeffs/sum(coeffs);
        derivCoeffs=polyder(coeffs);
        dg=polyval(derivCoeffs,xi);
        xi=polyval(coeffs,xi);
        
        w=w.*dg.';
    case 1%The Kosloff-Tal-Ezer map
        alpha=2/(rho+1/rho);
        
        dg=alpha./(sqrt(1-xi.^2*alpha^2)*asin(alpha));
        
        xi=asin(alpha*xi)./asin(alpha);

        w=w.*dg.';
    case 2%The strip mapping.
        if(pointType==1)
            error('The strip mapping (mapping=3) cannot be used with Clenshaw-Curtis points'); 
        end
        
        num=0;
        den=0;
        for j=1:round((1/2)+sqrt(10/log(rho)))
            num=num+rho^(-4*(j-(1/2))^2);
            den=den+rho^(-4*j^2);
        end
        m4=2*num/(1+2*den);%m^(1/4)
        m=m4^4;
        
        K=ellipIntInc1Kind(pi/2,m);
        u=asin(xi);
        omega=2*K*u/pi;
        [sn,cn,dn]=JacobiEllipticFuncVals(omega,m);

        dg=(2*K*m4./(pi*sqrt(1-xi.^2))).*(cn.*dn./(1-m4^2*sn.^2))/atanh(m4);
        
        xi=atanh(m4*sn)/atanh(m4);
        
        w=w.*dg.';
    case 3
        u=asin(xi);
        tau=pi/log(rho);

        d=(1/2)+1/(exp(tau*pi)+1);
        pd2pu=pi/2+u;
        pd2mu=pi/2-u;

        C=1/(log(1+exp(-tau*pi))-log(2)+(pi/2)*tau*d);

        dg=-C*(tau./sqrt(1-xi.^2)).*(1./(exp(tau*pd2pu)+1)+1./(exp(tau*pd2mu)+1)-d);
        dg([1,end])=(C*tau^2/4)*tanh((pi/2)*tau)^2;

        w=w.*dg.';

        xi=C*(log(1+exp(-tau*pd2pu))-log(1+exp(-tau*pd2mu))+d*tau*u);
    otherwise
        error('Unknown Mapping specified.')
end

end"
2664,confounderajust.m,74.0,60,86.67,60,100.0,63.33,70-80,"function F=confounderajust(XC,XI,confounder,OPT)


[Mcal,Ncal]=size(XC);

Interest=1:Ncal;
Interest(confounder)=[];
XCi=[XC(:,Interest) ones(Mcal,1)];
XCp=XC(:,confounder);
Bin=inv(XCi'*XCi)*XCi'*XCp;
E=XCp-XCi*Bin;
R2b=1-sumsqr(E)/sumsqr(XCp);

XC=[XC ones(Mcal,1)];
B=inv(XC'*XC)*XC'*XI;

Bc=B(confounder,:);
if OPT==0
  XIc=XI-XC(:,confounder)*Bc;
elseif OPT==1
  XIc=XI-E*Bc;
end
MEAN=mean(XI);
R2=sumsqr(XIc)/sumsqr(XI);
F.confounder=confounder;
F.B=B;
F.Bin=Bin;
F.R2=R2;
F.R2b=R2b;
F.XI_ajusted=XIc;"
2665,confSynth_dyn.m,78.256,80,65.91,100,100.0,45.37,70-80,"function [params, union_y_a, cost] = confSynth_dyn(linsysDT,params,options)




G.X = generators(params.R0conf);
G.W = generators(params.W);
G.V = generators(params.V);
nrOfGen.X = size(G.X,2); % number of generators of X
nrOfGen.W = size(G.W,2); % number of generators of W
nrOfGen.V = size(G.V,2); % number of generators of V
maxNrOfTimeSteps = ceil(params.tFinal/linsysDT.dt); % maximum number of timeSteps
q = size(linsysDT.C,1); % output dimension
n = size(linsysDT.A,1); % system dimension
w = options.w; % weight vector

[union_y_a,union_x_a] = priv_conform_unifyTestCases(linsysDT,params);

if isinf(params.tFinal)
    
else
    Adi = eye(n);
    lin_A = [];
    lin_b = [];
    Lambda = cell(maxNrOfTimeSteps+1,1); % further time step required to consider initial time
    disturbanceMatrix = [];
    Lambda{1} = linsysDT.C;
    LambdaSum = zeros(q,n);

    for k = 0:maxNrOfTimeSteps 
        if k>0
            LambdaSum = LambdaSum + Lambda{k}; % C*[I + A_d + A_d^2 + ... + A_d^(k-1)]
            disturbanceMatrix(:,end+1:end+nrOfGen.W) = Lambda{k}*G.W; % C*[I, A_d, A_d^2, ..., A_d^(k-1)]*G.W
            Adi = linsysDT.A*Adi; 
            Lambda{k+1} = linsysDT.C*Adi; % Lambda_{k+1} is \\Lambda_k in [1]
        else
            disturbanceMatrix = [];
        end
        G_total = [Lambda{k+1}*G.X, disturbanceMatrix, G.V];
        N = aux_normalVectors(G_total);
        nrOfConstraints = size(N,1);
        Gamma = [Lambda{k+1}, LambdaSum, eye(q)];
        G_tilde = aux_compute_G_tilde(N, k, G, Lambda, nrOfGen);
        A_partial = [-N*Gamma, -G_tilde];
        b_partial = -max(N*union_y_a{k+1}',[],2);
        lin_A(end+1:end+nrOfConstraints,:) = A_partial; 
        lin_b(end+1:end+nrOfConstraints,1) = b_partial; 
    end
    length_alpha = nrOfGen.X + nrOfGen.W + nrOfGen.V;
    lin_A(end+1:end+length_alpha,:) = [zeros(length_alpha,2*n+q), -eye(length_alpha)];
    lin_b(end+1:end+length_alpha,1) = zeros(length_alpha, 1);
    rob = 1e-10;
    lin_b = lin_b - rob;
end

    
switch options.norm
    case 'interval'
        iNorm = 0;
        for k = 0:maxNrOfTimeSteps
            G_tilde = aux_compute_G_tilde(eye(q), k, G, Lambda, nrOfGen);  
            iNorm = iNorm + w(k+1)*ones(1,q)*G_tilde;
        end
        lin_f = [zeros(1,2*n+q), iNorm]';
        
        problem.f = lin_f;
        problem.Aineq = lin_A;
        problem.bineq = lin_b;
        problem.Aeq = [];
        problem.beq = [];
        problem.lb = [];
        problem.ub = [];
        [p_opt,cost,exitflag] = CORAlinprog(problem);

    case 'frob'
        H_sum = 0;
        for k = 0:maxNrOfTimeSteps
            H_tilde = aux_compute_H_tilde(options.P, k, G, Lambda, nrOfGen);  
            H_sum = H_sum + w(k+1)*H_tilde;
        end

        problem.H = blkdiag(diag(zeros(1,2*n+q)), H_sum);
        
        problem.f = [];
        problem.Aineq = lin_A;
        problem.bineq = lin_b;
        problem.Aeq = [];
        problem.beq = [];
        problem.lb = [];
        problem.ub = [];
        [p_opt,cost,exitflag] = CORAquadprog(problem);
        
    otherwise
        throw(CORAerror(""CORA:notSupported"",...
            ""Value for options.norm not supported""));
end

if exitflag ~= 1
    throw(CORAerror('CORA:solverIssue'));
end

dim_c = 2*n+q;
c_X = p_opt(1:n);
c_W = p_opt(n+1:2*n);
c_V = p_opt(2*n+1:2*n+q);
alpha_X = p_opt(dim_c+1:dim_c+nrOfGen.X);
alpha_W = p_opt(dim_c+nrOfGen.X+1:dim_c+nrOfGen.X+nrOfGen.W);
alpha_V = p_opt(dim_c+nrOfGen.X+nrOfGen.W+1:end);

params.R0conf = zonotope(c_X, generators(params.R0conf)*diag(alpha_X));
params.W = zonotope(c_W, generators(params.W)*diag(alpha_W));
params.V = zonotope(c_V, generators(params.V)*diag(alpha_V));


end



function N = aux_normalVectors(G)
    G = nonzeroFilter(G);
    [n,nrGen] = size(G);
    if n>1
        comb = combinator(nrGen,n-1,'c');
        comb = comb(any(comb,2),:);

        N = zeros(length(comb(:,1)),n);
        for i=1:length(comb(:,1))
            indices=comb(i,:);
            Q=G(:,indices);
            v=ndimCross(Q);
            N(i,:)=v'/norm(v);
        end
        N = [N; -N];
    else
        N = [1; -1];
    end
end

function G_tilde = aux_compute_G_tilde(M, k, G, Lambda, nrOfGen)
    nrOfConstraints = size(M,1);
    A_X = abs(M*Lambda{k+1}*G.X); % Lambda_{k+1} is \\Lambda_k in [1]
    if k > 0 % disturbance has only an effect for k>0
        A_W = zeros(nrOfConstraints,nrOfGen.W);
        for i = 0:k-1
            A_W_partial = abs(M*Lambda{i+1}*G.W);
            A_W = A_W + A_W_partial;
        end
    else
        A_W = zeros(nrOfConstraints,nrOfGen.W);
    end
    A_V = abs(M*G.V);
    G_tilde = [A_X, A_W, A_V];
end


function H_tilde = aux_compute_H_tilde(P, k, G, Lambda, nrOfGen)
    dim = size(G.X,1);
    if ~isempty(G.X)
        H_X_aux = Lambda{k+1}*G.X;
        H_X = diag(diag(H_X_aux.'*P*H_X_aux));   % Lambda_{k+1} is \\Lambda_k in [1]
    else
        H_X = [];
    end
    if k > 0 % disturbance has only an effect for k>0
        H_W_inner = zeros(dim,dim);
        for i = 0:k-1
            H_W_partial = Lambda{i+1}.'*P*Lambda{i+1};
            H_W_inner = H_W_inner + H_W_partial;
        end
        H_W = diag(diag(G.W.'*H_W_inner*G.W)); 
    else
        H_W = zeros(nrOfGen.W,nrOfGen.W);
    end
    H_V = diag(diag(G.V.'*P*G.V));
    H_tilde = blkdiag(H_X, H_W, H_V);
end"
2666,confSynth_gray.m,78.714,100,57.14,90,100.0,46.43,70-80,"function [params, union_y_a, linsysDT] = confSynth_gray(linsysDT,params,options)



param0 = options.p_0;
free   = options.p_free;
lb     = options.p_min;
ub     = options.p_max;

if any(isinf(lb)) || any(isinf(ub))
    throw(CORAerror(""CORA:specialError"",...
        'Upper and lower bounds MUST be specified for variables.'));
end

opts = optimoptions('fmincon','MaxFunEvals',10000,'MaxIter',10000,'Display','iter','Algorithm','sqp','UseParallel',false);

x0  = param0(free);
x0_ = (x0-lb(free))./(ub(free)-lb(free));
lb_ = zeros(size(x0));
ub_ = ones(size(x0));

xLast     = []; % Last place computeall was called

[param_opt_, ~, ~, ~] = fmincon(@nest_objfun, x0_, [], [], [], [], lb_, ub_, [], opts); %nest_objfun nested below

function cost = nest_objfun(x_)
    if ~isequal(x_,xLast) % Check if computation is necessary

        x = x_ .* (ub(free) - lb(free)) + lb(free);

        param0(free) = x;

        [linsysDT.A, linsysDT.B, linsysDT.C, linsysDT.D] = params.getMatricesFromP(param0,linsysDT);

        try
            [~, ~, cost] = linsysDT.confSynth_dyn(params, options); % Just interested in the cost
        catch err
            disp('Error occurred during the identification:');
            disp(['Error message: ', err.message]);

            cost = inf;
        end

        xLast = x_;
    end
end


param_opt = param_opt_ .* (ub(free) - lb(free)) + lb(free);

param0(free) = param_opt;   
[linsysDT.A, linsysDT.B, linsysDT.C, linsysDT.D] = params.getMatricesFromP(param0,linsysDT);

[params, union_y_a] = linsysDT.confSynth_dyn(params, options);

end"
2667,conFun.m,73.386,60,92.31,30,100.0,84.62,70-80,"function [c,ceq]=confun(ts)

global w h a W r x lamda;
l=w+h/sin(ts(1));
d=l-ts(2);
q=sqrt(r^2-x.^2);
len=sqrt(d^2-+w^2+r^2-x.^2-2*(d*cos(ts(1))+w)*q+2*d*w*cos(ts(1)))+q-d-w;

c=[a*W-2*(w+h*cot(ts(1)));
    -(q+(d*cos(ts(1))+w-q).*(l-q)./sqrt(d^2-+w^2+r^2-x.^2-2*(d*cos(ts(1))+w)*q+2*d*w*cos(ts(1))));
    len-ts(2)+lamda
    ];
ceq=[];"
2668,confusionmat.m,70.556,30,88.89,45,100.0,88.89,70-80,"function [ret] = confusionmat(actual, pred)
    values = union(unique(actual), unique(pred));
    ret = zeros(numel(values), numel(values));
    for i = 1:numel(actual)
        i1 = find(values == actual(i));
        i2 = find(values == pred(i));
        ret(i1, i2) = ret(i1, i2) + 1;
    end
end"
2669,confusion_matrix.m,77.0,60,77.78,75,100.0,72.22,70-80,"function [A, A_pc] = confusion_matrix(pred, gt)
	if nargin == 0
		gt = [1 1 2 2 2 3 3 3 3];
		pred  = [1 3 2 1 2 1 3 2 3];
	end
	C = max(gt);
	A = zeros(C, C);
	for i = 1: numel(gt) 
		A(gt(i), pred(i)) = A(gt(i), pred(i)) + 1;
    end 
    s = sum(A, 2);
    A_pc = A./repmat(s, 1, C);
    if nargin == 0
        disp(A) 
        disp(A_pc)
    end 

end"
