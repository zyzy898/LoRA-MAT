   for i=j^2:-1:1
      [U,D,sigma,flag]=disloc3d(PM(:,i),x,mu,0.25);
      t=[nhat'*sigma([1 2 3],:)
         nhat'*sigma([2 4 5],:)
         nhat'*sigma([3 5 6],:)];
      S(:,i)=(nhat'*t)';
   end


   s=S\\repmat(m(8),j^2,1);
   max(s);
   PM(10,:)=s';

   u=DM_Disloc(PM,xy,nu);"
