            obj.createPlotter();
            obj.plotter.refresh();            
        end
        
    end
    
    methods (Access = private)
        
        function init(obj,cParams)
            obj.mesh       = cParams.mesh;
            obj.inputFile  = cParams.inputFile;
            obj.scale      = cParams.scale;
            obj.density    = cParams.density;
