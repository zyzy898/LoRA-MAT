M(1).f  = @(x,v,P)(1 - sum(exp(x)) - (x + log(3))/32)/64;
M(1).g  = @(x,v,P)[[-1 0 1]*spm_phi(16*(exp(x) - 1)); [-1 0 1]*exp(x) + zeros(16,1)];
M(1).x  = -log(3)*[1; 1; 1];                   % hidden states
M(1).V  = [0 (zeros(1,16) + exp(-4))];         % error precision (g)
M(1).W  = exp(8);                              % error precision (f)
 
 
 
G(1).g  = @(x,v,a,P)[a; v + zeros(16,1)]';
G(1).V  = [exp(8) zeros(1,16) + exp(2)];       % error precision
G(1).U  = [exp(0) zeros(1,16)];                % motor gain
 
G(2).v  = 0;                                   % exogenous forces
G(2).a  = 0;                                   % action forces
G(2).V  = exp(16);
 
 
N     = 32;                                    % length of data sequence
pst   = (1:N);                                 % peristimulus time (bins)
 
DEM.G = G;
DEM.M = M;
DEM.C = spm_phi(((1:N) - N/4)*32/N);           % stimulus motion
 
DEM   = spm_ADEM(DEM);
spm_DEM_qU(DEM.qU,DEM.pU)
 
subplot(2,2,2)
spm_plot_ci(DEM.qU.x{1},DEM.qU.S,pst,(1:3),'exp'), hold on
axis([1 N 0 2]), axis square"
5751,DEM_get_faces.m,79.778,100,62.22,90,100.0,46.67,70-80,"function DEM_get_faces
 
 
file  = dir;
IMG   = [];
for i = 1:length(file)
    try
        if strcmp(file(i).name(1:4),IMG(end).name(1:4))
            IMG(end + 1).y = imread(file(i).name);
            IMG(end).name  = file(i).name;
        end
    catch
        try
            IMG(end + 1).y = imread(file(i).name);
            IMG(end).name  = file(i).name;
        end
    end
end
 
N     = length(IMG);
for i = 1:N
    j    = [find(IMG(i).name =='_') + 1:find(IMG(i).name =='%') - 1];
    E(i) = eval(IMG(i).name(j));
end
[i j] = sort(E);
IMG   = IMG(j);
 
for i = 1:N
    M(i) = im2frame(IMG(i).y);
end
movie(M,1,12);
 
Nm    = 3;
dv    = 4;
F     = double(IMG(1).y(1:dv:end,1:dv:end,:));
for i = 1:N
    Y(:,i) = spm_vec(double(IMG(i).y(1:dv:end,1:dv:end,:)));
end
v     = linspace(0,1,N);
for i = 1:Nm
    U(:,i) = cos((i - 1)*pi*v');
end
V     = Y*U;
 
save DEM_IMG V F U"
5752,DEM_HB_and_LE.m,79.354,80,67.36,100,100.0,49.41,70-80,"function DEM_HB_and_LE


spm_figure('GetWin','DEM'); clf

f  = @(x,v,P,G) v(:) + [-P(1) P(1) 0; P(3) -1 -x(1); x(2) 0 P(2)]*x/64;
Df = @(x,v,P,G) [-P(1) P(1) 0; P(3) -1 -x(1); x(2) 0 P(2)]/64 + ...
                [0 0 0; -x(3) 0 0; 0 x(1) 0]/64;

G.x  = [1; 1; 24];
G.f  = f;

b     = 32;                         % number of bins for density estimation
T     = 2^20;                       % length of trajectory
W     = 32;                         % precision of intrinsic fluctuations
P     = exp((-16:32)*log(32)/32);   % Rayleigh parameter range
for k = 1:length(P)
    
    U.u   = randn(T + 256,3)/W;
    Pk    = [10; -8/3; P(k)];
    t     = spm_int_L(Pk,G,U);
    
    t     = t(256:end,:);
    t     = t(1:T,:);
    tt{k} = t;
    
    
    for i = 1:3
        t(:,i) = t(:,i) - min(t(:,i));
        t(:,i) = (b - 2)*t(:,i)/max(t(:,i));
    end
    t     = t + 1;
    p     = zeros(b,b,b) + 1;
    S     = 0;
    for i = 1:T
        
        j = round(t(i,:));
        p(j(3),j(2),j(1)) = p(j(3),j(2),j(1)) + 1;
        
        dfdx = Df(tt{k}(i,:)',zeros(1,3)',Pk);
        S    = S + sort(real(eig(dfdx,'nobalance')),'descend');
        
    end
    p     = p/sum(p(:));
    pp{k} = p;
    
    [I,Ii,Ie] = spm_self_entropy(p);
    MI(1,k)   = I;
    MI(2,k)   = Ii;
    MI(3,k)   = Ie;
    LE(:,k)   = S/T; 

    
    subplot(3,2,3)
    semilogx(P(1:k),MI(1,:),'b',P(1:k),MI(2,:),'b-.',P(1:k),MI(3,:),'b:')
    axis square xy
    title('Expected surpise','Fontsize',16)
    xlabel('Control parameter'),ylabel('Entropies (nats)'),drawnow
    
    subplot(3,2,4)
    semilogx(P(1:k),LE(1,:),'b')
    axis square xy
    title('Lyapunov exponent','Fontsize',16)
    xlabel('Control parameter'),ylabel('Principal exponent'),drawnow
    
end

j     = find(LE(1,:) > 0,1);
j     = P(j);
subplot(3,2,3)
hold on, plot([j j],[ 0 6],':'), hold off
hold on, plot([1 1],[ 0 6],':'), hold off
legend({'H(B)','H(B|E)','I(B,E)'})
subplot(3,2,4)
hold on, plot([j j],[-1 1]*0.03,':'), hold off
hold on, plot([1 1],[-1 1]*0.03,':'), hold off
hold on, plot(P,zeros(size(P)),'--'), hold off


j     = [8 38 length(P)];
for i = 1:length(j)
    
    subplot(3,3,i)
    t    = tt{j(i)};
    plot(t(1:1024,2),t(1:1024,3),'k')
    axis square xy
    title('Trajectory','Fontsize',16)
    axis([-30 30 -5 60])
    
    subplot(3,3,6 + i)
    p = pp{j(i)};
    imagesc(1-squeeze(sum(p,2))'),axis xy square
    title('Marginal density','Fontsize',16)
    ylabel('State'), xlabel('State')
    
    
    
end

return


function [HB,HBH,IBH] = spm_self_entropy(pHxB)

pB    = sum(pHxB,1);
pH    = sum(sum(sum(pHxB,2),3),4);

ln    = @(p)log(spm_vec(p) + 1e-16);
H     = @(p)-spm_vec(p)'*ln(p);

HB    = H(pB);
IBH   = H(pH) + H(pB) - H(pHxB);
HBH   = HB - IBH;

return

function D = spm_Kaplan_Yorke(LE)
L     = real(LE);
for i = 1:size(L,2)
    l = sort(L(:,i),'descend');
    j = find(cumsum(l) > 0,1);
    if isempty(j), j = 0; end
    D(i) = j + sum(l(1:j))/abs(l(j + 1));
end


function [W,S,X,beta] = spm_power_law(x)

N     = floor(log2(size(x,2)));
s     = abs(fft(x(1,:)')).^2;
w     = (1:2^12)';
W     = w;
S     = s(w + 1);

S     = decimate(log(S),N - 4);
W     = log(decimate(W,N - 4));
X     = [ones(size(W)),W];

[~,i] = max(abs(diff(spm_conv(x(1,:),2^(N - 8)))));
nn    = 2^10;
i     = (-nn:nn) + i;
i     = i(i > 0 & i < size(x,2));

[~,~,beta] = spm_ancova(X,[],S,[0;1]);"
