4817,DCNSGAIII.m,72.834,60,66.67,75,100.0,62.5,70-80,"classdef DCNSGAIII < ALGORITHM


    
    methods
        function main(Algorithm,Problem)
            cp                    = Algorithm.ParameterSet(5);
            
            [Z,Problem.N]         = UniformPoint(Problem.N, Problem.M);
            Population            = Problem.Initialization();
            
            [initialE, ~]         = max(max(0,Population.cons), [], 1);
            initialE(initialE==0) = 1;
            
            while Algorithm.NotTerminated(Population)
                epsn       = ReduceBoundary(initialE, ceil(Problem.FE/Problem.N), ceil(Problem.maxFE/Problem.N)-1, cp);
                MatingPool = TournamentSelection(2, Problem.N,sum(max(0, Population.cons-epsn), 2));
                Offspring  = OperatorGA(Problem,Population(MatingPool));
                Zmin       = min([Population(sum(max(0, Population.cons)<=epsn, 2)==size(Population.cons, 2)).objs; Offspring(sum(max(0,Offspring.cons)<=epsn, 2)==size(Offspring.cons, 2)).objs], [], 1);
                Population = EnvironmentalSelection([Population, Offspring], Problem.N, Z, Zmin, initialE, epsn);
            end
        end
    end
end"
4818,dcost.m,76.566,60,78.26,75,100.0,69.57,70-80,"function Y = dcost(X)

[n, m] = size(X);
Y = zeros(size(X));

ww = (exp(-1i*(0:n - 1)*pi/(2 * n)) / sqrt(2*n)).';
ww(1) = ww(1) / sqrt(2);

for i = 1:m
    if (rem(n, 2) == 1)
        y = zeros(2*n, 1);
        y(1:n) = X(:, i);
        y(n+1:2*n) = X(n:-1:1, i);
        ff = fft(y);
        ff = ff(1:n);
    else
        y = [X(1:2:n, i); X(n:-2:2, i)];
        ff = fft(y);
        if i == 1, ww = 2 * ww; end
    end
    
    Y(:, i) = real(ww.*ff);
end"
4819,dcpf.m,71.0,60,70.0,60,100.0,65.0,70-80,"function [Va, success] = dcpf(B, Pbus, Va0, ref, pv, pq)


Va_threshold = 1e5;     %% arbitrary threshold on |Va| for declaring failure

Va = Va0;
success = 1;    %% successful by default

[lastmsg, lastid] = lastwarn;
lastwarn('');

Va([pv; pq]) = B([pv; pq], [pv; pq]) \\ ...
                (Pbus([pv; pq]) - B([pv; pq], ref) * Va0(ref));

[msg, id] = lastwarn;
if ~isempty(msg) || max(abs(Va)) > Va_threshold
    success = 0;
end

lastwarn(lastmsg, lastid);"
4820,dct.m,78.422,60,78.95,90,100.0,63.16,70-80,"function X=dct(x,N)

if min(size(x)) > 1
    error('DCT currently only supported for vectors');
end

x = reshape(x,[],1);

if nargin == 1    
    N = length(x);
else    
    x = [x;zeros(N-length(x),1)];
end

k = 1:N;
n = 1:N;
w=[1/sqrt(N); sqrt(2/N)*ones(N-1,1)];
e = cos(pi*(k-1)'*(2*n-1)/(2*N));
X=w.*(e*x);"
4821,DCTBasis.m,74.526,60,84.21,60,100.0,68.42,70-80,"function A=dctbasis(N,D)


i=0:N-1;
j=0:N-1;
[I,J]=meshgrid(i,j);
A=sqrt(2/N)*cos(((2.*I+1).*J*pi)/(N*2));
A(1,:)=A(1,:)./sqrt(2);
A=A';   
if D==1
elseif D==2
 B=zeros(N,N,N,N);
 for i=1:N
  for j=1:N
   B(:,:,i,j)=A(:,i)*A(:,j)';
  end;
 end;    
 A=B;
end;"
4822,dctn.m,79.762,100,71.43,75,100.0,52.38,70-80,"function [y,w] = dctn(y,w)



error(nargchk(1,2,nargin))

y = double(y);
sizy = size(y);
y = squeeze(y);

dimy = ndims(y);
if isvector(y)
    dimy = 1;
    y = y(:);
end

if ~exist('w','var') || isempty(w)
    for dim = 1:dimy
        n = (dimy==1)*numel(y) + (dimy>1)*sizy(dim);
        w{dim} = exp(1i*(0:n-1)'*pi/2/n);
    end
end

if ~isreal(y)
    y = complex(misc.dctn(real(y),w),misc.dctn(imag(y),w));
else
    for dim = 1:dimy
        siz = size(y);
        n = siz(1);
        y = y([1:2:n 2*floor(n/2):-2:2],:);
        y = reshape(y,n,[]);
        y = y*sqrt(2*n);
        y = ifft(y,[],1);
        y = bsxfun(@times,y,w{dim});
        y = real(y);
        y(1,:) = y(1,:)/sqrt(2);
        y = reshape(y,siz);
        y = shiftdim(y,1);
    end
end
        
y = reshape(y,sizy);"
4823,dc_ofdm_ber_vs_clipping_ratio.m,79.946,80,68.09,100,100.0,51.64,70-80,"addpath ../f/           % functions path
rng('default')      % initiate default random number generator


sim.Nsymb = 2^14;

RCLIP = 3:0.2:5;

verbose = false;

Nave = 5; %Number of repetitions

tol = 1e-2; % tolerance for the derivative of the BER. If the derivative becomes smaller than this value,

imp_resolution = 1e-9;  % Minimum resolution of the impulse response of the filters

sim.save = true;                   % save important data from simulation on file
sim.Pb = 1.8e-4;                    % Target BER
sim.Mct = 8;                        % oversampling rate for emulation of continuous time 
                                    
                                    
sim.quantiz = false;                % include quantization at both transmitter and receiver
sim.ENOB = 5;                       % effective number of bits

ofdm.ofdm = 'dc_ofdm';             % ofdm type
ofdm.Nc = 64;                       % total number of subcarriers = FFT size (must be even)
ofdm.Nu = 52;                     % number of nonzero subcarriers (including complex conjugate)
ofdm.Rb = 107e9;                    % bit rate (total over two polarizations) (b/s)

ofdm.Ms = ofdm.Nc/ofdm.Nu;       % oversampling ratio
ofdm.Rs = 2*ofdm.Rb/log2(ofdm.CS);   % Symbol rate  
ofdm.B = ofdm.Nu/2*log2(ofdm.CS);    % Total number of bits per symbol

tx.kappa = 1;                         % current to optical power conversion (dc slope)

tx.fnl = Fnl;
tx.Hl = @(f) 1./(1 + 2*1j*f/tx.fnl - (f/tx.fnl).^2);  % laser freq. resp. (unitless) f is frequency vector (Hz)
tx.hl = @(t) (2*pi*tx.fnl)^2*t(t >= 0).*exp(-2*pi*tx.fnl*t(t >= 0));
tx.hl_delay = 2/(2*pi*tx.fnl);          % group delay of second-order filter in seconds

tx.filter = 'bessel';
tx.filter_order = 5;                % filter order
tx.filter_cutoff = 1/ofdm.Ms;       % Cut-off frequency normalized by ofdm.fs
tx.imp_length = 512;                % length of the impulse response of the filter

[bfilt, afilt] = design_filter(tx.filter, tx.filter_order, tx.filter_cutoff, sim.Mct);
                 
switch tx.filter
    case 'ideal'
        tx.gdac = bfilt/sum(bfilt);       
        tx.gdac_delay = grpdelay(bfilt, afilt, 1);
    otherwise
        bzoh = ones(1, sim.Mct);    % Grp delay = (Mct-1)/2
        bdac = conv(bfilt, bzoh);   % numerator of DAC transfer function (Gzoh x Gfilt) 
        adac = afilt;               % denominator of DAC transfer function (Gzoh x Gfilt) ZOH is FIR
        tx.gdac = impz(bdac, adac, tx.imp_length).';    

        tx.gdac = tx.gdac/sum(tx.gdac);
        tx.gdac_delay = grpdelay(bdac, adac, 1);    % calculates the group delay by approximating the filter as an FIR filter

        assert(abs(tx.gdac(end)) < imp_resolution, 'tx.gdac length is not high enough');
end
                                             
rx.R = 1;                           % responsivity
rx.NEP = 30e-12;                    % Noise equivalent power of the TIA at the receiver (A/sqrt(Hz))
rx.Sth = rx.R^2*rx.NEP^2/2;            % two-sided psd of thermal noise at the receiver (Sth = N0/2)

rx.filter = 'gaussian';
rx.filter_order = 4;                            % filter order
rx.filter_cutoff = 1/ofdm.Ms;                   % Cut-off frequency normalized by ofdm.fs
rx.imp_length = 512;                            % length of the impulse response of the filter

[bfilt, afilt] = design_filter(rx.filter, rx.filter_order, rx.filter_cutoff, sim.Mct);

rx.gadc = impz(bfilt, afilt, rx.imp_length).';  % impulse response
rx.gadc = rx.gadc/sum(rx.gadc);                 % normalize so frequency response at 0 Hz is 0 dB
rx.gadc_delay = grpdelay(bfilt, afilt, 1);

assert(abs(rx.gadc(end)) < imp_resolution, 'rx.gadc length is not high enough');

[ofdm.Npre_os, ofdm.Nneg_os, ofdm.Npos_os] = cyclic_prefix(ofdm, tx, rx, sim);

ofdm.fs = ofdm.Rs*(ofdm.Nc + ofdm.Npre_os)/ofdm.Nu;               % sampling rate (Hz)
ofdm.fsct = sim.Mct*ofdm.fs;                                      % sampling frequency to emulate continuous time (Hz)
ofdm.fc = ofdm.fs/ofdm.Nc*(1:ofdm.Nu/2);                          % frequency at which subcarriers are located       

dt = 1/ofdm.fsct;                                                 % time increment in emulating continuous time (s)
Ntot = sim.Mct*(ofdm.Nc + ofdm.Npre_os)*sim.Nsymb;                % total number of points simulated in continuous time
df = ofdm.fsct/Ntot;                                              % frequency increment in continuous time (Hz)                    

sim.t = dt*(0:Ntot-1);                                            % continuous time scale
sim.f = -ofdm.fsct/2:df:ofdm.fsct/2-df;                           % frequency range in continuous time                    
    

PtxdBm = zeros(size(RCLIP));
bercount = zeros(size(RCLIP));
berest = zeros(size(RCLIP));

rng_seed = rng;

for k = 1:length(RCLIP)
    fprintf('--- r = %.2f --- \\n', RCLIP(k))
    sim.rcliptx = RCLIP(k);                    % Clipping ratio of ACO-OFDM
     
    PtxdBmv = zeros(1, Nave);
    berc = zeros(1, Nave);
    bere = zeros(1, Nave);                               
    
    rng(rng_seed);
    for kk = 1:Nave
        [ber, P] = dc_ofdm(ofdm, tx, rx, sim, verbose);
        
        PtxdBmv(kk) = 10*log10(P.Ptx/1e-3);
        berc(kk) = log10(ber.count);
        bere(kk) = log10(ber.est);
    end
   
    PtxdBm(k) = mean(PtxdBmv);
    bercount(k) = mean(berc);
    berest(k) = mean(bere); 
end

snr = fzero(@(x) berqam(ofdm.CS, x) - sim.Pb, 20);      % snr to achieve target BER;
snrl = 10^(snr/10);

Pnrx = snrl*ofdm.Ms*ofdm.Rs*rx.Sth/ofdm.Nc;
Pnawgn = (1-qfunc(sim.rcliptx))^2*Pnrx./abs(rx.R*tx.kappa)^2*ones(1, ofdm.Nu/2);
Pawgn = tx.kappa*sqrt(2*sum(Pnawgn))*(sim.rcliptx*(1 - qfunc(sim.rcliptx)) + 1/sqrt(2*pi)*exp(-sim.rcliptx^2/2));
PawgndBm = 10*log10(Pawgn/1e-3);

PookdBm = 10*log10(1/rx.R*qfuncinv(sim.Pb)*sqrt(rx.Sth*ofdm.Rb)/1e-3);


PP_ofdm_dc = @ (M, r) 10*log10(r*sqrt(2*(M-1)./(3*log2(M)))); 

power_pen_ook = PtxdBm - PookdBm;

r = linspace(RCLIP(1), RCLIP(end));
bercount_int = spline(RCLIP, bercount, r);
dr = abs(r(1)-r(2));
dber = diff(bercount_int)/dr;

loc = (abs(dber) < tol);

for k = 1:length(loc)
    if all(loc(k:end))
        ropt = r(k);
        break;
    else
        continue;
    end
end


figure
subplot(211), hold on
plot(RCLIP, bercount, 'sk', RCLIP, berest, '-or')
plot(RCLIP, log10(sim.Pb)*ones(size(RCLIP)), 'k')
plot(r, bercount_int, '-k')
plot(ropt, bercount_int(r == ropt), '*k', 'MarkerSize', 10);
xlabel('Clipping ratio', 'FontSize', 12)
ylabel('log_{10}(BER)', 'FontSize', 12)
legend('BER counted', 'BER estimaded', 'Target BER')
axis([RCLIP([1 end]) -4 -3])
grid on

subplot(212), hold on
plot(r(1:end-1), abs(dber), 'k')
plot(r([1 end-1]), [tol tol], '-r')
xlabel('Clipping ratio', 'FontSize', 12)
ylabel('|dlog_{10}(BER)/dr|', 'FontSize', 12)
axis([RCLIP([1 end]) 0 2*tol])


if sim.save
    filepath = ['results/' ofdm.ofdm '/'];
    if sim.quantiz
        filename = ['clip_opt_' ofdm.ofdm '_' sim.type '_CS=' num2str(ofdm.CS) '_ENOB=' num2str(sim.ENOB) '_Fnl=' num2str(Fnl/1e9) 'GHz'];
    else
        filename = ['clip_opt_' ofdm.ofdm '_' sim.type '_CS=' num2str(ofdm.CS) '_Fnl=' num2str(Fnl/1e9) 'GHz'];
    end
    
    sim = rmfield(sim, {'f', 't'});
    
    save([filepath filename])
    
    saveas(gca, [filepath filename], 'png')
end"
4824,dc_ofdm_ber_vs_clipping_ratio_rx.m,78.786,80,60.61,100,100.0,53.32,70-80,"format compact

addpath ../f/           % functions path
rng('default')      % initiate default random number generator


sim.quantiz = true;                % include quantization at both transmitter and receiver

sim.Nsymb = 2^14;

switch cases
    case 1 % Preemphasis, CS = 16
        sim.type = 'preemphasis';
        
        ofdm.CS = 16;
        
        Fnl = (10:5:50)*1e9;
        
        RCLIPTX = [4.2 4.0 3.9 3.7 3.7 3.7 3.7 3.7 3.7]; % result from optimization
        
        RCLIPRX = 3:0.1:4; % range to swipe
        
    case 2 % Preemphasis, CS = 64
        sim.type = 'preemphasis';
        
        ofdm.CS = 64;
        
        Fnl = (10:5:50)*1e9;
        
        RCLIPTX = [4.3 4.2 4.1 4.0 4.0 4.0 4.0 4.0 4.0];
        
        RCLIPRX = 3:0.1:4; % range to swipe
        
    case 3 % Palloc, CS = 16
        sim.type = 'palloc';
        
        ofdm.CS = 16;
        
        Fnl = (10:5:50)*1e9;
        
        RCLIPTX = [3.9 3.8 3.7 3.7 3.7 3.7 3.7 3.7 3.7];
        
        RCLIPRX = 3:0.1:4; % range to swipe       
        
    case 4 % Palloc, CS = 64
        sim.type = 'palloc';
        
        ofdm.CS = 64;
        
        Fnl = (10:5:50)*1e9;
  
        RCLIPTX = [4.4 4.3 4.1 4.1 3.9 3.9 3.9 3.9 3.9];
        
        RCLIPRX = 3:0.1:4; % range to swipe 
        
    otherwise
        error('invalid option');
end

verbose = false;

Nave = 5; %Number of noise realizations

tol = 1e-2; % tolerance for the derivative of the BER. If the derivative becomes smaller than this value,

imp_resolution = 1e-9;  % Minimum resolution of the impulse response of the filters

sim.save = true;                   % save important data from simulation on file
sim.Pb = 1.8e-4;                    % Target BER
sim.Mct = 8;                        % oversampling rate for emulation of continuous time 
                                    
                             

ofdm.ofdm = 'dc_ofdm';             % ofdm type
ofdm.full_dc = false;               % simulation with full dc bias or with reduced dc bias
ofdm.Nc = 64;                       % total number of subcarriers = FFT size (must be even)
ofdm.Nu = 52;                     % number of nonzero subcarriers (including complex conjugate)
ofdm.Rb = 107e9;                    % bit rate (total over two polarizations) (b/s)

ofdm.Ms = ofdm.Nc/ofdm.Nu;       % oversampling ratio
ofdm.Rs = 2*ofdm.Rb/log2(ofdm.CS);   % Symbol rate  
ofdm.B = ofdm.Nu/2*log2(ofdm.CS);    % Total number of bits per symbol

tx.kappa = 1;                         % current to optical power conversion (dc slope)

tx.filter = 'bessel';
tx.filter_order = 5;                % filter order
tx.filter_cutoff = 1/ofdm.Ms;       % Cut-off frequency normalized by ofdm.fs
tx.imp_length = 512;                % length of the impulse response of the filter

[bfilt, afilt] = design_filter(tx.filter, tx.filter_order, tx.filter_cutoff, sim.Mct);
                 
switch tx.filter
    case 'ideal'
        tx.gdac = bfilt/sum(bfilt);       
        tx.gdac_delay = grpdelay(bfilt, afilt, 1);
    otherwise
        bzoh = ones(1, sim.Mct);    % Grp delay = (Mct-1)/2
        bdac = conv(bfilt, bzoh);   % numerator of DAC transfer function (Gzoh x Gfilt) 
        adac = afilt;               % denominator of DAC transfer function (Gzoh x Gfilt) ZOH is FIR
        tx.gdac = impz(bdac, adac, tx.imp_length).';    

        tx.gdac = tx.gdac/sum(tx.gdac);
        tx.gdac_delay = grpdelay(bdac, adac, 1);    % calculates the group delay by approximating the filter as an FIR filter

        assert(abs(tx.gdac(end)) < imp_resolution, 'tx.gdac length is not high enough');
end
                                             
rx.R = 1;                           % responsivity
rx.NEP = 30e-12;                    % Noise equivalent power of the TIA at the receiver (A/sqrt(Hz))
rx.Sth = rx.R^2*rx.NEP^2/2;            % two-sided psd of thermal noise at the receiver (Sth = N0/2)

rx.filter = 'gaussian';
rx.filter_order = 4;                            % filter order
rx.filter_cutoff = 1/ofdm.Ms;                   % Cut-off frequency normalized by ofdm.fs
rx.imp_length = 512;                            % length of the impulse response of the filter

[bfilt, afilt] = design_filter(rx.filter, rx.filter_order, rx.filter_cutoff, sim.Mct);

rx.gadc = impz(bfilt, afilt, rx.imp_length).';  % impulse response
rx.gadc = rx.gadc/sum(rx.gadc);                 % normalize so frequency response at 0 Hz is 0 dB
rx.gadc_delay = grpdelay(bfilt, afilt, 1);

assert(abs(rx.gadc(end)) < imp_resolution, 'rx.gadc length is not high enough');


PtxdBm = zeros(length(Fnl), length(RCLIPRX));
bercount = zeros(length(Fnl), length(RCLIPRX));
berest = zeros(length(Fnl), length(RCLIPRX));

figure('units', 'normalized','outerposition',[0 0 1 1])
for nn = 1:length(Fnl)
    fprintf('-------------- fnl = %d GHz --------------\\n', Fnl(nn)/1e9)
    
    tx.fnl = Fnl(nn);
    sim.rcliptx = RCLIPTX(nn);
    
    tx.Hl = @(f) 1./(1 + 2*1j*f/tx.fnl - (f/tx.fnl).^2);  % laser freq. resp. (unitless) f is frequency vector (Hz)
    tx.hl = @(t) (2*pi*tx.fnl)^2*t(t >= 0).*exp(-2*pi*tx.fnl*t(t >= 0));
    tx.hl_delay = 2/(2*pi*tx.fnl);          % group delay of second-order filter in seconds
   
    [ofdm.Npre_os, ofdm.Nneg_os, ofdm.Npos_os] = cyclic_prefix(ofdm, tx, rx, sim);

    ofdm.fs = ofdm.Rs*(ofdm.Nc + ofdm.Npre_os)/ofdm.Nu;               % sampling rate (Hz)
    ofdm.fsct = sim.Mct*ofdm.fs;                                      % sampling frequency to emulate continuous time (Hz)
    ofdm.fc = ofdm.fs/ofdm.Nc*(1:ofdm.Nu/2);                          % frequency at which subcarriers are located       

    dt = 1/ofdm.fsct;                                                 % time increment in emulating continuous time (s)
    Ntot = sim.Mct*(ofdm.Nc + ofdm.Npre_os)*sim.Nsymb;                % total number of points simulated in continuous time
    df = ofdm.fsct/Ntot;                                              % frequency increment in continuous time (Hz)                    

    sim.t = dt*(0:Ntot-1);                                            % continuous time scale
    sim.f = -ofdm.fsct/2:df:ofdm.fsct/2-df;                           % frequency range in continuous time                    
    
    rng('shuffle');
    rng_seed = rng;
    
    for k = 1:length(RCLIPRX)
        fprintf('--- r = %.2f --- \\n', RCLIPRX(k))
        sim.rcliprx = RCLIPRX(k);                    % Clipping ratio of ACO-OFDM

        PtxdBmv = zeros(1, Nave);
        berc = zeros(1, Nave);
        bere = zeros(1, Nave);                               
        
        rng(rng_seed);
        for kk = 1:Nave
            try
                [ber, P] = dc_ofdm(ofdm, tx, rx, sim, verbose);
            catch err
                disp(err.message)
                fprintf('fnl = %d GHz, r = %.2f\\n', tx.fnl/1e9, sim.rcliprx);
                break; 
            end

            PtxdBmv(kk) = 10*log10(P.Ptx/1e-3);
            berc(kk) = log10(ber.count);
            bere(kk) = log10(ber.est);
        end
   
        PtxdBm(nn, k) = mean(PtxdBmv);
        bercount(nn, k) = mean(berc);
        berest(nn, k) = mean(bere); 
    end

    snr = fzero(@(x) berqam(ofdm.CS, x) - sim.Pb, 20);      % snr to achieve target BER;
    snrl = 10^(snr/10);

    Pnrx = snrl*ofdm.Ms*ofdm.Rs*rx.Sth/ofdm.Nc;
    Pnawgn = (1-qfunc(sim.rcliptx))^2*Pnrx./abs(rx.R*tx.kappa)^2*ones(1, ofdm.Nu/2);
    Pawgn = tx.kappa*sqrt(2*sum(Pnawgn))*(sim.rcliptx*(1 - qfunc(sim.rcliptx)) + 1/sqrt(2*pi)*exp(-sim.rcliptx^2/2));
    PawgndBm = 10*log10(Pawgn/1e-3);

    PookdBm = 10*log10(1/rx.R*qfuncinv(sim.Pb)*sqrt(rx.Sth*ofdm.Rb)/1e-3);


    PP_ofdm_dc = @ (M, r) 10*log10(r*sqrt(2*(M-1)./(3*log2(M)))); 

    power_pen_ook = PtxdBm - PookdBm;

    if all(bercount(nn,:) == 0)
        fprintf('----- There is no clipping ratio that makes it work at fnl = %d GHz -----\\n', tx.fnl/1e9);
        continue
    end

    subplot(3, 3, nn), hold on
    plot(RCLIPRX, bercount(nn, :), '-sk', RCLIPRX, berest(nn,:), '-or')
    plot(RCLIPRX, log10(sim.Pb)*ones(size(RCLIPRX)), 'k')
    
    xlabel('Clipping ratio', 'FontSize', 12)
    ylabel('log_{10}(BER)', 'FontSize', 12)
    legend('BER counted', 'BER estimaded', 'Target BER')
    axis([RCLIPRX([1 end]) -4 -3])
    grid on
    title(sprintf('fnl = %d GHz', tx.fnl/1e9));
end

if sim.save
    filepath = ['results/' ofdm.ofdm '/'];
    if sim.quantiz
        filename = ['clip_opt_' ofdm.ofdm '_' sim.type '_CS=' num2str(ofdm.CS) '_ENOB=' num2str(sim.ENOB)];
    else
        filename = ['clip_opt_' ofdm.ofdm '_' sim.type '_CS=' num2str(ofdm.CS)];
    end
    
    sim = rmfield(sim, {'f', 't'});

    save([filepath filename])
    
    saveas(gca, [filepath filename], 'fig')
end"
4825,dc_wavelet.m,76.384,60,100.0,45,100.0,76.92,70-80,"function dcData=dc_wavelet(dcfile)
