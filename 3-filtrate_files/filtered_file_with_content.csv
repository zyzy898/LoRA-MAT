2113,computeDistMatrix.m,76.666,60,73.33,90,100.0,60.0,70-80,"function [D,HMMs_dualregr] = computeDistMatrix (data,T,hmm)

if ~iscell(data) || ~iscell(T), error('X and T must both be cells'); end 

N = length(data);
