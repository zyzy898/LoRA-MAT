      elseif Ind(j,2) == -1 && j < m
        t = t+1;
        Tria(t,:) = [nv1+j nv0+Ind(j,1) nv0+Ind(j,1)+1];
        t = t+1;
        Tria(t,:) = [nv1+j nv0+Ind(j,1)+1 nv1+j+1];
