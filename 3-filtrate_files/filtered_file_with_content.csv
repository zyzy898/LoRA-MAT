4601,dataAcquisition.m,76.88,100,75.76,45,100.0,63.64,70-80,"function [w,RPmap,phaseSignal,heartSignal,breathSignal]=dataAcquisition(rawData,ADCS)
Data=rawData;
fsFast=2*10^6;
FP=128;
X=zeros(FP,length(Data)/ADCS);

for ii=1:length(Data)/ADCS
    [X(:,ii),w]=FFTNonshift(window(@nuttallwin,ADCS).*Data(1,1+(ii-1)*ADCS:ADCS+(ii-1)*ADCS).',FP);
end

RPmap=abs(X)/(2*pi);

[~,Posi]=max(abs(X(1:end,:)));
pos=mode(Posi');

fsSlow=100;
MaxRow=X(pos,:);
fc = 77e9;
c = physconst('LightSpeed');
lambda = c/fc;

phaseSignal=unwrap(angle(MaxRow))*lambda/(4*pi);

Wn =[0.8 2.0]/(fsSlow/2);
[a,b] = butter(3, Wn);
filterSignal_heart = filter(a,b,phaseSignal);
heartSignal = filterSignal_heart;

Wn =[0.1 0.5]/(fsSlow/2);
[a,b] = butter(3, Wn);
filterSignal_breath = filter(a,b,phaseSignal);
breathSignal = filterSignal_breath;
end"
4602,DataAssociatorX.m,79.85,100,63.64,75,100.0,60.61,70-80,"classdef (Abstract) DataAssociatorX < BaseX 
    
    properties
        TrackList
        MeasurementList
        Gater
        Hypothesiser
