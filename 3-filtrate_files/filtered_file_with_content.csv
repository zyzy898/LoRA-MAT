6184,decomposeFloat.m,68.298,100,56.14,45,100.0,40.35,61-70,"function [mantissa,exponent,signBit]=decomposeFloat(x,decodeExp,addLeading1)

if(nargin<2||isempty(decodeExp))
    decodeExp=true;
end

if(nargin<3||isempty(addLeading1))
    addLeading1=true;
end

if(~isreal(x)||~isscalar(x))
   error('x must be a real, scalar, floating point value.') 
end

if(isa(x,'double'))
    N=typecast(x,'uint64');
    
    theMask=getBitMask(63,'uint64');
    signBit=bitshift(bitand(N,theMask),-63);
    
    expMask=getBitMask([52,62],'uint64');
    exponent=bitshift(bitand(N,expMask),-52);

    theMask=getBitMask([0,51],'uint64');
    mantissa=bitand(N,theMask);
    if(addLeading1&&exponent~=0&&exponent~=expMask)

        mantissa=bitor(mantissa,bitshift(uint64(1),52));
    end

    if(decodeExp)
        exponent=int64(exponent)-1023;
    end
elseif(isa(x,'single'))
    N=typecast(x,'uint32');
    
    theMask=getBitMask(31,'uint32');
    signBit=bitshift(bitand(N,theMask),-31);
    
    expMask=getBitMask([23,30],'uint32');
    exponent=bitshift(bitand(N,expMask),-23);
    
    theMask=getBitMask([0,22],'uint32');
    mantissa=bitand(N,theMask);
    if(addLeading1&&exponent~=0&&exponent~=expMask)

        mantissa=bitor(mantissa,bitshift(uint32(1),23));
    end

    if(decodeExp)
        exponent=int32(exponent)-127;
    end
else
    error('x must be a single or double floating point value.')
end

end"
6185,crossJ.m,66.232,60,53.85,75,100.0,42.31,61-70,"function [c,Ca,Cb] = crossJ(a,b)



c = cross(a,b);

if nargout > 1
    
    Ca = -hat(b);

    Cb = hat(a);

end

return


syms x y z u v w real
a = [x;y;z];
b = [u,v,w];

[c,Ca,Cb] = crossJ(a,b);

Ca - jacobian(c,a)

Cb - jacobian(c,b)"
6186,compute_A_and_b_Gauss_Newton.m,63.758,60,75.86,45,100.0,37.93,61-70,"function [A,b]=compute_A_and_b_Gauss_Newton(current_betas,rho,L)




A=zeros(6,4);
b=zeros(6,1);

cb=current_betas;

B=[cb(1)*cb(1),
   cb(1)*cb(2),
   cb(2)*cb(2),
   cb(1)*cb(3),
   cb(2)*cb(3),
   cb(3)*cb(3),
   cb(1)*cb(4),
   cb(2)*cb(4),
   cb(3)*cb(4),
   cb(4)*cb(4)];

for i=1:6
    A(i,1)=2*cb(1)*L(i,1)+cb(2)*L(i,2)+cb(3)*L(i,4)+cb(4)*L(i,7);
    A(i,2)=cb(1)*L(i,2)+2*cb(2)*L(i,3)+cb(3)*L(i,5)+cb(4)*L(i,8);
    A(i,3)=cb(1)*L(i,4)+cb(2)*L(i,5)+2*cb(3)*L(i,6)+cb(4)*L(i,9);
    A(i,4)=cb(1)*L(i,7)+cb(2)*L(i,8)+cb(3)*L(i,9)+2*cb(4)*L(i,10);
        
    b(i)=(rho(i)-L(i,:)*B);    
end"
