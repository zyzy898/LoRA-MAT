while Usernum<=Num
[Schedule,Channel,Avgdeley,Usercurrent,avgdeleymin,point,Timeslot,Timeslotlast]=Game(Usernum,Servernum,Taskgraph,Tasknum,Transdata,Computecost,Transferrate,Comstartup,Iterationnum);
