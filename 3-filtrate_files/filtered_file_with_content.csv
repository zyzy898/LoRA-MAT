Isigma      = max(Isigma,0.1/255);
Msigma      = sf;    % noise level of last denoiser, from [1,15]
kernelsigma = 1.6; % width (sigma) of the Gaussian blur kernel
k       = fspecial('gaussian',7,kernelsigma);


