2260,computeTrueAnomFromEccAnom.m,72.0,30,100.0,30,100.0,100.0,70-80,"function [tru] = computeTrueAnomFromEccAnom(EccA, ecc)
    
    upper = sqrt(1+ecc) .* tan(EccA/2);
    lower = sqrt(1-ecc);
    tru = AngleZero2Pi(atan2(upper, lower) * 2);
end"
2261,computeTrueAnomFromHypAnom.m,72.0,30,100.0,30,100.0,100.0,70-80,"function [tru] = computeTrueAnomFromHypAnom(HypA, ecc)

    upper = sqrt(ecc+1) .* tanh(HypA/2);
    lower = sqrt(ecc-1);
    tru = atan2(upper, lower) * 2;
end"
