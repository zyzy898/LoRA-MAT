6433,colprintf.m,69.6,60,76.0,60,100.0,52.0,61-70,"function [] = colprintf(aC, astr_LC, varargin)

	LC              = 40;
	RC              = 40;
        verbosity       = 1;

        if isobject(aC)
            LC          = aC.m_LC;
            RC          = aC.m_RC;
            verbosity   = aC.m_verbosity;
        else
            [str_LC, str_RC]    = strtok(aC, ';');
            LC                  = str2num(str_LC);
            RC                  = str2num(str_RC);
        end

        sfrmt   = sprintf(varargin{:});
        
        if length(astr_LC) & verbosity
            fprintf(1, '%s', sprintf('%*s', LC, astr_LC));
        end
        if length(sfrmt)   & verbosity
            fprintf(1, '%s', sprintf('%*s', RC, sfrmt));
        end
end"
