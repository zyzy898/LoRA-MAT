Handles.Hp{end+1} = patch('faces',surf.faces,'vertices',surf.vertices,...
                          'facecolor','interp',...
                          'FaceVertexCData', vertexColors,...
                          'edgecolor', 'none',...
                          'facealpha',0.5);

view([40,20])
daspect([1 1 1])
axis equal
