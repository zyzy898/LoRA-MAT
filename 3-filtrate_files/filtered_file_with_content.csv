	if Num <= 0
		Rout = eye(3);
	else
		Rout = varargin{1};
		for k = 2:Num
			R = varargin{k};
			if size(R,1) ~= 3 || size(R,2) ~= 3
				warning('Ignoring an invalid rotation parameter!');
				continue;
			end
			Rout = Rout * R;
		end
	end

end"
