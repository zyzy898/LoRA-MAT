        plot(hours, GPS_rec_clk_phase, 'r--');
        leg_txt_clk{i} = 'dt_{phase}^{G}'; i=i+1;
    end
    if isGLO && any(~isnan(GLO_rec_clk_code))
        plot(hours, GLO_rec_clk_code, 'c-');
        leg_txt_clk{i} = 'dt_{code}^{R}'; i=i+1;
        plot(hours, GLO_rec_clk_phase, 'c--');
