   nu=varargin{3};
end

if isempty(varargin{4})
   mu=3e10;
else
   mu=varargin{4};
end

if isempty(varargin{5})
   n=3;
else
   n=varargin{5};
end


   nhat=unitvector(m);
   j=2^n;
   PM=patchfault(m,j,j);
   PM(8:9,:)=0;
   PM(10,:)=1;
   x=midpoint(PM);
