1234,db_import.m,83.834,100,66.67,90,100.0,62.5,80-90,"function nProtocols = db_import(BrainstormDbDir)



nProtocols = 0;
if (nargin < 1) || isempty(BrainstormDbDir)
    if ispc
        defDir = 'C:\\';
    else
        defDir = bst_get('UserDir');
    end
    BrainstormDbDir = bst_uigetdir(defDir, 'Please select database directory.');
    if isempty(BrainstormDbDir) || ~ischar(BrainstormDbDir)
        return
    end
end

files = dir(BrainstormDbDir);
dirList = files([files.isdir] == 1);
if isempty(dirList)
    return
end
iProtocols = [];

for i = 1:length(dirList)
    if (dirList(i).name(1) == '.')
        continue;
    end
    ProtocolDir = bst_fullfile(BrainstormDbDir, dirList(i).name);
    [subjectFile, iDepthSubject] = file_find(ProtocolDir, 'brainstormsubject*.mat', 3);
    [studyFile, iDepthStudy]     = file_find(ProtocolDir, 'brainstormstudy*.mat',   3);
    if isempty(subjectFile) || isempty(studyFile) || (iDepthSubject ~= 3) || (iDepthSubject ~= 3)
        continue;
    end
    
    sProtocol = db_template('ProtocolInfo');
    [tmp__,sProtocol.Comment] = bst_fileparts(ProtocolDir, 1);
    sProtocol.SUBJECTS = bst_fileparts(bst_fileparts(subjectFile), 1);
    sProtocol.STUDIES  = bst_fileparts(bst_fileparts(studyFile), 1);
    tmp = db_edit_protocol('load', sProtocol);
    if ~isempty(tmp) && ~isequal(tmp, -1)
        iProtocols(end+1) = tmp;
    end
end

if ~isempty(iProtocols)
    gui_brainstorm('SetCurrentProtocol', iProtocols(1));
end"
1235,db_index.m,82.962,100,64.81,100,100.0,50.0,80-90,"function [t,r] = db_index(D, cl, C, p, q)
 


if isstruct(D), 
    switch D.type,
    case 'som_map', D = D.codebook; 
    case 'som_data', D = D.data; 
    end
end

[~, dim] = size(D);
u = unique(cl); 
c = length(u); 
if nargin <3, 
  C = zeros(c,dim); 
  for i=1:c, 
      me = nanstats(D(cl==u(i),:));
      C(i,:) = me';
  end 
end

u2i = zeros(max(u),1); u2i(u) = 1:c; 
D = som_fillnans(D,C,u2i(cl)); % replace NaN's with cluster centroid values

if nargin <4, p = 2; end % euclidian distance between cluster centers
if nargin <5, q = 2; end % dispersion = standard deviation
 

S = zeros(1, c);
for i = 1:c
  ind = find(cl==u(i)); % points in this cluster
  l   = length(ind);
  if l > 0
    S(i) = (mean(sqrt(sum((D(ind,:) - ones(l,1) * C(i,:)).^2,2)).^q))^(1/q);
  else
    S(i) = NaN;
  end
end
 
M = som_mdist(C,p); 

R = NaN * zeros(c);
r = NaN * zeros(c,1);
for i = 1:c
  for j = i+1:c
    R(i,j) = (S(i) + S(j))/M(i,j);
  end
  r(i) = max(R(i,:));
end
 
t = mean(r(isfinite(r)));
 
return;"
1236,db_load_protocol.m,83.332,100,64.58,100,100.0,52.08,80-90,"function isLoaded = db_load_protocol(iProtocols)


global GlobalData;

if (nargin < 1) || isempty(iProtocols)
    iProtocols = 1:length(GlobalData.DataBase.ProtocolInfo);
end
isLoaded = 0;

for i = 1:length(iProtocols)
    isReload = 0;
    ProtocolFile = bst_fullfile(GlobalData.DataBase.ProtocolInfo(iProtocols(i)).STUDIES, 'protocol.mat');
    if ~file_exist(ProtocolFile)
        isReload = 1;
    elseif ~file_attrib(ProtocolFile, 'r')
        disp(['BST> Error: Insufficient rights to read the protocol file ""' ProtocolFile '"".']);
        isReload = 1;
    end


    if ~isReload
        try
            ProtocolMat = load(ProtocolFile);
        catch
            disp(['BST> Error: Cannot read protocol file ""' ProtocolFile '"".']);
            isReload = 1;
        end
    end
    

    if ~isReload && (~isfield(ProtocolMat, 'DbVersion') || ~isfield(GlobalData.DataBase, 'DbVersion') || (GlobalData.DataBase.DbVersion ~= ProtocolMat.DbVersion))
        isReload = 1;
    end

    if isReload
        db_reload_database(iProtocols(i));
    else
        GlobalData.DataBase.ProtocolInfo(iProtocols(i)).iStudy            = ProtocolMat.ProtocolInfo.iStudy;
        GlobalData.DataBase.ProtocolInfo(iProtocols(i)).UseDefaultAnat    = ProtocolMat.ProtocolInfo.UseDefaultAnat;
        GlobalData.DataBase.ProtocolInfo(iProtocols(i)).UseDefaultChannel = ProtocolMat.ProtocolInfo.UseDefaultChannel;
        GlobalData.DataBase.ProtocolSubjects(iProtocols(i))   = ProtocolMat.ProtocolSubjects;
        GlobalData.DataBase.ProtocolStudies(iProtocols(i))    = ProtocolMat.ProtocolStudies;
        GlobalData.DataBase.isProtocolLoaded(iProtocols(i))   = 1;
        GlobalData.DataBase.isProtocolModified(iProtocols(i)) = 0;
        panel_protocols('UpdateTree');
    end
end"
1237,db_load_studies.m,83.75,100,66.67,100,100.0,52.08,80-90,"function db_load_studies(isTreeUpdate, isFix)


if (nargin < 1) || isempty(isTreeUpdate)
    isTreeUpdate = 1;
end
if (nargin < 2) || isempty(isFix)
    isFix = 1;
end

ProtocolInfo = bst_get('ProtocolInfo');
if isempty(ProtocolInfo)
    bst_error('No valid protocol selected. Please set Brainstorm variable iProtocol to a valid protocol index.', 'Reload studies', 0);
    return
elseif ~file_exist(ProtocolInfo.STUDIES)
    bst_error(['Data folder has been deleted or moved:' 10 ProtocolInfo.STUDIES], 'Reload studies', 0);
    return
elseif ~file_exist(bst_fullfile(ProtocolInfo.STUDIES, bst_get('DirDefaultStudy'))) || ...
       ~file_exist(bst_fullfile(ProtocolInfo.STUDIES, bst_get('DirAnalysisInter')))
    if isFix
        db_fix_protocol();
    else
        ProtocolSubjects = db_template('ProtocolSubjects');
        ProtocolStudies = db_template('ProtocolStudies');
        bst_set('ProtocolSubjects', ProtocolSubjects);
        bst_set('ProtocolStudies', ProtocolStudies);
    end
    bst_progress('stop');
    return;
end

rootStudyFiles = dir(bst_fullfile(ProtocolInfo.STUDIES, 'brainstormstudy*.mat'));
if (length(rootStudyFiles) > 1)
    warning('Brainstorm:InvalidDataDir', 'There is more than one brainstormstudy file in directory ''%s'' : ignoring directory.', ProtocolInfo.STUDIES);
elseif ~isempty(rootStudyFiles)
    try
        studyMat = load(bst_fullfile(ProtocolInfo.STUDIES, rootStudyFiles(1).name));
    catch
        warning('Brainstorm:CannotOpenFile', 'Cannot open file ''%s'' : ignoring study', rootStudyFiles(1).name);
        studyMat = [];
    end

    if ~isempty(studyMat)
        [fpath_, newDirName] = bst_fileparts(studyMat.BrainStormSubject);
        if (isempty(newDirName))
            newDirName = 'NoSubject';
        end
        
        if (file_exist(bst_fullfile(ProtocolInfo.STUDIES, newDirName)))
            newIndex = 1;
            while (file_exist(bst_fullfile(ProtocolInfo.STUDIES, sprintf('%s_%02d', newDirName, newIndex))))
                newIndex = newIndex + 1;
            end
            newDirName = sprintf('%s_%02d', newDirName, newIndex);
        end
        status = mkdir(ProtocolInfo.STUDIES, newDirName);
        if (status)
            status = file_move(bst_fullfile(ProtocolInfo.STUDIES, '*.*'), bst_fullfile(ProtocolInfo.STUDIES, newDirName));
            if (~status)
                warning('Brainstorm:CannotMoveFile', 'Cannot move files to directory ''%s''.', bst_fullfile(ProtocolInfo.STUDIES, rootStudyFiles(1).name), bst_fullfile(ProtocolInfo.STUDIES, newDirName));
            end
        else
            warning('Brainstorm:CannotCreateDir', 'Cannot create subject subdirectory ''%s''.', bst_fullfile(ProtocolInfo.STUDIES, newDirName));
        end
    end
end


ProtocolStudies = db_template('ProtocolStudies');
ProtocolStudies.Study = db_parse_study(ProtocolInfo.STUDIES, '', 130);
ProtocolStudies.AnalysisStudy = db_parse_study(ProtocolInfo.STUDIES, bst_get('DirAnalysisInter'), 10);
if (length(ProtocolStudies.AnalysisStudy) > 1)        
    disp('BST> Database error: multiple @inter studies found for the same protocol, please keep only one of the following:');
    for i = 1:length(ProtocolStudies.AnalysisStudy)
        disp(['BST>    ' ProtocolStudies.AnalysisStudy(i).FileName]);
    end
    ProtocolStudies.AnalysisStudy = ProtocolStudies.AnalysisStudy(1);
end
ProtocolStudies.DefaultStudy = db_parse_study(ProtocolInfo.STUDIES, bst_get('DirDefaultStudy'), 10);
if (length(ProtocolStudies.DefaultStudy) > 1)        
    disp('BST> Database error: multiple @default_study folders found for the same protocol, please keep only one of the following:');
    for i = 1:length(ProtocolStudies.DefaultStudy)
        disp(['BST>    ' ProtocolStudies.DefaultStudy(i).FileName]);
    end
    ProtocolStudies.DefaultStudy = ProtocolStudies.DefaultStudy(1);
end


bst_set('ProtocolStudies', ProtocolStudies);
db_links();
if isTreeUpdate
    panel_protocols('UpdateTree');
end


end"
1238,db_load_subjects.m,84.942,100,67.06,100,100.0,57.65,80-90,"function db_load_subjects(isTreeUpdate, isFix)


if (nargin < 1) || isempty(isTreeUpdate)
    isTreeUpdate = 1;
end
if (nargin < 2) || isempty(isFix)
    isFix = 1;
end

ProtocolInfo = bst_get('ProtocolInfo');
if isempty(ProtocolInfo)
    bst_error('No valid protocol selected. Please set Brainstorm context variable iProtocol to a valid protocol index.', 'Reload subject', 0);
    return
elseif ~file_exist(ProtocolInfo.SUBJECTS)
    bst_error(['Anatomy folder has been deleted or moved:' 10 ProtocolInfo.STUDIES], 'Reload studies', 0);
    return
elseif ~file_exist(bst_fullfile(ProtocolInfo.SUBJECTS, bst_get('DirDefaultSubject')))
    if isFix
        db_fix_protocol();
    else
        ProtocolSubjects = db_template('ProtocolSubjects');
        ProtocolStudies = db_template('ProtocolStudies');
        bst_set('ProtocolSubjects', ProtocolSubjects);
        bst_set('ProtocolStudies', ProtocolStudies);
    end
    bst_progress('stop');
    return;
end

rootSubjectFiles = dir(bst_fullfile(ProtocolInfo.SUBJECTS, 'brainstormsubject*.mat'));
if (length(rootSubjectFiles) > 1)
    warning('Brainstorm:InvalidSubjDir','There is more than one brainstormsubject file in directory ''%s'' : ignoring directory.', ProtocolInfo.SUBJECTS);
elseif ~isempty(rootSubjectFiles)
    try
        subjMat = load(bst_fullfile(ProtocolInfo.SUBJECTS, rootSubjectFiles(1).name));
    catch
        warning('Brainstorm:CannotOpenFile', 'Cannot open file ''%s'' : ignoring subject', rootSubjectFiles(1).name);
        subjMat = [];
    end

    if ~isempty(subjMat)
        newDirName = bst_fileparts(rootSubjectFiles(1).name);
        if (isempty(newDirName))
            newDirName = 'Unnamed';
        end
        newDirName = file_unique(newDirName);
        status = mkdir(ProtocolInfo.SUBJECTS, newDirName);
        if (status)
            status = file_move(bst_fullfile(ProtocolInfo.SUBJECTS, '*.*'), bst_fullfile(ProtocolInfo.SUBJECTS, newDirName));
            if (~status)
                warning('Brainstorm:CannotMoveFile', 'Cannot move subject file ''%s'' to directory ''%s''.', bst_fullfile(ProtocolInfo.SUBJECTS, rootSubjectFiles(1).name), bst_fullfile(ProtocolInfo.SUBJECTS, newDirName));
            end
        else
            warning('Brainstorm:CannotCreateDir', 'Cannot create subject subdirectory ''%s''.', bst_fullfile(ProtocolInfo.SUBJECTS, newDirName));
        end
    end
end


ProtocolSubjects = db_template('ProtocolSubjects');
ProtocolSubjects.DefaultSubject = db_parse_subject(ProtocolInfo.SUBJECTS, bst_get('DirDefaultSubject'), 5);
ProtocolSubjects.Subject = db_parse_subject(ProtocolInfo.SUBJECTS, '', 45);
bst_set('ProtocolSubjects', ProtocolSubjects);


if isempty(ProtocolInfo.UseDefaultAnat)
    if ~isempty(ProtocolSubjects.Subject) 
        ProtocolInfo.UseDefaultAnat = (nnz([ProtocolSubjects.Subject.UseDefaultAnat]) / length((ProtocolSubjects.Subject)) > 0.5);
        nbCat = [nnz([ProtocolSubjects.Subject.UseDefaultChannel] == 0), ...
                 nnz([ProtocolSubjects.Subject.UseDefaultChannel] == 1), ...
                 nnz([ProtocolSubjects.Subject.UseDefaultChannel] == 2)];
        ProtocolInfo.UseDefaultChannel = find(nbCat == max(nbCat), 1) - 1;
    else
        ProtocolInfo.UseDefaultAnat    = 1;
        ProtocolInfo.UseDefaultChannel = 2;
    end
    bst_set('ProtocolInfo', ProtocolInfo);
end

if isTreeUpdate
    panel_protocols('UpdateTree');
end

end"
1239,db_open.m,84.782,100,71.74,100,100.0,52.17,80-90,"function db_open(user, password, server, port, database)



persistent prev_filename

switch nargin
  case 0
    user     = 'fieldtrip';
    password = 'fieldtrip';
    server   = 'odin';
    port     = 3306;
    filename = sprintf('mysql://<%s>:<%s>@<%s>:<%d>', user, password, server, port);
  case 1
    filename = user;
    [user, password, server, port] = filetype_check_uri(filename);
  case 3
    filename = sprintf('mysql://<%s>:<%s>@<%s>', user, password, server);
  case 4
    filename = sprintf('mysql://<%s>:<%s>@<%s>:<%d>', user, password, server, port);
  case 5
    filename = sprintf('mysql://<%s>:<%s>@<%s>:<%d>/<%s>', user, password, server, port, database);
  otherwise
    ft_error('incorrect input arguments');
end

if ~strcmp(filename, prev_filename)
  mysql('close');
  prev_filename = [];
end

if ~strcmp(filename, prev_filename)
  if ~isempty(port)
    server = sprintf('%s:%d', server, port);
  end
  try
    mysql('open', server, user, password);
    if nargin==5
      mysql('use', database);
    end
    prev_filename = filename;
  catch
    prev_filename = [];
    ft_warning(lasterr);
  end
end"
1240,db_reload_conditions.m,85.442,100,69.77,90,100.0,67.44,80-90,"function iNewStudies = db_reload_conditions(iSubjects)


if isempty(iSubjects)
    return
end
iNewStudies = [];
ProtocolInfo = bst_get('ProtocolInfo');
ProtocolStudies = bst_get('ProtocolStudies');

isProgressBar = ~bst_progress('isVisible');
if isProgressBar
    bst_progress('start', 'Reload subject', 'Reloading datasets...', 0, 100 * length(iSubjects));
end
for i = 1:length(iSubjects)
    sSubject = bst_get('Subject', iSubjects(i), 1);
    [sOldStudies, iOldStudies] = bst_get('StudyWithSubject', sSubject.FileName, 'intra_subject', 'default_study');
    ProtocolStudies.Study(iOldStudies) = [];

    subjectSubDir = bst_fileparts(sSubject.FileName);
    if ~file_exist(ProtocolInfo.STUDIES)
        bst_error(['Data folder has been deleted or moved:' 10 ProtocolInfo.STUDIES], 'Reload studies', 0);
        return
    elseif ~file_exist(bst_fullfile(ProtocolInfo.STUDIES, subjectSubDir)) || ...
       ~file_exist(bst_fullfile(ProtocolInfo.STUDIES, subjectSubDir, bst_get('DirDefaultStudy'))) || ...
       ~file_exist(bst_fullfile(ProtocolInfo.STUDIES, subjectSubDir, bst_get('DirAnalysisIntra')))
        db_fix_protocol();
        bst_progress('stop');
        return
    end
    
    sReadStudies = db_parse_study(ProtocolInfo.STUDIES, subjectSubDir, 100);
    ProtocolStudies.Study = [ProtocolStudies.Study, sReadStudies];
    bst_set('ProtocolStudies', ProtocolStudies);
    db_links('Subject', iSubjects(i));
end

db_save();
panel_protocols('UpdateTree');
panel_protocols('SelectNode', [], 'studysubject', -1, iSubjects(1) );
if isProgressBar
    bst_progress('stop');
end"
1241,db_reload_database.m,87.548,100,77.36,100,100.0,60.38,80-90,"function isError = db_reload_database(iProtocolsList, isFix)


global GlobalData;

if (nargin < 2) || isempty(isFix)
    isFix = 1;
end
if (nargin < 1) || isempty(iProtocolsList)
    iProtocolsList = 1:length(GlobalData.DataBase.ProtocolInfo);
elseif ischar(iProtocolsList) && strcmpi(iProtocolsList, 'current')
    iProtocolsList = GlobalData.DataBase.iProtocol;
end
isError = zeros(1, length(iProtocolsList));
prevProtocol = GlobalData.DataBase.iProtocol;

isProgressBar = ~bst_progress('isVisible');
if isProgressBar
    bst_progress('start', 'Reload database', 'Reloading database...', 0, 200 * length(iProtocolsList));
end
for i = 1:length(iProtocolsList)
    bst_progress('set', 200 * (i - 1));
    bst_set('iProtocol', iProtocolsList(i));
    ProtocolInfo = GlobalData.DataBase.ProtocolInfo(iProtocolsList(i));
    if ~file_exist(ProtocolInfo.STUDIES) || ~file_exist(ProtocolInfo.SUBJECTS)
        disp(['BST> Error: Protocol ""' ProtocolInfo.Comment '"" is not accessible.']);
        isError(i) = 1;
        continue;
    end
    if isFix
        pos = bst_progress('get');
        isError(i) = db_fix_protocol();
        bst_progress('set', pos);
        if isError(i)
            continue
        end
    end
    bst_progress('text', ['""' ProtocolInfo.Comment '"": Reloading subjects...']);
    db_load_subjects(0, isFix);
    bst_progress('text', ['""' ProtocolInfo.Comment '"": Reloading datasets...']);
    db_load_studies(0, isFix);
    bst_progress('text', ['""' ProtocolInfo.Comment '"": Updating links...']);
    db_links();
end
bst_set('isProtocolLoaded', 1);
db_save();
if ~isempty(prevProtocol)
    gui_brainstorm('SetCurrentProtocol', prevProtocol);
end
if isProgressBar
    bst_progress('stop');
end
panel_protocols('UpdateTree');"
1242,db_reload_subjects.m,80.726,100,61.36,90,100.0,52.27,80-90,"function db_reload_subjects( iSubjects )


ProtocolInfo     = bst_get('ProtocolInfo');
ProtocolSubjects = bst_get('ProtocolSubjects');
if isempty(ProtocolSubjects) || any(iSubjects < 0) || any(iSubjects > length(ProtocolSubjects.Subject))
    error('Invalid subject indices');
end

isProgressBar = ~bst_progress('isVisible');
if isProgressBar
    bst_progress('start', 'Reload subject', 'Reloading subjects...', 0, 50 * length(iSubjects));
end
for i = 1:length(iSubjects)
    iSubject = iSubjects(i);
    if (iSubject == 0)
        subjectSubDir = bst_fileparts(ProtocolSubjects.DefaultSubject.FileName);
    else
        subjectSubDir = bst_fileparts(ProtocolSubjects.Subject(iSubject).FileName);
    end
    if ~file_exist(bst_fullfile(ProtocolInfo.SUBJECTS, subjectSubDir))
        db_fix_protocol();
        bst_progress('stop');
        return
    end
    sSubject = db_parse_subject(ProtocolInfo.SUBJECTS, subjectSubDir, 50);
    if isempty(sSubject)
        db_fix_protocol();
        bst_progress('stop');
        return
    end
    if (iSubject == 0)
        ProtocolSubjects.DefaultSubject = sSubject;
    else
        ProtocolSubjects.Subject(iSubject) = sSubject;
    end
end

bst_set('ProtocolSubjects', ProtocolSubjects);
panel_protocols('UpdateNode', 'Subject', iSubjects);
db_save();
if isProgressBar
    bst_progress('stop');
end"
1243,db_save.m,86.41,100,75.64,100,100.0,56.41,80-90,"function db_save(isIgnoreTime)


global GlobalData;
if (nargin < 1) || isempty(isIgnoreTime)
    isIgnoreTime = 0;
end

elapsed = toc(GlobalData.DataBase.LastSavedTime);
if ~isIgnoreTime && (elapsed < 10 * 60)
    return;
end

isProgress = bst_progress('isVisible');
bst_progress('start', 'Database auto-save', 'Saving database...');
if ~isfield(GlobalData.DataBase, 'isProtocolLoaded') || isempty(GlobalData.DataBase.isProtocolLoaded)
    GlobalData.DataBase.isProtocolLoaded = ones(1, length(GlobalData.DataBase.ProtocolInfo));
end
BstMat.iProtocol             = GlobalData.DataBase.iProtocol;
BstMat.ProtocolsListInfo     = GlobalData.DataBase.ProtocolInfo;
BstMat.ProtocolsListSubjects = GlobalData.DataBase.ProtocolSubjects;
BstMat.ProtocolsListStudies  = GlobalData.DataBase.ProtocolStudies;
BstMat.isProtocolLoaded      = GlobalData.DataBase.isProtocolLoaded;
BstMat.BrainStormDbDir       = GlobalData.DataBase.BrainstormDbDir;
BstMat.DbVersion             = GlobalData.DataBase.DbVersion;
BstMat.CloneLock             = GlobalData.Program.CloneLock;
BstMat.Colormaps             = GlobalData.Colormaps;
BstMat.ChannelMontages       = GlobalData.ChannelMontages;
BstMat.DataViewer.DefaultFactor = [];
BstMat.Pipelines   = GlobalData.Processes.Pipelines;
BstMat.Preferences = GlobalData.Preferences;
BstMat.Searches    = GlobalData.DataBase.Searches.All;
BstMat.Preferences.TopoLayoutOptions.TimeWindow = [];

for iProtocol = 1:length(GlobalData.DataBase.ProtocolInfo)
    if ~GlobalData.DataBase.isProtocolLoaded(iProtocol)
        continue;
    end
    ProtocolFile = bst_fullfile(GlobalData.DataBase.ProtocolInfo(iProtocol).STUDIES, 'protocol.mat');
    if ~file_attrib(ProtocolFile, 'w')
        continue;
    end
    BstMat.ProtocolsListSubjects(iProtocol) = db_template('ProtocolSubjects');
    BstMat.ProtocolsListStudies(iProtocol)  = db_template('ProtocolStudies');
    BstMat.isProtocolLoaded(iProtocol)      = 0;
    if ~GlobalData.DataBase.isProtocolModified(iProtocol)
        continue;
    end
    ProtocolMat.ProtocolInfo      = GlobalData.DataBase.ProtocolInfo(iProtocol);
    ProtocolMat.ProtocolSubjects  = GlobalData.DataBase.ProtocolSubjects(iProtocol);
    ProtocolMat.ProtocolStudies   = GlobalData.DataBase.ProtocolStudies(iProtocol);
    ProtocolMat.DbVersion         = GlobalData.DataBase.DbVersion;
    ProtocolMat.LastAccessDate    = datestr(now);
    ProtocolMat.LastAccessUserDir = bst_get('UserDir');
    ProtocolMat.ProtocolInfo = rmfield(ProtocolMat.ProtocolInfo, 'STUDIES');
    ProtocolMat.ProtocolInfo = rmfield(ProtocolMat.ProtocolInfo, 'SUBJECTS');
    disp(['BST> Saving protocol ""' ProtocolMat.ProtocolInfo.Comment '""...']);

    try
        bst_save(ProtocolFile, ProtocolMat, 'v7');
    catch
        disp(['BST> Error: Cannot save file ""' ProtocolFile '"".']);
        continue;
    end
    if (iProtocol ~= GlobalData.DataBase.iProtocol)
        GlobalData.DataBase.ProtocolSubjects(iProtocol) = db_template('ProtocolSubjects');
        GlobalData.DataBase.ProtocolStudies(iProtocol)  = db_template('ProtocolStudies');
        GlobalData.DataBase.isProtocolLoaded(iProtocol) = 0;
    end
end


BrainstormDbFile = bst_get('BrainstormDbFile');
bst_save(BrainstormDbFile, BstMat, 'v7');
GlobalData.DataBase.LastSavedTime = tic();
if ~isProgress
    bst_progress('stop');
end"
1244,db_select.m,87.728,100,81.82,100,100.0,56.82,80-90,"function s = db_select(tablename, fields, sel)



nfields  = length(fields);
fieldstr = sprintf('%s, ', fields{:});
fieldstr = fieldstr(1:(end-2)); % remove the last comma

if nargin>2
  cmd = sprintf('SELECT %s FROM %s LIMIT %d,1', fieldstr, tablename, sel-1);
else
  cmd = sprintf('SELECT %s FROM %s', fieldstr, tablename);
end

switch nfields
  case 1
    [t{1}] = mysql(cmd);
  case 2
    [t{1}, t{2}] = mysql(cmd);
  case 3
    [t{1}, t{2}, t{3}] = mysql(cmd);
  case 4
    [t{1}, t{2}, t{3}, t{4}] = mysql(cmd);
  case 5
    [t{1}, t{2}, t{3}, t{4}, t{5}] = mysql(cmd);
  case 6
    [t{1}, t{2}, t{3}, t{4}, t{5}, t{6}] = mysql(cmd);
  case 7
    [t{1}, t{2}, t{3}, t{4}, t{5}, t{6}, t{7}] = mysql(cmd);
  case 8
    [t{1}, t{2}, t{3}, t{4}, t{5}, t{6}, t{7}, t{8}] = mysql(cmd);
  case 9
    [t{1}, t{2}, t{3}, t{4}, t{5}, t{6}, t{7}, t{8}, t{9}] = mysql(cmd);
  otherwise
    ft_error('unsupported number of fields');
end

for i=1:nfields
  if isnumeric(t{i})
    t{i} = num2cell(t{i});
  end
end
s = {fields{:} ; t{:}};
s = struct(s{:});"
1245,db_set_channel.m,81.312,80,68.42,100,100.0,58.14,80-90,"function [OutputFile, ChannelMat, ChannelReplace, ChannelAlign, Modality, Tolerance] = db_set_channel( iStudy, ChannelMat, ChannelReplace, ChannelAlign, Tolerance)


if (nargin < 5) || isempty(Tolerance)
    Tolerance = 0;
end
if (nargin < 4) || isempty(ChannelAlign)
    ChannelAlign = 1;
end
if (nargin < 3) || isempty(ChannelReplace)
    ChannelReplace = 1;
end
if (nargin < 2) 
    error('Invalid call.');
end
Modality = [];
if (length(iStudy) > 1)
    OutputFile = {};
    for i = 1:length(iStudy)
        [OutputFile{end+1}, tmp, ChannelReplace, ChannelAlign] = db_set_channel(iStudy(i), ChannelMat, ChannelReplace, ChannelAlign);
    end
    return;
end

if ischar(ChannelMat)
    ChannelFile = ChannelMat;
    ChannelMat = in_bst_channel(ChannelFile);
    [fPath, fBase, fExt] = bst_fileparts(ChannelFile);
    OutputFile = [fBase, fExt];
elseif isstruct(ChannelMat)
    DeviceTag = channel_detect_device(ChannelMat);
    OutputFile = ['channel', DeviceTag, '.mat'];
end


sStudy = bst_get('Study', iStudy);
if ~isempty(sStudy.Channel)
    oldChannelFile = file_fullpath(sStudy.Channel.FileName);
    if (ChannelReplace == 0)
        OutputFile = [];
        return
    elseif (ChannelReplace == 1)
        res = java_dialog('confirm', [...
            '<HTML><B>Warning</B>: a channel file is already defined for this study.<BR>' ...
            'If you delete it, you might not be able to read your recordings anymore.<BR><BR>' ...
            '<FONT color=""#D00000"">If you are trying to <B>add 3D positions</B> to an existing dataset, answer NO,<BR>' ...
            'then right-click on the channel file > <B><U>Add EEG positions</U></B>.</FONT><BR><BR>' ...
            'Delete existing channel file ?'], 'Replace channel file');
        if ~res
            OutputFile = [];
            return
        end
        ChannelReplace = 2;
        file_delete(oldChannelFile, 1);
    end
end


if ~isfield(ChannelMat, 'Comment') || isempty(ChannelMat.Comment)
    ChannelMat.Comment = 'Channels';
end
ChannelMat.Comment = str_remove_parenth(ChannelMat.Comment, '(');
ChannelMat.Comment = [ChannelMat.Comment, sprintf(' (%d)', length(ChannelMat.Channel))];


ProtocolInfo = bst_get('ProtocolInfo');
OutputFile = bst_fullfile(bst_fileparts(sStudy.FileName), OutputFile);
OutputFileFull = bst_fullfile(ProtocolInfo.STUDIES, OutputFile);
bst_save(OutputFileFull, ChannelMat, 'v7');
sChannelDb = db_template('Channel');
sChannelDb.FileName   = OutputFile;
sChannelDb.Comment    = ChannelMat.Comment;
sChannelDb.nbChannels = length(ChannelMat.Channel);
[sChannelDb.Modalities, sChannelDb.DisplayableSensorTypes] = channel_get_modalities(ChannelMat.Channel);
if any(ismember({'MEG','MEG GRAD','MEG MAG'}, sChannelDb.DisplayableSensorTypes))
    Modality = 'MEG';
elseif ismember('EEG', sChannelDb.DisplayableSensorTypes)
    Modality = 'EEG';
elseif ismember('NIRS', sChannelDb.DisplayableSensorTypes)
    Modality = 'NIRS';
else
    Modality = [];
end
        

sStudy.Channel = sChannelDb;
bst_set('Study', iStudy, sStudy);
panel_protocols('UpdateNode', 'Study', iStudy);
db_save();


if (ChannelAlign >= 1)
    if (ChannelAlign == 1)
        if isempty(Modality)
            return;
        end
        bst_memory('UnloadAll', 'Forced');
        channel_align_manual(OutputFileFull, Modality, 0);
        isConfirm = 1;
    else
        isConfirm = 0;
    end
    
    [ChannelMat, R, T, isSkip, isUserCancel, strReport, Tolerance] = channel_align_auto(OutputFile, [], 0, isConfirm, Tolerance);
    if ~isSkip
        if isUserCancel
            ChannelAlign = 0;
        elseif ~isempty(ChannelMat)
            ChannelAlign = 2;
        else
            ChannelAlign = 0;
        end
    end
end"
1246,db_set_clusters.m,82.338,100,69.88,90,100.0,51.81,80-90,"function OutputFiles = db_set_clusters(ChannelFile, Target, Clusters)


OutputFiles = {};
if (nargin < 3)
    Clusters = [];
    isInputCluster = 0;
else
    isInputCluster = 1;
end

if ~isempty(ChannelFile)
    [sSrcStudy, iSrcStudy] = bst_get('AnyFile', ChannelFile);
    if isempty(iSrcStudy)
        error(['Invalid channel file: ' ChannelFile]);
    end
    if ~isInputCluster
        ChannelMat = in_bst_channel(ChannelFile, 'Clusters');
        Clusters = ChannelMat.Clusters;
    end
else
    iSrcStudy = [];
end

if isnumeric(Target)
    iDestStudies = Target;
elseif strcmpi(Target, 'AllConditions')
    if isempty(iSrcStudy)
        error('When using option ''AllConditions'', the first argument must be the path to a channel file.');
    end
    [sDestStudies, iDestStudies] = bst_get('StudyWithSubject', sSrcStudy.BrainStormSubject);
elseif strcmpi(Target, 'AllSubjects')
    ProtocolSubjects = bst_get('ProtocolSubjects');
    [uniqueSubjects, iUniqueSubjects] = sort({ProtocolSubjects.Subject.Name});
    iDestStudies = [];
    for iSubj = 1:length(uniqueSubjects)
        iSubject = iUniqueSubjects(iSubj);
        SubjectFile = ProtocolSubjects.Subject(iSubject).FileName;
        [sStudies, iStudies] = bst_get('StudyWithSubject', SubjectFile, 'intra_subject', 'default_study');
        iDestStudies = [iDestStudies, iStudies];
    end
else 
    return;
end
if ~isempty(iSrcStudy)
    iDestStudies = setdiff(iDestStudies, iSrcStudy);
end
if isempty(iDestStudies)
    disp('BST> Warning: db_set_cluster: No channel file to update.');
    return;
end
DestChannelFiles = cell(1, length(iDestStudies));
for i = 1:length(iDestStudies)
    sChannel = bst_get('ChannelForStudy', iDestStudies(i));
    if ~isempty(sChannel)
        DestChannelFiles{i} = sChannel.FileName;
    end
end
iEmpty = find(cellfun(@isempty, DestChannelFiles));
if ~isempty(iEmpty)
    DestChannelFiles(iEmpty) = [];
end
DestChannelFiles = unique(DestChannelFiles);


for iFile = 1:length(DestChannelFiles)
    ChannelFileFull = file_fullpath(DestChannelFiles{iFile});
    ChannelMat = load(ChannelFileFull);
    if ~isfield(ChannelMat, 'Clusters') || isempty(ChannelMat.Clusters) || isempty(Clusters)
        ChannelMat.Clusters = repmat(db_template('cluster'), 1, 0);
    end
    for iClustSrc = 1:length(Clusters)
        iClustDest = find(strcmpi({ChannelMat.Clusters.Label}, Clusters(iClustSrc).Label));
        if isempty(iClustDest)
            iClustDest = length(ChannelMat.Clusters) + 1;
        end
        for f = fieldnames(Clusters)'
            ChannelMat.Clusters(iClustDest).(f{1}) = Clusters(iClustSrc).(f{1});
        end
    end
    bst_save(ChannelFileFull, ChannelMat, 'v7');
end
OutputFiles = DestChannelFiles;"
1247,db_set_headmodel.m,83.714,100,67.86,90,100.0,60.71,80-90,"function OutputFiles = db_set_headmodel(HeadModelFile, Target)


OutputFiles = {};

[sSrcStudy, iSrcStudy] = bst_get('AnyFile', HeadModelFile);
    
if isnumeric(Target)
    iDestStudies = Target;
elseif strcmpi(Target, 'AllConditions')
    [sDestStudies, iDestStudies] = bst_get('StudyWithSubject', sSrcStudy.BrainStormSubject);
elseif strcmpi(Target, 'AllSubjects')
    ProtocolSubjects = bst_get('ProtocolSubjects');
    [uniqueSubjects, iUniqueSubjects] = sort({ProtocolSubjects.Subject.Name});
    iDestStudies = [];
    for iSubj = 1:length(uniqueSubjects)
        iSubject = iUniqueSubjects(iSubj);
        SubjectFile = ProtocolSubjects.Subject(iSubject).FileName;
        [sStudies, iStudies] = bst_get('StudyWithSubject', SubjectFile, 'intra_subject', 'default_study');
        iDestStudies = [iDestStudies, iStudies];
    end
else 
    return;
end

nCopied = 0;
for i = 1:length(iDestStudies)
    iDestStudy = iDestStudies(i);
    destStudy = bst_get('Study', iDestStudy);
    
    if iDestStudy == iSrcStudy
        continue;
    end
    
    conditionName = destStudy.Condition{1};
    if (length(conditionName) > 4 && strcmpi(conditionName(1:4), '@raw')) || isempty(destStudy.Channel)
        continue;
    end
    
    destHeadModel = bst_get('HeadModelForStudy', iDestStudy);
    if ~isempty(destHeadModel)
        destSubject = bst_get('Subject', destStudy.BrainStormSubject);
        disp(['BST> Study ""' conditionName '"" of subject ""' destSubject.Name '"" already contains a head model. Skipping.']);
        continue;
    end
    
    OutputFiles{end + 1} = panel_protocols('CopyFile', iDestStudy, HeadModelFile, 'headmodel', iSrcStudy);
    nCopied = nCopied + 1;
end

if nCopied > 0
    db_reload_studies(iDestStudies);
else
    java_dialog('warning', ['No file was copied. To avoid errors, folders with existing head models, only raw data, or without channel file' 10 ...
        'are not supported by this process. You need to copy them manually via File -> Copy/Paste.']);
end"
1248,db_set_noisecov.m,84.136,100,73.86,90,100.0,56.82,80-90,"function OutputFiles = db_set_noisecov(iSrcStudy, Target, isDataCov, ReplaceFile)


if (nargin < 4) || isempty(ReplaceFile)
    ReplaceFile = [];
end
if (nargin < 3) || isempty(isDataCov)
    isDataCov = 0;
end
OutputFiles = {};

sSrcStudy = bst_get('Study', iSrcStudy);
if isempty(sSrcStudy.Channel)
    error('This operation requires that you have a channel file defined in the source and destination studies.');
end
if isempty(sSrcStudy.NoiseCov) || (~isDataCov && isempty(sSrcStudy.NoiseCov(1).FileName)) || (isDataCov && ((length(sSrcStudy.NoiseCov) < 2) || isempty(sSrcStudy.NoiseCov(2).FileName)))
    error('No noise covariance available in the source study.');
end
    
if isnumeric(Target)
    iDestStudies = Target;
elseif strcmpi(Target, 'AllConditions')
    [sDestStudies, iDestStudies] = bst_get('StudyWithSubject', sSrcStudy.BrainStormSubject);
elseif strcmpi(Target, 'AllSubjects')
    ProtocolSubjects = bst_get('ProtocolSubjects');
    [uniqueSubjects, iUniqueSubjects] = sort({ProtocolSubjects.Subject.Name});
    iDestStudies = [];
    for iSubj = 1:length(uniqueSubjects)
        iSubject = iUniqueSubjects(iSubj);
        SubjectFile = ProtocolSubjects.Subject(iSubject).FileName;
        [sStudies, iStudies] = bst_get('StudyWithSubject', SubjectFile, 'intra_subject', 'default_study');
        iDestStudies = [iDestStudies, iStudies];
    end
else 
    return;
end
[sDestChannels, iDestChanStudies] = bst_get('ChannelForStudy', iDestStudies);
iDestChanStudies = unique(iDestChanStudies);
iDestChanStudies = setdiff(iDestChanStudies, iSrcStudy);
if isempty(iDestChanStudies)
    error('No destination studies.');
end

if isDataCov
    SrcNoiseCovMat = load(file_fullpath(sSrcStudy.NoiseCov(2).FileName));
else
    SrcNoiseCovMat = load(file_fullpath(sSrcStudy.NoiseCov(1).FileName));
end
SrcChannelMat = in_bst_channel(sSrcStudy.Channel.FileName);

for i = 1:length(iDestChanStudies)
    iDestStudy = iDestChanStudies(i);
    sDestStudy = bst_get('Study', iDestStudy);
    if isempty(sDestStudy.Channel) || isempty(sDestStudy.Channel.FileName)
        disp(['BST> Warning: No channel file in ' bst_fileparts(sDestStudy.FileName) ': Ignoring condition...']);
        continue;
    end
    DestChannelMat = in_bst_channel(sDestStudy.Channel.FileName);
    nbDestChan = length(DestChannelMat.Channel);
    DestNoiseCovMat = SrcNoiseCovMat;
    DestNoiseCovMat.NoiseCov = zeros(nbDestChan);
    
    iSrcChan = [];
    iDestChan = [];
    for iChan = 1:nbDestChan
        iTmp = find(strcmpi({SrcChannelMat.Channel.Name}, DestChannelMat.Channel(iChan).Name));
        if ~isempty(iTmp) && ~isempty(DestChannelMat.Channel(iChan).Name)
            iDestChan(end+1) = iChan;
            iSrcChan(end+1) = iTmp(1);
        end
    end
    
    if ~isempty(iDestChan)
        DestNoiseCovMat.NoiseCov(iDestChan,iDestChan) = SrcNoiseCovMat.NoiseCov(iSrcChan,iSrcChan);
        if isfield(SrcNoiseCovMat, 'FourthMoment') && ~isempty(SrcNoiseCovMat.FourthMoment)
            DestNoiseCovMat.FourthMoment = zeros(nbDestChan);
            DestNoiseCovMat.FourthMoment(iDestChan,iDestChan) = SrcNoiseCovMat.FourthMoment(iSrcChan,iSrcChan);
        end
        if isfield(SrcNoiseCovMat, 'nSamples') && ~isempty(SrcNoiseCovMat.nSamples)
            DestNoiseCovMat.nSamples = zeros(nbDestChan);
            DestNoiseCovMat.nSamples(iDestChan,iDestChan) = SrcNoiseCovMat.nSamples(iSrcChan,iSrcChan);
        end
        NewFile = import_noisecov(iDestStudy, DestNoiseCovMat, ReplaceFile, isDataCov);
        if ~isempty(NewFile) && ischar(NewFile)
            OutputFiles{end+1} = NewFile;
        end
    end
end"
1249,db_set_template.m,82.482,80,68.07,100,100.0,64.34,80-90,"function db_set_template( iSubject, sTemplate, isInteractive )



if (nargin < 3) || isempty(isInteractive)
    isInteractive = 1;
end
sSubject = bst_get('Subject', iSubject);
ProtocolInfo = bst_get('ProtocolInfo');
targetDir = bst_fullfile(ProtocolInfo.SUBJECTS, bst_fileparts(sSubject.FileName));
if isInteractive && (~isempty(sSubject.Anatomy) || ~isempty(sSubject.Surface))
    if ~java_dialog('confirm', ['Warning: There is already an anatomy defined for this subject.' 10 10 ...
        'Are you sure you want to delete the previous MRI and surfaces ?' 10 10], 'Use default anatomy');
        return;
    end
end


if ischar(sTemplate)
    TemplateName = sTemplate;
    sTemplate = bst_get('AnatomyDefaults', TemplateName);
    if isempty(sTemplate)
        error(['Invalid template name: ' TemplateName]);
    end
end
if isdir(sTemplate.FilePath)
    templateDir = sTemplate.FilePath;
    isDeleteDir = 0;
else
    templateDir = bst_fullfile(bst_get('BrainstormTmpDir'), sTemplate.Name);
    if file_exist(templateDir)
        file_delete(templateDir, 1, 3);
    end
    mkdir(templateDir);
    if ~isempty(strfind(sTemplate.FilePath, 'http://')) || ~isempty(strfind(sTemplate.FilePath, 'https://')) || ~isempty(strfind(sTemplate.FilePath, 'ftp://'))
        ZipFile = bst_fullfile(bst_get('UserDefaultsDir'), 'anatomy', [sTemplate.Name '.zip']);
        errMsg = gui_brainstorm('DownloadFile', sTemplate.FilePath, ZipFile, 'Download template');
        if ~isempty(errMsg)
            if isInteractive
                bst_error(['Impossible to download template:' 10 errMsg], 'Download error', 0);
                return
            else
                error(['Impossible to download template: ' errMsg]);
            end
        end
    elseif ~isempty(strfind(sTemplate.FilePath, '.zip'))
        ZipFile = sTemplate.FilePath;
    else
        error('Invalid template.');
    end
    bst_progress('start', 'Import template', 'Unzipping file...');
    try
        unzip(ZipFile, templateDir);
    catch
        errMsg = ['Could not unzip anatomy template: ' 10 10 lasterr];
        disp(['BST> Error: ' errMsg]);
        if isInteractive
            if java_dialog('confirm', [errMsg 10 10 'Delete invalid template file?' 10 10], 'Use default anatomy');
                file_delete(ZipFile, 1);
            end
        end
        bst_progress('stop');
        return;
    end
    isDeleteDir = 1;
end


bst_memory('UnloadAll', 'Forced');
if isempty(templateDir) || ~isdir(templateDir) || isempty(dir(bst_fullfile(templateDir, 'brainstormsubject*.mat')))
    error(['Invalid template directory : ""' strrep(templateDir, '\\', '\\\\') '"".']);
end
bst_progress('start', 'Import template', 'Copying template files...');
file_delete(bst_fullfile(targetDir, '*.bin'), 1);
file_delete(bst_fullfile(targetDir, '*.bak'), 1);
file_delete(bst_fullfile(targetDir, '*_openmeeg.mat'), 1);
dirFiles = dir(bst_fullfile(targetDir, '*.mat'));
for i = 1:length(dirFiles)
    fileType = file_gettype(dirFiles(i).name);
    if ~strcmpi(fileType, 'brainstormsubject')
        file_delete(bst_fullfile(targetDir, dirFiles(i).name), 1);
    end
end
dirFiles = dir(bst_fullfile(templateDir, '*.mat'));
for i = 1:length(dirFiles)
    fileType = file_gettype(dirFiles(i).name);
    switch (fileType)
        case 'brainstormsubject'
            tempSubjMat = load(bst_fullfile(templateDir, dirFiles(i).name));
            targetSubjFile = file_fullpath(sSubject.FileName);
            targetSubjMat = load(targetSubjFile);
            for f = {'Anatomy', 'Scalp', 'Cortex', 'InnerSkull', 'OuterSkull', 'FEM'}
                if isfield(tempSubjMat, f{1}) && ~isempty(tempSubjMat.(f{1}))
                    [tmp, fBase, fExt] = bst_fileparts(tempSubjMat.(f{1}));
                    targetSubjMat.(f{1}) = [bst_fileparts(sSubject.FileName), '/', [fBase, fExt]];
                end
            end
            bst_save(targetSubjFile, targetSubjMat, 'v7');
        case {'subjectimage', 'tess', 'cortex', 'scalp', 'outerskull', 'innerskull', 'fibers', 'fem'}
            file_copy(bst_fullfile(templateDir, dirFiles(i).name), targetDir);
        case 'channel'
            eegDefDir = bst_fullfile(bst_get('UserDefaultsDir'), 'eeg');
            eegTargetDir = bst_fullfile(eegDefDir, sTemplate.Name);
            if ~isdir(eegTargetDir)
                mkdir(eegTargetDir);
            end
            if isdir(eegTargetDir)
                file_copy(bst_fullfile(templateDir, dirFiles(i).name), eegTargetDir);
                disp(['BST> Installed new EEG template: ' bst_fullfile(eegTargetDir, dirFiles(i).name)]);
            end
    end
end

db_reload_subjects(iSubject);
sSubject = bst_get('Subject', iSubject);
bst_progress('stop');
if isDeleteDir
    file_delete(templateDir, 1, 3);
end"
1250,db_surface_type.m,84.666,100,83.33,90,100.0,50.0,80-90,"function newFileName = db_surface_type(SurfaceFile, targetType)


newFileName = '';
SurfaceFileFull = file_fullpath(SurfaceFile);
[sSubject, iSubject, iSurf] = bst_get('SurfaceFile', SurfaceFile);
initType = sSubject.Surface(iSurf).SurfaceType;
if strcmpi(initType, targetType)
    newFileName = SurfaceFile;
    return;
end

switch targetType
    case {'Scalp', 'Head'}
        targetTag = 'tess_scalp';
    case 'Cortex'
        targetTag = 'tess_cortex';
    case 'OuterSkull'
        targetTag = 'tess_outerskull';
    case 'InnerSkull'
        targetTag = 'tess_innerskull';
    case 'Fibers'
        targetTag = 'tess_fibers';
    case 'FEM'
        targetTag = 'tess_fem'; 
    case 'Other'
        targetTag = 'tess';
end

[isOk, newSurfaceFileFull] = file_update(SurfaceFileFull, 'FileType', targetTag);
if ~isOk
    return
end
newFileName = file_short(newSurfaceFileFull);
bst_history('add', newSurfaceFileFull, 'set_type', ['Set surface type: ' targetType]);

sSubject.Surface(iSurf).SurfaceType = targetType;
sSubject.Surface(iSurf).FileName    = newFileName;
sSubject.iScalp      = setdiff(sSubject.iScalp,      iSurf);
sSubject.iCortex     = setdiff(sSubject.iCortex,     iSurf);
sSubject.iOuterSkull = setdiff(sSubject.iOuterSkull, iSurf);
sSubject.iInnerSkull = setdiff(sSubject.iInnerSkull, iSurf);
sSubject.iFibers     = setdiff(sSubject.iFibers,     iSurf);
sSubject.iFEM        = setdiff(sSubject.iFEM,        iSurf);
sSubject.iOther      = setdiff(sSubject.iOther,      iSurf);
bst_set('Subject', iSubject, sSubject);

if ~strcmpi(targetType, 'Other')   
    db_surface_default(iSubject, targetType, iSurf);
end
if ~strcmpi(initType, 'Other')  
    db_surface_default(iSubject, initType);
end
db_save();"
1251,DC1_DTLZ1.m,86.938,100,77.55,100,100.0,57.14,80-90,"classdef DC1_DTLZ1 < PROBLEM


    methods
        function Setting(obj)
            if isempty(obj.M); obj.M = 3; end
            if isempty(obj.D); obj.D = obj.M + 4; end
            obj.lower    = zeros(1,obj.D);
            obj.upper    = ones(1,obj.D);
            obj.encoding = ones(1,obj.D);
        end
        function PopObj = CalObj(obj,PopDec)
            g      = 100*(obj.D-obj.M+1+sum((PopDec(:,obj.M:end)-0.5).^2-cos(20.*pi.*(PopDec(:,obj.M:end)-0.5)),2));
            PopObj = 0.5*repmat(1+g,1,obj.M).*fliplr(cumprod([ones(size(PopDec,1),1),PopDec(:,1:obj.M-1)],2)).*[ones(size(PopDec,1),1),1-PopDec(:,obj.M-1:-1:1)];
        end
        function PopCon = CalCon(obj,PopDec)
            PopCon = 0.5 - cos(3*pi*PopDec(:,1));
        end
        function R = GetOptimum(obj,N)
            R = UniformPoint(N,obj.M);
            x = zeros(size(R,1),obj.M-1);
            for i = 1 : size(R,1)
                for j = 2 : obj.M
                    temp = R(i,j)./R(i,1).*prod(x(i,obj.M-j+2:obj.M-1));
                    x(i,obj.M-j+1) = 1./(1+temp);
                end
            end
            R(cos(3*pi*x(:,1))<0.5,:) = [];
            R = R/2;
        end
        function R = GetPF(obj)
            if obj.M == 2
                R(:,1) = linspace(0,1,100)';
                R(:,2) = 1 - R(:,1);
                R(cos(3*pi*R(:,1))<0.5,:) = nan;
                R = R/2;
            elseif obj.M == 3
                a = linspace(0,1,10)';
                x = a*a';
                y = a*(1-a');
                z = (1-a)*ones(size(a'));
                z(cos(3*pi*a*ones(size(a')))<0.5) = nan;
                R = {x/2,y/2,z/2};
            else
                R = [];
            end
        end
    end
end"
1252,DC1_DTLZ3.m,86.53,100,79.59,100,100.0,53.06,80-90,"classdef DC1_DTLZ3 < PROBLEM


    methods
        function Setting(obj)
            if isempty(obj.M); obj.M = 3; end
            if isempty(obj.D); obj.D = obj.M + 9; end
            obj.lower    = zeros(1,obj.D);
            obj.upper    = ones(1,obj.D);
            obj.encoding = ones(1,obj.D);
        end
        function PopObj = CalObj(obj,PopDec)
            g      = 10*(obj.D-obj.M+1+sum((PopDec(:,obj.M:end)-0.5).^2-cos(20.*pi.*(PopDec(:,obj.M:end)-0.5)),2));
            PopObj = repmat(1+g,1,obj.M).*fliplr(cumprod([ones(size(PopDec,1),1),cos(PopDec(:,1:obj.M-1)*pi/2)],2)).*[ones(size(PopDec,1),1),sin(PopDec(:,obj.M-1:-1:1)*pi/2)];
        end
        function PopCon = CalCon(obj,PopDec)
            PopCon = 0.5 - cos(3*pi*PopDec(:,1));
        end
        function R = GetOptimum(obj,N)
            R = UniformPoint(N,obj.M);
            R = R./repmat(sqrt(sum(R.^2,2)),1,obj.M);
            c = zeros(size(R,1),obj.M-1);
            for i = 1 : size(R,1)
                for j = 2 : obj.M
                    temp = R(i,j)./R(i,1).*prod(c(i,obj.M-j+2:obj.M-1));
                    c(i,obj.M-j+1) = sqrt(1./(1+temp^2));
                end
            end
            R(cos(6*acos(c(:,1)))<0.5,:) = [];
        end
        function R = GetPF(obj)
            if obj.M == 2
                x      = linspace(0,pi/2,100)';
                R(:,1) = cos(x);
                R(:,2) = sin(x);
                R(cos(6*x)<0.5,:) = nan;
            elseif obj.M == 3
                a = linspace(0,pi/2,10)';
                x = cos(a)*cos(a');
                y = cos(a)*sin(a');
                z = sin(a)*ones(size(a'));
                z(cos(6*a*ones(size(a')))<0.5) = nan;
                R = {x,y,z};
            else
                R = [];
            end
        end
    end
end"
1253,dc2dc_v000.m,84.714,100,85.71,75,100.0,62.86,80-90,"function [At, Qt, Rt]=dc2dc(A,Q,R,dt,mode,dtn)
nst=size(A,1);
Rt=R;
if (mode==0)    %cont 2 disc
    M = dt*[-A,Q;zeros(nst),A'];
    N = expm(M);
    At = N(nst+1:2*nst,nst+1:2*nst)';
    Qt = At*N(1:nst,nst+1:2*nst);
    if (~isempty(R))
        Rt=R/dt;
    end
elseif (mode==1)    %disc 2 cont
    At=logm(A)/dt;      %achtung: eig(A) must not contain ""0""
    mx_a=expm(At'*dt);
    mx_b=expm(-At*dt);
    mx_c=mx_b*Q;
    
    M=logm([mx_b mx_c;zeros(nst) mx_a]);
    Qt=M(1:nst,nst+1:2*nst)/dt;
    
    if (~isempty(R))
        Rt=R*dt;
    end
elseif (mode==2) %d2d in discrete time
    n=round(dtn/dt);
    At=A^n;
    Qt=Q;
    for in=2:n
        Qt=A*Qt*A'+Q;
    end
    Rt=R/n;
elseif (mode==3) %d2d via continuous time
    [Ac, Qc, Rc]=dc2dc_v000(A,Q,R,dt,1);
    [At, Qt, Rt]=dc2dc_v000(Ac,Qc,Rc,dtn,0);
end"
1254,DC2_DTLZ1.m,87.428,100,77.14,100,100.0,60.0,80-90,"classdef DC2_DTLZ1 < PROBLEM


    methods
        function Setting(obj)
            if isempty(obj.M); obj.M = 3; end
            if isempty(obj.D); obj.D = obj.M + 4; end
            obj.lower    = zeros(1,obj.D);
            obj.upper    = ones(1,obj.D);
            obj.encoding = ones(1,obj.D);
        end
        function PopObj = CalObj(obj,PopDec)
            g      = 100*(obj.D-obj.M+1+sum((PopDec(:,obj.M:end)-0.5).^2-cos(20.*pi.*(PopDec(:,obj.M:end)-0.5)),2));
            PopObj = 0.5*repmat(1+g,1,obj.M).*fliplr(cumprod([ones(size(PopDec,1),1),PopDec(:,1:obj.M-1)],2)).*[ones(size(PopDec,1),1),1-PopDec(:,obj.M-1:-1:1)];
        end
        function PopCon = CalCon(obj,PopDec)
            g = 100*(obj.D-obj.M+1+sum((PopDec(:,obj.M:end)-0.5).^2-cos(20.*pi.*(PopDec(:,obj.M:end)-0.5)),2));
            PopCon(:,1) = 0.5 - cos(3*pi*g);
            PopCon(:,2) = 0.5 - exp(-g);
        end
        function R = GetOptimum(obj,N)
            R = UniformPoint(N,obj.M)/2;
        end
        function R = GetPF(obj)
            if obj.M == 2
                R = obj.GetOptimum(100);
            elseif obj.M == 3
                a = linspace(0,1,10)';
                R = {a*a'/2,a*(1-a')/2,(1-a)*ones(size(a'))/2};
            else
                R = [];
            end
        end
    end
end"
