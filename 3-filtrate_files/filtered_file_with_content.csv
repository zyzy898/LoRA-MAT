2544,comp_snr.m,79.404,100,59.65,90,100.0,47.37,70-80,"function [snr_mean, segsnr_mean]= comp_snr(cleanFile, enhdFile, f_s);

data1= cleanFile; 
data2= enhdFile; 
Srate1= f_s;
[snr_dist, segsnr_dist]= snr( data1, data2,Srate1);

snr_mean= snr_dist;
segsnr_mean= mean( segsnr_dist);


function [overall_snr, segmental_snr] = snr(clean_speech, processed_speech,sample_rate)


clean_length      = length(clean_speech);
processed_length  = length(processed_speech);

if (clean_length ~= processed_length)
  disp('Error: Both Speech Files must be same length.');
  return
end




overall_snr = 10* log10( sum(clean_speech.^2)/sum((clean_speech-processed_speech).^2));



winlength   = round(30*sample_rate/1000); %240;		   % window length in samples for 30-msecs
skiprate    = floor(winlength/4); %60;		   % window skip in samples
MIN_SNR     = -10;		   % minimum SNR in dB
MAX_SNR     =  35;		   % maximum SNR in dB


num_frames = clean_length/skiprate-(winlength/skiprate); % number of frames
start      = 1;					% starting sample
window     = 0.5*(1 - cos(2*pi*(1:winlength)'/(winlength+1)));

for frame_count = 1: num_frames


   clean_frame = clean_speech(start:start+winlength-1);
   processed_frame = processed_speech(start:start+winlength-1);
   clean_frame = clean_frame.*window;
   processed_frame = processed_frame.*window;


   signal_energy = sum(clean_frame.^2);
   noise_energy  = sum((clean_frame-processed_frame).^2);
   segmental_snr(frame_count) = 10*log10(signal_energy/(noise_energy+eps)+eps);
   segmental_snr(frame_count) = max(segmental_snr(frame_count),MIN_SNR);
   segmental_snr(frame_count) = min(segmental_snr(frame_count),MAX_SNR);

   start = start + skiprate;

end"
2545,comp_struct_old.m,77.948,80,68.68,100,100.0,41.06,70-80,"function [df, match, er1, er2] = comp_struct(s1,s2,prt,pse,tol,n1,n2,wbf)

if nargin < 1; help comp_struct; error('I / O error'); end
if nargin < 2; s2 = s1; prt = 3; end
if nargin < 3 || isempty(prt); prt = 1; end
if nargin < 4 || isempty(pse); pse = 0; elseif pse ~= 1 && prt == 0; pse = 0; end
if nargin < 5 || isempty(tol); tol = 1e-6; end
if nargin < 6 || isempty(s1); n1 = 's1'; end
if nargin < 7 || isempty(s2); n2 = 's2'; end
if nargin < 8 || isempty(wbf); wbf = 1; end
if pse > prt, pse = prt; end

[match, er1, er2] = comp_struct_loop(s1,s2,prt,pse,tol,n1,n2,wbf);

eval([char(n1) ' = s1;']);
eval([char(n2) ' = s2;']);

ner1 = numel(er1); ner2 = numel(er2);
if ner1 ~= ner2
	error(char('Something went very wrong in capturing errors.', ...
		'If possible, please email the two structures to moarant@gmail.com'));
else
	n = ner1;
end

df = cell(n,3);
for ii = 1:n
	temp1 = er1{ii}; temp2 = er2{ii};
	
	if isempty(regexp(temp2,'is missing', 'once'))
		df{ii,1} = temp2;
		if isempty(regexp(temp2,'is unique', 'once'))
			junk = regexp(temp2,' ','once');
			df{ii,3} = eval(temp2(1:junk-1));
		else
			junk = regexp(temp2,' ','once'); temp2(junk:end) = [];
			junk = strfind(temp2,'.'); trash = temp2(junk+1:end); temp2(junk:end) = [];
			if isempty(trash)
				df{ii,3} = eval(['fieldnames(' temp2 ')'])';
			else
				if (numel(eval(temp2)) - 1)
					df{ii,3} = sprintf('%s(#%g).%s is class %s', ...
						temp2,numel(eval(temp2)),trash,class(eval([temp2 '.' trash])));
				else
					df{ii,3} = eval([temp2 '.' trash]);
				end
			end
		end
	end
	if isempty(regexp(temp1,'is missing', 'once'))
		df{ii,1} = temp1;
		if isempty(regexp(temp1,'is unique', 'once'))
			junk = regexp(temp1,' ','once');
			df{ii,2} = eval([temp1(1:junk-1)]);
		else
			junk = regexp(temp1,' ','once'); temp1(junk:end) = [];
			junk = strfind(temp1,'.'); trash = temp1(junk+1:end); temp1(junk:end) = [];
			if isempty(trash)
				df{ii,2} = eval(['fieldnames(' temp1 ')'])';
			else
				if (numel(eval(temp1)) - 1)
					df{ii,2} = sprintf('%s(#%g).%s is class %s', ...
						temp1,numel(eval(temp1)),trash,class(eval([temp1 '.' trash])));
				else
					df{ii,2} = eval([temp1 '.' trash]);
				end
			end
		end
	end
end

if prt
	fprintf('\\n Error table\\n');
	for ii = 1:n
		fprintf('\\n%s    \\n',df{ii,1});
		fprintf('Structure 1:  ');
		if isempty(df{ii,2}); fprintf('\\n'); else; disp(df{ii,2}); end
		fprintf('Structure 2:  ');
		if isempty(df{ii,3}); fprintf('\\n'); else; disp(df{ii,3}); end	
	end
	fprintf('\\n\\n\\n\\n\\n');
end



function [match, er1, er2] = comp_struct_loop(s1,s2,prt,pse,tol,n1,n2,wbf)

match = {}; er1 = {}; er2 = {}; 

if isstruct(s1) && isstruct(s2)
	fn1 = fieldnames(s1);
	fn2 = fieldnames(s2);
	temp1 = ismember(fn1,fn2);
	temp2 = ismember(fn2,fn1);
	for ii = find(~temp2)'
		er1{end+1} = sprintf('%s is missing field %s',n1,fn2{ii});
		er2{end+1} = sprintf('%s.%s is unique',n2,fn2{ii});
		if prt > 1; fprintf('%s\\n',er1{end}); end; if pse; pause; end
	end
	for ii = find(~temp1)'
		er2{end+1} = sprintf('%s is missing field %s',n2,fn1{ii});
		er1{end+1} = sprintf('%s.%s is unique',n1,fn1{ii});
		if prt > 1; fprintf('%s\\n',er2{end}); end; if pse; pause; end
	end
	inda = numel(s1); indb = numel(s2); inder = inda-indb;
	if inder < 0
		for ii = inda+1:indb
			er1{end+1} = sprintf('%s(%g) is missing',n1,ii);
			er2{end+1} = sprintf('%s(%g) is unique',n2,ii);
			if prt > 1; fprintf('%s\\n',er1{end}); end; if pse; pause; end
		end
	elseif inder > 0
		for ii = indb+1:inda
			er2{end+1} = sprintf('%s(%g) is missing',n2,ii);
			er1{end+1} = sprintf('%s(%g) is unique',n1,ii);
			if prt > 1; fprintf('%s\\n',er2{end}); end; if pse; pause; end
		end
	end
	fn = fn1(temp1); fnn = numel(fn); 
	ind = min([inda indb]); cnt = 0; 
	if wbf; wb = waitbar(0,'Comparing ....'); end
	for ii = 1:ind
		for jj = 1:fnn
			if wbf; cnt = cnt + 1; waitbar(cnt/(ind*fnn),wb); drawnow; end
			n1p = sprintf('%s(%g).%s',n1,ii,fn{jj});
			n2p = sprintf('%s(%g).%s',n2,ii,fn{jj});
			[m e1 e2] = comp_struct_loop(s1(ii).(fn{jj}),s2(ii).(fn{jj}),prt,pse, ...
				tol,n1p,n2p,wbf);
			match = [match m']; 
			if ~isempty(e1) || ~isempty(e2)
				er1 = [er1 e1']; er2 = [er2 e2'];
			end
		end
	end
	if wbf;	close(wb); end
else
	c1 = class(s1); c2 = class(s2);
	if strcmp(c1,c2);
		if isequal(s1,s2)
			match{end+1} = sprintf('%s and %s match',n1,n2);
			if prt == 3; fprintf('%s\\n',match{end}); end
		else
			switch c1
				case {'single', 'double'}, 
					if numel(s1) ~= numel(s2) || size(s1,1) ~= size(s2,1)
						er = 1;
					else
						er = norm(s1-s2);
					end
				case {'function_handle'},
					s1f = functions(s1); s2f = functions(s2);
					if strcmp(s1f.function,s2f.function)
						er = 0;
						er1{end+1} = sprintf('%s and %s are both %s but have different values', ...
							n1,n2,char(s1));
						er2{end+1} = er1{end};
						if prt > 1; fprintf('%s\\n',er1{end}); end;
						if pse > 1; pause; end
					else
						er = 1;
					end
				otherwise, er = 1;
			end
			if er > tol
				er1{end+1} = sprintf('%s and %s do not match',n1,n2);
				er2{end+1} = sprintf('%s and %s do not match',n2,n1);
				if prt > 1; fprintf('%s\\n',er1{end}); end;
				if pse > 1; pause; end
			else
				match{end+1} = sprintf('%s and %s are tolerance match',n1,n2);
				if prt > 2; fprintf('%s\\n',match{end}); end
			end
		end
	else
		er1{end+1} = sprintf('%s is class %s, %s is class %s',n1,c1,n2,c2);
		er2{end+1} = sprintf('%s is class %s, %s is class %s',n2,c2,n1,c1);
		if prt > 1; fprintf('%s\\n',er1{end}); end
		if pse; pause; end
	end
end

match = match'; er1 = er1'; er2 = er2';"
2546,comp_tfrfromwin.m,78.72,100,67.44,75,100.0,51.16,70-80,"function [tfr,gamma] = comp_tfrfromwin(g, atheight)


gl = winwidthatheight(g, 1e-10);
w  = winwidthatheight(g, atheight);

Cg = -pi/4*(w/gl)^2/log(atheight);
gamma = Cg*gl^2;
tfr = @(L) gamma/L;


function width = winwidthatheight(gnum,atheight)


if ~isnumeric(gnum) || isempty(gnum) || ~isvector(gnum) || ~isreal(gnum)
    error('%s: gnum must be a numeric vector.', upper(mfilename));
end

if isempty(atheight) || any(atheight) > 1 || any(atheight) < 0
    error('%s: h must be in the interval [0-1].', upper(mfilename));
end

width = zeros(size(atheight));
for ii=1:numel(atheight)
    gl = numel(gnum);
    gmax = max(gnum);
    frac=  1/atheight(ii);
    fracofmax = gmax/frac;

    ind =find(gnum(1:floor(gl/2)+1)==fracofmax,1,'first');
    if isempty(ind)
        ind1 = find(gnum(1:floor(gl/2)+1)>fracofmax,1,'last');
        ind2 = find(gnum(1:floor(gl/2)+1)<fracofmax,1,'first');
        if isempty(ind2)
            width(ii) = gl;
        else
            rest = 1-(fracofmax-gnum(ind2))/(gnum(ind1)-gnum(ind2));
            width(ii) = 2*(ind1+rest-1);
        end
    else
        width(ii) = 2*(ind-1);
    end
end"
2547,comp_tstamps.m,72.69,100,58.62,60,100.0,44.83,70-80,"function data_tstamps = comp_tstamps(inp, sfreq)


THRESH = 3;
BASELINE = 5;   % seconds
TRAIN_STEP = 0.015; % seconds
NBITS = 43;          % including the parity bit

trigs = find([0 diff(inp>THRESH)>0]);

d = trigs(2:end) - trigs(1:end-1);

samps = [];
tss = [];

for i = find(d > BASELINE * sfreq)
    ts = read_timestamp(d, i, TRAIN_STEP*sfreq, NBITS);
    if ts ~= -1
        samps(end+1) = trigs(i+1);
        tss(end+1) = ts;
    end
end
    
p = polyfit(samps, tss, 1);
data_tstamps = [1:length(inp)] * p(1) + p(2);



function ts = read_timestamp(dtrigs, cur, step, nbits)

ts = 0;
parity = false;

for i = 1 : nbits
    if cur+i > length(dtrigs)
        warning('end of input reached before NBITS bits read');
        ts = -1;
        return;
    end
    
    if (dtrigs(cur+i) < step*1.5) | (dtrigs(cur+i) > step*4.5)
        warning('invalid interval between two triggers');
        ts = -1;
        return;
    end
    
    if dtrigs(cur+i) > step*3
        parity = ~parity;
        if i < nbits    % don't read the parity bit into the timestamp
            ts = ts + 2^(i-1);
        end
    end
end

if parity
    warning('parity check failed');
    ts = -1;
end"
2548,comp_ufilterbank_td.m,70.668,60,76.67,60,100.0,56.67,70-80,"function c=comp_ufilterbank_td(f,g,a,skip,ext)  


L=size(f,1);
