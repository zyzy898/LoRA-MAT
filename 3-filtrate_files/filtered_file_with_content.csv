4694,DBD.m,74.126,100,59.57,60,100.0,51.06,70-80,"function [updates, state] = DBD(gradients, state)

if nargin == 1
    state = struct;
end

if ~isfield(state, 'alpha')
    state.alpha = 1e-2;
end
if ~isfield(state, 'momentum') 
    state.momentum = 0.5;
end
if ~isfield(state, 'mini')
    state.mini = 0.01;
end
if ~isfield(state, 'iteration')
    state.iteration = 1;
end
if ~isfield(state, 'updates')
    state.updates = zeros(size(gradients));
end
if ~isfield(state, 'gains')
    state.gains = ones(size(gradients));
end
if ~isfield(state, 'kappa')
    state.kappa = 0.2;
end
if ~isfield(state, 'phi')
    state.phi = 0.8;
end

dbd = sign(gradients) == sign(state.updates);

state.gains(dbd) = state.gains(dbd) * state.phi;

state.gains(~dbd) = state.gains(~dbd) + state.kappa;

state.gains = max(state.gains, state.mini);
    
updates = state.alpha * (state.gains .* gradients) - state.momentum * state.updates;

state.updates = -updates;  

state.iteration = state.iteration + 1;


end"
4695,DBDF.m,77.258,80,62.6,100,100.0,43.69,70-80,"function [x_best, psi_best, out] = DBDF(mapp, x0, options)

format longG ;

if nargin > 3
    error('The number of input arguments is more than what is needed');
elseif nargin < 3
    error('The number of input arguments is not enough');
end;

if isempty(mapp)
    error('the function handle mapp has to be defined');
elseif ~isa(mapp,'function_handle')
    error('mapp should be a function handle');
end

if isempty(x0)
    error('The starting point x0 has to be defined');
elseif ~isa(x0,'numeric')
    error('x0 should be a numeric vector');
end

[MaxNumIter,MaxNumMapEval,TimeLimit,epsilon,alpha, ...
         beta,sigma,l,tauBar,lambda_min,lambda_max,flag_x_error, ...
         flag_psi_error,flag_time,Stopping_Crit] = InitialDuplo(options);

if isfield(options,'x_opt')
    x_opt=options.x_opt;
elseif flag_x_error==1
    error('x_error requires to x_opt be specified');
end

if flag_x_error == 1
    Nxopt      = sqrt(sum(x_opt(:).^2));
    x_error(1) = sqrt(sum((x0(:)-x_opt(:)).^2))/Nxopt;
end

if flag_psi_error == 1
    psi_error(1) = 1;
end

if flag_time == 1
    Time(1) = 0;
end


xk         = x0;
Xk         = xk;
Niter      = 1;
fxk        = mapp(x0);
Nmap       = 1;
nfxk       = norm(fxk);
nfx0       = nfxk;
merit_func = 0.5*nfxk^2;
max_inner  = 10;
StopFlag   = 0;


T0 = tic;

while ~StopFlag

    xk1         = xk-fxk;
    fxk1        = mapp(xk1);
    Nmap        = Nmap+1;
    nfxk1       = norm(fxk1);
    lambdak     = lambda_max;
    inner_count = 0;
    while (nfxk1^2>=(1-alpha*lambdak)*nfxk^2 && inner_count<= max_inner)
        lambdak = beta*lambdak;
        if lambdak < lambda_min
            alpha   = beta*alpha;
            lambdak = lambda_max;
        end
        xk1         = xk-lambdak*fxk;
        fxk1        = mapp(xk1);
        Nmap        = Nmap+1;
        nfxk1       = norm(fxk1);
        inner_count = inner_count+1;
    end

    xk                = xk1;
    Niter             = Niter+1;
    fxk               = fxk1;
    nfxk              = nfxk1;
    psik              = 0.5*nfxk^2;
    merit_func(Niter) = psik;
    if flag_time == 1
        Time(Niter+1) = toc(T0);
    end

    if flag_x_error == 1
        Nx_opt = norm(x_opt);
        x_error(Niter+1) = sqrt(sum((xk(:)-x_opt(:)).^2))/Nx_opt;
    end

    if flag_psi_error == 1
        psi_error(Niter+1) = (psik-psi_opt)/(psi0-psi_opt);
    end


    T = toc(T0);

    [StopFlag,Status] = StopCritDuplo(nfxk,Niter,Nmap,T, ...
              MaxNumIter,MaxNumMapEval,TimeLimit,epsilon,Stopping_Crit);

end


Status
x_best         = xk;
psi_best       = psik;
out.Xk         = Xk;
out.T          = T;
out.nhx        = nfxk;
out.merit_func = merit_func';
out.Niter      = Niter;
out.Nmap       = Nmap;
out.Status     = Status;

if flag_x_error == 1
    out.x_error = x_error;
end
if flag_psi_error == 1
    out.psi_error = psi_error;
end
if flag_time == 1
    out.Time = Time;
end

end"
4696,dbdrop.m,78.662,100,70.42,75,100.0,47.89,70-80,"function [drop] = dbdrop(varargin)
	if(isempty(varargin))
		error('Missing model')
	end

	if(length(varargin) < 3)
		w1 = 0.01;
		w2 = 100;
	else
		w1 = varargin{2};
		w2 = varargin{3};
	end

	type = varargin{1}.type;
	if(strcmp(type, 'SS' ))
		G = ss2tf(varargin{1});
		dBdrop(G, w1, w2);
	elseif(strcmp(type, 'TF' ))
		G = varargin{1};
		for i = 1:size(G,1)
			for j = 1:size(G,2)
				a = G(i,j).num;
				b = G(i,j).den;
				delay = G(i,j).delay;
				sampleTime = G(i,j).sampleTime;

				if(length(a) > length(b))
					b = [zeros(1, size(a,2) - size(b,2)) b];
				elseif(length(a) < length(b))
					a = [zeros(1, size(b,2) - size(a,2)) a];
				end

				L = 1000; % Number of frequency elements
				N = length(b); % Number of denomerators
				w = logspace(log10(w1), log10(w2), L); % Angular frequencies
				H = zeros(1, L);
				h = sampleTime;
				if(sampleTime > 0) % Discrete model
					for k = 1 : L
						H(k) = (a*fliplr((exp(1i*w(k)*h)).^(0 : N-1)).')/(b*fliplr((exp(1i*w(k)*h)).^(0 : N-1)).')*exp(-delay*exp(1i*w(k)*h));
					end
				else
					for k = 1 : L
						H(k) = (a*fliplr((1i*w(k)).^(0 : N-1)).')/(b*fliplr((1i*w(k)).^(0 : N-1)).')*exp(-delay*1i*w(k));
					end
				end

				dBstatic = 20*log10(abs(freqresp(G(i,j), 0))); % The static G(0) dB gain
				dBinitial = dBstatic - 3;
				dropWc = NaN;
				for k = 1 : L
					if(20*log10(abs(H(k))) <= dBinitial)
						drop = w(k);
						break;
					end
				end

				figure('Name', sprintf(strcat('Transfer function: ', num2str(i), 'x', num2str(j))))
				semilogx(w, 20*log10(abs(H)), 'b');
				hold on
				h = semilogx([drop drop], [dBinitial (dBinitial + 3)], 'r');
				ylabel('Magnitude [dB]');
				grid on
				legend(h,strcat('3 dB drop at: ', num2str(drop), ' rad/s'))

			end
		end
	else
		error('Only transfer functions and state space models allowed')
	end
end"
4697,DBDuplicate.m,76.286,60,67.86,100,100.0,53.57,70-80,"function new = DBDuplicate(old,new,varargin)



