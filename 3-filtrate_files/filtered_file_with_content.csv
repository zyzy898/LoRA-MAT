for i = 1:numel(free)
    pC.(free{i}) = PCM.M.pC.(free{i});
end


for r = 1:numel(D)
    
    fprintf('%d out of %d\\n',r,numel(D));
    try, clear Y; end
    
    Y(1).type = 'PCR cases (ONS)'; % daily PCR positive cases (by specimen)
    Y(1).unit = 'number/day';
    Y(1).U    = 2;
    Y(1).date = D(r).date;
    Y(1).Y    = D(r).cases;
    Y(1).h    = 2;
    
    if ismember('W',D(r).code{1})
        
        Y(2).type = 'Certified deaths (ONS)'; % weekly covid related deaths
        Y(2).unit = 'number/day';
        Y(2).U    = 1;
        Y(2).date = D(r).date;
        Y(2).Y    = D(r).cert/7;
