subplot(2,1,2); spm_SARS_ci(Ep,Cp,YS(:,9),13,M); hold on

M.FTT = .24;
for i = 1:numel(Tdate)
    M.TTT = datenum(Tdate{i},'dd-mmm-yyyy') - datenum(M.date,'dd-mm-yyyy');
    subplot(2,1,1); spm_SARS_ci(Ep,Cp,YS(:,3),3,M);  hold on
