3145,convXyz2Geod.m,78.27,100,63.51,90,100.0,37.84,70-80,"function [dphi, dlambda, h] = convXyz2Geod(const, XYZ)

a = const.EARTH_SEMIMAJORAXIS;
finv = 1/const.EARTH_FLATTENING;%the inverse of flattening (finv)
X=XYZ(1);
Y=XYZ(2);
Z=XYZ(3);

h       = 0;
tolsq   = 1.e-10;
maxit   = 10;

rtd     = 180/pi;

if finv < 1.e-20
    esq = 0;
else
    esq = (2 - 1/finv) / finv;
end

oneesq  = 1 - esq;

P = sqrt(X^2+Y^2);

if P > 1.e-20
    dlambda = atan2(Y,X) * rtd;
else
    dlambda = 0;
end

if (dlambda < 0)
    dlambda = dlambda + 360;
end

r = sqrt(P^2 + Z^2);

if r > 1.e-20
    sinphi = Z/r;
else
    sinphi = 0;
end

dphi = asin(sinphi);

if r < 1.e-20
    h = 0;
    return
end

h = r - a*(1-sinphi*sinphi/finv);

for i = 1:maxit
    sinphi  = sin(dphi);
    cosphi  = cos(dphi);
    
    N_phi   = a/sqrt(1-esq*sinphi*sinphi);
    
    dP      = P - (N_phi + h) * cosphi;
    dZ      = Z - (N_phi*oneesq + h) * sinphi;
    
    h       = h + (sinphi*dZ + cosphi*dP);
    dphi    = dphi + (cosphi*dZ - sinphi*dP)/(N_phi + h);
    
    if (dP*dP + dZ*dZ < tolsq)
        break;
    end

    if i == maxit
        fprintf([' Problem in TOGEOD, did not converge in %2.0f',...
            ' iterations\\n'], i);
    end
end % for i = 1:maxit

dphi = dphi * rtd;"
