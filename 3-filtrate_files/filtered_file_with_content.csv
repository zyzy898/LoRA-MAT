5263,DEMO_4_Order_vs_Accuracy.m,71.396,100,82.54,30,100.0,44.44,70-80,"clear; clc;

orderRange = [2,1000];
orderNum = 20;
orderList = unique(round(logspace(...
    log10(orderRange(1)),...
    log10(orderRange(2)),...
    orderNum)));  

nTime = 1000;

d = [-2,1];

time = linspace(d(1),d(2),nTime);

IO.domain = d;
IO.userFunc = @testFunction;

N = length(orderList);
cpuTime = zeros(N,1);
maxError = zeros(N,2);
meanError = zeros(N,2);

for i=1:N
    disp(['Order: ' num2str(orderList(i))])
    tic;
    f = chebyshevFit(IO, orderList(i)); 
    [y, Dy] = chebyshevInterpolate(f,time,d);
    cpuTime(i) = toc;
    [g,Dg] = testFunction(time);
    e = abs(g-y);
    De = abs(Dg-Dy);
    maxError(i,:) = [max(e),max(De)];
    meanError(i,:) = [mean(e),mean(De)];
end

    figure(403); clf;
    subplot(3,2,1)
        loglog(orderList,cpuTime)
