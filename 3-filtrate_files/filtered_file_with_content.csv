init_ML_DICOM

for indBase = 1:length(dirS)
    
    [~,fname,~] = fileparts(dirS(indBase).name);
    registeredDir = fullfile(registeredDirLoc,['registered_to_',...
        fname]); 
    
    segFileName = fullfile(registeredDir,dirS(indBase).name);
    planC = loadPlanC(segFileName);
