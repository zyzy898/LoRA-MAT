        'channelwise',1, ...
        'format','double', ...
        'resolution', NaN);
end"
3097,convexhullConcave2D.m,72.6,100,86.0,45,100.0,32.0,70-80,"function [Ax,Ay,b,K] = convexhullConcave2D(x1,f1,df1,x2,f2,df2,x3,f3,df3,x4,f4,df4,x5,f5,df5)



