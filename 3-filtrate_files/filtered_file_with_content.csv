curved = [];
if(~isempty(k))
 cylfaces = [k,f];
 curved = sort(unique(k)); 
 MakeCylinder2D(cylfaces, .5, 0, 0);
 ids = find(BCType==Cyl);  BCType(ids) = Wall;
