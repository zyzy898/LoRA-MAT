5834,deriv.m,75.572,60,67.86,100,100.0,50.0,70-80,"function out = deriv(f, xx, varargin)


if ( isempty(f) )
    return
end

m = 1;      

if ( nargin == 3 )
    if ( isnumeric(varargin{1}) ) % DERIV(F, X, M)
        m = varargin{1};
        varargin = {};
    else                          % DERIV(F, X, S)
        m = 1;  % By default, compute first derivative
    end
elseif ( nargin == 4 )            % DERIV(F, X, S, M)
    m = varargin{2};
    varargin{2} = [];
end

if ( m == 0 )
    out = feval(f, xx, varargin{:});
else
    out = feval(diff(f, m), xx, varargin{:});
end

