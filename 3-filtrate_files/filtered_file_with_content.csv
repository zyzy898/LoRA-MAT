        end
        param = [param9(2:4) param param0(8:end)];
        [varargout{1:nargout}] = spm_diffeo('dartel',varargin{1:3},param);

    case {'vel2mom'}
        param0 = varargin{3};
        vx2    = mean(param0(2:4).^2);
