    mean_recall_per_IoU = mean(cell2mat(recall_per_class),2); % average over classes
    mean_ave_recall = mean(ave_recall_per_class); % average over classes
    fprintf('Average Recall: %.3f -- Recall(IoU>=0.4): %.3f -- Recall(IoU>=0.5): %.3f -- Recall(IoU>=0.7): %.3f\\n', ...
        mean_ave_recall, mean_recall_per_IoU(thresholds == 0.4), mean_recall_per_IoU(thresholds == 0.5), mean_recall_per_IoU(thresholds == 0.7));
else
    [ave_recall, recall_per_IoU, thresholds] = compute_ave_recall_of_bbox(abbox, all_bbox_gt);
    mean_recall_per_IoU = recall_per_IoU(:);  
    mean_ave_recall = ave_recall;
    fprintf('Average Recall: %.3f -- Recall(IoU>=0.4): %.3f -- Recall(IoU>=0.5): %.3f -- Recall(IoU>=0.7): %.3f\\n',...
        mean_ave_recall, mean_recall_per_IoU(thresholds == 0.4), mean_recall_per_IoU(thresholds == 0.5), mean_recall_per_IoU(thresholds == 0.7));
end

end"
2425,compute_recall_precision_accuracy_3d.m,75.888,80,68.39,90,100.0,41.05,70-80,"function [recall, precision, accuracy, ap, aa] = compute_recall_precision_accuracy_3d(cls, viewThresh,methodId)


path_ann_view = '../Annotations';

pascal_init;
ids = textread(sprintf(VOCopts.imgsetpath, 'val'), '%s');
M = numel(ids);

filename = sprintf('data/%s_3d_%s.mat', methodId, cls);
object = load(filename);
dets_all = object.dets;

energy = [];
correct = [];
correct_view = [];
overlap = [];
count = zeros(M,1);
num = zeros(M,1);
num_pr = 0;

for i = 1:M
    fprintf('%s %d/%d\\n', cls, i, M);
    rec = PASreadrecord(sprintf(VOCopts.annopath, ids{i}));
    clsinds = strmatch(cls, {rec.objects(:).class}, 'exact');
    diff = [rec.objects(clsinds).difficult];
    clsinds(diff == 1) = [];
    n = numel(clsinds);
    bbox = zeros(n, 4);
    for j = 1:n
        bbox(j,:) = rec.objects(clsinds(j)).bbox;
    end
    count(i) = size(bbox, 1);
    det = zeros(count(i), 1);
    
    if isempty(clsinds) == 0
        filename = fullfile(path_ann_view, sprintf('%s_pascal/%s.mat', cls, ids{i}));
        object = load(filename);
        record = object.record;
        view_gt = zeros(n, 3);
        for j = 1:n
            vp = record.objects(clsinds(j)).viewpoint;
            if vp.distance == 0
                azimuth = vp.azimuth_coarse;
            else
                azimuth = vp.azimuth;
            end
            view_gt(j,:) = [vp.theta vp.elevation azimuth];
        end
    else
        view_gt = [];
    end
    
    dets = dets_all{i};
    num(i) = size(dets, 1);
    for j = 1:num(i)
        num_pr = num_pr + 1;
        energy(num_pr) = dets(j, end);        
        bbox_pr = dets(j, 1:4);
        view_pr = dets(j, 5:7);
        
        if isempty(bbox) == 0
            o = box_overlap(bbox, bbox_pr);
            [maxo, index] = max(o);
            if maxo >= 0.5 && det(index) == 0
                overlap{num_pr} = index;
                correct(num_pr) = 1;
                det(index) = 1;
                diff = rotDiff(view_pr,view_gt(index,:));
                 if diff < viewThresh
                    correct_view(num_pr) = 1;
                else
                    correct_view(num_pr) = 0;
                end
            else
                overlap{num_pr} = [];
                correct(num_pr) = 0;
                correct_view(num_pr) = 0;
            end
        else
            overlap{num_pr} = [];
            correct(num_pr) = 0;
            correct_view(num_pr) = 0;
        end
    end
end
overlap = overlap';

[threshold, index] = sort(energy, 'descend');
correct = correct(index);
correct_view = correct_view(index);
n = numel(threshold);
recall = zeros(n,1);
precision = zeros(n,1);
accuracy = zeros(n,1);
num_correct = 0;
num_correct_view = 0;
for i = 1:n
    num_positive = i;
    num_correct = num_correct + correct(i);
    if num_positive ~= 0
        precision(i) = num_correct / num_positive;
    else
        precision(i) = 0;
    end
    
    num_correct_view = num_correct_view + correct_view(i);
    if num_correct ~= 0
        accuracy(i) = num_correct_view / num_positive;
    else
        accuracy(i) = 0;
    end
    
    recall(i) = num_correct / sum(count);
end


ap = VOCap(recall, precision);
fprintf('AP = %.4f\\n', ap);

aa = VOCap(recall, accuracy);
fprintf('AA = %.4f\\n', aa);

figure;
hold on;
plot(recall, precision, 'r', 'LineWidth',3);
plot(recall, accuracy, 'g', 'LineWidth',3);
xlabel('Recall');
ylabel('Precision/Accuracy');
tit = sprintf('Average Precision = %.1f / Average Accuracy = %.1f', 100*ap, 100*aa);
title(tit);
hold off;

end

function delta = rotDiff(a1,a2)
    a1 = a1*pi/180;a2 = a2*pi/180;
    R1 = angle2dcm(a1(1),a1(2)-pi/2,-a1(3),'ZXZ');
    R2 = angle2dcm(a2(1),a2(2)-pi/2,-a2(3),'ZXZ');
    delta = norm(logm(R1'*R2),'fro')/sqrt(2)*180/pi;
end

function ind = find_interval(azimuth, a)

for i = 1:numel(a)
    if azimuth < a(i)
        break;
    end
end
ind = i - 1;
if azimuth > a(end)
    ind = 1;
end

end"
2426,compute_recall_precision_accuracy_3dview.m,79.058,80,70.29,100,100.0,45.0,70-80,"function [recall, precision, accuracy, ap, aa] = compute_recall_precision_accuracy_3dview(cls, prediction_filename, show_curve, ARP)

BASE_DIR = fullfile(mfilename('fullpath'),'../');
addpath(fullfile(BASE_DIR, '../'));
global_variables;

if nargin < 3
    show_curve = 1;
end
if nargin < 4
    ARP = 0;
end


path_ann_view = fullfile(g_pascal3d_root_folder, 'Annotations');

addpath(fullfile(g_pascal3d_root_folder, 'VDPM'));
addpath(fullfile(g_pascal3d_root_folder, 'PASCAL/VOCdevkit/VOCcode'));
VOCinit;
ids = textread(sprintf(VOCopts.imgsetpath, 'val'), '%s');
M = numel(ids);

filename = prediction_filename;
object = load(filename);
dets_all = object.dets;

try
    object = load(fullfile(BASE_DIR, 'voc12val_records.mat'));
catch
    run(fullfile(BASE_DIR, 'extract_records.m'));
    object = load(fullfile(BASE_DIR, 'voc12val_records.mat'));
end
voc12val_records = object.voc12val_records;

energy = [];
correct = [];
correct_view = [];
overlap = [];
count = zeros(M,1);
num = zeros(M,1);
num_pr = 0;
for i = 1:M
    fprintf('%s %d/%d\\n', cls, i, M);    
    rec = voc12val_records{i}; %PASreadrecord(sprintf(VOCopts.annopath, ids{i}));
    clsinds = strmatch(cls, {rec.objects(:).class}, 'exact');
    diff = [rec.objects(clsinds).difficult];
    clsinds(diff == 1) = [];
    n = numel(clsinds);
    bbox = zeros(n, 4);
    for j = 1:n
        bbox(j,:) = rec.objects(clsinds(j)).bbox;
    end
    count(i) = size(bbox, 1);
    det = zeros(count(i), 1);
    
    if isempty(clsinds) == 0
        filename = fullfile(path_ann_view, sprintf('%s_pascal/%s.mat', cls, ids{i}));
        object = load(filename);
        record = object.record;
        view_gt = zeros(n, 3);
        for j = 1:n
            viewpoint = record.objects(clsinds(j)).viewpoint;
            if record.objects(clsinds(j)).viewpoint.distance == 0
                azimuth = viewpoint.azimuth_coarse;
                elevation = viewpoint.elevation_coarse;
                tilt = viewpoint.theta;
            else
                azimuth = viewpoint.azimuth;
                elevation = viewpoint.elevation;
                tilt = viewpoint.theta;
            end
            view_gt(j,:) = [azimuth, elevation, tilt];
        end
    else
        view_gt = [];
    end
    
    dets = dets_all{i};
    num(i) = size(dets, 1);
    for j = 1:num(i)
        num_pr = num_pr + 1;
        energy(num_pr) = dets(j, 8); %dets(j, 6);        
        bbox_pr = dets(j, 1:4);
        view_pr = dets(j, 5:7); %find_interval((dets(j, 5) - 1) * (360 / vnum_train), azimuth_interval);
        
        if isempty(bbox) == 0
            o = box_overlap(bbox, bbox_pr);
            [maxo, index] = max(o);
            if maxo >= 0.5 && det(index) == 0
                overlap{num_pr} = index;
                correct(num_pr) = 1;
                det(index) = 1;
                R_pr = angle2dcm(view_pr(1)/180*pi, view_pr(2)/180*pi, view_pr(3)/180*pi);
                R_gt = angle2dcm(view_gt(index,1)/180*pi, view_gt(index,2)/180*pi, view_gt(index,3)/180*pi);
                R_angle = norm(logm(R_pr' * R_gt)) / sqrt(2); % in [0,2pi]
                azimuth_angle = min(abs(view_pr(1) - view_gt(index,1)), 360-abs(view_pr(1) - view_gt(index,1))); % in degree
                if ARP && R_angle < pi/6  % ARP_pi/6
                    correct_view(num_pr) = 1;
                elseif ARP == 0 && azimuth_angle < 30 % AVP_pi/6
                    correct_view(num_pr) = 1;
                else
                    correct_view(num_pr) = 0;
                end
            else
                overlap{num_pr} = [];
                correct(num_pr) = 0;
                correct_view(num_pr) = 0;
            end
        else
            overlap{num_pr} = [];
            correct(num_pr) = 0;
            correct_view(num_pr) = 0;
        end
    end
end
overlap = overlap';

[threshold, index] = sort(energy, 'descend');
correct = correct(index);
correct_view = correct_view(index);
n = numel(threshold);
recall = zeros(n,1);
precision = zeros(n,1);
accuracy = zeros(n,1);
num_correct = 0;
num_correct_view = 0;
for i = 1:n
    num_positive = i;
    num_correct = num_correct + correct(i);
    if num_positive ~= 0
        precision(i) = num_correct / num_positive;
    else
        precision(i) = 0;
    end
    
    num_correct_view = num_correct_view + correct_view(i);
    if num_correct ~= 0
        accuracy(i) = num_correct_view / num_positive;
    else
        accuracy(i) = 0;
    end
    
    recall(i) = num_correct / sum(count);
end


ap = VOCap(recall, precision);
fprintf('AP = %.4f\\n', ap);

aa = VOCap(recall, accuracy);
fprintf('AA = %.4f\\n', aa);

if show_curve
figure;
hold on;
plot(recall, precision, 'r', 'LineWidth',3);
plot(recall, accuracy, 'g', 'LineWidth',3);
xlabel('Recall');
ylabel('Precision/Accuracy');
tit = sprintf('Average Precision = %.1f / Average Accuracy = %.1f', 100*ap, 100*aa);
title(tit);
hold off;
end

function ind = find_interval(azimuth, a)

for i = 1:numel(a)
    if azimuth < a(i)
        break;
    end
end
ind = i - 1;
if azimuth > a(end)
    ind = 1;
end"
