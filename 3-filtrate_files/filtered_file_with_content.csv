3743,createRawFormat.m,75.456,60,63.64,90,100.0,63.64,70-80,"function formatSpec = createRawFormat(raw_variables)


m = numel(raw_variables);   % number of variables

formatSpec='';      % initialize

for i = 1:m
    switch raw_variables{i}
        
        case {'TimeNanos', 'FullBiasNanos', 'ReceivedSvTimeNanos', 'ReceivedSvTimeUncertaintyNanos', ...
                'CarrierCycles', 'allRxMillis', 'BiasNanos', 'TimeOffsetNanos'}
            formatSpec = sprintf('%s %%d64', formatSpec);
            
        case {'Raw', 'CodeType'}
            formatSpec = strcat(formatSpec, ' %s');
            
        otherwise
            formatSpec = sprintf('%s %%f', formatSpec);
            
    end
end"
3744,createRay.m,76.666,60,76.19,90,100.0,57.14,70-80,"function ray = createRay(varargin)


if length(varargin)==2
    p0 = varargin{1};
    arg = varargin{2};
    if size(arg, 2)==1
        ray = [p0 cos(arg) sin(arg)];
    else
        ray = [p0 arg-p0];
    end
    
elseif length(varargin)==3   
    x = varargin{1};
    y = varargin{2};
    theta = varargin{3};
    ray = [x y cos(theta) sin(theta)];   

else
    error('Wrong number of arguments in ''createRay'' ');
end"
3745,createrBioNetStructure.m,72.862,80,64.96,60,100.0,59.35,70-80,"function [metabolite_structure_rBioNet] = createrBioNetStructure(metabolite_structure_rBioNet,start,stop)
