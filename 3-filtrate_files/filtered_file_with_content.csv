h5=plot(gp_fic.X_u, -3, 'rx', 'MarkerSize', 5, 'LineWidth', 2);
legend([h1  h2 h3 h4(1) h5(1)],'Ef','95% CI','Data','Initial X_u','Optimized X_u')
ylim([-3 3])
title('FIC')


fprintf('VAR GP\\n')
gp_var = gp_set(gp,'type','VAR','X_u',Xu,'infer_params','inducing');

