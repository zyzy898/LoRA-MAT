5706,DEM_demo_convolution_LAP.m,77.206,100,82.19,60,100.0,43.84,70-80,"function DEM_demo_convolution_LAP
 
 
 
M       = spm_DEM_M('convolution model');
 
M(1).f  = inline('[P(1,:).*x(1,:)+P(3,:).*x(2,:)+P(13,:).*v(:,:);P(2,:).*x(1,:)+P(4,:).*x(2,:)+P(14,:).*v(:,:);]','x','v','P');
M(1).g  = inline('[P(5,:).*x(1,:)+P(9,:).*x(2,:);P(6,:).*x(1,:)+P(10,:).*x(2,:);P(7,:).*x(1,:)+P(11,:).*x(2,:);P(8,:).*x(1,:)+P(12,:).*x(2,:);]','x','v','P');
M(1).V  = exp(8);                              % error precision
M(1).W  = exp(6);                              % error precision
M(2).V  = exp(8);
 
P       = spm_vec(M(1).pE);                    % true parameters
ip      = [2 4 5 9];                           % free parameters
pE      = P;
np      = length(pE);
pE(ip)  = 0;
pC      = sparse(ip,ip,32,np,np);
M(1).pE = pE;
M(1).pC = pC;
 
M(1).E.nE  = 32;                                % DEM-steps
M(1).E.nN  = 32;                                % DEM-steps
N          = 32;                                % length of data sequence
U          = exp(-((1:N) - 12).^2/(2.^2));      % this is the Gaussian cause
DEM        = spm_DEM_generate(M,U,{P});
DEM.M(2).V = exp(0);
 
spm_figure('GetWin','Figure 1'); 
spm_DEM_qU(DEM.pU);
 
SCK         = DEM;
SCK.M(1).cb = [];               % option to specify constrain on parameters values [min max]
SCK.M(1).ip = ip;               % indices of model parameters to be estimated
SCK.M(2).v  = 0;                % input initial condition
SCK.M(2).V  = 10;               % input noise precision (fixed)
SCK.M(1).xP = eye(2)*1e-1^2;    % state error covariance matrix
SCK.M(1).uP = eye(1)*1e-1^2;    % input error covariance matrix
SCK.M(1).wP = sparse(ip,ip,10e-10^2,np,np); % parameter error covariance matrix
SCK.M(1).pC = sparse(ip,ip,1e-3,np,np);  % covariance matrix of parameter noise
SCK.M(1).Q  = {speye(M(1).l,M(1).l)};    % if Q is specified then algorithm performs
SCK.M(1).Qf      = 'auto';      % form of estimation of measurement noise covariance 
SCK.M(1).E.nN    = 50;          % max number of iteration of SCKF-SCK algorithm
SCK.M(1).E.Itol  = 1e-3;        % convergence tolerance value for SCKF_SCK algorithm
SCK.M(1).E.RM    = [5e2 1e6];   % scaling parameter for Robbins-Monro approximation of 
SCK.M(1).VB.N    = 10;          % max number of VB iteration during one SCKF-SCK run
SCK.M(1).VB.Itol = 1e-6;        % convergence tolerance value for VB algorithm
SCK.M(1).VB.l    = 1 - exp(-2); % scaling parameter for VB algorithm, 
 
 
DEM     = spm_DEM(DEM);
LAP     = spm_LAP(DEM);
SCK     = spm_SCK(SCK);
 
spm_figure('GetWin','spm_DEM'); spm_DEM_qU(DEM.qU,LAP.pU)
spm_figure('GetWin','spm_SCK'); spm_DEM_qU(SCK.qU,LAP.pU)
spm_figure('GetWin','spm_LAP'); spm_DEM_qU(LAP.qU,LAP.pU)
 
 
qP1    = spm_vec(LAP.pP.P);
qP2    = spm_vec(LAP.qP.P);
qP3    = spm_vec(DEM.qP.P);
qP4    = spm_vec(SCK.qP.P);
qP1    = qP1(ip);
qP2    = qP2(ip);
qP3    = qP3(ip);
qP4    = qP4(ip);
 
subplot(2,2,4)
bar([qP1 qP2 qP3 qP4])
axis square
legend('True','LAP','DEM','SCK')
title('parameters','FontSize',16)"
5707,DEM_demo_Cornsweet.m,71.174,70,59.78,90,100.0,36.09,70-80,"function DEM_demo_Cornsweet
 
 
 
spm_figure('GetWin','Figure 1');
colormap((1:255)'*[1 1 1]/255)
 
nx    = 64;
YX    = [zeros(1,nx*3/8) 1:(nx/8) -(nx/8):-1 zeros(1,nx*3/8)]*8/nx;
YT    = ones(32,1);
 
C     = [1 4 32 64];
nc    = length(C);
for i = 1:length(C)
 
    subplot(nc,2,2*i - 1)
    image(YT*YX*C(i) + 128)
    title('Cornsweet effect','FontSize',16)
    xlabel('eccentricity ','FontSize',12)
    axis square
 
    subplot(nc,2,2*i)
    plot(YX*C(i))
    title('Reflectance ','FontSize',16)
    xlabel('eccentricity ','FontSize',12)
    axis square, axis([1 nx -64 64]);
    
end
 
 
 
 
nx      = 32;                               % number of pixels
P.R     = spm_dwtmtx(nx,1,1);               % DWT for hidden causes
P.I     = spm_dctmtx(nx,3);                 % DCT for hidden causes
P.I     = P.I/diag(max(P.I));
nr      = size(P.R,2);
ni      = size(P.I,2);
W       = log2(nx./sum(P.R > 0))*4;         % scale of reflectance
W(1)    = 16;
 
 
x       = sparse(nr,1);
v       = sparse(ni + nr,1);
v(1)    = -1;
ii      = (1:ni);
ir      = (1:nr) + ni;
 
M(1).f  = inline('(v(4:end) - x)/16','x','v','P');
M(1).g  = inline('exp(P.R*x + P.I*v(1:3))','x','v','P');
M(1).pE = P;                                % The prior expectation
M(1).x  = x;                                % The prior expectation
M(1).V  = exp(6);                           % error precision (data)
M(1).W  = exp(10);                          % error precision (motion)
M(1).xP = diag(exp(W));                     % error precision (motion)
 
M(2).v  = v;                                % hidden causes 
M(2).V  = exp(0);                           % error precision (cause)
 
 
M(1).E.n = 1;
N        = 64;                             % length of sequence
t        = ([1:N] - N/4)*8;                % time (ms)
YX       = [zeros(1,nx*3/8) 1:(nx/8) -(nx/8):-1 zeros(1,nx*3/8)]*8/nx;
YX       = YX'/4 + 1;
YX       = exp(P.R*pinv(P.R)*log(YX));
YT       = exp((tanh(([1:N] - N/3)/8) - 1)*4);
YT       = exp(-([1:N] - N/2).^2/(2*(N/8)^2));
Y        = YX*YT;
 
DEM.M    = M;
DEM.Y    = Y;
DEM      = spm_DEM(DEM);
 
 
spm_figure('GetWin','Figure 2'); clf
 
subplot(2,2,1)
PI  = P.I*DEM.qU.v{2}(ii,:);
imagesc(exp(PI))
title('Perceived illunimant','FontSize',16)
xlabel('time (bins)','FontSize',12)
ylabel('eccentricity ','FontSize',12)
axis square
 
subplot(2,2,2)
PR = P.R*DEM.qU.x{1};
imagesc(exp(PR))
title('Perceived reflectance','FontSize',16)
xlabel('time (bins)','FontSize',12)
ylabel('eccentricity ','FontSize',12)
axis square
 
subplot(2,2,3)
imagesc(DEM.qU.v{1})
title('Predicted stimulus','FontSize',16)
xlabel('time (bins)','FontSize',12)
ylabel('eccentricity ','FontSize',12)
axis square
 
 
C     = sparse(1,nx);
i     = nx/2 - nx/4 - 1;
C(i)  =  1;
i     = nx/2 + nx/4 + 2;
C(i)  = -1;
R1    = C*P.R;
 
i     = nx/2 - nx/8 - 1;
C(i)  = -1;
i     = nx/2 + nx/8 + 2;
C(i)  =  1;
R2    = C*P.R;
 
D1    = R1*DEM.qU.x{1};
D2    = R2*DEM.qU.x{1};
for i = 1:N
    V1(i) = R1*DEM.qU.S{i}*R1';
    V2(i) = R2*DEM.qU.S{i}*R2';
end
 
 
subplot(2,2,4)
spm_plot_ci(D1,V1,t), hold on
spm_plot_ci(D2,V2,t), hold off
title('Perceived reflectance','FontSize',16)
xlabel('time (ms)','FontSize',12)
ylabel('eccentricity ','FontSize',12)
axis square
spm_axis tight
drawnow
 
 
C   = -2:2:12;
for i = 1:length(C)
    
    SIM{i}        = DEM;
    SIM{i}.M(1).V = exp(C(i));
    SIM{i}        = spm_DEM(SIM{i});
 
    d1(i) = R1*SIM{i}.qU.x{1}(:,N/2);
    v1(i) = R1*SIM{i}.qU.S{N/2}*R1';
    d2(i) = R2*SIM{i}.qU.x{1}(:,N/2);
    v2(i) = R2*SIM{i}.qU.S{N/2}*R2';
 
end
 

 
spm_figure('GetWin','Figure 3'); clf
 
subplot(3,1,1)
spm_plot_ci(d1,v1,C),                hold on
plot(C,d1,'ob',C,C*0,'LineWidth',2), hold off
title('Conditional difference (Cornsweet)','FontSize',16)
xlabel('log-precision (contrast)','FontSize',12)
ylabel('reflectance difference','FontSize',12)
spm_axis tight square
 
subplot(3,1,2)
spm_plot_ci(d2,v2,C),                hold on
plot(C,d2,'or',C,C*0,'LineWidth',2), hold off
title('Conditional difference (Mach Band)','FontSize',16)
xlabel('log-precision (contrast)','FontSize',12)
ylabel('reflectance difference','FontSize',12)
spm_axis tight square
 
colormap([1:255]'*[1 1 1]/255)
j     = [1 5 7];
nj    = length(j);
for i = 1:nj
   
    PR    = P.R*SIM{j(i)}.qU.x{1};
    PR    = PR*256 + 128;
    
    subplot(3,nj,i + 2*nj)
    image(PR)
    ylabel('eccentricity','FontSize',12)
    axis square
 
end
 
spm_figure('GetWin','Figure 4'); clf
as    = 0;
ax    = 0;
av    = 0;
for i = 1:nj
    
    
    Ev = SIM{j(i)}.qU.z{2}(ir,:);
    Es = SIM{j(i)}.qU.z{1};
    av = max(max(abs(Ev(:))),av);
    as = max(max(abs(Es(:))),as);
    
    subplot(3,nj,i)
    plot(t,Es,'r')
    title('Error (sensory)','FontSize',14)
    xlabel('time (ms)','FontSize',12)
    ylabel('error (state)','FontSize',12)
 
    subplot(3,nj,i + nj)
    plot(t,Ev,'r')
    title('Error (hidden states)','FontSize',14)
    xlabel('time (ms)','FontSize',12)
    ylabel('error (state)','FontSize',12)
    
 
end
 
 
for i = 1:nj
    
    subplot(3,nj,i)
    axis square, axis([t(1) t(end) -as*1.2 as*1.2])
    
    subplot(3,nj,i + nj)
    axis square, axis([t(1) t(end) -av*1.2 av*1.2])
 
end
 
 
spm_figure('GetWin','DEM');
spm_DEM_qU(SIM{7}.qU)

 
try, load cornsweet_data, catch, return, end

sim.Con    = C;               % simulated contrast
sim.Ecs    = d1;              % conditional expectation of Cornsweet effect
sim.Emb    = d2;              % conditional expectation of mach band effect
sim.Vcs    = v1;              % conditional dispersion of Cornsweet effect
sim.Vmb    = v2;              % conditional dispersion of mach band effect
 
sim.Con_cs = cornsweet.cornsweet;
sim.Con_mb = mach.machContrast;
G.sim      = sim;     % place in model
 
Y          = struct;
Y.y{1}     = cornsweet.stepMatch(:);
Y.y{2}     = mach.pSeeMach(:);
Y.Q        = spm_Ce([length(Y.y{1}) length(Y.y{2})]); % error precisions
 
 
B.thresh = -2;                % log-contrast threshold for Mach band
B.sig    = 1;                 % parameter of contrast function
B.off    = 2;                 % parameter of contrast function
B.con    = 1/32;              % scaling of reported contrast
B.sen    = 4;                 % parameter of response probability
nb       = length(spm_vec(B));
 
 
G.IS = 'spm_cornsweet';       % function name f(P,M,U) - generative model
G.pE = B;                     % prior expectation of model parameters
G.pC = speye(nb,nb)/8;        % prior covariance  of model parameters
G.hE = [16; 8];               % prior expectation of log-precisions
G.hC = exp(-4);               % prior covariance of log-precisions
 
 
Ep   = spm_nlsi_GN(G,[],Y);
spm_cornsweet(Ep,G,Y);




return

subplot(2,2,1)
SE   = cornsweet.error;
errorbar(cornsweet.cornsweet,cornsweet.stepMatch,SE/2)
xlabel('empirical contrast','Fontsize',12)
ylabel('reported contrast','Fontsize',12)
title('Cornsweet','Fontsize',16)
set(gca,'XLim',[0 .15]);
axis square

subplot(2,2,2)
SE   = mach.error;
errorbar(mach.machContrast,mach.pSeeMach,SE/2)
xlabel('empirical contrast','Fontsize',12)
ylabel('report probability','Fontsize',12)
title('Mach Bands','Fontsize',16)
set(gca,'XLim',[0 .15]);
axis square
 
