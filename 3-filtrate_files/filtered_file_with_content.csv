1671,col2imsum.m,71.5,60,75.0,60,100.0,62.5,70-80,"function a = col2imsum(b,sz,imgsz,delta)


if (nargin<4), delta = [1 1]; end

a = zeros(imgsz);

k = 1;
for j = 1:sz(2)
  for i = 1:sz(1)
    ids_i = i+(0:imgsz(1)/delta(1)-sz(1)/delta(1))*delta(1);
    ids_j = j+(0:imgsz(2)/delta(2)-sz(2)/delta(2))*delta(2);
