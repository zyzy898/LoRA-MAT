    q = 100;
    Tf = 350;
    V = 100;
    C_Af = 1;
    C_A0 = 0.5;
    T_0 = 350;
    T_c0 = 300;

    U = [-3 -6.9] * x;

    x = x + [C_A0;T_0];

    U = U + T_c0;

    f(1,1) = ((1-(q*T)/(2*V) - k0*T*exp(-E_R/x(2)))*x(1) + q/V * C_Af * T)/ ...
             (1 + (q*T)/(2*V)) + u(1)*T;

    f(2,1) = (x(2)*(1-0.5*T- (T*UA)/(2*V*rho*Cp)) + T*(Tf*q/V + (UA*U)/(V*rho*Cp)) ...
              - x(1)*(deltaH*k0*T)/(rho*Cp) * exp(-E_R/x(2))) ...
              / (1+0.5*T*q/V+(T*UA)/(2*V*rho*Cp)) + u(2)*T;

    f = f - [C_A0;T_0];

end"
