2018,ComposeQuat.m,77.0,60,77.78,75,100.0,72.22,70-80,"function [Qout] = ComposeQuat(varargin)

	Num = length(varargin);
	if Num <= 0
		Qout = [1 0 0 0];
	else
		Qout = varargin{1};
		for k = 2:Num
			Q = varargin{k};
			if numel(Q) ~= 4
				warning('Ignoring an invalid rotation parameter!');
				continue;
			end
			Qout = [Qout(1)*Q(1)-dot(Qout(2:4),Q(2:4)) Qout(1)*Q(2:4)+Q(1)*Qout(2:4)+cross(Qout(2:4),Q(2:4))];
		end
	end

end"
2019,ComposeRotmat.m,77.0,60,77.78,75,100.0,72.22,70-80,"function [Rout] = ComposeRotmat(varargin)

