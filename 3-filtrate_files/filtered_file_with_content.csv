end

grd2 = xmin2:delta2:xmax2;

Gabove2 = repmat(grd2', 1, size(x2,2));
Gbelow2 = Gabove2(2:end,:);
Gbelow2(end+1,:) = inf;

X2 = repmat(x2, size(grd2,2),1);
Xin2 = (X2>= Gabove2)&(X2<Gbelow2);


