2954,ConvertAtoG.m,72.834,60,75.0,75,100.0,54.17,70-80,"function G = ConvertAtoG(A)

G = zeros(10,2);
A = A + A';

G(1,:) = [0 0];
visited = zeros(10,1);
visited(1) = 1;


cnt = 0;
while sum(visited) < 10
    cnt = cnt+1;
    for i=2:10
        for j=1:10
            if A(i,j) == 1 && visited(j)
                visited(i) = 1;
                G(i,1) = 1;
                G(i,2) = j;
                break;
            end
        end
    end
end"
2955,convertATPflux2StepNumer.m,79.0,60,91.67,60,100.0,83.33,70-80,"function [Energy_kJ,Energy_kcal,Meter,StepNumber] = convertATPflux2StepNumber(ATP_hydrolysis_flux, sex, weight, height)

Energy_kJ = (ATP_hydrolysis_flux/1000) * 64; %in kJ per person per day
Energy_kcal = Energy_kJ*0.239006; %in kcal per person per day
Meter = Energy_kJ*1000/(3*weight); % per person per day
if strcmp(sex,'male')
    Stride = 0.415 * height; %in cm
else
    Stride = 0.413 * height; %in cm
end
    
StepNumber = Meter/(Stride/100);"
