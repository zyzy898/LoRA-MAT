Nmcmc = 16;
nm = length(models);
p = cell(nm,nm,Nmcmc);
o = cell(nm,nm,Nmcmc);
F = zeros(nm,nm,Nmcmc);
for ii=1:Nmcmc
    R = exp(randn(2,ntrials));
    t = exp(randn(2,ntrials));
    u = zeros(4,ntrials);
