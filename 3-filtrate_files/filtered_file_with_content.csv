        function check(this)
            for i = 1 : length(this.active_list)
                if this.active_list(i)
                    ss = this.getSys(this.SYS_C(i));
                    if sum(ss.flag_f) == 0
                        ss.setFlagF(1:length(ss.flag_f), true(length(ss.flag_f),1));
                    end
                end
            end
        end
