    priors.omega_y	   ={-0.0384 , -5,  5 };
    priors.omega_pai   ={2.8918 , -5,  5 };
    priors.e_ss	       ={3.7927 , 0.0005, 5 };
    priors.z_ss_trans  ={0.7127, 0, 2};
