3342,cost_fun.m,75.286,60,92.86,45,100.0,78.57,70-80,"function cost = cost_fun(N, y, X, x_eq, A,B,Q, R, P, T, m, LAMBDA, PSI)
    cost = 0;
    u=y(1:m*N);
    theta=y(m*N+1:end);
    xk = X;
    uk = u(1:m);
    for k=1:N
        xk1 = dynamics(xk, uk, A, B);
        cost = cost + run_cost(xk, uk, theta, Q, R, LAMBDA,PSI);
        xk = xk1;
        uk = u(m*k+1:m*(k+1));
    end
    cost = cost + term_cost(x, theta, x_eq, P, T, LAMBDA);
end"
3343,cost_func.m,74.0,60,87.5,60,100.0,62.5,70-80,"function [A,C,b_srtd,J] = cost_func(PATH,ts,gamma)
A = A_const(ts);
Ae = eig(A);
  if (min(Ae) < 0)
    A = A + eye(size(A))*(abs(min(Ae)) + .001);
  end
C = permut_mat(ts);
Q = cost_mat(ts);
R = C/A'*Q/A*C';
Re = eig(R);
  if (min(Re) < 0)
    R = R + eye(size(R))*(abs(min(Re)) + .001);
  end
J = 0;
b_srtd = [];
[Rff,Rfp,Rpf,Rpp] = seg_R(R);
for i=1:size(PATH,2)
    bf = const_bf(PATH(:,i));
    bp_star = -Rpp\\Rfp'*bf;
    b_srtd(:,i) = [bf;bp_star];
    J = J + b_srtd(:,i)'*R*b_srtd(:,i) + gamma*ts(end);
end

end"
3344,cost_func2.m,72.286,60,92.86,30,100.0,78.57,70-80,"function J = cost_func2(PATH,del_ts,gamma)
