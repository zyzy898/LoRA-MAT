1346,definePoint.m,81.492,100,61.19,100,100.0,46.27,80-90,"function f = definePoint(f, s, v)


if ( isempty(s) )
    return
end


if ( numel(f) == 1 )
    
    f = columnDefinePoint(f, s, v);
    
else
    
    if ( size(v, 2 - f(1).isTransposed) == 1 )
        v = repmat(v, 1, numColumns(f));
    end
    if ( f(1).isTransposed )
        v = v.';
    end
    for k = numel(f)
        f(k) = columnDefinePoint(f(k), s, v(:,k));
    end
end

end

function f = columnDefinePoint(f, s, v)

if ( isempty(v) )
    error('CHEBFUN:CHEBFUN:definePoint:columnDefinePoint:conversion',...
            'Cannot assign empty values to points.')
elseif ( ~isa(v, 'numeric') )
    error('CHEBFUN:CHEBFUN:definePoint:columnDefinePoint:conversion',...
            ['Conversion to numeric from ', class(v), ' is not possible.'])
elseif ( (min(s) < f.domain(1)) || (max(s) > f.domain(end)) )
    error('CHEBFUN:CHEBFUN:definePoint:columnDefinePoint:outbounds',...
        'Cannot introduce points outside the domain.')
end

if ( ~f.isTransposed )
    dim = 2;
else
    dim = 1;
end

numCols = size(f, dim);

if ( length(v) == 1 )
    v = repmat(v, numel(s), numCols);
elseif ( (size(v, 2) == numCols) && (size(v, 1) == 1) )
    v = repmat(v, numel(s), 1);
elseif ( (numCols == 1) && (min(size(v)) == 1) && (length(v) == length(s)) )
    v = v(:);
elseif ( (numel(s) ~= size(v, 1)) || (numCols ~= size(v, 2)) )
    error('CHEBFUN:CHEBFUN:definePoint:columnDefinePoint:dimensions',...
            'Subscripted assignment dimension mismatch.')
end

sNew = [f.domain(1) ; s(:) ; f.domain(end)]';
sNew = unique(sNew);
f = restrict(f, sNew);

[mem, loc] = ismember(s, f.domain);
f.pointValues(loc,:) = v(mem, :);

end"
1347,defineWebNodes.m,82.646,100,82.35,75,100.0,55.88,80-90,"function xWebNode = defineWebNodes(BLADE, WEB)

NUM_SEC  = BLADE.NUM_SEC;
zSec     = BLADE.zSec;
chord    = BLADE.chord;
pitAxis  = BLADE.pitAxis;
NUM_WEBS = WEB.NUM_WEBS;
inbStn   = WEB.inbStn;
oubStn   = WEB.oubStn;
inbChLoc = WEB.inbChLoc;
oubChLoc = WEB.oubChLoc;

xWebNode = NaN(NUM_SEC, NUM_WEBS);  % x/c location of the webs, use NaN as a placeholder where webs do not exist  
for n = 1:NUM_WEBS
    x  = zSec(inbStn(n):oubStn(n));
    pa = pitAxis(inbStn(n):oubStn(n));
    c  = chord(inbStn(n):oubStn(n));
    y1 = (inbChLoc(n) - pa(1))*c(1);
    y2 = (oubChLoc(n) - pa(end))*c(end);
    x1 = x(1);
    x2 = x(end);
    m  = (y2 - y1)/(x2 - x1);
    y  = m.*(x - x1) + y1;
    
    xWebNode(inbStn(n):oubStn(n),n) = y./c + pa;
end

for i = 1:NUM_SEC   
    if any( diff(xWebNode(i,:)) <= 0 )
        error(['ERROR: The webs are not allowed to cross, but they appear to cross at station ' num2str(i)]);
    end    
end

end % function defineWebNodes"
1348,DefineZone.m,80.456,100,63.64,100,100.0,38.64,80-90,"function zone = DefineZone(s,shape,points)



if nargin < 3,
  error('Incorrect number of parameters (type ''help <a href=""matlab:help DefineZone"">DefineZone</a>'' for details).');
end
if ~isdvector(s,'#2','>0'),
  error('Incorrect size (type ''help <a href=""matlab:help DefineZone"">DefineZone</a>'' for details).');
end
if ~isstring_FMAT(shape,'rectangle','circle'),
  error('Incorrect shape (type ''help <a href=""matlab:help DefineZone"">DefineZone</a>'' for details).');
end
points = round(points);

width = s(1);
height = s(2);

zone = logical(zeros(width,height));

if strcmp(lower(shape),'rectangle'),
	if length(points) ~= 4,
		error('Incorrect points (type ''help <a href=""matlab:help DefineZone"">DefineZone</a>'' for details).');
	end
	x = points(1);
	y = points(2);
	w = points(3);
	h = points(4);
	zone(y:y+h-1,x:x+w-1) = 1;
elseif strcmp(lower(shape),'circle'),
	if length(points) ~= 3,
		error('Incorrect points (type ''help <a href=""matlab:help DefineZone"">DefineZone</a>'' for details).');
	end
	x = points(1);
	y = points(2);
	r = points(3);
	for i = 1:width,
		for j = 1:height,
			if (x-i)^2+(y-j)^2 <= r^2,
				zone(j,i) = 1;
			end
		end
	end
end"
1349,define_input.m,80.418,100,72.53,90,100.0,39.56,80-90,"function inputs = define_input(Clouds,nPD1,nPD2Min,nPD2Max)




create_input
Inputs = inputs;

if ischar(Clouds) || isstring(Clouds)
  matobj = matfile([Clouds,'.mat']);
  names = fieldnames(matobj);
  i = 1;
  n = max(size(names));
  while i <= n && ~strcmp(names{i,:},'Properties')
    i = i+1;
  end
  I = (1:1:n);
  I = setdiff(I,i);
  names = names(I,1);
  names = sort(names);
  nt = max(size(names)); % number of trees/point clouds
else
  P = Clouds;
  nt = 1;
end
inputs(nt).PatchDiam1 = 0;


for i = 1:nt
  if nt > 1
    P = matobj.(names{i});
    inputs(i) = Inputs;
    inputs(i).name = names{i};
    inputs(i).tree = i;
    inputs(i).plot = 0;
    inputs(i).savetxt = 0;
    inputs(i).savemat = 0;
    inputs(i).disp = 0;
  end

  Hb = min(P(:,3));
  Ht = max(P(:,3));
  TreeHeight = double(Ht-Hb);
  Hei = P(:,3)-Hb;

  hSecTop = min(4,0.1*TreeHeight);
  hSecBot = 0.02*TreeHeight;
  hSec = hSecTop-hSecBot;
  Sec = Hei > hSecBot & Hei < hSecTop;
  StemBot = P(Sec,1:3);

  AxisPoint = mean(StemBot);
  V = StemBot-AxisPoint;
  V = normalize(V);
  AxisDir = optimal_parallel_vector(V);

  d = distances_to_line(StemBot,AxisDir,AxisPoint);
  Rstem = double(median(d));

  Res = sqrt((2*pi*Rstem*hSec)/size(StemBot,1));

  pd1 = Rstem/3;%*max(1,TreeHeight/20);
  if nPD1 == 1
    inputs(i).PatchDiam1 = pd1;
  else
    n = nPD1;
    inputs(i).PatchDiam1 = linspace((0.90-(n-2)*0.1)*pd1,(1.10+(n-2)*0.1)*pd1,n);
  end

  pd2 = Rstem/6*min(1,20/TreeHeight);
  if nPD2Min == 1
    inputs(i).PatchDiam2Min = pd2;
  else
    n = nPD2Min;
    inputs(i).PatchDiam2Min = linspace((0.90-(n-2)*0.1)*pd2,(1.10+(n-2)*0.1)*pd2,n);
  end

  pd3 = Rstem/2.5;%*max(1,TreeHeight/20);
  if nPD2Max == 1
    inputs(i).PatchDiam2Max = pd3;
  else
    n = nPD2Max;
    inputs(i).PatchDiam2Max = linspace((0.90-(n-2)*0.1)*pd3,(1.10+(n-2)*0.1)*pd3,n);
  end

  inputs(i).BallRad1 = max([inputs(i).PatchDiam1+1.5*Res;
    min(1.25*inputs(i).PatchDiam1,inputs(i).PatchDiam1+0.025)]);
  inputs(i).BallRad2 = max([inputs(i).PatchDiam2Max+1.25*Res;
    min(1.2*inputs(i).PatchDiam2Max,inputs(i).PatchDiam2Max+0.025)]);

end"
