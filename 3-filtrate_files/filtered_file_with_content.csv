6676,comp_hermite_all.m,68.706,60,64.71,60,100.0,58.82,61-70,"function y = comp_hermite_all(n, x)



rt = 1 / sqrt(sqrt(pi));


y = zeros(length(x), n);

y(:, 1) = rt * exp(-0.5 * x.^2);
if n > 1
   y(:, 2) = rt * sqrt(2) * x .* exp(-0.5 * x.^2);
end
for k = 2:n-1
        y(:, k+1) = sqrt(2)*x.*y(:, k) - sqrt(k-1)*y(:, k-1);
