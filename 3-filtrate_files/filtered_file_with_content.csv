        tok_ori = tok;
        tok = regexprep(tok,'-','_');
        metabolite_structure.(tok) = struct();
           metabolite_structure.(tok).VMHId = regexprep(tok,'VMH_','');
           metabolite_structure.(tok).originalID = model.mets{i};
