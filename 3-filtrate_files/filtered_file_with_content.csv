    Fac(fac).used      = false; % Factor is being used ?
    Fac(fac).type      = ''; % {'motion','measurement','absolute'}
    Fac(fac).rob       = []; % rob index
    Fac(fac).sen       = []; % sen index
    Fac(fac).lmk       = []; % lmk index
    Fac(fac).frames    = []; % Frames (one or more)
