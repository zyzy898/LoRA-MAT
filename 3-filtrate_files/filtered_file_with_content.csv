        coef('ygap','pi',2,'syncoef',istate),0
        coef('ygap','pi',0,'syncoef',istate)+coef('ygap','FFR',0,'syncoef',istate),0
        }
        ]; %#ok<AGROW>
    nonlin_restr=[nonlin_restr
        {
		['coef(ygap,FFR,0,syncoef,',int2str(istate),')>=0']
        }
        ]; %#ok<AGROW>
end

end"
3880,create_restrictions_and_markov_chains3.m,74.642,100,79.49,45,100.0,48.72,70-80,"function [lin_restr,nonlin_restr,tpl]=create_restrictions_and_markov_chains3(tpl)

