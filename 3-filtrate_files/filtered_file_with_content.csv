U(3,:)  = 2*sin(pi*[1:T]/8);
DEM     = spm_DEM_generate(M,U);

spm_figure('GetWin','Figure 1'); clf
spm_DEM_qU(DEM.pU)
 
subplot(2,2,4)
imagesc(DEM.Y)
axis square
xlabel time
 
DEM        = spm_DEM(DEM);
 
spm_DEM_qU(DEM.qU,DEM.pU)
 
qx      = DEM.qU.x{1};
px      = DEM.pU.x{1};
qx(1,:) = qx(1,:) - px(1,:);
px(1,:) = px(1,:) - px(1,:);
for i = 1:T
    P(:,i) = spm_gx_Gabor(px(:,i),[],[]);
    Q(:,i) = spm_gx_Gabor(qx(:,i),[],[]);
end
 
spm_figure('GetWin','Figure 2'); clf

subplot(2,2,1)
