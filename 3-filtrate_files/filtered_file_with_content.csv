4842,ddz.m,79.936,100,70.97,90,100.0,38.71,70-80,"function d=ddz(z,bc)




if nargin < 2;
    bc=2;
end

del=mean(diff(z));
N=length(z);
d=zeros(N,N);

for n=2:N-1
    d(n,n-1)=-1.;
    d(n,n+1)=1.;
end

if bc==1
    d(1,2)=1;
    d(N,N-1)=-1;
elseif bc==2;
    d(1,1)=-3;
    d(1,2)=4;
    d(1,3)=-1.;
    d(N,N)=3;
    d(N,N-1)=-4;
    d(N,N-2)=1;
end

d=d/(2*del);"
4843,ddz2.m,78.0,100,72.97,90,100.0,27.03,70-80,"function d=ddz2(z,bc)





if nargin < 2
    bc=2;
end

del=mean(diff(z));
N=length(z);
d=zeros(N,N);

for n=2:N-1
    d(n,n-1)=1.;
    d(n,n)=-2.;
    d(n,n+1)=1.;
end

if bc==1;
    d(1,1)=-2;
    d(1,2)=1;
    d(N,N)=-2;
    d(N,N-1)=1;
elseif bc==2;
    d(1,1)=2;
    d(1,2)=-5;
    d(1,3)=4;
    d(1,4)=-1;
    d(N,N)=2;
    d(N,N-1)=-5;
    d(N,N-2)=4;
    d(N,N-3)=-1;
end

d=d/del^2;"
4844,ddz4.m,72.714,60,76.19,75,100.0,52.38,70-80,"function d=ddz4(z) 



if abs(std(diff(z))/mean(diff(z)))>.000001 
disp(['ddz2: values not evenly spaced!']) 
d=NaN; 
return 
end 
del=z(2)-z(1);N=length(z); 
d=zeros(N,N); 
for n=3:N-2 
d(n,n-2)=1.;
d(n,n-1)=-4.; 
d(n,n)=6.; 
d(n,n+1)=-4.;
d(n,n+2)=1.;
end 
d=d/del^4; 
return 
end"
