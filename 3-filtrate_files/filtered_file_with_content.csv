5874,descFileRead.m,73.63,60,77.78,60,100.0,70.37,70-80,"function raw = descFileRead(fileName)

f = fopen(fileName);

header = fgetl(f);
headers = strrep(strsplit(header,'\\t','CollapseDelimiters',false),' ','_');

cline = fgetl(f);
data = cell(2*length(headers),1);
data(:) = {''};
currentLine = 1;
while cline ~= -1
    cdata = strsplit(cline,'\\t','CollapseDelimiters',false);
    for i = 1:length(cdata)
        cdataElem = cdata{i};
        exData = data{2*i};
        exData(currentLine,1:length(cdataElem)) = cdataElem;
        data{2*i} = exData;
    end
    currentLine = currentLine + 1;
    cline = fgetl(f);
end
[data{1:2:end}] = deal(headers{:});

raw = struct(data{:});
    
fclose(f);"
