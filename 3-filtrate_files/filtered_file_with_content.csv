      fprintf (1,'To turn the cardinal data to %s''s plane use:\\n', fname);
      fprintf (1,'3drotate -matvec_dicom %s ...\\n\\n',  fmatvec );

      fprintf (1,'To test for individual points add options: -origin %g %g %g -points\\n\\n',...
