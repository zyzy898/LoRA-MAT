        debug_slow = convertSeperateTsToArrayTs(debug_slow);
        disp('Successfully parsed slow logging file!'); 
        if(nargin == 4)
          save(save_file, 'debug', 'debug_slow', '-v7.3'); 
        end
    else
        if(nargin == 4)
          save(save_file, 'debug','-v7.3'); 
        end
    end  
end"
504,convertf.m,84.186,100,74.42,100,100.0,46.51,80-90,"function [A,b,c,K]=convertf(A,b,c,K)
m=length(b);
[Am,An]=size(A);
if (Am ~= m)
  if (An == m)
    fprintf('Transposing A to match b \\n');
    A=A';
  else
    fprintf('A is not of the correct size to match b \\n');
    return
  end
end
if (c == 0)
  fprintf('Expanding c to the appropriate size\\n');
  [Am,An]=size(A);
  c=zeros(An,1);
end
if (isempty(c))
  fprintf('Expanding empty c to zeros of the appropriate size\\n');
  [Am,An]=size(A);
  c=zeros(An,1);
end
[cm,cn]=size(c);
if (cn > cm)
  c=c';
end
if (isfield(K,'f'))
  nfree=K.f
  fprintf('Converting %d free variables to LP variables\\n',nfree);
  if (isfield(K,'l'))
    nlin=K.l;
  else
    nlin=0;
  end
  [Am,An]=size(A);
  Anew=[A(:,1:nfree) -A(:,1:nfree) A(:,nfree+1:An)];
  A=Anew;
  cnew=[c(1:nfree); -c(1:nfree); c(nfree+1:An)];
  c=cnew;

  K.l=nlin+2*nfree;
  K.f=0;
end"
505,convertGene2PathwayInteractions.m,82.186,100,72.09,90,100.0,48.84,80-90,"function [neg, zer, nd, pos] = convertGene2PathwayInteractions(E, epSys, uSys)

if (nargin < 3)
    uSys = unique(convertMyCell2List(epSys, 2));
end

negE = (E < -0.25);
zerE = (E >= -0.25) & (E < 0.25);
ndE = (E >= 0.25) & (E < 0.85);
posE = (E >= 0.85);
g1 = 0;
g2 = 0;
pos = zeros(length(uSys), length(uSys)); neg = pos; nd = pos; zer = pos;
for i = 1:length(uSys)
    index1 = cellfun(@strcmp, epSys, repmat(uSys(i), length(epSys), 1));
    for j = 1:length(uSys)
        index2 = cellfun(@strcmp, epSys, repmat(uSys(j), length(epSys), 1));
        pos(i, j) = sum(sum(posE(index1, index2)));
        neg(i, j) = sum(sum(negE(index1, index2)));
        nd(i, j) = sum(sum(ndE(index1, index2)));
        zer(i, j) = sum(sum(zerE(index1, index2)));
    end
end

function B = convertMyCell2List(A, dimSense)




cnt = 0;
if nargin < 2
    dimSense = 2;
end
for i = 1:length(A)
    for j = 1:length(A{i, 1})
        cnt = cnt + 1;
        if dimSense == 1
            B{cnt, 1} = A{i, 1}{1, j};
        elseif dimSense == 2
            B{cnt, 1} = A{i, 1}{j, 1};
        end
    end
end"
506,convertIGScoords.m,83.308,100,83.08,75,100.0,58.46,80-90,"function OUT = convertIGScoords(date)

y = date(1);
m = date(2);
d = date(3);
jd = cal2jd_GT(y,m,d);
[doy, yyyy] = jd2doy_GT(jd);
[gpsweek, sow, ~] = jd2gps_GT(jd);
dow = floor(sow/3600/24);
gpsweek_str = sprintf('%04d',gpsweek);
dow_str     = sprintf('%01d',dow);
yyyy_str    = sprintf('%04d',yyyy);
doy_str 	= sprintf('%03d',doy);

URL_host = 'igs.ensg.ign.fr:21';
URL_folder = ['/pub/igs/products/', gpsweek_str, '/'];
URL_file = ['igs' yyyy_str(3:4), 'P', gpsweek_str, dow_str, '.ssc.Z'];
target = pwd;
[~, ~] = mkdir(target);
file_status = ftp_download(URL_host, URL_folder, URL_file, target, true);
if file_status == 0
    errordlg('Download of IGS coordinates failed', 'Error')
    return          % file download failed
end
path_info = what([pwd, '/../CODE/7ZIP/']);      % canonical path of 7-zip is needed
path_7zip = [path_info.path, '/7za.exe'];
curr_archive = [target, '/', URL_file];
file_unzipped = unzip_7zip(path_7zip, curr_archive);
delete(curr_archive);


fid = fopen(file_unzipped);
FILE = textscan(fid,'%s', 'delimiter','\\n', 'whitespace','');
FILE = FILE{1};
fclose(fid);
delete(file_unzipped);
n = length(FILE);             	% number of lines
OUT = cell(0); ii = 1;          % to save output

i = 1; line = FILE{i};  % get first line

while ~contains(line, '+SOLUTION/ESTIMATE')
    i = i + 1; line = FILE{i};
end

while i < n
    i = i + 1; line = FILE{i};
    if contains(line, 'STAX')       % new station
        line1 = FILE{i};
        line2 = FILE{i+1};
        line3 = FILE{i+2};
        stat = line1(15:18);        
        X = str2double(line1(48:68));
        Y = str2double(line2(48:68));
        Z = str2double(line3(48:68));
        string = [stat '   ' sprintf('% 30.3f', X) sprintf('% 16.3f', Y) sprintf('% 16.3f', Z)];
        OUT{ii} = string;     ii = ii + 1;
    end
end

OUT = OUT';
fid2 = fopen('out.txt','w');
CT = OUT.';
fprintf(fid2,'%s\\n', CT{:});
fclose(fid2);"
507,convertLeksellFileToHex.m,80.526,60,78.95,90,100.0,73.68,80-90,"function convertLeksellFileToHex(fileName)

