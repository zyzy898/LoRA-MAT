4479,cvx_version.m,77.04,70,70.13,100,100.0,45.07,70-80,"function varargout = cvx_version( varargin )


global cvx___

args = varargin;
compile = false;
exit_if = false;
quick = nargout > 0;
if nargin
    if ~ischar( args{1} ),
        quick = true;
    else
        tt = strcmp( args, '-quick' );
        quick = any( tt );
        if quick, args(tt) = []; end
        tt = strcmp( args, '-compile' );
        compile = any( tt );
        if compile, quick = false; args(tt) = []; end
        tt = strcmp( args, '-exit-if' );
        exit_if = any( tt );
        if exit_if, quick = false; args(tt) = []; end
    end
end

cvx___.exit_if = exit_if;
if isfield( cvx___, 'loaded' ),
    
    if quick, return; end
    fs = cvx___.fs;
    mpath = cvx___.where;
    isoctave = cvx___.isoctave;
    
else
    
    isoctave = exist( 'OCTAVE_VERSION', 'builtin' );

    comp = computer;
    if isoctave,
        mext = 'mex';
        izpc = false;
        izmac = false;
        switch comp
        case 'x86_64-pc-linux-gnu'
            msub = 'o_lin';
        case 'x86_64-apple-darwin21.6.0'
            msub = 'o_maci';
        case 'aarch64-apple-darwin23.4.0'
            msub = 'o_maca';
        case 'x86_64-w64-mingw32'
            msub = 'o_win';
        otherwise
            warning(sprintf('Unexpected Octave computer type: %s', COMPUTER));
            msub = '';
        end
    else
        izpc = strncmp( comp, 'PC', 2  );
        izmac = strncmp( comp, 'MAC', 3 );
        mext = mexext;
        msub = '';
    end
    if izpc,
        fs = '\\'; 
        fsre = '\\\\';
        ps = ';'; 
        cs = false;
    else
        fs = '/'; 
        fsre = '/';
        ps = ':';
        cs = ~izmac;
    end

    mpath = mfilename('fullpath');
    temp = strfind( mpath, fs );
    mpath = mpath( 1 : temp(end) - 1 );

    nver = version;
    nver(nver=='.') = ' ';
    nver = sscanf(nver,'%d');
    nver = nver(1) + 0.01 * ( nver(2) + 0.01 * nver(3) );
    
    if isoctave || ~usejava('jvm'),
        jver = 0;
    else
        jver = char(java.lang.System.getProperty('java.version'));
        try
            ndxs = strfind( jver, '.' );
            jver = str2double( jver(1:ndxs(2)-1) );
        catch
            jver = 0;
        end
    end
    
    cvx___.where = mpath;
    cvx___.isoctave = isoctave;
    cvx___.nver = nver;
    cvx___.jver = jver;
    cvx___.comp = comp;
    cvx___.mext = mext;
    cvx___.msub = msub;
    cvx___.fs = fs;
    cvx___.fsre = fsre;
    cvx___.ps = ps;
    cvx___.cs = cs;
    
end


if quick,
    if nargout,
        varargout = { fs, cvx___.ps, mpath, cvx___.mext };
    end
    cvx_load_prefs( false );
    cvx___.loaded = true;
    return
end


cvx_ver = '2.2';
cvx_bld = '****';
cvx_bdate = '<undated>';
cvx_bcomm = '*******';
line = '---------------------------------------------------------------------------';
fprintf( '\\n%s\\n', line );
fprintf( 'CVX: Software for Disciplined Convex Programming       (c)2014 CVX Research\\n' );
fprintf( 'Version %3s, Build %3s (%7s)%42s\\n', cvx_ver, cvx_bld, cvx_bcomm, cvx_bdate );
fprintf( '%s\\n', line );
fprintf( 'Installation info:\\n    Path: %s\\n', cvx___.where );
if isoctave,
