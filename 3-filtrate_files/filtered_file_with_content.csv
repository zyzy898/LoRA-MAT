N = double(max(VertLay));
I = VertLay == N;
Vert(I,3) = Hbot;
ind = (1:1:nv)';
ind = ind(I);
Curve = Vert(I,:); % Boundary curve of the bottom
n = size(Curve,1);
if n < 10
  triangulation = zeros(0,1);
  disp('  No triangulation: Ground layer boundary curve too small')
  return
end

C = zeros(n,2);
C(:,1) = (1:1:n)';
C(1:n-1,2) = (2:1:n)';
C(n,2) = 1;
warning off
dt = delaunayTriangulation(Curve(:,1),Curve(:,2),C);
In = dt.isInterior();
GroundTria = dt(In,:);
Points = dt.Points;
