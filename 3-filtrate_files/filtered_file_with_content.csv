2843,contourMatrixToPolylines.m,72.42,60,73.68,60,100.0,68.42,70-80,"function polys = contourMatrixToPolylines(C)


nCoords = size(C, 2);

nContours = 0;
offset = 1;
while offset < nCoords
    nContours = nContours + 1;
    offset = offset + C(2, offset) + 1;
end

polys = cell(nContours, 1);
offset = 1;
for iContour = 1:nContours
    nv = C(2, offset);
    polys{iContour} = C(:, offset + (1:nv))';
    offset = offset + nv + 1;
end"
