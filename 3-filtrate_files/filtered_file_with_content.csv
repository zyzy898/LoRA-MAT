5816,dependentTerms.m,72.902,100,68.29,45,100.0,51.22,70-80,"function [zSq,zH] = dependentTerms(matZ,r)



C=matZ.C;
G=matZ.G;
n=dim(matZ);
gens=matZ.numgens;


sqC = C^2*r^2 + 0.5*sum(pagemtimes(G,G),3)*r^2;

sqG = cat(3, ...
    (pagemtimes(C,G) + pagemtimes(G,C))*r^2, ...
    0.5*pagemtimes(G,G)*r^2 ...
);
if (gens>=2)
    ind = combinator(gens,2,'c');
    sqG = cat(3, ...
            sqG, ...
            ( ...
                pagemtimes( ...
                    G(:,:,ind(:,1)), ...
                    G(:,:,ind(:,2))) ...
                + ...            
                pagemtimes( ...
                    G(:,:,ind(:,2)), ...
                    G(:,:,ind(:,1))) ...
            ) * r^2 ...
    );
end


HC = eye(n) + C*r + 0.5*sqC;

HG = 0.5 * sqG;
HG(:,:,1:gens) = HG(:,:,1:gens) + G*r;


zSq=matZonotope(sqC,sqG);
zH=matZonotope(HC,HG);"
5817,depfunFast.m,77.642,100,64.15,75,100.0,49.06,70-80,"function filelist = depfunFast(fn,recursive)



if ~ischar(fn)
    error('First argument must be a string');
end

foundfile = which(fn);
if isempty(foundfile)
    error('File not found: %s',fn);
end

filelist = i_scan(foundfile);

if nargin>1 && recursive
    toscan = filelist;
    toscan = toscan(2:end); % first entry is always the same file again
    while numel(toscan)>0
        newlist = i_scan(toscan{1});
        newlist = newlist(2:end); % first entry is always the same file again
        toscan(1) = []; % remove the file we've just scanned
        reallynew = ~ismember(newlist,filelist);
        newlist = newlist(reallynew);
        toscan = unique( [ toscan ; newlist ] );
        filelist = unique( [ filelist ; newlist ] );
    end
end
end
function list = i_scan(f)

func = i_function_name(f);

list = depfun(func,'-toponly','-quiet');
ulist = lower(list);

toolboxroot = lower(fullfile(matlabroot,'toolbox'));

intoolbox = strncmp(ulist,toolboxroot,numel(toolboxroot));

list = list(~intoolbox);
end
function func = i_function_name(f)

[dirname,funcname,ext] = fileparts(f);
[ignore,dirname] = fileparts(dirname);

if ~isempty(dirname) && dirname(1)=='@'
    func = [ dirname '/' funcname ];
else
    func = funcname;
end
end"
5818,depixellise.m,78.428,100,71.43,75,100.0,45.71,70-80,"function [uu,Up,Uc] = depixellise(pix,cal)



u0 = cal(1);
v0 = cal(2);
au = cal(3);
av = cal(4);

u = pix(1,:);
v = pix(2,:);

uu = [(u-u0)/au
    (v-v0)/av];

if nargout > 1
    Up = [...
        [ 1/au,    0]
        [    0, 1/av]];
    Uc = [...
        [        -1/au,            0, (-u+u0)/au^2,            0]
        [            0,        -1/av,            0, (-v+v0)/av^2]];
end

return


syms u0 v0 au av u v real
pix = [u;v];
cal = [u0;v0;au;av];

[u,Up,Uc] = depixellise(pix,cal);

simplify(Up - jacobian(u,pix))
simplify(Uc - jacobian(u,cal))"
5819,depixelliseOmniCam.m,78.384,100,63.46,90,100.0,38.46,70-80,"function [u,U_p,U_k] = depixelliseOmniCam(pix, k)


  n_points = size(pix,2);
  
  xc = k(1);
  yc = k(2);
  c  = k(3);
  d  = k(4);
  e  = k(5);

  A = [1 e;
       d c ];

  T = [xc;yc]*ones(1,n_points);
  u = A^-1*(pix-T);


  if nargout > 1 % jacobians
    
    if n_points > 1
      error('Jacobians not available for multiple points');
    end
    
    u1 = pix(1);
    u2 = pix(2);
    
    U_p = [...
            [  c/(c - d*e), -e/(c - d*e)]
            [ -d/(c - d*e),  1/(c - d*e)]
          ];

    U_k = [...
            [ -c/(c - d*e),  e/(c - d*e), (u1 - xc)/(c - d*e) - (c*(u1 - xc))/(c - d*e)^2 + (e*(u2 - yc))/(c - d*e)^2,                     (c*e*(u1 - xc))/(c - d*e)^2 - (e^2*(u2 - yc))/(c - d*e)^2, (c*d*(u1 - xc))/(c - d*e)^2 - (u2 - yc)/(c - d*e) - (d*e*(u2 - yc))/(c - d*e)^2]
            [  d/(c - d*e), -1/(c - d*e),                           (d*(u1 - xc))/(c - d*e)^2 - (u2 - yc)/(c - d*e)^2, (e*(u2 - yc))/(c - d*e)^2 - (u1 - xc)/(c - d*e) - (d*e*(u1 - xc))/(c - d*e)^2,                         (d*(u2 - yc))/(c - d*e)^2 - (d^2*(u1 - xc))/(c - d*e)^2]
          ];

  end

return


syms xc yc c d e real
syms u1 u2 real

pix = [u1;u2];
k   = [xc yc c d e];

u = depixelliseOmniCam(pix,k);

U_p = jacobian(u,pix)
U_k = jacobian(u,k)"
