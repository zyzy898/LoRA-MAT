  case 'all',
    TRIALS = 1:ctf.setup.number_trials;
  otherwise
end
TRIALS = unique(sort(TRIALS));



for trial = TRIALS,
    
    fprintf('...exporting trial %d of %d trials in ctf.data\\n',trial,Ntrials);
    
    
    data = ctf.data(TIME_index,CHAN,trial);
    
