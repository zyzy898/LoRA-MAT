1708,collision_base.m,75.532,80,53.24,100,100.0,44.42,70-80,"classdef (Abstract) collision_base < handle



    properties (Dependent)
        Pose
        
    end
    
    properties (Access = protected)
        
        PoseInternal

        VisualMeshVertices
        
        VisualMeshFaces
        
        EstimatedMaxReach
    end
    
    properties (Hidden, SetAccess = protected)
        Position
        
        Quaternion
    end
    
    properties (Hidden, Transient, SetAccess = protected)
                
        GeometryInternal
                
    end

    methods

        function obj = collision_base()
            obj.Pose = eye(4);

        end
        
        function [axOut, patchObjOut] = show(obj, varargin)
            
            parser = inputParser;
            parser.StructExpand = false;
            parser.addParameter('Parent', [], ...
                @(x)robotics.internal.validation.validateAxesHandle(x));
            
            parser.parse(varargin{:});
            
            ph = parser.Results.Parent;

            if isempty(ph)
                ax = newplot; 
            else
                ax = newplot(ph);
            end
            
            if strcmp(ax.NextPlot, 'replace') % when hold is off, reset scene
                resetScene(obj, ax);
            end
            
            q = quaternion(obj.Quaternion);
            
            Vt = obj.Position + q.rotatepoint(obj.VisualMeshVertices);
            
            if isempty(obj.VisualMeshFaces)
                patchObj = patch(ax, 'Vertices', Vt, ...
                  'FaceColor', [1, 0.5, 0]);
            else
                patchObj = patch(ax,'Faces', obj.VisualMeshFaces,...
                  'Vertices', Vt, ...
                  'FaceColor', [1, 0.5, 0]);                
            end
            
            if nargout > 0
                axOut = ax;
            end
            
            if nargout > 1
                patchObjOut = patchObj;
            end
        end

    end
    
    methods
        function set.Pose(obj, tform)
            obj.updatePose(tform);
        end
        
        function pose = get.Pose(obj)
            pose = obj.PoseInternal;
        end
    end
    
    methods (Access = protected)
        function resetScene(obj, ax)
            
            axis(ax, 'vis3d');
            hFigure = ax.Parent;
            pan(hFigure,'on');
            rotate3d(hFigure,'on');
            
            ax.Visible = 'off';
            daspect(ax, [1 1 1]);
            
            a = obj.EstimatedMaxReach;
            if obj.EstimatedMaxReach == 0.0
                a = 1e-10;
            end
            set(ax, 'xlim', obj.Position(1) + [-a, a], 'ylim', obj.Position(2) + [-a, a], 'zlim', obj.Position(3) + [-a, a]);
            
            xlabel(ax, 'X');
            ylabel(ax, 'Y');
            zlabel(ax, 'Z');
            
            view(ax, [135 8]);
            set(ax, 'Projection', 'perspective');
            ax.CameraViewAngle = 8.0;
            grid(ax, 'on');
            
            if isempty(findobj(ax,'Type','Light'))
                light('Position',[a, 0, a],'Style','local','parent',ax);
            end
            ax.Visible = 'on';
            
        end
        
        function updatePose(obj, pose)

            pos = pose(1:3, 4)';
            quat = physics.RotationMatrixToQuaternion(pose(1:3, 1:3));
            obj.Position = pos;         
            obj.Quaternion = quat;
            
            obj.PoseInternal = pose;

        end
    end
end"
1709,collision_time.m,73.092,60,90.91,60,100.0,54.55,70-80,"function t=collision_time(s,t,x,T)

if nargin<4
	T=1e6;
end;
sl=s(1); sr=s(2);
tl=t(1); tr=t(2);
xl=x(1); xr=x(2);
if sr > sl, 
	t=T+1;
elseif sr < sl, 
	h1=sl*tl;
	h2=sr*tr;
	h3=xl-xr;
	h4=sl-sr;
	h1=(h1-h2-h3);
	t=h1/h4;    % this is not safe programming, but seems to work ok...
elseif (xl==xr)&&(tl==tr),
	t=tl;
else
	t=T+1;
end;"
1710,Collocation.m,77.424,100,68.18,75,100.0,43.94,70-80,"classdef Collocation < handle

  properties

    daefun
    pathcostfun
    
    coefficients
    coeff_eval
    coeff_der
    coeff_int

    vars
    num_x
    num_z
    num_u
    num_p
    num_t

    num_i
    
    tau_root
    order
  end

  methods

    function self = Collocation(states, algvars, controls, parameters, statesOrder, daefun, pathcostfun, d)

      nx = length(states);
      nz = length(algvars);
      nu = length(controls);
      np = length(parameters);
      nt = d;
      
      v = ocl.types.Structure();
      v.addRepeated({'states', 'algvars'}, {states, algvars}, d);

      tau = [0 ocl.collocation.collocationPoints(d)];
      
      coeff = ocl.collocation.coefficients(tau);
      
      self.daefun = daefun;
      self.pathcostfun = pathcostfun;
      
      self.coefficients = coeff;
      self.coeff_eval = ocl.collocation.evalCoefficients(coeff, d, 1.0);
      self.coeff_der = ocl.collocation.evalCoefficientsDerivative(coeff, tau, d);
      self.coeff_int = ocl.collocation.evalCoefficientsIntegral(coeff, d, 1.0);

      self.vars = v;
      self.num_x = nx;
      self.num_z = nz;
      self.num_u = nu;
      self.num_p = np;
      self.num_t = nt;
      
      self.num_i = length(v);
      
      self.tau_root = tau;
      self.order = d;
      
    end

  end
end"
