    S2_max(index) = max(error_last);                   % maximum error value

    S3_result(index) = nan;
    for i = 1:step_num
        if sum(error(i:step_num) > steady_threshold) == 0
            S3_result(index) = i*Ts;
            break
        end
    end
    
end

