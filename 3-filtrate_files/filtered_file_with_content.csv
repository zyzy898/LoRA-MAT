6022,CreateMatrixFromPrimaries_xy.m,61.636,60,72.73,30,100.0,45.45,61-70,"function mtx = CreateMatrixFromPrimaries_xy(R, G, B, Wp)


R  = ConvertXYZtoYxy(reshape([1.0,  R], 1, 1, 3), 1);
G  = ConvertXYZtoYxy(reshape([1.0,  G], 1, 1, 3), 1);
