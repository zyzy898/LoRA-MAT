            HR = cat(3,HR,HR,HR);
        end
        [~,imageName,ext] = fileparts(filepaths(i).name);
        HR  = modcrop(HR, sf);
        label_RGB = HR;
        blury_HR = imfilter(im2double(HR),double(kernel),'replicate'); % blur
        LR       = imresize(blury_HR,1/sf,'bicubic'); % bicubic downsampling
