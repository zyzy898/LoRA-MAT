    b( 1, tt ) = NaN;
end
if clean,
    b1 = b( 1, : );
    if nnz( b ) == nnz( b1 ),
        v = cvx_reshape( b1, s );
        return
    end
end

v = class( struct( 'size_', s, 'basis_', b, 'dual_', '', 'dof_', d, 'slow_', slow ), 'cvx', cvxobj );"
