xlabel('iteration','FontSize',12)"
5725,DEM_demo_Laplace.m,76.17,100,83.02,45,100.0,52.83,70-80,"n  = 128;                       % number of samples (time bins)
P  = 4;                         % true parameter
k  = n;                         % precision on fluctuations
pp = 2;                         % prior on parameter
m  = 8;                         % number of data
iS = eye(m,m)*2;                % error precision
s  = sqrtm(inv(iS));
 
p  = [0;0];                     % initial parameter estimates
for i = 1:n
    
    x      = 4 + randn(m,1);          % exogenous input
    z      = s*randn(m,1);            % error
    y      = P*x + z;                 % response
    e      = y - p(1)*x;              % prediction error
    Lp     = -e'*iS*x + pp*p(1);
    Lpp    = x'*iS*x  + pp;
    f      = [p(2); (-Lp -k*p(2))];
    dfdx   = [0 1;   -Lpp -k];
    p      = p + spm_dx(dfdx,f,1);
    X(:,i) = p;
    LP(i)  = Lp;
end
 
subplot(2,1,1)
plot(1:n,X)
title('generalised parameter estimates','FontSize',16)
 
subplot(2,1,2)
plot(1:n,LP)
title('energy gradient','FontSize',16)

 
return

M.f = inline('[x(2); (u - K(1)*x(2))]','x','u','K','M');
M.m = 1;
M.n = 2;
M.l = 2;
M.x = [0;0];
M.u = 0;

N   = 128;
dt  = 1/64;
K   = 4;
[K0,K1,K2] = spm_kernels(M,K,N,dt);

subplot(2,1,1)
plot([1:N]*dt,K1);
xlabel('time (s)')
title('Kernels','FontSize',16)
legend('drive','trace')
axis square"
5726,DEM_demo_large_fMRI.m,73.96,80,65.47,75,100.0,49.33,70-80,"function DEM_demo_large_fMRI


rng('default')

N  = 4;                               % number of runs
T  = 512;                             % number of observations (scans)
TR = 2;                               % repetition time or timing
n  = 6;                               % number of regions or nodes
t  = (1:T)*TR;                        % observation times

options.maxnodes   = 4;               % effective number of nodes

options.nonlinear  = 0;
options.two_state  = 0;
options.stochastic = 0;
options.centre     = 1;
options.induced    = 1;

A   = ones(n,n);
B   = zeros(n,n,0);
C   = zeros(n,n);
D   = zeros(n,n,0);
pP  = spm_dcm_fmri_priors(A,B,C,D,options);


pP.A = randn(n,n)/12;
pP.A = pP.A - diag(diag(pP.A));
pP.C = eye(n,n);
pP.transit = randn(n,1)/16;


U.u  = spm_rand_mar(T,n,1/2)/8;      % endogenous fluctuations
U.dt = TR;
M.f  = 'spm_fx_fmri';
M.x  = sparse(n,5);
x    = spm_int_J(pP,M,U);

for i = 1:T
    y(i,:) = spm_gx_fmri(spm_unvec(x(i,:),M.x),[],pP)';
end

e    = spm_rand_mar(T,n,1/2)/8;

i = 1:256;
spm_figure('Getwin','Figure 1'); clf
subplot(2,2,1)
plot(t(i),U.u(i,:))
title('Endogenous fluctuations','FontSize',16)
xlabel('Time (seconds)')
ylabel('Amplitude')
axis square

subplot(2,2,2), hold off
plot(t(i),x(i,n + 1:end),'c'), hold on
plot(t(i),x(i,1:n)), hold off
title('Hidden states','FontSize',16)
xlabel('Time (seconds)')
ylabel('Amplitude')
axis square

subplot(2,2,3)
plot(t(i),y(i,:),t(i),e(i,:),':')
title('Hemodynamic response and noise','FontSize',16)
xlabel('Time (seconds)')
ylabel('Amplitude')
axis square


DCM.options = options;

DCM.a    = ones(n,n);
DCM.b    = zeros(n,n,0);
DCM.c    = zeros(n,1);
DCM.d    = zeros(n,n,0);

DCM.Y.y  = y + e;
DCM.Y.dt = TR;
DCM.U.u  = zeros(T,1);
DCM.U.dt = TR;

DCM   = spm_dcm_fmri_csd(DCM);


pP.A  = DCM.Ep.A;

M.g   = 'spm_gx_fmri';
CSD   = {};
RMS   = [];
Qp    = [];
Pp    = pP.A - diag(diag(pP.A));
for i = 1:N
    try

        U.u  = spm_rand_mar(T,n,1/2)/8;      % endogenous fluctuations
        y    = spm_int_J(pP,M,U);            % integrate with observer
        
        e    = spm_rand_mar(T,n,1/2)/8;
        
        DCM.Y.y  = y + e;
        
        CSD{end + 1} = spm_dcm_fmri_csd(DCM);
        BPA          = spm_dcm_average(CSD,'simulation',1);
        DCM.M.P      = BPA.Ep;
        
        qp   = CSD{end}.Ep.A;
        Qp(:,end + 1) = spm_vec(qp - diag(diag(qp)));
                
        dp   = BPA.Ep.A - pP.A;
        dp   = dp - diag(diag(dp));
        RMS(end + 1) = sqrt(mean(dp(~~dp).^2));
        
        
        spm_figure('Getwin','Figure 2'); clf
        
        subplot(2,1,1); hold off
        spm_plot_ci(BPA.Ep.A(:),BPA.Cp(1:n*n,1:n*n)), hold on
        bar(pP.A(:),1/4), hold off
        title('True and MAP connections','FontSize',16)
        axis square
        
        subplot(2,2,3); cla
        plot(Pp(:),Qp,'cd','MarkerSize',8),hold on
        plot(Pp,BPA.Ep.A - diag(diag(BPA.Ep.A)),'b.','MarkerSize',16), hold off
        title('True and MAP connections (Extrinsic)','FontSize',16)
        xlabel('True')
        ylabel('Estimated')
        axis square
        
        subplot(2,2,4);
        plot(RMS)
        title('root mean square error','FontSize',16)
        xlabel('number of sessions')
        ylabel('RMS')
        axis square
        drawnow
        
    end
end"
5727,DEM_demo_Lorenz.m,75.146,80,56.73,75,100.0,64.0,70-80,"function DEM_demo_Lorenz

 

M       = spm_DEM_M('Lorenz');
 
M(1).V  = exp(0);
M(1).W  = exp(16);
 
M(2).v  = 0;
M(2).V  = exp(16);
 
 
N       = 64;
T       = 1:N;
U       = sparse(1,N);
DEM     = spm_DEM_generate(M,U);

 
DEM.M(1).x = [1; 1; 16];
DEM        = spm_DEM(DEM);
spm_DEM_qU(DEM.qU,DEM.pU)
 
ex     = spm_ekf(DEM.M,DEM.Y);
px     = spm_pf(DEM.M,DEM.Y);
 
spm_figure('GetWin','Figure 1');
 
subplot(2,2,1)
plot(T,DEM.pU.v{1},'k',T,DEM.qU.v{1},'k:')
legend({'DEM','true'})
title('true and predicted response','FontSize',16)
xlabel('time')
axis square
 
subplot(2,2,2)
plot(T,DEM.pU.x{1},'k',T,DEM.qU.x{1},'k:')
title('true and predicted states','FontSize',16)
xlabel('time')
axis square
 
subplot(2,2,3)
plot(T,sum(px),'k',T,sum(ex),'k:')
legend({'PF','EKF'})
title('predicted responses','FontSize',16)
xlabel('time')
axis square
 
subplot(2,2,4)
plot(T,px,'k',T,ex,'k:')
title('predicted states','FontSize',16)
xlabel('time')
axis square


return

 
spm_figure('GetWin','Figure 2');
 
tx    = DEM.pU.x{1};
subplot(2,2,1)
plot(tx(1,:),tx(2,:),'k'), hold on
plot(tx(1,1),tx(2,1),'k.','Markersize',16)
title('attractor','FontSize',16)
axis square
axis([-20 20 -20 20])
 
for i = 1:4
 
    x          = rand(3,1)*16;
    DEM.M(1).x = x;
    DEM        = spm_DEM(DEM);
    dx         = DEM.qU.x{1};
    ex         = spm_ekf(DEM.M,DEM.Y);
    px         = spm_pf(DEM.M,DEM.Y);
    dx         = [x dx];
    ex         = [x ex];
    px         = [x px];
 
    spm_figure('GetWin','Figure 2');
    
    subplot(2,2,2)
    plot(dx(1,:),dx(2,:),'k','color',[0 0 0] + 2/6), hold on
    plot(dx(1,1),dx(2,1),'k.','Markersize',16,'color',[0 0 0] + 2/6)
    title('attractor reconstructions (DEM)','FontSize',16)
    axis square
    axis([-20 20 -20 20])
    
    subplot(2,2,3)
    plot(px(1,:),px(2,:),'k','color',[0 0 0] + 2/6), hold on
    plot(px(1,1),px(2,1),'k.','Markersize',16,'color',[0 0 0] + 2/6)
    title('attractor reconstructions (PF)','FontSize',16)
    axis square
    axis([-20 20 -20 20])
    
    subplot(2,2,4)
    plot(ex(1,:),ex(2,:),'k','color',[0 0 0] + 2/6), hold on
    plot(ex(1,1),ex(2,1),'k.','Markersize',16,'color',[0 0 0] + 2/6)
    title('attractor reconstructions (EKF)','FontSize',16)
    axis square
    axis([-20 20 -20 20])
     
end"
5728,DEM_demo_lorenz_LAP.m,72.908,100,75.86,45,100.0,43.68,70-80,"function DEM_demo_lorenz_LAP
 
 
 
M         = spm_DEM_M('Lorenz');
 
 
N         = 128;
U         = sparse(1,N);
 
M(1).E.nN = 32;
M(1).E.nE = 32;
M(1).E.nD = 2;
M(1).E.n  = 4;
M(1).E.d  = 2;
M(1).E.s  = 1/16;
M(1).V    = exp(1);
M(1).W    = exp(16);
DEM       = spm_DEM_generate(M,U);
 
spm_figure('GetWin','Figure 1');
spm_DEM_qU(DEM.pU);
 
pE  = M(1).pE + [0 1 -1]';        % Modified prior parameters
pC  = diag(exp(-[32 2 2]));       % prior covariance
DEM.M(1).pE = pE;
DEM.M(1).pC = pC;
 
 
np          = length(pE);
ip          = 1:np; 
SCK         = DEM;
SCK.M(1).x  = [rand(2,1)*16;25];  % partly random initialization of the states
SCK.M(1).x  = [0.9;0.8;30];       % True state values: 
          
 
cb = [0, 30;
    -10, 10;
     40, 50;];                    % [min max]
 
SCK.M(1).cb = [];                 % option to specify constrain on parameters values [min max]
SCK.M(1).ip = ip;                 % indices of model parameters to be estimated
SCK.M(2).v  = [];                 % input initial condition
SCK.M(2).V  = [];                 % input noise precision (fixed)
SCK.M(1).xP = eye(3)*1e-1^2;      % state error covariance matrix
SCK.M(1).uP = eye(1)*1e-10^2;     % input error covariance matrix
SCK.M(1).wP = pC*pC;              % parameter error covariance matrix
SCK.M(1).Q  = {speye(M(1).l,M(1).l)};     % if Q is specified then algorithm performs
SCK.M(1).Qf      = 'auto';        % form of estimation of measurement noise covariance 
SCK.M(1).E.nN    = 32;            % max number of iteration of SCKF-SCK algorithm
SCK.M(1).E.Itol  = 1e-3;          % convergence tolerance value for SCKF_SCK algorithm
SCK.M(1).E.RM    = [5e3 1e6];     % scaling parameter for Robbins-Monro approximation of 
SCK.M(1).VB.N    = 3;             % max number of VB iteration during one SCKF-SCK run
SCK.M(1).VB.Itol = 1e-2;          % convergence tolerance value for VB algorithm
SCK.M(1).VB.l    = 1 - exp(-2);   % scaling parameter for VB algorithm, 
                                  
 
LAP     = spm_LAP(DEM);
DEM     = spm_DEM(DEM);
SCK     = spm_SCK(SCK);
 
spm_figure('GetWin','spm_DEM'); spm_DEM_qU(DEM.qU,LAP.pU)
spm_figure('GetWin','spm_SCK'); spm_DEM_qU(SCK.qU,LAP.pU)
spm_figure('GetWin','spm_LAP'); spm_DEM_qU(LAP.qU,LAP.pU)
 
 
pP1    = spm_vec(LAP.pP.P);
qP2    = spm_vec(LAP.qP.P);
qP3    = spm_vec(DEM.qP.P);
qP4    = spm_vec(SCK.qP.P);
dP1    = pE(ip)  - pP1(ip);
dP2    = qP2(ip) - pP1(ip);
dP3    = qP3(ip) - pP1(ip);
dP4    = qP4(ip) - pP1(ip);
 
 
subplot(2,2,3)
bar([pP1 qP2 qP3 qP4])
axis square
legend('True','LAP','DEM','SCK')
title('parameters','FontSize',16)
 
subplot(2,2,4)
bar([dP1 dP2 dP3 dP4])
axis square
legend('Prior','LAP','DEM','SCK')
title('deviations from true value','FontSize',16)"
5729,DEM_demo_MDP_DEM.m,73.556,70,59.14,100,100.0,38.64,70-80,"function MDP = DEM_demo_MDP_DEM


rng('default')
pth = fileparts(mfilename('fullpath'));




global STIM
str   = {'null','bird','seed','cats'};
for i = 1:numel(str)
    STIM.H{i} = spm_vol(fullfile(pth,[str{i},'.nii']));
end

dim    = 32;                                  % dimension of visual sample
nb     = 6;                                   % number of basis functions
ns     = nb*nb;                               % number of sensory channels
STIM.W = 1/2;                                 % foveal sampling width
STIM.R = ones(dim,dim);                       % retinal precision
STIM.B = spm_dctmtx(dim,nb);                  % Basis functions (CRFs)
STIM.A = 4;                                   % Attenuation (spotlight)

L{1}   = [-8;-8];
L{2}   = [ 8;-8];
L{3}   = [-8; 8];
L{4}   = [ 8; 8];
STIM.L = L;



N     = 24;                                  % length of data sequence
nh    = length(STIM.H);                      % number of hypotheses
nl    = length(STIM.L);                      % number of locations
for i = 1:nh
    for j = 1:nl
        c           = [STIM.L{j}; sparse(i,1,1,nh,1)];
        u           = [STIM.L{j}; sparse(i,1,1,nh,1)];
        demi.U{i,j} = u*ones(1,N);
        demi.C{i,j} = c*ones(1,N);
    end
end

o     = [4,1];
O{1}  = spm_softmax(sparse(1:4,1,1,nh,1));
O{2}  = spm_softmax(sparse(1,1,4,nl,1));

M(1).E.s = 1/2;                               % smoothness
M(1).E.n = 2;                                 % order of
M(1).E.d = 1;                                 % generalised motion

x      = [0;0];                               % oculomotor angle
v.x    = [8;0];                               % fixed (attracting) point
v.h    = sparse(nh,1);                        % hypothesis
g      = @ADEM_sample_image;

M(1).f = @(x,v,P) (v.x - x)/8;
M(1).g = @(x,v,P) spm_vec(x,g(x - v.x,v.h));
M(1).x = x;                                   % hidden states
M(1).V = 8;                                   % error precision (g)
M(1).W = 8;                                   % error precision (f)

M(2).v = v;                                   % priors
M(2).V = [exp(8) exp(8) ones(1,nh)];



G(1).f = @(x,v,a,P) a;
G(1).g = @(x,v,a,P) spm_vec(x,g(x - v.x,v.h));
G(1).x = x;                                  % hidden states
G(1).V = exp(16);                            % error precision
G(1).W = exp(16);                            % error precision
G(1).U = [1 1 zeros(1,ns)];                  % gain

G(2).v = v;                                  % exogenous forces
G(2).a = [0;0];                              % action forces
G(2).V = exp(16);

DEM.G  = G;
DEM.M  = M;

DEM    = spm_MDP_DEM(DEM,demi,O,o);

DEM.label{1} = @(x,v,P) g(x - v.x,v.h);
DEM.label{2} = @(x,v,P) 1 - sparse(ceil(x(1)*2 + 16),ceil(x(2)*2 + 16),1,32,32);

spm_figure('GetWin','Figure 1');
spm_DEM_qU(DEM.qU,DEM.pU)

spm_figure('GetWin','Figure 2');
spm_dem_mdp_movie(DEM)
drawnow


label.factor     = {'what','where','flip','flip'};
label.name{1}    = {'flee','feed','wait'};
label.name{2}    = {'1','2','3','4'};
label.name{3}    = {'-','+'};
label.name{4}    = {'-','+'};

label.modality   = {'what','where'};
label.outcome{1} = {'null','bird','seed','cat'};
label.outcome{2} = {'1','2','3','4'};


D{1} = [1 1 1]';           % what:     {'flee','feed','wait'}
D{2} = [1 0 0 0]';         % where:    {'1',...,'4'}
D{3} = [8 1]';             % flip(ud): {'no','yes'}
D{4} = [8 1]';             % flip(rl): {'no','yes'}

Nf    = numel(D);
for f = 1:Nf
    Ns(f) = numel(D{f});
end
for f1 = 1:Ns(1)
    for f2 = 1:Ns(2)
        for f3 = 1:Ns(3)
            for f4 = 1:Ns(4)
                
                if f1 == 1, a = {'bird','cat' ;'null','null'}; end
                if f1 == 2, a = {'bird','seed';'null','null'}; end
                if f1 == 3, a = {'bird','null';'null','seed'}; end
                
                if f3 == 2, a = flipud(a); end
                if f4 == 2, a = fliplr(a); end
                
                
                A{1}(1,f1,f2,f3,f4) = strcmp(a{f2},'null');
                A{1}(2,f1,f2,f3,f4) = strcmp(a{f2},'bird');
                A{1}(3,f1,f2,f3,f4) = strcmp(a{f2},'seed');
                A{1}(4,f1,f2,f3,f4) = strcmp(a{f2},'cat');
                
                A{2}(f2,f1,f2,f3,f4) = 1;
                
            end
        end
    end
end

for f = 1:Nf
    B{f} = eye(Ns(f));
end

for k = 1:Ns(2)
    B{2}(:,:,k) = 0;
    B{2}(k,:,k) = 1;
end


mdp.T     = 3;                      % number of updates
mdp.A     = A;                      % observation model
mdp.B     = B;                      % transition probabilities
mdp.D     = D;                      % prior over initial states
mdp.DEM   = DEM;
mdp.demi  = demi;

mdp.label = label;
mdp.Aname = label.modality;
mdp.Bname = label.factor;
mdp.alpha = 64;
mdp.chi   = 1/32;

clear A B D

MDP = spm_MDP_check(mdp);
clear mdp


label.factor     = {'story','where','decision'};
label.name{1}    = {...
    'flee wait feed wait'
    'wait wait wait feed'
    'wait flee wait feed'
    'flee wait feed flee'
    'wait wait wait flee'
    'wait flee wait flee'};
label.name{2}    = {'1st','2nd','3rd','4th'};
label.name{3}    = {'null','happy','sad'};

label.modality   = {'picture','where','feedback'};
label.outcome{1} = {'flee','feed','wait'};
label.outcome{2} = {'1','2','3','4'};
label.outcome{3} = {'null','right','wrong'};


D{1} = [1 1 1 1 1 1]';   % what:   {'story 1',...,'story 6'}
D{2} = [1 0 0 0]';       % where:  {'1',...,'4'}
D{3} = [1 0 0]';         % report: {'null','happy','sad'}

Nf    = numel(D);
for f = 1:Nf
    Ns(f) = numel(D{f});
end
for f1 = 1:Ns(1)
    for f2 = 1:Ns(2)
        for f3 = 1:Ns(3)
            
            if f1 == 1, a = {'flee','wait','feed','wait'}; end  % happy
            if f1 == 2, a = {'wait','wait','wait','feed'}; end  % happy
            if f1 == 3, a = {'wait','flee','wait','feed'}; end  % happy
            if f1 == 4, a = {'flee','wait','feed','flee'}; end  % sad
            if f1 == 5, a = {'wait','wait','wait','flee'}; end  % sad
            if f1 == 6, a = {'wait','flee','wait','flee'}; end  % sad
            
            
            A{1}(1,f1,f2,f3) = strcmp(a{f2},'flee');
            A{1}(2,f1,f2,f3) = strcmp(a{f2},'feed');
            A{1}(3,f1,f2,f3) = strcmp(a{f2},'wait');
            
            A{2}(f2,f1,f2,f3) = 1;
            
            hap = any(ismember([1 2 3],f1));
            sad = any(ismember([4 5 6],f1));
            A{3}(1,f1,f2,f3) = (f3 == 1);                         % undecided
            A{3}(2,f1,f2,f3) = (f3 == 2 & hap) | (f3 == 3 & sad); % right
            A{3}(3,f1,f2,f3) = (f3 == 3 & hap) | (f3 == 2 & sad); % wrong
            
        end
    end
end
Ng    = numel(A);
for g = 1:Ng
    No(g) = size(A{g},1);
end

for f = 1:Nf
    B{f} = eye(Ns(f));
end

B{2}(:,:,1) = spm_speye(Ns(2),Ns(2), 0);
B{2}(:,:,2) = spm_speye(Ns(2),Ns(2),-1); B{2}(end,end,2) = 1;

for k = 1:Ns(3)
    B{3}(:,:,k) = 0;
    B{3}(k,:,k) = 1;
end

U(1,1,:)  = [1 2 1]';           % move to next page
U(1,2,:)  = [1 1 2]';           % stay on current page and report happy
U(1,3,:)  = [1 1 3]';           % stay on current page and report sad

for g = 1:Ng
    C{g}  = zeros(No(g),1);
end
C{3}(2,:) =  0;                 % the agent expects to be right
C{3}(3,:) = -4;                 % and not wrong

mdp.MDP  = MDP;
mdp.link = sparse(1,1,1,numel(MDP.D),Ng);

mdp.T = 5;                      % number of moves
mdp.U = U;                      % allowable policies
mdp.A = A;                      % observation model
mdp.B = B;                      % transition probabilities
mdp.C = C;                      % preferred outcomes
mdp.D = D;                      % prior over initial states
mdp.s = [1 1 1]';               % initial state

mdp.label = label;
mdp.alpha = 64;
mdp       = spm_MDP_check(mdp);


MDP  = spm_MDP_VB_X(mdp);

spm_figure('GetWin','Figure 3'); clf
spm_MDP_VB_trial(MDP);

spm_figure('GetWin','Figure 4'); clf
