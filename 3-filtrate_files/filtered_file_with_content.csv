M(1).hC = 2;                           % log-precision prior covariance
M(1).W  = exp(16);                     % error precision
 
M(2).v  = 0;
M(2).V  = exp(16);
 
 
M(1).E.nE = 4;
M(1).E.s  = 1;
 
N       = 128;
