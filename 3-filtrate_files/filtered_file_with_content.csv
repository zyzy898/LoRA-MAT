28,coherencysegpt.m,89.144,100,82.86,100,100.0,62.86,80-90,"function [C,phi,S12,S1,S2,f,zerosp,confC,phistd,Cerr]=coherencysegpt(data1,data2,win,params,segave,fscorr)


