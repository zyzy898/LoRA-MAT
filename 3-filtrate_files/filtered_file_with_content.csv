                    save(file_fullpath(FileName), 'Comment', '-append');
                    sNew.Comment = Comment;
                end
            end
        else
            deletedFile{end+1} = sStudy.Stat(iItem).FileName;
        end
        sStudy.Stat(iItem) = sNew;
    case 'timefreq'
