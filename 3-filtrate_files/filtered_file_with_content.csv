subplot(2,2,4)
plot(log(w),LG,log(w),PL);
xlabel('Frequencies')
ylabel('Spectral density')
title('Power law scaling','FontSize',16);"
5741,DEM_demo_ontology.m,74.158,80,63.98,90,100.0,36.81,70-80,"function DEM_demo_ontology
 
 
 
