6451,computeWindFrame.m,67.556,30,88.89,30,100.0,88.89,61-70,"function [R_wind_2_bodyinertial, wind_x, wind_y, wind_z] = computeWindFrame(rVect,vVect)
    down = -1*normVector(rVect);
    
    wind_x = normVector(vVect);
    wind_y = normVector(crossARH(down, wind_x));
    wind_z = normVector(crossARH(wind_x, wind_y));
    
    R_wind_2_bodyinertial = horzcat(wind_x,wind_y,wind_z);
end"
