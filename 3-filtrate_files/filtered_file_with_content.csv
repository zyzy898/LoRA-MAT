2781,constructDecoupledGeneticNetwork.m,79.0,100,65.71,75,100.0,54.29,70-80,"function factorList = constructDecoupledGeneticNetwork(pedigree, alleleFreqs, alphaList)

numPeople = length(pedigree.names);

factorList(3*numPeople) = struct('var', [], 'card', [], 'val', []);

factorList(3*numPeople) = struct('var', [], 'card', [], 'val', []);

numAlleles = length(alleleFreqs); % Number of alleles
a = pedigree.parents(:,1);
bookkeeping = ones(1,numPeople);
for i=1:numPeople
	if a(i) == 0
		factorList(i) = childCopyGivenFreqsFactor(alleleFreqs,i);
		factorList(numPeople+i) = childCopyGivenFreqsFactor(alleleFreqs,numPeople+i);
		bookkeeping(i) = 0;
	end
end
while sum(bookkeeping)!=0
	for i=1:numPeople
		if bookkeeping(i)==1
			parents = pedigree.parents(i,:);
			bb = bookkeeping(parents(2));
			aa = bookkeeping(parents(1));
			if aa==0 && bb==0 
				factorList(i) = childCopyGivenParentalsFactor(numAlleles,i,parents(1),numPeople+parents(1));
				factorList(numPeople+i) = childCopyGivenParentalsFactor(numAlleles,numPeople+i,parents(2),numPeople+parents(2));
				bookkeeping(i) = 0;
			end
		end
	end
end
for i = 1:numPeople
	factorList(2*numPeople+i) = phenotypeGivenCopiesFactor(alphaList,numAlleles,i,numPeople+i,2*numPeople+i);
end"
2782,constructElementalMatrix.m,79.864,100,70.27,75,100.0,54.05,70-80,"function [E, elements] = constructElementalMatrix(metFormulas, metCharges)

m = length(metFormulas); % Format inputs

includee = nargin == 2;
if nargin < 2 || isempty(metCharges)
    metCharges = zeros(m,1);
end

load atomicNumbers.mat % Load list of elements (s) and their atomic numbers (n)
s = [s; {'R'; 'X'; 'e'}]; % add pseudoelements and electron
n = [n; 0; 0; 0];
p = length(s);

E = sparse(m,p);
for i = 1:m
    f = metFormulas{i};
    c = metCharges(i);

    for j = 1:p-1
        E(i,j) = numAtomsOfElementInFormula(f,s{j});
    end

    a = E(i,:)*n;
    E(i,end) = a - c;
end

if ~includee
    s = s(1:end-1);
    E = E(:,1:end-1);
end

elements = s(any(E,1))';
E = E(:,any(E,1));

[elements,xi] = sort(elements);
E = E(:,xi);"
