                    fprintf('%s\\n','cycleFreeFlux: #5 Lower bounds slightly greater than upper bounds, set to the same.')
                end
            else
                error('cycleFreeFlux: Lower bounds cannot be greater than upper bounds')
            end
        end
        
        if any(lb(n+1:n+p)>ub(n+1:n+p))
