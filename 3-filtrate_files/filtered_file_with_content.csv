4839,dDTCWT.m,76.0,60,93.75,45,100.0,81.25,70-80,"function [Y1 h11]=derotated_dtcwt(I1,n,biot,Qshift)
[Y1,h1] = dtwavexfm2(I1,n,biot,Qshift);

h11{n}=h1{n};
for k=n:-1:2
    for m=1:6
        xp=imresize(h1{k}(:,:,m),2);%
        argxp=angle(xp);
        argx=angle(h1{k-1}(:,:,m));
        argx=argx-2.*argxp;
        absx=abs(h1{k-1}(:,:,m));
        xa=absx.*cos(argx);
        xb=absx.*sin(argx);
        h11{k-1}(:,:,m)=complex(xa,xb);
    end
end"
