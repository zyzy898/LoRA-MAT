6576,computeInertialAeroAnglesFromBodyAxes.m,68.768,60,76.92,30,100.0,76.92,61-70,"function [bankAng,angOfAttack,angOfSideslip] = computeInertialAeroAnglesFromBodyAxes(ut, rVect, vVect, bodyInfo, bodyX, bodyY, bodyZ)

