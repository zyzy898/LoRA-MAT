4521,d2Ibr_dV2.m,73.364,60,77.27,75,100.0,54.55,70-80,"function [H11, H12, H21, H22] = d2Ibr_dV2(Ybr, V, mu, vcart)


if nargin < 4
    vcart = 0;      %% default to polar coordinates
end

nb = length(V);

if vcart
    H11 = sparse(nb, nb);
    H12 = H11;
    H21 = H11;
    H22 = H11;
else
    diagInvVm = sparse(1:nb, 1:nb, ones(nb, 1)./abs(V), nb, nb);

    H11 = sparse(1:nb, 1:nb, -(Ybr.' * mu) .* V, nb, nb);
    H21 = -1j * H11 * diagInvVm;
    H12 = H21;
    H22 = sparse(nb, nb);
end"
4522,d2Imis_dVdSg.m,79.242,100,75.76,75,100.0,45.45,70-80,"function Gsv = d2Imis_dVdSg(Cg, V, lam, vcart)


if nargin < 4
    vcart = 0;      %% default to polar coordinates
end

nb = length(V);

if vcart
    D = Cg' * sparse(1:nb,1:nb, lam./conj(V.^2), nb, nb);

    G_Pg_Vr = D;
    G_Pg_Vi = -1j * D;
    G_Qg_Vr = G_Pg_Vi;
    G_Qg_Vi = -D;

    Gsv = [ G_Pg_Vr G_Pg_Vi;
            G_Qg_Vr G_Qg_Vi ];
else
    D = sparse(1:nb, 1:nb, 1./abs(V), nb, nb);
    E = sparse(1:nb, 1:nb, lam./conj(V), nb, nb);
    K = Cg' * E;
    L = K * D;

    G_Pg_Va = -1j * K;
    G_Pg_Vm = L;
    G_Qg_Va = -K;
    G_Qg_Vm = -1j * L;

    Gsv = [ G_Pg_Va G_Pg_Vm;
            G_Qg_Va G_Qg_Vm ];
end"
4523,D2L2R2_cost.m,77.668,60,91.67,45,100.0,91.67,70-80,"function cost = D2L2R2_cost(Y, Y_range, D, D_range, X, opts)
    C = numel(Y_range) - 1;
    cost_rank = 0;
    for c = 1: C 
        Dc = get_block_col(D, c, D_range);
        cost_rank = cost_rank + nuclearnorm(Dc);
    end 
    cost = 0.5*(normF2(Y - D*X) + FDDL_fidelity(Y, Y_range, D, D_range, X)) + ...
          opts.lambda1*norm1(X) + ...
          0.5*opts.lambda2*FDDL_discriminative(X, Y_range) + ...
          opts.alpha*cost_rank;
end"
4524,D2L2R2_init.m,75.286,60,92.86,45,100.0,78.57,70-80,"function [D, X] = D2L2R2_init(Y, Y_range, D_range, opts)

    C = numel(Y_range) - 1;
    D = zeros(size(Y, 1), D_range(end));
    X = zeros(D_range(end), Y_range(end));
    for c = 1: C 
        range_Yc = get_range(Y_range, c);
        range_Dc = get_range(D_range, c);
        Yc = Y(:, range_Yc);
        [Dc, Xcc] = ODL(Yc, D_range(c+1) - D_range(c), opts.lambda1, opts);
        D(:, range_Dc) = Dc;
        X(range_Dc, range_Yc) = Xcc;
    end 
end"
4525,D2L2R2_pred.m,75.118,60,94.12,45,100.0,76.47,70-80,"function pred = D2L2R2_pred(Y, D, D_range, CoefM, opts)
    vgamma = opts.gamma;
    opts.max_iter = 100;
    [X, cost] = lasso_fista(Y, D, zeros(size(D,2), size(Y,2)), vgamma, opts);
    C = size(CoefM,2);
    E = zeros(C, size(Y,2));
    for c = 1: C 
        Dc = get_block_col(D, c, D_range);
        Xc = get_block_row(X, c, D_range);
        R1 = Y - Dc*Xc;
        E1 = sum(R1.^2);
        R2 = X - repmat(CoefM(:, c), 1, size(Y,2));
        E2 = sum(R2.^2);
        E(c,:) = E1 + opts.weight*E2;
    end 
    [~, pred] = min(E);
end"
4526,D2L2R2_updateD.m,75.118,60,88.24,45,100.0,82.35,70-80,"function D = D2L2R2_updateD(Y, Y_range, D, D_range, X, opts)

    C = numel(Y_range) - 1;
    opts.YXt = true;
    for c = 1 : C 
        Mc  = Y  - remove_block_col(D, c, D_range)*remove_block_row(X, c, D_range);
        Yc  = get_block_col(Y, c, Y_range);
        Xc  = get_block_row(X, c, D_range);
        Xcc = get_block_col(Xc, c, Y_range);
        E   = Mc*Xc' + Yc * Xcc';
        F   = 2*Xc*Xc';

        range_Dc = get_range(D_range, c);
        Dc = D(:, range_Dc);
        D(:, range_Dc) = min_rank_dict(Dc, E, F, opts.alpha, opts);
    end 
end"
4527,d2p.m,78.596,100,59.7,90,100.0,43.28,70-80,"function [P, beta] = d2p(D, u, tol)


    
    if ~exist('u', 'var') || isempty(u)
        u = 15;
    end
    if ~exist('tol', 'var') || isempty(tol)
        tol = 1e-4; 
    end
    
    n = size(D, 1);                     % number of instances
    P = zeros(n, n);                    % empty probability matrix
    beta = ones(n, 1);                  % empty precision vector
    logU = log(u);                      % log of perplexity (= entropy)

    for i=1:n
        
        if ~rem(i, 500)
            disp(['Computed P-values ' num2str(i) ' of ' num2str(n) ' datapoints...']);
        end
        
        betamin = -Inf; 
        betamax = Inf;

        [H, thisP] = Hbeta(D(i, [1:i - 1, i + 1:end]), beta(i));
        
        Hdiff = H - logU;
        tries = 0;
        while abs(Hdiff) > tol && tries < 50
            
            if Hdiff > 0
                betamin = beta(i);
                if isinf(betamax)
                    beta(i) = beta(i) * 2;
                else
                    beta(i) = (beta(i) + betamax) / 2;
                end
            else
                betamax = beta(i);
                if isinf(betamin) 
                    beta(i) = beta(i) / 2;
                else
                    beta(i) = (beta(i) + betamin) / 2;
                end
            end
            
            [H, thisP] = Hbeta(D(i, [1:i - 1, i + 1:end]), beta(i));
            Hdiff = H - logU;
            tries = tries + 1;
        end
        
        P(i, [1:i - 1, i + 1:end]) = thisP;
    end    
    disp(['Mean value of sigma: ' num2str(mean(sqrt(1 ./ beta)))]);
    disp(['Minimum value of sigma: ' num2str(min(sqrt(1 ./ beta)))]);
    disp(['Maximum value of sigma: ' num2str(max(sqrt(1 ./ beta)))]);
end
    


function [H, P] = Hbeta(D, beta)
    P = exp(-D * beta);
    sumP = sum(P);
    H = log(sumP) + beta * sum(D .* P) / sumP;
    P = P / sumP;
end"
4528,d2Sbr_dV2.m,77.0,60,80.0,75,100.0,70.0,70-80,"function [H11, H12, H21, H22] = d2Sbr_dV2(Cbr, Ybr, V, mu, vcart)


if nargin < 5
    vcart = 0;      %% default to polar coordinates
end

nl = length(mu);
nb = length(V);

A = Ybr' * sparse(1:nl, 1:nl, mu, nl, nl) * Cbr;
if vcart
    H11 = A + A.';
    H12 = 1j * (A - A.');
    H21 = -H12;
    H22 = H11;
else
    diagV  = sparse(1:nb, 1:nb, V, nb, nb);

    B = conj(diagV) * A * diagV;
    D = sparse(1:nb, 1:nb, (A*V) .* conj(V), nb, nb);
    E = sparse(1:nb, 1:nb, (A.'*conj(V)) .* V, nb, nb);
    F = B + B.';
    G = sparse(1:nb, 1:nb, ones(nb, 1)./abs(V), nb, nb);

    H11 = F - D - E;
    H21 = 1j * G * (B - B.' - D + E);
    H12 = H21.';
    H22 = G * F * G;
end"
4529,d3EnergyGradient.m,73.562,70,88.44,90,100.0,19.37,70-80,"function [S] = d3EnergyGradient(S)
    s6  = 1.0; % formula 3
    alp = 14.0;
    rs18= 1.0;

    rs6 = S.d3Rs6; % formula 4
    s18 = S.d3S18;

    rs8 = rs18;
    alp6 = alp;
    alp8 = alp + 2;

    rthr = S.d3Rthr;
    cn_thr = S.d3Cn_thr;
    atomposCart = coordinateTransformation(S, S.Atoms, 'noncart2cart_dis');
    latt = zeros(3);
    nImageCN = zeros(3,1);
    nImageEG = zeros(3,1);
    latt(1, :) = S.lat_uvec(1,:)*S.L1;
    latt(2, :) = S.lat_uvec(2,:)*S.L2;
    latt(3, :) = S.lat_uvec(3,:)*S.L3;
    periodicType = [S.BCx, S.BCy, S.BCz];
    if S.BC ~= 1 % not all BC conditions are Dirichlet. Otherwise, it is unnecessary to change nImageCN and nImageEG
        nImageCN = set_criteria(cn_thr, periodicType, latt);
        nImageEG = set_criteria(rthr, periodicType, latt);
    end

    imageVecCoordCN = zeros((nImageCN(1)*2+1)*(nImageCN(2)*2+1)*(nImageCN(3)*2+1), 3);
    imageIndexCN = zeros((nImageCN(1)*2+1)*(nImageCN(2)*2+1)*(nImageCN(3)*2+1), 3);
    count = 0;
    for image1 = -nImageCN(1):nImageCN(1)
        for image2 = -nImageCN(2):nImageCN(2)
            for image3 = -nImageCN(3):nImageCN(3)
                count = count + 1;
                imageVecCoordCN(count, :) = image1*latt(1, :) + image2*latt(2, :) + image3*latt(3, :);
                imageIndexCN(count, :) = [image1, image2, image3];
            end
        end
    end

    atomCN = d3_CN(S.n_atm, atomposCart, imageVecCoordCN, nImageCN, cn_thr, S.atomScaledRcov);

    imageVecCoord = zeros((nImageEG(1)*2+1)*(nImageEG(2)*2+1)*(nImageEG(3)*2+1), 3);
    imageIndex = zeros((nImageEG(1)*2+1)*(nImageEG(2)*2+1)*(nImageEG(3)*2+1), 3);
    count = 0;
    for image1 = -nImageEG(1):nImageEG(1)
        for image2 = -nImageEG(2):nImageEG(2)
            for image3 = -nImageEG(3):nImageEG(3)
                count = count + 1;
                imageVecCoord(count, :) = image1*latt(1, :) + image2*latt(2, :) + image3*latt(3, :);
                imageIndex(count, :) = [image1, image2, image3];
            end
        end
    end

    maxci = ...
        [2,1,2,3,5,5,4,3,2,1,...
        2,3,4,5,4,3,2,1,2,3,...
        3,3,3,3,3,3,4,4,2,2,...
        4,5,4,3,2,1,2,3,3,3,...
        3,3,3,3,3,3,2,2,4,5,...
        4,3,2,1,2,3,3,1,2,2,...
        2,2,2,2,2,2,2,2,2,2,...
        2,3,3,3,3,3,3,3,2,2,...
        4,5,4,3,2,1,2,3,2,2,...
        2,2,2,2];

    [e6, e8, drij_2atom, FdivR6mulDC6_2atom, dC6ij, C6Matrix] = edisp_gdisp_2atom(maxci, S.n_atm, atomposCart, S.atomicNumbers, S.atomScaledR2R4, atomCN, imageVecCoord, imageIndex,...
        nImageEG, rthr, S.c6ab, alp6, alp8, rs6, rs8, s6, s18);
    [e63, drij_3atom, FdivR6mulDC6_3atom] = edisp_gdisp_3atom(S.n_atm, atomposCart, S.atomicNumbers, imageVecCoordCN, imageIndexCN,...
        latt, nImageEG, nImageCN, cn_thr, dC6ij, C6Matrix, alp8);
    [gradAtomPos, d3stress] = gradAtomPos_stress(S.n_atm, atomposCart, latt, nImageEG, rthr, cn_thr, S.atomScaledRcov, imageVecCoord, imageIndex,...
        drij_2atom + drij_3atom, FdivR6mulDC6_2atom + FdivR6mulDC6_3atom);
    S.d3Energy = e6 + e8 - e63;
    S.d3gradAtomPos = gradAtomPos;
    S.d3stress = d3stress;
end

function nImage = set_criteria(rLimit, periodicType, inputLatt)
    rCutoff = sqrt(rLimit);
    lattice = inputLatt;
    cross23 = cross(lattice(2, :), lattice(3, :));
    cross31 = cross(lattice(3, :), lattice(1, :));
    cross12 = cross(lattice(1, :), lattice(2, :));
    unitCro23 = cross23 / vecnorm(cross23);
    unitCro31 = cross31 / vecnorm(cross31);
    unitCro12 = cross12 / vecnorm(cross12);
    cos1 = lattice(1, :) * unitCro23';
    cos2 = lattice(2, :) * unitCro31';
    cos3 = lattice(3, :) * unitCro12';
    nImage = [0, 0, 0];
    if periodicType(1) == 0
        nImage(1) = floor(rCutoff / cos1) + 1;
    end
    if periodicType(2) == 0
        nImage(2) = floor(rCutoff / cos2) + 1;
    end
    if periodicType(3) == 0
        nImage(3) = floor(rCutoff / cos3) + 1;
    end
end


function atomCN = d3_CN(numAtoms, atomposCart, imageVecCoordCN, nImageCN, cn_thr, scaledRcov)
    k1 = 16;
    atomCN = zeros(1, numAtoms);
    
    for i = 1:numAtoms
        iCoord = repmat(atomposCart(i, :), numAtoms, 1);
        for imageIndex = 1:(nImageCN(1)*2+1)*(nImageCN(2)*2+1)*(nImageCN(3)*2+1)
            imageVec = imageVecCoordCN(imageIndex, :);
            imageVecCoord = repmat(imageVec, numAtoms, 1);
            iDist = vecnorm((iCoord - atomposCart - imageVecCoord), 2, 2);
            iCN = zeros(1, numAtoms);
            for j = 1:numAtoms
                if (iDist(j) < sqrt(cn_thr)) && (iDist(j) > 1e-20) %%possible mistake
                    rr = (scaledRcov(i) + scaledRcov(j)) / iDist(j);
                    iCN(j) = 1.0 / (1.0 + exp(-k1 * (rr - 1.0)));
                end
            end
            atomCN(i) = atomCN(i) + sum(iCN);
        end
    end
end

function [C6, dC6I, dC6J] = comp_dC6_dCNij(maxci, iAtoms, c6ab, atomi, atomj, atomCN)
    k3 = -4; % |k3| is between 3 and 5? need to modify
    c6mem = -1e20;
    r_save = 1e20;
    c6termSum = 0.0;
    weightSum = 0.0;
    dC6termSumI = 0.0;
    dWeightSumI = 0.0;
    dC6termSumJ = 0.0;
    dWeightSumJ = 0.0;
    for i = 1:maxci(iAtoms(atomi))
        for j = 1:maxci(iAtoms(atomj))
            c6 = c6ab(iAtoms(atomi), iAtoms(atomj), i, j, 1);
            if c6 > 0
                CNri = c6ab(iAtoms(atomi), iAtoms(atomj), i, j, 2);
                CNrj = c6ab(iAtoms(atomi), iAtoms(atomj), i, j, 3);
                r = (CNri - atomCN(atomi))^2 + (CNrj - atomCN(atomj))^2;
                if r < r_save
                    r_save = r;
                    c6mem = c6;
                end
                weight = exp(k3*r);
                weightSum = weightSum + weight;
                c6termSum = c6termSum + weight * c6;
                dWeightI = weight * 2.0 * k3 * (atomCN(atomi) - CNri);
                dC6termSumI = dC6termSumI + dWeightI*c6;
                dWeightSumI = dWeightSumI + dWeightI;
                dWeightJ = weight * 2.0 * k3 * (atomCN(atomj) - CNrj);
                dC6termSumJ = dC6termSumJ + dWeightJ*c6;
                dWeightSumJ = dWeightSumJ + dWeightJ;
            end
        end
    end
    if weightSum > 1e-99
        C6 = c6termSum / weightSum;
        dC6I = (dC6termSumI*weightSum - dWeightSumI*c6termSum) / weightSum^2;
        dC6J = (dC6termSumJ*weightSum - dWeightSumJ*c6termSum) / weightSum^2;
    else
        C6 = c6mem;
        dC6I = 0;
        dC6J = 0;
    end
end

function index = countImage(i, j, k, nImageEG)
    index = (i + nImageEG(1))*(2*nImageEG(2) + 1)*(2*nImageEG(3) + 1) + (j + nImageEG(2))*(2*nImageEG(3) + 1) + (k + nImageEG(2)) + 1;
end

function [e6, e8, drij_2atom, FdivR6mulDC6_2atom, dC6ij, C6Matrix] = edisp_gdisp_2atom(maxci, numAtoms, atomposCart, iAtoms, scaledR2R4, atomCN, imageVecCoord, imageIndex,...
    nImageEG, rthr, c6ab, alp6, alp8, rs6, rs8, s6, s18)
    s8 = s18;
    e6 = 0.0;
    e8 = 0.0;
    drij = zeros((2*nImageEG(1)+1)*(2*nImageEG(2)+1)*(2*nImageEG(3)+1), numAtoms, numAtoms);
    FdivR6mulDC6 = zeros(numAtoms, 1); %dE/dCN
    dC6ij = zeros(numAtoms);
    C6Matrix = zeros(numAtoms);
    for i = 1:numAtoms
        for j = 1:i
            [C6, dC6pairI, dC6pairJ] = comp_dC6_dCNij(maxci, iAtoms, c6ab, i, j, atomCN); % the function to be modified
            r0abNow = find_r0ab(iAtoms(i), iAtoms(j));
            mulR2R4 = scaledR2R4(i) * scaledR2R4(j);
            if i == j
                C6Matrix(i, i) = C6;
                dC6ij(i, i) = dC6pairI;
            else
                C6Matrix(i, j) = C6;
                C6Matrix(j, i) = C6;
                dC6ij(i, j) = dC6pairI;
                dC6ij(j, i) = dC6pairJ;
            end
            iCoord = repmat(atomposCart(i, :), size(imageVecCoord, 1), 1);
            jCoord = repmat(atomposCart(j, :), size(imageVecCoord, 1), 1);
            ijImageVecs = iCoord - jCoord - imageVecCoord;
            iDist = vecnorm(ijImageVecs, 2, 2);
            iDist2 = iDist(:).^2;
            iDist6 = iDist2.^3;
            iDist7 = iDist6.*iDist;
            iDist8 = iDist6.*iDist2;
            iDist9 = iDist8.*iDist;
            for imagej = 1:size(imageVecCoord, 1)
                if (iDist2(imagej) <= rthr) && (iDist2(imagej) > 1e-15) %% remove the same atom
                    rr = r0abNow / iDist(imagej);
                    t6 = (rs6*rr)^alp6;
                    t8 = (rs8*rr)^alp8;
                    damp6 = 1.0 / (1.0 + 6 * t6);
                    damp8 = 1.0 / (1.0 + 6 * t8);
                    de6dr = s6 * 6 *damp6 * C6 / iDist7(imagej);
                    de8dr = s8 * 6 * C6 * mulR2R4 * damp8 / iDist9(imagej);
                    imageIndexEs = countImage(imageIndex(imagej, 1), imageIndex(imagej, 2), imageIndex(imagej, 3), nImageEG);
                    if i == j
                        drij(imageIndexEs, i, j) = drij(imageIndexEs, i, j) ...
                            - (de6dr + 4 * de8dr) / 2.0;
                        drij(imageIndexEs, i, j) = drij(imageIndexEs, i, j) ...
                            + (de6dr * alp6 * t6 * damp6...
                            + 3 * de8dr * alp8 * t8 * damp8) / 2.0;
                        FdivR6 = (s6 / iDist6(imagej) * damp6 + 3 * s8 * mulR2R4 / iDist8(imagej) * damp8) / 2.0;
                        e6 = e6 - s6 / iDist6(imagej) * damp6 * C6 / 2.0;
                        e8 = e8 - 3 * s8 * mulR2R4 / iDist8(imagej) * damp8 * C6 / 2.0;
                    else
                        drij(imageIndexEs, i, j) = drij(imageIndexEs, i, j) ...
                            - de6dr - 4 * de8dr;
                        drij(imageIndexEs, i, j) = drij(imageIndexEs, i, j) ...
                            + de6dr * alp6 * t6 * damp6...
                            + 3 * de8dr * alp8 * t8 * damp8;
                        drij(imageIndexEs, j, i) = drij(imageIndexEs, i, j);
                        FdivR6 = (s6 / iDist6(imagej) * damp6 + 3 * s8 * mulR2R4 / iDist8(imagej) * damp8);
                        e6 = e6 - s6 / iDist6(imagej) * damp6 * C6;
                        e8 = e8 - 3 * s8 * mulR2R4 / iDist8(imagej) * damp8 * C6;
                    end
                    
                    FdivR6mulDC6(i) = FdivR6mulDC6(i) + FdivR6 * dC6pairI;
                        FdivR6mulDC6(j) = FdivR6mulDC6(j) + FdivR6 * dC6pairJ;
                end
            end
        end
    end
    drij_2atom = drij;
    FdivR6mulDC6_2atom = FdivR6mulDC6;
end

function [e63, drij_3atom, FdivR6mulDC6_3atom] = edisp_gdisp_3atom(numAtoms, atomposCart, iAtoms, imageVecCoordCN, imageIndexCN,...
        lattice, nImageEG, nImageCN, cn_thr, dC6ij, C6Matrix, alp8)
    e63 = 0.0;
    drij = zeros((2*nImageEG(1)+1)*(2*nImageEG(2)+1)*(2*nImageEG(3)+1), numAtoms, numAtoms);
    FdivR6mulDC6 = zeros(numAtoms, 1); %dE/dCN
    for i = 1:numAtoms
        for j = 1:i
            r0abij = find_r0ab(iAtoms(i), iAtoms(j));
            for k = 1:j
                ikVec = atomposCart(k, :) - atomposCart(i, :);
                c9 = (C6Matrix(i, j)*C6Matrix(i, k)*C6Matrix(j, k))^0.5;
                r0abik = find_r0ab(iAtoms(i), iAtoms(k));
                r0abjk = find_r0ab(iAtoms(j), iAtoms(k));
                iCoord = repmat(atomposCart(i, :), size(imageVecCoordCN, 1), 1);
                jCoord = repmat(atomposCart(j, :), size(imageVecCoordCN, 1), 1);
                ijImageVecs = iCoord - jCoord - imageVecCoordCN;
                ijDist2 = sum(ijImageVecs(:,:).*ijImageVecs(:,:), 2);
                ijDist = sqrt(ijDist2(:));
                for imagej = 1:size(imageVecCoordCN, 1)
                    if (ijDist2(imagej) > cn_thr) || (ijDist(imagej) < 1e-15) %% remove the same atom
                        continue;
                    end
                    rr0ij = ijDist(imagej) / r0abij;
                    imageIndexIJ = imageIndexCN(imagej, :);
                    scopeImageK = [max(-nImageCN(1),imageIndexIJ(1)-nImageCN(1)), min(nImageCN(1),imageIndexIJ(1)+nImageCN(1));
                        max(-nImageCN(2),imageIndexIJ(2)-nImageCN(2)), min(nImageCN(2),imageIndexIJ(2)+nImageCN(2));
                        max(-nImageCN(3),imageIndexIJ(3)-nImageCN(3)), min(nImageCN(3),imageIndexIJ(3)+nImageCN(3))];
                    imageVecCoordK = zeros((scopeImageK(1, 2)-scopeImageK(1, 1)+1)*(scopeImageK(2, 2)-scopeImageK(2, 1)+1)*(scopeImageK(3, 2)-scopeImageK(3, 1)+1), 3);
                    imageIndexK = zeros((scopeImageK(1, 2)-scopeImageK(1, 1)+1)*(scopeImageK(2, 2)-scopeImageK(2, 1)+1)*(scopeImageK(3, 2)-scopeImageK(3, 1)+1), 3);
                    countk = 0;
                    for imagek1 = scopeImageK(1, 1):scopeImageK(1, 2)
                        for imagek2 = scopeImageK(2, 1):scopeImageK(2, 2)
                            for imagek3 = scopeImageK(3, 1):scopeImageK(3, 2)
                                countk = countk + 1;
                                imageVecCoordK(countk, :) = imagek1*lattice(1, :) + imagek2*lattice(2, :) + imagek3*lattice(3, :);
                                imageIndexK(countk, :) = [imagek1, imagek2, imagek3];
                            end
                        end
                    end
                    ikVecMat = repmat(ikVec, size(imageVecCoordK, 1), 1) + imageVecCoordK;
                    ikDist2 = sum(ikVecMat(:,:).*ikVecMat(:,:), 2); 
                    ikDist = sqrt(ikDist2(:));
                    jkVec = atomposCart(k, :) - atomposCart(j, :) - imageVecCoordCN(imagej, :);
                    jkVecMat = repmat(jkVec, size(imageVecCoordK, 1), 1) + imageVecCoordK;
                    jkDist2 = sum(jkVecMat(:,:).*jkVecMat(:,:), 2); 
                    jkDist = sqrt(jkDist2(:));
                    for imagek = 1:size(imageVecCoordK, 1)
                        if (ikDist2(imagek) > cn_thr) || (ikDist(imagek) < 1e-15) %% remove the same atom
                            continue;
                        end
                        if (jkDist2(imagek) > cn_thr) || (jkDist(imagek) < 1e-15) %% remove the same atom
                            continue;
                        end
                        rr0ik = ikDist(imagek) / r0abik;
                        rr0jk = jkDist(imagek) / r0abjk;
                        geoMean = (rr0ij*rr0ik*rr0jk)^(1/3);
                        damp3 = 1.0 / (1.0 + 6*((4.0/3.0) / geoMean)^alp8);
                        t1 = ijDist(imagej)^2 + jkDist(imagek)^2 - ikDist(imagek)^2;
                        t2 = ijDist(imagej)^2 + ikDist(imagek)^2 - jkDist(imagek)^2;
                        t3 = ikDist(imagek)^2 + jkDist(imagek)^2 - ijDist(imagej)^2;
                        tDenomin = ijDist(imagej)^2*jkDist(imagek)^2*ikDist(imagek)^2;
                        ang = (0.375*t1*t2*t3/tDenomin + 1.0) / tDenomin^1.5;
                        if (i == j) && (j == k)
                            e63 = e63 - damp3*c9*ang / 6.0;
                        elseif (i == j) || (j == k)
                            e63 = e63 - damp3*c9*ang / 2.0;
                        else
                            e63 = e63 - damp3*c9*ang;
                        end
                        
                        dFdamp = -2.0*alp8*((4.0/3.0) / geoMean)^alp8*damp3^2; %d(f_dmp)/d(r_ij)
                        dAngIJ = -0.375*(ijDist2(imagej)^3 + ijDist2(imagej)^2*(jkDist2(imagek) + ikDist2(imagek))...
                            + ijDist2(imagej)*(3.0*jkDist2(imagek)^2 + 2.0*jkDist2(imagek)*ikDist2(imagek) + 3.0*ikDist2(imagek)^2)...
                            -5.0*(jkDist2(imagek) - ikDist2(imagek))^2*(jkDist2(imagek) + ikDist2(imagek)))...
                            / (ijDist(imagej)*tDenomin^2.5);
                        imageIndexEsIJ = countImage(imageIndexCN(imagej, 1), imageIndexCN(imagej, 2), imageIndexCN(imagej, 3), nImageEG);
                        if (i == j) && (j == k)
                            drij(imageIndexEsIJ, i, j) = drij(imageIndexEsIJ, i, j) + dFdamp / ijDist(imagej) * c9 * ang / 6.0;
                            drij(imageIndexEsIJ, i, j) = drij(imageIndexEsIJ, i, j) - dAngIJ * c9 * damp3 / 6.0;
                            drij(imageIndexEsIJ, j, i) = drij(imageIndexEsIJ, i, j);
                        elseif (i == j) || (j == k)
                            drij(imageIndexEsIJ, i, j) = drij(imageIndexEsIJ, i, j) + dFdamp / ijDist(imagej) * c9 * ang / 2.0;
                            drij(imageIndexEsIJ, i, j) = drij(imageIndexEsIJ, i, j) - dAngIJ * c9 * damp3 / 2.0;
                            drij(imageIndexEsIJ, j, i) = drij(imageIndexEsIJ, i, j);
                        else
                            drij(imageIndexEsIJ, i, j) = drij(imageIndexEsIJ, i, j) + dFdamp / ijDist(imagej) * c9 * ang;
                            drij(imageIndexEsIJ, i, j) = drij(imageIndexEsIJ, i, j) - dAngIJ * c9 * damp3;
                            drij(imageIndexEsIJ, j, i) = drij(imageIndexEsIJ, i, j);
                        end
                        dAngJK = -0.375*(jkDist2(imagek)^3 + jkDist2(imagek)^2*(ikDist2(imagek) + ijDist2(imagej))...
                            + jkDist2(imagek)*(3.0*ikDist2(imagek)^2 + 2.0*ikDist2(imagek)*ijDist2(imagej) + 3.0*ijDist2(imagej)^2)...
                            -5.0*(ikDist2(imagek) - ijDist2(imagej))^2*(ikDist2(imagek) + ijDist2(imagej)))...
                            / (jkDist(imagek)*tDenomin^2.5);
                        imageIndexEsJK = ...
                            countImage(imageIndexK(imagek, 1)-imageIndexCN(imagej, 1), imageIndexK(imagek, 2)-imageIndexCN(imagej, 2), imageIndexK(imagek, 3)-imageIndexCN(imagej, 3), nImageEG);
                        if (i == j) && (j == k)
                            drij(imageIndexEsJK, j, k) = drij(imageIndexEsJK, j, k) + dFdamp / jkDist(imagek) * c9 * ang / 6.0;
                            drij(imageIndexEsJK, j, k) = drij(imageIndexEsJK, j, k) - dAngJK * c9 * damp3 / 6.0;
                            drij(imageIndexEsJK, k, j) = drij(imageIndexEsJK, j, k);
                        elseif (i == j) || (j == k)
                            drij(imageIndexEsJK, j, k) = drij(imageIndexEsJK, j, k) + dFdamp / jkDist(imagek) * c9 * ang / 2.0;
                            drij(imageIndexEsJK, j, k) = drij(imageIndexEsJK, j, k) - dAngJK * c9 * damp3 / 2.0;
                            drij(imageIndexEsJK, k, j) = drij(imageIndexEsJK, j, k);
                        else
                            drij(imageIndexEsJK, j, k) = drij(imageIndexEsJK, j, k) + dFdamp / jkDist(imagek) * c9 * ang;
                            drij(imageIndexEsJK, j, k) = drij(imageIndexEsJK, j, k) - dAngJK * c9 * damp3;
                            drij(imageIndexEsJK, k, j) = drij(imageIndexEsJK, j, k);
                        end
                        dAngIK = -0.375*(ikDist2(imagek)^3 + ikDist2(imagek)^2*(jkDist2(imagek) + ijDist2(imagej))...
                            + ikDist2(imagek)*(3.0*jkDist2(imagek)^2 + 2.0*jkDist2(imagek)*ijDist2(imagej) + 3.0*ijDist2(imagej)^2)...
                            -5.0*(jkDist2(imagek) - ijDist2(imagej))^2*(jkDist2(imagek) + ijDist2(imagej)))...
                            / (ikDist(imagek)*tDenomin^2.5);
                        imageIndexEsIK = countImage(imageIndexK(imagek, 1), imageIndexK(imagek, 2), imageIndexK(imagek, 3), nImageEG);
                        if (i == j) && (j == k)
                            drij(imageIndexEsIK, i, k) = drij(imageIndexEsIK, i, k) + dFdamp / ikDist(imagek) * c9 * ang / 6.0;
                            drij(imageIndexEsIK, i, k) = drij(imageIndexEsIK, i, k) - dAngIK * c9 * damp3 / 6.0;
                            drij(imageIndexEsIK, k, i) = drij(imageIndexEsIK, i, k);
                        elseif (i == j) || (j == k)
                            drij(imageIndexEsIK, i, k) = drij(imageIndexEsIK, i, k) + dFdamp / ikDist(imagek) * c9 * ang / 2.0;
                            drij(imageIndexEsIK, i, k) = drij(imageIndexEsIK, i, k) - dAngIK * c9 * damp3 / 2.0;
                            drij(imageIndexEsIK, k, i) = drij(imageIndexEsIK, i, k);
                        else
                            drij(imageIndexEsIK, i, k) = drij(imageIndexEsIK, i, k) + dFdamp / ikDist(imagek) * c9 * ang;
                            drij(imageIndexEsIK, i, k) = drij(imageIndexEsIK, i, k) - dAngIK * c9 * damp3;
                            drij(imageIndexEsIK, k, i) = drij(imageIndexEsIK, i, k);
                        end
                        if (i == j) && (j == k)
                            FdivR6 = ang * damp3 / 6.0;
                        elseif (i == j) || (j == k)
                            FdivR6 = ang * damp3 / 2.0;
                        else
                            FdivR6 = ang * damp3;
                        end
                        dC9i = -0.5*c9*(dC6ij(i, j) / C6Matrix(i, j) + dC6ij(i, k) / C6Matrix(i, k));
                        FdivR6mulDC6(i) = FdivR6mulDC6(i) + FdivR6*dC9i;
                        dC9j = -0.5*c9*(dC6ij(j, i) / C6Matrix(i, j) + dC6ij(j, k) / C6Matrix(j, k));
                        FdivR6mulDC6(j) = FdivR6mulDC6(j) + FdivR6*dC9j;
                        dC9k = -0.5*c9*(dC6ij(k, i) / C6Matrix(i, k) + dC6ij(k, j) / C6Matrix(j, k));
                        FdivR6mulDC6(k) = FdivR6mulDC6(k) + FdivR6*dC9k;
                    end
                end
            end
        end
    end
    drij_3atom = drij;
    FdivR6mulDC6_3atom = FdivR6mulDC6;
end

function [gradAtomPos, stress] = gradAtomPos_stress(numAtoms, atomposCart, lattice, nImageEG, rthr, cn_thr, scaledRcov, imageVecCoord, imageIndex, drij, FdivR6mulDC6)
    sigma = zeros(3);
    k1 = 16;
    g = zeros(numAtoms, 3);
    for i = 1:numAtoms
        gi = [0.0, 0.0, 0.0];
        for j = 1:i
            iCoord = repmat(atomposCart(i, :), size(imageVecCoord, 1), 1);
            jCoord = repmat(atomposCart(j, :), size(imageVecCoord, 1), 1);
            ijImageVecs = jCoord - iCoord + imageVecCoord;
            rcovij = scaledRcov(i) + scaledRcov(j);
            iDist2 = sum(ijImageVecs(:,:).*ijImageVecs(:,:), 2);
            iDist = sqrt(iDist2(:));
            for imagej = 1:size(imageVecCoord, 1)
                if (iDist2(imagej) > rthr) || (iDist2(imagej) < 0.5)
                    continue;
                end
                if (iDist2(imagej) < cn_thr) && (iDist2(imagej) > 1e-15)
                    expterm = exp(-k1*(rcovij/iDist(imagej) - 1));
                    dCN = -k1*rcovij*expterm / (iDist(imagej)*(expterm + 1))^2;
                else
                    dCN=0.0;
                end
                imageIndexEs = countImage(imageIndex(imagej, 1), imageIndex(imagej, 2), imageIndex(imagej, 3), nImageEG);
                if i ~= j
                    xi = drij(imageIndexEs, i, j) + dCN*(FdivR6mulDC6(i) + FdivR6mulDC6(j));
                    vec = xi * ijImageVecs(imagej, :) / iDist(imagej);
                else
                    xi = drij(imageIndexEs, i, j) + dCN*FdivR6mulDC6(i);
                    vec = xi * ijImageVecs(imagej, :) / iDist(imagej);
                end
                for row = 1:3
                    for col = 1:3
                        sigma(row,col) = sigma(row,col) + vec(row)*ijImageVecs(imagej, col);
                    end
                end
                if i ~= j
                    gi = gi + vec;
                    g(j, :) = g(j, :) - vec;
                end
            end
        end
        g(i, :) = g(i, :) + gi;
    end
    gradAtomPos = g; % gradient
    
    str = zeros(3);
    str = str - sigma*(inv(lattice))'; % this matrix is Transpose of real stress tensor.
    gradLatt = str';

    detLatt = det(lattice);
    stress = -sigma / detLatt;
end

