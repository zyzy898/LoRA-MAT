3469,cpf_corrector.m,75.648,80,59.83,90,100.0,48.41,70-80,"function [V, converged, i, lam] = cpf_corrector(Ybus, Sbusb, V_hat, ref, pv, pq, ...
                lam_hat, Sbust, Vprv, lamprv, z, step, parameterization, mpopt)


if nargin < 14
    mpopt = mpoption;
end

tol     = mpopt.pf.tol;
max_it  = mpopt.pf.nr.max_it;

converged = 0;
i = 0;
V = V_hat;          %% initialize V with predicted V
Va = angle(V);
Vm = abs(V);
lam = lam_hat;      %% initialize lam with predicted lam

npv = length(pv);
npq = length(pq);
nb = length(V);         %% number of buses
j1 = 1;         j2 = npv;           %% j1:j2 - V angle of pv buses
j3 = j2 + 1;    j4 = j2 + npq;      %% j3:j4 - V angle of pq buses
j5 = j4 + 1;    j6 = j4 + npq;      %% j5:j6 - V mag of pq buses
j7 = j6 + 1;    j8 = j6 + 1;        %% j7:j8 - lambda

Sb = Sbusb(Vm);
St = Sbust(Vm);
mis = V .* conj(Ybus * V) - Sb - lam * (St - Sb);
F = [   real(mis([pv; pq]));
        imag(mis(pq))   ];

P = cpf_p(parameterization, step, z, V, lam, Vprv, lamprv, pv, pq);

F = [ F; 
      P ];

normF = norm(F, inf);
if mpopt.verbose > 1
    fprintf('\\n it    max P & Q mismatch (p.u.)');
    fprintf('\\n----  ---------------------------');
    fprintf('\\n%3d        %10.3e', i, normF);
end
if normF < tol
    converged = 1;
    if mpopt.verbose > 1
        fprintf('\\nConverged!\\n');
    end
end

while (~converged && i < max_it)
    i = i + 1;
    
    [dSbus_dVa, dSbus_dVm] = dSbus_dV(Ybus, V);
    [dummy, neg_dSdb_dVm] = Sbusb(Vm);
    [dummy, neg_dSdt_dVm] = Sbust(Vm);
    dSbus_dVm = dSbus_dVm - neg_dSdb_dVm - lam * (neg_dSdt_dVm - neg_dSdb_dVm);
    
    j11 = real(dSbus_dVa([pv; pq], [pv; pq]));
    j12 = real(dSbus_dVm([pv; pq], pq));
    j21 = imag(dSbus_dVa(pq, [pv; pq]));
    j22 = imag(dSbus_dVm(pq, pq));
    
    J = [   j11 j12;
            j21 j22;    ];

    Sxf = St - Sb;
    dF_dlam = -[real(Sxf([pv; pq])); imag(Sxf(pq))];
    [dP_dV, dP_dlam] = cpf_p_jac(parameterization, z, V, lam, Vprv, lamprv, pv, pq);

    J = [   J   dF_dlam; 
          dP_dV dP_dlam ];

    dx = -(J \\ F);

    if npv
        Va(pv) = Va(pv) + dx(j1:j2);
    end
    if npq
        Va(pq) = Va(pq) + dx(j3:j4);
        Vm(pq) = Vm(pq) + dx(j5:j6);
    end
    V = Vm .* exp(1j * Va);
    Vm = abs(V);            %% update Vm and Va again in case
    Va = angle(V);          %% we wrapped around with a negative Vm

    lam = lam + dx(j7:j8);

    Sb = Sbusb(Vm);
    St = Sbust(Vm);
    mis = V .* conj(Ybus * V) - Sb - lam * (St - Sb);
    F = [   real(mis(pv));
            real(mis(pq));
            imag(mis(pq))   ];

    P = cpf_p(parameterization, step, z, V, lam, Vprv, lamprv, pv, pq);

    F = [ F; 
          P ];

    normF = norm(F, inf);
    if mpopt.verbose > 1
        fprintf('\\n%3d        %10.3e', i, normF);
    end
    if normF < tol
        converged = 1;
        if mpopt.verbose
            fprintf('\\nNewton''s method corrector converged in %d iterations.\\n', i);
        end
    end
end

if mpopt.verbose
    if ~converged
        fprintf('\\nNewton''s method corrector did not converge in %d iterations.\\n', i);
    end
end"
3470,cpf_detect_events.m,77.684,80,63.06,90,100.0,55.36,70-80,"function [rollback, evnts, cef] = cpf_detect_events(cpf_events, cef, pef, step, verbose)


rollback = 0;
evnts = struct( ...
    'eidx', 0, ...
    'name', '', ...
    'zero', 0, ...
    'idx', 0, ...
    'step_scale', 1, ...
    'log', 0, ...
    'msg', '' ...
);

i = 1;              %% index into evnts struct
nef = length(cef);  %% number of event functions

for eidx = 1:nef
    if ~cpf_events(eidx).locate %% if event doesn't request rollback to locate zero
        continue;               %%   skip to next event
    end

    c_sign = sign(cef{eidx});
    p_sign = sign(pef{eidx});

    idx = find( abs(c_sign) == 1 & c_sign == -p_sign & ...
                abs(cef{eidx}) > cpf_events(eidx).tol  );
    if ~isempty(idx)
        if step == 0    %% if it's a ""repeat"" step (e.g. after bus type changes)
            evnts.eidx = eidx;
            evnts.name = cpf_events(eidx).name;
            evnts.zero = 1;
            evnts.idx = idx;
            evnts.step_scale = 1;
            evnts.log = 1;
            evnts.msg = 'ZERO (BIFURCATION)';
            i = i + 1;
            break;
        else
            [step_scale, j] = ...
                min(pef{eidx}(idx) ./ (pef{eidx}(idx) - cef{eidx}(idx)) );

            if step_scale < evnts.step_scale
                evnts.eidx = eidx;
                evnts.name = cpf_events(eidx).name;
                evnts.zero = 0;
                evnts.idx = idx(j);
                evnts.step_scale = step_scale;
                evnts.log = 0;
                evnts.msg = 'INTERVAL';
                rollback = 1;   %% signal that a rollback event has been detected
            end
        end
    end
end

if rollback == 0
    for eidx = 1:nef
        idx = find( abs(cef{eidx}) <= cpf_events(eidx).tol );
        if ~isempty(idx)
            cef{eidx}(idx) = 0;

            evnts(i).eidx = eidx;
            evnts(i).name = cpf_events(eidx).name;
            evnts(i).zero = 1;
            evnts(i).idx = idx;
            evnts(i).step_scale = 1;
            evnts(i).log = 1;
            evnts(i).msg = 'ZERO';
            i = i + 1;
        end
    end
    
    if i == 1
        for eidx = 1:nef
            c_sign = sign(cef{eidx});
            p_sign = sign(pef{eidx});

            idx = find( abs(c_sign) == 1 & c_sign == -p_sign );
            if ~isempty(idx)
                step_scale = pef{eidx}(idx) ./ (pef{eidx}(idx) - cef{eidx}(idx));

                evnts(i).eidx = eidx;
                evnts(i).name = cpf_events(eidx).name;
                evnts(i).zero = 0;
                evnts(i).idx = idx;
                evnts(i).step_scale = step_scale;
                evnts(i).log = 0;
                evnts(i).msg = 'INTERVAL';
                i = i + 1;
            end
        end
    end
end

if evnts(1).eidx
    for i = 1:length(evnts)
        if length(cef{evnts(i).eidx}) > 1
            s1 = sprintf('(%d)', evnts(i).idx);
        else
            s1 = '';
        end
        if rollback
            s2 = sprintf('ROLLBACK by %g', evnts(i).step_scale);
        else
            s2 = 'CONTINUE';
        end
        evnts(i).msg = sprintf('%s detected for %s%s event : %s', ...
            evnts(i).msg, evnts(i).name, s1, s2);
    end
end"
3471,cpf_flim_event_cb.m,79.482,100,67.24,75,100.0,55.17,70-80,"function [nx, cx, done, rollback, evnts, cb_data, results] = cpf_flim_event_cb(...
        k, nx, cx, px, done, rollback, evnts, cb_data, cb_args, results)


[PQ, PV, REF, NONE, BUS_I, BUS_TYPE, PD, QD, GS, BS, BUS_AREA, VM, ...
    VA, BASE_KV, ZONE, VMAX, VMIN, LAM_P, LAM_Q, MU_VMAX, MU_VMIN] = idx_bus;
[F_BUS, T_BUS, BR_R, BR_X, BR_B, RATE_A, RATE_B, RATE_C, ...
    TAP, SHIFT, BR_STATUS, PF, QF, PT, QT, MU_SF, MU_ST, ...
    ANGMIN, ANGMAX, MU_ANGMIN, MU_ANGMAX] = idx_brch;

mpc = cb_data.mpc_base;
nb = size(mpc.bus, 1);
i2e_bus = mpc.order.bus.i2e;
f = mpc.branch(:, F_BUS);
t = mpc.branch(:, T_BUS);
SrateA = mpc.branch(:,RATE_A);

if k == 0
    Sf = sqrt((mpc.branch(:, PF)).^2 + (mpc.branch(:, QF)).^2);
    St = sqrt((mpc.branch(:, PT)).^2 + (mpc.branch(:, QT)).^2);

    if any(max(Sf,St) > SrateA)
        done.flag = 1;  %% prepare to terminate
        
        iL = find(max(Sf,St) > SrateA);
        for j = 1:length(iL)
            L = iL(j);
            msg = sprintf('branch flow limit violated in base case: branch %d -- %d exceeds limit of %g MVA\\n',...
                i2e_bus(f(L)), i2e_bus(t(L)), SrateA(L));

            done.msg = msg;
        end
    end
end

if k < 0 || done.flag
    return;
end

for i = 1:length(evnts)
    if strcmp(evnts(i).name, 'FLIM') && evnts(i).zero
        if cb_data.mpopt.verbose > 3
            msg = sprintf('%s\\n    ', evnts(i).msg);
        else
            msg = '';
        end
        
        iL = evnts(i).idx;
        for j = 1:length(iL)
            L = iL(j);      %% index of critical branch event of interest
            msg = sprintf('%sbranch flow limit reached\\nbranch %d -- %d at limit of %g MVA @ lambda = %.4g, in %d continuation steps',...
                msg, i2e_bus(f(L)), i2e_bus(t(L)), SrateA(L), nx.lam, k);
        end
        
        done.flag = 1;
        done.msg = msg;
    end
end"
3472,cpf_nose_event_cb.m,73.208,60,65.52,75,100.0,65.52,70-80,"function [nx, cx, done, rollback, evnts, cb_data, results] = cpf_nose_event_cb(...
        k, nx, cx, px, done, rollback, evnts, cb_data, cb_args, results)


if k <= 0 || done.flag
    return;
end

stop_at = cb_data.mpopt.cpf.stop_at;

if ~rollback || nx.step == 0
    for i = 1:length(evnts)
        if strcmp(evnts(i).name, 'NOSE') && evnts(i).zero
            if nx.step == 0
                evnts(i).msg = ...
                    sprintf('Nose point eliminated by limit induced bifurcation at %d continuation steps, lambda = %.4g.', k, nx.lam);
            else
                evnts(i).msg = ...
                    sprintf('Reached steady state loading limit in %d continuation steps, lambda = %.4g.', k, nx.lam);
            end

            if ischar(stop_at) && strcmp(stop_at, 'NOSE');
                done.flag = 1;
                done.msg = evnts(i).msg;
            end
            break;
        end
    end
end"
3473,cpf_p.m,79.6,60,76.0,90,100.0,72.0,70-80,"function P = cpf_p(parameterization, step, z, V, lam, Vprv, lamprv, pv, pq)


if parameterization == 1        %% natural
    if lam >= lamprv
        P = lam - lamprv - step;
    else
        P = lamprv - lam - step;
    end
elseif parameterization == 2    %% arc length
    Va = angle(V);
    Vm = abs(V);
    Vaprv = angle(Vprv);
    Vmprv = abs(Vprv);
    P = sum(([Va([pv; pq]); Vm(pq); lam] - [Vaprv([pv; pq]); Vmprv(pq); lamprv]).^2) - step^2;
elseif parameterization == 3    %% pseudo arc length
    nb = length(V);
    Va = angle(V);
    Vm = abs(V);
    Vaprv = angle(Vprv);
    Vmprv = abs(Vprv);
    P = z([pv; pq; nb+pq; 2*nb+1])' * ...
        ( [Va([pv; pq]); Vm(pq); lam] - [Vaprv([pv; pq]); Vmprv(pq); lamprv] )...
        - step;
end"
3474,cpf_qlim_event_cb.m,78.092,100,70.1,75,100.0,45.36,70-80,"function [nx, cx, done, rollback, evnts, cb_data, results] = cpf_qlim_event_cb(...
        k, nx, cx, px, done, rollback, evnts, cb_data, cb_args, results)


if k <= 0 || done.flag
    return;
end

[PQ, PV, REF, NONE, BUS_I, BUS_TYPE, PD, QD, GS, BS, BUS_AREA, VM, ...
    VA, BASE_KV, ZONE, VMAX, VMIN, LAM_P, LAM_Q, MU_VMAX, MU_VMIN] = idx_bus;
[GEN_BUS, PG, QG, QMAX, QMIN, VG, MBASE, GEN_STATUS, PMAX, PMIN, ...
    MU_PMAX, MU_PMIN, MU_QMAX, MU_QMIN, PC1, PC2, QC1MIN, QC1MAX, ...
    QC2MIN, QC2MAX, RAMP_AGC, RAMP_10, RAMP_30, RAMP_Q, APF] = idx_gen;

mpc = [];

for i = 1:length(evnts)
    if strcmp(evnts(i).name, 'QLIM') && evnts(i).zero
        if isempty(mpc)
            d = cb_data;
            if length(d.ref) ~= 1
                error('cpf_qlim_event_cb: ''cpf.enforce_qlims'' option only valid for systems with exactly one REF bus')
            end
            mpc = cpf_current_mpc(d.mpc_base, d.mpc_target, ...
                d.Ybus, d.Yf, d.Yt, d.ref, d.pv, d.pq, nx.V, nx.lam, d.mpopt);
            ng = size(mpc.gen, 1);
            i2e_bus = mpc.order.bus.i2e;
            i2e_gen = mpc.order.gen.i2e;
        end

        if cb_data.mpopt.verbose > 3
            msg = sprintf('%s\\n    ', evnts(i).msg);
        else
            msg = '';
        end
        ig = evnts(i).idx;
        for j = 1:length(ig)
            g = ig(j);                  %% index of gen of interest
            maxlim = 1;
            if g > ng
                g = g - ng;
                maxlim = 0;
            end
            ib = mpc.gen(g, GEN_BUS);   %% corresponding bus index
            if maxlim
                msg = sprintf('%sgen %d @ bus %d reached %g MVAr Qmax lim @ lambda = %.4g : bus %d converted to PQ', ...
                    msg, i2e_gen(g), i2e_bus(ib), mpc.gen(g, QMAX), nx.lam, i2e_bus(ib));
            else
                msg = sprintf('%sgen %d @ bus %d reached %g MVAr Qmin lim @ lambda = %.4g : bus %d converted to PQ', ...
                    msg, i2e_gen(g), i2e_bus(ib), mpc.gen(g, QMIN), nx.lam, i2e_bus(ib));
            end

            if maxlim
                mpc.gen(g, QG) = mpc.gen(g, QMAX);
            else
                mpc.gen(g, QG) = mpc.gen(g, QMIN);
            end
            mpc.bus(ib, BUS_TYPE) = PQ;

            on = find(mpc.gen(:, GEN_STATUS) > 0 & ...  %% which generators are on?
                      mpc.bus(mpc.gen(:, GEN_BUS), BUS_TYPE) ~= PQ);  %% ... and are not PQ buses

            if isempty(on)
                done.flag = 1;
                done.msg = 'No REF or PV buses remaining.';
            else
                oldref = cb_data.ref;   %% save previous ref bus
                [ref, pv, pq] = bustypes(mpc.bus, mpc.gen);
                if oldref ~= ref        %% ref bus changed
                    mpc.bus(ref, BUS_TYPE) = REF;
                end

                cb_data.ref = ref;
                cb_data.pv  = pv;
                cb_data.pq  = pq;
                cb_data.mpc_base.bus(  :, BUS_TYPE) = mpc.bus(:, BUS_TYPE);
                cb_data.mpc_target.bus(:, BUS_TYPE) = mpc.bus(:, BUS_TYPE);
            
                cb_data.mpc_base.gen(  g, QG) = mpc.gen(g, QG);
                cb_data.mpc_target.gen(g, QG) = mpc.gen(g, QG);

                if oldref ~= ref
                    cb_data.mpc_base.gen(  g, PG) = mpc.gen(g,PG);
                    cb_data.mpc_target.gen(g, PG) = mpc.gen(g,PG);
                end
                
                b = cb_data.mpc_base;
                t = cb_data.mpc_target;
                cb_data.Sbusb = @(Vm)makeSbus(b.baseMVA, b.bus, b.gen, d.mpopt, Vm);
                cb_data.Sbust = @(Vm)makeSbus(t.baseMVA, t.bus, t.gen, d.mpopt, Vm);
                
                nx.this_step = 0;
            end
        end
        evnts(i).msg = msg;
    end
end"
3475,cpf_register_event.m,74.2,60,76.0,75,100.0,60.0,70-80,"function cpf_events = cpf_register_event(cpf_events, name, fcn, tol, locate)


e = struct( ...
        'name', name, ...
