2175,ComputeLP_metric_error.m,73.572,100,68.57,45,100.0,54.29,70-80,"function [squared_LP_metric, LP_metric_loc, LP_metric_mis, LP_metric_fal, LP_metric_switch]=ComputeLP_metric_error(X_estimate,t_b_estimate, length_estimate,X_truth,t_birth,t_death,c_gospa,gamma_track_metric,k,Nx)


