6431,cubic_split.m,64.0,30,100.0,30,100.0,60.0,61-70,"function [C1,C2] = cubic_split(C,t)
  C12 = (C(2,:)-C(1,:)).*t + C(1,:);
  C23 = (C(3,:)-C(2,:)).*t + C(2,:);
  C34 = (C(4,:)-C(3,:)).*t + C(3,:);
  C123 = (C23-C12).*t+C12;
  C234 = (C34-C23).*t+C23;
  C1234 = (C234-C123).*t+C123;
  C1 = [C(1,:);C12;C123;C1234];
  C2 = [C1234;C234;C34;C(4,:)];
end"
