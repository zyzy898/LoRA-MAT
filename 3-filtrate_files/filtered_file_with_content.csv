5283,DEMO_BAYES_FACTORS.m,74.65,100,71.08,60,100.0,42.17,70-80,"function DEMO_BAYES_FACTORS(pC,hE,hC,N,b)



rng('default')

try, pC; catch, pC = 1;     end
try, hE; catch, hE = 0;     end
try, hC; catch, hC = 1/16;  end
try, N;  catch, N  = 32;    end
try, b;  catch, b  = 1/128; end

Y    = randn(N,1);
XX   = kron([1 1; 1 -1],ones(N/2,1));

M.nograph = 1;
M.noprint = 1;

M.IS = @(P,M,U) U*P;
M.pE = zeros(2,1);
M.pC = speye(2,2)*pC;
M.hE = hE;
M.hC = hC;
 

Ns  = 64;
for i = 1:Ns
    X{i} = XX;
    X{i}(:,2) = XX(randperm(N),2);
end

pE    = M.pE;                    % full prior expectations
pC    = M.pC;                    % full prior covariance
rC    = pC; rC(2,2) = b;         % restricted or reduced priors
R     = M; R.pC = rC;            % reduced model  
Cr    = [0 0;0 1];               % classical contrast
for i = 1:Ns
    
    [qE,qC,Eh,f] =  spm_nlsi_GN(M,X{i},Y);
    F(i,1)       = -spm_log_evidence(qE,qC,pE,pC,pE,rC);
    [qE,qC,Eh,r] =  spm_nlsi_GN(R,X{i},Y);
    G(i,1)       =  f - r; disp(i)
    
    T(i,1)       =  spm_ancova(X{i},[],Y,Cr);
    
end

u   = spm_invFcdf(0.95,[1 (N - 2)]);
r   = sort(T);
r   = r(fix((1 - 0.05)*Ns));

j   = abs(F) < 32;
b   = pinv([F(j) ones(size(F(j)))])*T(j);
Fq  = (-32:32)';
Tq  = [Fq, ones(size(Fq))]*b;

spm_figure('GetWin','Graphics');clf

subplot(2,2,1)
hist(F,32), hold on
xlabel('Log Bayes Factor','FontSize',16), ylabel('Frequency')
title('Null distribution','FontSize',16)
axis square

subplot(2,2,2)
hist(T,32), hold on
plot([u u],[0 Ns/4],'--r'), hold on
plot([r r],[0 Ns/4],'--b'), hold off
xlabel('Classical F-ratio','FontSize',16), ylabel('Frequency')
title('Null distribution','FontSize',16)
axis square

subplot(2,1,2)
plot(F,T,'.b','Markersize',8), hold on
plot(G,T,'.r','Markersize',8), hold on
plot(Fq,Tq,'b'), hold on
plot([3 3],[0 16],':r'), hold on
plot([0 0],[0 16],'--r'), hold on
plot([-32, 32],[r r],':b'), hold off
xlabel('free energy difference','FontSize',16), ylabel('Classical F-ratio')
title('Null distribution','FontSize',16)
axis([-8 8 0 16])
axis square"
5284,demo_blockproc_basicloop.m,79.714,100,62.86,90,100.0,45.71,70-80,"function demo_blockproc_basicloop(source,varargin) %RUNASSCRIPT


if demo_blockproc_header(mfilename,nargin)
   return;
end



p = blockpanel({
               {'GdB','Gain',-20,20,0,21},...
               });


           
try
    fs = block(source,varargin{:},'loadind',p);
catch
    blockdone(p);
    err = lasterror;
    error(err.message);
end

L = floor(30e-3*fs);

flag = 1;
while flag && p.flag
   gain = blockpanelget(p,'GdB');
   gain = 10^(gain/20);
   
   [f,flag] = blockread(L);
   blockplay(f*gain);
   blockwrite(f);
end
blockdone(p);"
5285,demo_blockproc_effects.m,75.088,80,55.16,100,100.0,40.28,70-80,"function demo_blockproc_effects(source,varargin) %RUNASSCRIPT


if demo_blockproc_header(mfilename,nargin)
   return;
end

fobj = blockfigure();

bufLen = 1024;

Fmorph = frametight(frame('dgtreal',{'hann',512},128,512,'timeinv'));
Fmorph = blockframeaccel(Fmorph, bufLen,'segola');

haveWav = 0;
try
   [ff, fsbeat] = wavload('beat.wav'); ff = ff(:,1);
   ffblocks = reshape(postpad(ff,ceil(size(ff,1)/bufLen)*bufLen),bufLen,[]);
   cidx = 1;
   haveWav = 1;
catch
   warning('beat.wav not found. morphing effect is disabled.');
end

if haveWav && fsbeat~=44100
    error('%s: beat.wav must be sampled at 44.1 kHz.',upper(mfilename));
end

Fana = frame('dgtreal',{'hann',882},300,3000);
Fana = blockframeaccel(Fana, bufLen,'segola');

Mrob = 2^12;
Frob = frametight(frame('dgtreal',{'hann',Mrob},Mrob/8,Mrob,'timeinv'));
Frob = blockframeaccel(Frob, bufLen,'segola');

Mwhis = 512;
Fwhis = frametight(frame('dgtreal',{'hann',512},128,Mwhis));
Fwhis = blockframeaccel(Fwhis, bufLen,'segola');


M = 1024;
a = 512;
[F] = frametight(frame('dgtreal',{'hann',1024},a,M,'timeinv'));
Fa = blockframeaccel(F, bufLen,'segola');
Fs = Fa;

Mhalf = floor(M/2) + 1;
scale = (0:Mhalf-1)/Mhalf;
scale = scale(:);

shiftRange = 12;

scaleTable = round(scale*2.^(-(1:shiftRange)/12)*Mhalf)+1;
scaleTable2 = round(scale*2.^((1:shiftRange)/12)*Mhalf)+1;
scaleTable2(scaleTable2>Mhalf) = Mhalf;

phaseCorr = exp(abs(bsxfun(@minus,scaleTable,(1:size(scaleTable,1))'))./M*2*pi*1i*a);
phaseCorr2 = exp(abs(bsxfun(@minus,scaleTable2,(1:size(scaleTable2,1))'))./M*2*pi*1i*a);
fola = [];
phasecorrVect = ones(Mhalf,1,'single');

if haveWav
parg = {
        {'GdB','Gain',-20,20,0,21},...
        {'Eff','Effect',0,4,0,5},...
        {'Shi','Shift',-shiftRange,shiftRange,0,2*shiftRange+1}
       };
else
parg = {
        {'GdB','Gain',-20,20,0,21},...
        {'Eff','Effect',0,3,0,4},...
        {'Shi','Shift',-shiftRange,shiftRange,0,2*shiftRange+1}
       };
end

p = blockpanel(parg);

try
   fs=block(source,varargin{:},'loadind',p,'L',bufLen);
catch
    blockdone(p,fobj);
    err = lasterror;
    error(err.message);
end

if fs~=44100
    error('%s: This demo only works with fs=44100 Hz.',upper(mfilename));
end

p.setVisibleParam('Shi',0);


oldEffect = 0;
flag = 1;
ffola = [];
while flag && p.flag
   gain = blockpanelget(p,'GdB');
   gain = 10.^(gain/20);
   effect = blockpanelget(p,'Eff');
   shift = fix(blockpanelget(p,'Shi'));
   
   effectChanged = 0;
   if oldEffect ~= effect
       effectChanged = 1;
   end
   oldEffect = effect;
       
   

   [f,flag] = blockread();

   f=f*gain;
   if effect ==0
       if effectChanged
          p.setVisibleParam('Shi',0);
       end
       c = blockana(Fana, f);
       blockplot(fobj,Fana,c(:,1));
       
       fhat = f;
   elseif effect == 1
   if effectChanged
       p.setVisibleParam('Shi',0);
   end
   
   c = blockana(Frob, f);
   
   cc = Frob.coef2native(c,size(c));
   
   if(strcmpi(source,'playrec'))
      cc(1:2,:,:) = 0;
   end
   
   c = Frob.native2coef(cc);
   
   c = abs(c);
   
   blockplot(fobj,Frob,c(:,1));
   
   fhat = blocksyn(Frob, c, size(f,1));
   
   elseif effect == 2
   if effectChanged
       p.setVisibleParam('Shi',0);
   end

    c = blockana(Fwhis, f);
   
    cc = Fwhis.coef2native(c,size(c));
   
    if(strcmpi(source,'playrec'))
      cc(1:2,:,:) = 0;
    end
   
    c = Fwhis.native2coef(cc);
   
    c = abs(c).*exp(i*2*pi*randn(size(c)));
  
   
    blockplot(fobj,Fwhis,c(:,1));
   
    fhat = blocksyn(Fwhis, c, size(f,1));
   elseif effect == 3
   if effectChanged
       p.setVisibleParam('Shi',1);
   end
       

   c = blockana(Fa, f);
   
   cc = Fa.coef2native(c,size(c));

       cTmp = zeros(size(cc),class(c));
    if shift<0
       slices = size(cc,2);
       for s = 1:slices
          phasecorrVect = phasecorrVect.*phaseCorr(:,-shift);
          cTmp(scaleTable(:,-shift),s,:) =... 
          bsxfun(@times,cc(1:numel(scaleTable(:,-shift)),s,:),phasecorrVect);
       end
    elseif shift>0
       slices = size(cc,2);
       for s = 1:slices
          phasecorrVect = phasecorrVect.*phaseCorr2(:,shift);
          cTmp(scaleTable2(:,shift),s,:) =... 
          bsxfun(@times,cc(1:numel(scaleTable2(:,shift)),s,:),phasecorrVect);
       end
    else
        cTmp = cc;
    end
   
   c = Fa.native2coef(cTmp);
 
   
   fhat = blocksyn(Fs, c, size(f,1));
   
   [c2,fola] = blockana(Fa,fhat,fola);
   
   blockplot(fobj,Fa,c2(:,1));
   
   elseif effect == 4
      if effectChanged
       p.setVisibleParam('Shi',0);
     end
       
       
       [cff,ffola] = blockana(Fmorph, ffblocks(:,cidx), ffola);
       cidx = mod(cidx,size(ffblocks,2)) + 1;
       c = blockana(Fmorph, f);
       
       c = bsxfun(@times,abs(c),exp(1i*(angle(cff) )));

   
        blockplot(fobj,Fmorph,c(:,1));
   
        fhat = blocksyn(Fmorph, c, size(f,1)); 
   
   end

   blockplay(fhat);
   blockwrite(fhat);
end
blockdone(p,fobj);"
5286,demo_blockproc_paramequalizer.m,75.336,80,57.53,100,100.0,39.15,70-80,"function demo_blockproc_paramequalizer(source,varargin) %RUNASSCRIPT

if demo_blockproc_header(mfilename,nargin)
   return;
end


Q = sqrt(2);

filts = [
         struct('Hb',[1;0],'Ha',[1;0],'G',0,'Z',[0;0],'type','lsf'),...
         struct('Hb',[1;0;0],'Ha',[1;0;0],'G',0,'Z',[0;0],'type','peak'),...
         struct('Hb',[1;0;0],'Ha',[1;0;0],'G',0,'Z',[0;0],'type','peak'),...
         struct('Hb',[1;0;0],'Ha',[1;0;0],'G',0,'Z',[0;0],'type','peak'),...
         struct('Hb',[1;0;0],'Ha',[1;0;0],'G',0,'Z',[0;0],'type','peak'),...
         struct('Hb',[1;0;0],'Ha',[1;0;0],'G',0,'Z',[0;0],'type','hsf')...
        ];
     
     

pcell = cell(1,numel(filts));
for ii=1:numel(filts)
   pcell{ii} =  {sprintf('band%i',ii),'Gain',-10,10,filts(ii).G,41};
end
p = blockpanel(pcell); 

try
    fs = block(source,varargin{:},'loadind',p);
catch
    blockdone(p);
    err = lasterror;
    error(err.message);
end

bufLen = floor(30e-3*fs);

feq = [0.0060, 0.0156, 0.0313, 0.0625, 0.1250, 0.2600]*fs;

[filts(1).Ha, filts(1).Hb] = parlsf(feq(1),blockpanelget(p,'band1'),fs);
[filts(2).Ha, filts(2).Hb] = parpeak(feq(2),Q,blockpanelget(p,'band2'),fs);
[filts(3).Ha, filts(3).Hb] = parpeak(feq(3),Q,blockpanelget(p,'band3'),fs);
[filts(4).Ha, filts(4).Hb] = parpeak(feq(4),Q,blockpanelget(p,'band4'),fs);
[filts(5).Ha, filts(5).Hb] = parpeak(feq(5),Q,blockpanelget(p,'band5'),fs);
[filts(6).Ha, filts(6).Hb] = parhsf(feq(6),blockpanelget(p,'band6'),fs);

flag = 1;
while flag && p.flag
   
  G = blockpanelget(p,'band1','band2','band3','band4','band5','band6');
  
   for ii=1:numel(filts)
     if G(ii)~=filts(ii).G
        filts(ii).G = G(ii);
        if strcmpi('lsf',filts(ii).type)
           [filts(ii).Ha, filts(ii).Hb] = parlsf(feq(ii),filts(ii).G,fs);
        elseif strcmpi('hsf',filts(ii).type)
           [filts(ii).Ha, filts(ii).Hb] = parhsf(feq(ii),filts(ii).G,fs);
        elseif strcmpi('peak',filts(ii).type)
           [filts(ii).Ha, filts(ii).Hb] = parpeak(feq(ii),Q,filts(ii).G,fs);   
        else
           error('Uknown filter type.');
        end
     end
  end
       
  [f,flag] = blockread(bufLen);
 
  for ii=1:numel(filts)
    [f,filts(ii).Z] = filter(filts(ii).Ha,filts(ii).Hb,f,filts(ii).Z);
  end

  blockplay(f);
end
blockdone(p);

function [Ha,Hb]=parlsf(fc,G,Fs)
Ha = zeros(3,1);
Hb = zeros(3,1);
Hb(1) = 1;
Ha(1) = 1;
K = tan(pi*fc/Fs);
if G>0
   V0=10^(G/20);
   den = 1 + sqrt(2)*K + K*K;
   Ha(1) = (1+sqrt(2*V0)*K+V0*K*K)/den;
   Ha(2) = 2*(V0*K*K-1)/den;
   Ha(3) = (1-sqrt(2*V0)*K+V0*K*K)/den;
   Hb(2) = 2*(K*K-1)/den;
   Hb(3) = (1-sqrt(2)*K+K*K)/den;
elseif G<0
   V0=10^(-G/20);
   den = 1 + sqrt(2*V0)*K + V0*K*K;
   Ha(1) = (1+sqrt(2)*K+K*K)/den;
   Ha(2) = 2*(K*K-1)/den;
   Ha(3) = (1-sqrt(2)*K+K*K)/den;
   Hb(2) = 2*(V0*K*K-1)/den;
   Hb(3) = (1-sqrt(2*V0)*K+V0*K*K)/den;
end

function [Ha,Hb]=parpeak(fc,Q,G,Fs)
Ha = zeros(3,1);
Hb = zeros(3,1);
Hb(1) = 1;
Ha(1) = 1;
K = tan(pi*fc/Fs);
if G>0
   V0=10^(G/20);
   den = 1 + K/Q + K*K;
   Ha(1) = (1+V0*K/Q+K*K)/den;
   Ha(2) = 2*(K*K-1)/den;
   Ha(3) = (1-V0*K/Q+K*K)/den;
   Hb(2) = 2*(K*K-1)/den;
   Hb(3) = (1-K/Q+K*K)/den;
elseif G<0
   V0=10^(-G/20);
   den = 1 + V0*K/Q + K*K;
   Ha(1) = (1+K/Q+K*K)/den;
   Ha(2) = 2*(K*K-1)/den;
   Ha(3) = (1-K/Q+K*K)/den;
   Hb(2) = 2*(K*K-1)/den;
   Hb(3) = (1-V0*K/Q+K*K)/den;
end

function [Ha,Hb]=parhsf(fm,G,Fs)
Ha = zeros(3,1);
Hb = zeros(3,1);
Hb(1) = 1;
Ha(1) = 1;
K = tan(pi*fm/Fs);
if G>0
   V0=10^(G/20);
   den = 1 + sqrt(2)*K + K*K;
   Ha(1) = (V0+sqrt(2*V0)*K+K*K)/den;
   Ha(2) = 2*(K*K-V0)/den;
   Ha(3) = (V0-sqrt(2*V0)*K+K*K)/den;
   Hb(2) = 2*(K*K-1)/den;
   Hb(3) = (1-sqrt(2)*K+K*K)/den;
elseif G<0
   V0=10^(-G/20);
   den = V0 + sqrt(2*V0)*K + K*K;
   Ha(1) = (1+sqrt(2)*K+K*K)/den;
   Ha(2) = 2*(K*K-1)/den;
   Ha(3) = (1-sqrt(2)*K+K*K)/den;
   Hb(2) = 2*(K*K/V0-1)/den;
   Hb(3) = (1-sqrt(2/V0)*K+K*K/V0)/den;
end"
