6403,correlatedGaussianNoise.m,69.606,100,57.58,45,100.0,45.45,61-70,"function [result, sampRpp] = correlatedGaussianNoise(Rpp, nSamp)


if(ndims(Rpp) ~= 2),
    result = [];
    error('Rpp must be a real-valued symmetric matrix');
    return;
end

Rpp = 0.5 .*(double(Rpp) + double(Rpp'));

[V,D] = eig(Rpp);

if(any(diag(D) <= 0)),
    result = [];
    error('Rpp must be a positive definite');
    return;
end

W = V*sqrt(D);

n = randn(size(Rpp,1), nSamp);

result = W * n;

if(nargout == 2),
    sampRpp = 0;
    for k1=1:nSamp,
        sampRpp = sampRpp + result(:,k1) * (result(:,k1)');
    end
    
    sampRpp = sampRpp ./ (nSamp - 1);
end"
6404,comp_wfac.m,66.816,100,48.15,60,100.0,25.93,61-70,"function gf=comp_wfac(g,a,M)

  
L=size(g,1);
R=size(g,2);

N=L/a;
b=L/M;

c=gcd(a,M);
p=a/c;
q=M/c;
d=N/q;

gf=zeros(p,q*R,c,d,assert_classname(g));

if p==1  
  if (c==1) && (d==1) && (R==1)
    for l=0:q-1	  
      gf(1,l+1,1,1)=g(mod(-l,L)+1);
    end;

  else

    for w=0:R-1
      for s=0:d-1
	for l=0:q-1	  
	  gf(1,l+1+q*w,:,s+1)=g((1:c)+mod(-l*a+s*p*M,L),w+1);
	end;
      end;
    end;

  end;
else

  for w=0:R-1
    for s=0:d-1
      for l=0:q-1
	for k=0:p-1	    
	  gf(k+1,l+1+q*w,:,s+1)=g((1:c)+c*mod(k*q-l*p+s*p*q,d*p*q),w+1);
	end;
      end;
    end;
  end;

end;

if d>1
  gf=fft(gf,[],4);
end;

gf=gf*sqrt(M);

gf=reshape(gf,p*q*R,c*d);"
