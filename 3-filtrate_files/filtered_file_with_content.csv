qE     = P(:,1); qS = sqrt(diag(C{1}))*1.69;
txt{4} = sprintf(' Prevalence (%s) : %.3f (%.3f - %.3f)','%',qE(j),qE(j) - qS(j),qE(j) + qS(j));

text(d,m,txt,'FontSize',10,'Fontweight','bold')

subplot(2,1,2), hold off
