                [ExchangeRxnMatrix] = addReaction(ExchangeRxnMatrix,R,'metaboliteList',[sub(1) prod(1)],'stoichCoeffList',[-1 1],'lowerBound',-10000,'upperBound',10000);
               
            elseif (strcmp(compartment,'[p]')==1) % keep this branch the same for now.
