for m=1:M
   for w=1:W
      F(:,w)=F(:,w)+repmat(fft(c{m}(:,w)),a(m),1).*conj(G{m});
   end;
end"
2524,comp_inonsepdgt.m,75.514,100,60.26,75,100.0,42.31,70-80,"function f=comp_inonsepdgt(coef,g,a,lt,do_timeinv,alg)




M=size(coef,1);
N=size(coef,2);
W=size(coef,3);
L=N*a;

if (alg==1) || (alg==0 && lt(2)<=2) 
    
    
    mwin=comp_nonsepwin2multi(g,a,M,lt,L);
    
    
    E = exp(2*pi*i*a*kron(0:N/lt(2)-1,ones(1,lt(2))).*...
            rem(kron(ones(1,N/lt(2)), 0:lt(2)-1)*lt(1),lt(2))/M);

    coef=bsxfun(@times,coef,E);
    
    f=zeros(L,W,assert_classname(coef,g));
    for ii=0:lt(2)-1
        sub=coef(:,ii+1:lt(2):end);
        f=f+comp_idgt(sub,mwin(:,ii+1),lt(2)*a,M,L,0);  
    end;

else

    [s0,s1,br] = shearfind(L,a,M,lt);
    
    b=L/M;
    ar = a*b/br;
    Mr = L/br;
    Nr = L/ar;
    
    ind = [ar 0; 0 br]*[kron((0:L/ar-1),ones(1,L/br));kron(ones(1,L/ar), ...
                                                      (0:L/br-1))];
    phs = reshape(mod((s1*(ind(1,:)-s0*ind(2,:)).^2+s0*ind(2,:).^2)*(L+1) ...
                    -2*(s0 ~= 0)*ind(1,:).*ind(2,:),2*L),L/br,L/ar);    
    phs = exp(-pi*1i*phs/L);

    ind_final = [1 0;-s1 1]*[1 -s0;0 1]*ind;
    ind_final = mod(ind_final,L);
    
    if s1 ~= 0
        g = comp_pchirp(L,s1).*g;
    end
    
    if s0 ~= 0
        
        c_rect = zeros(Nr,Mr,W,assert_classname(coef,g));
        g = comp_pchirp(L,-s0).*fft(g);
        for w=0:W-1
            c_rect(ind(1,[1:Mr,end:-1:Mr+1])/ar+1+(ind(2,:)/br)*Nr+w*M*N) = ...
                coef(floor(ind_final(2,:)/b)+1+(ind_final(1,:)/a)*M+w*M* ...
                     N).*phs(ind(2,:)/br+1+(ind(1,:)/ar)*Mr);
        end;
        f = comp_idgt(c_rect,g,br,Nr,L,0);
        f = ifft(bsxfun(@times,comp_pchirp(L,s0),f));   
        
    else
        
        c_rect = zeros(Mr,Nr,W,assert_classname(coef,g));
        for w=0:W-1
            c_rect(ind(2,:)/br+1+(ind(1,:)/ar)*Mr+w*M*N) = ... 
                coef(floor(ind_final(2,:)/b)+1+(ind_final(1,:)/a)*M+w*M*N);       
            c_rect(:,:,w+1) = phs.*c_rect(:,:,w+1);
        end;
        f = comp_idgt(c_rect,g,ar,Mr,L,0);
        
    end
    
    if s1 ~= 0
        f = bsxfun(@times,comp_pchirp(L,-s1),f);
    end        

end;"
2525,comp_inonsepdgtreal_quinqux.m,76.324,100,67.57,60,100.0,54.05,70-80,"function f=comp_inonsepdgtreal_quinqux(coef,g,a,M,do_timeinv)




M2=size(coef,1);
N=size(coef,2);
W=size(coef,3);
L=N*a;

coef2=zeros(M,N,W,assert_classname(coef,g));

coef2(1:M2,:,:)=coef;
if rem(M,2)==0
    coef2(M2+1:M,1:2:N-1,:)=conj(coef(M2-1:-1:2,1:2:N-1,:));
    coef2(M2:M,2:2:N  ,:)  =conj(coef(M2-1:-1:1,2:2:N,:));
else
    coef2(M2+1:M,1:2:N-1,:)=conj(coef(M2:-1:2,1:2:N-1,:));
    coef2(M2+1:M,2:2:N  ,:)=conj(coef(M2-1:-1:1,2:2:N,:));
end;

coef=coef2;

lt=[1 2];
mwin=comp_nonsepwin2multi(g,a,M,lt,L);


E = exp(2*pi*i*a*kron(0:N/2-1,ones(1,2)).*...
        rem(kron(ones(1,N/2), 0:2-1),2)/M);

coef = bsxfun(@times,coef,E);

f=zeros(L,W,assert_classname(coef,g));
for ii=0:2-1
    sub=coef(:,ii+1:2:end,:);
    f=f+comp_idgt(sub,mwin(:,ii+1),2*a,[0 1],0,0);  
end;"
2526,comp_inonsepdgt_shear.m,73.182,100,56.57,75,100.0,34.34,70-80,"function f=comp_inonsepdgt_shear(coef,g,a,s0,s1,br)

M=size(coef,1);
N=size(coef,2);
W=size(coef,3);

L=N*a;

b=L/M;
ar = a*b/br;
Mr = L/br;
Nr = L/ar;

ind = [ar 0; 0 br]*[kron((0:L/ar-1),ones(1,L/br));kron(ones(1,L/ar), ...
                                                  (0:L/br-1))];
phs = reshape(mod((s1*(ind(1,:)-s0*ind(2,:)).^2+s0*ind(2,:).^2)*(L+1) ...
                  -2*(s0 ~= 0)*ind(1,:).*ind(2,:),2*L),L/br,L/ar);    
phs = exp(-pi*1i*phs/L);

ind_final = [1 0;-s1 1]*[1 -s0;0 1]*ind;
ind_final = mod(ind_final,L);

if s1 ~= 0
    g = comp_pchirp(L,s1).*g;
end

if s0 == 0

    c_rect = zeros(Mr,Nr,W,assert_classname(coef,g));
    if 0
        
        for w=0:W-1
            c_rect(ind(2,:)/br+1+(ind(1,:)/ar)*Mr+w*M*N) = ... 
                coef(floor(ind_final(2,:)/b)+1+(ind_final(1,:)/a)*M+w*M*N);       
            c_rect(:,:,w+1) = phs.*c_rect(:,:,w+1);
        end;
        
    else
    
        tmp1=mod(s1*a*(L+1),2*N);
        
        for k=0:Nr-1   
            phsidx= mod(mod(tmp1*k,2*N)*k,2*N);
            
            for m=0:Mr-1
                phs = exp(-pi*1i*phsidx/N);
                
                idx1 =       mod(    k        ,N);
                idx2 = floor(mod(-s1*k*a+m*b,L)/b);
                
                for w=0:W-1    
                     c_rect(m+1,k+1,w+1) = coef(idx2+1,idx1+1,w+1).*phs;
                end;
            end;
        end;
        
    end;
    
    
    f = comp_idgt(c_rect,g,ar,[0 1],0,0);
        
else

    c_rect = zeros(Nr,Mr,W,assert_classname(coef,g));
    p = comp_pchirp(L,-s0);

    g = p.*fft(g);

    twoN=2*N;
    cc1=ar/a;
    cc2=mod(-s0*br/a,twoN);
    cc3=mod(a*s1*(L+1),twoN);
    cc4=mod(cc2*br*(L+1),twoN);
    cc5=mod(2*cc1*br,twoN);
    cc6=mod((s0*s1+1)*br,L);
    
    for k=0:Nr-1   
        for m=0:Mr-1
            sq1=mod(k*cc1+cc2*m,twoN);
            phsidx = mod(mod(cc3*sq1.^2,twoN)-mod(m*(cc4*m+k*cc5),twoN),twoN);            
            phs = exp(-pi*1i*phsidx/N);
            
            idx1 =       mod(    k*cc1       +cc2*m,N);
            idx2 = floor(mod(-s1*k*ar+(s0*s1+1)*m*br,L)/b);
            
            for w=0:W-1                    
                c_rect(mod(-k,Nr)+1,m+1,w+1) = coef(idx2+1,idx1+1,w+1).*phs;
            end;
        end;
    end;                    
    
    f = comp_idgt(c_rect,g,br,[0 1],0,0);
    f = ifft(bsxfun(@times,comp_pchirp(L,s0),f));   
    
end

if s1 ~= 0
    f = bsxfun(@times,comp_pchirp(L,-s1),f);
end"
2527,comp_iufwt.m,73.38,60,80.95,45,100.0,80.95,70-80,"function f = comp_iufwt(c,g,a,J,scaling)

assert(a(1)==a(2),'First two elements of a are not equal. Such wavelet filterbank is not suported.');

filtNo = length(g);
gOffset = cellfun(@(gEl) gEl.offset,g(:));

g = comp_filterbankscale(g(:),a(:),scaling);

gMat = cell2mat(cellfun(@(gEl) gEl.h(:),g(:)','UniformOutput',0));

ca = squeeze(c(:,1,:));
cRunPtr = 2;
for jj=1:J
   filtUps = a(1)^(J-jj); 
   offset = filtUps.*gOffset ;%+ filtUps; 
   ca=comp_iatrousfilterbank_td([reshape(ca,size(ca,1),1,size(ca,2)),...
                 c(:,cRunPtr:cRunPtr+filtNo-2,:)],gMat,filtUps,offset); 
   cRunPtr = cRunPtr + filtNo -1;
end
f = ca;"
2528,comp_iuwfbt.m,77.486,100,72.73,45,100.0,69.7,70-80,"function f=comp_iuwfbt(c,wtNodes,nodesUps,rangeLoc,rangeOut,scaling)

L = size(c,1);
W = size(c,3);
catmp = [];
ca = [];
for jj=1:length(wtNodes)
    a = wtNodes{jj}.a;
    
    g = comp_filterbankscale(wtNodes{jj}.g(:),a(:),scaling);
    
    gMat = cell2mat(cellfun(@(gEl) gEl.h(:),g','UniformOutput',0));

    gOffset = cellfun(@(gEl) gEl.offset,wtNodes{jj}.g);
    
    offset = nodesUps(jj).*(gOffset) ;%- nodesUps(jj);
     
    filtNo = size(gMat,2);
    if(filtNo~=size(catmp,2))
       catmp = zeros(L,filtNo,W,class(c));
    end

    catmp(:,rangeLoc{jj},:) = c(:,rangeOut{jj},:);
    diffRange = 1:filtNo;
    diffRange(rangeLoc{jj}) = [];
    if(~isempty(diffRange))
       catmp(:,diffRange(end:-1:1),:) = ca(:,1:numel(diffRange),:);
    end
    
    catmp = comp_iatrousfilterbank_td(catmp,gMat,nodesUps(jj),offset);
    ca = horzcat(ca(:,numel(diffRange)+1:end,:),reshape(catmp,size(catmp,1),1,size(catmp,2)));
end
f = catmp;"
2529,comp_iuwpfbt.m,77.144,60,67.86,90,100.0,67.86,70-80,"function f=comp_iuwpfbt(c,wtNodes,nodesUps,pOutIdxs,chOutIdxs,scaling,interscaling)

interscalingfac = 1;
if strcmp('intscale',interscaling)
    interscalingfac = 1/2;
elseif strcmp('intsqrt',interscaling)
    interscalingfac = 1/sqrt(2);
end

 for jj=1:length(wtNodes)
    a = wtNodes{jj}.a;
    
    g = comp_filterbankscale(wtNodes{jj}.g(:),a(:),scaling);
    
    gMat = cell2mat(cellfun(@(gEl) gEl.h(:),g','UniformOutput',0));

    gOffset = cellfun(@(gEl) gEl.offset,wtNodes{jj}.g);
    
    offset = nodesUps(jj).*(gOffset);% + nodesUps(jj);

    ctmp = comp_iatrousfilterbank_td(c(:,chOutIdxs{jj},:),gMat,nodesUps(jj),offset);
    
    if(pOutIdxs(jj))
       c(:,pOutIdxs(jj),:) = interscalingfac*(c(:,pOutIdxs(jj),:)+reshape(ctmp,size(ctmp,1),1,size(ctmp,2)));
    else
       f = ctmp;
    end
 end"
2530,comp_iwfbt.m,77.6,60,84.0,60,100.0,84.0,70-80,"function f=comp_iwfbt(c,wtNodes,outLens,rangeLoc,rangeOut,ext)

doPer = strcmp(ext,'per');

ca = {};
for jj=1:length(wtNodes)
    gCell = cellfun(@(gEl) gEl.h(:),wtNodes{jj}.g(:),'UniformOutput',0);
    a = wtNodes{jj}.a;
    if(doPer)
       offset = cellfun(@(gEl) gEl.offset,wtNodes{jj}.g(:));
    else
       offset = -(a-1);
    end
    filtNo = numel(gCell);
    
    catmp = cell(filtNo,1);
    catmp(rangeLoc{jj}) = c(rangeOut{jj});
    diffRange = 1:filtNo;
    diffRange(rangeLoc{jj}) = [];
    catmp(diffRange(end:-1:1)) = ca(1:numel(diffRange));
    
    catmp = comp_ifilterbank_td(catmp,gCell,a,outLens(jj),offset,ext);
    ca = [ca(numel(diffRange)+1:end);catmp];
end
f = catmp;"
2531,comp_KR.m,72.23,100,82.05,15,100.0,64.1,70-80,"[ H, ok, score ] = HM_ransac(X1, X2, 500, 0.1);

figure; clf;
marker_size = 15;
imshow([im1,im2], 'border', 'tight'); hold on;
plot(X1(1,ok), X1(2,ok), 'b.', 'MarkerSize', marker_size);
plot(X2(1,ok)+imsize1(2), X2(2,ok), 'b.', 'MarkerSize', marker_size);
plot(X1(1,~ok), X1(2,~ok), 'r.', 'MarkerSize', marker_size);
plot(X2(1,~ok)+imsize1(2), X2(2,~ok), 'r.', 'MarkerSize', marker_size);


X1_ok = X1(:,ok);
X2_ok = X2(:,ok);

options = optimoptions('lsqnonlin', 'Algorithm','levenberg-marquardt', 'Display','final',...
    'MaxFunEvals',2000, 'MaxIter',1e3, 'TolFun',1e-6, 'TolX',1e-6, 'Jacobian','off');
[paras_init,resnorm_init,residual_init,exitflag_init,output_init] = lsqnonlin(...
    @(p)residual_KR_robust(double(X1_ok), double(X2_ok), imsize1, imsize2, p, 1000), [1000 1000 0 0 0],...
    [],[],options);
[paras,resnorm,residual,exitflag,output] = lsqnonlin(...
    @(p)residual_KR_robust(double(X1_ok), double(X2_ok), imsize1, imsize2, p, 10), paras_init,...
    [],[],options);
k1 = paras(1);
k2 = paras(2);
theta = paras(3:5);

K1 = [k1, 0, imsize1(2)/2;
     0, k1, imsize1(1)/2;
     0,  0, 1];
K2 = [k2, 0, imsize2(2)/2;
      0, k2, imsize2(1)/2;
      0,  0, 1];
theta_m = [0         -theta(3) theta(2)
           theta(3)  0         -theta(1)
           -theta(2) theta(1)  0];
R = expm(theta_m);

H = K2*R/K1;
M1 = K1; M2 = K2; D1 = 0; D2 = 0;"
2532,comp_load_solo.m,76.152,100,79.25,60,100.0,41.51,70-80,"function [data] = raw_load_solo()






[raw_name,temp,filterindex]=uigetfile('*.*','Load Binary File');
filnam=[temp raw_name];

fid = fopen(filnam,'r');
fseek(fid,0,'eof'); % move to end of file
pos2 = ftell(fid); % pos2 is overall length of file
frewind(fid); % move back to beginning of file
nrecs = pos2/488;

disp(sprintf('%d 5-second records in the file',nrecs));
tbase = double(datenum(1970,1,1));
for i =1:nrecs
    data.secs(i,1) = fread(fid,1,'uint32');
    data.time(i,1) = data.secs(i)/86400.0 + tbase;
    data.pMean(i,1) = fread(fid,1,'single');
    data.t1Mean(i,1) = fread(fid,1,'single');
    data.t1Var(i,1) = single(fread(fid,1,'single'));
    data.t2Mean(i,1) = fread(fid,1,'single');
    data.t2Var(i,1) = fread(fid,1,'single');
    data.t1PVar(i,1) = fread(fid,1,'single');
    data.t2PVar(i,1) = fread(fid,1,'single');
    data.s1Var(i,1) = fread(fid,1,'single');
    data.s2Var(i,1) = fread(fid,1,'single');
    data.wMean(i,1) = fread(fid,1,'single');
    data.wVar(i,1) = fread(fid,1,'single');
    data.axMean(i,1) = fread(fid,1,'single');
    data.ayMean(i,1) = fread(fid,1,'single');
    data.azMean(i,1) = fread(fid,1,'single');
    data.axVar(i,1) = fread(fid,1,'single');
    data.ayVar(i,1) = fread(fid,1,'single');
    data.azVar(i,1) = fread(fid,1,'single');
    data.headingMean(i,1) = fread(fid,1,'single');
    data.pitchMean(i,1) = fread(fid,1,'single');
    data.rollMean(i,1) = fread(fid,1,'single');
    data.validbins(i,1) = fread(fid,1,'uint32');
    mvals = fread(fid,[25,4],'single');
    data.t1PAmplitudes(i,1:data.validbins) = mvals(1:data.validbins,1);
    data.t2PAmplitudes(i,1:data.validbins) = mvals(1:data.validbins,2);
    data.s1Amplitudes(i,1:data.validbins) = mvals(1:data.validbins,3);
    data.s2Amplitudes(i,1:data.validbins) = mvals(1:data.validbins,4);

end


fclose(fid);
end"
2533,comp_logE.m,70.474,60,78.95,45,100.0,68.42,70-80,"function logE = comp_logE(x);

x(:);   % convert x to a column vector

logE_floor = -50;           % minimum value for log energy
Fs = 8000;              % for AURORA2 database, the sampling rate is 8k

frame_size = Fs * 0.025;    % 25ms frame
frame_shift = Fs * 0.01;    % 10ms shift
frame_overlap = frame_size - frame_shift;

N_block = floor((length(x)-frame_size)/frame_shift)+1;
    
for i = 1:N_block
    start = (i-1)*frame_shift+1;
    last = min(length(x),start+frame_size-1);
    x_fr = x(start:last);
    logE(i) = log(max(logE_floor, sum(x_fr.^2)));
end"
