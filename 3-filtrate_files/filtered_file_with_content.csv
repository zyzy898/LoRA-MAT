sat_portion_07   =  sum( logvs >= sat_top-sat_range*7/20 & logvs < sat_top-sat_range*6/20  ) / num;
sat_portion_08   =  sum( logvs >= sat_top-sat_range*8/20 & logvs < sat_top-sat_range*7/20  ) / num;
