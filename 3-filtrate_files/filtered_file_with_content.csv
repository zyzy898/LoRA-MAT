3930,crop_all.m,78.472,100,67.65,60,100.0,64.71,70-80,"function croppedImages = crop_all(this, rangeIndexArray, otherImages)


if ~iscell(otherImages)
    otherImages = {otherImages};
end
nImages = numel(otherImages) + 1;

croppedImages = cell(nImages,1);

dimLabels = rangeIndexArray(1:2:end);
cropIndexRanges = rangeIndexArray(2:2:end);


nDims = numel(dimLabels);
selectionIndexArray = cell(1, 2*nDims);


croppedImages = [{this}; reshape(otherImages, [], 1)];
for iImage = 1:nImages
    
    for iDim = 1:nDims
        cropIndexRange = cropIndexRanges{iDim};
        dimLabel = dimLabels{iDim};
        idxDim = this.dimInfo.get_dim_index(dimLabel);
        crop = this.dimInfo.index2sample(cropIndexRange, idxDim);
        res = croppedImages{iImage}.dimInfo.resolutions;
        selectionIndexArray{2*iDim-1} = dimLabel;
        selectionIndexArray{2*iDim} = crop(1):res(idxDim):crop(2);
    end
    
    croppedImages{iImage} = croppedImages{iImage}.select('type', 'samples', ...
        selectionIndexArray{:});
end"
3931,crop_borders.m,76.41,80,49.58,100,100.0,52.47,70-80,"function [A, vA, vB, bb_rel] = crop_borders(A, bcol, padding, crop_amounts)


    if nargin < 3
        padding = 0;
    end
    if nargin < 4
        crop_amounts = nan(1,4);  % =auto-cropping
    end
    crop_amounts(end+1:4) = NaN;  % fill missing values with NaN

    [h, w, c, n] = size(A);
    if isempty(bcol)  % case of transparent bgcolor
        bcol = A(ceil(end/2),1,:,1);
    end
    if isscalar(bcol)
        bcol = bcol(ones(c, 1));
    end

    if ~isfinite(crop_amounts(4))
        bail = false;
        for l = 1:w
            for a = 1:c
                if ~all(col(A(:,l,a,:)) == bcol(a))
                    bail = true;
                    break;
                end
            end
            if bail
                break;
            end
        end
    else
        l = 1 + abs(crop_amounts(4));
    end

    if ~isfinite(crop_amounts(2))
        bcol = A(ceil(end/2),w,:,1);
        bail = false;
        for r = w:-1:l
            for a = 1:c
                if ~all(col(A(:,r,a,:)) == bcol(a))
                    bail = true;
                    break;
                end
            end
            if bail
                break;
            end
        end
    else
        r = w - abs(crop_amounts(2));
    end

    if ~isfinite(crop_amounts(1))
        bcol = A(1,ceil(end/2),:,1);
        bail = false;
        for t = 1:h
            for a = 1:c
                if ~all(col(A(t,:,a,:)) == bcol(a))
                    bail = true;
                    break;
                end
            end
            if bail
                break;
            end
        end
    else
        t = 1 + abs(crop_amounts(1));
    end

    bcol = A(h,ceil(end/2),:,1);
    if ~isfinite(crop_amounts(3))
        bail = false;
        for b = h:-1:t
            for a = 1:c
                if ~all(col(A(b,:,a,:)) == bcol(a))
                    bail = true;
                    break;
                end
            end
            if bail
                break;
            end
        end
    else
        b = h - abs(crop_amounts(3));
    end

    if padding == 0  % no padding
        if ~isequal([t b l r], [1 h 1 w]) % Check if we're actually croppping
            padding = 1; % Leave one boundary pixel to avoid bleeding on resize
            bcol(:) = nan;  % make the 1px padding transparent
        end
    elseif abs(padding) < 1  % pad value is a relative fraction of image size
        padding = sign(padding)*round(mean([b-t r-l])*abs(padding)); % ADJUST PADDING
    else  % pad value is in units of 1/72"" points
        padding = round(padding);  % fix cases of non-integer pad value
    end

    if padding > 0  % extra padding
        B = repmat(bcol,[(b-t)+1+padding*2,(r-l)+1+padding*2,1,n]);  % Fix per Luiz Carvalho
        vA = [t b l r];
        vB = [padding+1, (b-t)+1+padding, padding+1, (r-l)+1+padding];
        B(vB(1):vB(2), vB(3):vB(4), :, :) = A(vA(1):vA(2), vA(3):vA(4), :, :);
        A = B;
    else  % extra cropping
        vA = [t-padding b+padding l-padding r+padding];
        A = A(vA(1):vA(2), vA(3):vA(4), :, :);
        vB = [NaN NaN NaN NaN];
    end

    bb_rel = [l-1 h-b-1 r+1 h-t+1]./[w h w h];
end

function A = col(A)
    A = A(:);
end"
