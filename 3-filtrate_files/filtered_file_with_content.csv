    case 'RegisterMode'
        mode = get(findobj('Tag', 'dispregpopupmenu'),'Value');
        switch mode
            case 1 %manual
            case 2 %ctrl points  
            case 3 %auto control points
        end
               
    case 'LoadRefImage'
