function H=cal_h(t,ksi)

    r = 200;
    w = 0.15;
    H = zeros(40,1);
    for i =1:10
        hi = [ r*sin(w*t+(i-1)*pi/5);
               r*w*cos(w*t+(i-1)*pi/5);
               r*cos(w*t+(i-1)*pi/5);
               -w*r*sin(w*t+(i-1)*pi/5)];   
        H(4*(i-1)+1:4*i,1) = hi;
    end
end

function Hv_dot=cal_hvdot(t,ksi)
    r = 200;
    w = 0.15;
    Hv_dot = zeros(20,1);
    for i =1:10
        hiv_dot = [  -r*w^2*sin(w*t+(i-1)*pi/5);
           -r*w^2*cos(w*t+(i-1)*pi/5)]; 
        Hv_dot(2*i-1:2*i,1) = hiv_dot;
    end
end"
