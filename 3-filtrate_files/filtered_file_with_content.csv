5055,DEKF_2V_2D.m,75.944,100,80.28,60,100.0,39.44,70-80,"function [xhat1Out,xhat2Out,P1Out,P2Out] = DEKF2(y1,y2,p1,p2,x1hat,x2hat,P1,P2,Ts,depth,t) 
Omega1=inv(P1);
Omega2=inv(P2);

q1=Omega1*x1hat;
q2=Omega2*x2hat;

Q = 1e-4*diag([10 10 1 1]);
R1=10;
R2=10;
W=inv(Q);
V1=inv(R1);
V2=inv(R2);
A = [1 0 Ts 0;
     0 1 0  Ts;
     0 0 1  0;
     0 0 0  1];

pos1_hat=x1hat(1:2);
pos2_hat=x2hat(1:2);
h1hat = norm([pos1_hat-p1;depth]);
h2hat = norm([pos2_hat-p2;depth]);

if rem(t,2)==0
    C1=[(pos1_hat-p1)'/h1hat 0 0];
    C2=[(pos2_hat-p2)'/h2hat 0 0];

    y1_err=y1-h1hat+C1*x1hat;
    y2_err=y2-h2hat+C2*x2hat;

    delta_q1=C1'*V1*y1_err;
    delta_q2=C2'*V2*y2_err;
    
    delta_Omega1=C1'*V1*C1;
    delta_Omega2=C2'*V2*C2;
    q1_fus=(q1+q2)/2;
    q2_fus=(q2+q1)/2;
    Omega1_fus=(Omega1+Omega2)/2;
    Omega2_fus=(Omega2+Omega1)/2;
    
    delta_q1_fus=(delta_q1+delta_q2)/2;
    delta_q2_fus=(delta_q2+delta_q1)/2;

    delta_Omega1_fus=(delta_Omega1 + delta_Omega2)/2;
    delta_Omega2_fus=(delta_Omega2 + delta_Omega1)/2;
 
    q1_cor=q1_fus+delta_q1_fus;
    q2_cor=q2_fus+delta_q2_fus;
    
    Omega1_cor=Omega1_fus+delta_Omega1_fus;
    Omega2_cor=Omega2_fus+delta_Omega2_fus;
 
  xhat1_cor=inv(Omega1_cor)*q1_cor;
  xhat2_cor=inv(Omega2_cor)*q2_cor;
else
    xhat1_cor=x1hat;
    xhat2_cor=x2hat;
    Omega1_cor=Omega1;
    Omega2_cor=Omega2;
end
xhat1_pre = A*xhat1_cor;
Omega1_pre=W-W*A/(Omega1_cor+A'*W*A)*A'*W;

xhat2_pre = A*xhat2_cor;
Omega2_pre=W-W*A/(Omega2_cor+A'*W*A)*A'*W;


xhat1Out=xhat1_pre;
P1Out=inv(Omega1_pre);
xhat2Out=xhat2_pre;
P2Out=inv(Omega2_pre);"
5056,DEKF_3V_2D.m,79.878,100,83.33,60,100.0,56.06,70-80,"function [Tracker1, Tracker2, Tracker3] = DEKF_3V_2D(Tracker1, Tracker2, Tracker3, Target,Ts,t)

    Q = 1e-4*diag([10 10 1 1]);
    W = inv(Q);
    R1 = 10;    R2 = 10;    R3 = 10;
    V1 = inv(R1);   V2 = inv(R2);   V3 = inv(R3);

    F = [1 0 Ts 0;
         0 1 0  Ts;
         0 0 1  0;
         0 0 0  1];

    T_meas = 2;
    if rem(t,T_meas)==0
        Tracker1 = local_correction(Tracker1,Target,V1);
        Tracker2 = local_correction(Tracker2,Target,V2);
        Tracker3 = local_correction(Tracker3,Target,V3);

        Tracker1 = fusion(Tracker1,Tracker2);
        Tracker2 = fusion(Tracker2,Tracker3);
        Tracker3 = fusion(Tracker3,Tracker1);
    else
        Tracker1.x_hat_cor = Tracker1.x_hat(:,end);
        Tracker2.x_hat_cor = Tracker2.x_hat(:,end);
        Tracker3.x_hat_cor = Tracker3.x_hat(:,end);        
        Tracker1.Omega_cor = inv(Tracker1.P_hat);
        Tracker2.Omega_cor = inv(Tracker2.P_hat);
        Tracker3.Omega_cor = inv(Tracker3.P_hat);
    end
    Tracker1 = prediction(Tracker1, F, W);
    Tracker2 = prediction(Tracker2, F, W);
    Tracker3 = prediction(Tracker3, F, W);
end   
function Tracker = local_correction(Tracker,Target,V)
    q_hat = Tracker.x_hat(1:2,end);                                         % Current estimated position of target
    p = Tracker.p(:,end);                                                   % Current position of tracker
    h_hat = norm([q_hat-p;Target.Depth]);                                   % Current estimated range from tracker to target
    y = Tracker.range(end);                                                 % Current true range from tracker to target
    x_hat = Tracker.x_hat(:,end);
    Omega = inv(Tracker.P_hat);     
    z = Omega*x_hat;                                                       % Current informaiton vector
        
    C = [(q_hat - p)'/h_hat 0 0];        
    y_err = y - h_hat + C*x_hat;
         
    z_tilde = z + C'*V*y_err;                                      % will be transmited to neighbor, i.e. Tracker 3 
    Omega_tilde = Omega + C'*V*C;                                  % will be transmited to neighbor, i.e. Tracker 3
    
    Tracker.z_tilde = z_tilde;
    Tracker.Omega_tilde = Omega_tilde;
end
function Tracker = fusion(Tracker,neighbor)
     Tracker.z_cor = 0.5*Tracker.z_tilde + 0.5*neighbor.z_tilde;
     Tracker.Omega_cor = 0.5*Tracker.Omega_tilde + 0.5*neighbor.Omega_tilde;
     Tracker.x_hat_cor = inv(Tracker.Omega_cor)*Tracker.z_cor;
end
function Tracker = prediction(Tracker,F,W)
    x_hat_cor = Tracker.x_hat_cor;
    Omega_cor = Tracker.Omega_cor;
    x_hat_pre = F*x_hat_cor;
    Omega_pre = W - W*F/(Omega_cor + F'*W*F)*F'*W;
   
    Tracker.x_hat(:,end+1) = x_hat_pre;
    Tracker.P_hat = inv(Omega_pre);
    Tracker.P_save = [Tracker.P_save Tracker.P_hat];
end"
5057,DEKF_3V_2D_ETC.m,75.038,80,79.31,60,100.0,55.88,70-80,"function [Tracker1, Tracker2, Tracker3] = DEKF_3V_2D_ETC(Tracker1, Tracker2, Tracker3, Target,Ts,t)

    Q = 1e-4*diag([10 10 1 1]);
    W = inv(Q);
    R1 = 10;    R2 = 10;    R3 = 10;
    V1 = inv(R1);   V2 = inv(R2);   V3 = inv(R3);

    F = [1 0 Ts 0;
         0 1 0  Ts;
         0 0 1  0;
         0 0 0  1];

    T_meas = 2;
    if rem(t,T_meas)==0
        Tracker1 = local_correction(Tracker1,Target,V1);
        Tracker2 = local_correction(Tracker2,Target,V2);
        Tracker3 = local_correction(Tracker3,Target,V3);
        Tracker1 = ETC(Tracker1,t);
        Tracker2 = ETC(Tracker2,t);
        Tracker3 = ETC(Tracker3,t);
        
        Tracker1 = fusion_ETC(Tracker1,Tracker2);
        Tracker2 = fusion_ETC(Tracker2,Tracker3);
        Tracker3 = fusion_ETC(Tracker3,Tracker1);
    else
        Tracker1.x_hat_cor = Tracker1.x_hat(:,end);
        Tracker2.x_hat_cor = Tracker2.x_hat(:,end);
        Tracker3.x_hat_cor = Tracker3.x_hat(:,end);        
        Tracker1.Omega_cor = inv(Tracker1.P_hat);
        Tracker2.Omega_cor = inv(Tracker2.P_hat);
        Tracker3.Omega_cor = inv(Tracker3.P_hat);
    end
    Tracker1 = prediction(Tracker1, F, W);
    Tracker2 = prediction(Tracker2, F, W);
    Tracker3 = prediction(Tracker3, F, W);
    Tracker1 = predict_reference(Tracker1, F, Q);
    Tracker2 = predict_reference(Tracker2, F, Q);
    Tracker3 = predict_reference(Tracker3, F, Q);
end   
function Tracker = local_correction(Tracker,Target,V)
    q_hat = Tracker.x_hat(1:2,end);                                         % Current estimated position of target
    p = Tracker.p(:,end);                                                   % Current position of tracker
    h_hat = norm([q_hat-p;Target.Depth]);                                   % Current estimated range from tracker to target
    y = Tracker.range(end);                                                 % Current true range from tracker to target
    x_hat = Tracker.x_hat(:,end);
    Omega = inv(Tracker.P_hat);     
    z = Omega*x_hat;                                                       % Current informaiton vector
        
    C = [(q_hat - p)'/h_hat 0 0];        
    y_err = y - h_hat + C*x_hat;
         
    z_tilde = z + C'*V*y_err;                                      % will be transmited to neighbor, i.e. Tracker 3 
    Omega_tilde = Omega + C'*V*C;                                  % will be transmited to neighbor, i.e. Tracker 3
    
    P_tilde = inv(Omega_tilde);
    x_tilde = P_tilde*z_tilde;
    Tracker.z_tilde = z_tilde;
    Tracker.Omega_tilde = Omega_tilde;

    Tracker.P_tilde = P_tilde;
    Tracker.x_tilde = x_tilde;
end
function Tracker = fusion_ETC(Tracker,neighbor)
     neighbor.Omega_bar = inv(neighbor.P_bar);
     neighbor.z_bar = neighbor.Omega_bar*neighbor.x_bar(:,end);
     
     Tracker.z_cor = 0.5*Tracker.z_tilde + 0.5*neighbor.z_bar;
     Tracker.Omega_cor = 0.5*Tracker.Omega_tilde + 0.5*neighbor.Omega_bar;
    
      
     Tracker.x_hat_cor = inv(Tracker.Omega_cor)*Tracker.z_cor;
end
function Tracker = prediction(Tracker,F,W)
    x_hat_cor = Tracker.x_hat_cor;
    Omega_cor = Tracker.Omega_cor;
    x_hat_pre = F*x_hat_cor;
    Omega_pre = W - W*F/(Omega_cor + F'*W*F)*F'*W;
   
    Tracker.x_hat(:,end+1) = x_hat_pre;
    Tracker.P_hat = inv(Omega_pre);
    Tracker.P_save = [Tracker.P_save Tracker.P_hat];   
end    
function Tracker = ETC(Tracker,t)
    x_bar = Tracker.x_bar(:,end);
    Omega_bar = inv(Tracker.P_bar);
    x_tilde = Tracker.x_tilde;
    P_tilde = Tracker.P_tilde;
    Omega_tilde = inv(P_tilde);
    c0 = 2;     c1 = 6;     c2 = 0.05;
    g = c0+c1*exp(-c2*t(end));        
    n = length(x_bar);
    KLD = trace(Omega_bar*P_tilde)+(x_bar-x_tilde)'*Omega_bar*(x_bar-x_tilde)...
                              +log(det(Omega_tilde)/det(Omega_bar))-n;
                          
    if KLD >= g
        Com_DEKF = 1;                                                   % transmit
        Tracker.P_bar = P_tilde;                                        % reset reference density
        Tracker.x_bar(:,end) = x_tilde;
    else
        Com_DEKF = 0; 
    end
    Tracker.KLD(end+1) = KLD;
    Tracker.g(end+1) = g;
    Tracker.Com_DEKF(end+1) = Com_DEKF;
end            
function Tracker = predict_reference(Tracker,F, Q)
   
    x_bar = Tracker.x_bar(:,end);
    P_bar = Tracker.P_bar;
    
    x_bar_pre = F*x_bar;
    P_bar_pre = F*P_bar*F' + Q;
    
    Tracker.x_bar(:,end+1) = x_bar_pre;
    Tracker.P_bar = P_bar_pre;
end"
5058,DEKF_3V_2D_Event1.m,73.154,80,78.88,75,100.0,31.89,70-80,"function [xhat1Out,xhat2Out,xhat3Out,P1Out,P2Out,P3Out,Com_Sig,d_lk] = DEKF_event(y1,y2,y3,p1,p2,p3,x1hat,x2hat,x3hat,P1,P2,P3,Ts,depth,t) 
