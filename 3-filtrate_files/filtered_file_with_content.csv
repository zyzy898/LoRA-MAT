plot(xt02(:,1), Ef2(1:nt)-1.96*sqrt(diag(Varf2(1:nt,1:nt))), '--', 'color', col2, 'linewidth', 2)
xlabel('age')
title('effect of age for both sexes, inputdependent-weibull')

col1=ones(1,3)*0.7;
col2=ones(1,3)*0.3;
