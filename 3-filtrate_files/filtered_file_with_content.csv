6801,DavisBouldinIndex.m,58.0,60,57.69,30,100.0,42.31,51-60,"function [DBI]=DavisBouldinIndex(d,c,kk);






CL = unique(c); 
M = length(CL);

t = 2; q = 2; 
D = zeros(M,M); 

for k=1:M,
        [dk, v(k,:)] = center(d(c==CL(k),:),1); 
        S(k) = sum(sqrt(sum(dk.^2,2)).^q).^(1/q);
end;         

for k1=1:M,
for k2=1:M,
        d(k1,k2)= sum(abs(v(k1,:)-v(k2,:)).^t).^(1/t);  % Minkowski Distance of order t   
end;
end; 

[x,y] = meshgrid(S);
DBI = mean(max((x+y)./D + diag(repmat(NaN,1,M))));"
