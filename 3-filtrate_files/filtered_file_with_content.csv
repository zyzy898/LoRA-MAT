6024,create_data_noisy_L2.m,69.0,30,100.0,15,100.0,100.0,61-70,"function [B, optimal_X, optimal_S, delta]=create_data_noisy_L2(n1,n2,p,r,stdev)

    optimal_S = zeros(n1,n2);
    optimal_X = randn(n1,r)*randn(r,n2);
    noise = stdev*randn(n1,n2);
    delta = stdev*sqrt(n1*n2);
    OMEGA = randperm(n1*n2);
