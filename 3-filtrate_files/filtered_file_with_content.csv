            nav.utc_qzs(3)=str2double(line(39:45));
            nav.utc_qzs(4)=str2double(line(46:50));    
        end
    elseif ~isempty(strfind(label,'LEAP SECONDS'))
        nav.leaps=str2double(line(1:7));
    elseif ~isempty(strfind(label,'END OF HEADER'))
        break;
    end
end

