4028,cscDerivVal.m,73.376,100,75.0,45,100.0,46.88,70-80,"function val=cscDerivVal(z,n)

numEls=numel(z);

val=zeros(size(z));
for curEl=1:numEls
    x=z(curEl);
    u=-cot(x);

    P=zeros(n+1,1);
    Q=zeros(n+1,1);
    P(1)=u;
    Q(1)=1;
    
    for k=1:n
        sumValP=0;
        sumValQ=0;
        for i=0:(k-1)
            binomVal=binomial(k-1,i);
            sumValP=sumValP+binomVal*P(i+1)*P(k-1-i+1);
            sumValQ=sumValQ+binomVal*P(i+1)*Q(k-1-i+1);
        end
        if(k==1)
            sumValP=sumValP+1;
        end
        P(k+1)=sumValP;
        Q(k+1)=sumValQ;
    end
    val(curEl)=Q(end)*csc(x);
end

end"
