        otherwise
        sweepsizevec = 1;    
    end
    sweepsetts.sweepsizevec = sweepsizevec;
    sweepsetts.sweepdim = size(sweepsizevec,1);
end

group_settings.sweepsetts = sweepsetts;        



group_settings.preset_group = preset_group;"
