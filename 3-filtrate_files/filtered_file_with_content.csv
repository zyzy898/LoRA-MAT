c = c(idx);
s = s(idx);
t = t(idx);
tmp = sparse(t, r + szin(1) * (c - 1), s, npixout, npixin);
A = A + tmp;
r = rowidx(:) + 1;
c = colidx(:) + 1;
s = (rowk(:)) .* (colk(:));
t = 1 : npixout;
idx = (r <= szin(1)) & (r >= 1) & (c <= szin(2)) & (c >= 1);
r = r(idx);
c = c(idx);
s = s(idx);
t = t(idx);
tmp = sparse(t, r + szin(1) * (c - 1), s, npixout, npixin);
