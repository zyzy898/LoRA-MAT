2656,ConflictPartition.m,71.526,60,78.95,45,100.0,73.68,70-80,"function Psi = ConflictPartition(PopObj,NS)


    M = size(PopObj,2);
    
    cMatrix = 1 - corr(PopObj);
    cMatrix = repmat(max(cMatrix,[],2)',M,1).*(1-eye(M));
    
    k      = ceil(M/NS);
    Psi    = cell(1,NS);
    remain = 1 : M;
    for s = 1 : NS-1
        [~,L]  = sort(cMatrix(remain,remain),2);
        [~,i]  = min(L(:,k));
        Psi{s} = remain(L(i,1:k));
        remain(L(i,1:k)) = [];
    end
    Psi{NS} = remain;
end"
2657,confmaps2pts.m,71.0,60,83.33,45,100.0,66.67,70-80,"function [pts, confvals] = confmaps2pts(C)

numChannels = size(C,3);
