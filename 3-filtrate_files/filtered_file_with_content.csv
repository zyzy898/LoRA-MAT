2715,ConnectProfiles.m,70.4,100,56.0,60,100.0,36.0,70-80,"function [connection_lines, ip, op] = ConnectProfiles(ip, op)

connection_lines = [];

if(isempty(ip) | isempty(op))
   return 
end

pi1 = ip(1,:);
pi2 = ip(end,:);
po = op(1,:);

d1 = sqrt(sum(pi1 - po).^2);
d2 = sqrt(sum(pi2 - po).^2);

pi = pi1;
d = d1;
if(d1 > d2)
    d = d2;
    ip(:,1) = flipud(ip(:,1));
    ip(:,2) = flipud(ip(:,2));
    pi = pi2;
    ind_e = 1;
end

if(d > 0.5)
    connection_lines = [connection_lines; po; pi];
end

pi = ip(end,:);
po = op(end,:);

d = sqrt(sum(pi - po).^2);

if(d > 0.5)
    connection_lines = [connection_lines; po; pi];
end


if( ip(end,2) < ip(1,2) )
    ip(:,1) = flipud(ip(:,1));
    ip(:,2) = flipud(ip(:,2));    
end

if( op(end,2) < op(1,2) )
    op(:,1) = flipud(op(:,1));
    op(:,2) = flipud(op(:,2));    
end

end"
2716,connectRxnGapfilling.m,75.854,80,67.27,75,100.0,57.0,70-80,"function [resolveBlocked,model]=connectRxnGapfilling(model,database)

